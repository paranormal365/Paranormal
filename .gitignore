[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates

# ============================================================
# IDE / editor
# ============================================================
.vs/
.idea/
*.DotSettings.user

# ============================================================
# VS Code runtime files (logs, pids — not settings/tasks)
# ============================================================
.vscode/webapi.log
.vscode/.webapi.pid
**/webapi-*.log

# ============================================================
# NuGet
# ============================================================
.nuget/
*.nupkg
packages/

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# WaveSurfer TypeScript build tooling (run `npm run build:blazor` to regenerate)
# ============================================================
Ben.Web.WebApp/wwwroot/ts/wavesurfer/node_modules/
Ben.Web.WebApp/wwwroot/ts/wavesurfer/dist/
Ben.Web.WebApp/wwwroot/assets/

# ============================================================
# Secrets / sensitive config
# ============================================================

# Telerik license (proprietary, local-only)
telerik-license.txt

# Development appsettings — contain secrets (connection strings, client secrets, passwords, seed data)
**/appsettings.Development.json
**/appsettings.*.json
!**/appsettings.json

# .NET user secrets
**/secrets.json

# Local secrets / credentials reference (never commit)
SECRETS.md
**/SECRETS.md
.env
.env.*
ProjectNotes/Art/IsHauntedLogo.ai
ProjectNotes/Agent007/
.uploads/

# Ben.Wasm.Video's wwwroot config is browser-fetched client configuration (a dev API URL), not
# server secrets — the blanket appsettings exclusion above exists for secret-bearing server files.
!Ben.Wasm.Video/wwwroot/appsettings.Development.json

# Ben.Video.Sidecar build outputs — fetched/built locally by scripts/fetch-ffmpeg.* and
# installer/macos/build.sh, never committed (100+ MB of binaries; also environment-specific).
Ben.Video.Sidecar/ffmpeg/
Ben.Video.Sidecar/installer/dist/

# Log files — never committed. The WebApi's file sink was removed (audit B6); anything left is
# local noise from a dev run.
*.log

# Rider/ReSharper per-user solution settings — machine-specific, not shared config.
*.DotSettings.user

# Publish output for the standalone editor (scripts/publish-editor.sh). Regenerated on demand and
# around 65 MB, most of it the .NET runtime — a build product, not a source artefact.
artifacts/

# Sidecar zips are staged into the editor's downloads folder at publish time, never committed —
# scripts/publish-editor.sh copies them from Ben.Video.Sidecar/installer/dist.
Ben.Wasm.Video/wwwroot/downloads/*.zip
Ben.Wasm.Video/wwwroot/downloads/checksums.txt
