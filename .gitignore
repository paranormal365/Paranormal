
# ============================================================
# .NET build outputs
# ============================================================
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates

# ============================================================
# IDE / editor
# ============================================================
.vs/
.idea/
*.DotSettings.user

# ============================================================
# VS Code runtime files (logs, pids — not settings/tasks)
# ============================================================
.vscode/webapi.log
.vscode/.webapi.pid
**/webapi-*.log

# ============================================================
# NuGet
# ============================================================
.nuget/
*.nupkg
packages/

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# WaveSurfer TypeScript build tooling (run `npm run build:blazor` to regenerate)
# ============================================================
Ben.Web.WebApp/wwwroot/ts/wavesurfer/node_modules/
Ben.Web.WebApp/wwwroot/ts/wavesurfer/dist/
Ben.Web.WebApp/wwwroot/assets/

# ============================================================
# Secrets / sensitive config
# ============================================================

# Telerik license (proprietary, local-only)
telerik-license.txt

# Development appsettings — contain secrets (connection strings, client secrets, passwords, seed data)
**/appsettings.Development.json
**/appsettings.*.json
!**/appsettings.json
# UAT settings carry no secret: integrated security to the UAT copy of the database, and the
# log sink pointed at the same place. Tracked so the UAT environment is reproducible.
!**/appsettings.UAT.json

# .NET user secrets
**/secrets.json

# Local secrets / credentials reference (never commit)
SECRETS.md
**/SECRETS.md
.env
.env.*
ProjectNotes/Art/IsHauntedLogo.ai
ProjectNotes/Agent007/
.uploads/

# Ben.Wasm.Video's wwwroot config is browser-fetched client configuration (a dev API URL), not
# server secrets — the blanket appsettings exclusion above exists for secret-bearing server files.
!Ben.Wasm.Video/wwwroot/appsettings.Development.json

# Ben.Video.Sidecar build outputs — fetched/built locally by scripts/fetch-ffmpeg.* and
# installer/macos/build.sh, never committed (100+ MB of binaries; also environment-specific).
#
# The Intel Mac image was briefly committed here on 2026-09-05 so a Windows deploy host would have
# one without a Mac in the loop, and taken back out: at 122 MiB it is over GitHub's hard 100 MiB
# per-file limit, so the push was refused. All three images reach the server the same way — the
# deploy script stages them from this folder — which means the deploy runs from a machine that has
# built them.
Ben.Video.Sidecar/ffmpeg/
Ben.Video.Sidecar/installer/dist/

# Log files — never committed. The WebApi's file sink was removed (audit B6); anything left is
# local noise from a dev run.
*.log

# Rider/ReSharper per-user solution settings — machine-specific, not shared config.
*.DotSettings.user

# Publish output for the standalone editor (scripts/publish-editor.sh). Regenerated on demand and
# around 65 MB, most of it the .NET runtime — a build product, not a source artefact.
artifacts/

# Sidecar zips are staged into the editor's downloads folder at publish time, never committed —
# scripts/publish-editor.sh copies them from Ben.Video.Sidecar/installer/dist.
Ben.Wasm.Video/wwwroot/downloads/*.zip
Ben.Wasm.Video/wwwroot/downloads/checksums.txt
TestResults/

# Loose credential files kept beside the repo but never in it.
# The patterns above matched appsettings and SECRETS.md but not an ad-hoc file like
# "IsHaunted - AZURE Client Secrets", which sat untracked and committable in the repo root.
# This repo has already had an Azure secret scrubbed from history with git-filter-repo once.
*[Cc]lient [Ss]ecret*
*[Cc]lient[-_][Ss]ecret*
*CLIENT_SECRET*
*.secrets

# ── Ben.iOS (Xcode / SwiftPM) ────────────────────────────────────────────────
# Anywhere, not just Ben.iOS: a stray workspace made during Xcode Cloud troubleshooting shipped
# its window-state binary because the old rule was path-scoped.
**/xcuserdata/
Ben.iOS/**/.DS_Store
Ben.iOS/BenKit/.build/
Ben.iOS/DerivedData/

# F5b: the NSFW screening model is fetched, not committed (87MB; see scripts/get-screener-model.sh)
Ben.Data.WebApi/Models/nsfw/*.onnx

.uploads-e2e/
.uploads-IsHauntedDb_e2e*/

# Working-copy-only secrets, e.g. the App Review demo password
*.local.md
