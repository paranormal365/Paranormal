<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The outbox the Share Extension adds to and the app sends from, and the list of events the app writes for it
	     (item 235 phase 14d). Same group as the app's entitlement. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ishaunted.ios</string>
	</array>
</dict>
</plist>
