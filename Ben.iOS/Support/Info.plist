<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>IsHaunted</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ishaunted.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ishaunted</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- HTTPS and the system Keychain only: no non-exempt encryption. Without this key
	     App Store Connect asks the export-compliance question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsUsageDescription</key>
	<string>Add public events and investigations you're attending to your own calendar.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Add public events and investigations you're attending to your own calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>Capture photos and video during a field session, and for feed posts and case occurrences.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Stamps where you were standing on every reading, photo and recording in a field session, so a spike in the cellar isn't confused with one in the hall. It stays on this device unless you choose to upload the session to your group.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Measures sound level and records audio during field sessions and EVP recordings, and captures sound with video for feed posts and case evidence.</string>
	<key>NSMotionUsageDescription</key>
	<string>Reads the magnetometer and barometer during a field session — magnetic field strength, and how far up or down you've moved between floors.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save investigation media you download to your photo library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns spoken notes into text during a field session. This happens entirely on your device — nothing you say is sent anywhere.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Ink</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
