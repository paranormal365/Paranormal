<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <!--
    Item 225: no EntityFrameworkCore / Identity.EntityFrameworkCore / EntityFrameworkCore.SqlServer
    here. Nothing in this project used them - they were declared and never referenced - and their
    only effect was to drag EF Core and the SQL Server provider into every consumer, including
    Ben.Service.Models and, through it, any client that wants the DTOs. Every project that really
    does use EF gets it from Ben.Data.Source or declares it itself. A new EF reference here means
    entity code has landed in the wrong project.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- The menu designs' fonts (10/13/2026): free, from Google Fonts, under the SIL Open Font
       License (Special Elite: Apache 2.0); licenses beside them. Embedded once here so the API
       draws PDFs with them and the website serves them to the page, from one copy. -->
  <ItemGroup>
    <EmbeddedResource Include="Menus\Fonts\*.ttf" LogicalName="MenuFont.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Menus\site-mark.jpg" LogicalName="MenuMark.site-mark.jpg" />
  </ItemGroup>

</Project>
