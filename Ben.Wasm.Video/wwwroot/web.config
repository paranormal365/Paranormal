<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the published editor.

  IIS serves nothing whose extension it does not recognise: no mapping, no response, 404. A Blazor
  WebAssembly app is almost entirely such files — the .NET runtime and every assembly ship as
  .wasm, and the ICU data as .dat — so without this file the site returns a page that loads and
  then sits on "Loading" forever while the browser collects 404s for the runtime. Nothing in the
  logs says "MIME type", which is what makes it worth the comment.

  There is deliberately NO <rewrite> section here. URL Rewrite is a separate IIS download rather
  than part of IIS, and a <rewrite> section on a server without it fails the whole folder with
  HTTP 500.19 — trading a working app for a broken one to gain deep links the editor does not
  need. If you later want /editors/video/<anything> to fall back to the app, install URL Rewrite
  and add (the rewrite target is site-absolute, so it has to name the deployed sub-path):

      <rewrite>
        <rules>
          <rule name="SPA fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            </conditions>
            <action type="Rewrite" url="/editors/video/index.html" />
          </rule>
        </rules>
      </rewrite>
-->
<configuration>
  <system.webServer>
    <!-- removeServerHeader: the site and the API drop the "Server: Microsoft-IIS/10.0" line; this
         child application serves static files under its own web.config, so it has to say so too
         (found still announcing on 2026-09-03 after the other two stopped). -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <staticContent>
      <!-- Removed first: a mapping may already exist at the server or site level, and adding a
           duplicate is itself a 500.19. Removing something absent is harmless. -->
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- The editor ships no security headers at all, and TokenStore's own doc comment cites a
             CSP that does not exist as the reason a bearer token in memory is safe enough
             (2026-09-05 audit, wasm-5). These are the ones a static app can set and mean.

             frame-ancestors rather than a full policy: the app loads its own scripts, its own
             WebAssembly and a Google Fonts stylesheet, and a script-src tight enough to be worth
             having would need Blazor's own inline bootstrapping enumerated. Framing is the attack
             this app actually has — an editor holding somebody's footage, embedded invisibly in
             another page — and it is closed here without guessing at the rest. -->
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="frame-ancestors 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Cross-origin isolation, which is what lets the browser hand out SharedArrayBuffer.
             Without both of these, self.crossOriginIsolated is false, isMultiThreadSupported
             answers no, and the multi-thread ffmpeg core can never be selected however capable the
             machine is — so the editor has always rendered on one core in production while
             carrying the code for the other (2026-09-05 audit, wasm-7).

             The cost is real and worth stating: with COEP require-corp, any cross-origin resource
             this page loads must opt in with its own CORP or CORS header. The Google Fonts
             stylesheet and its font files do send permissive headers, and everything else the
             editor loads is same-origin — which is the position vendoring the ffmpeg core just
             put us in. Adding a cross-origin resource that does not opt in will fail visibly. -->
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Embedder-Policy" value="require-corp" />
      </customHeaders>
    </httpProtocol>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <!-- Two files must never be cached, and everything else must be.
         index.html names the fingerprinted runtime files, and appsettings.json names the API. A
         cached copy of either points a returning visitor at a deployment that no longer exists:
         the shell asks for dotnet.<hash>.js files the last /MIR deploy deleted, and the app sits
         on "Loading" with a handful of 404s (2026-09-05 audit, wasm-9). Everything under the app
         is fingerprinted, so the blanket rule below is safe and is what makes a repeat visit
         fast. -->
    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
        <add extension=".json" policy="DisableCache" kernelCachePolicy="DisableCache" />
      </profiles>
    </caching>
  </system.webServer>
</configuration>
