<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      The editor writes ffmpeg filter graphs by formatting numbers into strings. Under a French or
      German browser locale the current culture writes 2.5 as "2,5", and a comma inside a filter
      argument is something ffmpeg cannot parse — so exports with an animated title or callout
      failed for anyone whose browser was not set to English, with an error that named the filter
      rather than the cause (2026-09-05 audit, titles-10). Individual call sites are now explicit
      about InvariantCulture; this closes the whole class rather than the instances found.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Telerik.UI.for.Blazor" Version="14.1.0" />
    <!-- Pinned past the version Telerik's document libraries bring (9.0.9), which carries a published
         high-severity advisory (GHSA-846f-f764-76mx, fixed in 10.0.13): a fresh restore refused to
         build with warnings as errors (10/14/2026). Telerik 15.1 brings 10.0.13 itself; remove then. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ben.Video.Editor\Ben.Video.Editor.csproj" />
  </ItemGroup>
</Project>
