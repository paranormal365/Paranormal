@page "/login"
@using Ben.Wasm.Video.Services
@inject AuthService Auth
@inject TokenStore Tokens
@inject NavigationManager Nav
@inject IConfiguration Config

<PageTitle>Sign in — Video Editor</PageTitle>

@* Plain Blazor-bound inputs by deliberate convention: Telerik inputs ignore synthetically-set
   values (JS-set text never reaches the bound field), which makes automated verification lie.
   A login form is exactly where that must not happen. *@
<div class="bwv-login">
    <h1>Sign in</h1>
    <p class="bwv-login__hint">
        Uses your regular site account. Signing in lets the editor list your uploaded media,
        save projects to the server, and publish finished renders.
    </p>

    <EditForm Model="this" OnValidSubmit="SubmitAsync">
        <label for="email">Email</label>
        <InputText id="email" type="email" @bind-Value="Email" autocomplete="username" />

        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="Password" autocomplete="current-password" />

        @* Only once the server has said the password was right and a code is what is missing.
           Every 401 used to read as "check the address and password", so anyone with two-factor
           turned on could not sign in here at all and was told their password was wrong while
           typing it correctly (2026-09-05 audit, F11). *@
        @if (_needsCode)
        {
            <label for="code">Authenticator code</label>
            <InputText id="code" @bind-Value="TwoFactorCode" autocomplete="one-time-code"
                       inputmode="numeric" placeholder="000000" />
            <p class="bwv-login__hint">A recovery code works here too.</p>
        }

        <button type="submit" disabled="@_busy">@(_busy ? "Signing in…" : _needsCode ? "Verify" : "Sign in")</button>
    </EditForm>

    @if (_error is not null)
    {
        <p class="bwv-login__error" role="alert">@_error</p>
    }

    @* Always offered, not only once signed in. Somebody who opened this page by mistake, or who
       decided to carry on without an account, had no way back — and editing and export work
       perfectly well signed out (2026-09-05 audit, F11). *@
    <p class="bwv-login__back">
        @if (Tokens.IsAuthenticated)
        {
            <span class="bwv-login__ok">Signed in.</span>
        }
        <a href="@EditorUrl">Back to the editor</a>
    </p>

    @* Both live on the site, not here: this app has no account pages of its own, and sending
       somebody to a dead end is worse than sending them off-app. *@
    @if (SiteUrl is not null)
    {
        <p class="bwv-login__links">
            <a href="@($"{SiteUrl}/forgot-password")" target="_blank" rel="noopener">Forgotten your password?</a>
            <span aria-hidden="true"> · </span>
            <a href="@($"{SiteUrl}/register")" target="_blank" rel="noopener">Create an account</a>
        </p>
    }
</div>

@code {
    private bool _busy;
    private string? _error;

    private bool _needsCode;

    public string Email { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;
    public string TwoFactorCode { get; set; } = string.Empty;

    /// <summary>
    /// This app's own root.
    /// </summary>
    /// <remarks>
    /// Not "/". In production the editor is served under a sub-path, where "/" is the site's root
    /// and not this app — so signing in successfully navigated straight out of the editor
    /// (2026-09-05 audit, wasm-2).
    /// </remarks>
    private string EditorUrl => Nav.BaseUri;

    /// <summary>The site the account belongs to, for the pages this app does not have.</summary>
    private string? SiteUrl => Config["BenVideo:SiteBaseUrl"]?.TrimEnd('/');

    private async Task SubmitAsync()
    {
        _busy = true; _error = null;
        try
        {
            var result = await Auth.SignInAsync(Email, Password, _needsCode ? TwoFactorCode : null);

            if (result.RequiresTwoFactor)
            {
                _needsCode = true;
                _error     = null;
                return;
            }

            _error = result.Problem;
            if (_error is null) Nav.NavigateTo(EditorUrl);
        }
        finally
        {
            _busy = false;
        }
    }
}
