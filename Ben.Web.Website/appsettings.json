{
  "WebApi": {
    "BaseUrl": "http://localhost:5252"
  },
  "ConnectionStrings": {
    "BenDbConnectionString": "data source=localhost;initial catalog=BenDb;integrated security=True;persist security info=False;encrypt=True;trustservercertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "data source=localhost;initial catalog=BenDb;integrated security=True;persist security info=False;encrypt=True;trustservercertificate=True;",
          "tableName": "Logs",
          "autoCreateSqlTable": true,
          "restrictedToMinimumLevel": "Error",
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "Source",
                "DataType": "nvarchar",
                "DataLength": 64
              },
              {
                "ColumnName": "Application",
                "DataType": "nvarchar",
                "DataLength": 128
              },
              {
                "ColumnName": "EntityType",
                "DataType": "nvarchar",
                "DataLength": 128
              },
              {
                "ColumnName": "Operation",
                "DataType": "nvarchar",
                "DataLength": 64
              }
            ]
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Ben.Web.Website",
      "Source": "Website"
    }
  },
  "SiteIdentity": {
    "Name": "IsHaunted.com",
    "BaseUrl": "",
    "Tagline": "Find paranormal investigators near you."
  },
  "Apple": {
    "AppLinks": {
      "AppId": "5778H75249.com.ishaunted.ios"
    }
  }
}
