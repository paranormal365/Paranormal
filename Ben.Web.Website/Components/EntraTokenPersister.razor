@* EntraTokenPersister.razor
   No rendermode — runs in the static SSR HTTP scope where EntraTokenHolder IS populated.
   Registers a callback so PersistentComponentState embeds the token into the page HTML.
   MainLayout (circuit scope) reads it back via TryTakeFromJson in OnInitialized.
*@

@inject EntraTokenHolder EntraTokenHolder
@inject PersistentComponentState AppState
@implements IDisposable

@code {
    private PersistingComponentStateSubscription _sub;

    protected override void OnInitialized()
    {
        _sub = AppState.RegisterOnPersisting(PersistAsync, RenderMode.InteractiveServer);
    }

    private Task PersistAsync()
    {
        AppState.PersistAsJson("EntraToken", new SerializedEntraToken(
            EntraTokenHolder.AccessToken,
            EntraTokenHolder.Email,
            EntraTokenHolder.EntraOid,
            EntraTokenHolder.IsEntraAuthenticated));
        return Task.CompletedTask;
    }

    public void Dispose() => _sub.Dispose();
}
