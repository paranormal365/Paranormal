@implements IDisposable

@inject IWebApiTokenStore TokenStore
@inject IWebApiAuthService AuthService
@inject NavigationManager NavManager
@inject NotificationState Notifications
@inject SiteFeaturesProvider Features
@inject IBenAdminClient AdminClient

@*
    The template's sidebar, driven by data instead of hand-maintained markup.

    Replaces three things at once: the 694-line _GeneratedNavigation partial, the inline script
    in _Sidebar.cshtml that marked the active link by string-matching window.location, and
    smartNavigation.js's accordion. Active state, expansion and filtering are all C# here — two
    owners of the same DOM classes (Blazor and a jQuery-era script) is the classic way this breaks.

    Administration lives here as an expandable group rather than in a separate right-hand drawer:
    the template already has a nested-menu pattern, and one place to look for navigation beats two.
*@

<aside class="app-sidebar d-flex flex-column">

    @* No logo here: the brand lives in the header, ahead of the sidebar toggle. *@

    @* The template's own filter markup, class names and id included. Those are not decoration:
       the minified-sidebar rule is `.app-menu-filter-container #searchInput { visibility: hidden }`,
       so a differently-named wrapper leaves the box on screen when the sidebar shrinks to 70px. *@
    <form class="app-menu-filter-container px-4" @onsubmit:preventDefault="true">
        <input type="text" class="form-control" id="searchInput" placeholder="Filter"
               autocomplete="off" aria-label="Filter menu"
               value="@_filter" @oninput="OnFilterInput" />
    </form>

    <nav id="nav-menu" class="primary-nav flex-grow-1 custom-scroll">
        <ul class="nav-menu">
            @foreach (var section in VisibleSections)
            {
                @if (section.Title is { } title)
                {
                    <li class="nav-title"><span>@title</span></li>
                }

                @foreach (var item in section.Items)
                {
                    @RenderItem(item)
                }
            }
        </ul>

        @if (!VisibleSections.Any())
        {
            <div class="no-results-msg pt-3 info-container">
                <h6 class="mb-1">No menu items found.</h6>
                <p class="fs-sm">Try searching with different keywords.</p>
            </div>
        }
    </nav>

    @if (IsImpersonating)
    {
        <div class="impersonation-banner p-2">
            <div class="d-flex align-items-center gap-2 mb-2">
                <BenIcon Name="user" />
                <span class="text-truncate">Viewing as <strong>@TokenStore.UserEmail</strong></span>
            </div>
            <button type="button" class="btn btn-warning btn-sm w-100" @onclick="ReturnToSuperAdmin">
                Return to SuperAdmin
            </button>
        </div>
    }
</aside>

@* The template's own backdrop, from _Sidebar.cshtml. It does two jobs on small screens: dims the
   page behind the open menu, and closes it when tapped. Without it the menu is a one-way door —
   the open sidebar is 288px wide starting at x:0, which covers the hamburger that opened it, so
   the only way out is to pick a link. CSS shows it only while .app-mobile-menu-open is set. *@
<div class="backdrop" data-action="toggle-swap" data-toggleclass="app-mobile-menu-open"></div>

@code {
    /// <summary>Passed down by MainLayout — see the note at its call site for why these are
    /// parameters rather than reads of the token store.</summary>
    [Parameter] public bool IsAuthenticated { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }

    /// <summary>Item 186 F5: may reach the moderation desk. True for a SuperAdmin implicitly.</summary>
    [Parameter] public bool IsModerator { get; set; }
    [Parameter] public bool IsImpersonating { get; set; }

    private string _filter = string.Empty;
    private readonly HashSet<string> _openGroups = new();

    private sealed record Section(string? Title, IReadOnlyList<NavItem> Items);

    /// <summary>Whether the filter box has anything in it.</summary>
    private bool IsFiltering => !string.IsNullOrWhiteSpace(_filter);

    /// <summary>
    /// Sections after the filter box has been applied, dropping any left empty.
    /// </summary>
    /// <remarks>
    /// A matching group is kept with <b>only its matching children</b>. Keeping the whole group
    /// would answer "Checkouts" with an Equipment group holding four entries, three of which have
    /// nothing to do with what was typed — which is the same amount of reading the filter was
    /// meant to save.
    /// </remarks>
    private IEnumerable<Section> VisibleSections
    {
        get
        {
            if (!IsFiltering) return Sections;

            return Sections
                .Select(s => s with { Items = s.Items.Where(Matches).Select(Prune).ToList() })
                .Where(s => s.Items.Count > 0)
                .ToList();
        }
    }

    /// <summary>Drops the children of a matched group that do not themselves match.</summary>
    /// <remarks>
    /// A group whose own name matched keeps everything — typing "Equipment" is asking for the
    /// Equipment group, not for the one entry inside it that repeats the word.
    /// </remarks>
    private NavItem Prune(NavItem item)
    {
        if (item.Children.Count == 0) return item;
        if (item.Text.Contains(_filter, StringComparison.OrdinalIgnoreCase)) return item;

        return new NavItem(item.Text, item.Icon, item.Url,
                           children: item.Children.Where(Matches).Select(Prune).ToList());
    }

    /// <summary>
    /// True when this item, or anything at any depth beneath it, matches the filter.
    /// </summary>
    /// <remarks>
    /// Recursive rather than one level deep. Administration's tools are two levels down, so
    /// filtering for one of them used to find nothing — and now that ordinary entries live in
    /// groups too, a one-level check would fail the same way for most of the menu.
    /// </remarks>
    private bool Matches(NavItem item)
        => item.Text.Contains(_filter, StringComparison.OrdinalIgnoreCase)
        || item.Children.Any(Matches);

    // Same buckets, order and roll-up rules as the Telerik drawer this replaces — only the
    // icon names change (Telerik SvgIcon -> sprite symbol id).
    private IReadOnlyList<Section> Sections
    {
        get
        {
            var sections = new List<Section>();

            // Home stands alone so Administration can sit directly beneath it for an admin,
            // ahead of the visitor-facing entries — an admin arrives to run the site, not to
            // browse it, and the admin tools are what they are reaching for.
            var home = new List<NavItem> { new NavItem("Home", "home", "/") };

            // Your groups, right below Home (item 159): one link per membership, by name. Six
            // or more fold into an expandable entry — the sidebar is a menu, not a directory.
            // Membership rows only, so a SuperAdmin sees the groups they belong to rather than
            // all of them, and impersonation shows the impersonated person's groups.
            if (IsAuthenticated && _myOrgs.Count > 0)
            {
                var orgLinks = _myOrgs
                    .Select(o => new NavItem(o.Name, "globe", $"/organizations/{o.OrganizationId}"))
                    .ToArray();

                if (orgLinks.Length <= 5)
                    home.AddRange(orgLinks);
                else
                    home.Add(Group("Your Organizations", "globe", orgLinks));
            }

            var main = new List<NavItem>();

            // ── Signed out ────────────────────────────────────────────────────
            // Flat, and staying flat. There are only four entries at most, and folding four items
            // into two groups adds a click to reach each of them while saving two rows nobody was
            // struggling to read. Grouping earns its keep at eighteen items, not at four.
            // Impersonation deliberately does NOT fall in here any more (item 159): the whole
            // point of impersonating is seeing the person's real experience, and the old
            // signed-out menu was the single biggest lie in that view. What stays hidden while
            // impersonating is the ADMIN section below — those are the SuperAdmin's own tools,
            // not part of anyone's experience.
            if (!IsAuthenticated)
            {
                // The client's way in: the request wizard, where they give the address the case
                // is about. Sits above the browse-style entries because it is the thing a first
                // -time visitor actually came to do — the wizard itself handles sending them
                // through sign-in.
                main.Add(new NavItem("Request Investigation", "file-plus", "/my-requests/new"));
                main.Add(new NavItem("Join a Group", "map-pin", "/find"));

                // Item 186: the feed is the front door, so a visitor gets the link to it. No
                // badge — a badge counts mentions, and nobody can be mentioned without an account.
                if (Features.IsOn(SiteFeatures.PublicFeed))
                    main.Add(new NavItem("Feed", "message-circle", "/feed"));

                // Sections a SuperAdmin can switch off. The links go when the feature does — and
                // the pages themselves refuse the URL through the same provider, so a hidden link
                // is never the only thing standing between a visitor and a disabled section.
                if (Features.IsOn(SiteFeatures.Equipment))
                    main.Add(new NavItem("Equipment", "tool", "/equipment-catalog"));

                // Publications are written to be read by people who have no account, so this is
                // one of the few entries that matters more signed out than signed in.
                if (Features.IsOn(SiteFeatures.Publications))
                    main.Add(new NavItem("Publications", "book-open", "/publications"));
            }

            if (IsAuthenticated)
            {
                var s = Notifications.Current;


                // ── Kept at the top level, deliberately ───────────────────────
                // These two are checked constantly rather than navigated to, and a thing you look
                // at every few minutes should not be behind a disclosure triangle. Everything else
                // below is a place you go on purpose, which is what a group is for.
                main.Add(new NavItem("Notifications",     "bell",        "/notifications",
                                     Combine(s.SystemMessages, s.PendingPermissionRequests),
                                     badgeNoun: "unread notifications"));
                // Count of groups, not unread messages — Ben read the old badge as a count and he
                // was right to: a bare number after a label reads as a quantity of that label.
                // The unread counts still appear, broken out by bucket, in the bell popover.
                main.Add(new NavItem("Organizations",     "globe",       "/organizations",
                                     CountBadge(_organizationCount),
                                     badgeNoun: "groups"));

                // ── My Work ───────────────────────────────────────────────────
                main.Add(Group("My Work", "clipboard",
                    new NavItem("My Cases",          "folder",   "/my-cases", s.CaseMessagesAsClient,
                                badgeNoun: "unread case messages"),
                    new NavItem("My Investigations", "calendar", "/my-investigations", s.InvestigationInvites,
                                badgeNoun: "investigation invitations"),
                    new NavItem("My Requests",       "inbox",    "/my-requests")));

                // ── Equipment ─────────────────────────────────────────────────
                // The public catalogue joins its owner's own gear here rather than sitting alone
                // above: someone looking for a thermal camera does not first decide whether they
                // mean theirs or everybody's.
                if (Features.IsOn(SiteFeatures.Equipment))
                {
                    main.Add(Group("Equipment", "tool",
                        new NavItem("Catalogue",       "book-open",   "/equipment-catalog"),
                        new NavItem("My Equipment",    "tool",        "/my-equipment"),
                        new NavItem("My Checkouts",    "calendar",    "/my-checkouts", s.EquipmentCheckouts,
                                    badgeNoun: "gear requests and overdue items"),
                        new NavItem("Gear Questions",  "help-circle", "/my-equipment/questions")));
                }

                // ── Media ─────────────────────────────────────────────────────
                var media = new List<NavItem> { new NavItem("Upload Files", "upload", "/upload-files") };
                // What the phone sent up. Without this the website listed field sessions nowhere,
                // so an upload from the app appeared to go into a hole.
                media.Add(new NavItem("My Field Sessions", "activity", "/my-field-sessions"));
                if (Features.IsOn(SiteFeatures.MediaLibrary))
                    media.Add(new NavItem("Media Library", "image", "/media-library"));
                if (Features.IsOn(SiteFeatures.VideoEditor))
                    media.Add(new NavItem("My Videos",     "film",  "/my-videos"));
                main.Add(Group("Media", "layers", media.ToArray()));

                // ── Community ─────────────────────────────────────────────────
                var community = new List<NavItem>();

                // The badge is mentions specifically, not feed activity: being named is
                // addressed to you and worth a number, while "there are new posts" is a feed
                // doing what a feed does and would make the badge meaningless within a day.
                if (Features.IsOn(SiteFeatures.PublicFeed))
                    community.Add(new NavItem("Feed", "message-circle", "/feed", s.FeedMentions,
                                              badgeNoun: "posts that mention you"));
                if (Features.IsOn(SiteFeatures.Publications))
                    community.Add(new NavItem("Publications", "book-open", "/publications"));

                community.Add(new NavItem("Join a Group", "map-pin", "/find"));
                community.Add(new NavItem("Pricing", "dollar-sign", "/pricing"));
                community.Add(new NavItem("Request Investigation", "file-plus", "/my-requests/new"));

                main.Add(Group("Community", "users", community.ToArray()));
            }

            // No Login entry here: the header carries a Sign In control on every page, and a
            // second one in the nav list is the same destination twice.

            sections.Add(new Section(null, home));

            // Item 186 F5: a moderator who is not an administrator still needs their desk. Shown
            // as its own entry rather than folded into Administration, which they cannot open —
            // the whole point of the role is that moderating does not require running the site.
            if (IsModerator && !IsSuperAdmin && !IsImpersonating)
            {
                sections.Add(new Section(null, new[]
                {
                    new NavItem("Moderation", "shield", children:
                    [
                        new NavItem("Media Review",   "image", "/moderation/media"),
                        new NavItem("Reported Posts", "flag",  "/admin/feed-reports"),
                    ]),
                }));
            }

            if (IsSuperAdmin && !IsImpersonating)
            {
                // One expandable entry rather than a headed section: the admin tools are a place
                // you go, not a permanent third of the sidebar. Everything below it stays grouped
                // by area, one level further in.
                sections.Add(new Section(null, new[]
                {
                    new NavItem("Administration", "settings", children: AdminGroups),
                }));
            }

            sections.Add(new Section(null, main));

            return sections;
        }
    }

    /// <summary>
    /// The former right-hand admin drawer, as expandable groups. Same destinations and grouping,
    /// so muscle memory carries over.
    /// </summary>
    // Instance, not static: the Users entry now carries a live count from _userCount.
    private IReadOnlyList<NavItem> AdminGroups => new List<NavItem>
    {
        // Top and ungrouped: it is the overview the rest of this menu drills into, so burying it
        // in a group would put the summary below the detail.
        new NavItem("Dashboard", "bar-chart-2", "/admin/dashboard"),
        new NavItem("Users", "users", bucket: CountBadge(_userCount), badgeNoun: "people", children: new[]
        {
            new NavItem("Manage Users", "user", "/admin/users"),
            new NavItem("Site Roles",   "lock", "/admin/roles"),
        }),
        new NavItem("Cases & Investigations", "folder", children: new[]
        {
            new NavItem("All Cases",          "folder",   "/admin/cases"),
            new NavItem("All Investigations", "calendar", "/admin/investigations"),
        }),
        new NavItem("Content", "layers", children: new[]
        {
            new NavItem("File Types",           "file",   "/admin/file-types"),
            new NavItem("Lookup Types",         "list",   "/admin/lookup-types"),
            new NavItem("Clipart Library",      "image",  "/admin/video-assets"),
            new NavItem("Experience Taxonomy",  "layers", "/admin/experience-taxonomy"),
            new NavItem("Equipment Taxonomy",   "tool",   "/admin/equipment-taxonomy"),
            // Left in place when the feed is switched off, unlike the reader-facing entries: a
            // feed that has been turned off may still have reports somebody never got to, and
            // hiding the only way to see them would strand them.
            new NavItem("Reported Posts",       "flag",   "/admin/feed-reports"),
            new NavItem("Media Review",         "image",  "/moderation/media"),
            new NavItem("Group Ads",            "star",   "/admin/org-ads"),
            new NavItem("Merge Groups",         "git-merge", "/admin/merge-groups"),
            new NavItem("Duplicate Places",     "map-pin", "/admin/place-duplicates"),
            // Sessions whose readings are not on this server — a Playwright run against a shared
            // database leaves the row here and the bytes on the machine that ran it.
            new NavItem("Orphaned Sessions",    "slash",  "/admin/orphaned-sessions"),
            // Feed posts by the seeded accounts — what a Playwright run leaves on the live feed.
            // Hidden, not deleted, and reversible from the same page.
            new NavItem("Test Posts",           "eye-off", "/admin/test-posts"),
            // Last in the group, and named for what it does rather than something softer:
            // it destroys a group and everything belonging to it, and a menu entry that
            // read "Tidy up" would be the first half of an accident.
            new NavItem("Delete a Group",       "trash-2", "/admin/delete-group"),
            // Same reasoning, same bluntness. The users grid links straight into this page with
            // an account chosen; the menu entry is for arriving at it deliberately.
            new NavItem("Delete a Person",      "user-x",  "/admin/delete-user"),
        }),
        new NavItem("Billing", "dollar-sign", children: new[]
        {
            new NavItem("Price Bands",   "layers",      "/admin/subscription-tiers"),
            new NavItem("Coupons",       "tag",         "/admin/coupons"),
            new NavItem("Subscriptions", "credit-card", "/admin/org-subscriptions"),
            new NavItem("Ledger",        "book",        "/admin/billing-ledger"),
            new NavItem("Tax Rates",     "percent",     "/admin/tax-rates"),
            new NavItem("Referrals",     "users",       "/admin/referrals"),
            new NavItem("Member Seats",  "user-plus",   "/admin/member-seats"),
        }),
        new NavItem("System", "settings", children: new[]
        {
            new NavItem("Site Settings",    "settings", "/admin/site-settings"),
            new NavItem("Support Tickets",  "mail",     "/admin/support-tickets"),
            new NavItem("Audit Log",        "list",     "/admin/audit-log"),
            // Beside the audit log, because that is where somebody looks for either, and named
            // "Error Log" so the pair reads as what-people-did against what-broke.
            new NavItem("Error Log",        "alert-triangle", "/admin/error-log"),
            new NavItem("Sidecar Installs", "download", "/admin/sidecar-telemetry"),
            new NavItem("Rate Limits", "shield", "/admin/rate-limits"),
            new NavItem("Outgoing Mail", "send", "/admin/mail"),
        }),
    };

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        // Sections are recomputed on every render, so the badges only need a re-render to update.
        Notifications.Changed += OnNotificationsChanged;
        TokenStore.StateChanged += OnAuthChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Notifications.EnsureStartedAsync(RendererInfo.IsInteractive);
        await LoadNavCountsAsync();
    }

    // ── Inventory counts on the nav ──────────────────────────────────────────
    //
    // These are "how many of these exist", not "how much needs your attention" — which is what
    // every other badge in this menu means. Ben asked for it after reading the Organizations badge
    // as a count of organizations when it was actually unread messages, which is the exact
    // misreading BadgeNoun was added to mitigate and evidently did not.
    //
    // The message counts are not lost: the bell popover still breaks them out by bucket, which is
    // where a per-bucket number belongs anyway.
    //
    // Fetched once per circuit rather than on the notification poll: an organisation being created
    // or a person signing up is rare, and a badge that is a minute stale costs nothing. Sections
    // is a synchronous property, so these land in fields and a re-render picks them up — the same
    // shape as Notifications.Current.
    private int? _organizationCount;
    private IReadOnlyList<MyMembershipOrgItem> _myOrgs = [];
    private int? _userCount;

    /// <summary>
    /// An inventory count, shaped as the bucket the badge renderer already takes.
    /// </summary>
    /// <remarks>
    /// Null (not yet loaded) and zero both render nothing — "0 groups" is noise, and a badge that
    /// flickers in a moment after the menu paints is worse than one that simply appears.
    /// Urgency is None: these are counts, not work waiting, so they must never take the colour
    /// that means "this is overdue".
    /// </remarks>
    private static NotificationBucket? CountBadge(int? count)
        => count is > 0 ? new NotificationBucket(count.Value, null) : null;

    private async Task LoadNavCountsAsync()
    {
        // Impersonation no longer bails (item 159): every fetch below rides the current bearer
        // token, so an impersonated session gets the impersonated person's numbers — fidelity
        // for free. Only the SuperAdmin-gated user count below keeps its own guard.
        //
        // The TOKEN STORE, not the IsAuthenticated parameter: this runs from the store's own
        // StateChanged, and the parameter only updates when MainLayout re-renders — reading it
        // here raced the cascade and skipped the fetch on every soft sign-in.
        if (!TokenStore.IsAuthenticated) return;

        try
        {
            _myOrgs = (await AdminClient.GetMyMembershipOrganizationsAsync()).Items;

            // Already scoped to the caller: a member gets their groups, a SuperAdmin gets all.
            _organizationCount = (await AdminClient.GetOrganizationsAsync()).Items.Count;

            // SuperAdmin only, because only they are shown the Users entry this badges.
            //
            // Counting a full list is the wrong shape at scale — this pulls every user row to
            // display one number. Fine at today's size, and the honest fix is a count endpoint
            // rather than a cleverer client; noted rather than pretended away.
            if (TokenStore.IsSuperAdmin && !TokenStore.IsImpersonating)
            {
                // A badge number. A refused fetch leaves the badge off rather than showing
                // zero users, which would be the same lie in a smaller space.
                var users = await AdminClient.GetAllUsersAsync();
                if (!users.Failed) _userCount = users.Items.Count;
            }
        }
        catch (Exception)
        {
            // A badge is not worth breaking the navigation over. Left null, which renders nothing.
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnFilterInput(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? string.Empty;

    private void ToggleGroup(string key)
    {
        if (!_openGroups.Remove(key)) _openGroups.Add(key);
    }

    /// <summary>A group is open when the user opened it, or when the current page is inside it.</summary>

    @* Rendered recursively rather than as fixed levels, so Administration can hold groups that
       themselves hold links. The template's own nav nests three <ul> deep and styles
       `.primary-nav ul ul ul`, so the depth costs nothing extra. *@
    private RenderFragment RenderItem(NavItem item) => __builder =>
    {
        @* has-ul and aria-haspopup are what the template's own nav script sets on a parent item;
           the template's CSS keys its active-state styling off has-ul, and the chevron below is
           the affordance that tells a reader the item opens at all. Rendered here in C# because
           that script is not shipped — without them Administration looked like a plain link. *@
        <li class="nav-item @(item.Children.Count > 0 ? "has-ul" : null) @(item.Children.Count > 0 && IsExpanded(item) ? "open active" : null) @(item.Children.Count == 0 && IsActive(item) ? "active" : null)"
            aria-haspopup="@(item.Children.Count > 0 ? "true" : null)">
            @if (item.Children.Count == 0)
            {
                <a href="@item.Url" title="@item.Text">
                    <BenIcon Name="@item.Icon" />
                    <span class="nav-link-text">@item.Text</span>
                    @if (item.Count > 0)
                    {
                        @* The visible glyph stays a bare number — there is no room for more — but
                           the tooltip and the accessible name both say what it is counting. *@
                        <span class="badge badge-end @NotificationBadge.CssClass(item.Urgency)"
                              title="@($"{item.Count} {item.BadgeNoun}")"
                              aria-label="@($"{item.Count} {item.BadgeNoun}")">@NotificationBadge.Text(item.Count)</span>
                    }
                </a>
            }
            else
            {
                <a href="#" title="@item.Text"
                   aria-expanded="@IsExpanded(item).ToString().ToLowerInvariant()"
                   @onclick="() => ToggleGroup(item.Text)" @onclick:preventDefault="true">
                    <BenIcon Name="@item.Icon" />
                    <span class="nav-link-text">@item.Text</span>
                    @* Only while closed. Open, every child shows its own badge directly beneath,
                       and a parent repeating their sum reads as a second, larger pile of work. *@
                    @* A group's own count — an inventory number like "how many people" — shows
                       whether the group is open or shut, because it describes the group itself
                       rather than summarising what is inside it. The rolled-up notification badge
                       below is the one that hides when open, since its children then show their
                       own. *@
                    @if (item.Count > 0)
                    {
                        <span class="badge badge-end @NotificationBadge.CssClass(NotificationBadge.Urgency.None)"
                              title="@($"{item.Count} {item.BadgeNoun}")"
                              aria-label="@($"{item.Count} {item.BadgeNoun}")">@NotificationBadge.Text(item.Count)</span>
                    }
                    else if (!IsExpanded(item) && RolledUp(item) is { Count: > 0 } waiting)
                    {
                        var label = waiting.Count == 1
                            ? $"1 item waiting in {item.Text}"
                            : $"{waiting.Count} items waiting in {item.Text}";

                        <span class="badge badge-end @NotificationBadge.CssClass(waiting)"
                              title="@label" aria-label="@label">@NotificationBadge.Text(waiting.Count)</span>
                    }
                    <span class="collapse-sign" aria-hidden="true">
                        <i class="sa @(IsExpanded(item) ? "sa-chevron-up" : "sa-chevron-down")"></i>
                    </span>
                </a>
                @* The template hides every nav list with `.primary-nav ul { display: none }` and
                   reveals a submenu with `.primary-nav ul.nav-menu ul.active` — the class belongs
                   on the <ul> itself, not the parent <li>. Toggling an inline style instead left
                   the CSS default in force, so the group opened in the DOM and stayed invisible. *@
                <ul class="@(IsExpanded(item) ? "active" : null)">
                    @foreach (var child in item.Children)
                    {
                        @RenderItem(child)
                    }
                </ul>
            }
        </li>
    };

    /// <summary>
    /// Open if the reader opened it, or if the current page is anywhere beneath it — checked
    /// recursively, so Administration opens along with the group holding the active link rather
    /// than only when that link is its direct child.
    /// </summary>
    private bool IsExpanded(NavItem group)
        // While filtering, everything left is open. A filter that returns a collapsed group has
        // shown you that a match exists somewhere and then hidden it, which is worse than not
        // filtering at all.
        => IsFiltering || _openGroups.Contains(group.Text) || ContainsActive(group);

    private bool ContainsActive(NavItem group)
        => group.Children.Any(c => IsActive(c) || ContainsActive(c));

    private bool IsActive(NavItem item)
    {
        if (string.IsNullOrEmpty(item.Url)) return false;
        var path = "/" + NavManager.ToBaseRelativePath(NavManager.Uri).Split('?')[0].TrimEnd('/');
        if (item.Url == "/") return path == "/";
        return path.Equals(item.Url, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(item.Url + "/", StringComparison.OrdinalIgnoreCase);
    }

    // Raised off the renderer's synchronization context by NotificationState's poll.
    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);
    private void OnAuthChanged() => _ = InvokeAsync(async () =>
    {
        // Identity changed — sign-in, sign-out, impersonation either way. The org links and
        // counts on screen belong to the previous identity; refetch under the new token rather
        // than re-rendering stale numbers next to a new name (item 159).
        _myOrgs = [];
        _organizationCount = null;
        StateHasChanged();
        await LoadNavCountsAsync();
    });
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => InvokeAsync(StateHasChanged);

    private async Task ReturnToSuperAdmin()
    {
        await AuthService.StopImpersonatingAsync();
        NavManager.NavigateTo("/admin/users");
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        Notifications.Changed -= OnNotificationsChanged;
        TokenStore.StateChanged -= OnAuthChanged;
    }

    /// <summary>
    /// A collapsible group — unless it would hold a single item, in which case it <i>is</i> that
    /// item.
    /// </summary>
    /// <remarks>
    /// A group of one is strictly worse than the item alone: same row on screen, plus a click to
    /// reach what the row already named. It happens for real — switch the media library and the
    /// video editor off and Media is left holding only Upload Files.
    /// </remarks>
    private static NavItem Group(string text, string icon, params NavItem[] children)
        => children.Length == 1
            ? children[0]
            : new NavItem(text, icon, children: children);

    /// <summary>
    /// Everything waiting anywhere beneath a group, as one bucket.
    /// </summary>
    /// <remarks>
    /// <para>Without this, folding a badged item into a group hides its badge: only a leaf renders
    /// one, so a collapsed group is a closed door with nothing on it. That turns grouping — meant
    /// to make the sidebar readable — into a way of losing the one signal the sidebar exists to
    /// carry.</para>
    ///
    /// <para>Recursive, so a badge two levels down still reaches the top. The urgency comes from
    /// the oldest unread item in the whole subtree, which is what <see cref="Combine"/> already
    /// computes — a group is as overdue as the most overdue thing in it.</para>
    /// </remarks>
    private static NotificationBucket RolledUp(NavItem group)
        => Combine(Descendants(group).Select(i => i.Bucket ?? NotificationBucket.Empty).ToArray());

    private static IEnumerable<NavItem> Descendants(NavItem item)
        => item.Children.SelectMany(c => new[] { c }.Concat(Descendants(c)));

    /// <summary>Merges buckets that share one destination, keeping the older timestamp.</summary>
    private static NotificationBucket Combine(params NotificationBucket[] buckets)
    {
        var count = buckets.Sum(b => b.Count);
        if (count == 0) return NotificationBucket.Empty;

        var oldest = buckets.Where(b => b.Count > 0 && b.OldestUnreadUtc.HasValue)
                            .Select(b => b.OldestUnreadUtc!.Value)
                            .DefaultIfEmpty()
                            .Min();
        return new NotificationBucket(count, oldest == default ? null : oldest);
    }

    public sealed class NavItem
    {
        public string Text { get; }
        public string Icon { get; }
        public string Url { get; }
        public IReadOnlyList<NavItem> Children { get; }

        /// <summary>Items waiting behind this destination, or 0 for a plain nav item.</summary>
        public int Count { get; }

        /// <summary>
        /// The bucket this item's badge came from, kept so a parent group can add its children's
        /// counts together. Null for an item with no badge.
        /// </summary>
        public NotificationBucket? Bucket { get; }

        /// <summary>How overdue those items are — drives the badge colour.</summary>
        public NotificationBadge.Urgency Urgency { get; }

        /// <summary>
        /// Plural noun for whatever the badge is counting, e.g. "unread case messages".
        /// <para>
        /// A bare number sitting directly after a nav label reads as a quantity of that label:
        /// "Organizations 17" was taken to mean seventeen organizations, when it meant seventeen
        /// unread messages and the page behind it lists three organizations. The badge has to name
        /// its own units.
        /// </para>
        /// </summary>
        public string BadgeNoun { get; }

        public NavItem(string text, string icon, string url = "", NotificationBucket? bucket = null,
                       IReadOnlyList<NavItem>? children = null, string badgeNoun = "waiting")
        {
            Text = text;
            Icon = icon;
            Url = url;
            Children = children ?? Array.Empty<NavItem>();
            Bucket = bucket;
            Count = bucket?.Count ?? 0;
            Urgency = bucket is null ? NotificationBadge.Urgency.None : NotificationBadge.Classify(bucket);
            BadgeNoun = badgeNoun;
        }
    }
}
