@inject Microsoft.Extensions.Options.IOptions<Ben.Data.Common.SiteIdentity> SiteOptions

<footer class="app-footer">
    <span class="app-footer-text">@SiteOptions.Value.Name &copy; @DateTime.Today.Year</span>
    @* Both reachable signed out: the guides explaining how to request an investigation are
       for people without an account, and so is the contact form. *@
    <a href="/help" class="app-footer-link ms-3">Help</a>
    @* Anonymous like the rest of these: somebody deciding whether to sign up is exactly the
       reader who wants to see the place is being worked on. *@
    <a href="/changes" class="app-footer-link ms-3">What's new</a>
    <a href="/contact" class="app-footer-link ms-3">Contact</a>
    @* Also the privacy-policy URL given to App Store Connect, so it has to stay anonymous and
       stay at this path — a moved or gated /privacy is a rejected app submission, not just a
       broken footer link. *@
    <a href="/privacy" class="app-footer-link ms-3">Privacy</a>
    <a href="/terms" class="app-footer-link ms-3">Terms</a>
    @* The iPhone and iPad app, on every page (Ben, 2026-10-01). A new tab, because it leaves the
       site — and the theme underlines links that do, which is the honest signal here. *@
    <a href="@SiteOptions.Value.AppStoreUrl" class="app-footer-link ms-3" target="_blank" rel="noopener"
       data-testid="footer-app-store">iPhone &amp; iPad app</a>
</footer>
