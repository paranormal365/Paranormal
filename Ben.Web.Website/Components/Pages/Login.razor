@page "/login"

@inject IWebApiAuthService AuthService
@inject IWebApiTokenStore TokenStore
@inject NavigationManager NavManager
@inject IConfiguration Configuration
@inject IWebHostEnvironment Env

<PageTitle>Login</PageTitle>

@*
    The @code block is the original's, unchanged — including the open-redirect guard on ReturnUrl
    and the "resolved UserId, not just a token" check that keeps a half-bridged Entra session from
    bouncing the user off this page. Only the inputs changed: Telerik textboxes become plain
    Blazor InputText, so the form is native Bootstrap.

    Deliberately NOT on a chromeless layout, tempting as that is for a sign-in page: the auth
    bootstrap (and therefore SignalAuthReady) lives in MainLayout, and OnInitializedAsync below
    awaits AuthReady. Under any layout that does not run that bootstrap, this page would hang
    waiting for a signal that never comes. Giving login its own shell means first moving the
    bootstrap into something both layouts render.
*@

<div class="d-flex align-items-center justify-content-center p-3">
    <div class="card shadow-sm" style="width:100%;max-width:26rem;">
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <img src="/static/images/is-haunted-logo.svg" alt="" style="height:64px;width:auto;" />
                <h2 class="h4 mt-3 mb-0">Sign In</h2>
            </div>

            <EditForm Model="@_model" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="login-email">Email</label>
                    <InputText id="login-email" class="form-control" @bind-Value="_model.Email"
                               placeholder="you@example.com" autocomplete="username" />
                    <ValidationMessage For="@(() => _model.Email)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="login-password">Password</label>
                    <InputText id="login-password" type="password" class="form-control"
                               @bind-Value="_model.Password" placeholder="••••••••"
                               autocomplete="current-password" />
                    <ValidationMessage For="@(() => _model.Password)" class="text-danger small" />
                </div>

                @*
                    The second factor, shown only once the server has said this account needs one.
                    Asking everybody up front would be asking most people for something they do not
                    have — 2FA is opt-in, per account.
                *@
                @if (_needsTwoFactor)
                {
                    <div class="mb-3">
                        @*
                            This label deliberately has no target attribute. TelerikMaskedTextBox
                            does not render an id on its inner input — only a data-id GUID — so
                            pointing a label at the component's Id matched nothing: clicking the
                            label did nothing, and a screen reader announced an unlabelled box.
                            LabelAssociationTests caught it. The accessible name comes from
                            aria-label instead, which Telerik splats onto the input.

                            (That guard scans raw file text, so writing the broken attribute out in
                            a comment trips it too — which is why this paragraph describes it in
                            words.)
                        *@
                        <label class="form-label">
                            @(_useRecoveryCode ? "Recovery code" : "Authentication code")
                        </label>
                        <TelerikMaskedTextBox @bind-Value="@_twoFactorCode"
                                              Mask="@(_useRecoveryCode ? null : "000000")"
                                              Class="w-100"
                                              aria-label="@(_useRecoveryCode ? "Recovery code" : "Authentication code")"
                                              Placeholder="@(_useRecoveryCode ? "xxxxx-xxxxx" : "000000")" />
                        <div class="form-text">
                            @if (_useRecoveryCode)
                            {
                                <text>One of the codes you saved when you turned this on. Each works once.</text>
                            }
                            else
                            {
                                <text>The six-digit code from your authenticator app.</text>
                            }
                        </div>
                        <button type="button" class="btn btn-link btn-sm px-0"
                                @onclick="@(() => { _useRecoveryCode = !_useRecoveryCode; _twoFactorCode = string.Empty; })">
                            @(_useRecoveryCode ? "Use my authenticator app instead" : "I can't use my app — use a recovery code")
                        </button>
                    </div>
                }

                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger py-2 mb-3">@_errorMessage</div>
                }

                <button type="submit" class="btn btn-primary w-100" disabled="@_isLoading">
                    @(_isLoading ? "Signing in..." : _needsTwoFactor ? "Verify" : "Sign In")
                </button>
            </EditForm>

            <p class="text-center text-secondary small mt-3 mb-0">
                New here? <a href="/signup">Create an account</a>.
            </p>

            @if (_entraEnabled)
            {
                <hr class="my-3" />
                <div class="text-center text-muted small mb-2">or</div>
                <button class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                        @onclick="LoginWithMicrosoft">
                    <svg width="18" height="18" viewBox="0 0 21 21" xmlns="http://www.w3.org/2000/svg">
                        <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                        <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                        <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                    </svg>
                    Sign in with Microsoft
                </button>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Where to land after a successful sign-in — e.g. an invite link. Only a relative,
    /// local path is honored (never an absolute URL) to avoid an open-redirect via a crafted link.</summary>
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private LoginModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;
    private bool _entraEnabled;

    private string RedirectTarget =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
            ? ReturnUrl : "/";

    protected override async Task OnInitializedAsync()
    {
        _entraEnabled = !string.IsNullOrWhiteSpace(Configuration["AzureAd:ClientId"])
                        && Configuration["AzureAd:ClientId"] != "YOUR_WEBAPP_CLIENT_ID";

        if (Env.IsDevelopment())
        {
            _model.Email    = Configuration["DevLogin:Email"]    ?? string.Empty;
            _model.Password = Configuration["DevLogin:Password"] ?? string.Empty;
        }

        if (!await TokenStore.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        // Only redirect if truly authenticated (has a resolved UserId).
        // AccessToken alone may be set from a partial Entra bridge state (no UserId yet).
        if (TokenStore.IsAuthenticated && TokenStore.UserId.HasValue)
            NavManager.NavigateTo(RedirectTarget);
    }

    private bool _needsTwoFactor;
    private bool _useRecoveryCode;
    private string _twoFactorCode = string.Empty;

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        var code = string.IsNullOrWhiteSpace(_twoFactorCode) ? null : _twoFactorCode.Trim();

        var success = await AuthService.LoginAsync(
            _model.Email,
            _model.Password,
            twoFactorCode: _useRecoveryCode ? null : code,
            recoveryCode:  _useRecoveryCode ? code : null);

        if (success)
        {
            NavManager.NavigateTo(RedirectTarget);
            return;
        }

        _isLoading = false;

        // Four refusals, four different things to do about them. Reporting them all as "invalid
        // email or password" sends three of the four somewhere useless — to reset a password that
        // was right, or to retype credentials the server never even looked at.
        switch (AuthService.LastLoginFailure)
        {
            case LoginFailure.RequiresTwoFactor:
                _needsTwoFactor = true;
                // Not an error the first time: the password was correct and this is the next step.
                _errorMessage = code is null
                    ? null
                    : "That code wasn't right. Try the current one from your app.";
                break;

            case LoginFailure.RateLimited:
                _errorMessage = "Too many sign-in attempts. Please wait a minute and try again.";
                break;

            case LoginFailure.EmailNotConfirmed:
                _errorMessage = "Confirm your email address first — check your inbox for the link we sent.";
                break;

            default:
                _errorMessage = "Invalid email or password.";
                break;
        }
    }

    private void LoginWithMicrosoft()
    {
        // forceLoad: true causes a full HTTP redirect (required to leave the SignalR circuit
        // and trigger the server-side OIDC challenge + redirect to Entra).
        NavManager.NavigateTo("/auth/entra-signin", forceLoad: true);
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
