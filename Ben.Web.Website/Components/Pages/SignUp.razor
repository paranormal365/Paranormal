@page "/signup"
@using Ben.Data.Common.Helpers
@using Ben.Web.Services
@implements IDisposable

@inject IBenAdminClient AccountClient
@inject NavigationManager NavManager

<PageTitle>Create an account</PageTitle>

@*
    Signing up.

    Four fields, and the @name is the one that needs explaining rather than merely labelling: it is
    permanent, it is public, and it is how other people write to you in the feed. Everything about
    this form is arranged so somebody understands that before they pick one.

    The availability check runs as they type, debounced. It is advisory — the unique index in the
    database is what actually decides — so the form still handles being told "taken" on submit.
*@

<div class="container py-4" style="max-width: 520px;">
    <div class="card">
        <div class="card-body p-4">

            <h1 class="h4 mb-1">Create an account<HelpLink Slug="getting-started" Anchor="getting-an-account" /></h1>
            <p class="text-secondary small mb-4">
                Already have one? <a href="/login">Sign in</a>.
            </p>

            @if (_done)
            {
                @* Deliberately the same message whether or not the address was already registered.
                   See the WebApi's registration controller. *@
                <div class="alert alert-success mb-0">
                    <p class="mb-2"><strong>Check your email.</strong></p>
                    <p class="mb-0 small">@_message</p>
                </div>
            }
            else
            {
                <EditForm Model="@_form" OnValidSubmit="SubmitAsync" FormName="signup">
                    <DataAnnotationsValidator />

                    @* Legal name, above the display name — asked first because it is the one the
                       site treats as the person's actual identity; the display name is a choice
                       made afterwards. Both required, so the two are never confused for each
                       other later. *@
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="signup-first">First name</label>
                            <InputText id="signup-first" class="form-control" @bind-Value="_form.FirstName" @bind-Value:after="TidyFirstName"
                                       autocomplete="given-name" placeholder="Sarah" />
                            <ValidationMessage For="@(() => _form.FirstName)" class="text-danger small" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="signup-last">Last name</label>
                            <InputText id="signup-last" class="form-control" @bind-Value="_form.LastName" @bind-Value:after="TidyLastName"
                                       autocomplete="family-name" placeholder="Mitchell" />
                            <ValidationMessage For="@(() => _form.LastName)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="signup-name">Display name</label>
                        <InputText id="signup-name" class="form-control" @bind-Value="_form.DisplayName"
                                   autocomplete="name" placeholder="Sarah Mitchell" />
                        <div class="form-text">What people see on your posts and your profile. You can change this later.</div>
                        <ValidationMessage For="@(() => _form.DisplayName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="signup-handle">Your @@name</label>
                        <div class="input-group">
                            <span class="input-group-text fw-semibold ben-handle-prefix @HandleSymbolClass">@@</span>
                            <input id="signup-handle" class="form-control @HandleFieldClass"
                                   value="@_form.Handle"
                                   @oninput="OnHandleInput"
                                   autocomplete="off" spellcheck="false"
                                   maxlength="@UserHandle.MaxLength"
                                   placeholder="sarahmitchell" />
                        </div>
                        <div class="form-text">
                            How people mention you — <code>@@@(string.IsNullOrEmpty(_form.Handle) ? "yourname" : _form.Handle)</code>.
                            Letters, numbers and underscores. <strong>This cannot be changed later.</strong>
                        </div>
                        @if (_handleMessage is not null)
                        {
                            <div class="small @(_handleAvailable ? "text-success" : "text-danger")">@_handleMessage</div>
                        }
                        <ValidationMessage For="@(() => _form.Handle)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="signup-email">Email</label>
                        <InputText id="signup-email" type="email" class="form-control" @bind-Value="_form.Email"
                                   autocomplete="email" />
                        <div class="form-text">We'll send a link to confirm it. You can't sign in until you have.</div>
                        <ValidationMessage For="@(() => _form.Email)" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="signup-password">Password</label>
                        <InputText id="signup-password" type="password" class="form-control" @bind-Value="_form.Password"
                                   autocomplete="new-password" />
                        <div class="form-text">At least 8 characters, with an upper-case letter, a lower-case letter and a digit.</div>
                        <ValidationMessage For="@(() => _form.Password)" class="text-danger small" />
                    </div>

                    @if (_error is not null)
                    {
                        <div class="alert alert-danger">@_error</div>
                    }

                    @* Disabled only while the request is in flight. It used to also require _handleAvailable,
                       which starts false — so before the availability check had ever run the only button on
                       the page was dead, and being disabled it could not say why. Reported as "the sign up
                       button does nothing". The handle is now checked on submit, where there is somewhere
                       to put the answer. *@
                    <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                        @(_busy ? "Creating your account…" : "Create account")
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private readonly SignUpForm _form = new();

    private bool _busy;
    private bool _done;
    private string? _error;
    private string? _message;

    private bool _handleAvailable;
    private string? _handleMessage;

    /// <summary>True from the first keystroke until the availability answer lands.</summary>
    private bool _handleChecking;

    /// <summary>
    /// Debounces the availability check.
    /// </summary>
    /// <remarks>
    /// Without this every keystroke is a request, so typing a ten-character name is ten round trips
    /// and the answers can arrive out of order — leaving "taken" on screen for a name that is free
    /// because an earlier reply landed last. The token is cancelled on each keystroke, so only the
    /// last one survives the delay.
    /// </remarks>
    private CancellationTokenSource? _handleCheck;

    private string HandleFieldClass => _handleMessage switch
    {
        null => string.Empty,
        _ when _handleAvailable => "is-valid",
        _ => "is-invalid",
    };

    /// <summary>
    /// The @@ prefix is the progress indicator: grey while there is nothing to say, blue while the
    /// answer is in flight, then green or red once it lands.
    /// </summary>
    /// <remarks>
    /// The check is debounced by 400ms and then makes a round trip, which is long enough that
    /// without this the field simply sits there. The colours live in app.css rather than on
    /// Bootstrap utilities: the template forces the prefix to white with !important while the
    /// group has focus, which is precisely when somebody is typing a name, and a single utility
    /// class loses that fight on specificity.
    /// </remarks>
    private string HandleSymbolClass => _handleMessage switch
    {
        null when _handleChecking => "is-checking",
        null                      => string.Empty,
        _ when _handleAvailable   => "is-free",
        _                         => "is-taken",
    };

    private void TidyFirstName() => _form.FirstName = CapitaliseName(_form.FirstName);
    private void TidyLastName()  => _form.LastName  = CapitaliseName(_form.LastName);

    /// <summary>
    /// Gives each part of a name its initial capital when the field is left.
    /// </summary>
    /// <remarks>
    /// <para>Only words typed in all lower case are touched. Anyone who wrote "McTest",
    /// "van der Berg" or "d'Eath" meant it, and a blanket title-case would quietly correct their
    /// own name to something wrong — the one field where being clever is least welcome. So
    /// "mctest" becomes "Mctest" and "McTest" is left exactly as written.</para>
    ///
    /// <para>Display name is deliberately not touched: it is whatever the person wants to be
    /// called, including lower case.</para>
    /// </remarks>
    private static string CapitaliseName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return value ?? string.Empty;

        var chars = value.ToCharArray();
        var atWordStart = true;

        for (var i = 0; i < chars.Length; i++)
        {
            var c = chars[i];

            if (char.IsWhiteSpace(c) || c is '-' or '\'' or '\u2019')
            {
                atWordStart = true;
                continue;
            }

            if (atWordStart)
            {
                // Leave a word alone unless it is entirely lower case — see the remark above.
                var end = i;
                while (end < chars.Length && !char.IsWhiteSpace(chars[end])
                       && chars[end] is not ('-' or '\'' or '\u2019')) end++;

                var word = value[i..end];
                if (word.All(ch => !char.IsLetter(ch) || char.IsLower(ch)))
                    chars[i] = char.ToUpperInvariant(c);

                atWordStart = false;
            }
        }

        return new string(chars);
    }

    private async Task OnHandleInput(ChangeEventArgs e)
    {
        // Normalised as they type, so what is shown is what will be stored — somebody typing
        // "Sarah Mitchell" sees at once that spaces and capitals are not part of a name.
        _form.Handle = UserHandle.Normalize(e.Value?.ToString());
        _handleMessage = null;

        _handleCheck?.Cancel();
        _handleCheck?.Dispose();
        _handleCheck = new CancellationTokenSource();
        var ct = _handleCheck.Token;

        if (_form.Handle.Length == 0) { _handleChecking = false; StateHasChanged(); return; }

        // The rules that need no server are answered immediately; only "is it taken" waits.
        if (!UserHandle.IsValid(_form.Handle, out var localError))
        {
            _handleChecking  = false;
            _handleAvailable = false;
            _handleMessage = localError;
            StateHasChanged();
            return;
        }

        _handleChecking = true;
        StateHasChanged();

        try
        {
            await Task.Delay(400, ct);
            var result = await AccountClient.CheckHandleAsync(_form.Handle, ct);
            if (ct.IsCancellationRequested) return;

            _handleChecking = false;

            if (result is null)
            {
                // The check itself failed to reach the server. Say nothing rather than claiming
                // the name is taken — the prefix goes back to grey and submit is not blocked,
                // because registration validates the name again and is the real authority.
                _handleAvailable = false;
                _handleMessage   = null;
                StateHasChanged();
                return;
            }

            _handleAvailable = result.Available;
            _handleMessage = result.Available ? $"@{result.Handle} is free." : result.Reason;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a later keystroke, which owns _handleChecking now — leave it set so
            // the prefix stays blue across the handover instead of flickering back to grey.
        }
    }

    private async Task SubmitAsync()
    {
        // A check may still be in flight — somebody who types a name and clicks straight through
        // beats the 400ms debounce. Cancel it so a late reply cannot overwrite what we say here.
        _handleCheck?.Cancel();

        if (!UserHandle.IsValid(_form.Handle, out var handleError))
        {
            _handleAvailable = false;
            _handleMessage   = handleError;
            return;
        }

        // A name already known to be taken is worth stopping for; anything else goes to the
        // server, which is the only real authority on whether a name is free and says so below.
        if (_handleMessage is not null && !_handleAvailable)
        {
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            var result = await AccountClient.RegisterAsync(
                new RegisterAccount(_form.Email, _form.Password, _form.DisplayName, _form.Handle,
                                    _form.FirstName, _form.LastName));

            if (result.Succeeded)
            {
                _done = true;
                _message = result.Message;
                return;
            }

            _error = result.Message;

            // When the server named the field, reflect it where the person is looking rather than
            // only at the bottom of the form.
            if (result.Field == nameof(RegisterAccount.Handle))
            {
                _handleAvailable = false;
                _handleMessage = result.Message;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _handleCheck?.Cancel();
        _handleCheck?.Dispose();
    }

    private sealed class SignUpForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your first name.")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your last name.")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 1)]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter the name you want people to see.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, MinimumLength = 2)]
        public string DisplayName { get; set; } = string.Empty;

        // Every other field on this form is [Required] with a ValidationMessage beside it, so
        // leaving one blank says so when you click. Handle had neither: it was enforced only by
        // disabling the submit button, which cannot explain itself. Item 131.
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Choose an @name — it's how people mention you.")]
        [System.ComponentModel.DataAnnotations.StringLength(
            Ben.Data.Common.Helpers.UserHandle.MaxLength,
            MinimumLength = Ben.Data.Common.Helpers.UserHandle.MinLength,
            ErrorMessage = "Names are between 3 and 30 characters.")]
        public string Handle { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your email address.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Choose a password.")]
        [System.ComponentModel.DataAnnotations.StringLength(200, MinimumLength = 8,
            ErrorMessage = "Passwords are at least 8 characters.")]
        public string Password { get; set; } = string.Empty;
    }
}
