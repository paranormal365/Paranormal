@page "/upload-files"

@implements IDisposable

@inject IWebApiClient Api
@inject IWebApiTokenStore TokenStore
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject Ben.Web.Website.Services.UploadTicketService UploadTickets

@using Ben.Data.Common.Enums
@using Ben.Data.Common.Helpers
@using Ben.Service.Models.Entities
@using Microsoft.AspNetCore.Components.Forms
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>Upload Files</PageTitle>

<div class="container-fluid px-3">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Upload Files</h3>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-primary" @onclick="@(() => _showUploadPanel = !_showUploadPanel)"><BenIcon Name="upload" Class="me-1" />
                Upload New File
            </button>
        </div>
    </div>

    @if (_showUploadPanel)
    {
        <div class="card mb-4 p-3">
            <h5 class="mb-3">New Upload</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">File Type</label>
                    <BenSelect Data="@_fileTypes" Value="@_newUpload.FileTypeId" ValueChanged="@((Guid id) => { _newUpload.FileTypeId = id; _uploadError = GetExtensionError(); })" TextField="@nameof(UploadFileTypeRecord.Name)" ValueField="@nameof(UploadFileTypeRecord.Id)" Width="100%" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="uploadfiles-description-f23a">Description</label>
                    <input id="uploadfiles-description-f23a" type="text" class="form-control" @bind="@_newUpload.Description" @bind:event="oninput" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <input type="checkbox" class="form-check-input" id="chkPublic" @bind="@_newUpload.IsPublic" />
                    <label class="ms-2" for="chkPublic">Public</label>
                </div>
                <div class="col-12">
                    <label class="form-label" for="@FileInputId">Files</label>
                    @* A plain input rather than InputFile: the bytes leave through page JavaScript
                       in chunks (see wwwroot/js/chunked-upload.js), never through the circuit —
                       InputFile would stream a multi-gigabyte recording over SignalR. *@
                    <input type="file" id="@FileInputId" multiple class="form-control" @onchange="OnFilesPicked" />
                </div>
                @if (_uploadError is not null)
                {
                    <div class="col-12"><div class="alert alert-danger py-2">@_uploadError</div></div>
                }
                @if (_progress.Count > 0)
                {
                    <div class="col-12 d-flex flex-column gap-2">
                        @for (var i = 0; i < _progress.Count; i++)
                        {
                            var p = _progress[i];
                            <div>
                                <div class="d-flex justify-content-between small">
                                    <span>@p.Name <span class="text-secondary">(@FormatSize(p.Total))</span></span>
                                    <span class="text-secondary">
                                        @(p.State switch
                                        {
                                            UploadState.Done => "Done",
                                            UploadState.Failed => "Failed",
                                            UploadState.Sending => $"{(p.Total == 0 ? 0 : p.Sent * 100 / p.Total)}%",
                                            _ => "Waiting"
                                        })
                                    </span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @(p.State == UploadState.Failed ? "bg-danger" : p.State == UploadState.Done ? "bg-success" : "")"
                                         role="progressbar"
                                         style="width: @(p.Total == 0 ? 0 : p.Sent * 100 / p.Total)%"></div>
                                </div>
                                @if (p.Error is not null)
                                {
                                    <div class="small text-danger mt-1">@p.Error</div>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="col-12 d-flex gap-2">
                    <button type="button" class="btn btn-primary" @onclick="UploadFile" disabled="@(!(_pickedFiles.Count > 0 && !_isUploading))">
                        @(_isUploading ? "Uploading..." : _pickedFiles.Count > 1 ? $"Upload {_pickedFiles.Count} Files" : "Upload")
                    </button>
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showUploadPanel = false)">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* A file grid shown empty over a refusal sends somebody to upload again what is already
       stored. *@
    <BenListState TItem="UploadFileRecord" Result="@_filesResult"
                  EmptyText="No files uploaded yet" OnRetry="@LoadDataAsync">
    <ChildContent>
    <TelerikGrid Data="@_files"
                 TItem="UploadFileRecord"
                 Pageable="true"
                 PageSize="20"
                 Sortable="true"
                 FilterMode="GridFilterMode.FilterRow">
        <GridColumns>
            <GridColumn Field="@nameof(UploadFileRecord.FileName)" Title="File Name" />
            <GridColumn Field="@nameof(UploadFileRecord.ContentType)" Title="Type" Width="140px" />
            <GridColumn Field="@nameof(UploadFileRecord.FileSize)" Title="Size" Width="100px">
                <Template>
                    @(FormatSize(((UploadFileRecord)context).FileSize))
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(UploadFileRecord.IsPublic)" Title="Public" Width="80px">
                <Template>
                    @if (((UploadFileRecord)context).IsPublic)
                    {
                        <BenIcon Name="check" />
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(UploadFileRecord.DateCreated)" Title="Uploaded" Width="140px">
                <Template>
                    @(((UploadFileRecord)context).DateCreated.ToViewerLocalTime(UserState).ToDisplayDate())
                </Template>
            </GridColumn>
            <GridCommandColumn Width="300px">
                <GridCommandButton Command="Download" Icon="@SvgIcon.Download"
                                   OnClick="@((GridCommandEventArgs e) => DownloadFile((UploadFileRecord)e.Items.First()))">
                    Download
                </GridCommandButton>
                <GridCommandButton Command="Share" Icon="@SvgIcon.Share"
                                   OnClick="@((GridCommandEventArgs e) => OpenShareDialog((UploadFileRecord)e.Items.First()))">
                    Share
                </GridCommandButton>
                <GridCommandButton Command="Replace" Icon="@SvgIcon.Upload"
                                   OnClick="@((GridCommandEventArgs e) => OpenReplaceDialog((UploadFileRecord)e.Items.First()))">
                    Replace
                </GridCommandButton>
                <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash"
                                   OnClick="@((GridCommandEventArgs e) => DeleteFile((UploadFileRecord)e.Items.First()))">
                </GridCommandButton>
            </GridCommandColumn>
        </GridColumns>
    </TelerikGrid>
    </ChildContent>
    </BenListState>
</div>

@* Same-filename-on-upload prompt (item #6 phase 3) *@
<BenModal @bind-Visible="@_showSameNameDialog" Title="File Already Exists">
    <ChildContent>
        @if (_sameNameMatch is not null)
        {
            <p>You already have a file named <strong>@_sameNameMatch.FileName</strong>.</p>
            <p class="text-secondary small mb-0">
                Keep both as separate files, or cancel and use the grid's <em>Replace</em> button on
                the existing file to swap its contents (which keeps comments, votes and case links).
            </p>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-primary" @onclick="ConfirmKeepBoth">Keep Both</button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showSameNameDialog = false)">Cancel</button>
        </div>
    </ChildContent>
</BenModal>

@* Delete: the two questions (item 180 Phase B). A small, single-purpose dialog — Ben's rule
   keeps large surfaces on pages, and this is one file and two yes/no questions. *@
<BenConfirmDialog @bind-Visible="@_showDeleteConfirm" Title="Delete File" Width="420px"
                  Busy="@_isDeleting" BusyText="Deleting…" ConfirmText="Delete"
                  OnConfirm="ConfirmPlainDelete" OnCancel="@(() => _deleteTarget = null)">
    @if (_deleteTarget is not null)
    {
        <p class="mb-1">Delete <strong>@_deleteTarget.FileName</strong>?</p>
        @if (_deleteUsage is { PersonShares: > 0 } or { IsPublic: true })
        {
            <p class="text-secondary small mb-0">
                It is @(_deleteUsage!.IsPublic ? "public" : "")@(_deleteUsage.IsPublic && _deleteUsage.PersonShares > 0 ? " and " : "")@(_deleteUsage.PersonShares > 0 ? $"shared with {_deleteUsage.PersonShares} {(_deleteUsage.PersonShares == 1 ? "person" : "people")}" : ""). Those shares end with it.
            </p>
        }
    }
</BenConfirmDialog>

<BenModal @bind-Visible="@_showInUseDialog" Title="This file is in use">
    <ChildContent>
        @if (_deleteTarget is not null && _deleteUsage is not null)
        {
            <p class="mb-2"><strong>@_deleteTarget.FileName</strong> is being used by:</p>
            <ul class="small mb-3" data-testid="file-usage-list">
                @foreach (var o in _deleteUsage.Organizations)
                {
                    <li>
                        <strong>@o.OrganizationName</strong>
                        <span class="text-secondary">
                            — @UsageSentence(o)
                        </span>
                    </li>
                }
            </ul>

            @if (_deleteStep == DeleteStep.AskEverywhere)
            {
                <p class="mb-1 fw-semibold">Do you want it removed everywhere it is shared?</p>
                <p class="text-secondary small">
                    Yes ends every share, removes the copies those groups took — including any
                    comments and votes on them — and then deletes the file. There is no undo.
                </p>
            }
            else
            {
                <p class="mb-1 fw-semibold">Do you still want it out of your files?</p>
                <p class="text-secondary small">
                    If so, the file and its details are handed to the group using it. It leaves
                    your files, the group keeps everything that points at it, and only people in
                    that group with the right permission will see it. You will not be able to get
                    it back.
                </p>
                @if (_deleteUsage.Organizations.Count > 1)
                {
                    <label class="form-label small fw-semibold" for="reassign-org">Hand it to</label>
                    <select id="reassign-org" class="form-select form-select-sm mb-2" style="max-width:320px" @bind="@_reassignOrgId">
                        @foreach (var o in _deleteUsage.Organizations)
                        {
                            <option value="@o.OrganizationId">@o.OrganizationName</option>
                        }
                    </select>
                }
            }

            @if (_deleteError is not null)
            {
                <div class="alert alert-danger py-2 mt-2 mb-0">@_deleteError</div>
            }
        }
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            @if (_deleteStep == DeleteStep.AskEverywhere)
            {
                <button type="button" class="btn btn-danger" data-testid="delete-everywhere" @onclick="ConfirmDeleteEverywhere" disabled="@_isDeleting">
                    @(_isDeleting ? "Removing…" : "Yes, remove it everywhere")
                </button>
                <button type="button" class="btn btn-outline-secondary" data-testid="delete-not-everywhere" @onclick="@(() => _deleteStep = DeleteStep.AskReassign)" disabled="@_isDeleting">No</button>
            }
            else
            {
                <button type="button" class="btn btn-primary" data-testid="reassign-file" @onclick="ConfirmReassign" disabled="@_isDeleting">
                    @(_isDeleting ? "Handing over…" : $"Hand it to {ReassignOrgName()}")
                </button>
                <button type="button" class="btn btn-outline-secondary" data-testid="keep-file" @onclick="CloseDeleteDialogs" disabled="@_isDeleting">Keep it</button>
            }
        </div>
    </ChildContent>
</BenModal>

@* Replace File Dialog (item #6 phase 3) *@
<BenModal @bind-Visible="@_showReplaceDialog" Title="Replace File">
    <ChildContent>
        @if (_replaceTarget is not null)
        {
            <p class="text-secondary mb-3">Replacing: <strong>@_replaceTarget.FileName</strong></p>

            @if (_replaceSelectedFile is null)
            {
                <label class="form-label">New file</label>
                <InputFile OnChange="@OnReplaceFileSelected" class="form-control" />
            }
            else
            {
                <p class="mb-2">New file: <strong>@_replaceSelectedFile.Name</strong></p>

                @if (_loadingImpact)
                {
                    <p class="text-secondary small">Checking which cases hold a copy...</p>
                }
                else if (_replaceImpact is not null)
                {
                    @if (_replaceImpact.Cases.Count == 0)
                    {
                        <p class="text-secondary small">No cases currently hold a copy of this file.</p>
                    }
                    else
                    {
                        <p class="small fw-semibold mb-1">This will also update the copy in:</p>
                        <ul class="small mb-0">
                            @foreach (var c in _replaceImpact.Cases)
                            {
                                <li>
                                    @c.CaseTitle <span class="text-secondary">(@c.OrganizationName)</span>
                                    @if (c.CommentCount > 0)
                                    {
                                        <span class="badge text-bg-warning ms-1">@c.CommentCount comment@(c.CommentCount == 1 ? "" : "s")</span>
                                    }
                                    @if (c.VoteCount > 0)
                                    {
                                        <span class="badge text-bg-warning ms-1">@c.VoteCount vote@(c.VoteCount == 1  ? "" : "s")</span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            }

            @if (_replaceError is not null)
            {
                <div class="alert alert-danger py-2 mt-3 mb-0">@_replaceError</div>
            }
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-primary" @onclick="ConfirmReplace" disabled="@(!(_replaceSelectedFile is not null && !_loadingImpact && !_isReplacing))">
                @(_isReplacing ? "Replacing..." : "Replace")
            </button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showReplaceDialog = false)">Cancel</button>
        </div>
    </ChildContent>
</BenModal>

@* Share with Org Dialog *@
<BenModal @bind-Visible="@_showShareDialog" Title="Share with Organization">
    <ChildContent>
        @if (_sharingFile is not null)
        {
            <p class="text-secondary mb-3">Sharing: <strong>@_sharingFile.FileName</strong></p>
            <div class="mb-3">
                <label class="form-label">Organization</label>
                <BenSelect Data="@_myOrgs" @bind-Value="@_shareOrgId" TextField="@nameof(OrganizationSummaryResponse.Name)" ValueField="@nameof(OrganizationSummaryResponse.OrganizationId)" Width="100%" />
            </div>
            <div class="mb-3">
                <label class="form-label">Visibility</label>
                <BenSelect Data="@_visibilityOptions" @bind-Value="@_shareVisibility" TextField="Label" ValueField="Value" Width="100%" />
            </div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-primary" @onclick="ConfirmShare">Share</button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showShareDialog = false)">Cancel</button>
        </div>
    </ChildContent>
</BenModal>

@code {
    // ── State ────────────────────────────────────────────────────────────────
    private IReadOnlyList<UploadFileRecord> _files = [];
    private LoadResult<UploadFileRecord> _filesResult;
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];
    private IReadOnlyList<OrganizationSummaryResponse> _myOrgs = [];

    private bool _showUploadPanel;
    private bool _isUploading;
    private string? _uploadError;

    // ── Chunked upload state ─────────────────────────────────────────────────
    // The picked files' FACTS live here; their bytes never enter the circuit. JavaScript holds
    // the File objects (chunked-upload.js) and this page holds names, sizes and progress.
    private const string FileInputId = "chunked-upload-input-7f31";
    private IReadOnlyList<PickedFile> _pickedFiles = [];
    private List<FileProgress> _progress = [];
    private DotNetObjectReference<UploadFiles>? _selfRef;

    private sealed record PickedFile(string Name, long Size, string ContentType);

    private enum UploadState { Waiting, Sending, Done, Failed }

    private sealed class FileProgress
    {
        public required string Name { get; init; }
        public long Total { get; init; }
        public long Sent { get; set; }
        public UploadState State { get; set; } = UploadState.Waiting;
        public string? Error { get; set; }
    }

    private NewUploadModel _newUpload = new();

    // Share dialog
    private bool _showShareDialog;
    private UploadFileRecord? _sharingFile;
    private Guid _shareOrgId;
    private FileShareVisibility _shareVisibility = FileShareVisibility.OrgAdminsOnly;

    // Same-filename-on-upload prompt (item #6 phase 3)
    private bool _showSameNameDialog;
    private UploadFileRecord? _sameNameMatch;

    // Delete: the two questions (item 180 Phase B)
    private enum DeleteStep { AskEverywhere, AskReassign }
    private bool _showDeleteConfirm;
    private bool _showInUseDialog;
    private UploadFileRecord? _deleteTarget;
    private FileUsageRecord? _deleteUsage;
    private DeleteStep _deleteStep = DeleteStep.AskEverywhere;
    private Guid _reassignOrgId;
    private bool _isDeleting;
    private string? _deleteError;

    // Replace dialog (item #6 phase 3)
    private bool _showReplaceDialog;
    private UploadFileRecord? _replaceTarget;
    private IBrowserFile? _replaceSelectedFile;
    private ReplaceImpactRecord? _replaceImpact;
    private bool _loadingImpact;
    private bool _isReplacing;
    private string? _replaceError;

    private static readonly List<(string Label, FileShareVisibility Value)> _visibilityOptions =
    [
        ("Org Admins Only", FileShareVisibility.OrgAdminsOnly),
        ("All Org Members",  FileShareVisibility.OrgMembers),
        ("Public",           FileShareVisibility.Public)
    ];

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (!await TokenStore.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!TokenStore.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!await TokenStore.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        var filesTask = Api.GetUploadFilesAsync();
        var typesTask = Api.GetUploadFileTypesAsync();
        var orgsTask  = Api.GetMyOrganizationsAsync();

        await Task.WhenAll(filesTask, typesTask, orgsTask);

        _filesResult = filesTask.Result;
        _files       = _filesResult.Items;
        _fileTypes   = typesTask.Result.Items;
        _myOrgs      = orgsTask.Result.Items;

        if (_fileTypes.Any())
            _newUpload.FileTypeId = _fileTypes[0].Id;
        if (_myOrgs.Any())
            _shareOrgId = _myOrgs[0].OrganizationId;
    }

    // ── Upload ───────────────────────────────────────────────────────────────
    //
    // Chunked (item: uploads past Cloudflare's 100 MB): the browser cuts each file into chunks
    // sized by the server and PUTs them to this site's relay endpoints — the bytes never ride
    // the circuit. This page only starts sessions, mints tickets, and draws progress. SVGs are
    // the one exception: the server sanitises them as a whole document, so they go through the
    // classic multipart endpoint — also from the browser, via the classic relay.
    private async Task OnFilesPicked()
    {
        var picked = await JS.InvokeAsync<PickedFile[]>("benChunkedUpload.readSelection", FileInputId);
        _pickedFiles = picked;
        _progress = picked.Select(f => new FileProgress { Name = f.Name, Total = f.Size }).ToList();
        _uploadError = GetExtensionError();
    }

    private string? GetExtensionError()
    {
        var type = _fileTypes.FirstOrDefault(t => t.Id == _newUpload.FileTypeId);
        if (type is null || type.AllowAllExtensions) return null;

        var refused = _pickedFiles
            .Select(f => Path.GetExtension(f.Name))
            .Where(ext => !FileExtensionPatternMatcher.IsAllowedByPatterns(type.AllowedPatterns, ext))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (refused.Count == 0) return null;

        var allowed = type.AllowedPatterns.Count > 0
            ? string.Join(", ", type.AllowedPatterns)
            : "(none defined)";
        return $"File extension{(refused.Count > 1 ? "s" : "")} {string.Join(", ", refused.Select(e => $"'{e}'"))} " +
               $"not allowed for type '{type.Name}'. Allowed: {allowed}";
    }

    private async Task UploadFile()
    {
        if (_pickedFiles.Count == 0 || TokenStore.UserEmail is null) return;

        // Re-validate extensions in case the file type selection changed after files were picked
        _uploadError = GetExtensionError();
        if (_uploadError is not null) return;

        // Same-name-on-upload detection (item #6 phase 3) — only among files this user actually
        // owns (GetUploadFilesAsync currently returns every user's files, tracked as a separate,
        // pre-existing authorization gap — not something to widen scope fixing here).
        var myUserId = TokenStore.UserId ?? Guid.Empty;
        var existing = _pickedFiles
            .Select(p => _files.FirstOrDefault(f =>
                f.AppUserId == myUserId && string.Equals(f.FileName, p.Name, StringComparison.OrdinalIgnoreCase)))
            .FirstOrDefault(f => f is not null);
        if (existing is not null)
        {
            _sameNameMatch = existing;
            _showSameNameDialog = true;
            return;
        }

        await DoUploadAsync();
    }

    private async Task ConfirmKeepBoth()
    {
        _showSameNameDialog = false;
        await DoUploadAsync();
    }

    private async Task DoUploadAsync()
    {
        _isUploading = true;
        _uploadError = null;
        _selfRef ??= DotNetObjectReference.Create(this);

        var anyFailed = false;
        try
        {
            // One file at a time, deliberately: parallel files would split the same home-upstream
            // bandwidth without finishing anything sooner, and sequential keeps every failure
            // attributable to one file.
            for (var i = 0; i < _pickedFiles.Count; i++)
            {
                var file = _pickedFiles[i];
                var progress = _progress[i];
                progress.State = UploadState.Sending;
                StateHasChanged();

                try
                {
                    var record = await UploadOneAsync(i, file);
                    progress.State = UploadState.Done;
                    progress.Sent = progress.Total;
                    _files = [record, .._files];
                }
                catch (Exception ex)
                {
                    progress.State = UploadState.Failed;
                    progress.Error = ex.Message;
                    anyFailed = true;
                }
                StateHasChanged();
            }

            if (!anyFailed)
            {
                await JS.InvokeVoidAsync("benChunkedUpload.clearSelection", FileInputId);
                _pickedFiles = [];
                _progress = [];
                _showUploadPanel = false;
                _newUpload = new NewUploadModel { FileTypeId = _fileTypes.FirstOrDefault()?.Id ?? Guid.Empty };
            }
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task<UploadFileRecord> UploadOneAsync(int fileIndex, PickedFile file)
    {
        var accessToken = TokenStore.AccessToken
            ?? throw new InvalidOperationException("Your sign-in has expired — sign in again to upload.");

        var isSvg = Path.GetExtension(file.Name).Equals(".svg", StringComparison.OrdinalIgnoreCase);
        if (isSvg)
        {
            // The classic multipart path, relayed browser-side. The nonce exists purely to bind
            // the ticket to this one upload gesture.
            var nonce = Guid.NewGuid();
            return await JS.InvokeAsync<UploadFileRecord>("benChunkedUpload.uploadClassic", fileIndex, new
            {
                nonce,
                ticket = UploadTickets.Protect(nonce, accessToken),
                uploadFileTypeId = _newUpload.FileTypeId,
                appUserId = TokenStore.UserId ?? Guid.Empty,
                description = _newUpload.Description ?? string.Empty,
                isPublic = _newUpload.IsPublic,
            });
        }

        var (session, error) = await Api.StartChunkedUploadAsync(new StartChunkedUploadRequest(
            file.Name, file.ContentType, file.Size, _newUpload.FileTypeId,
            _newUpload.Description, _newUpload.IsPublic));
        if (session is null)
            throw new InvalidOperationException(error ?? "The upload could not be started. Please try again.");

        return await JS.InvokeAsync<UploadFileRecord>("benChunkedUpload.uploadFile", _selfRef, fileIndex, new
        {
            id = session.Id,
            ticket = UploadTickets.Protect(session.Id, accessToken),
            chunkMaxBytes = session.ChunkMaxBytes,
        });
    }

    [JSInvokable]
    public void OnChunkProgress(int fileIndex, long sent, long total)
    {
        if (fileIndex < 0 || fileIndex >= _progress.Count) return;
        _progress[fileIndex].Sent = sent;
        StateHasChanged();
    }

    public void Dispose() => _selfRef?.Dispose();

    // ── Download ─────────────────────────────────────────────────────────────
    private async Task DownloadFile(UploadFileRecord file)
    {
        var result = await Api.DownloadFileAsync(file.Id);
        if (result is null) return;

        var (data, contentType, fileName) = result.Value;
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, contentType, fileName);
    }

    // ── Delete (item 180 Phase B) ─────────────────────────────────────────────
    //
    // The usage comes first, and decides which dialog opens. A file nobody else is using gets
    // a plain confirm. A file a group is using gets the two questions Ben specified: remove it
    // everywhere? and if not, still delete it — by handing it to the group?
    private async Task DeleteFile(UploadFileRecord file)
    {
        _deleteTarget = file;
        _deleteError  = null;
        _deleteStep   = DeleteStep.AskEverywhere;
        _deleteUsage  = await Api.GetUploadFileUsageAsync(file.Id);

        if (_deleteUsage is { InUseByAnOrganization: true })
        {
            _reassignOrgId = _deleteUsage.Organizations[0].OrganizationId;
            _showInUseDialog = true;
        }
        else
        {
            _showDeleteConfirm = true;
        }
    }

    private async Task ConfirmPlainDelete()
    {
        if (_deleteTarget is null) return;
        _isDeleting = true;
        var ok = await Api.DeleteUploadFileAsync(_deleteTarget.Id);
        _isDeleting = false;
        if (ok)
        {
            _files = [.._files.Where(f => f.Id != _deleteTarget.Id)];
            CloseDeleteDialogs();
        }
        else
        {
            // The server refuses a plain delete once a group is using it — re-ask with the usage.
            _deleteUsage = await Api.GetUploadFileUsageAsync(_deleteTarget.Id);
            _showDeleteConfirm = false;
            if (_deleteUsage is { InUseByAnOrganization: true })
            {
                _reassignOrgId = _deleteUsage.Organizations[0].OrganizationId;
                _showInUseDialog = true;
            }
            else
            {
                _deleteError = "The file could not be deleted.";
            }
        }
    }

    private async Task ConfirmDeleteEverywhere()
    {
        if (_deleteTarget is null) return;
        _isDeleting = true; _deleteError = null;
        var result = await Api.DeleteUploadFileEverywhereAsync(_deleteTarget.Id);
        _isDeleting = false;
        if (result is null)
        {
            _deleteError = "Everything shared was removed, but something else still holds this file, so it stays.";
            return;
        }
        _files = [.._files.Where(f => f.Id != _deleteTarget.Id)];
        CloseDeleteDialogs();
    }

    private async Task ConfirmReassign()
    {
        if (_deleteTarget is null) return;
        _isDeleting = true; _deleteError = null;
        var moved = await Api.ReassignUploadFileAsync(_deleteTarget.Id, _reassignOrgId);
        _isDeleting = false;
        if (moved is null)
        {
            _deleteError = "The file could not be handed over.";
            return;
        }
        // It has left this person's files, which is what they asked for.
        _files = [.._files.Where(f => f.Id != _deleteTarget.Id)];
        CloseDeleteDialogs();
    }

    private void CloseDeleteDialogs()
    {
        _showDeleteConfirm = false;
        _showInUseDialog = false;
        _deleteTarget = null;
        _deleteUsage = null;
        _deleteError = null;
    }

    private string ReassignOrgName()
        => _deleteUsage?.Organizations.FirstOrDefault(o => o.OrganizationId == _reassignOrgId)?.OrganizationName ?? "the group";

    private static string UsageSentence(FileUsageOrganizationRecord o)
    {
        var parts = new List<string>();
        if (o.Shares > 0)      parts.Add(o.Shares == 1 ? "a share" : $"{o.Shares} shares");
        if (o.CaseCopies > 0)  parts.Add(o.CaseCopies == 1 ? "a copy on a case" : $"copies on {o.CaseCopies} cases");
        if (o.GroupCopies > 0) parts.Add(o.GroupCopies == 1 ? "a copy in its files" : $"{o.GroupCopies} copies in its files");
        if (o.DirectLinks > 0) parts.Add(o.DirectLinks == 1 ? "one direct link" : $"{o.DirectLinks} direct links");
        return string.Join(", ", parts);
    }

    // ── Replace (item #6 phase 3) ───────────────────────────────────────────────
    private void OpenReplaceDialog(UploadFileRecord file)
    {
        _replaceTarget = file;
        _replaceSelectedFile = null;
        _replaceImpact = null;
        _replaceError = null;
        _showReplaceDialog = true;
    }

    private async Task OnReplaceFileSelected(InputFileChangeEventArgs e)
    {
        _replaceSelectedFile = e.File;
        await LoadReplaceImpactAsync();
    }

    private async Task LoadReplaceImpactAsync()
    {
        if (_replaceTarget is null) return;
        _loadingImpact = true;
        try { _replaceImpact = await Api.GetReplaceImpactAsync(_replaceTarget.Id); }
        catch { _replaceImpact = null; }
        finally { _loadingImpact = false; }
    }

    private async Task ConfirmReplace()
    {
        if (_replaceTarget is null || _replaceSelectedFile is null) return;

        _isReplacing = true;
        _replaceError = null;
        try
        {
            var content = new MultipartFormDataContent();
            // No practical upload size limit for now — a future limit belongs at app-settings /
            // per-person / per-org / per-case / per-investigation scope, not a blanket cap here.
            var maxSize = long.MaxValue;
            await using var stream = _replaceSelectedFile.OpenReadStream(maxSize);
            var fileContent = new StreamContent(stream);
            var contentType = string.IsNullOrWhiteSpace(_replaceSelectedFile.ContentType)
                ? "application/octet-stream"
                : _replaceSelectedFile.ContentType;
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
            content.Add(fileContent, "file", _replaceSelectedFile.Name);

            var result = await Api.ReplaceUploadFileAsync(_replaceTarget.Id, content);
            if (result is not null)
            {
                _files = [.._files.Select(f => f.Id == result.Id ? result : f)];
                _showReplaceDialog = false;
            }
            else
            {
                _replaceError = "Replace failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _replaceError = $"Error: {ex.Message}";
        }
        finally
        {
            _isReplacing = false;
        }
    }

    // ── Share ────────────────────────────────────────────────────────────────
    private void OpenShareDialog(UploadFileRecord file)
    {
        _sharingFile = file;
        _shareVisibility = FileShareVisibility.OrgAdminsOnly;
        _showShareDialog = true;
    }

    private async Task ConfirmShare()
    {
        if (_sharingFile is null) return;

        // Who's sharing is now derived server-side from the caller's own token, not sent here.
        await Api.ShareFileWithOrgAsync(_sharingFile.Id, new ShareFileWithOrgRequest(
            _shareOrgId, _shareVisibility));

        _showShareDialog = false;
    }

