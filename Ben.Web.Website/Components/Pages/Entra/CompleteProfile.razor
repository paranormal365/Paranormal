@page "/entra/complete-profile"

@inject EntraTokenHolder EntraTokenHolder
@inject IWebApiClient WebApiClient
@inject IWebApiAuthService AuthService
@inject IWebApiTokenStore TokenStore
@inject NavigationManager NavManager

<PageTitle>Complete Your Profile</PageTitle>

@*
    Where an Entra sign-in lands when there is no local account behind it yet.

    The @code block is carried over unchanged — in particular the two-step link flow, where the
    Entra token proves the Microsoft identity and the password proves the local account, and the
    forceLoad after registration that lets the OIDC middleware repopulate EntraTokenHolder so
    MainLayout's bridge can find the new user. Only Telerik inputs/buttons became Bootstrap ones.
*@

<div class="d-flex align-items-center justify-content-center p-3">
    <div class="card shadow-sm" style="width:100%;max-width:29rem;">
        <div class="card-body p-4">

        @if (!EntraTokenHolder.IsEntraAuthenticated)
        {
            <p class="text-muted mb-0">No active Microsoft session found. <a href="/login">Return to login</a>.</p>
        }
        else if (_mode == PageMode.Choose)
        {
            <h2 class="h4 mb-1">Welcome</h2>
            <p class="text-muted mb-4">
                We don't have a local account for
                <strong>@EntraTokenHolder.Email</strong>.
                What would you like to do?
            </p>

            <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary w-100"
                        @onclick="@(() => _mode = PageMode.CreateNew)">
                    Create a new account
                </button>
                <button type="button" class="btn btn-outline-secondary w-100"
                        @onclick="@(() => _mode = PageMode.LinkExisting)">
                    I already have an account — link it
                </button>
            </div>
        }
        else if (_mode == PageMode.CreateNew)
        {
            <h2 class="h4 mb-1">Create Account</h2>
            <p class="text-muted mb-3">
                Signing in as <strong>@EntraTokenHolder.Email</strong>
            </p>

            <div class="mb-3">
                <label class="form-label" for="cp-name">Display Name <span class="text-danger">*</span></label>
                <input id="cp-name" class="form-control" @bind="_displayName" @bind:event="oninput"
                       placeholder="Your name" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="cp-email">Email</label>
                <input id="cp-email" class="form-control" value="@EntraTokenHolder.Email" disabled />
                <div class="form-text">Provided by Microsoft — cannot be changed here.</div>
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@_error</div>
            }

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-link"
                        @onclick="@(() => { _mode = PageMode.Choose; _error = null; })">
                    Back
                </button>
                <button type="button" class="btn btn-primary flex-grow-1"
                        disabled="@(_saving || string.IsNullOrWhiteSpace(_displayName))"
                        @onclick="CreateAccount">
                    @(_saving ? "Creating…" : "Create Account")
                </button>
            </div>
        }
        else if (_mode == PageMode.LinkExisting)
        {
            <h2 class="h4 mb-1">Link Your Account</h2>
            <p class="text-muted mb-3">
                Sign in with your existing account to link
                <strong>@EntraTokenHolder.Email</strong> to it.
            </p>

            <div class="mb-3">
                <label class="form-label" for="cp-link-email">Account Email <span class="text-danger">*</span></label>
                <input id="cp-link-email" class="form-control" @bind="_linkEmail" @bind:event="oninput"
                       placeholder="you@example.com" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="cp-link-pw">Password <span class="text-danger">*</span></label>
                <input id="cp-link-pw" type="password" class="form-control" @bind="_linkPassword" @bind:event="oninput"
                       placeholder="••••••••" autocomplete="current-password" />
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@_error</div>
            }
            @if (_linkSuccess)
            {
                <div class="alert alert-success py-2 mb-3">
                    Microsoft account linked! Redirecting…
                </div>
            }

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-link"
                        @onclick="@(() => { _mode = PageMode.Choose; _error = null; })">
                    Back
                </button>
                <button type="button" class="btn btn-primary flex-grow-1"
                        disabled="@_saving" @onclick="LinkAccount">
                    @(_saving ? "Linking…" : "Sign In & Link")
                </button>
            </div>
        }

        </div>
    </div>
</div>

@code {
    private enum PageMode { Choose, CreateNew, LinkExisting }

    private PageMode _mode = PageMode.Choose;
    private string   _displayName  = string.Empty;
    private string   _linkEmail    = string.Empty;
    private string   _linkPassword = string.Empty;
    private string?  _error;
    private bool     _saving;
    private bool     _linkSuccess;

    protected override void OnInitialized()
    {
        // If user navigated here without an Entra session, or is already authenticated locally, redirect away.
        if (!EntraTokenHolder.IsEntraAuthenticated)
            NavManager.NavigateTo("/login");
    }

    // ── Create new account ────────────────────────────────────────────────────

    private async Task CreateAccount()
    {
        _saving = true;
        _error  = null;

        try
        {
            var payload = new EntraRegisterPayload(DisplayName: _displayName);

            // The Entra access token is sent explicitly — the server validates it and reads OID/
            // email from its own claims, never from this payload (see IWebApiClient.EntraRegisterAsync).
            var result = await WebApiClient.EntraRegisterAsync(EntraTokenHolder.AccessToken ?? string.Empty, payload);

            if (result is null)
            {
                _error = "Registration failed. An account with this email may already exist — try 'Link existing account'.";
                return;
            }

            // Force a full page reload so the OIDC middleware repopulates EntraTokenHolder,
            // and MainLayout.TryBridgeEntraAuthAsync finds the user via FindByLoginAsync.
            NavManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Link to existing account ──────────────────────────────────────────────

    private async Task LinkAccount()
    {
        _saving = true;
        _error  = null;

        try
        {
            // Step 1: link the caller's Entra identity (proven by the Entra access token, sent
            // explicitly) to the target local account (proven by password, checked server-side).
            // No local session is needed yet — that's the whole point of this endpoint.
            var linkPayload = new EntraLinkPayload(Email: _linkEmail, Password: _linkPassword);
            var linkOk = await WebApiClient.EntraLinkAsync(EntraTokenHolder.AccessToken ?? string.Empty, linkPayload);
            if (!linkOk)
            {
                _error = "Account linking failed. Check your email and password, or this Microsoft identity may already be linked elsewhere.";
                return;
            }

            // Step 2: now establish the actual local session.
            var loginOk = await AuthService.LoginAsync(_linkEmail, _linkPassword);
            if (!loginOk)
            {
                // Link succeeded but the follow-up sign-in didn't — shouldn't happen since Link
                // just verified the same credentials, but send them to /login rather than stall here.
                NavManager.NavigateTo("/login");
                return;
            }

            _linkSuccess = true;
            // Small delay so the user sees the success message, then navigate home.
            await Task.Delay(1200);
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
