@page "/media-library"
@using Ben.Web.Website.Library.Media
@using Ben.Web.Services
@inject IBenUserState UserState
@inject NavigationManager NavManager

<FeatureGate Flag="@SiteFeatures.MediaLibrary">
    <PageTitle>Media Library</PageTitle>

    @if (!UserState.IsAuthenticated)
    {
        <div class="container py-4"><p class="text-muted">You must be signed in to view your media library.</p></div>
    }
    else
    {
        <div class="container-fluid py-3">
            <div class="d-flex align-items-baseline gap-3 mb-3">
                <h3 class="mb-0">Media Library</h3>
                <a href="/audio/scans" class="small" id="media-library-scans">EVP scans</a>
            </div>
            <p class="text-secondary small mb-3">
                Everything you have uploaded. Files other people shared with you live on the case,
                the group or the investigation they belong to.
            </p>
            @* "Mine", not public and not everything (Ben, 2026-09-21). Asked of the server, so the
               page no longer receives the whole site's media in order to hide it. *@
            <MediaLibraryGrid ShowVoting="true" Scope="personal" />
        </div>
    }
</FeatureGate>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) NavManager.NavigateTo(Ben.Web.Website.Library.Kit.SignInLink.For(NavManager));
    }
}
