@page "/forgot-password"

@inject IWebApiIdentityClient IdentityClient
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Help

<PageTitle>Forgot Password</PageTitle>

@*
    Anonymous on purpose, and the outcome is the same sentence whether or not the address has an
    account — the endpoint is built that way (a 200 either way) and this page must not undo it by
    wording success differently from "no such account".

    Also the answer to item 142's underlying gap: an account created by signing in with Microsoft
    has no password, and completing this flow SETS one — resetting a password that was never set
    is how a first one is made. The wording below says so, because the person most likely to be
    here is exactly that person.
*@

<div class="d-flex align-items-center justify-content-center p-3">
    <div class="card shadow-sm" style="width:100%;max-width:26rem;">
        <div class="card-body p-4">
            <h2 class="h4 mb-3">Reset your password<HelpLink Slug="getting-started" Anchor="forgot-your-password-or-never-had-one" /></h2>

            @if (_sent)
            {
                <div class="alert alert-success">
                    If that address has an account, a reset link is on its way. Check your inbox —
                    the link brings you back here to choose a new password.
                </div>
                <p class="text-secondary small">
                    Nothing arriving? Check your spam folder, and make sure you typed the address
                    your account uses.
                </p>
                <a href="/login" class="btn btn-outline-secondary w-100">Back to sign in</a>
            }
            else
            {
                <p class="text-secondary small">
                    Enter your email and we'll send a link to choose a new password. This also
                    works for adding a password to an account that signs in with Microsoft.
                </p>

                <BenInteractiveOnly>
                <EditForm Model="@this" OnValidSubmit="SendAsync" FormName="ForgotPasswordForm">
                    <div class="mb-3">
                        <label class="form-label" for="forgot-email">Email</label>
                        <InputText id="forgot-email" class="form-control" @bind-Value="_email"
                                   placeholder="you@example.com" autocomplete="username" />
                    </div>

                    @if (_error is not null)
                    {
                        <div class="alert alert-danger py-2 mb-3">@_error</div>
                    }

                    <button type="submit" class="btn btn-primary w-100" disabled="@_sending">
                        @(_sending ? "Sending…" : "Send reset link")
                    </button>
                </EditForm>
                </BenInteractiveOnly>

                <p class="text-center text-secondary small mt-3 mb-0">
                    <a href="/login">Back to sign in</a>
                </p>
            }
        </div>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private bool _sending;
    private bool _sent;
    private string? _error;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _error = "Enter the email address your account uses.";
            return;
        }

        _sending = true;
        _error = null;

        var ok = await IdentityClient.ForgotPasswordAsync(_email.Trim());

        _sending = false;

        if (!ok)
        {
            // False means the request itself failed — unreachable or rate-limited — never
            // "no such account", which the endpoint deliberately does not disclose.
            _error = "Couldn't send the email just now. Wait a moment and try again.";
            return;
        }

        _sent = true;
    }
}
