@page "/styleguide"
@inject BenToastService Toasts
@inject IWebHostEnvironment Env

<PageTitle>Style guide</PageTitle>

@*
    Development-only harness for the Kit components and the Telerik widgets kept by design.

    Its job is to make the two halves of the UI checkable side by side in both themes: if a kept
    Telerik widget still reads as a control suite dropped onto the template, it shows up here
    rather than three waves into the migration. Toggle light/dark in the header while looking at
    this page.
*@

@if (!Env.IsDevelopment())
{
    <div class="alert alert-warning">The style guide is only available in Development.</div>
}
else
{
<BenPageHeader Title="Style guide"
               Subtitle="Kit + kept Telerik"
               Icon="layers"
               Description="Every shared component, so the template's own controls and the Telerik widgets kept by design can be compared in both themes."
               Breadcrumbs="_crumbs" />

<div class="row">

    <div class="col-xl-6">
        <BenPanel Title="Skin tokens" Subtitle="themes/signal.css">
            @*
                Signal phase 1. The skin names every colour, shape and shadow ONCE, as a --ben-*
                token, and feeds Bootstrap's own --bs-* from it; nothing else in the site should
                carry a colour literal. These swatches read the live values, so this panel tells
                the truth about whatever is in themes/signal.css right now rather than about what
                it said when this was written.

                Flip light/dark in the header: every chip here must change and none may vanish.
                Every fault found so far has been light-only.
            *@
            <h4 class="h6 mb-2">Surfaces and lines</h4>
            <div class="sg-tokens mb-3">
                @foreach (var (token, label) in Surfaces)
                {
                    <div class="sg-token">
                        <span class="sg-chip" style="@($"background:var({token})")"></span>
                        <code>@token</code><small>@label</small>
                    </div>
                }
            </div>

            <h4 class="h6 mb-2">Ink</h4>
            <div class="sg-tokens mb-3">
                @foreach (var (token, label) in Inks)
                {
                    <div class="sg-token">
                        <span class="sg-chip sg-chip--text" style="@($"color:var({token})")">Aa</span>
                        <code>@token</code><small>@label</small>
                    </div>
                }
            </div>

            <h4 class="h6 mb-2">Accent</h4>
            <div class="sg-tokens mb-3">
                <div class="sg-token"><span class="sg-chip" style="background:var(--ben-accent)"></span><code>--ben-accent</code><small>primary</small></div>
                <div class="sg-token"><span class="sg-chip" style="background:var(--ben-accent-2)"></span><code>--ben-accent-2</code><small>secondary</small></div>
                <div class="sg-token"><span class="sg-chip" style="background:var(--ben-accent-soft)"></span><code>--ben-accent-soft</code><small>tint</small></div>
                <div class="sg-token"><span class="sg-chip sg-chip--grad"></span><code>--ben-accent-grad</code><small>gradient</small></div>
            </div>

            <h4 class="h6 mb-2">Shape and depth</h4>
            <div class="sg-tokens">
                @foreach (var (token, label) in Shapes)
                {
                    <div class="sg-token">
                        <span class="sg-chip sg-chip--plain" style="@($"border-radius:var({token})")"></span>
                        <code>@token</code><small>@label</small>
                    </div>
                }
                @foreach (var (token, label) in Shadows)
                {
                    <div class="sg-token">
                        <span class="sg-chip sg-chip--plain" style="@($"box-shadow:var({token})")"></span>
                        <code>@token</code><small>@label</small>
                    </div>
                }
            </div>
        </BenPanel>

        <BenPanel Title="The brand lockup" Subtitle="ben-brand">
            @*
                The mark is a white ghost in a GREEN ring with amber windows, and Signal is violet
                and cyan — at full colour it is the only green thing on a page and reads as a
                sticker. It is turned white by a CSS filter and set in a gradient tile, which
                leaves the brand file itself untouched: the full-colour original still serves the
                favicon, the app icon, the iOS listing and the flyers.
            *@
            <a class="ben-brand fs-4" href="/">
                <span class="ben-brand__tile"><img src="/static/images/is-haunted-logo.svg" alt="" /></span>
                <span>IsHaunted<span class="ben-brand__dot">.com</span></span>
            </a>
        </BenPanel>
    </div>

    <div class="col-xl-6">
        <BenPanel Title="Buttons &amp; inputs" Subtitle="native Bootstrap">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-primary">Primary</button>
                <button class="btn btn-secondary">Secondary</button>
                <button class="btn btn-success">Success</button>
                <button class="btn btn-danger">Danger</button>
                <button class="btn btn-outline-secondary">Outline</button>
                <button class="btn btn-link">Link</button>
            </div>
            <div class="mb-3">
                <label class="form-label" for="sg-text">Text</label>
                <input id="sg-text" class="form-control" @bind="_text" placeholder="Type here" />
                <div class="form-text">Bound value: <code>@_text</code></div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="sg-select">Select</label>
                <select id="sg-select" class="form-select" @bind="_choice">
                    <option>First</option><option>Second</option><option>Third</option>
                </select>
            </div>
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="sg-switch" @bind="_switch" />
                <label class="form-check-label" for="sg-switch">Switch (@(_switch ? "on" : "off"))</label>
            </div>
            <label class="form-label" for="sg-range">Range: @_range</label>
            <input id="sg-range" type="range" class="form-range" min="0" max="100" @bind="_range" @bind:event="oninput" />
        </BenPanel>

        <BenPanel Title="BenTabs" Subtitle="TelerikTabStrip replacement">
            <BenTabs @bind-ActiveIndex="_tab">
                <BenTab Title="Overview" Icon="grid">
                    <p class="mb-0">Panels render from the component's own tree — no <code>data-bs-toggle</code>.</p>
                </BenTab>
                <BenTab Title="Form" Icon="edit" Badge="2">
                    <label class="form-label" for="sg-tabinput">An input inside a tab</label>
                    <input id="sg-tabinput" class="form-control" @bind="_tabText" />
                    <div class="form-text">Bound: <code>@_tabText</code> — proves binding survives tab switches.</div>
                </BenTab>
                <BenTab Title="Disabled" Disabled="true"><p>Unreachable.</p></BenTab>
            </BenTabs>
        </BenPanel>

        <BenPanel Title="BenLoaderOverlay" Fullscreenable="true">
            <div class="mb-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _loading = !_loading">
                    Toggle overlay
                </button>
            </div>
            <BenLoaderOverlay Visible="_loading" Text="Loading…">
                <div class="border rounded p-3">
                    <p class="mb-0">Content stays in place while the overlay covers it, so nothing jumps.</p>
                </div>
            </BenLoaderOverlay>
        </BenPanel>
    </div>

    <div class="col-xl-6">
        <BenPanel Title="Overlays" Subtitle="modal, confirm, toasts, dropdown">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-primary" @onclick="() => _modal = true">Open BenModal</button>
                <button class="btn btn-danger" @onclick="() => _confirm = true">Destructive confirm</button>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-success btn-sm" @onclick="ToastSuccess">Success toast</button>
                <button class="btn btn-primary btn-sm" @onclick="ToastInfo">Info</button>
                <button class="btn btn-warning btn-sm" @onclick="ToastWarning">Warning</button>
                <button class="btn btn-danger btn-sm" @onclick="ToastError">Error (sticky)</button>
            </div>

            <BenDropdown Title="A dropdown" ToggleClass="btn btn-outline-secondary" MinWidth="260px">
                <ToggleContent>Open menu</ToggleContent>
                <ChildContent>
                    <h6 class="dropdown-header">Menu with an input</h6>
                    <div class="px-3 pb-2">
                        <input class="form-control form-control-sm" placeholder="Filter…" @bind="_dropText" />
                    </div>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item" type="button">First action</button>
                    <button class="dropdown-item" type="button">Second action</button>
                    <div class="px-3 pt-2 small text-muted">Bound: <code>@_dropText</code></div>
                </ChildContent>
            </BenDropdown>
        </BenPanel>

        <BenPanel Title="Kept Telerik" Subtitle="restyled via telerik-signal.css">
            <p class="text-muted small">
                These have no honest Bootstrap equivalent, so they stay Telerik and are themed to
                match. Check them in both light and dark.
            </p>

            <label class="form-label" for="styleguide-date">BenDateField (typed; an impossible date is refused with a sentence, and the calendar is TelerikCalendar)</label>
            <BenDateField Mode="DateEntryMode.Date" Id="styleguide-date" @bind-Value="_date" Width="100%" />

            <label class="form-label mt-3">TelerikDropDownList (templated)</label>
            <BenSelect Data="@_options" @bind-Value="_option" Width="100%" />

            <label class="form-label mt-3">TelerikGrid</label>
            <TelerikGrid Data="@_rows" Pageable="true" Sortable="true" PageSize="4" Height="260px">
                <GridColumns>
                    <GridColumn Field="@nameof(Row.Name)" Title="Name" />
                    <GridColumn Field="@nameof(Row.Status)" Title="Status" />
                    <GridColumn Field="@nameof(Row.Count)" Title="Count" Width="90px" />
                </GridColumns>
            </TelerikGrid>

            @*
                Signal (2026-10-01). This panel had three widgets while the site uses twenty-odd, and
                a widget that is not on this page cannot be checked in both themes — so it was only
                ever checked by happening to visit a screen that had one. These are the common ones,
                by count across the website and both editors: buttons (139, in every theme colour
                and fill the site actually uses), sliders (92), checkboxes, progress bars, numeric
                boxes, tab strips and the rich-text editor.
            *@
            <label class="form-label mt-3">TelerikButton — the theme colours and fills in use</label>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Primary</TelerikButton>
                <TelerikButton>Base</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Info">Info</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Warning">Warning</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error">Error</TelerikButton>
                <TelerikButton Enabled="false" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Disabled</TelerikButton>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Outline</TelerikButton>
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline" ThemeColor="@ThemeConstants.Button.ThemeColor.Error">Outline error</TelerikButton>
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Flat</TelerikButton>
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat">Flat base</TelerikButton>
            </div>

            <label class="form-label mt-3">TelerikSlider · TelerikCheckBox · TelerikNumericTextBox</label>
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <TelerikSlider @bind-Value="_slider" Min="0" Max="100" SmallStep="1" LargeStep="25" Width="220px" />
                <label class="d-inline-flex align-items-center gap-2 mb-0"><TelerikCheckBox @bind-Value="_checked" /> Checked</label>
                <label class="d-inline-flex align-items-center gap-2 mb-0"><TelerikCheckBox @bind-Value="_unchecked" /> Not checked</label>
                <TelerikNumericTextBox @bind-Value="_number" Width="120px" />
            </div>

            <label class="form-label mt-3">TelerikProgressBar</label>
            <TelerikProgressBar Value="62" Max="100" />

            <label class="form-label mt-3">TelerikTabStrip</label>
            <TelerikTabStrip>
                <TabStripTab Title="Overview"><p class="mb-0 py-2">The first tab.</p></TabStripTab>
                <TabStripTab Title="Timeline"><p class="mb-0 py-2">The second tab.</p></TabStripTab>
                <TabStripTab Title="Files"><p class="mb-0 py-2">The third tab.</p></TabStripTab>
            </TelerikTabStrip>

            @* BenEditor, not a raw TelerikEditor: it is what all sixteen of the site's editors go
               through, and it sets EditMode.Div. The raw component defaults to an iframe, which
               does not inherit the page's font — shown here first, it rendered in Times New Roman. *@
            <label class="form-label mt-3">BenEditor (TelerikEditor, in-page mode)</label>
            <BenEditor @bind-Value="_html" Height="180px" />
        </BenPanel>

        <BenPanel Title="Alerts &amp; badges" Collapsible="true" Collapsed="false">
            <div class="alert alert-primary py-2">Primary alert</div>
            <div class="alert alert-success py-2">Success alert</div>
            <div class="alert alert-warning py-2">Warning alert</div>
            <div class="alert alert-danger py-2 mb-3">Danger alert</div>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge text-bg-primary">primary</span>
                <span class="badge text-bg-success">success</span>
                <span class="badge text-bg-warning">warning</span>
                <span class="badge text-bg-danger">danger</span>
                <span class="badge text-bg-secondary">secondary</span>
            </div>
        </BenPanel>
    </div>
</div>

<BenModal @bind-Visible="_modal" Title="A dialog with a form in it" Size="lg">
    <ChildContent>
        <p>
            The point of this dialog: inputs inside it must keep binding. TelerikDialog is banned
            in this codebase because they stopped — type below, close, and reopen.
        </p>
        <label class="form-label" for="sg-modal-input">Name</label>
        <input id="sg-modal-input" class="form-control" @bind="_modalText" />
        <div class="form-text">Bound value: <code>@_modalText</code></div>
    </ChildContent>
    <FooterContent>
        <button class="btn btn-outline-secondary" @onclick="() => _modal = false">Cancel</button>
        <button class="btn btn-primary" @onclick="() => _modal = false">Save</button>
    </FooterContent>
</BenModal>

<BenConfirmDialog @bind-Visible="_confirm"
                  Title="Delete this case?"
                  Message="Deleting a case removes its files and notes as well. This cannot be undone."
                  ConfirmText="Delete"
                  Destructive="true"
                  OnConfirm="OnConfirmed" />
}

@code {
    private readonly IReadOnlyList<BenPageHeader.Crumb> _crumbs = new[]
    {
        new BenPageHeader.Crumb("Home", "/"),
        new BenPageHeader.Crumb("Style guide"),
    };

    private string _text = string.Empty;
    private string _choice = "First";
    private bool _switch = true;
    private int _range = 40;
    private int _tab;
    private string _tabText = string.Empty;
    private bool _loading;
    private bool _modal;
    private string _modalText = string.Empty;
    private bool _confirm;
    private string _dropText = string.Empty;

    // The extra Kept Telerik widgets (Signal)
    private double _slider = 40;
    private bool _checked = true;
    private bool _unchecked;
    private int _number = 12;
    private string _html = "<p>Some <strong>rich</strong> text, as a case summary would have.</p>";

    private DateTime? _date = DateTime.Today;
    private string _option = "Second";
    private readonly List<string> _options = new() { "First", "Second", "Third" };

    private sealed record Row(string Name, string Status, int Count);

    private readonly List<Row> _rows = new()
    {
        new("Ravenswood Manor", "Open", 12),
        new("Old Mill Road", "Closed", 4),
        new("Harborview Inn", "Open", 9),
        new("Pine Hollow", "Pending", 2),
        new("Cedar Street", "Open", 7),
        new("The Old Rectory", "Closed", 1),
    };

    private static readonly (string Token, string Label)[] Surfaces =
    [
        ("--ben-bg", "page"), ("--ben-bg-sunken", "gutters, bars"),
        ("--ben-surface", "cards"), ("--ben-surface-raised", "popovers, modals"),
        ("--ben-line", "hairlines"), ("--ben-line-strong", "field borders"),
    ];

    private static readonly (string Token, string Label)[] Inks =
    [
        ("--ben-ink", "body"), ("--ben-ink-muted", "secondary"), ("--ben-ink-faint", "captions"),
    ];

    private static readonly (string Token, string Label)[] Shapes =
    [
        ("--ben-radius-sm", "8px"), ("--ben-radius", "12px"),
        ("--ben-radius-lg", "20px"), ("--ben-radius-pill", "pill"),
    ];

    private static readonly (string Token, string Label)[] Shadows =
    [
        ("--ben-shadow-sm", "small"), ("--ben-shadow", "default"),
        ("--ben-shadow-lg", "large"), ("--ben-glow", "accent glow"),
    ];

    private void ToastSuccess() => Toasts.Success("Saved.");
    private void ToastInfo()    => Toasts.Info("Nine files queued.");
    private void ToastWarning() => Toasts.Warning("Two photos were skipped.");
    private void ToastError()   => Toasts.Error("Upload failed — the file is larger than the server allows.");

    private void OnConfirmed()
    {
        _confirm = false;
        Toasts.Success("Deleted.", "Case removed");
    }
}
