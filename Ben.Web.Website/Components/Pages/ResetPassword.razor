@page "/reset-password"

@inject IWebApiIdentityClient IdentityClient
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Choose a New Password</PageTitle>

@*
    Landed on from the reset email. Email and code arrive in the query string and stay editable —
    a mangled link (mail clients wrap long URLs) leaves somebody with a code and no working link,
    and the email tells them to paste it here.
*@

<div class="d-flex align-items-center justify-content-center p-3">
    <div class="card shadow-sm" style="width:100%;max-width:26rem;">
        <div class="card-body p-4">
            <h2 class="h4 mb-3">Choose a new password</h2>

            @if (_done)
            {
                <div class="alert alert-success">
                    Your password is set. You can sign in with it now.
                </div>
                <a href="/login" class="btn btn-primary w-100">Go to sign in</a>
            }
            else
            {
                <EditForm Model="@this" OnValidSubmit="ResetAsync" FormName="ResetPasswordForm">
                    <div class="mb-3">
                        <label class="form-label" for="reset-email">Email</label>
                        <InputText id="reset-email" class="form-control" @bind-Value="_email"
                                   autocomplete="username" />
                    </div>

                    @if (_showCodeBox)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="reset-code">Reset code</label>
                            <InputText id="reset-code" class="form-control" @bind-Value="_code"
                                       placeholder="From the email we sent" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="reset-new">New password</label>
                        <InputText id="reset-new" type="password" class="form-control"
                                   @bind-Value="_newPassword" autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="reset-confirm">Confirm new password</label>
                        <InputText id="reset-confirm" type="password" class="form-control"
                                   @bind-Value="_confirmPassword" autocomplete="new-password" />
                    </div>

                    @if (_error is not null)
                    {
                        <div class="alert alert-danger py-2 mb-3">@_error</div>
                    }

                    <button type="submit" class="btn btn-primary w-100" disabled="@_working">
                        @(_working ? "Setting…" : "Set password")
                    </button>
                </EditForm>

                <p class="text-center text-secondary small mt-3 mb-0">
                    Link expired? <a href="/forgot-password">Request a new one</a>.
                </p>
            }
        </div>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _showCodeBox;
    private bool _working;
    private bool _done;
    private string? _error;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(NavManager.Uri).Query);

        if (query.TryGetValue("email", out var email)) _email = email.ToString();
        if (query.TryGetValue("code", out var code)) _code = code.ToString();

        // A complete link keeps the code out of sight — nobody should have to look at a 100-
        // character token. The box appears only when the link arrived without one, which is the
        // paste-the-code fallback the email offers.
        _showCodeBox = _code.Length == 0;
    }

    private async Task ResetAsync()
    {
        if (string.IsNullOrWhiteSpace(_email)) { _error = "Enter your email address."; return; }
        if (string.IsNullOrWhiteSpace(_code))
        {
            _showCodeBox = true;
            _error = "Enter the reset code from the email.";
            return;
        }
        if (_newPassword.Length == 0) { _error = "Enter a new password."; return; }
        if (_newPassword != _confirmPassword) { _error = "The two passwords don't match."; return; }

        _working = true;
        _error = null;

        var failure = await IdentityClient.ResetPasswordAsync(_email.Trim(), _code.Trim(), _newPassword);

        _working = false;

        if (failure is not null)
        {
            _error = failure;
            // A failed code means retyping it, so the box has to be visible to retype into.
            _showCodeBox = true;
            return;
        }

        _done = true;
    }
}
