<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Markdig" Version="0.37.0" />
        <PackageReference Include="Telerik.UI.for.Blazor" Version="14.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ben.Data.Common\Ben.Data.Common.csproj" />
        <ProjectReference Include="..\Ben.Service.Models\Ben.Service.Models.csproj" />
        <ProjectReference Include="../../Github-BenVideo/Ben.Video.Editor/Ben.Video.Editor.csproj" />
    </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ben.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help documents ship inside the assembly rather than under wwwroot: a wwwroot file is
         served raw to anyone who guesses its name, which would hand out the app-administration
         documents past their audience gate. -->
    <EmbeddedResource Include="Help\Content\*.md" />
  </ItemGroup>

</Project>
