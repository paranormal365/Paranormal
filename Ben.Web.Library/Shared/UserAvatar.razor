@using Ben.Web.Services
@inject AvatarCache Avatars

@*
    A person's picture, or their initials when there isn't one to show. Which photo the viewer
    gets is decided server-side by /api/users/{id}/avatar — this component never asks for a
    specific photo, only for a person.
*@

@if (_dataUri is not null)
{
    <img src="@_dataUri" alt="@(DisplayName ?? "")" title="@DisplayName"
         class="rounded-circle @CssClass"
         style="width:@(Size)px;height:@(Size)px;object-fit:cover;flex:0 0 auto;" />
}
else
{
    @* Initials beat a generic silhouette: they still identify the person, and they don't read
       as a picture that failed to load. *@
    <span class="rounded-circle d-inline-flex align-items-center justify-content-center bg-secondary text-white @CssClass"
          title="@DisplayName"
          style="width:@(Size)px;height:@(Size)px;font-size:@(Math.Max(9, Size * 0.4))px;flex:0 0 auto;">@Initials</span>
}

@code {
    /// <summary>Whose avatar to show. Null renders initials from <see cref="DisplayName"/> alone.</summary>
    [Parameter] public Guid? AppUserId { get; set; }

    /// <summary>Used for the initials fallback, the alt text, and the tooltip.</summary>
    [Parameter] public string? DisplayName { get; set; }

    /// <summary>Rendered size in pixels, square.</summary>
    [Parameter] public int Size { get; set; } = 32;

    /// <summary>Extra classes for the caller's layout.</summary>
    [Parameter] public string? CssClass { get; set; }

    private string? _dataUri;
    private Guid? _loadedFor;

    private string Initials
    {
        get
        {
            var source = DisplayName;
            if (string.IsNullOrWhiteSpace(source)) return "?";
            var parts = source.Split(new[] { ' ', '.', '@', '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..1].ToUpperInvariant(),
                _ => (parts[0][..1] + parts[1][..1]).ToUpperInvariant(),
            };
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload only when the subject actually changes — these render inside lists that
        // re-render on every keystroke elsewhere on the page.
        if (AppUserId == _loadedFor) return;
        _loadedFor = AppUserId;
        _dataUri = null;

        if (AppUserId is { } id)
            _dataUri = await Avatars.GetAsync(id);
    }
}
