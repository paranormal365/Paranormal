@namespace Ben.Web.Library.Shared
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@*
  Community vote widget for a public case.
  Shows aggregate vote counts (confirms/disputes/inconclusive) and,
  for authenticated users, buttons to cast or change their vote.
*@

<div class="case-vote-widget d-flex flex-column gap-2">
    @if (_summary is null && _loading)
    {
        <span class="text-secondary small">Loading votes…</span>
    }
    else if (_summary is null && _error is not null)
    {
        <span class="text-danger small">@_error</span>
    }
    else if (_summary is not null)
    {
        @* ── Vote progress bar ──────────────────────────────────────────────── *@
        @if (_summary.TotalVotes > 0)
        {
            <div class="mb-1">
                <div class="progress" style="height:5px; border-radius:3px;">
                    <div class="progress-bar bg-success" style="width:@ConfirmsPct%" title="@_summary.ConfirmsCount confirms"></div>
                    <div class="progress-bar bg-danger"  style="width:@DisputesPct%" title="@_summary.DisputesCount disputes"></div>
                    <div class="progress-bar bg-warning" style="width:@InconclusivePct%" title="@_summary.InconclusiveCount inconclusive"></div>
                </div>
            </div>
        }
        <div class="d-flex gap-2 align-items-center" style="font-size:.78rem;">
            <span class="text-success">✓ @_summary.ConfirmsCount</span>
            <span class="text-danger">✗ @_summary.DisputesCount</span>
            <span class="text-warning-emphasis">? @_summary.InconclusiveCount</span>
            <span class="text-muted ms-auto">@_summary.TotalVotes vote@(_summary.TotalVotes == 1 ? "" : "s")</span>
            <VoteScoreBadge Score="@_summary.Score" Total="@_summary.TotalVotes" />
        </div>

        @* ── Vote buttons (authenticated users only) ──────────────────────── *@
        @if (UserState.IsAuthenticated)
        {
            <div class="d-flex gap-1 flex-wrap">
                @foreach (var vt in Enum.GetValues<EvidenceVoteType>())
                {
                    var v = vt;
                    var isActive = _summary.CurrentUserVote == v;
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@(isActive ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline)"
                                   ThemeColor="@VoteThemeColor(v)"
                                   OnClick="@(() => CastVote(v))"
                                   Enabled="@(!_isBusy)">
                        @VoteLabel(v)
                    </TelerikButton>
                }
                @if (_summary.CurrentUserVote.HasValue)
                {
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   OnClick="RemoveVote"
                                   Enabled="@(!_isBusy)">
                        Remove
                    </TelerikButton>
                }
            </div>
            @if (_actionError is not null)
            {
                <span class="text-danger small">@_actionError</span>
            }
        }
        else
        {
            <a href="/login" class="text-secondary text-decoration-none" style="font-size:.75rem;">Sign in to vote</a>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    /// <summary>When provided, skips the API fetch. Used by list views that pre-load summaries in batch.</summary>
    [Parameter] public CaseVoteSummary? PreloadedSummary { get; set; }

    private CaseVoteSummary? _summary;
    private bool _loading = true;
    private bool _isBusy;
    private string? _error;
    private string? _actionError;

    protected override async Task OnParametersSetAsync()
    {
        if (PreloadedSummary is not null)
        {
            _summary = PreloadedSummary;
            _loading = false;
            return;
        }
        _loading = true;
        try { _summary = await AdminClient.GetCaseVoteSummaryAsync(CaseId); }
        catch { _error = "Failed to load votes."; }
        _loading = false;
    }

    private async Task CastVote(EvidenceVoteType voteType)
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            var updated = await AdminClient.CastCaseVoteAsync(CaseId, voteType);
            if (updated is not null) _summary = updated;
            else _actionError = "Failed to cast your vote. Please try again.";
        }
        catch { _actionError = "Failed to cast your vote. Please try again."; }
        finally { _isBusy = false; }
    }

    private async Task RemoveVote()
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            await AdminClient.RemoveCaseVoteAsync(CaseId);
            _summary = await AdminClient.GetCaseVoteSummaryAsync(CaseId);
        }
        catch { _actionError = "Failed to remove your vote. Please try again."; }
        finally { _isBusy = false; }
    }

    private double ConfirmsPct     => _summary is { TotalVotes: > 0 } ? _summary.ConfirmsCount     * 100.0 / _summary.TotalVotes : 0;
    private double DisputesPct     => _summary is { TotalVotes: > 0 } ? _summary.DisputesCount     * 100.0 / _summary.TotalVotes : 0;
    private double InconclusivePct => _summary is { TotalVotes: > 0 } ? _summary.InconclusiveCount * 100.0 / _summary.TotalVotes : 0;

    private static string VoteLabel(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "✓ Confirms",
        EvidenceVoteType.Disputes     => "✗ Disputes",
        EvidenceVoteType.Inconclusive => "? Inconclusive",
        _                             => v.ToString(),
    };

    private static string VoteThemeColor(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => ThemeConstants.Button.ThemeColor.Success,
        EvidenceVoteType.Disputes     => ThemeConstants.Button.ThemeColor.Error,
        EvidenceVoteType.Inconclusive => ThemeConstants.Button.ThemeColor.Base,
        _                             => ThemeConstants.Button.ThemeColor.Base,
    };
}
