@namespace Ben.Web.Library.Shared
@using Ben.Web.Library.Organization
@implements IAsyncDisposable

@inject IBenAdminClient  AdminClient
@inject IJSRuntime       JS

@* ── What's near you (backlog item #88) ──────────────────────────────────────
   The front door for somebody who has never heard of any of these organizations: pick a distance,
   see the groups that serve it and the public events happening in it. Deliberately list-only, no
   map — PublicCaseDiscovery already carries the cost of a Telerik map + colocated JS for the case
   view, and duplicating that machinery here was not worth it for a first version. If a map earns
   its place later, it is additive, not a rewrite: the two results lists below do not change shape.

   Groups and events do NOT share a redaction rule, and that asymmetry is deliberate, not an
   oversight — see SearchController.Nearby. A group that opted into search is a business listing
   and is shown exactly as it chose to be found; an event is an invitation and stays approximate.
   Nothing in this component decides that; it only renders what the server already decided. *@

<div class="container-fluid px-3 mt-5" style="max-width:1000px;">
    <div class="d-flex align-items-baseline justify-content-between mb-2 flex-wrap gap-2">
        <h4 class="mb-0">What's Near You</h4>
        <div class="d-flex align-items-center gap-2">
            <label class="text-secondary small mb-0" for="nearby-radius">Within</label>
            <TelerikDropDownList Id="nearby-radius"
                                 Data="@_radiusOptions" TItem="int" TValue="int"
                                 Value="@_radiusMiles"
                                 ValueChanged="@((int r) => OnRadiusChangedAsync(r))"
                                 Width="110px" />
        </div>
    </div>

    @if (_locationState == LocationState.Asking)
    {
        <p class="text-secondary small mb-3">Finding your location…</p>
    }
    else if (_locationState == LocationState.Denied)
    {
        @* The browser said no, or there simply is no geolocation API — a corporate proxy, an
           older device, a visitor who declined the prompt. Falling silent here would look like the
           feature is broken; asking for a place name instead keeps it usable either way. *@
        <div class="d-flex gap-2 mb-3 flex-wrap">
            @* Plain input, not TelerikTextBox: Telerik text boxes commit on blur, so the button
               beside them — whose Enabled depends on this field — stays disabled until focus
               leaves. Somebody who types and clicks straight through finds a dead button. The same
               reasoning already governs the equipment and timeline editors; a Playwright test
               caught it here after the first version used TelerikTextBox and failed exactly that
               way. *@
            @* Stable id, because HomeHero above carries the identical placeholder — a
               placeholder-based selector matches its box instead of this one. *@
            <input id="nearby-location" class="form-control" style="max-width:280px;"
                   placeholder="Enter your city, address, or zip code"
                   value="@_manualQuery"
                   @oninput="@(e => { _manualQuery = e.Value?.ToString() ?? string.Empty; _manualError = null; })" />
            <TelerikButton OnClick="SearchManualLocationAsync"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Enabled="@(!_searching && !string.IsNullOrWhiteSpace(_manualQuery))">
                @(_searching ? "Searching…" : "Show what's near there")
            </TelerikButton>
        </div>
        @if (_manualError is not null)
        {
            <div class="alert alert-warning py-2">@_manualError</div>
        }
    }

    @* A second, independent chain. It was originally one long if/else-if with the block above,
       which meant the Denied branch shadowed every results branch: somebody who declined the
       browser prompt, typed a place and searched got their data loaded and nothing rendered. The
       manual box has to stay on screen anyway — it is how they search somewhere else — so the two
       concerns cannot share a chain. Caught by a Playwright test, not by anything else. *@
    @if (_searching)
    {
        <div class="d-flex justify-content-center py-4">
            <TelerikLoaderContainer Visible="true" Text="Looking nearby…" />
        </div>
    }
    else if (_hasSearched && _events.Count == 0 && _groups.Count == 0)
    {
        <div class="alert alert-light text-muted text-center py-4">
            Nothing found within @_radiusMiles miles.
            <br /><span class="small">Try a wider distance, or <a href="/find" class="text-decoration-none">browse every group</a>.</span>
        </div>
    }
    else if (_hasSearched)
    {
        @* ── Public events ────────────────────────────────────────────────── *@
        @if (_events.Count > 0)
        {
            <h5 class="mb-2">Upcoming Events</h5>
            <p class="text-secondary small mb-3">
                Locations shown here are approximate — an area several miles across, not an address.
            </p>
            <div class="row g-3 mb-4">
                @foreach (var ev in _events)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="card-title mb-1">@ev.Title</h6>
                                <p class="card-text text-secondary mb-1" style="font-size:.85rem;">
                                    @ev.StartDateTime.ToString("ddd, MMM d · h:mm tt")
                                </p>
                                @if (!string.IsNullOrWhiteSpace(ev.City))
                                {
                                    <p class="card-text text-muted mb-1" style="font-size:.8rem;">
                                        Near @ev.City@(string.IsNullOrWhiteSpace(ev.State) ? "" : $", {ev.State}")
                                        · @ev.DistanceMiles.ToString("F0") mi
                                    </p>
                                }
                                <p class="card-text text-muted mb-0" style="font-size:.78rem;">Hosted by @ev.OrgName</p>
                            </div>
                            <div class="card-footer bg-transparent d-flex gap-2 pt-2">
                                @if (!string.IsNullOrWhiteSpace(ev.UrlName) && !string.IsNullOrWhiteSpace(ev.OrgUrlName))
                                {
                                    <a href="@($"/o/{ev.OrgUrlName}/events/{ev.UrlName}")"
                                       class="btn btn-sm btn-outline-primary">View Event</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(ev.OrgUrlName))
                                {
                                    <a href="/o/@ev.OrgUrlName" class="btn btn-sm btn-outline-secondary">Group</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Groups ────────────────────────────────────────────────────────── *@
        @if (_groups.Count > 0)
        {
            <h5 class="mb-2">Groups Nearby</h5>
            <div class="row g-3 mb-4">
                @foreach (var org in _groups)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <OrgCard Name="@org.OrgName" UrlName="@org.OrgUrlName">
                            <MetaLine>@org.DistanceMiles.ToString("F1") mi away</MetaLine>
                        </OrgCard>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private enum LocationState { Asking, Granted, Denied }

    private static readonly int[] _radiusOptions = [10, 25, 50, 100];

    private LocationState _locationState = LocationState.Asking;
    private int    _radiusMiles = 25;
    private bool   _searching;
    private bool   _hasSearched;
    private string _manualQuery = "";
    private string? _manualError;

    private IReadOnlyList<Ben.Service.Models.Entities.NearbyEventResult> _events = [];
    private IReadOnlyList<Ben.Service.Models.Entities.NearbyOrgResult>   _groups = [];

    private double? _lat, _lon;

    // ── JS interop ───────────────────────────────────────────────────────────
    private IJSObjectReference? _module;
    private DotNetObjectReference<NearbyDiscovery>? _dotnetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module    = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Ben.Web.Library/Shared/NearbyDiscovery.razor.js");
        _dotnetRef = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("tryGetUserLocation", _dotnetRef);
    }

    /// <summary>
    /// The browser's answer to the geolocation prompt — accepted, declined, or unsupported. All
    /// three land here as the same callback; only <paramref name="lat"/>/<paramref name="lon"/>
    /// being null distinguishes "no" from "yes".
    /// </summary>
    [JSInvokable]
    public async Task SetUserLocation(double? lat, double? lon)
    {
        if (lat.HasValue && lon.HasValue)
        {
            _lat = lat; _lon = lon;
            _locationState = LocationState.Granted;
            await RunSearchAsync();
        }
        else
        {
            _locationState = LocationState.Denied;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SearchManualLocationAsync()
    {
        if (string.IsNullOrWhiteSpace(_manualQuery)) return;

        _searching    = true;
        _manualError  = null;
        StateHasChanged();

        var geo = await AdminClient.SearchGeocodingAsync(_manualQuery.Trim());

        if (geo?.Latitude is null || geo.Longitude is null)
        {
            _manualError = $"Could not locate \"{_manualQuery.Trim()}\". Try a city name or zip code.";
            _searching   = false;
            return;
        }

        _lat = (double)geo.Latitude.Value;
        _lon = (double)geo.Longitude.Value;
        await RunSearchAsync();
    }

    private async Task OnRadiusChangedAsync(int radius)
    {
        _radiusMiles = radius;
        if (_lat.HasValue && _lon.HasValue)
            await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        if (!_lat.HasValue || !_lon.HasValue) return;

        _searching = true;
        StateHasChanged();

        var results = await AdminClient.GetNearbyAsync(_lat.Value, _lon.Value, _radiusMiles);

        _events = results?.Events ?? [];
        _groups = results?.Organizations ?? [];
        _hasSearched = true;
        _searching   = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            await _module.DisposeAsync();
        _dotnetRef?.Dispose();
    }
}
