@namespace Ben.Web.Library.Shared

@* The one signed number, rendered the same way everywhere it appears.

   The score is handed over by the server and shown as given — this component does no arithmetic,
   because a reader recomputing it from the counts is how the four surfaces drift apart. The vote
   count travels with it for the same reason equipment ratings carry theirs: +4 from five people and
   +4 from ninety are not the same claim, and a number shown alone invites reading it as if they
   were. *@

@if (Total == 0)
{
    <span class="badge bg-light text-secondary border" style="@Style" title="Nobody has voted yet">
        No votes
    </span>
}
else
{
    <span class="badge @Colour" style="@Style"
          title="@Description">
        @Formatted
    </span>
}

@code {
    /// <summary>The server's signed total: +1 confirms, 0 inconclusive, −1 disputes.</summary>
    [Parameter, EditorRequired] public int Score { get; set; }

    /// <summary>How many people voted. Shown in the tooltip so the score is never read unweighted.</summary>
    [Parameter, EditorRequired] public int Total { get; set; }

    [Parameter] public bool Compact { get; set; }

    private string Style => Compact ? "font-size:.7rem;" : "font-size:.8rem;";

    /// <summary>
    /// A leading plus on a positive score, because "3" and "+3" say different things when the
    /// neighbouring value can be negative — the sign is the information.
    /// </summary>
    private string Formatted => Score > 0 ? $"+{Score}" : Score.ToString();

    private string Colour => Score switch
    {
        > 0 => "bg-success",
        < 0 => "bg-danger",
        // Zero is a real answer, not a missing one: it means the people who looked were split, or
        // undecided. Amber rather than grey says the question was asked and came back even.
        _   => "bg-warning text-dark",
    };

    private string Description => Score switch
    {
        > 0 => $"Leans haunted (+{Score} across {Total} vote{(Total == 1 ? "" : "s")})",
        < 0 => $"Leans unconvinced ({Score} across {Total} vote{(Total == 1 ? "" : "s")})",
        _   => $"Evenly split or undecided, across {Total} vote{(Total == 1 ? "" : "s")}",
    };
}
