@* Reusable delete/confirm dialog — replaces the near-identical _showDeleteDialog/TelerikDialog
   boilerplate that was hand-copied across ~15 components. The component only owns closing itself
   on Cancel (always safe); what happens on Confirm (close on success, stay open to show an error,
   etc.) is entirely up to the caller's own OnConfirm handler, matching each page's existing
   behavior exactly. *@

<TelerikDialog @bind-Visible="@Visible" Title="@Title" Width="@Width">
    <DialogContent>
        @ChildContent
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="Cancel" Enabled="@(!Busy)">@CancelText</TelerikButton>
        <TelerikButton ThemeColor="@ConfirmThemeColor"
                       OnClick="@(() => OnConfirm.InvokeAsync())"
                       Enabled="@(!Busy && ConfirmEnabled)">
            @(Busy ? BusyText : ConfirmText)
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Width { get; set; } = "400px";
    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public string BusyText { get; set; } = "Working…";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string ConfirmThemeColor { get; set; } = ThemeConstants.Button.ThemeColor.Error;
    [Parameter] public bool Busy { get; set; }
    /// <summary>Additional confirm-button gate beyond !Busy, for pages that need one (e.g. "can't
    /// delete while X is still true"). Defaults to always allowed.</summary>
    [Parameter] public bool ConfirmEnabled { get; set; } = true;
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task Cancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}
