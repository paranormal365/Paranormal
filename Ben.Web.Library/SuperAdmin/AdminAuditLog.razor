@page "/admin/audit-log"
@namespace Ben.Web.Library.SuperAdmin
@using Ben.Service.Models.Admin
@using Ben.Data.Common.Enums
@using Ben.Web.Library.Shared

@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Audit Log</PageTitle>

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Audit Log</h3>
        </div>
    </div>

    @if (!UserState.IsSuperAdmin)
    {
        <div class="alert alert-danger">Access restricted to SuperAdmins.</div>
        return;
    }

    @* ── Filter bar ─────────────────────────────────────────────────────────── *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-sm-3">
                    <label class="form-label small mb-1">Entity Type</label>
                    <TelerikDropDownList Data="@_entityTypeOptions"
                                        @bind-Value="@_filterEntityType"
                                        DefaultText="All types"
                                        Width="100%" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small mb-1">Action</label>
                    <TelerikDropDownList Data="@_actionOptions"
                                        @bind-Value="@_filterAction"
                                        TextField="Label"
                                        ValueField="Value"
                                        DefaultText="All actions"
                                        Width="100%" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small mb-1">From</label>
                    <TelerikDatePicker @bind-Value="@_filterDateFrom" Width="100%" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small mb-1">To</label>
                    <TelerikDatePicker @bind-Value="@_filterDateTo" Width="100%" />
                </div>
                <div class="col-sm-3 d-flex gap-2">
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   OnClick="ApplyFiltersAsync"
                                   Enabled="@(!_loading)">
                        @(_loading ? "Loading…" : "Search")
                    </TelerikButton>
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                                   OnClick="ClearFilters">
                        Clear
                    </TelerikButton>
                </div>
            </div>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }

    @* ── Grid ───────────────────────────────────────────────────────────────── *@
    <TelerikGrid @ref="@_grid"
                 Data="@_items"
                 TItem="AuditLogRecord"
                 Pageable="true"
                 PageSize="@_pageSize"
                 Sortable="true"
                 FilterMode="@GridFilterMode.FilterRow"
                 SelectionMode="@GridSelectionMode.Single"
                 @bind-SelectedItems="@_selectedItems"
                 OnRowClick="@OnRowClick"
                 Height="600px">

        <GridToolBarTemplate>
            <TelerikButton Icon="@SvgIcon.FileExcel"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@ExportToExcel">
                Excel
            </TelerikButton>
            <TelerikButton Icon="@SvgIcon.FileCsv"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@ExportToCsv">
                CSV
            </TelerikButton>
            <span class="ms-3 text-secondary small">@_totalCount total records</span>
        </GridToolBarTemplate>

        <DetailTemplate>
            @{ var log = (AuditLogRecord)context; }
            <div class="p-3 bg-light border rounded ms-3" style="max-width:860px;">
                <div class="row g-2 mb-2">
                    <div class="col-sm-3 text-secondary small">Entity ID</div>
                    <div class="col-sm-9 font-monospace small">@log.EntityId</div>
                    <div class="col-sm-3 text-secondary small">User</div>
                    <div class="col-sm-9 small"><UserNameLink AppUserId="@log.UserId" DisplayName="@log.UserDisplayName" /></div>
                    <div class="col-sm-3 text-secondary small">Source</div>
                    <div class="col-sm-9 small">@log.Source</div>
                    <div class="col-sm-3 text-secondary small">Occurred</div>
                    <div class="col-sm-9 small">@log.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(log.ChangesJson))
                {
                    <div class="text-secondary small mb-1">Changes</div>
                    <pre class="bg-white border rounded p-2 small" style="max-height:200px; overflow:auto; white-space:pre-wrap; word-break:break-all;">@FormatJson(log.ChangesJson)</pre>
                }
            </div>
        </DetailTemplate>

        <GridColumns>
            <GridColumn Field="@nameof(AuditLogRecord.OccurredAt)" Title="Time" Width="170px">
                <Template>
                    @{ var r = (AuditLogRecord)context; }
                    <span class="small">@r.OccurredAt.ToString("yyyy-MM-dd HH:mm")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.EntityType)" Title="Entity" Width="180px" />
            <GridColumn Field="@nameof(AuditLogRecord.Action)" Title="Action" Width="90px">
                <Template>
                    @{ var r2 = (AuditLogRecord)context; }
                    <span class="badge @ActionBadge(r2.Action)">@ActionLabel(r2.Action)</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.EntityId)" Title="Entity ID" Width="110px">
                <Template>
                    @{ var r3 = (AuditLogRecord)context; }
                    <span class="font-monospace small text-secondary">@r3.EntityId.ToString()[..8]…</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.UserId)" Title="User" Width="150px">
                <Template>
                    @{ var r4 = (AuditLogRecord)context; }
                    <span class="small"><UserNameLink AppUserId="@r4.UserId" DisplayName="@r4.UserDisplayName" /></span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.Source)" Title="Source" Width="100px" />
            <GridColumn Title="" Width="60px" Filterable="false" Sortable="false">
                <Template>
                    @{ var r5 = (AuditLogRecord)context; }
                    <TelerikButton Icon="@SvgIcon.Envelope"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   Title="Send as message"
                                   OnClick="@(() => OpenMailDialog(r5))" />
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>

    @* Pagination note for large result sets *@
    @if (_totalCount > _pageSize * 10)
    {
        <div class="text-muted small mt-1">
            Showing page @_currentPage of @((_totalCount + _pageSize - 1) / _pageSize). Use filters to narrow results.
        </div>
    }

</div>

@* ── Mail Dialog ─────────────────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_mailDialogVisible"
               Title="Send Audit Log Record"
               Width="640px"
               CloseOnOverlayClick="false">
    <DialogContent>
        @if (_mailTarget is not null)
        {
            <div class="mb-3 p-2 bg-light rounded small">
                <strong>@_mailTarget.EntityType</strong> · @ActionLabel(_mailTarget.Action) ·
                @_mailTarget.OccurredAt.ToString("yyyy-MM-dd HH:mm") UTC
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Recipients</label>
                <div class="d-flex gap-2 mb-2">
                    <TelerikTextBox @bind-Value="@_userSearchQuery"
                                    Placeholder="Search users…"
                                    Width="100%"
                                    OnChange="@SearchUsersAsync" />
                </div>
                @if (_userSearchResults.Any())
                {
                    <div class="border rounded p-2 mb-2" style="max-height:140px; overflow-y:auto;">
                        @foreach (var u in _userSearchResults)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="small">@(u.DisplayName ?? u.Email) <span class="text-secondary">(@u.Email)</span></span>
                                <TelerikButton Icon="@SvgIcon.Plus"
                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                               Size="@ThemeConstants.Button.Size.Small"
                                               OnClick="@(() => AddRecipient(u))"
                                               Enabled="@(!_selectedRecipients.Any(r => r.Id == u.Id))" />
                            </div>
                        }
                    </div>
                }
                @if (_selectedRecipients.Any())
                {
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var r in _selectedRecipients)
                        {
                            <span class="badge bg-secondary d-flex align-items-center gap-1">
                                @(r.DisplayName ?? r.Email)
                                <button class="btn-close btn-close-white" style="font-size:0.6rem;"
                                        @onclick="@(() => RemoveRecipient(r))"></button>
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Subject</label>
                <TelerikTextBox @bind-Value="@_mailSubject" Width="100%" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Body</label>
                <TelerikTextArea @bind-Value="@_mailBody" Rows="6" Width="100%" />
            </div>

            @if (_mailError is not null)
            {
                <div class="alert alert-danger py-2 small">@_mailError</div>
            }
            @if (_mailSuccess)
            {
                <div class="alert alert-success py-2 small">Message sent successfully.</div>
            }
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Envelope"
                       OnClick="SendMessageAsync"
                       Enabled="@(!_mailSending && _selectedRecipients.Any())">
            @(_mailSending ? "Sending…" : "Send")
        </TelerikButton>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="CloseMailDialog">
            Close
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    // ── Grid state ─────────────────────────────────────────────────────────────

    private TelerikGrid<AuditLogRecord>? _grid;
    private IEnumerable<AuditLogRecord>  _items        = [];
    private IEnumerable<AuditLogRecord>  _selectedItems = [];
    private int     _totalCount  = 0;
    private int     _currentPage = 1;
    private int     _pageSize    = 25;
    private bool    _loading     = false;
    private string? _errorMessage;

    // ── Filter state ───────────────────────────────────────────────────────────

    private string?   _filterEntityType;
    private AuditAction? _filterAction;
    private DateTime? _filterDateFrom = DateTime.UtcNow.AddDays(-30);
    private DateTime? _filterDateTo;

    private IReadOnlyList<string>       _entityTypeOptions = [];
    private static readonly ActionOption[] _actionOptions = [
        new(AuditAction.Create, "Create"),
        new(AuditAction.Update, "Update"),
        new(AuditAction.Delete, "Delete"),
    ];

    // ── Mail dialog state ──────────────────────────────────────────────────────

    private bool            _mailDialogVisible = false;
    private AuditLogRecord? _mailTarget;
    private string          _mailSubject    = "";
    private string          _mailBody       = "";
    private string          _userSearchQuery = "";
    private bool            _mailSending    = false;
    private bool            _mailSuccess    = false;
    private string?         _mailError;

    private IReadOnlyList<UserSearchResult> _userSearchResults   = [];
    private List<UserSearchResult>          _selectedRecipients  = [];

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await Task.WhenAll(LoadEntityTypesAsync(), LoadDataAsync());
    }

    private async Task LoadEntityTypesAsync()
    {
        var types = await AdminClient.GetAuditLogEntityTypesAsync();
        _entityTypeOptions = types;
    }

    private async Task LoadDataAsync()
    {
        _loading      = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.GetAuditLogsAsync(
                page:       _currentPage,
                pageSize:   _pageSize,
                entityType: _filterEntityType,
                action:     _filterAction.HasValue ? (int)_filterAction.Value : null,
                dateFrom:   _filterDateFrom,
                dateTo:     _filterDateTo);

            _items      = result?.Items ?? [];
            _totalCount = result?.TotalCount ?? 0;
        }
        catch
        {
            _errorMessage = "Failed to load audit log.";
        }

        _loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ClearFilters()
    {
        _filterEntityType = null;
        _filterAction     = null;
        _filterDateFrom   = DateTime.UtcNow.AddDays(-30);
        _filterDateTo     = null;
        await ApplyFiltersAsync();
    }

    // ── Row click ──────────────────────────────────────────────────────────────

    private void OnRowClick(GridRowClickEventArgs args)
    {
        // Row expand is handled by the grid's built-in detail template toggle
    }

    // ── Export ─────────────────────────────────────────────────────────────────

    private async Task ExportToExcel() => await _grid!.ExportToExcelAsync();
    private async Task ExportToCsv()   => await _grid!.ExportToCsvAsync();

    // ── Mail dialog ────────────────────────────────────────────────────────────

    private void OpenMailDialog(AuditLogRecord log)
    {
        _mailTarget          = log;
        _mailSubject         = $"Audit: {log.EntityType} {ActionLabel(log.Action)} at {log.OccurredAt:yyyy-MM-dd HH:mm} UTC";
        _mailBody            = BuildDefaultBody(log);
        _userSearchQuery     = "";
        _userSearchResults   = [];
        _selectedRecipients  = [];
        _mailError           = null;
        _mailSuccess         = false;
        _mailDialogVisible   = true;
    }

    private void CloseMailDialog()
    {
        _mailDialogVisible = false;
        _mailTarget        = null;
    }

    private async Task SearchUsersAsync()
    {
        if (string.IsNullOrWhiteSpace(_userSearchQuery)) { _userSearchResults = []; return; }
        var users = await AdminClient.GetAllUsersAsync();
        var q = _userSearchQuery.ToLowerInvariant();
        _userSearchResults = users
            .Where(u => (u.DisplayName ?? "").ToLowerInvariant().Contains(q)
                     || (u.Email ?? "").ToLowerInvariant().Contains(q))
            .Take(10)
            .Select(u => new UserSearchResult(u.Id, u.Email ?? "", u.DisplayName))
            .ToList();
    }

    private void AddRecipient(UserSearchResult user)
    {
        if (!_selectedRecipients.Any(r => r.Id == user.Id))
            _selectedRecipients.Add(user);
    }

    private void RemoveRecipient(UserSearchResult user)
        => _selectedRecipients.RemoveAll(r => r.Id == user.Id);

    private async Task SendMessageAsync()
    {
        if (_mailTarget is null || !_selectedRecipients.Any()) return;

        _mailError   = null;
        _mailSuccess = false;
        _mailSending = true;

        var ok = await AdminClient.SendAuditLogMessageAsync(new SendAuditLogMessageRequest(
            AuditLogId:       _mailTarget.Id,
            RecipientUserIds: _selectedRecipients.Select(r => r.Id).ToList(),
            Subject:          _mailSubject,
            Body:             _mailBody));

        _mailSending = false;

        if (ok) _mailSuccess = true;
        else    _mailError   = "Failed to send message. Please try again.";
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static string ActionLabel(AuditAction action) => action switch
    {
        AuditAction.Create => "Create",
        AuditAction.Update => "Update",
        AuditAction.Delete => "Delete",
        _                  => action.ToString()
    };

    private static string ActionBadge(AuditAction action) => action switch
    {
        AuditAction.Create => "bg-success",
        AuditAction.Update => "bg-warning text-dark",
        AuditAction.Delete => "bg-danger",
        _                  => "bg-secondary"
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string BuildDefaultBody(AuditLogRecord log)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Audit Log Entry");
        sb.AppendLine($"───────────────");
        sb.AppendLine($"Action:      {ActionLabel(log.Action)}");
        sb.AppendLine($"Entity Type: {log.EntityType}");
        sb.AppendLine($"Entity ID:   {log.EntityId}");
        sb.AppendLine($"User ID:     {log.UserId}");
        sb.AppendLine($"Source:      {log.Source}");
        sb.AppendLine($"Occurred:    {log.OccurredAt:yyyy-MM-dd HH:mm:ss} UTC");
        if (!string.IsNullOrWhiteSpace(log.ChangesJson))
        {
            sb.AppendLine();
            sb.AppendLine("Changes:");
            sb.AppendLine(FormatJson(log.ChangesJson));
        }
        return sb.ToString();
    }

    // ── Inner types ────────────────────────────────────────────────────────────

    private sealed record ActionOption(AuditAction Value, string Label);
    private sealed record UserSearchResult(Guid Id, string Email, string? DisplayName);
}
