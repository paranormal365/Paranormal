@page "/admin/file-types"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — File Types</PageTitle>

<div class="container-fluid px-3">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">File Types</h3>
        </div>
        <div class="col-auto">
            <TelerikButton Icon="@SvgIcon.Plus"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="OpenCreate">New File Type</TelerikButton>
        </div>
    </div>

    @if (_loading)
    {
        <p>Loading…</p>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <TelerikGrid Data="@_types"
                     TItem="AdminFileTypeWithExtensionsResponse"
                     Sortable="true"
                     Class="file-types-grid">
            <GridColumns>
                <GridColumn Field="@($"{nameof(AdminFileTypeWithExtensionsResponse.FileType)}.{nameof(UploadFileTypeRecord.Name)}")"
                            Title="Name" />
                <GridColumn Field="@($"{nameof(AdminFileTypeWithExtensionsResponse.FileType)}.{nameof(UploadFileTypeRecord.Description)}")"
                            Title="Description" />
                <GridColumn Field="@($"{nameof(AdminFileTypeWithExtensionsResponse.FileType)}.{nameof(UploadFileTypeRecord.SortOrder)}")"
                            Title="Sort" Width="70px" />
                <GridColumn Field="@($"{nameof(AdminFileTypeWithExtensionsResponse.FileType)}.{nameof(UploadFileTypeRecord.IsActive)}")"
                            Title="Active" Width="80px">
                    <Template>
                        @if (((AdminFileTypeWithExtensionsResponse)context).FileType.IsActive)
                        {
                            <TelerikSvgIcon Icon="@SvgIcon.Check" ThemeColor="@ThemeConstants.SvgIcon.ThemeColor.Success" />
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@($"{nameof(AdminFileTypeWithExtensionsResponse.FileType)}.{nameof(UploadFileTypeRecord.AllowAllExtensions)}")"
                            Title="Extensions" Width="130px">
                    <Template>
                        @{
                            var row = (AdminFileTypeWithExtensionsResponse)context;
                            if (row.FileType.AllowAllExtensions)
                            {
                                <span class="badge bg-secondary">Any</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@row.Extensions.Count pattern(s)</span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridCommandColumn Width="220px">
                    <GridCommandButton Command="Edit"
                                       Icon="@SvgIcon.Pencil"
                                       OnClick="@((GridCommandEventArgs e) => OpenEdit((AdminFileTypeWithExtensionsResponse)e.Item))">
                        Edit
                    </GridCommandButton>
                    <GridCommandButton Command="Extensions"
                                       Icon="@SvgIcon.FileWrench"
                                       OnClick="@((GridCommandEventArgs e) => OpenExtensions((AdminFileTypeWithExtensionsResponse)e.Item))">\n                        Extensions
                    </GridCommandButton>
                    <GridCommandButton Command="Delete"
                                       Icon="@SvgIcon.Trash"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                       OnClick="@((GridCommandEventArgs e) => ConfirmDelete((AdminFileTypeWithExtensionsResponse)e.Item))">
                        Delete
                    </GridCommandButton>
                </GridCommandColumn>
            </GridColumns>
        </TelerikGrid>
    }
</div>

@* ── Create / Edit Dialog ── *@
<TelerikDialog @bind-Visible="@_showTypeDialog"
               Title="@(_editingType is null ? "New File Type" : "Edit File Type")"
               Width="500px">
    <DialogContent>
        <EditForm Model="_typeForm" OnValidSubmit="SaveType">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Name <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="_typeForm.Name" Width="100%" />
                <ValidationMessage For="@(() => _typeForm.Name)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <TelerikTextArea @bind-Value="_typeForm.Description" Width="100%" Rows="3" />
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">Icon CSS class</label>
                    <TelerikTextBox @bind-Value="_typeForm.IconClass" Width="100%" />
                </div>
                <div class="col">
                    <label class="form-label">Color CSS class</label>
                    <TelerikTextBox @bind-Value="_typeForm.ColorClass" Width="100%" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-auto">
                    <label class="form-label">Sort order</label>
                    <TelerikNumericTextBox @bind-Value="_typeForm.SortOrder" Width="90px" />
                </div>
                <div class="col-auto d-flex align-items-end gap-3 pb-1">
                    <label>
                        <TelerikCheckBox @bind-Value="_typeForm.IsActive" />
                        <span class="ms-1">Active</span>
                    </label>
                    <label>
                        <TelerikCheckBox @bind-Value="_typeForm.IsPublic" />
                        <span class="ms-1">Public</span>
                    </label>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label d-block">Allowed extensions</label>
                <label>
                    <TelerikCheckBox @bind-Value="_typeForm.AllowAllExtensions" />
                    <span class="ms-1">Allow <strong>all</strong> file extensions</span>
                </label>
                @if (!_typeForm.AllowAllExtensions)
                {
                    <p class="text-muted mt-1 mb-0" style="font-size:.85em">
                        Extension patterns can be added/edited via the <em>Extensions</em> button after saving.
                    </p>
                }
            </div>
            @if (_saveError is not null)
            {
                <div class="alert alert-danger py-1">@_saveError</div>
            }
            <div class="d-flex gap-2 justify-content-end">
                <TelerikButton OnClick="CloseTypeDialog">Cancel</TelerikButton>
                <TelerikButton ButtonType="@ButtonType.Submit"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Enabled="@(!_saving)">
                    @(_saving ? "Saving…" : "Save")
                </TelerikButton>
            </div>
        </EditForm>
    </DialogContent>
</TelerikDialog>

@* ── Extensions Dialog ── *@
<TelerikDialog @bind-Visible="@_showExtDialog"
               Title="@($"Extensions — {_extFileType?.FileType.Name}")"
               Width="480px">
    <DialogContent>
        @if (_extFileType is not null)
        {
            @if (_extFileType.FileType.AllowAllExtensions)
            {
                <div class="alert alert-info py-2 mb-3">
                    This file type allows <strong>all</strong> extensions. Enable restricted mode on the file type to manage patterns.
                </div>
            }
            else
            {
                <div class="mb-3 d-flex gap-2">
                    <TelerikTextBox @bind-Value="_newPattern"
                                    Placeholder=".txt  or  .tx*"
                                    Width="200px" />
                    <TelerikButton Icon="@SvgIcon.Plus"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Enabled="@(!string.IsNullOrWhiteSpace(_newPattern))"
                                   OnClick="AddExtension">Add</TelerikButton>
                </div>
                @if (_extError is not null)
                {
                    <div class="alert alert-danger py-1 mb-2">@_extError</div>
                }
                @if (!_extFileType.Extensions.Any())
                {
                    <p class="text-muted">No extension patterns defined yet.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>Pattern</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var ext in _extList)
                            {
                                <tr>
                                    <td>
                                        @if (_editingExtId == ext.Id)
                                        {
                                            <TelerikTextBox @bind-Value="_editPattern" Width="150px" />
                                        }
                                        else
                                        {
                                            <code>@ext.Pattern</code>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (_editingExtId == ext.Id)
                                        {
                                            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                           OnClick="() => SaveExtension(ext.Id)">Save</TelerikButton>
                                            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                           OnClick="CancelEditExtension">Cancel</TelerikButton>
                                        }
                                        else
                                        {
                                            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                           Icon="@SvgIcon.Pencil"
                                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                           OnClick="() => StartEditExtension(ext)">Edit</TelerikButton>
                                            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                           Icon="@SvgIcon.Trash"
                                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                           OnClick="() => DeleteExtension(ext.Id)">Delete</TelerikButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            <div class="d-flex justify-content-end mt-2">
                <TelerikButton OnClick="CloseExtDialog">Close</TelerikButton>
            </div>
        }
    </DialogContent>
</TelerikDialog>

@* ── Delete Confirmation ── *@
<TelerikDialog @bind-Visible="@_showDeleteConfirm"
               Title="Delete File Type"
               Width="380px">
    <DialogContent>
        <p>Delete <strong>@_deleteTarget?.FileType.Name</strong>? This cannot be undone.</p>
        <div class="d-flex gap-2 justify-content-end">
            <TelerikButton OnClick="@(() => _showDeleteConfirm = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           OnClick="ExecuteDelete">Delete</TelerikButton>
        </div>
    </DialogContent>
</TelerikDialog>

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private IReadOnlyList<AdminFileTypeWithExtensionsResponse> _types = [];
    private bool _loading = true;
    private string? _error;

    // Type dialog
    private bool _showTypeDialog;
    private AdminFileTypeWithExtensionsResponse? _editingType;
    private FileTypeFormModel _typeForm = new();
    private bool _saving;
    private string? _saveError;

    // Extensions dialog
    private bool _showExtDialog;
    private AdminFileTypeWithExtensionsResponse? _extFileType;
    private List<UploadFileTypeExtensionRecord> _extList = [];
    private string _newPattern = string.Empty;
    private Guid? _editingExtId;
    private string _editPattern = string.Empty;
    private string? _extError;

    // Delete dialog
    private bool _showDeleteConfirm;
    private AdminFileTypeWithExtensionsResponse? _deleteTarget;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating)
        {
            NavManager.NavigateTo("/");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _types = await AdminClient.GetFileTypesWithExtensionsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load file types: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Create / Edit ─────────────────────────────────────────────────────────
    private void OpenCreate()
    {
        _editingType = null;
        _typeForm = new FileTypeFormModel();
        _saveError = null;
        _showTypeDialog = true;
    }

    private void OpenEdit(AdminFileTypeWithExtensionsResponse item)
    {
        _editingType = item;
        _typeForm = new FileTypeFormModel
        {
            Name = item.FileType.Name,
            Description = item.FileType.Description,
            IconClass = item.FileType.IconClass,
            ColorClass = item.FileType.ColorClass,
            IsActive = item.FileType.IsActive,
            IsPublic = item.FileType.IsPublic,
            SortOrder = item.FileType.SortOrder,
            AllowAllExtensions = item.FileType.AllowAllExtensions
        };
        _saveError = null;
        _showTypeDialog = true;
    }

    private async Task SaveType()
    {
        _saving = true;
        _saveError = null;
        try
        {
            if (_editingType is null)
            {
                var req = new AdminCreateFileTypeRequest(
                    _typeForm.Name,
                    _typeForm.Description,
                    _typeForm.IconClass,
                    _typeForm.ColorClass,
                    _typeForm.IsActive,
                    _typeForm.IsPublic,
                    _typeForm.SortOrder,
                    _typeForm.AllowAllExtensions,
                    UserState.UserId ?? Guid.Empty);

                await AdminClient.CreateFileTypeAsync(req);
            }
            else
            {
                var req = new AdminUpdateFileTypeRequest(
                    _typeForm.Name,
                    _typeForm.Description,
                    _typeForm.IconClass,
                    _typeForm.ColorClass,
                    _typeForm.IsActive,
                    _typeForm.IsPublic,
                    _typeForm.SortOrder,
                    _typeForm.AllowAllExtensions,
                    UserState.UserId);

                await AdminClient.UpdateFileTypeAsync(_editingType.FileType.Id, req);
            }

            _showTypeDialog = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void CloseTypeDialog() => _showTypeDialog = false;

    // ── Extensions ────────────────────────────────────────────────────────────
    private void OpenExtensions(AdminFileTypeWithExtensionsResponse item)
    {
        _extFileType = item;
        _extList = item.Extensions.ToList();
        _newPattern = string.Empty;
        _editingExtId = null;
        _extError = null;
        _showExtDialog = true;
    }

    private async Task AddExtension()
    {
        _extError = null;
        if (string.IsNullOrWhiteSpace(_newPattern) || _extFileType is null) return;

        try
        {
            var req = new AdminCreateFileTypeExtensionRequest(
                _extFileType.FileType.Id,
                _newPattern.Trim(),
                UserState.UserId ?? Guid.Empty);

            var created = await AdminClient.CreateFileTypeExtensionAsync(req);
            if (created is not null)
            {
                _extList.Add(created);
                _newPattern = string.Empty;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _extError = ex.Message;
        }
    }

    private void StartEditExtension(UploadFileTypeExtensionRecord ext)
    {
        _editingExtId = ext.Id;
        _editPattern = ext.Pattern;
    }

    private void CancelEditExtension()
    {
        _editingExtId = null;
        _editPattern = string.Empty;
    }

    private async Task SaveExtension(Guid id)
    {
        _extError = null;
        try
        {
            var updated = await AdminClient.UpdateFileTypeExtensionAsync(id, _editPattern);
            if (updated is not null)
            {
                var idx = _extList.FindIndex(e => e.Id == id);
                if (idx >= 0) _extList[idx] = updated;
            }
            _editingExtId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _extError = ex.Message;
        }
    }

    private async Task DeleteExtension(Guid id)
    {
        _extError = null;
        try
        {
            await AdminClient.DeleteFileTypeExtensionAsync(id);
            _extList.RemoveAll(e => e.Id == id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _extError = ex.Message;
        }
    }

    private void CloseExtDialog()
    {
        _showExtDialog = false;
        _extFileType = null;
    }

    // ── Delete ────────────────────────────────────────────────────────────────
    private void ConfirmDelete(AdminFileTypeWithExtensionsResponse item)
    {
        _deleteTarget = item;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDelete()
    {
        if (_deleteTarget is null) return;
        _showDeleteConfirm = false;
        await AdminClient.DeleteFileTypeAsync(_deleteTarget.FileType.Id);
        await LoadAsync();
    }

    // ── Form Model ────────────────────────────────────────────────────────────
    private sealed class FileTypeFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? IconClass { get; set; }
        public string? ColorClass { get; set; }
        public bool IsActive { get; set; } = true;
        public bool IsPublic { get; set; }
        public int SortOrder { get; set; }
        public bool AllowAllExtensions { get; set; } = true;
    }
}
