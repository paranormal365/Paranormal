@page "/admin/lookup-types"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Lookup Types</PageTitle>

<div class="container-fluid px-3">

    @* ── Header ── *@
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Lookup Types</h3>
        </div>
        <div class="col-auto">
            <TelerikButton Icon="@SvgIcon.Plus"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="OpenCreate">New</TelerikButton>
        </div>
    </div>

    @* ── Family selector ── *@
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Type Family</label>
            <TelerikDropDownList Data="@_families"
                                 Value="@_selectedFamily"
                                 ValueChanged="@((string r) => OnFamilyChanged(r))"
                                 TextField="@nameof(LookupFamily.Label)"
                                 ValueField="@nameof(LookupFamily.Route)"
                                 Width="100%" />
        </div>
    </div>

    @if (_loading)
    {
        <p>Loading…</p>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else
    {
        <TelerikGrid Data="@_items"
                     TItem="LookupTypeAdminRecord"
                     Sortable="true"
                     Pageable="true"
                     PageSize="20">
            <GridColumns>
                <GridColumn Field="@nameof(LookupTypeAdminRecord.Name)" Title="Name" />
                <GridColumn Field="@nameof(LookupTypeAdminRecord.Description)" Title="Description" />
                <GridColumn Field="@nameof(LookupTypeAdminRecord.IconClass)" Title="Icon" Width="110px">
                    <Template>
                        @{ var row = (LookupTypeAdminRecord)context; }
                        @if (!string.IsNullOrWhiteSpace(row.IconClass))
                        {
                            @if (row.IconClass.StartsWith("t:"))
                            {
                                var ico = IconPickerDialog.ResolveTelerikIcon(row.IconClass);
                                @if (ico is not null)
                                {
                                    <span title="@row.IconClass">
                                        <TelerikSvgIcon Icon="@ico" />
                                    </span>
                                }
                            }
                            else
                            {
                                <span title="@row.IconClass">
                                    <i class="@row.IconClass" style="font-size:1.1rem;"></i>
                                </span>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LookupTypeAdminRecord.SortOrder)" Title="Sort" Width="70px" />
                <GridColumn Field="@nameof(LookupTypeAdminRecord.IsActive)" Title="Active" Width="80px">
                    <Template>
                        @if (((LookupTypeAdminRecord)context).IsActive)
                        {
                            <TelerikSvgIcon Icon="@SvgIcon.Check"
                                            ThemeColor="@ThemeConstants.SvgIcon.ThemeColor.Success" />
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LookupTypeAdminRecord.IsPublic)" Title="Public" Width="80px">
                    <Template>
                        @if (((LookupTypeAdminRecord)context).IsPublic)
                        {
                            <TelerikSvgIcon Icon="@SvgIcon.Check"
                                            ThemeColor="@ThemeConstants.SvgIcon.ThemeColor.Success" />
                        }
                    </Template>
                </GridColumn>
                <GridCommandColumn Width="140px">
                    <GridCommandButton Command="Edit"
                                       Icon="@SvgIcon.Pencil"
                                       OnClick="@((GridCommandEventArgs e) => OpenEdit((LookupTypeAdminRecord)e.Items.First()))">
                        Edit
                    </GridCommandButton>
                    <GridCommandButton Command="Delete"
                                       Icon="@SvgIcon.Trash"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                       OnClick="@((GridCommandEventArgs e) => ConfirmDelete((LookupTypeAdminRecord)e.Items.First()))">
                    </GridCommandButton>
                </GridCommandColumn>
            </GridColumns>
        </TelerikGrid>
    }
</div>

@* ── Add / Edit dialog ── *@
<TelerikDialog @bind-Visible="@_showDialog"
               Title="@(_editingItem is null ? $"New {_familyLabel}" : $"Edit {_familyLabel}")"
               Width="520px"
               Class="@($"k-dialog-lookup f{_iconFieldKey}")">
    @* Class includes _iconFieldKey so TelerikDialog re-evaluates ShouldRender when the icon picker
       sets a new value — forcing portal content to refresh and the @key wrapper to be re-processed. *@
    <DialogContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="@_form.Name" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <TelerikTextBox @bind-Value="@_form.Description" Width="100%" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Icon <span class="text-secondary small">(optional)</span></label>
                @* @key forces the TextBox to be recreated (fresh Value) when the picker sets a new class *@
                <div class="d-flex align-items-center gap-1" @key="@_iconFieldKey">
                    <TelerikTextBox @bind-Value="@_form.IconClass"
                                    PlaceHolder="Browse or type: bi bi-house, t:Home…"
                                    Width="100%" />
                    @if (!string.IsNullOrWhiteSpace(_form.IconClass))
                    {
                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                       Icon="@SvgIcon.X"
                                       title="Clear icon"
                                       OnClick="@ClearIconClass" />
                    }
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   Icon="@SvgIcon.Search"
                                   title="Browse icons"
                                   OnClick="@OpenIconPickerAsync">Browse</TelerikButton>
                    @if (!string.IsNullOrWhiteSpace(_form.IconClass))
                    {
                        <span class="d-flex align-items-center justify-content-center border rounded"
                              style="min-width:34px;height:34px;flex-shrink:0;"
                              title="@_form.IconClass">
                            @if (_form.IconClass.StartsWith("t:"))
                            {
                                var svgIco = IconPickerDialog.ResolveTelerikIcon(_form.IconClass);
                                @if (svgIco is not null) { <TelerikSvgIcon Icon="@svgIco" /> }
                            }
                            else
                            {
                                <i class="@_form.IconClass"></i>
                            }
                        </span>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Color Class</label>
                <TelerikTextBox @bind-Value="@_form.ColorClass" Width="100%" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Sort Order</label>
                <TelerikNumericTextBox @bind-Value="@_form.SortOrder" Width="100%" Min="0" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <TelerikCheckBox @bind-Value="@_form.IsActive" Id="chkActive" />
                <label for="chkActive">Active</label>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <TelerikCheckBox @bind-Value="@_form.IsPublic" Id="chkPublic" />
                <label for="chkPublic">Public</label>
            </div>
            @if (_dialogError is not null)
            {
                <div class="col-12">
                    <div class="alert alert-danger py-2">@_dialogError</div>
                </div>
            }
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       OnClick="SaveAsync"
                       Enabled="@(!string.IsNullOrWhiteSpace(_form.Name))">
            Save
        </TelerikButton>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showDialog = false)">Cancel</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Delete confirm dialog ────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showDeleteDialog"
               Title="Confirm Delete"
               Width="400px">
    <DialogContent>
        <p>Delete <strong>@_deletingItem?.Name</strong>? This cannot be undone.</p>
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                       OnClick="ExecuteDeleteAsync">Delete</TelerikButton>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showDeleteDialog = false)">Cancel</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Icon Picker ─────────────────────────────────────────────── *@
<IconPickerDialog @bind-Visible="@_showIconPicker"
                  OnIconSelected="@OnIconPickerSelected" />

@code {

    // ── Family catalog ────────────────────────────────────────────────────────

    private sealed record LookupFamily(string Label, string Route);

    private static readonly List<LookupFamily> _families =
    [
        new("User — Address Types",        "api/admin/user-address-types"),
        new("User — Email Types",          "api/admin/user-email-types"),
        new("User — Phone Types",          "api/admin/user-phone-types"),
        new("User — Link Types",           "api/admin/user-link-types"),
        new("User — Note Types",           "api/admin/user-note-types"),
        new("User — Message Types",        "api/admin/user-message-types"),
        new("Org — Address Types",         "api/admin/organization-address-types"),
        new("Org — Email Types",           "api/admin/organization-email-types"),
        new("Org — Phone Types",           "api/admin/organization-phone-types"),
        new("Org — Link Types",            "api/admin/organization-link-types"),
        new("Org — Note Types",            "api/admin/organization-note-types"),
    ];

    // ── State ─────────────────────────────────────────────────────────────────

    private string _selectedFamily = _families[0].Route;
    private string _familyLabel => _families.FirstOrDefault(f => f.Route == _selectedFamily)?.Label ?? "Type";

    private IReadOnlyList<LookupTypeAdminRecord> _items = [];
    private bool _loading;
    private string? _error;

    // ── Dialog state ──────────────────────────────────────────────────────────

    private bool _showDialog;
    private LookupTypeAdminRecord? _editingItem;
    private FormModel _form = new();
    private string? _dialogError;

    private bool _showDeleteDialog;
    private LookupTypeAdminRecord? _deletingItem;
    private bool _showIconPicker;
    private bool _loadingIconPicker;
    private int  _iconFieldKey;

    private void ClearIconClass() { _form.IconClass = string.Empty; _iconFieldKey++; }

    /// <summary>Opens the icon picker with a brief spinner so the UI doesn't appear frozen.</summary>
    private async Task OpenIconPickerAsync()
    {
        _loadingIconPicker = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        _showIconPicker    = true;
        _loadingIconPicker = false;
    }

    /// <summary>Receives the chosen icon class string from the picker and forces a re-render.</summary>
    private async Task OnIconPickerSelected(string cls)
    {
        _form.IconClass = cls;
        _iconFieldKey++;                      // forces TextBox recreation with new Value
        await InvokeAsync(StateHasChanged);
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        if (!UserState.IsSuperAdmin)
            NavManager.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await AdminClient.GetLookupTypesAsync(_selectedFamily);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnFamilyChanged(string route)
    {
        _selectedFamily = route;
        await LoadAsync();
    }

    // ── CRUD ──────────────────────────────────────────────────────────────────

    private void OpenCreate()
    {
        _editingItem  = null;
        _form         = new FormModel { IsActive = true, SortOrder = 0 };
        _dialogError  = null;
        _iconFieldKey = 0;
        _showDialog   = true;
    }

    private void OpenEdit(LookupTypeAdminRecord item)
    {
        _editingItem  = item;
        _iconFieldKey = 0;
        _form = new FormModel
        {
            Name        = item.Name,
            Description = item.Description,
            IconClass   = item.IconClass,
            ColorClass  = item.ColorClass,
            IsActive    = item.IsActive,
            IsPublic    = item.IsPublic,
            SortOrder   = item.SortOrder,
        };
        _dialogError = null;
        _showDialog = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _dialogError = "Name is required.";
            return;
        }

        _dialogError = null;
        var userId = UserState.UserId ?? Guid.Empty;

        if (_editingItem is null)
        {
            // Create
            var req = new LookupTypeUpsertRequest(
                Guid.Empty,
                _form.Name,
                string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description,
                string.IsNullOrWhiteSpace(_form.IconClass)   ? null : _form.IconClass,
                string.IsNullOrWhiteSpace(_form.ColorClass)  ? null : _form.ColorClass,
                _form.IsActive,
                _form.IsPublic,
                _form.SortOrder,
                DateTime.UtcNow,
                null,
                userId,
                null);

            var created = await AdminClient.CreateLookupTypeAsync(_selectedFamily, req);
            if (created is null)
            {
                _dialogError = "Create failed. Check the API logs.";
                return;
            }
            _items = [created, .._items];
        }
        else
        {
            // Update
            var req = new LookupTypeUpsertRequest(
                _editingItem.Id,
                _form.Name,
                string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description,
                string.IsNullOrWhiteSpace(_form.IconClass)   ? null : _form.IconClass,
                string.IsNullOrWhiteSpace(_form.ColorClass)  ? null : _form.ColorClass,
                _form.IsActive,
                _form.IsPublic,
                _form.SortOrder,
                _editingItem.DateCreated,
                DateTime.UtcNow,
                _editingItem.CreatedByAppUserId,
                userId);

            var updated = await AdminClient.UpdateLookupTypeAsync(_selectedFamily, _editingItem.Id, req);
            if (updated is null)
            {
                _dialogError = "Update failed. Check the API logs.";
                return;
            }
            _items = [.._items.Select(i => i.Id == updated.Id ? updated : i)];
        }

        _showDialog = false;
    }

    private void ConfirmDelete(LookupTypeAdminRecord item)
    {
        _deletingItem = item;
        _showDeleteDialog = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deletingItem is null) return;
        var ok = await AdminClient.DeleteLookupTypeAsync(_selectedFamily, _deletingItem.Id);
        if (ok)
            _items = [.._items.Where(i => i.Id != _deletingItem.Id)];
        _showDeleteDialog = false;
        _deletingItem = null;
    }

    // ── Form model ────────────────────────────────────────────────────────────

    private sealed class FormModel
    {
        public string Name        { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? IconClass  { get; set; }
        public string? ColorClass { get; set; }
        public bool IsActive      { get; set; } = true;
        public bool IsPublic      { get; set; }
        public int SortOrder      { get; set; }
    }
}
