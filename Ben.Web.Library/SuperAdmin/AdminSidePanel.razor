@inject NavigationManager NavManager

@if (IsOpen)
{
    <div class="admin-panel-backdrop" @onclick="Close"></div>
}

<div class="admin-panel @(IsOpen ? "admin-panel--open" : "")">
    <div class="admin-panel-header">
        <span class="admin-panel-title">Administration</span>
        <TelerikButton Icon="@SvgIcon.X"
                       FillMode="@ThemeConstants.Button.FillMode.Clear"
                       Size="@ThemeConstants.Button.Size.Small"
                       Title="Close"
                       OnClick="Close" />
    </div>

    <nav class="admin-panel-nav">

        <div class="admin-panel-section-label">Users</div>
        <a class="admin-panel-link" href="/admin/users" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.User" />
            <span>Manage Users</span>
        </a>
        <a class="admin-panel-link" href="/admin/roles" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.Lock" />
            <span>Site Roles</span>
        </a>

        <div class="admin-panel-section-label">Organizations</div>
        <a class="admin-panel-link" href="/organizations" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.Globe" />
            <span>Manage Organizations</span>
        </a>

        <div class="admin-panel-section-label">Cases &amp; Investigations</div>
        <a class="admin-panel-link" href="/admin/cases" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.FolderOpen" />
            <span>All Cases</span>
        </a>
        <a class="admin-panel-link" href="/admin/investigations" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
            <span>All Investigations</span>
        </a>

        <div class="admin-panel-section-label">Content</div>
        <a class="admin-panel-link" href="/admin/file-types" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.FileConfig" />
            <span>File Types</span>
        </a>
        <a class="admin-panel-link" href="/admin/lookup-types" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.ListUnordered" />
            <span>Lookup Types</span>
        </a>
        <a class="admin-panel-link" href="/admin/experience-taxonomy" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.LayoutStacked" />
            <span>Experience Taxonomy</span>
        </a>

        <div class="admin-panel-section-label">System</div>
        <a class="admin-panel-link" href="/admin/audit-log" @onclick="Close" @onclick:preventDefault="false">
            <TelerikSvgIcon Icon="@SvgIcon.LayoutStacked" />
            <span>Audit Log</span>
        </a>

    </nav>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }
}
