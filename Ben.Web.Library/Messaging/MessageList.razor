@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@inject IBenUserState UserState

@* Reusable message list sub-component used by OrgMessages.razor *@

<div>
    @if (Messages is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    }
    else if (Messages.Count == 0)
    {
        <p class="text-secondary p-3">No messages.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-1">
            @foreach (var msg in Messages)
            {
                var m = msg;
                var unread = !m.IsReadByCurrentUser;
                <div class="card @(unread ? "border-primary" : "") message-row"
                     style="cursor:pointer;"
                     @onclick="@(() => OnOpen.InvokeAsync(m))">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex align-items-start justify-content-between gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    @if (unread)
                                    {
                                        <span class="badge bg-primary" style="font-size:0.65rem;">New</span>
                                    }
                                    <span class="badge @ChannelBadge(m.ChannelType)" style="font-size:0.65rem;">
                                        @ChannelLabel(m.ChannelType)
                                    </span>
                                    @if (m.IsEncrypted)
                                    {
                                        <span class="text-secondary" style="font-size:0.75rem;" title="Encrypted">🔒</span>
                                    }
                                    <strong class="@(unread ? "" : "text-secondary")">
                                        @(string.IsNullOrEmpty(m.Subject) ? "(No subject)" : m.Subject)
                                    </strong>
                                </div>
                                <div class="text-secondary small text-truncate" style="max-width:480px;">
                                    @StripHtml(m.Body)
                                </div>
                            </div>
                            <div class="text-end text-secondary small flex-shrink-0">
                                <div>@m.AuthorDisplayName</div>
                                <div>@m.DateCreated.ToViewerLocalTime(UserState).ToString("MMM d")</div>
                                @if (m.ReplyCount > 0)
                                {
                                    <div>@m.ReplyCount replies</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OrgMessageRecord>? Messages { get; set; }
    [Parameter] public EventCallback<OrgMessageRecord> OnOpen { get; set; }

    private static string ChannelLabel(OrgMessageChannel c) => c switch
    {
        OrgMessageChannel.OrgBroadcast  => "Broadcast",
        OrgMessageChannel.DirectMessage => "Direct",
        OrgMessageChannel.CaseTeam      => "Case Team",
        OrgMessageChannel.PublicFeed    => "Public",
        _                               => c.ToString(),
    };

    private static string ChannelBadge(OrgMessageChannel c) => c switch
    {
        OrgMessageChannel.OrgBroadcast  => "bg-primary",
        OrgMessageChannel.DirectMessage => "bg-info text-dark",
        OrgMessageChannel.CaseTeam      => "bg-warning text-dark",
        OrgMessageChannel.PublicFeed    => "bg-success",
        _                               => "bg-secondary",
    };

    private static string StripHtml(string? html)
        => string.IsNullOrWhiteSpace(html)
           ? ""
           : System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "").Trim();
}
