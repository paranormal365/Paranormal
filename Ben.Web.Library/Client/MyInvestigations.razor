@page "/my-investigations"
@using Ben.Data.Common.Enums
@using Ben.Web.Services
@using Ben.Web.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject NotificationState Notifications

<PageTitle>My Investigations</PageTitle>

<div class="container-fluid py-3" style="max-width:860px;">
    <h3 class="mb-4">My Investigations</h3>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_items is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading your investigations…" />
    }
    else if (_items.Count == 0 && _myEvents.Count == 0)
    {
        @* Both empty, or the page would tell somebody they have nothing while listing the event
           they signed up to this morning — which is the bug this section exists to fix, put back. *@
        <div class="text-center py-5 text-secondary">
            <p class="mb-3">You have not been assigned to any investigations.</p>
            <p class="small">When an investigation group schedules a visit and adds you to the team, it will appear here.</p>
            <p class="small">
                Anyone can come along to a group's <a href="/events">public events</a>.
            </p>
        </div>
    }
    else
    {
        var upcoming = _items.Where(i => i.Status is InvestigationStatus.Scheduled or InvestigationStatus.InProgress)
                             .OrderBy(i => i.ScheduledDateTime).ToList();
        var past     = _items.Where(i => i.Status is InvestigationStatus.Completed or InvestigationStatus.Cancelled
                                      || i.ScheduledDateTime < DateTime.UtcNow)
                             .OrderByDescending(i => i.ScheduledDateTime).ToList();

        @if (upcoming.Count > 0)
        {
            <h5 class="text-secondary mb-3">Upcoming</h5>
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var inv in upcoming)
                {
                    var isSaving = _saving.Contains(inv.AttendeeId);
                    <div class="card @(inv.Status == InvestigationStatus.InProgress ? "border-warning" : "")"
                         style="cursor:pointer;" @onclick="@(() => OpenInvestigation(inv))">
                        <div class="card-body">
                            @InvCardHeader(inv)
                            <span @onclick:stopPropagation="true">
                                @InvRsvpButtons(inv, isSaving)
                            </span>
                        </div>
                    </div>
                }
            </div>
        }

        @if (past.Count > 0)
        {
            <h5 class="text-secondary mb-3">Past</h5>
            <div class="d-flex flex-column gap-3">
                @foreach (var inv in past)
                {
                    <div class="card opacity-75" style="cursor:pointer;" @onclick="@(() => OpenInvestigation(inv))">
                        <div class="card-body">
                            @InvCardHeader(inv)
                            @if (inv.DidAttend.HasValue)
                            {
                                <div class="text-secondary small mt-2">
                                    Attendance: <strong>@(inv.DidAttend.Value ? "Attended" : "Did not attend")</strong>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Public events I said I would go to ───────────────────────────── *@
        @* Here rather than on a page of its own: from the person's point of view "things I am
           going to" is one list, and the difference between being on a team and having signed up
           to a public walk is a distinction only the database cares about. *@
        @if (_myEvents.Count > 0)
        {
            <h5 class="text-secondary mb-3">Events you're going to</h5>
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var ev in _myEvents)
                {
                    var isPast = ev.EndDateTime < DateTime.UtcNow;
                    <div class="card @(isPast ? "opacity-75" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">
                                        @if (ev.UrlName is string slug)
                                        {
                                            <a href="@($"/o/{ev.OrganizationUrlName}/events/{slug}")"
                                               class="text-decoration-none">@ev.Title</a>
                                        }
                                        else
                                        {
                                            @ev.Title
                                        }
                                    </div>
                                    <div class="text-secondary small">
                                        @ev.OrganizationName
                                        @if (ev.City is not null)
                                        {
                                            <span> · @ev.City@(ev.State is null ? "" : $", {ev.State}")</span>
                                        }
                                        @if (ev.IsOnline)
                                        {
                                            <span class="badge bg-info text-dark ms-1">Online</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-secondary small text-end flex-shrink-0">
                                    @ev.StartDateTime.ToViewerLocalTime(UserState).ToString("ddd d MMM")
                                    @if (!ev.IsAllDay)
                                    {
                                        <span class="d-block">@ev.StartDateTime.ToViewerLocalTime(UserState).ToString("h:mm tt")</span>
                                    }
                                </div>
                            </div>

                            @* The address, when there is one to have, lives on the event's own page
                               — it is only served to people who are coming, and repeating it here
                               would mean a second place to keep that rule right. *@
                            <div class="text-secondary mt-2" style="font-size:.75rem;">
                                @(isPast ? "This has already happened." : "You said you're coming. Open it for the details.")
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Where I have been ────────────────────────────────────────────── *@
        @if (_attended.Count > 0)
        {
            <h5 class="text-secondary mt-5 mb-1">
                Where I've been<HelpLink Slug="your-profile" Anchor="your-investigation-map" />
            </h5>
            <p class="text-secondary small">
                Investigations you actually attended — @_attended.Count so far.
            </p>

            @if (_attendedPins.Any(p => p.Latitude.HasValue))
            {
                <InvestigationsMap Pins="@_attendedPins" Height="320px" OnPinClicked="@OpenById" />
            }

            <div class="table-responsive mt-3">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>When</th><th>Investigation</th><th>Where</th><th>Group</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _attended)
                        {
                            <tr style="cursor:pointer;" @onclick="@(() => OpenById(row.InvestigationId))">
                                <td class="text-nowrap">@row.ScheduledDateTime.ToLocalTime().ToString("d MMM yyyy")</td>
                                <td>
                                    @row.Title
                                    @if (row.WasLead)
                                    {
                                        <span class="badge bg-primary ms-1">Led</span>
                                    }
                                </td>
                                <td>@AttendedWhere(row)</td>
                                <td>@row.OrganizationName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private List<MyInvestigationItem>? _items;
    private List<AttendedInvestigationItem> _attended = [];

    /// <summary>Public events this person said they would attend. Empty is the ordinary case.</summary>
    private IReadOnlyList<PublicEventListItem> _myEvents = [];
    private List<InvestigationMapPin> _attendedPins = [];
    private string? _error;
    private HashSet<Guid> _saving = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        _myEvents = await AdminClient.GetMyPublicEventsAsync();

        try { _items = (await AdminClient.GetMyInvestigationsAsync()).ToList(); }
        catch { _error = "Failed to load investigations."; _items = []; }

        try
        {
            _attended = (await AdminClient.GetAttendedInvestigationsAsync()).ToList();
            _attendedPins = _attended
                .Select(a => new InvestigationMapPin(
                    a.InvestigationId, a.Title, a.Latitude, a.Longitude, IsPast: true))
                .ToList();
        }
        catch
        {
            // The assignments list above is the point of this page; failing to draw the history
            // map should not take the whole screen down with it.
            _attended = [];
            _attendedPins = [];
        }

        StateHasChanged();
    }

    private void OpenInvestigation(MyInvestigationItem inv)
    {
        // CaseId is nullable now. A case-less visit has no case page to open, and building the URL
        // anyway would navigate to /cases/ with nothing after it.
        if (inv.CaseId is not { } caseId) return;
        NavManager.NavigateTo($"/organizations/{inv.OrgId}/cases/{caseId}?tab=investigations");
    }

    private void OpenById(Guid investigationId)
    {
        var row = _attended.FirstOrDefault(a => a.InvestigationId == investigationId);
        if (row?.CaseId is not { } caseId) return;
        NavManager.NavigateTo($"/organizations/{row.OrganizationId}/cases/{caseId}?tab=investigations");
    }

    private static string AttendedWhere(AttendedInvestigationItem row)
    {
        if (!string.IsNullOrWhiteSpace(row.PlaceName)) return row.PlaceName!;
        var cityState = string.Join(", ",
            new[] { row.PlaceCity, row.PlaceState }.Where(v => !string.IsNullOrWhiteSpace(v)));
        return string.IsNullOrWhiteSpace(cityState) ? "—" : cityState;
    }

    private async Task SetRsvp(MyInvestigationItem inv, RsvpStatus rsvp)
    {
        if (_saving.Contains(inv.AttendeeId)) return;
        _saving.Add(inv.AttendeeId);
        StateHasChanged();
        try
        {
            await AdminClient.UpdateMyInvestigationRsvpAsync(inv.AttendeeId, rsvp);
            var idx = _items!.IndexOf(inv);
            if (idx >= 0) _items[idx] = inv with { Rsvp = rsvp };

            // Answering the invite is exactly what the badge was counting, and the user is
            // still looking at it. Without this the drawer keeps showing the old number until
            // the next navigation or the 60s poll, which reads as "it didn't save".
            await Notifications.RefreshAsync(force: true);
        }
        catch { _error = "Failed to save your RSVP. Please try again."; }
        finally { _saving.Remove(inv.AttendeeId); StateHasChanged(); }
    }

    // ── Render helpers ────────────────────────────────────────────────────────

    private RenderFragment InvCardHeader(MyInvestigationItem inv) => __builder =>
    {
        <div class="d-flex align-items-start justify-content-between">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <span class="fw-semibold">@inv.Title</span>
                    <span class="badge @InvStatusBadge(inv.Status)" style="font-size:.72rem;">@inv.Status</span>
                    @if (!string.IsNullOrWhiteSpace(inv.AssignedRole))
                    {
                        <span class="badge bg-secondary" style="font-size:.72rem;">@inv.AssignedRole</span>
                    }
                </div>
                <div class="text-secondary small">
                    <span class="font-monospace">@inv.CaseReference</span>
                    <span class="mx-1">·</span>@inv.CaseTitle
                    <span class="mx-1">·</span>
                    <strong @onclick:stopPropagation="true">
                        <OrgNameLink OrganizationId="@inv.OrgId" OrganizationName="@inv.OrgName" OrgUrlName="@inv.OrgUrlName" IsMember="true" />
                    </strong>
                </div>
                <div class="small mt-1">
                    <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
                    @inv.ScheduledDateTime.ToViewerLocalTime(UserState).ToString("ddd MMM d, yyyy h:mm tt")
                    @if (inv.EndDateTime.HasValue)
                    {
                        <span class="text-secondary"> – @inv.EndDateTime.Value.ToViewerLocalTime(UserState).ToString("h:mm tt")</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(inv.Location))
                {
                    <div class="text-secondary small">
                        <TelerikSvgIcon Icon="@SvgIcon.MapMarker" /> @inv.Location
                    </div>
                }
                @if (inv.EvidenceDueDate.HasValue)
                {
                    <div class="text-warning small mt-1">
                        Evidence due: @inv.EvidenceDueDate.Value.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")
                    </div>
                }
            </div>
        </div>
    };

    private RenderFragment InvRsvpButtons(MyInvestigationItem inv, bool isSaving) => __builder =>
    {
        <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
            <span class="text-secondary small me-1">Your RSVP:</span>
            <TelerikButton ThemeColor="@(inv.Rsvp == RsvpStatus.Accepted ? "success" : "base")"
                           FillMode="@(inv.Rsvp == RsvpStatus.Accepted ? "solid" : "outline")"
                           Size="sm"
                           Enabled="@(!isSaving)"
                           OnClick="@(() => SetRsvp(inv, RsvpStatus.Accepted))">
                Will Attend
            </TelerikButton>
            <TelerikButton ThemeColor="@(inv.Rsvp == RsvpStatus.Tentative ? "warning" : "base")"
                           FillMode="@(inv.Rsvp == RsvpStatus.Tentative ? "solid" : "outline")"
                           Size="sm"
                           Enabled="@(!isSaving)"
                           OnClick="@(() => SetRsvp(inv, RsvpStatus.Tentative))">
                Tentative
            </TelerikButton>
            <TelerikButton ThemeColor="@(inv.Rsvp == RsvpStatus.Declined ? "error" : "base")"
                           FillMode="@(inv.Rsvp == RsvpStatus.Declined ? "solid" : "outline")"
                           Size="sm"
                           Enabled="@(!isSaving)"
                           OnClick="@(() => SetRsvp(inv, RsvpStatus.Declined))">
                Cannot Attend
            </TelerikButton>
            @if (isSaving)
            {
                <TelerikLoader Size="sm" />
            }
        </div>
    };

    private static string InvStatusBadge(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "bg-primary",
        InvestigationStatus.InProgress => "bg-warning text-dark",
        InvestigationStatus.Completed  => "bg-success",
        InvestigationStatus.Cancelled  => "bg-secondary",
        _                              => "bg-secondary",
    };
}
