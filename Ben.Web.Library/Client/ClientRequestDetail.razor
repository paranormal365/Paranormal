@page "/my-requests/{Id:guid}"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>Request Details</PageTitle>

<div class="container-fluid py-3" style="max-width:860px;">

    <div class="d-flex align-items-center gap-2 mb-4">
        <TelerikButton Icon="@SvgIcon.ArrowLeft"
                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                       OnClick="@(() => NavManager.NavigateTo("/my-requests"))">
            My Requests
        </TelerikButton>
        <span class="text-secondary">/</span>
        <h5 class="mb-0">Request Details</h5>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_request is null && _error is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    }
    else if (_request is not null)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="fw-semibold">@_request.City, @_request.State @_request.ZipCode</span>
                <span class="badge @StatusBadgeClass(_request.Status)">@StatusLabel(_request.Status)</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">
                        @_request.StreetAddress1
                        @if (!string.IsNullOrWhiteSpace(_request.StreetAddress2))
                        {
                            <br />@_request.StreetAddress2
                        }
                        <br />@_request.City, @_request.State @_request.ZipCode, @_request.Country
                    </dd>

                    @if (_request.BirthYear.HasValue)
                    {
                        <dt class="col-sm-3">Birth Year</dt>
                        <dd class="col-sm-9">@_request.BirthYear</dd>
                    }

                    <dt class="col-sm-3">Submitted</dt>
                    <dd class="col-sm-9">@_request.DateCreated.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")</dd>

                    @if (_request.DateUpdated.HasValue)
                    {
                        <dt class="col-sm-3">Last Updated</dt>
                        <dd class="col-sm-9">@_request.DateUpdated.Value.ToLocalTime().ToString("MMMM d, yyyy h:mm tt")</dd>
                    }
                </dl>

                @if (!string.IsNullOrWhiteSpace(_request.Description))
                {
                    <hr />
                    <div class="fw-semibold mb-1">Description</div>
                    <div>@((MarkupString)_request.Description)</div>
                }
            </div>

            @if (_request.Status is ClientRequestStatus.Draft or ClientRequestStatus.Submitted)
            {
                <div class="card-footer d-flex gap-2">
                    @if (_request.Status == ClientRequestStatus.Draft)
                    {
                        <TelerikButton Icon="@SvgIcon.Pencil"
                                       OnClick="@(() => NavManager.NavigateTo($"/my-requests/{Id}/edit"))">
                            Edit Draft
                        </TelerikButton>
                    }
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                   Icon="@SvgIcon.Cancel"
                                   Enabled="@(!_isBusy)"
                                   OnClick="@ConfirmWithdraw">
                        Withdraw
                    </TelerikButton>
                </div>
            }
        </div>
    }
</div>

@* ── Withdraw confirmation ─────────────────────────────────────────────────── *@
@if (_showWithdrawConfirm)
{
    <TelerikWindow Visible="true"
                   VisibleChanged="@((bool v) => { if (!v) _showWithdrawConfirm = false; })"
                   Width="420px"
                   Modal="true"
                   CloseOnOverlayClick="false">
        <WindowTitle>Withdraw Request</WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _showWithdrawConfirm = false)" />
        </WindowActions>
        <WindowContent>
            <div class="p-2">
                <p>Are you sure you want to withdraw this request? This cannot be undone.</p>
                @if (_withdrawError is not null)
                {
                    <div class="alert alert-danger">@_withdrawError</div>
                }
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <TelerikButton OnClick="@(() => _showWithdrawConfirm = false)">Cancel</TelerikButton>
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                   Enabled="@(!_isBusy)"
                                   OnClick="@WithdrawAsync">
                        @(_isBusy ? "Withdrawing…" : "Withdraw")
                    </TelerikButton>
                </div>
            </div>
        </WindowContent>
    </TelerikWindow>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ClientRequestRecord? _request;
    private string? _error;
    private bool _isBusy;
    private bool _showWithdrawConfirm;
    private string? _withdrawError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!UserState.IsAuthenticated)
        {
            NavManager.NavigateTo("/login");
            return;
        }
        try
        {
            _request = await AdminClient.GetClientRequestAsync(Id);
            if (_request is null) _error = "Request not found.";
        }
        catch { _error = "Failed to load request."; }
        StateHasChanged();
    }

    private void ConfirmWithdraw()
    {
        _withdrawError = null;
        _showWithdrawConfirm = true;
    }

    private async Task WithdrawAsync()
    {
        _isBusy = true; _withdrawError = null;
        try
        {
            var result = await AdminClient.WithdrawClientRequestAsync(Id);
            if (result is null) { _withdrawError = "Withdraw failed."; }
            else { _request = result; _showWithdrawConfirm = false; }
        }
        catch (Exception ex) { _withdrawError = ex.Message; }
        finally { _isBusy = false; }
    }

    private static string StatusBadgeClass(ClientRequestStatus s) => s switch
    {
        ClientRequestStatus.Draft     => "bg-secondary",
        ClientRequestStatus.Submitted => "bg-primary",
        ClientRequestStatus.Assigned  => "bg-success",
        ClientRequestStatus.Closed    => "bg-dark",
        ClientRequestStatus.Withdrawn => "bg-warning text-dark",
        _                             => "bg-secondary",
    };

    private static string StatusLabel(ClientRequestStatus s) => s switch
    {
        ClientRequestStatus.Draft     => "Draft",
        ClientRequestStatus.Submitted => "Submitted",
        ClientRequestStatus.Assigned  => "Assigned",
        ClientRequestStatus.Closed    => "Closed",
        ClientRequestStatus.Withdrawn => "Withdrawn",
        _                             => s.ToString(),
    };
}
