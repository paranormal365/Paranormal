@page "/my-cases/{CaseId:guid}"
@using Ben.Data.Common.Enums
@using Ben.Web.Library.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>@(_case?.Title ?? "My Case")</PageTitle>

@if (_loading)
{
    <TelerikLoaderContainer Visible="true" Text="Loading your case…" />
    return;
}

@if (_case is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Case not found</h2>
        <a href="/my-cases" class="btn btn-outline-secondary mt-3">← Back to My Cases</a>
    </div>
    return;
}

<div class="container-fluid py-3" style="max-width:960px;">

    @* ── Header ──────────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <a href="/my-cases" class="text-secondary small">← My Cases</a>
            <div class="d-flex align-items-center gap-2 mt-1">
                <span class="font-monospace text-muted">@_case.CaseReference</span>
                <span class="badge @StatusBadge(_case.Status)">@StatusLabel(_case.Status)</span>
            </div>
            <h3 class="mb-0 mt-1">@_case.Title</h3>
            <div class="text-secondary small">@_case.City, @_case.State · Opened @_case.DateCaseOpened.ToLocalTime().ToString("MMMM d, yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(_case.CaseManagerDisplayName))
            {
                <div class="text-secondary small mt-1">Case Manager: <strong>@_case.CaseManagerDisplayName</strong></div>
            }
        </div>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Plus"
                       OnClick="OpenLogDialog">Log Occurrence</TelerikButton>
    </div>

    @if (_error is not null) { <div class="alert alert-danger mb-3">@_error</div> }

    @* ── Main grid ────────────────────────────────────────────────────────────── *@
    <div class="row g-4">

        @* ── Calendar + occurrences ──────────────────────────────────────────── *@
        <div class="col-12 col-lg-7">
            <div class="card mb-3">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                    <span>Occurrence Calendar</span>
                    <span class="text-muted small">@_case.Occurrences.Count occurrence@(_case.Occurrences.Count == 1 ? "" : "s")</span>
                </div>
                <div class="card-body">
                    <TelerikCalendar Value="@_selectedDate"
                                     ValueChanged="@((DateTime d) => _selectedDate = d)"
                                     Min="@_case.DateCaseOpened.ToLocalTime().Date"
                                     Max="@(_case.DateCaseClosed?.ToLocalTime().Date ?? DateTime.Today)"
                                     ShowOtherMonthDays="false">
                    </TelerikCalendar>
                </div>
            </div>

            @* Occurrences for selected date *@
            @{ var dayOccurrences = OccurrencesForDate(_selectedDate); }
            @if (dayOccurrences.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">
                        @_selectedDate.ToString("MMMM d, yyyy")
                        <span class="badge bg-secondary ms-2">@dayOccurrences.Count</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var occ in dayOccurrences)
                        {
                            var o = occ;
                            <div class="list-group-item">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="flex-grow-1">
                                        @if (!string.IsNullOrWhiteSpace(o.Title))
                                        {
                                            <div class="fw-semibold small">@o.Title</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.Body))
                                        {
                                            <div class="text-secondary small mt-1">@((MarkupString)o.Body)</div>
                                        }
                                        <div class="text-muted" style="font-size:.72rem;">
                                            @((o.EventDateTime ?? o.DateCreated).ToLocalTime().ToString("h:mm tt"))
                                        </div>
                                        @* Attached files *@
                                        @if (o.Files.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var f in o.Files)
                                                {
                                                    var icon = f.ContentType.StartsWith("image/") ? SvgIcon.Image
                                                             : f.ContentType.StartsWith("video/") ? SvgIcon.Play
                                                             : f.ContentType.StartsWith("audio/") ? SvgIcon.Play
                                                             : SvgIcon.File;
                                                    <span class="badge bg-secondary d-flex align-items-center gap-1" title="@f.FileName">
                                                        <TelerikSvgIcon Icon="@icon" />
                                                        <span style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@f.FileName</span>
                                                        <TelerikButton Size="sm" FillMode="flat"
                                                                       Icon="@SvgIcon.X"
                                                                       Class="text-white p-0"
                                                                       OnClick="@(async () => await RemoveFile(o.Id, f.FileId))" />
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @* Attach file input *@
                                        <div class="mt-1">
                                            <InputFile OnChange="@(e => AttachFiles(o.Id, e))"
                                                       accept="image/*,audio/*,video/*,.pdf,.doc,.docx"
                                                       multiple
                                                       style="display:none;"
                                                       id="@($"file-{o.Id}")" />
                                            <label for="@($"file-{o.Id}")" class="btn btn-outline-secondary btn-sm" style="cursor:pointer; font-size:.72rem;">
                                                <TelerikSvgIcon Icon="@SvgIcon.Upload" /> Attach File
                                            </label>
                                            @if (_uploading.Contains(o.Id))
                                            {
                                                <TelerikLoader Size="sm" Class="ms-1" />
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 ms-2">
                                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       Icon="@SvgIcon.Pencil"
                                                       OnClick="@(() => OpenEditDialog(o))" />
                                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                       Icon="@SvgIcon.Trash"
                                                       OnClick="@(() => ConfirmDelete(o))" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_case.Occurrences.Count > 0)
            {
                <p class="text-secondary small text-center">No occurrences on @_selectedDate.ToString("MMMM d").</p>
            }
        </div>

        @* ── Right column: description + investigations ───────────────────────── *@
        <div class="col-12 col-lg-5">
            @if (!string.IsNullOrWhiteSpace(_case.Description))
            {
                <div class="card mb-3">
                    <div class="card-header fw-semibold">Case Summary</div>
                    <div class="card-body">@((MarkupString)_case.Description)</div>
                </div>
            }

            @if (_case.Investigations.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">Investigations</div>
                    <div class="list-group list-group-flush">
                        @foreach (var inv in _case.Investigations.OrderBy(i => i.ScheduledDateTime))
                        {
                            <div class="list-group-item">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div>
                                        <div class="fw-semibold small">@inv.Title</div>
                                        <div class="text-secondary small">
                                            @inv.ScheduledDateTime.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                            @if (inv.EndDateTime.HasValue)
                                            { <span> – @inv.EndDateTime.Value.ToLocalTime().ToString("h:mm tt")</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(inv.Location))
                                        {
                                            <div class="text-secondary small">@inv.Location</div>
                                        }
                                        @if (inv.EvidenceDueDate.HasValue)
                                        {
                                            var isPastDue = inv.EvidenceDueDate.Value.ToLocalTime() < DateTime.Now;
                                            var isSoon    = !isPastDue && inv.EvidenceDueDate.Value.ToLocalTime() < DateTime.Now.AddDays(7);
                                            <div class="small mt-1 @(isPastDue ? "text-danger" : isSoon ? "text-warning" : "text-secondary")">
                                                Evidence @(isPastDue ? "was due" : "due"):
                                                @inv.EvidenceDueDate.Value.ToLocalTime().ToString("MMM d, yyyy")
                                                @if (isPastDue) { <strong> (closed)</strong> }
                                            </div>
                                        }
                                    </div>
                                    <span class="badge @InvStatusBadge(inv.Status)">@InvStatusLabel(inv.Status)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>

    @* ── Scheduling proposals from the org ───────────────────────────────────── *@
    @if (_pendingProposals.Count > 0)
    {
        <div class="card mt-4 border-warning">
            <div class="card-header fw-semibold d-flex align-items-center gap-2 bg-warning text-dark">
                <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
                Investigation Date Proposal
                <span class="badge bg-dark">@_pendingProposals.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var prop in _pendingProposals)
                {
                    var p = prop;
                    <div class="list-group-item">
                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                        {
                            <div class="small mb-2">@p.Notes</div>
                        }
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var slot in p.Slots)
                            {
                                var s = slot;
                                <div class="d-flex align-items-center gap-2">
                                    <span class="small">
                                        @s.StartDateTime.ToLocalTime().ToString("ddd MMM d, yyyy h:mm tt")
                                        @if (s.EndDateTime.HasValue) { <span> – @s.EndDateTime.Value.ToLocalTime().ToString("h:mm tt")</span> }
                                    </span>
                                    <TelerikButton Size="sm" ThemeColor="success"
                                                   OnClick="@(async () => await AcceptProposal(p.Id, s.Id))"
                                                   Enabled="@(!_respondingProposal)">Accept</TelerikButton>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <TelerikButton Size="sm" FillMode="outline"
                                           OnClick="@(() => { _counterProposalId = p.Id; _showCounterDialog = true; })"
                                           Enabled="@(!_respondingProposal)">Suggest Different Date</TelerikButton>
                            <TelerikButton Size="sm" FillMode="flat" ThemeColor="error"
                                           OnClick="@(async () => await DeclineProposal(p.Id))"
                                           Enabled="@(!_respondingProposal)">Decline All</TelerikButton>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Message thread ──────────────────────────────────────────────────────── *@
    <div class="card mt-4">
        <div class="card-header fw-semibold d-flex align-items-center gap-2">
            <TelerikSvgIcon Icon="@SvgIcon.Comment" />
            Messages with your investigation group
            @if (_case.UnreadMessageCount > 0)
            {
                <span class="badge bg-danger rounded-pill" title="@_case.UnreadMessageCount unread">@_case.UnreadMessageCount</span>
            }
        </div>
        <div class="card-body">
            <CaseMessageThread CurrentSide="@Ben.Data.Common.Enums.CaseMessageSide.Client"
                               LoadMessages="@LoadClientMessages"
                               PostMessage="@PostClientMessage" />
        </div>
    </div>

    @* ── Published investigation reports ─────────────────────────────────────── *@
    @if (_reports.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <TelerikSvgIcon Icon="@SvgIcon.File" />
                Investigation Reports
                <span class="badge bg-secondary">@_reports.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var r in _reports)
                {
                    <div class="list-group-item d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold small">@r.Title</div>
                            @if (r.PublishedAt.HasValue)
                            {
                                <div class="text-secondary small">Published @r.PublishedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</div>
                            }
                        </div>
                        <TelerikButton Size="sm" FillMode="outline" Icon="@SvgIcon.FilePdf"
                                       OnClick="@(async () => await DownloadReport(r.Id))">PDF</TelerikButton>
                    </div>
                }
            </div>
        </div>
    }

</div>

@* ── Log / Edit Occurrence dialog ─────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showDialog"
               Title="@(_editOcc is null ? "Log Occurrence" : "Edit Occurrence")"
               Width="520px"
               Modal="true">
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Date & Time</label>
                <TelerikDateTimePicker @bind-Value="@_form.EventDateTime" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Brief Title (optional)</label>
                <TelerikTextBox @bind-Value="@_form.Title" Width="100%"
                                Placeholder="e.g. Knocking sounds in basement" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                <TelerikTextArea @bind-Value="@_form.Body" Rows="5" Width="100%"
                                 Placeholder="Describe what happened in detail…" />
            </div>
        </div>
        @if (_dialogError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
        }
    </WindowContent>
    <WindowActions>
        <WindowAction Name="Close" OnClick="@(() => _showDialog = false)" />
    </WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showDialog = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Icon="@SvgIcon.Save"
                           OnClick="SaveOccurrence"
                           Enabled="@(!_isBusy && !string.IsNullOrWhiteSpace(_form.Body))">
                @(_isBusy ? "Saving…" : "Save")
            </TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@* ── Delete confirmation ──────────────────────────────────────────────────────── *@
@if (_deleteOcc is not null)
{
    <TelerikWindow Visible="true"
                   VisibleChanged="@((bool v) => { if (!v) _deleteOcc = null; })"
                   Width="400px" Modal="true"
                   Title="Delete Occurrence">
        <WindowContent>
            <p>Are you sure you want to delete this occurrence?</p>
        </WindowContent>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _deleteOcc = null)" />
        </WindowActions>
        <WindowFooter>
            <div class="d-flex gap-2 justify-content-end w-100">
                <TelerikButton OnClick="@(() => _deleteOcc = null)">Cancel</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                               OnClick="DeleteOccurrence"
                               Enabled="@(!_isBusy)">Delete</TelerikButton>
            </div>
        </WindowFooter>
    </TelerikWindow>
}

@* ── Counter-proposal dialog ──────────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showCounterDialog" Title="Suggest a Different Date"
               Width="440px" Modal="true">
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Your Preferred Date & Time</label>
                <TelerikDateTimePicker @bind-Value="@_counterDateTime" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Notes (optional)</label>
                <TelerikTextArea @bind-Value="@_counterNotes" Rows="3" Width="100%"
                                 Placeholder="e.g. I am free weekends only." />
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" OnClick="@(() => _showCounterDialog = false)" /></WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showCounterDialog = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="primary" OnClick="SendCounter"
                           Enabled="@(_counterDateTime.HasValue && !_respondingProposal)">Send</TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@code {
    [Parameter] public Guid CaseId { get; set; }

    private ClientCaseDetail? _case;
    private bool _loading = true;
    private string? _error;
    private bool _isBusy;
    private HashSet<Guid> _uploading = [];
    private DateTime _selectedDate = DateTime.Today;

    // Dialog state
    private bool _showDialog;
    private ClientCaseOccurrence? _editOcc;
    private ClientCaseOccurrence? _deleteOcc;
    private string? _dialogError;
    private OccForm _form = new();
    private List<CaseReportSummary> _reports = [];
    private List<ScheduleProposalDto> _pendingProposals = [];
    private bool _respondingProposal;
    private bool _showCounterDialog;
    private Guid _counterProposalId;
    private DateTime? _counterDateTime;
    private string _counterNotes = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try { _case = await AdminClient.GetMyCaseAsync(CaseId); }
        catch { _error = "Failed to load case."; }
        _loading = false;
        StateHasChanged();

        // Load published reports after case renders (non-blocking)
        try { _reports = (await AdminClient.GetMyCaseReportsAsync(CaseId)).ToList(); StateHasChanged(); }
        catch { /* reports are optional; silent failure */ }

        // Load pending scheduling proposals
        try { _pendingProposals = (await AdminClient.GetMyScheduleProposalsAsync(CaseId)).ToList(); StateHasChanged(); }
        catch { /* silent */ }
    }

    private List<ClientCaseOccurrence> OccurrencesForDate(DateTime date) =>
        _case?.Occurrences
            .Where(o => (o.EventDateTime ?? o.DateCreated).ToLocalTime().Date == date.Date)
            .OrderBy(o => o.EventDateTime ?? o.DateCreated)
            .ToList() ?? [];

    private void OpenLogDialog()
    {
        _editOcc = null;
        _form = new OccForm { EventDateTime = _selectedDate.Date.AddHours(DateTime.Now.Hour) };
        _dialogError = null;
        _showDialog = true;
    }

    private void OpenEditDialog(ClientCaseOccurrence occ)
    {
        _editOcc = occ;
        _form = new OccForm
        {
            EventDateTime = occ.EventDateTime ?? occ.DateCreated,
            Title         = occ.Title ?? "",
            Body          = occ.Body ?? "",
        };
        _dialogError = null;
        _showDialog = true;
    }

    private void ConfirmDelete(ClientCaseOccurrence occ) => _deleteOcc = occ;

    private async Task SaveOccurrence()
    {
        if (string.IsNullOrWhiteSpace(_form.Body)) { _dialogError = "Description is required."; return; }
        _isBusy = true; _dialogError = null;
        try
        {
            var req = new LogOccurrenceRequest(_form.EventDateTime, _form.Title?.Trim(), _form.Body.Trim());
            if (_editOcc is null)
                await AdminClient.LogOccurrenceAsync(CaseId, req);
            else
                await AdminClient.UpdateOccurrenceAsync(CaseId, _editOcc.Id, req);
            _showDialog = false;
            await LoadAsync();
        }
        catch { _dialogError = "Save failed. Please try again."; }
        finally { _isBusy = false; }
    }

    private async Task DeleteOccurrence()
    {
        if (_deleteOcc is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.DeleteOccurrenceAsync(CaseId, _deleteOcc.Id);
            _deleteOcc = null;
            await LoadAsync();
        }
        catch { _error = "Delete failed."; }
        finally { _isBusy = false; }
    }

    private static string StatusBadge(CaseStatus s) => s switch
    {
        CaseStatus.Accepted  => "bg-primary",
        CaseStatus.Active    => "bg-success",
        CaseStatus.Public    => "bg-info text-dark",
        CaseStatus.Haunted   => "bg-warning text-dark",
        CaseStatus.Closed    => "bg-dark",
        _                    => "bg-secondary",
    };

    private static string StatusLabel(CaseStatus s) => s switch
    {
        CaseStatus.Accepted    => "Accepted",
        CaseStatus.Active      => "Active",
        CaseStatus.Public      => "Public",
        CaseStatus.Haunted     => "Haunted",
        CaseStatus.Closed      => "Closed",
        CaseStatus.Transferred => "Transferred",
        _                      => s.ToString(),
    };

    private static string InvStatusBadge(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "bg-primary",
        InvestigationStatus.InProgress => "bg-warning text-dark",
        InvestigationStatus.Completed  => "bg-success",
        _                              => "bg-secondary",
    };

    private static string InvStatusLabel(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "Scheduled",
        InvestigationStatus.InProgress => "In Progress",
        InvestigationStatus.Completed  => "Completed",
        InvestigationStatus.Cancelled  => "Cancelled",
        _                              => s.ToString(),
    };

    private class OccForm
    {
        public DateTime? EventDateTime { get; set; } = DateTime.Now;
        public string    Title         { get; set; } = "";
        public string    Body          { get; set; } = "";
    }

    private Task<IReadOnlyList<CaseMessageRecord>> LoadClientMessages()
        => AdminClient.GetMyCaseMessagesAsync(CaseId);

    private async Task<CaseMessageRecord?> PostClientMessage(string body)
        => await AdminClient.PostMyCaseMessageAsync(CaseId, body);

    private async Task DownloadReport(Guid reportId)
    {
        var result = await AdminClient.DownloadMyCaseReportPdfAsync(CaseId, reportId);
        if (result is null) return;
        var base64 = Convert.ToBase64String(result.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, "application/pdf", result.Value.FileName);
    }

    private async Task AcceptProposal(Guid proposalId, Guid slotId)
    {
        _respondingProposal = true;
        try
        {
            var result = await AdminClient.AcceptScheduleProposalAsync(CaseId, proposalId, slotId);
            if (result is not null) _pendingProposals.RemoveAll(p => p.Id == proposalId);
        }
        catch { _error = "Failed to accept proposal."; }
        finally { _respondingProposal = false; StateHasChanged(); }
    }

    private async Task DeclineProposal(Guid proposalId)
    {
        _respondingProposal = true;
        try
        {
            await AdminClient.DeclineScheduleProposalAsync(CaseId, proposalId, null);
            _pendingProposals.RemoveAll(p => p.Id == proposalId);
        }
        catch { _error = "Failed to decline proposal."; }
        finally { _respondingProposal = false; StateHasChanged(); }
    }

    private async Task SendCounter()
    {
        if (!_counterDateTime.HasValue) return;
        _respondingProposal = true;
        try
        {
            await AdminClient.CounterScheduleProposalAsync(CaseId, _counterProposalId, _counterDateTime.Value, _counterNotes);
            _pendingProposals.RemoveAll(p => p.Id == _counterProposalId);
            _showCounterDialog = false;
        }
        catch { _error = "Failed to send counter-proposal."; }
        finally { _respondingProposal = false; StateHasChanged(); }
    }

    private async Task AttachFiles(Guid entryId, InputFileChangeEventArgs e)
    {
        _uploading.Add(entryId);
        StateHasChanged();
        try
        {
            foreach (var f in e.GetMultipleFiles(10))
            {
                using var stream = f.OpenReadStream(maxAllowedSize: 50_000_000); // 50 MB max
                var item = await AdminClient.AttachOccurrenceFileAsync(CaseId, entryId, stream, f.Name, f.ContentType);
                if (item is not null)
                {
                    // Optimistic update — add file to the in-memory occurrence
                    var occ = _case?.Occurrences.FirstOrDefault(o => o.Id == entryId);
                    if (occ is not null)
                    {
                        var updatedFiles = occ.Files.ToList();
                        updatedFiles.Add(item);
                        var idx = _case!.Occurrences.ToList().IndexOf(occ);
                        var newList = _case.Occurrences.ToList();
                        newList[idx] = occ with { Files = updatedFiles };
                        _case = _case with { Occurrences = newList };
                    }
                }
            }
        }
        catch { _error = "Failed to attach file. Please try again."; }
        finally { _uploading.Remove(entryId); StateHasChanged(); }
    }

    private async Task RemoveFile(Guid entryId, Guid fileId)
    {
        try
        {
            await AdminClient.DetachOccurrenceFileAsync(CaseId, entryId, fileId);
            var occ = _case?.Occurrences.FirstOrDefault(o => o.Id == entryId);
            if (occ is not null)
            {
                var updatedFiles = occ.Files.Where(f => f.FileId != fileId).ToList();
                var idx = _case!.Occurrences.ToList().IndexOf(occ);
                var newList = _case.Occurrences.ToList();
                newList[idx] = occ with { Files = updatedFiles };
                _case = _case with { Occurrences = newList };
                StateHasChanged();
            }
        }
        catch { _error = "Failed to remove file."; }
    }
}
