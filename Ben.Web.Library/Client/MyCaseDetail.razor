@page "/my-cases/{CaseId:guid}"
@using Ben.Data.Common.Enums
@using Ben.Web.Library.Services
@using Ben.Web.Library.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>@(_case?.Title ?? "My Case")</PageTitle>

@if (_loading)
{
    <TelerikLoaderContainer Visible="true" Text="Loading your case…" />
    return;
}

@if (_case is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Case not found</h2>
        <a href="/my-cases" class="btn btn-outline-secondary mt-3">← Back to My Cases</a>
    </div>
    return;
}

<div class="container-fluid py-3" style="max-width:960px;">

    @* ── Header ──────────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <a href="/my-cases" class="text-secondary small">← My Cases</a>
            <div class="d-flex align-items-center gap-2 mt-1">
                <span class="font-monospace text-muted">@_case.CaseReference</span>
                <span class="badge @_case.Status.BadgeClass()">@_case.Status.Label()</span>
            </div>
            <h3 class="mb-0 mt-1">@_case.Title</h3>
            <div class="text-secondary small">@_case.City, @_case.State · Opened @_case.DateCaseOpened.ToViewerLocalTime(UserState).ToString("MMMM d, yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(_case.CaseManagerDisplayName))
            {
                <div class="text-secondary small mt-1">Case Manager: <strong>@_case.CaseManagerDisplayName</strong></div>
            }
        </div>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Plus"
                       OnClick="OpenLogDialog">Log Occurrence</TelerikButton>
    </div>

    @if (_error is not null) { <div class="alert alert-danger mb-3">@_error</div> }

    @* ── Main grid ────────────────────────────────────────────────────────────── *@
    <div class="row g-4">

        @* ── Calendar + occurrences ──────────────────────────────────────────── *@
        <div class="col-12 col-lg-7">
            <div class="card mb-3">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                    <span>Occurrence Calendar</span>
                    <span class="text-muted small">@_case.Occurrences.Count occurrence@(_case.Occurrences.Count == 1 ? "" : "s")</span>
                </div>
                <div class="card-body">
                    <TelerikCalendar Value="@_selectedDate"
                                     ValueChanged="@((DateTime d) => _selectedDate = d)"
                                     Min="@_case.DateCaseOpened.ToViewerLocalTime(UserState).Date"
                                     Max="@(_case.DateCaseClosed?.ToViewerLocalTime(UserState).Date ?? UserState.NowInViewerTimeZone().Date)"
                                     ShowOtherMonthDays="false">
                    </TelerikCalendar>
                </div>
            </div>

            @* Occurrences for selected date *@
            @{ var dayOccurrences = OccurrencesForDate(_selectedDate); }
            @if (dayOccurrences.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">
                        @_selectedDate.ToString("MMMM d, yyyy")
                        <span class="badge bg-secondary ms-2">@dayOccurrences.Count</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var occ in dayOccurrences)
                        {
                            var o = occ;
                            <div class="list-group-item">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="flex-grow-1">
                                        @* Org-authored entries can now reach this list, so say so —
                                           otherwise an investigator's note reads as the client's own. *@
                                        @if (o.FromInvestigators)
                                        {
                                            <span class="badge bg-primary mb-1">From the investigators</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.Title))
                                        {
                                            <div class="fw-semibold small">@o.Title</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.Body))
                                        {
                                            <div class="text-secondary small mt-1">@((MarkupString)o.Body)</div>
                                        }
                                        <div class="text-muted" style="font-size:.72rem;">
                                            @((o.EventDateTime ?? o.DateCreated).ToViewerLocalTime(UserState).ToString("h:mm tt"))
                                        </div>
                                        @* Attached files *@
                                        @if (o.Files.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var f in o.Files)
                                                {
                                                    var icon = f.ContentType.StartsWith("image/") ? SvgIcon.Image
                                                             : f.ContentType.StartsWith("video/") ? SvgIcon.Play
                                                             : f.ContentType.StartsWith("audio/") ? SvgIcon.Play
                                                             : SvgIcon.File;
                                                    <span class="badge bg-secondary d-flex align-items-center gap-1" title="@f.FileName">
                                                        <TelerikSvgIcon Icon="@icon" />
                                                        <span style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@f.FileName</span>
                                                        <TelerikButton Size="sm" FillMode="flat"
                                                                       Icon="@SvgIcon.X"
                                                                       Class="text-white p-0"
                                                                       OnClick="@(async () => await RemoveFile(o.Id, f.FileId))" />
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @* Attach file input *@
                                        <div class="mt-1">
                                            <InputFile OnChange="@(e => AttachFiles(o.Id, e))"
                                                       accept="image/*,audio/*,video/*,.pdf,.doc,.docx"
                                                       multiple
                                                       style="display:none;"
                                                       id="@($"file-{o.Id}")" />
                                            <label for="@($"file-{o.Id}")" class="btn btn-outline-secondary btn-sm" style="cursor:pointer; font-size:.72rem;">
                                                <TelerikSvgIcon Icon="@SvgIcon.Upload" /> Attach File
                                            </label>
                                            @if (_uploading.Contains(o.Id))
                                            {
                                                <TelerikLoader Size="sm" Class="ms-1" />
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 ms-2">
                                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       Icon="@SvgIcon.Pencil"
                                                       OnClick="@(() => OpenEditDialog(o))" />
                                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                       Icon="@SvgIcon.Trash"
                                                       OnClick="@(() => ConfirmDelete(o))" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_case.Occurrences.Count > 0)
            {
                <p class="text-secondary small text-center">No occurrences on @_selectedDate.ToString("MMMM d").</p>
            }
        </div>

        @* ── Right column: description + investigations ───────────────────────── *@
        <div class="col-12 col-lg-5">
            @if (!string.IsNullOrWhiteSpace(_case.Description))
            {
                <div class="card mb-3">
                    <div class="card-header fw-semibold">Case Summary</div>
                    <div class="card-body">@((MarkupString)_case.Description)</div>
                </div>
            }

            @if (_case.Investigations.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">Investigations</div>
                    <div class="list-group list-group-flush">
                        @foreach (var inv in _case.Investigations.OrderBy(i => i.ScheduledDateTime))
                        {
                            var canCancel  = inv.CancellationDeadlineUtc.HasValue && DateTime.UtcNow < inv.CancellationDeadlineUtc.Value;
                            var deadlinePassed = inv.CancellationDeadlineUtc.HasValue && DateTime.UtcNow >= inv.CancellationDeadlineUtc.Value;
                            <div class="list-group-item">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div>
                                        <div class="fw-semibold small">@inv.Title</div>
                                        <div class="text-secondary small">
                                            @inv.ScheduledDateTime.ToViewerLocalTime(UserState).ToString("MMM d, yyyy h:mm tt")
                                            @if (inv.EndDateTime.HasValue)
                                            { <span> – @inv.EndDateTime.Value.ToViewerLocalTime(UserState).ToString("h:mm tt")</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(inv.Location))
                                        {
                                            <div class="text-secondary small">@inv.Location</div>
                                        }
                                        @if (inv.EvidenceDueDate.HasValue)
                                        {
                                            var isPastDue = inv.EvidenceDueDate.Value < DateTime.UtcNow;
                                            var isSoon    = !isPastDue && inv.EvidenceDueDate.Value < DateTime.UtcNow.AddDays(7);
                                            <div class="small mt-1 @(isPastDue ? "text-danger" : isSoon ? "text-warning" : "text-secondary")">
                                                Evidence @(isPastDue ? "was due" : "due"):
                                                @inv.EvidenceDueDate.Value.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")
                                                @if (isPastDue) { <strong> (closed)</strong> }
                                            </div>
                                        }
                                        @if (canCancel)
                                        {
                                            <div class="text-secondary small mt-1">
                                                Cancel by: @inv.CancellationDeadlineUtc!.Value.ToViewerLocalTime(UserState).ToString("MMM d h:mm tt")
                                            </div>
                                        }
                                        @if (deadlinePassed && inv.Status == Ben.Data.Common.Enums.InvestigationStatus.Scheduled)
                                        {
                                            <div class="text-muted small mt-1"><em>Cancellation window closed</em></div>
                                        }
                                    </div>
                                    <div class="d-flex flex-column align-items-end gap-1">
                                        <span class="badge @InvStatusBadge(inv.Status)">@InvStatusLabel(inv.Status)</span>
                                        @if (canCancel)
                                        {
                                            <TelerikButton Size="sm" ThemeColor="error" FillMode="outline"
                                                           OnClick="@(async () => await CancelInvestigation(inv.Id))"
                                                           Enabled="@(!_cancelling)">Cancel Visit</TelerikButton>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>

    @* ── Scheduling proposals from the org ───────────────────────────────────── *@
    @if (_pendingProposals.Count > 0)
    {
        <div class="card mt-4 border-warning">
            <div class="card-header fw-semibold d-flex align-items-center gap-2 bg-warning text-dark">
                <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
                Investigation Date Proposal
                <span class="badge bg-dark">@_pendingProposals.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var prop in _pendingProposals)
                {
                    var p = prop;
                    <div class="list-group-item">
                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                        {
                            <div class="small mb-2">@p.Notes</div>
                        }
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var slot in p.Slots)
                            {
                                var s = slot;
                                <div class="d-flex align-items-center gap-2">
                                    <span class="small">
                                        @s.StartDateTime.ToViewerLocalTime(UserState).ToString("ddd MMM d, yyyy h:mm tt")
                                        @if (s.EndDateTime.HasValue) { <span> – @s.EndDateTime.Value.ToViewerLocalTime(UserState).ToString("h:mm tt")</span> }
                                    </span>
                                    <TelerikButton Size="sm" ThemeColor="success"
                                                   OnClick="@(async () => await AcceptProposal(p.Id, s.Id))"
                                                   Enabled="@(!_respondingProposal)">Accept</TelerikButton>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <TelerikButton Size="sm" FillMode="outline"
                                           OnClick="@(() => { _counterProposalId = p.Id; _showCounterDialog = true; })"
                                           Enabled="@(!_respondingProposal)">Suggest Different Date</TelerikButton>
                            <TelerikButton Size="sm" FillMode="flat" ThemeColor="error"
                                           OnClick="@(async () => await DeclineProposal(p.Id))"
                                           Enabled="@(!_respondingProposal)">Decline All</TelerikButton>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Co-client access management (primary client only) ──────────────────── *@
    @if (_isPrimaryClient)
    {
        <div class="card mt-4">
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                <span><TelerikSvgIcon Icon="@SvgIcon.Group" /> Shared Access</span>
                <TelerikButton Size="sm" Icon="@SvgIcon.Plus" OnClick="@(() => _showAddCoClient = true)">Add Person</TelerikButton>
            </div>
            <div class="card-body">
                @if (_coClients.Count == 0 && _pendingInvites.Count == 0)
                {
                    <div class="text-secondary small">Only you have access. Use 'Add Person' to share this case with another account.</div>
                }
                <div class="d-flex flex-column gap-1">
                    @foreach (var cc in _coClients)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small">@cc.DisplayName</span>
                            <TelerikButton Size="sm" FillMode="flat" ThemeColor="error" Icon="@SvgIcon.X"
                                           OnClick="@(async () => await RemoveCoClient(cc.AccessId))" />
                        </div>
                    }
                </div>

                @if (_pendingInvites.Count > 0)
                {
                    <div class="text-secondary small fw-semibold mt-3 mb-1">Pending Invites</div>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var inv in _pendingInvites)
                        {
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small">
                                    @inv.Email
                                    <span class="text-secondary"> · expires @inv.DateExpires.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")</span>
                                </span>
                                <div class="d-flex gap-1">
                                    <TelerikButton Size="sm" FillMode="flat" Icon="@SvgIcon.Copy"
                                                   OnClick="@(() => CopyInviteLink(inv))">Copy Link</TelerikButton>
                                    <TelerikButton Size="sm" FillMode="flat" ThemeColor="error" Icon="@SvgIcon.X"
                                                   OnClick="@(async () => await RevokeInvite(inv.Id))" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── People at the property (basic info, no account) ─────────────────────── *@
    <div class="card mt-4">
        <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
            <span><TelerikSvgIcon Icon="@SvgIcon.Group" /> People at the Property</span>
            @if (_isPrimaryClient)
            {
                <TelerikButton Size="sm" Icon="@SvgIcon.Plus" OnClick="OpenAddPerson">Add Person</TelerikButton>
            }
        </div>
        <div class="card-body">
            <div class="text-secondary small mb-2">
                People you mention who don't have accounts on this site — for reference in your notes and timeline. This information is never made public.
            </div>
            @if (_relatedPeople.Count == 0)
            {
                <div class="text-secondary small">No one added yet.</div>
            }
            <div class="d-flex flex-column gap-2">
                @foreach (var p in _relatedPeople)
                {
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="d-flex align-items-start gap-2">
                            @if (p.UploadFileId is { } pf && _personPhotos.TryGetValue(pf, out var pfSrc))
                            {
                                <img src="@pfSrc" alt="@p.Name" class="rounded border"
                                     style="width:40px;height:40px;object-fit:cover;flex:0 0 auto;" />
                            }
                        <div>
                            <span class="small fw-semibold">@p.Name</span>
                            @if (p.Age.HasValue) { <span class="small text-secondary"> · Age @p.Age</span> }
                            @if (!string.IsNullOrWhiteSpace(p.Relationship)) { <span class="small text-secondary"> · @p.Relationship</span> }
                            @if (p.LivesAtProperty) { <span class="badge bg-info text-dark ms-1" style="font-size:.65rem;">Lives here</span> }
                            @if (!string.IsNullOrWhiteSpace(p.Notes))
                            {
                                <div class="text-secondary small">@p.Notes</div>
                            }
                        </div>
                        </div>
                        @if (_isPrimaryClient)
                        {
                            <div class="d-flex gap-1">
                                <TelerikButton Size="sm" FillMode="flat" Icon="@SvgIcon.Pencil"
                                               Title="Edit"
                                               OnClick="@(() => OpenEditPerson(p))" />
                                <TelerikButton Size="sm" FillMode="flat" ThemeColor="error" Icon="@SvgIcon.X"
                                               Title="Remove"
                                               OnClick="@(async () => await RemoveRelatedPerson(p.Id))" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Message thread ──────────────────────────────────────────────────────── *@
    <div class="card mt-4">
        <div class="card-header fw-semibold d-flex align-items-center gap-2">
            <TelerikSvgIcon Icon="@SvgIcon.Comment" />
            Messages with your investigation group
            @if (_case.UnreadMessageCount > 0)
            {
                <span class="badge bg-danger rounded-pill" title="@_case.UnreadMessageCount unread">@_case.UnreadMessageCount</span>
            }
        </div>
        <div class="card-body">
            <CaseMessageThread CurrentSide="@Ben.Data.Common.Enums.CaseMessageSide.Client"
                               LoadMessages="@LoadClientMessages"
                               PostMessage="@PostClientMessage" />
        </div>
    </div>

    @* ── Published investigation reports ─────────────────────────────────────── *@
    @if (_reports.Count > 0)
    {
        <div class="card mt-4">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <TelerikSvgIcon Icon="@SvgIcon.File" />
                Investigation Reports
                <span class="badge bg-secondary">@_reports.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var r in _reports)
                {
                    <div class="list-group-item d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold small">@r.Title</div>
                            @if (r.PublishedAt.HasValue)
                            {
                                <div class="text-secondary small">Published @r.PublishedAt.Value.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")</div>
                            }
                        </div>
                        <TelerikButton Size="sm" FillMode="outline" Icon="@SvgIcon.FilePdf"
                                       OnClick="@(async () => await DownloadReport(r.Id))">PDF</TelerikButton>
                    </div>
                }
            </div>
        </div>
    }

</div>

@* ── Log / Edit Occurrence dialog ─────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showDialog"
               Width="520px"
               Modal="true">
    <WindowTitle>@(_editOcc is null ? "Log Occurrence" : "Edit Occurrence")</WindowTitle>
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Date & Time</label>
                <TelerikDateTimePicker @bind-Value="@_form.EventDateTime" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Brief Title (optional)</label>
                <TelerikTextBox @bind-Value="@_form.Title" Width="100%"
                                Placeholder="e.g. Knocking sounds in basement" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                <TelerikTextArea @bind-Value="@_form.Body" Rows="5" Width="100%"
                                 Placeholder="Describe what happened in detail…" />
            </div>
        </div>
        @if (_dialogError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
        }
    </WindowContent>
    <WindowActions>
        <WindowAction Name="Close" OnClick="@(() => _showDialog = false)" />
    </WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showDialog = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Icon="@SvgIcon.Save"
                           OnClick="SaveOccurrence"
                           Enabled="@(!_isBusy && !string.IsNullOrWhiteSpace(_form.Body))">
                @(_isBusy ? "Saving…" : "Save")
            </TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@* ── Delete confirmation ──────────────────────────────────────────────────────── *@
@if (_deleteOcc is not null)
{
    <TelerikWindow Visible="true"
                   VisibleChanged="@((bool v) => { if (!v) _deleteOcc = null; })"
                   Width="400px" Modal="true">
        <WindowTitle>Delete Occurrence</WindowTitle>
        <WindowContent>
            <p>Are you sure you want to delete this occurrence?</p>
        </WindowContent>
        <WindowActions>
            <WindowAction Name="Close" OnClick="@(() => _deleteOcc = null)" />
        </WindowActions>
        <WindowFooter>
            <div class="d-flex gap-2 justify-content-end w-100">
                <TelerikButton OnClick="@(() => _deleteOcc = null)">Cancel</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                               OnClick="DeleteOccurrence"
                               Enabled="@(!_isBusy)">Delete</TelerikButton>
            </div>
        </WindowFooter>
    </TelerikWindow>
}

@* ── Add co-client / invite dialog ────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showAddCoClient" Width="440px" Modal="true">
    <WindowTitle>Share Case Access</WindowTitle>
    <WindowContent>
        @if (_inviteResult is null)
        {
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Email address of person to add</label>
                    <TelerikTextBox @bind-Value="@_addCoClientEmail" Width="100%"
                                    Placeholder="person@example.com" />
                    <div class="form-text">If they don't have an account yet, we'll send them an invite to create one.</div>
                    @if (!string.IsNullOrWhiteSpace(_addCoClientEmail) && !IsValidEmailFormat(_addCoClientEmail))
                    {
                        <div class="text-danger small mt-1">Enter a valid email address.</div>
                    }
                </div>
                @if (_inviteError is not null)
                {
                    <div class="col-12"><div class="alert alert-danger py-2 mb-0">@_inviteError</div></div>
                }
            </div>
        }
        else if (_inviteResult.LinkedExistingAccount)
        {
            <div class="alert alert-success mb-0">
                <strong>@_inviteResult.CoClient?.DisplayName</strong> already has an account and now has access to this case.
            </div>
        }
        else
        {
            <p class="mb-2">
                @if (_inviteResult.EmailSent)
                {
                    <text>An invite email is on its way to <strong>@_inviteResult.Invite?.Email</strong>. You can also share this link directly:</text>
                }
                else
                {
                    <text>Email isn't set up on this server yet — share this link with <strong>@_inviteResult.Invite?.Email</strong> yourself:</text>
                }
            </p>
            <div class="d-flex gap-2">
                <TelerikTextBox Value="@InviteLink(_inviteResult.Invite)" ReadOnly="true" Width="100%" />
                <TelerikButton Icon="@SvgIcon.Copy" OnClick="@(() => CopyToClipboard(InviteLink(_inviteResult.Invite)))" />
            </div>
            <div class="text-secondary small mt-2">This link expires @_inviteResult.Invite?.DateExpires.ToViewerLocalTime(UserState).ToString("MMMM d, yyyy").</div>
        }
    </WindowContent>
    <WindowActions><WindowAction Name="Close" OnClick="CloseAddCoClientDialog" /></WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            @if (_inviteResult is null)
            {
                <TelerikButton OnClick="CloseAddCoClientDialog">Cancel</TelerikButton>
                <TelerikButton ThemeColor="primary" OnClick="AddCoClient" Enabled="@(IsValidEmailFormat(_addCoClientEmail) && !_isInviting)">
                    @(_isInviting ? "Sending..." : "Add")
                </TelerikButton>
            }
            else
            {
                <TelerikButton ThemeColor="primary" OnClick="CloseAddCoClientDialog">Done</TelerikButton>
            }
        </div>
    </WindowFooter>
</TelerikWindow>

@* ── Add related person dialog ────────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showAddRelatedPerson" Width="420px" Modal="true">
    <WindowTitle>@(_editingPersonId is null ? "Add a Person" : "Edit Person")</WindowTitle>
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Name</label>
                <TelerikTextBox @bind-Value="@_newPersonName" Width="100%" Placeholder="Full name" />
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold">Age (optional)</label>
                <TelerikNumericTextBox @bind-Value="@_newPersonAge" Width="100%" Min="0" Max="120" />
            </div>
            <div class="col-6 d-flex align-items-end">
                <div class="form-check">
                    <TelerikCheckBox @bind-Value="@_newPersonLivesAtProperty" Id="livesHere" />
                    <label class="form-check-label ms-1" for="livesHere">Lives at the property</label>
                </div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Relationship (optional)</label>
                <TelerikTextBox @bind-Value="@_newPersonRelationship" Width="100%" Placeholder="e.g. spouse, neighbor, tenant" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Notes (optional)</label>
                <TelerikTextArea @bind-Value="@_newPersonNotes" Rows="2" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Photo (optional)</label>
                <div class="d-flex align-items-center gap-3">
                    @if (_personPhotoPreview is not null)
                    {
                        <img src="@_personPhotoPreview" alt="" class="rounded border"
                             style="width:64px;height:64px;object-fit:cover;flex:0 0 auto;" />
                    }
                    <div class="d-flex flex-column gap-1 flex-grow-1">
                        <InputFile OnChange="OnPersonPhotoSelected" class="form-control form-control-sm"
                                   accept="image/jpeg,image/png,image/gif,image/webp" />
                        @if (_personPhotoUploading)
                        {
                            <span class="text-secondary small">Uploading…</span>
                        }
                        else if (_newPersonPhotoFileId is not null)
                        {
                            <TelerikButton Size="sm" FillMode="flat" ThemeColor="error"
                                           OnClick="ClearPersonPhoto">Remove photo</TelerikButton>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="text-secondary small">This information is never made public, even if the case is.</div>
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" OnClick="@(() => _showAddRelatedPerson = false)" /></WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showAddRelatedPerson = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="primary" OnClick="SaveRelatedPerson"
                           Enabled="@(!string.IsNullOrWhiteSpace(_newPersonName) && !_personPhotoUploading)">
                @(_editingPersonId is null ? "Add" : "Save")
            </TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@* ── Counter-proposal dialog ──────────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showCounterDialog" Width="440px" Modal="true">
    <WindowTitle>Suggest a Different Date</WindowTitle>
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Your Preferred Date & Time</label>
                <TelerikDateTimePicker @bind-Value="@_counterDateTime" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Notes (optional)</label>
                <TelerikTextArea @bind-Value="@_counterNotes" Rows="3" Width="100%"
                                 Placeholder="e.g. I am free weekends only." />
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" OnClick="@(() => _showCounterDialog = false)" /></WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showCounterDialog = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="primary" OnClick="SendCounter"
                           Enabled="@(_counterDateTime.HasValue && !_respondingProposal)">Send</TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@code {
    [Parameter] public Guid CaseId { get; set; }

    private ClientCaseDetail? _case;
    private bool _loading = true;
    private string? _error;
    private bool _isBusy;
    private HashSet<Guid> _uploading = [];
    private DateTime _selectedDate = DateTime.Today;

    // Dialog state
    private bool _showDialog;
    private ClientCaseOccurrence? _editOcc;
    private ClientCaseOccurrence? _deleteOcc;
    private string? _dialogError;
    private OccForm _form = new();
    private List<CaseReportSummary> _reports = [];
    private List<ScheduleProposalDto> _pendingProposals = [];
    private List<CoClientItem> _coClients = [];
    private bool _isPrimaryClient;
    private bool _respondingProposal;
    private bool _cancelling;
    private bool _showAddCoClient;
    private string _addCoClientEmail = "";
    private List<CaseClientInviteRecord> _pendingInvites = [];
    private InviteCoClientResult? _inviteResult;
    private string? _inviteError;
    private bool _isInviting;
    private List<CaseRelatedPersonRecord> _relatedPeople = [];
    private bool _showAddRelatedPerson;

    /// <summary>Which person is being edited; null while adding a new one.</summary>
    private Guid? _editingPersonId;
    private Guid? _newPersonPhotoFileId;
    private string? _personPhotoPreview;
    private bool _personPhotoUploading;

    /// <summary>
    /// Witness photo thumbnails as data URIs, keyed by upload-file id. Fetched through the
    /// authenticated client rather than linked directly: these files are private, and a browser
    /// sends no bearer token with an &lt;img&gt; request, so a direct URL renders broken.
    /// </summary>
    private readonly Dictionary<Guid, string> _personPhotos = [];

    /// <summary>Witness photos are case evidence — same upload type as everything else on a case.</summary>
    private static readonly Guid EvidenceFileTypeId = new("20000000-0000-0000-0000-000000000001");
    private string _newPersonName = "";
    private int? _newPersonAge;
    private string _newPersonRelationship = "";
    private bool _newPersonLivesAtProperty;
    private string _newPersonNotes = "";
    private bool _showCounterDialog;
    private Guid _counterProposalId;
    private DateTime? _counterDateTime;
    private string _counterNotes = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try { _case = await AdminClient.GetMyCaseAsync(CaseId); }
        catch { _error = "Failed to load case."; }
        _loading = false;
        StateHasChanged();

        // Load published reports after case renders (non-blocking)
        try { _reports = (await AdminClient.GetMyCaseReportsAsync(CaseId)).ToList(); StateHasChanged(); }
        catch { /* reports are optional; silent failure */ }

        // Load pending scheduling proposals
        try { _pendingProposals = (await AdminClient.GetMyScheduleProposalsAsync(CaseId)).ToList(); StateHasChanged(); }
        catch { /* silent */ }

        // Co-clients — only load (and only shown) for the primary client. IsPrimaryClient comes
        // from the case detail response itself, not from whether GetCoClients happens not to
        // throw: the generic HTTP client returns an empty list on a 403 rather than throwing, so
        // that inference silently showed every co-client the primary-only admin controls too.
        _isPrimaryClient = _case?.IsPrimaryClient ?? false;
        if (_isPrimaryClient)
        {
            try
            {
                _coClients = (await AdminClient.GetCoClientsAsync(CaseId)).ToList();
                _pendingInvites = (await AdminClient.GetCaseInvitesAsync(CaseId)).ToList();
                StateHasChanged();
            }
            catch { /* silent — Shared Access card just shows its empty state */ }
        }

        try
        {
            _relatedPeople = (await AdminClient.GetRelatedPeopleAsync(CaseId)).ToList();
            await LoadPersonPhotosAsync();
            StateHasChanged();
        }
        catch { /* silent */ }
    }

    private List<ClientCaseOccurrence> OccurrencesForDate(DateTime date) =>
        _case?.Occurrences
            .Where(o => (o.EventDateTime ?? o.DateCreated).ToViewerLocalTime(UserState).Date == date.Date)
            .OrderBy(o => o.EventDateTime ?? o.DateCreated)
            .ThenBy(o => o.DateCreated).ThenBy(o => o.Id)
            .ToList() ?? [];

    private void OpenLogDialog()
    {
        _editOcc = null;
        _form = new OccForm { EventDateTime = _selectedDate.Date.AddHours(UserState.NowInViewerTimeZone().Hour) };
        _dialogError = null;
        _showDialog = true;
    }

    private void OpenEditDialog(ClientCaseOccurrence occ)
    {
        _editOcc = occ;
        _form = new OccForm
        {
            EventDateTime = (occ.EventDateTime ?? occ.DateCreated).ToViewerLocalTime(UserState),
            Title         = occ.Title ?? "",
            Body          = occ.Body ?? "",
        };
        _dialogError = null;
        _showDialog = true;
    }

    private void ConfirmDelete(ClientCaseOccurrence occ) => _deleteOcc = occ;

    private async Task SaveOccurrence()
    {
        if (string.IsNullOrWhiteSpace(_form.Body)) { _dialogError = "Description is required."; return; }
        _isBusy = true; _dialogError = null;
        try
        {
            var req = new LogOccurrenceRequest(_form.EventDateTime!.Value.ToUtcFromViewerLocal(UserState), _form.Title?.Trim(), _form.Body.Trim());
            if (_editOcc is null)
                await AdminClient.LogOccurrenceAsync(CaseId, req);
            else
                await AdminClient.UpdateOccurrenceAsync(CaseId, _editOcc.Id, req);
            _showDialog = false;
            await LoadAsync();
        }
        catch { _dialogError = "Save failed. Please try again."; }
        finally { _isBusy = false; }
    }

    private async Task DeleteOccurrence()
    {
        if (_deleteOcc is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.DeleteOccurrenceAsync(CaseId, _deleteOcc.Id);
            _deleteOcc = null;
            await LoadAsync();
        }
        catch { _error = "Delete failed."; }
        finally { _isBusy = false; }
    }

    private static string InvStatusBadge(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "bg-primary",
        InvestigationStatus.InProgress => "bg-warning text-dark",
        InvestigationStatus.Completed  => "bg-success",
        _                              => "bg-secondary",
    };

    private static string InvStatusLabel(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "Scheduled",
        InvestigationStatus.InProgress => "In Progress",
        InvestigationStatus.Completed  => "Completed",
        InvestigationStatus.Cancelled  => "Cancelled",
        _                              => s.ToString(),
    };

    private class OccForm
    {
        public DateTime? EventDateTime { get; set; } = DateTime.Now;
        public string    Title         { get; set; } = "";
        public string    Body          { get; set; } = "";
    }

    private async Task RemoveCoClient(Guid accessId)
    {
        await AdminClient.RemoveCoClientAsync(CaseId, accessId);
        _coClients.RemoveAll(c => c.AccessId == accessId);
        StateHasChanged();
    }

    /// <summary>Server-side validation is already correct; this is UX polish only — catches an
    /// obviously malformed address before round-tripping to the API.</summary>
    private static bool IsValidEmailFormat(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try { return new System.Net.Mail.MailAddress(email.Trim()).Address == email.Trim(); }
        catch { return false; }
    }

    private async Task AddCoClient()
    {
        if (!IsValidEmailFormat(_addCoClientEmail) || _isInviting) return;
        _isInviting = true;
        _inviteError = null;
        try
        {
            var result = await AdminClient.InviteCoClientAsync(CaseId, _addCoClientEmail.Trim());
            if (result is null)
            {
                _inviteError = "Something went wrong. Please try again.";
                return;
            }

            if (result.LinkedExistingAccount && result.CoClient is not null)
                _coClients.Add(result.CoClient);
            else if (result.Invite is not null)
                _pendingInvites.Insert(0, result.Invite);

            _inviteResult = result;
        }
        catch
        {
            _inviteError = "Something went wrong. Please try again.";
        }
        finally
        {
            _isInviting = false;
            StateHasChanged();
        }
    }

    private void CloseAddCoClientDialog()
    {
        _showAddCoClient = false;
        _addCoClientEmail = "";
        _inviteResult = null;
        _inviteError = null;
    }

    private string InviteLink(CaseClientInviteRecord? invite) =>
        invite is null ? "" : $"{NavManager.BaseUri.TrimEnd('/')}/invite/{invite.Token}";

    private async Task CopyToClipboard(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { /* clipboard access can be denied by the browser — link is still visible/selectable */ }
    }

    private Task CopyInviteLink(CaseClientInviteRecord invite) => CopyToClipboard(InviteLink(invite));

    private async Task RevokeInvite(Guid inviteId)
    {
        await AdminClient.RevokeCaseInviteAsync(CaseId, inviteId);
        _pendingInvites.RemoveAll(i => i.Id == inviteId);
        StateHasChanged();
    }

    private async Task RemoveRelatedPerson(Guid personId)
    {
        await AdminClient.RemoveRelatedPersonAsync(CaseId, personId);
        _relatedPeople.RemoveAll(p => p.Id == personId);
        StateHasChanged();
    }

    private void OpenAddPerson()
    {
        _editingPersonId = null;
        ResetPersonForm();
        _showAddRelatedPerson = true;
    }

    private void OpenEditPerson(CaseRelatedPersonRecord p)
    {
        _editingPersonId          = p.Id;
        _newPersonName            = p.Name;
        _newPersonAge             = p.Age;
        _newPersonRelationship    = p.Relationship ?? "";
        _newPersonLivesAtProperty = p.LivesAtProperty;
        _newPersonNotes           = p.Notes ?? "";
        _newPersonPhotoFileId     = p.UploadFileId;
        _personPhotoPreview       = p.UploadFileId is { } f && _personPhotos.TryGetValue(f, out var src) ? src : null;
        _showAddRelatedPerson     = true;
    }

    private void ResetPersonForm()
    {
        _newPersonName = ""; _newPersonAge = null; _newPersonRelationship = "";
        _newPersonLivesAtProperty = false; _newPersonNotes = "";
        _newPersonPhotoFileId = null; _personPhotoPreview = null;
    }

    private void ClearPersonPhoto()
    {
        _newPersonPhotoFileId = null;
        _personPhotoPreview   = null;
    }

    private async Task OnPersonPhotoSelected(InputFileChangeEventArgs e)
    {
        _personPhotoUploading = true;
        try
        {
            var file = e.File;
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: long.MaxValue).CopyToAsync(ms);
            var bytes = ms.ToArray();

            var uploaded = await AdminClient.UploadUserFileAsync(
                EvidenceFileTypeId, UserState.UserId ?? Guid.Empty,
                file.Name, file.ContentType, bytes,
                description: "Witness photo", isPublic: false);
            if (uploaded is null) { _error = "Couldn't upload that photo."; return; }

            _newPersonPhotoFileId = uploaded.Id;
            // Preview from the bytes already in hand — no round trip, and it works regardless of
            // the file being private.
            _personPhotoPreview   = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            _personPhotos[uploaded.Id] = _personPhotoPreview;
        }
        catch { _error = "Couldn't upload that photo."; }
        finally { _personPhotoUploading = false; StateHasChanged(); }
    }

    private async Task SaveRelatedPerson()
    {
        if (string.IsNullOrWhiteSpace(_newPersonName)) return;

        var name         = _newPersonName.Trim();
        var relationship = string.IsNullOrWhiteSpace(_newPersonRelationship) ? null : _newPersonRelationship.Trim();
        var notes        = string.IsNullOrWhiteSpace(_newPersonNotes) ? null : _newPersonNotes.Trim();

        if (_editingPersonId is { } editId)
        {
            var updated = await AdminClient.UpdateRelatedPersonAsync(CaseId, editId,
                new UpdateRelatedPersonRequest(name, _newPersonAge, relationship,
                                               _newPersonLivesAtProperty, notes, _newPersonPhotoFileId));
            if (updated is not null)
            {
                var idx = _relatedPeople.FindIndex(p => p.Id == editId);
                if (idx >= 0) _relatedPeople[idx] = updated;
                _showAddRelatedPerson = false;
                _editingPersonId = null;
            }
            else { _error = "Couldn't save that person."; }
        }
        else
        {
            var added = await AdminClient.AddRelatedPersonAsync(CaseId,
                new AddRelatedPersonRequest(name, _newPersonAge, relationship,
                                            _newPersonLivesAtProperty, notes, _newPersonPhotoFileId));
            if (added is not null)
            {
                _relatedPeople.Add(added);
                _showAddRelatedPerson = false;
                ResetPersonForm();
            }
            else { _error = "Couldn't add that person."; }
        }
        StateHasChanged();
    }

    /// <summary>Fetches thumbnails for any witness photos not already cached.</summary>
    private async Task LoadPersonPhotosAsync()
    {
        foreach (var id in _relatedPeople.Select(p => p.UploadFileId).OfType<Guid>().Distinct())
        {
            if (_personPhotos.ContainsKey(id)) continue;
            try
            {
                var file = await AdminClient.GetFileDataAsync(id);
                if (file is { } f)
                    _personPhotos[id] = $"data:{f.ContentType};base64,{Convert.ToBase64String(f.Data)}";
            }
            catch { /* a missing thumbnail is not worth failing the page over */ }
        }
    }

    private Task<IReadOnlyList<CaseMessageRecord>> LoadClientMessages()
        => AdminClient.GetMyCaseMessagesAsync(CaseId);

    private async Task<CaseMessageRecord?> PostClientMessage(string body)
        => await AdminClient.PostMyCaseMessageAsync(CaseId, body);

    private async Task DownloadReport(Guid reportId)
    {
        var result = await AdminClient.DownloadMyCaseReportPdfAsync(CaseId, reportId);
        if (result is null) return;
        var base64 = Convert.ToBase64String(result.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, "application/pdf", result.Value.FileName);
    }

    private async Task AcceptProposal(Guid proposalId, Guid slotId)
    {
        _respondingProposal = true;
        try
        {
            var result = await AdminClient.AcceptScheduleProposalAsync(CaseId, proposalId, slotId);
            if (result is not null) _pendingProposals.RemoveAll(p => p.Id == proposalId);
        }
        catch { _error = "Failed to accept proposal."; }
        finally { _respondingProposal = false; StateHasChanged(); }
    }

    private async Task DeclineProposal(Guid proposalId)
    {
        _respondingProposal = true;
        try
        {
            await AdminClient.DeclineScheduleProposalAsync(CaseId, proposalId, null);
            _pendingProposals.RemoveAll(p => p.Id == proposalId);
        }
        catch { _error = "Failed to decline proposal."; }
        finally { _respondingProposal = false; StateHasChanged(); }
    }

    private async Task CancelInvestigation(Guid invId)
    {
        _cancelling = true;
        try
        {
            var ok = await AdminClient.CancelMyInvestigationAsync(CaseId, invId);
            if (ok)
            {
                // Reload so the status badge and cancel button update
                _case = await AdminClient.GetMyCaseAsync(CaseId);
                _pendingProposals = (await AdminClient.GetMyScheduleProposalsAsync(CaseId)).ToList();
            }
            else { _error = "The cancellation window has closed for this investigation."; }
        }
        catch { _error = "Failed to cancel investigation."; }
        finally { _cancelling = false; StateHasChanged(); }
    }

    private async Task SendCounter()
    {
        if (!_counterDateTime.HasValue) return;
        _respondingProposal = true;
        try
        {
            await AdminClient.CounterScheduleProposalAsync(CaseId, _counterProposalId, _counterDateTime.Value, _counterNotes);
            _pendingProposals.RemoveAll(p => p.Id == _counterProposalId);
            _showCounterDialog = false;
        }
        catch { _error = "Failed to send counter-proposal."; }
        finally { _respondingProposal = false; StateHasChanged(); }
    }

    private async Task AttachFiles(Guid entryId, InputFileChangeEventArgs e)
    {
        _uploading.Add(entryId);
        StateHasChanged();
        try
        {
            foreach (var f in e.GetMultipleFiles(10))
            {
                // No practical upload size limit for now — a future limit belongs at app-settings /
                // per-person / per-org / per-case / per-investigation scope, not a blanket cap here.
                using var stream = f.OpenReadStream(maxAllowedSize: long.MaxValue);
                var item = await AdminClient.AttachOccurrenceFileAsync(CaseId, entryId, stream, f.Name, f.ContentType);
                if (item is not null)
                {
                    // Optimistic update — add file to the in-memory occurrence
                    var occ = _case?.Occurrences.FirstOrDefault(o => o.Id == entryId);
                    if (occ is not null)
                    {
                        var updatedFiles = occ.Files.ToList();
                        updatedFiles.Add(item);
                        var idx = _case!.Occurrences.ToList().IndexOf(occ);
                        var newList = _case.Occurrences.ToList();
                        newList[idx] = occ with { Files = updatedFiles };
                        _case = _case with { Occurrences = newList };
                    }
                }
            }
        }
        catch { _error = "Failed to attach file. Please try again."; }
        finally { _uploading.Remove(entryId); StateHasChanged(); }
    }

    private async Task RemoveFile(Guid entryId, Guid fileId)
    {
        try
        {
            await AdminClient.DetachOccurrenceFileAsync(CaseId, entryId, fileId);
            var occ = _case?.Occurrences.FirstOrDefault(o => o.Id == entryId);
            if (occ is not null)
            {
                var updatedFiles = occ.Files.Where(f => f.FileId != fileId).ToList();
                var idx = _case!.Occurrences.ToList().IndexOf(occ);
                var newList = _case.Occurrences.ToList();
                newList[idx] = occ with { Files = updatedFiles };
                _case = _case with { Occurrences = newList };
                StateHasChanged();
            }
        }
        catch { _error = "Failed to remove file."; }
    }
}
