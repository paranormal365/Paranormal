@page "/my-cases"
@using Ben.Data.Common.Enums
@using Ben.Web.Library.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>My Cases</PageTitle>

<div class="container-fluid py-3" style="max-width:860px;">
    <h3 class="mb-4">My Cases</h3>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_cases is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading your cases…" />
    }
    else if (_cases.Count == 0)
    {
        <div class="text-center py-5 text-secondary">
            <p class="mb-3">You have no active cases.</p>
            <p class="small">Cases appear here after an investigation group accepts your request.</p>
            <a href="/my-requests" class="btn btn-outline-primary mt-2">View My Requests</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var c in _cases)
            {
                <div class="card" style="cursor:pointer;" @onclick="@(() => NavManager.NavigateTo($"/my-cases/{c.CaseId}"))">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="font-monospace text-muted" style="font-size:.8rem;">@c.CaseReference</span>
                                    <span class="badge @StatusBadge(c.Status)">@StatusLabel(c.Status)</span>
                                </div>
                                <div class="fw-semibold">@c.Title</div>
                                <div class="text-secondary small">@c.City, @c.State</div>
                            </div>
                            <TelerikSvgIcon Icon="@SvgIcon.ChevronRight" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.CaseManagerDisplayName))
                        {
                            <div class="text-secondary small mt-1">
                                Case Manager: <span class="fw-semibold">@c.CaseManagerDisplayName</span>
                            </div>
                        }
                        <div class="text-secondary small mt-1">
                            Opened @c.DateCaseOpened.ToLocalTime().ToString("MMMM d, yyyy")
                        </div>
                        @if (c.NextInvestigationDate.HasValue)
                        {
                            <div class="small mt-1 text-primary fw-semibold">
                                <TelerikSvgIcon Icon="@SvgIcon.Calendar" />
                                Next visit: @c.NextInvestigationDate.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ClientCaseListItem>? _cases;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!RendererInfo.IsInteractive) return;
        await UserState.AuthReady;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        try { _cases = (await AdminClient.GetMyCasesAsync()).ToList(); }
        catch { _error = "Failed to load cases."; _cases = []; }
        StateHasChanged();
    }

    private static string StatusBadge(CaseStatus s) => s switch
    {
        CaseStatus.Accepted  => "bg-primary",
        CaseStatus.Active    => "bg-success",
        CaseStatus.Public    => "bg-info text-dark",
        CaseStatus.Haunted   => "bg-warning text-dark",
        CaseStatus.Closed    => "bg-dark",
        _                    => "bg-secondary",
    };

    private static string StatusLabel(CaseStatus s) => s switch
    {
        CaseStatus.Accepted    => "Accepted",
        CaseStatus.Active      => "Active",
        CaseStatus.Public      => "Public",
        CaseStatus.Haunted     => "Haunted",
        CaseStatus.Closed      => "Closed",
        CaseStatus.Transferred => "Transferred",
        _                      => s.ToString(),
    };
}
