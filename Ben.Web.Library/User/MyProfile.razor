@page "/profile"
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>My Profile</PageTitle>

<div class="container-fluid py-3" style="max-width:720px;">
    <h3 class="mb-1">My Profile</h3>
    <p class="text-secondary small mb-4">
        Everything here is about your own account. Only you can change it.
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert alert-success py-2">Saved.</div>
    }

    @if (_profile is null)
    {
        <p class="text-secondary">Loading…</p>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">Name</h6>
                <p class="text-secondary small">
                    Shown wherever your account appears — case notes, messages, member lists.
                    Your sign-in address (@_profile.Email) isn't changed by this.
                </p>
                <div class="d-flex gap-2 align-items-start">
                    @* Plain input rather than TelerikTextBox: Telerik inputs bind on blur here,
                       which loses the last edit when the user clicks Save directly. *@
                    <input class="form-control" style="max-width:340px;" maxlength="100"
                           placeholder="Your name" value="@_displayName"
                           @oninput="@(e => _displayName = e.Value?.ToString() ?? string.Empty)" />
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Enabled="@(!_saving)"
                                   OnClick="SaveNameAsync">Save</TelerikButton>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">Public photo</h6>
                <p class="text-secondary small">
                    Anyone can see this one, including visitors to public case pages.
                </p>
                @PhotoSlot(_profile.PublicPhoto, isPublic: true)
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">Private photo<HelpLink Slug="your-profile" Anchor="who-sees-your-private-photo" /></h6>
                <p class="text-secondary small">
                    Shown only to people you actually work with — never on public pages.
                </p>
                @PhotoSlot(_profile.PrivatePhoto, isPublic: false)

                <hr />

                <div class="d-flex align-items-start gap-2">
                    <input type="checkbox" class="form-check-input mt-1" id="share-private"
                           checked="@_shareWithClients"
                           @onchange="@(e => ToggleShareAsync((bool)(e.Value ?? false)))" />
                    <label for="share-private" class="mb-0">
                        Show my private photo to clients of the groups I work with
                        <span class="d-block text-secondary small">
                            Clients see a face rather than a name alone. Your group has to allow
                            this too — both of you decide, not just one.
                        </span>
                    </label>
                </div>

                @* An opt-in that silently does nothing is worse than no opt-in: say so plainly
                   rather than letting the user believe they've shared something they haven't. *@
                @if (_shareWithClients && !_profile.AnyOrgAllowsPrivatePhotoSharing)
                {
                    <div class="alert alert-warning py-2 mt-2 mb-0 small">
                        You've turned this on, but none of your groups currently allow member
                        photos to be shown to clients — so nothing is being shared yet. It will
                        take effect if a group turns it on.
                    </div>
                }
            </div>
        </div>

        @* Contact details. Each card loads and saves on its own — one slow lookup or one failed
           save has no business blocking the rest of the page. *@
        <MyEmailsCard />
        <MyPhonesCard />
        <MyAddressesCard />
        <MyLinksCard />

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">Where you've been<HelpLink Slug="your-profile" Anchor="your-investigation-map" /></h6>
                <p class="text-secondary small">
                    A map of the investigations you have actually attended, kept on your
                    investigations page.
                </p>
                <a class="btn btn-outline-primary btn-sm" href="/my-investigations">My investigations</a>
            </div>
        </div>
    }
</div>

@code {
    private MyProfileRecord? _profile;
    private string _displayName = string.Empty;
    private bool   _shareWithClients;
    private bool   _saving;
    private bool   _saved;
    private string? _error;

    // Slot currently uploading, so only that card shows a spinner.
    private bool? _uploadingSlot;

    /// <summary>
    /// Rendered image sources, keyed by upload-file id.
    /// </summary>
    /// <remarks>
    /// These are data URIs fetched through the authenticated client rather than
    /// <c>GetFileDownloadUrl</c>. A browser loading &lt;img src="…/api/upload-files/{id}/download"&gt;
    /// sends no bearer token, so the download endpoint sees an anonymous caller: the *public*
    /// photo happens to load anyway, and the private one 401s and renders as a broken image. That
    /// asymmetry is worse than an outright failure — the page looks correct until someone sets a
    /// private photo. Fetching the bytes server-side sidesteps it and is cheap for two small
    /// avatars on one page. U3's avatar endpoint replaces this with something cacheable that other
    /// pages can use too.
    /// </remarks>
    private readonly Dictionary<Guid, string> _previews = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _profile is not null) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            _profile = await AdminClient.GetMyProfileAsync();
            if (_profile is not null)
            {
                _displayName      = _profile.DisplayName ?? string.Empty;
                _shareWithClients = _profile.SharePrivatePhotoWithClients;
                await LoadPreviewsAsync();
            }
        }
        catch { _error = "Couldn't load your profile. Please refresh."; }
    }

    private async Task LoadPreviewsAsync()
    {
        foreach (var photo in new[] { _profile?.PublicPhoto, _profile?.PrivatePhoto })
        {
            if (photo is null || _previews.ContainsKey(photo.UploadFileId)) continue;
            try
            {
                var file = await AdminClient.GetFileDataAsync(photo.UploadFileId);
                if (file is { } f)
                    _previews[photo.UploadFileId] =
                        $"data:{f.ContentType};base64,{Convert.ToBase64String(f.Data)}";
            }
            catch { /* a photo that won't load isn't worth failing the whole page over */ }
        }
    }

    private async Task SaveNameAsync()
    {
        _saving = true; _error = null; _saved = false;
        try
        {
            // Only the name is sent. The consent field stays null so saving a name can never
            // change what you've agreed to share.
            var updated = await AdminClient.UpdateMyProfileAsync(new UpdateMyProfileRequest(_displayName));
            if (updated is null) { _error = "Couldn't save your name."; return; }
            _profile = updated;
            _saved = true;
        }
        catch { _error = "Couldn't save your name."; }
        finally { _saving = false; }
    }

    private async Task ToggleShareAsync(bool value)
    {
        _shareWithClients = value;          // optimistic, so the checkbox doesn't lag the click
        _error = null; _saved = false;
        try
        {
            var updated = await AdminClient.UpdateMyProfileAsync(
                new UpdateMyProfileRequest(null, SharePrivatePhotoWithClients: value));
            if (updated is null)
            {
                _shareWithClients = !value;
                _error = "Couldn't save that setting.";
                return;
            }
            _profile = updated;
            _shareWithClients = updated.SharePrivatePhotoWithClients;
        }
        catch
        {
            // Consent must never appear granted when the server didn't record it.
            _shareWithClients = !value;
            _error = "Couldn't save that setting.";
        }
    }

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e, bool isPublic)
    {
        _uploadingSlot = isPublic; _error = null; _saved = false;
        try
        {
            var file = e.File;
            var typeId = await AdminClient.GetProfilePhotoFileTypeIdAsync();
            if (typeId is null) { _error = "Photo uploads aren't configured."; return; }

            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxPhotoBytes).CopyToAsync(ms);

            var uploaded = await AdminClient.UploadUserFileAsync(
                typeId.Value, UserState.UserId ?? Guid.Empty,
                file.Name, file.ContentType, ms.ToArray(),
                description: null, isPublic: isPublic);
            if (uploaded is null)
            {
                _error = "Upload failed — photos must be JPEG, PNG, GIF or WebP.";
                return;
            }

            // Attaching to the slot is what makes it the active photo; the upload alone doesn't.
            var photo = await AdminClient.SetMyPhotoAsync(
                new SetMyPhotoRequest(uploaded.Id, isPublic, AltText: _displayName));
            if (photo is null) { _error = "Couldn't set that photo."; return; }

            _profile = await AdminClient.GetMyProfileAsync();
            await LoadPreviewsAsync();
            _saved = true;
        }
        catch (IOException)
        {
            _error = $"That image is too large — the limit is {MaxPhotoBytes / (1024 * 1024)} MB.";
        }
        catch { _error = "Upload failed. Please try again."; }
        finally { _uploadingSlot = null; }
    }

    private async Task RemovePhotoAsync(Guid photoId)
    {
        _error = null; _saved = false;
        try
        {
            if (!await AdminClient.DeleteMyPhotoAsync(photoId))
            {
                _error = "Couldn't remove that photo.";
                return;
            }
            _profile = await AdminClient.GetMyProfileAsync();
            await LoadPreviewsAsync();
        }
        catch { _error = "Couldn't remove that photo."; }
    }

    /// <summary>
    /// Deliberately generous — this is a profile picture, not evidence, and the site has no
    /// upload caps by design. It exists only so a mis-selected video gives a clear message
    /// instead of a stalled request.
    /// </summary>
    private const long MaxPhotoBytes = 25L * 1024 * 1024;

    private RenderFragment PhotoSlot(AppUserPhotoRecord? photo, bool isPublic) => __builder =>
    {
        <div class="d-flex align-items-center gap-3 flex-wrap">
            @if (photo is not null && _previews.TryGetValue(photo.UploadFileId, out var src))
            {
                <img src="@src"
                     alt="@(photo.AltText ?? "Profile photo")"
                     class="rounded-circle border"
                     style="width:88px;height:88px;object-fit:cover;" />
            }
            else if (photo is not null)
            {
                <div class="rounded-circle border d-flex align-items-center justify-content-center text-secondary"
                     style="width:88px;height:88px;">
                    <span class="small">…</span>
                </div>
            }
            else
            {
                <div class="rounded-circle border d-flex align-items-center justify-content-center text-secondary"
                     style="width:88px;height:88px;">
                    <span class="small">None</span>
                </div>
            }

            <div class="d-flex flex-column gap-2">
                <InputFile OnChange="@(e => OnPhotoSelectedAsync(e, isPublic))"
                           class="form-control form-control-sm" style="max-width:280px;"
                           accept="image/jpeg,image/png,image/gif,image/webp" />
                @if (_uploadingSlot == isPublic)
                {
                    <span class="text-secondary small">Uploading…</span>
                }
                else if (photo is not null)
                {
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Outline"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                   OnClick="@(() => RemovePhotoAsync(photo.Id))">Remove</TelerikButton>
                }
            </div>
        </div>
    };
}
