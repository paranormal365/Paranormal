@namespace Ben.Web.Library.User
@inject IBenAdminClient AdminClient

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h6 class="card-title">Phone numbers<HelpLink Slug="your-profile" Anchor="what-public-means" /></h6>
                <p class="text-secondary small mb-0">Private unless you mark one public.</p>
            </div>
            @if (!_showForm)
            {
                <TelerikButton Icon="@SvgIcon.Plus" OnClick="BeginCreate"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary">Add</TelerikButton>
            }
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mt-3 mb-0">@_error</div>
        }

        @if (_loading)
        {
            <div class="text-secondary small mt-3">Loading…</div>
        }
        else
        {
            @if (_rows.Count == 0 && !_showForm)
            {
                <p class="text-secondary small fst-italic mt-3 mb-0">No phone numbers yet.</p>
            }

            @foreach (var row in _rows)
            {
                <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <span class="fw-semibold">@row.PhoneNumber</span>
                        @if (!string.IsNullOrWhiteSpace(row.PhoneCountry))
                        {
                            <span class="text-secondary small ms-1">(@row.PhoneCountry)</span>
                        }
                        <span class="badge bg-secondary ms-2">@TypeName(row.UserPhoneTypeId)</span>
                        @if (row.IsPrimary)
                        {
                            <span class="badge bg-primary ms-1">Primary</span>
                        }
                        @if (row.IsCellular)
                        {
                            <span class="badge bg-light text-dark border ms-1">Mobile</span>
                        }
                        @if (row.IsPublic)
                        {
                            <span class="badge bg-info text-dark ms-1">Public</span>
                        }
                    </div>
                    <div class="d-flex gap-1">
                        <TelerikButton Icon="@SvgIcon.Pencil" Size="@ThemeConstants.Button.Size.Small"
                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                       Title="Edit" OnClick="@(() => BeginEdit(row))" />
                        <TelerikButton Icon="@SvgIcon.Trash" Size="@ThemeConstants.Button.Size.Small"
                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                       Title="Delete" OnClick="@(() => _deleteTarget = row)" />
                    </div>
                </div>
            }

            @if (_showForm)
            {
                <div class="border-top pt-3 mt-3">
                    <div class="row g-2">
                        <div class="col-sm-5">
                            <label class="form-label small mb-1">Number</label>
                            <input class="form-control" maxlength="50" placeholder="(555) 555-0123"
                                   value="@_formNumber"
                                   @oninput="@(e => _formNumber = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label small mb-1">Country</label>
                            <input class="form-control" maxlength="10" placeholder="US"
                                   value="@_formCountry"
                                   @oninput="@(e => _formCountry = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small mb-1">Type</label>
                            <select class="form-select" value="@_formTypeId"
                                    @onchange="@(e => _formTypeId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty)">
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id" selected="@(t.Id == _formTypeId)">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="phone-primary"
                                       checked="@_formIsPrimary"
                                       @onchange="@(e => _formIsPrimary = (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="phone-primary">Primary number</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="phone-cell"
                                       checked="@_formIsCellular"
                                       @onchange="@(e => _formIsCellular = (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="phone-cell">Mobile — can receive texts</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="phone-public"
                                       checked="@_formIsPublic"
                                       @onchange="@(e => _formIsPublic = (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="phone-public">Public</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Enabled="@(!_saving)" OnClick="SaveAsync">
                            @(_saving ? "Saving…" : "Save")
                        </TelerikButton>
                        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                                       OnClick="@(() => { _showForm = false; _error = null; })">Cancel</TelerikButton>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (_deleteTarget is not null)
{
    <TelerikWindow Visible="true" Modal="true" Width="380px">
        <WindowTitle>Delete phone number</WindowTitle>
        <WindowContent>
            <p>Remove <strong>@_deleteTarget.PhoneNumber</strong> from your profile?</p>
            <div class="dialog-footer-actions d-flex justify-content-end gap-2">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                               OnClick="@(() => _deleteTarget = null)">Cancel</TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                               OnClick="DeleteConfirmedAsync">Delete</TelerikButton>
            </div>
        </WindowContent>
    </TelerikWindow>
}

@code {
    private List<MyPhoneRecord> _rows = new();
    private IReadOnlyList<UserPhoneTypeRecord> _types = Array.Empty<UserPhoneTypeRecord>();
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool  _showForm;
    private Guid? _editId;
    private string _formNumber  = string.Empty;
    private string _formCountry = string.Empty;
    private Guid  _formTypeId;
    private bool  _formIsPrimary;
    private bool  _formIsCellular;
    private bool  _formIsPublic;

    private MyPhoneRecord? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        _types = await AdminClient.GetUserPhoneTypesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows = await AdminClient.GetMyPhonesAsync();
        _loading = false;
    }

    private string TypeName(Guid id) => _types.FirstOrDefault(t => t.Id == id)?.Name ?? "Other";

    private void BeginCreate()
    {
        if (_types.Count == 0)
        {
            _error = "No phone types have been set up yet. Ask an administrator to add some before adding a number.";
            return;
        }

        _editId = null;
        _formNumber = string.Empty;
        _formCountry = "US";
        _formTypeId = _types.FirstOrDefault()?.Id ?? Guid.Empty;
        _formIsPrimary = _rows.Count == 0;
        _formIsCellular = true;
        _formIsPublic = false;
        _error = null;
        _showForm = true;
    }

    private void BeginEdit(MyPhoneRecord row)
    {
        _editId = row.Id;
        _formNumber = row.PhoneNumber;
        _formCountry = row.PhoneCountry ?? string.Empty;
        _formTypeId = row.UserPhoneTypeId;
        _formIsPrimary = row.IsPrimary;
        _formIsCellular = row.IsCellular;
        _formIsPublic = row.IsPublic;
        _error = null;
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formNumber))
        {
            _error = "Enter a phone number.";
            return;
        }

        _saving = true;
        _error = null;

        var request = new UpsertMyPhoneRequest(
            _formTypeId, _formNumber.Trim(),
            string.IsNullOrWhiteSpace(_formCountry) ? null : _formCountry.Trim(),
            _formIsPrimary, _formIsCellular, _formIsPublic);

        var result = _editId is null
            ? await AdminClient.CreateMyPhoneAsync(request)
            : await AdminClient.UpdateMyPhoneAsync(_editId.Value, request);

        _saving = false;

        if (result is null)
        {
            _error = "That could not be saved.";
            return;
        }

        _showForm = false;
        await LoadAsync();
    }

    private async Task DeleteConfirmedAsync()
    {
        var target = _deleteTarget;
        _deleteTarget = null;
        if (target is null) return;

        if (!await AdminClient.DeleteMyPhoneAsync(target.Id))
        {
            _error = "That could not be deleted.";
            return;
        }

        await LoadAsync();
    }
}
