@namespace Ben.Web.Library.Equipment
@inject IBenAdminClient AdminClient

@* What past borrowers said about whoever lends this piece, shown at the point of deciding whether
   to ask. Unattributed, unlike the lender-facing direction — a borrower saying a lender was
   unreasonable has more to lose by being named.

   The lender never sees this: the endpoint refuses them, so the panel is simply absent. *@

@if (_panel is not null && (_panel.Comments.Count > 0 || _panel.Summary.RatingCount > 0))
{
    <details class="mb-3">
        <summary class="small fw-semibold" style="cursor:pointer;">
            What borrowers say about lending here
            @if (_panel.Summary.AverageRating is double average)
            {
                <span class="badge bg-secondary ms-2">
                    @average.ToString("0.0") across @_panel.Summary.RatingCount ratings
                </span>
            }
            else if (_panel.Summary.RatingCount > 0)
            {
                <span class="badge bg-light text-secondary border ms-2">
                    @_panel.Summary.RatingCount @(_panel.Summary.RatingCount == 1 ? "rating" : "ratings") — too few to average
                </span>
            }
        </summary>

        <div class="mt-2">
            @foreach (var entry in _panel.Comments)
            {
                <div class="border-bottom py-2 small">
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary">@entry.DateCreated.ToLocalTime().ToString("d MMM yyyy")</span>
                        @if (entry.Rating is int rating)
                        {
                            <span class="badge bg-secondary">@rating/5</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(entry.Comment))
                    {
                        <div style="white-space:pre-line;">@entry.Comment</div>
                    }
                </div>
            }

            <div class="text-secondary mt-2" style="font-size:.75rem;">
                Left by past borrowers, without their names.
            </div>
        </div>
    </details>
}

@code {
    [Parameter, EditorRequired] public Guid ItemId { get; set; }

    private LenderFeedbackPanelRecord? _panel;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (ItemId == Guid.Empty || _loadedFor == ItemId) return;
        _loadedFor = ItemId;
        _panel = await AdminClient.GetLenderFeedbackAsync(ItemId);
    }
}
