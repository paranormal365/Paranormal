@namespace Ben.Web.Library.Equipment
@inject IBenAdminClient AdminClient

@* One small, single-purpose interaction, so it stays a window rather than becoming a page.
   TelerikWindow, never TelerikDialog — inputs inside a TelerikDialog never reach Blazor. *@

<TelerikWindow Visible="@Visible" VisibleChanged="@OnVisibleChanged" Modal="true" Width="520px">
    <WindowTitle>Ask about @(ItemDisplayName ?? "this equipment")</WindowTitle>
    <WindowContent>
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @if (_sent)
        {
            <p class="mb-0">
                Sent. You'll get a notice when it's answered — and the answer will arrive without
                telling you who wrote it, just as your question arrived without your name.
            </p>
        }
        else
        {
            @* Stated plainly at the point of asking. The promise is worth nothing if the person
               making the decision to ask does not know about it. *@
            <div class="alert alert-info py-2 small">
                <strong>This is anonymous, both ways.</strong> Whoever looks after this piece will see
                your question but not your name, and you will see their answer but not theirs.
                Borrowing itself is not anonymous — if you go on to ask for it, you will each know
                who the other is.
            </div>

            <label class="form-label fw-semibold">Your question</label>
            <textarea class="form-control" rows="4" maxlength="2000" value="@_text"
                      placeholder="e.g. Does it take AA batteries, or is it rechargeable only?"
                      @oninput="@(e => _text = e.Value?.ToString() ?? string.Empty)"></textarea>
        }

        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <TelerikButton OnClick="@(() => OnVisibleChanged(false))" Enabled="@(!_busy)">
                @(_sent ? "Close" : "Cancel")
            </TelerikButton>
            @if (!_sent)
            {
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Enabled="@(!_busy && !string.IsNullOrWhiteSpace(_text))"
                               OnClick="SendAsync">Send</TelerikButton>
            }
        </div>
    </WindowContent>
</TelerikWindow>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter, EditorRequired] public Guid ItemId { get; set; }
    [Parameter] public string? ItemDisplayName { get; set; }

    private string _text = string.Empty;
    private bool _busy, _sent;
    private string? _error;

    private async Task SendAsync()
    {
        _busy = true; _error = null;
        var asked = await AdminClient.AskEquipmentQuestionAsync(ItemId, _text.Trim());
        if (asked is null) _error = "That couldn't be sent. You may not be able to ask about this piece.";
        else _sent = true;
        _busy = false;
    }

    private async Task OnVisibleChanged(bool visible)
    {
        Visible = visible;
        if (!visible) { _text = string.Empty; _sent = false; _error = null; }
        await VisibleChanged.InvokeAsync(visible);
    }
}
