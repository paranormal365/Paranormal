@namespace Ben.Web.Library.Equipment
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient

@* Which groups can see one piece of gear. TelerikWindow with an in-content footer, never
   TelerikDialog and never WindowActions — see MyEquipmentItemEditor for both reasons. *@

<TelerikWindow Visible="@Visible" VisibleChanged="@OnVisibleChanged" Modal="true" Width="480px">
    <WindowTitle>Share @(Item?.DisplayName ?? "equipment")</WindowTitle>
    <WindowContent>
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <p class="text-secondary small">
            Groups you tick can see you own this piece — its make, model and photos. They never see
            its serial number. Whether it can actually be borrowed is a separate setting on the
            item itself.
        </p>

        @if (_loading)
        {
            <p class="text-secondary">Loading your groups…</p>
        }
        else if (_options.Count == 0)
        {
            <div class="alert alert-info py-2 mb-0">
                You aren't a member of any group yet, so there's nobody to share with.
            </div>
        }
        else
        {
            @foreach (var option in _options)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <input type="checkbox" class="form-check-input mt-0"
                           id="@($"share-{option.OrganizationId}")"
                           checked="@_selected.Contains(option.OrganizationId)"
                           @onchange="@(e => Toggle(option.OrganizationId, (bool)(e.Value ?? false)))" />
                    <label class="mb-0" for="@($"share-{option.OrganizationId}")">@option.OrganizationName</label>
                </div>
            }
        }

        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <TelerikButton OnClick="@(() => OnVisibleChanged(false))" Enabled="@(!_busy)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Enabled="@(!_busy && !_loading)"
                           OnClick="SaveAsync">Save</TelerikButton>
        </div>
    </WindowContent>
</TelerikWindow>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EquipmentItemRecord? Item { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private List<EquipmentShareOptionRecord> _options = [];
    private HashSet<Guid> _selected = [];
    private bool _loading;
    private bool _busy;
    private string? _error;
    private Guid? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible || Item is null) { _loadedFor = null; return; }
        if (_loadedFor == Item.Id) return;
        _loadedFor = Item.Id;

        _loading = true;
        _error = null;
        _options = [.. await AdminClient.GetMyEquipmentSharesAsync(Item.Id)];
        _selected = _options.Where(o => o.IsShared).Select(o => o.OrganizationId).ToHashSet();
        _loading = false;
    }

    private void Toggle(Guid orgId, bool on)
    {
        if (on) _selected.Add(orgId);
        else _selected.Remove(orgId);
    }

    private async Task SaveAsync()
    {
        if (Item is null) return;
        _busy = true;
        _error = null;

        // The server re-validates membership regardless; this call just carries the choice.
        await AdminClient.SetMyEquipmentSharesAsync(Item.Id, [.. _selected]);

        _busy = false;
        await OnSaved.InvokeAsync();
        await OnVisibleChanged(false);
    }

    private async Task OnVisibleChanged(bool visible)
    {
        Visible = visible;
        if (!visible) _loadedFor = null;
        await VisibleChanged.InvokeAsync(visible);
    }
}
