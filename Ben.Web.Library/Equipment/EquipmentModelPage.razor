@page "/equipment-models/{ModelId:guid}"
@namespace Ben.Web.Library.Equipment
@inject IBenAdminClient AdminClient

<PageTitle>@(_page is null ? "Equipment" : $"{_page.Model.BrandName} {_page.Model.Name}")</PageTitle>

@* One product, with what every owner has contributed pooled together. Public — the photos arrive
   anonymously, and a photo only becomes a link when the server says this viewer may open that
   particular item. *@

<div class="container-fluid py-3" style="max-width:900px;">
    <div class="mb-3">
        <a href="/equipment-catalog" class="text-decoration-none small">&larr; Back to the catalog</a>
    </div>

    @if (_loading)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    }
    else if (_page is null)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h6 class="mb-2">That make and model could not be found</h6>
                <p class="text-secondary small mb-0">It may not have been approved for the catalog yet.</p>
            </div>
        </div>
    }
    else
    {
        <h3 class="mb-1">@_page.Model.BrandName @_page.Model.Name<HelpLink Slug="your-equipment" Anchor="the-public-catalog" /></h3>
        <p class="text-secondary small mb-4">
            @_page.Model.CategoryName
            @if (!string.IsNullOrWhiteSpace(_page.Model.ModelNumber))
            {
                <span> · model @_page.Model.ModelNumber</span>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(_page.Model.Description))
        {
            <p>@_page.Model.Description</p>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card h-100"><div class="card-body py-3 text-center">
                    <div class="h4 mb-0">@_page.ItemCount</div>
                    <div class="text-secondary small">@(_page.ItemCount == 1 ? "one is owned" : "owned by members")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100"><div class="card-body py-3 text-center">
                    <div class="h4 mb-0">@_page.AvailableToBorrowCount</div>
                    <div class="text-secondary small">offered for borrowing</div>
                </div></div>
            </div>
        </div>

        @* ── What owners have read about it ─────────────────────────────────── *@
        @if (_page.WebsiteLinks.Count > 0)
        {
            <h5 class="mb-2">Links owners have added</h5>
            <ul class="mb-4">
                @foreach (var link in _page.WebsiteLinks)
                {
                    <li><a href="@link" target="_blank" rel="noopener noreferrer">@link</a></li>
                }
            </ul>
        }

        @* ── The pooled photos ──────────────────────────────────────────────── *@
        <h5 class="mb-2">Photos</h5>
        @if (_page.Photos.Count == 0)
        {
            <p class="text-secondary small">Nobody has added a photo of one yet.</p>
        }
        else
        {
            <p class="text-secondary small">
                From members who own one. Photos are shown without saying whose they are.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var photo in _page.Photos)
                {
                    @* A link only where the server said this viewer may open that item. *@
                    @if (photo.LinkedItemId is Guid itemId)
                    {
                        <a href="@($"/equipment/{itemId}")" title="@(photo.Caption ?? "View this one")">
                            @RenderPhoto(photo)
                        </a>
                    }
                    else
                    {
                        @RenderPhoto(photo)
                    }
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid ModelId { get; set; }

    private EquipmentModelPageRecord? _page;
    private readonly Dictionary<Guid, string?> _thumbnails = [];
    private bool _loading = true;
    private Guid _loadedFor;

    private RenderFragment RenderPhoto(CatalogPhotoRecord photo) => @<text>
        @if (_thumbnails.TryGetValue(photo.PhotoId, out var url) && url is not null)
        {
            <img src="@url" alt="@(photo.Caption ?? "Equipment photo")"
                 style="width:150px;height:104px;object-fit:cover;border-radius:4px;" />
        }
        else
        {
            <div class="bg-body-secondary d-flex align-items-center justify-content-center"
                 style="width:150px;height:104px;border-radius:4px;">
                <span class="text-secondary small">…</span>
            </div>
        }
    </text>;

    protected override async Task OnParametersSetAsync()
    {
        if (ModelId == Guid.Empty || _loadedFor == ModelId) return;
        _loadedFor = ModelId;

        _loading = true;
        _page = await AdminClient.GetEquipmentModelPageAsync(ModelId);
        _loading = false;
        StateHasChanged();

        if (_page is null) return;

        // Thumbnails, not full-resolution files — these are drawn 150px wide.
        foreach (var photo in _page.Photos)
        {
            try
            {
                var bytes = await AdminClient.GetEquipmentPhotoThumbnailAsync(photo.PhotoId);
                _thumbnails[photo.PhotoId] = bytes is null
                    ? null
                    : $"data:{bytes.Value.ContentType};base64,{Convert.ToBase64String(bytes.Value.Data)}";
            }
            catch
            {
                _thumbnails[photo.PhotoId] = null;   // a photo that won't load is simply not shown
            }
            StateHasChanged();
        }
    }
}
