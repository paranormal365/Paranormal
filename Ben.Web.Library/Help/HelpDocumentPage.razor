@page "/help/{Slug}"
@using Ben.Web.Services.Help
@inject HelpContentService Content
@inject HelpViewerResolver Viewers

<PageTitle>@(_document?.Title ?? "Help")</PageTitle>

<div class="container-fluid py-3 help-page">
    @if (_loading)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    }
    else if (_document is null)
    {
        @* Missing and forbidden look identical here by design — see HelpContentService.Find. *@
        <div class="card">
            <div class="card-body text-center py-5">
                <h5 class="mb-2">That help topic isn't available</h5>
                <p class="text-secondary mb-3">
                    It may have moved, or it may not apply to your account.
                </p>
                <a class="btn btn-primary" href="/help">Back to help</a>
            </div>
        </div>
    }
    else
    {
        <nav class="mb-3 small">
            <a href="/help">Help</a>
            <span class="text-secondary mx-1">/</span>
            <span class="text-secondary">@_document.Section</span>
        </nav>

        <div class="row g-3">
            @if (_headings.Count > 1)
            {
                <div class="col-lg-3 order-lg-2">
                    <div class="card help-contents">
                        <div class="card-header fw-semibold">On this page</div>
                        <div class="list-group list-group-flush">
                            @foreach (var (text, anchor) in _headings)
                            {
                                <a class="list-group-item list-group-item-action small"
                                   href="@($"/help/{_document.Slug}#{anchor}")">@text</a>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="@(_headings.Count > 1 ? "col-lg-9 order-lg-1" : "col-12")">
                <div class="card">
                    <div class="card-body">
                        <h3 class="mb-1">@_document.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(_document.Summary))
                        {
                            <p class="text-secondary">@_document.Summary</p>
                        }
                        <hr />
                        @* Repo-authored markdown, rendered with raw HTML disabled in the pipeline. *@
                        <div class="help-body">@((MarkupString)_html)</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private HelpDocument? _document;
    private string _html = string.Empty;
    private IReadOnlyList<(string Text, string Anchor)> _headings = [];
    private bool _loading = true;

    // Runs on parameter change too: navigating between documents keeps the same component
    // instance, so loading only in OnInitializedAsync would leave the first document on screen.
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;

        // Same reason as the index: AuthReady never completes during the static prerender.
        if (!RendererInfo.IsInteractive) return;

        var viewer = await Viewers.ResolveAsync();

        _document = Content.Find(Slug, viewer);
        _html = _document is null ? string.Empty : Content.ToHtml(_document);
        _headings = _document is null ? [] : HelpContentService.HeadingsOf(_document);
        _loading = false;
    }
}
