@*
  OrganizationFiles.razor
  ────────────────────────
  Manages files owned by an organization.
  Members with OrganizationFiles-Create permission can upload new files or copy
  from user public/shared files. Edit and Delete require Update/Delete permission.
  Route: /organizations/{OrgId:guid}/files
*@

@page "/organizations/{OrgId:guid}/files"
@namespace Ben.Web.Library.Organization
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

<div class="container-fluid py-3">
    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <span class="spinner-border text-primary" role="status"></span>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <h4 class="mb-0">Files — @_orgName</h4>
            <div class="d-flex gap-2">
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Size="@ThemeConstants.Button.Size.Small"
                               OnClick="@(() => _showUploadDialog = true)">
                    ⬆ Upload File
                </TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                               FillMode="@ThemeConstants.Button.FillMode.Outline"
                               Size="@ThemeConstants.Button.Size.Small"
                               OnClick="@(() => _showCopyDialog = true)">
                    📋 Copy from User File
                </TelerikButton>
                <a href="/organizations" class="btn btn-sm btn-outline-secondary">← Organizations</a>
            </div>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <TelerikGrid Data="@_files" Pageable="true" PageSize="20" Sortable="true">
            <GridColumns>
                <GridColumn Field="@nameof(OrganizationFileRecord.FileName)" Title="File Name" />
                <GridColumn Field="@nameof(OrganizationFileRecord.FileTypeName)" Title="Type" Width="120px" />
                <GridColumn Field="@nameof(OrganizationFileRecord.ContentType)" Title="MIME" Width="140px" />
                <GridColumn Field="@nameof(OrganizationFileRecord.FileSize)" Title="Size" Width="90px">
                    <Template>
                        @{ var f = (OrganizationFileRecord)context; }
                        @FormatSize(f.FileSize)
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(OrganizationFileRecord.IsPublic)" Title="Public" Width="75px" />
                <GridColumn Title="Source" Width="80px">
                    <Template>
                        @{ var fv = (OrganizationFileRecord)context; }
                        @(fv.SourceUploadFileId.HasValue ? "Copy" : "Upload")
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(OrganizationFileRecord.Description)" Title="Description" />
                <GridColumn Field="@nameof(OrganizationFileRecord.DateCreated)" Title="Added" DisplayFormat="{0:d}" Width="100px" />
                <GridCommandColumn Width="160px">
                    <GridCommandButton OnClick="@(e => OpenEdit((OrganizationFileRecord)e.Item))"
                                      Size="@ThemeConstants.Button.Size.Small">Edit</GridCommandButton>
                    <GridCommandButton OnClick="@(e => ConfirmDelete((OrganizationFileRecord)e.Item))"
                                      ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                      Size="@ThemeConstants.Button.Size.Small" Class="ms-1">Delete</GridCommandButton>
                </GridCommandColumn>
            </GridColumns>
        </TelerikGrid>
    }
</div>

@* ── Upload dialog ─────────────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showUploadDialog" Title="Upload Organization File" Width="520px">
    <DialogContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">File <span class="text-danger">*</span></label>
                <InputFile OnChange="OnFileSelected" class="form-control" accept="*/*" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">File Type <span class="text-danger">*</span></label>
                <TelerikDropDownList Data="@_fileTypes"
                                     @bind-Value="@_uploadTypeId"
                                     TextField="@nameof(UploadFileTypeRecord.Name)"
                                     ValueField="@nameof(UploadFileTypeRecord.Id)"
                                     DefaultText="— select —" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Description</label>
                <TelerikTextBox @bind-Value="@_uploadDescription" Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="@_uploadIsPublic" Id="orgfile-pub" />
                <label for="orgfile-pub" class="form-label mb-0">Public</label>
            </div>
        </div>
        @if (_uploadError is not null) { <div class="alert alert-danger mt-3 mb-0 py-2 small">@_uploadError</div> }
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => { _showUploadDialog = false; _uploadError = null; })">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Enabled="@(!_uploading && _selectedFile is not null && _uploadTypeId != Guid.Empty)"
                       OnClick="UploadAsync">
            @(_uploading ? "Uploading…" : "Upload")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Copy from user file dialog ───────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showCopyDialog" Title="Copy from User File" Width="480px">
    <DialogContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">User File ID (Guid)</label>
                <TelerikTextBox @bind-Value="@_copySourceId" PlaceHolder="Paste the UploadFile ID..." Width="100%" />
                <small class="text-secondary">The file must be public or shared with this organization.</small>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Description <span class="text-secondary small">(leave blank to keep original)</span></label>
                <TelerikTextBox @bind-Value="@_copyDescription" Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="@_copyIsPublic" Id="orgcopy-pub" />
                <label for="orgcopy-pub" class="form-label mb-0">Mark copy as Public</label>
            </div>
        </div>
        @if (_copyError is not null) { <div class="alert alert-danger mt-3 mb-0 py-2 small">@_copyError</div> }
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => { _showCopyDialog = false; _copyError = null; })">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Enabled="@(!_copying)"
                       OnClick="CopyAsync">
            @(_copying ? "Copying…" : "Copy to Org")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Edit dialog ──────────────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showEditDialog" Title="Edit File" Width="420px">
    <DialogContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Description</label>
                <TelerikTextBox @bind-Value="@_editDescription" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Sort Order</label>
                <TelerikNumericTextBox @bind-Value="@_editSortOrder" Min="0" Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="@_editIsPublic" Id="orgfile-edit-pub" />
                <label for="orgfile-edit-pub" class="form-label mb-0">Public</label>
            </div>
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showEditDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" OnClick="SaveEditAsync">Save</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Delete confirm dialog ─────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showDeleteDialog" Title="Delete File" Width="380px">
    <DialogContent>
        <p>Delete <strong>@_pendingDelete?.FileName</strong>? This cannot be undone.</p>
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showDeleteDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error" OnClick="DeleteAsync">Delete</TelerikButton>
    </DialogButtons>
</TelerikDialog>

<TelerikNotification @ref="_toast" HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top" />

@code {
    [Parameter] public Guid OrgId { get; set; }

    private bool _loading = true;
    private string? _error;
    private string _orgName = string.Empty;
    private List<OrganizationFileRecord> _files = [];
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];

    // Upload state
    private bool _showUploadDialog;
    private IBrowserFile? _selectedFile;
    private Guid _uploadTypeId;
    private string _uploadDescription = string.Empty;
    private bool _uploadIsPublic;
    private bool _uploading;
    private string? _uploadError;

    // Copy state
    private bool _showCopyDialog;
    private string _copySourceId = string.Empty;
    private string _copyDescription = string.Empty;
    private bool _copyIsPublic;
    private bool _copying;
    private string? _copyError;

    // Edit state
    private bool _showEditDialog;
    private OrganizationFileRecord? _editingFile;
    private string _editDescription = string.Empty;
    private bool _editIsPublic;
    private int _editSortOrder;

    // Delete state
    private bool _showDeleteDialog;
    private OrganizationFileRecord? _pendingDelete;

    private TelerikNotification? _toast;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _files     = (await AdminClient.GetOrgFilesAsync(OrgId)).ToList();
            _fileTypes = await AdminClient.GetPublicFileTypesAsync();
            var orgs   = await AdminClient.GetOrganizationsAsync();
            _orgName   = orgs.FirstOrDefault(o => o.Id == OrgId)?.Name ?? OrgId.ToString();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFile = e.File;

    private async Task UploadAsync()
    {
        if (_selectedFile is null || _uploadTypeId == Guid.Empty) return;
        _uploading   = true;
        _uploadError = null;
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = _selectedFile.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024);
            content.Add(new StreamContent(stream), "File", _selectedFile.Name);
            content.Add(new StringContent(_uploadTypeId.ToString()), "UploadFileTypeId");
            content.Add(new StringContent(_uploadDescription ?? string.Empty), "Description");
            content.Add(new StringContent(_uploadIsPublic.ToString()), "IsPublic");
            content.Add(new StringContent("0"), "SortOrder");

            var result = await AdminClient.UploadOrgFileAsync(OrgId, content);
            if (result is not null)
            {
                _showUploadDialog = false;
                _selectedFile     = null;
                _uploadDescription = string.Empty;
                _files = (await AdminClient.GetOrgFilesAsync(OrgId)).ToList();
                _toast?.Show(new NotificationModel { Text = "File uploaded.", ThemeColor = ThemeConstants.Notification.ThemeColor.Success, CloseAfter = 3000 });
            }
            else { _uploadError = "Upload failed. Check the file type and try again."; }
        }
        catch (Exception ex) { _uploadError = ex.Message; }
        finally { _uploading = false; }
    }

    private async Task CopyAsync()
    {
        if (!Guid.TryParse(_copySourceId.Trim(), out var sourceId))
        {
            _copyError = "Enter a valid GUID.";
            return;
        }
        _copying   = true;
        _copyError = null;
        try
        {
            var result = await AdminClient.CopyFileFromUserAsync(OrgId, sourceId, _copyDescription, _copyIsPublic);
            if (result is not null)
            {
                _showCopyDialog   = false;
                _copySourceId     = string.Empty;
                _copyDescription  = string.Empty;
                _files = (await AdminClient.GetOrgFilesAsync(OrgId)).ToList();
                _toast?.Show(new NotificationModel { Text = "File copied.", ThemeColor = ThemeConstants.Notification.ThemeColor.Success, CloseAfter = 3000 });
            }
            else { _copyError = "Copy failed — ensure the file is public or shared with this organization."; }
        }
        catch (Exception ex) { _copyError = ex.Message; }
        finally { _copying = false; }
    }

    private void OpenEdit(OrganizationFileRecord f)
    {
        _editingFile      = f;
        _editDescription  = f.Description ?? string.Empty;
        _editIsPublic     = f.IsPublic;
        _editSortOrder    = f.SortOrder;
        _showEditDialog   = true;
    }

    private async Task SaveEditAsync()
    {
        if (_editingFile is null) return;
        var result = await AdminClient.UpdateOrgFileAsync(OrgId, _editingFile.Id, _editDescription, _editIsPublic, _editSortOrder);
        _showEditDialog = false;
        if (result is not null)
        {
            _files = (await AdminClient.GetOrgFilesAsync(OrgId)).ToList();
            _toast?.Show(new NotificationModel { Text = "Saved.", ThemeColor = ThemeConstants.Notification.ThemeColor.Success, CloseAfter = 3000 });
        }
    }

    private void ConfirmDelete(OrganizationFileRecord f) { _pendingDelete = f; _showDeleteDialog = true; }

    private async Task DeleteAsync()
    {
        if (_pendingDelete is null) return;
        var ok = await AdminClient.DeleteOrgFileAsync(OrgId, _pendingDelete.Id);
        _showDeleteDialog = false;
        if (ok)
        {
            _files = (await AdminClient.GetOrgFilesAsync(OrgId)).ToList();
            _toast?.Show(new NotificationModel { Text = "Deleted.", ThemeColor = ThemeConstants.Notification.ThemeColor.Error, CloseAfter = 3000 });
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F2} MB";
    }
}
