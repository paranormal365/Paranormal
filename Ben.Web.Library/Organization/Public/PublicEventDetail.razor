@page "/o/{UrlName}/events/{EventSlug}"
@namespace Ben.Web.Library.Organization.Public
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>@(_event?.Title ?? "Event") — @(_event?.OrganizationName ?? UrlName)</PageTitle>

@* The whole point of a public event is that somebody shares the link. This is what that link looks
   like in a group chat — and it carries the site's name alongside the group's. *@
@if (_event is not null)
{
    <Ben.Web.Library.Shared.SocialCard Title="@($"{_event.Title} — {_event.OrganizationName}")"
                                       Description="@SocialSummary"
                                       RelativeUrl="@($"/o/{UrlName}/events/{EventSlug}")"
                                       Type="article" />
}

@* One public event, for somebody who may never have heard of this group. The organization is named
   prominently on purpose: an introduction is what the listing is for. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    </div>
}
else if (_event is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Event not found</h2>
        <p class="text-secondary">
            This event has finished, or it is not open to the public.
            <a href="/o/@UrlName">← Back to @UrlName</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:800px; margin:auto;">
        <div class="mb-3">
            <a href="@($"/o/{_event.OrganizationUrlName}")" class="text-decoration-none small">
                &larr; @_event.OrganizationName
            </a>
        </div>

        <h1 class="mb-1">@_event.Title</h1>
        <p class="text-secondary mb-4">
            Hosted by <a href="@($"/o/{_event.OrganizationUrlName}")">@_event.OrganizationName</a>
        </p>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">When</dt>
                    <dd class="col-sm-9">
                        @_event.StartDateTime.ToLocalTime().ToString("dddd d MMMM yyyy")
                        @if (!_event.IsAllDay)
                        {
                            <span>, @_event.StartDateTime.ToLocalTime().ToString("h:mm tt")</span>
                            <span>&ndash; @_event.EndDateTime.ToLocalTime().ToString("h:mm tt")</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Where</dt>
                    <dd class="col-sm-9">
                        @if (_event.Location.ExactAddress is string address)
                        {
                            <span>@address</span>
                        }
                        else if (_event.Location.IsExactAddressHidden)
                        {
                            @* Said plainly, before anyone commits, so nobody feels tricked into
                               identifying themselves to find out where they are going. *@
                            <span>
                                @(_event.Location.City ?? "Location") @(_event.Location.State)
                                <span class="d-block text-secondary small">
                                    The exact address is shared with people who are coming.
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="text-secondary">@(_event.Location.City ?? "To be announced")</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(_event.MeetingUrl) && _event.Flags.HasRsvpd)
                        {
                            <span class="d-block mt-1">
                                <a href="@_event.MeetingUrl" target="_blank" rel="noopener noreferrer">Join online</a>
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-3">Coming</dt>
                    <dd class="col-sm-9">
                        @_event.AttendingCount
                        @if (_event.AttendeeCapacity is int cap)
                        {
                            <span class="text-secondary"> of @cap places</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_event.Description))
        {
            <p style="white-space:pre-line;">@_event.Description</p>
        }

        @* Rendered from the server's verdict, never worked out here. *@
        <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
            @if (_event.Flags.HasRsvpd)
            {
                <span class="badge bg-success">You're coming</span>
                <TelerikButton Enabled="@(!_busy)" OnClick="CancelAsync">I can't make it</TelerikButton>
            }
            else if (_event.Flags.CanRsvp)
            {
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Enabled="@(!_busy)" OnClick="RsvpAsync">I'm coming</TelerikButton>
            }
            else if (_event.Flags.RsvpBlockedReason is string reason)
            {
                <span class="text-secondary">@reason</span>
                @if (!_isAuthenticated)
                {
                    <a class="btn btn-primary btn-sm" href="/login">Sign in</a>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public string UrlName { get; set; } = "";
    [Parameter] public string EventSlug { get; set; } = "";

    /// <summary>
    /// What the link preview says. When and where come first because that is what somebody deciding
    /// whether to go actually needs — the description is often a paragraph that reads badly truncated.
    /// </summary>
    private string SocialSummary
    {
        get
        {
            if (_event is null) return "";

            var when  = _event.StartDateTime.ToLocalTime().ToString("dddd d MMMM, h:mm tt");
            var where = _event.Location.City is string city
                ? $" in {city}{(_event.Location.State is string st ? $", {st}" : "")}"
                : "";

            return $"{when}{where}. Hosted by {_event.OrganizationName}. Anyone can come along.";
        }
    }

    private PublicEventRecord? _event;
    private bool _loading = true, _busy, _isAuthenticated;
    private string? _error;

    /// <summary>
    /// Loads during <b>prerender</b>, which is the whole reason it is here rather than in
    /// <c>OnAfterRenderAsync</c> with everything else on this page.
    /// </summary>
    /// <remarks>
    /// The link-preview crawlers do not run JavaScript and never connect the circuit: they read the
    /// server-rendered HTML and leave. Loading the event after first render meant the social card
    /// had nothing to describe at the only moment anybody was looking, so every shared link would
    /// have rendered as a bare URL — invisible to a human testing the page, because by the time
    /// they look it has loaded.
    ///
    /// <para>Safe to do here precisely because this page is public: fetching the event needs no
    /// authentication, so there is no auth state to wait for. Whether to offer the RSVP button does
    /// need it, and that stays in the after-render pass below.</para>
    /// </remarks>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Public page: not being signed in is the ordinary case, not a reason to bail.
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive))
        {
            _isAuthenticated = UserState.IsAuthenticated;
            // Reload once auth is known: the RSVP flags depend on who is asking, and the prerender
            // pass necessarily computed them for nobody.
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _event   = await AdminClient.GetPublicEventAsync(UrlName, EventSlug);
        _loading = false;
        StateHasChanged();
    }

    private async Task RsvpAsync()
    {
        if (_event is null) return;
        _busy = true; _error = null;

        var updated = await AdminClient.RsvpToEventAsync(_event.Id);
        if (updated is null) _error = "That couldn't be saved — the event may be full or closed.";
        else _event = updated;

        _busy = false;
        if (_error is not null) await LoadAsync();
    }

    private async Task CancelAsync()
    {
        if (_event is null) return;
        _busy = true; _error = null;

        if (!await AdminClient.CancelEventRsvpAsync(_event.Id))
            _error = "That couldn't be changed.";

        _busy = false;
        await LoadAsync();
    }
}
