@page "/o/{UrlName}/cases/{CaseRef}"
@namespace Ben.Web.Library.Organization.Public
@using Ben.Data.Common.Enums
@using Ben.Web.Library.Shared
@using Ben.Web.Library.Organization.Cases

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

<PageTitle>@(_case?.Title ?? CaseRef) — @(_case?.OrgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    </div>
}
else if (_case is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Case not found</h2>
        <p class="text-secondary">
            Case <strong>@CaseRef</strong> does not exist or is not publicly available.
            <a href="/o/@UrlName/cases">← Back to cases</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-4" style="max-width:860px; margin:auto;">

        @* ── Breadcrumb nav ───────────────────────────────────────────────── *@
        <nav class="mb-4 d-flex flex-wrap gap-2">
            <a href="/o/@UrlName" class="btn btn-sm btn-outline-secondary">@_case.OrgName</a>
            <a href="/o/@UrlName/cases" class="btn btn-sm btn-outline-secondary">Cases</a>
            <span class="btn btn-sm btn-outline-primary disabled" aria-current="page">@_case.CaseReference</span>
        </nav>

        @* ── Case header ──────────────────────────────────────────────────── *@
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="font-monospace text-muted">@_case.CaseReference</span>
                <span class="badge @_case.Status.BadgeClass()">@_case.Status.Label()</span>
                @if (_case.IsHaunted && _case.Status != CaseStatus.Haunted)
                {
                    <span class="badge bg-warning text-dark">👻 Haunted</span>
                }
            </div>
            <h1 class="mb-1">@_case.Title</h1>
            <p class="text-secondary mb-1">@_case.City, @_case.State, @_case.Country</p>
            <p class="text-muted" style="font-size:.85rem;">
                Opened @_case.DateCaseOpened.ToString("MMMM d, yyyy")
                @if (_case.DateCaseClosed.HasValue)
                {
                    <span> · Closed @_case.DateCaseClosed.Value.ToString("MMMM d, yyyy")</span>
                }
                @if (_case.ClientName is not null)
                {
                    <span> · Client: @_case.ClientName</span>
                }
            </p>
        </div>

        @* ── Description ──────────────────────────────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(_case.Description))
        {
            <div class="mb-4">
                <h5 class="border-bottom pb-1 mb-2">Summary</h5>
                <div>@((MarkupString)_case.Description)</div>
            </div>
        }

        @* ── Community vote ───────────────────────────────────────────────── *@
        <div class="mb-4">
            <h5 class="border-bottom pb-1 mb-2">Community Rating</h5>
            <CaseVoteWidget CaseId="@_case.CaseId" />
        </div>

        @* ── Timeline ─────────────────────────────────────────────────────── *@
        @if (_case.Timeline.Count > 0)
        {
            <div class="mb-4">
                <h5 class="border-bottom pb-1 mb-3">Timeline</h5>
                <div class="timeline-list">
                    @foreach (var entry in _case.Timeline)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="flex-shrink-0 text-center" style="width:2rem;">
                                <span class="@EntryIcon(entry.EntryType)" style="font-size:1.1rem;"></span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex gap-2 align-items-baseline mb-1">
                                    @if (entry.EventDateTime.HasValue)
                                    {
                                        <span class="text-muted small">@entry.EventDateTime.Value.ToString("MMM d, yyyy h:mm tt")</span>
                                    }
                                    <span class="badge @EntryBadgeClass(entry.EntryType) small">@EntryTypeLabel(entry.EntryType)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Title))
                                {
                                    <p class="mb-1 fw-semibold">@entry.Title</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.Body))
                                {
                                    <div class="text-body-secondary" style="font-size:.9rem;">
                                        @((MarkupString)entry.Body)
                                    </div>
                                }
                                @if (entry.EntryType == CaseTimelineEntryType.Evidence && entry.EvidenceFileIds.Count > 0)
                                {
                                    <div class="mt-2 d-flex flex-wrap gap-2">
                                        @foreach (var fileId in entry.EvidenceFileIds)
                                        {
                                            <EvidenceVoteWidget UploadFileId="@fileId" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light text-muted text-center">No public timeline entries yet.</div>
        }
    </div>
}

@code {
    [Parameter] public string UrlName  { get; set; } = "";
    [Parameter] public string CaseRef  { get; set; } = "";

    private PublicCaseDetail? _case;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        StateHasChanged();
        _case    = await AdminClient.GetPublicCaseAsync(UrlName, CaseRef);
        _loading = false;
    }

    private static string EntryTypeLabel(CaseTimelineEntryType t) => t switch
    {
        CaseTimelineEntryType.ClientReport     => "Client",
        CaseTimelineEntryType.InvestigatorNote => "Investigator",
        CaseTimelineEntryType.Evidence         => "Evidence",
        CaseTimelineEntryType.ResearchNote     => "Research",
        _                                      => t.ToString(),
    };

    private static string EntryBadgeClass(CaseTimelineEntryType t) => t switch
    {
        CaseTimelineEntryType.ClientReport     => "bg-secondary",
        CaseTimelineEntryType.InvestigatorNote => "bg-primary",
        CaseTimelineEntryType.Evidence         => "bg-success",
        CaseTimelineEntryType.ResearchNote     => "bg-info text-dark",
        _                                      => "bg-secondary",
    };

    private static string EntryIcon(CaseTimelineEntryType t) => t switch
    {
        CaseTimelineEntryType.Evidence         => "bi bi-camera",
        CaseTimelineEntryType.InvestigatorNote => "bi bi-person-badge",
        CaseTimelineEntryType.ResearchNote     => "bi bi-book",
        _                                      => "bi bi-chat-left-text",
    };
}
