@page "/events"
@page "/o/{UrlName}/events"
@namespace Ben.Web.Library.Organization.Public
@inject IBenAdminClient AdminClient

<PageTitle>@(UrlName is null ? "What's on" : "Events")</PageTitle>

@* Two routes, one page. Under an organization it is their events; at the top level it is
   everybody's, which is the surface that brings in somebody who has never heard of any of them. *@

<div class="container-fluid px-3 py-3" style="max-width:900px; margin:auto;">

    @if (UrlName is not null)
    {
        <div class="mb-3">
            <a href="@($"/o/{UrlName}")" class="text-decoration-none small">&larr; Back to @UrlName</a>
        </div>
    }

    <h1 class="mb-1">@(UrlName is null ? "What's on" : "Events")</h1>
    <p class="text-secondary mb-4">
        @(UrlName is null
            ? "Public investigations, meetings and walks that groups have opened to anyone."
            : "Events this group has opened to anyone.")
    </p>

    @if (_loading)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    }
    else if (_events.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h6 class="mb-2">Nothing coming up</h6>
                <p class="text-secondary small mb-0">
                    @(UrlName is null
                        ? "No groups have public events scheduled at the moment. Worth checking back."
                        : "This group has no public events scheduled at the moment.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in _events)
            {
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-secondary small">
                                @item.StartDateTime.ToLocalTime().ToString("ddd d MMM")
                                @if (!item.IsAllDay)
                                {
                                    <span> · @item.StartDateTime.ToLocalTime().ToString("h:mm tt")</span>
                                }
                            </div>

                            <h6 class="card-title mt-1 mb-1">
                                @if (item.UrlName is string slug)
                                {
                                    <a href="@($"/o/{item.OrganizationUrlName}/events/{slug}")"
                                       class="text-decoration-none">@item.Title</a>
                                }
                                else
                                {
                                    @item.Title
                                }
                            </h6>

                            @* The group is named on every card. Somebody scanning this list is
                               meeting these organizations for the first time. *@
                            <div class="small mb-2">
                                <a href="@($"/o/{item.OrganizationUrlName}")" class="text-decoration-none">
                                    @item.OrganizationName
                                </a>
                            </div>

                            <div class="text-secondary small">
                                @if (item.IsOnline)
                                {
                                    <span class="badge bg-info text-dark">Online</span>
                                }
                                @if (item.City is not null)
                                {
                                    <span>@item.City@(item.State is null ? "" : $", {item.State}")</span>
                                }
                            </div>

                            <div class="text-secondary small mt-1">
                                @item.AttendingCount coming@(item.AttendeeCapacity is int cap ? $" of {cap} places" : "")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Null on the site-wide route, set when showing one group's events.</summary>
    [Parameter] public string? UrlName { get; set; }

    private IReadOnlyList<PublicEventListItem> _events = [];
    private bool _loading = true;
    private string? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        var key = UrlName ?? "*";
        if (_loadedFor == key) return;
        _loadedFor = key;

        _loading = true;
        _events  = await AdminClient.GetPublicEventsAsync(UrlName);
        _loading = false;
    }
}
