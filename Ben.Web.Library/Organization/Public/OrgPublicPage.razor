@page "/o/{UrlName}/{PageSlug}"
@namespace Ben.Web.Library.Organization.Public
@using Ben.Data.Common.Enums

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

<PageTitle>@(_page?.Page.PageTitle ?? PageSlug) — @(_page?.OrgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    </div>
}
else if (_page is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Page not found</h2>
        <p class="text-secondary">
            This page does not exist or is not publicly available.
            <a href="/o/@UrlName">← Back to @UrlName</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:900px; margin:auto;">

        @* ── Org header ───────────────────────────────────────────────────── *@
        <div class="d-flex align-items-center gap-3 mb-3">
            @if (_page.Logos.Any())
            {
                <img src="@AdminClient.GetFileDownloadUrl(_page.Logos.First().UploadFileId)"
                     alt="@(_page.Logos.First().AltText ?? _page.OrgName)"
                     style="max-height:48px; max-width:96px; object-fit:contain;" />
            }
            <a href="/o/@_page.OrgUrlName" class="text-decoration-none">
                <span class="fs-5 fw-semibold text-secondary">@_page.OrgName</span>
            </a>
        </div>

        @* ── Sub-page navigation ──────────────────────────────────────────── *@
        <nav class="mb-4 d-flex flex-wrap gap-2">
            <a href="/o/@_page.OrgUrlName" class="btn btn-sm btn-outline-secondary">Home</a>
            <a href="/o/@_page.OrgUrlName/cases" class="btn btn-sm btn-outline-secondary">Cases</a>
            <a href="/o/@_page.OrgUrlName/events" class="btn btn-sm btn-outline-secondary">Events</a>
            @foreach (var navPage in _page.NavPages.Where(p => p.ParentPageId is null).OrderBy(p => p.SortOrder))
            {
                var isActive = navPage.UrlName.Equals(PageSlug, StringComparison.OrdinalIgnoreCase);
                <a href="/o/@_page.OrgUrlName/@navPage.UrlName"
                   class="btn btn-sm @(isActive ? "btn-primary" : "btn-outline-secondary")">
                    @navPage.PageTitle
                </a>
            }
        </nav>

        @* ── Page title ───────────────────────────────────────────────────── *@
        <h1 class="mb-4">@_page.Page.PageTitle</h1>

        @* ── Page sections ────────────────────────────────────────────────── *@
        @foreach (var section in _page.Page.Sections.OrderBy(s => s.SortOrder))
        {
            <OrgPublicSection Section="section" FileBaseUrl="@AdminClient.GetFileDownloadUrl(Guid.Empty).Replace(Guid.Empty.ToString(), "")" PublicMediaBaseUrl="@AdminClient.GetPublicCaseMediaBaseUrl()" />
        }
    </div>
}

@code {
    [Parameter] public string UrlName   { get; set; } = "";
    [Parameter] public string PageSlug  { get; set; } = "";

    private OrgPublicPageResponse? _page;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        StateHasChanged();
        _page    = await AdminClient.GetPublicOrgPageAsync(UrlName, PageSlug);
        _loading = false;
    }
}
