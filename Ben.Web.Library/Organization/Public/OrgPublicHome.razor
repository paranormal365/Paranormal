@page "/o/{UrlName}"
@namespace Ben.Web.Library.Organization.Public
@using Ben.Data.Common.Enums
@using System.Text.Json

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

<PageTitle>@(_org?.OrgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <TelerikLoaderContainer Visible="true" Text="Loading…" />
    </div>
}
else if (_org is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Organization not found</h2>
        <p class="text-secondary">The organization <strong>@UrlName</strong> does not exist or has no public page.</p>
    </div>
}
else
{
    @* ── Org header ──────────────────────────────────────────────────────── *@
    <div class="container-fluid px-3 py-3" style="max-width:900px; margin:auto;">

        <div class="d-flex align-items-center gap-3 mb-3">
            @if (_org.Logos.Any())
            {
                <img src="@AdminClient.GetFileDownloadUrl(_org.Logos.First().UploadFileId)"
                     alt="@(_org.Logos.First().AltText ?? _org.OrgName)"
                     style="max-height:64px; max-width:120px; object-fit:contain;" />
            }
            <div>
                <h1 class="mb-0 fs-2 fw-bold">@_org.OrgName</h1>
                @if (_org.PublicPhone is not null || _org.PublicEmail is not null || _org.PublicWebsite is not null)
                {
                    <div class="d-flex flex-wrap gap-3 mt-1 text-secondary small">
                        @if (_org.PublicPhone is not null)
                        {
                            <span>📞 <a href="tel:@_org.PublicPhone" class="text-decoration-none text-secondary">@_org.PublicPhone</a></span>
                        }
                        @if (_org.PublicEmail is not null)
                        {
                            <span>✉️ <a href="mailto:@_org.PublicEmail" class="text-decoration-none text-secondary">@_org.PublicEmail</a></span>
                        }
                        @if (_org.PublicWebsite is not null)
                        {
                            <span>🌐 <a href="@_org.PublicWebsite" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-secondary">@_org.PublicWebsite</a></span>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Sub-page navigation ──────────────────────────────────────────── *@
        <nav class="mb-4 d-flex flex-wrap gap-2">
            <a href="/o/@_org.OrgUrlName" class="btn btn-sm btn-outline-primary">Home</a>
            <a href="/o/@_org.OrgUrlName/cases" class="btn btn-sm btn-outline-secondary">Cases</a>
            <a href="/o/@_org.OrgUrlName/events" class="btn btn-sm btn-outline-secondary">Events</a>
            @foreach (var navPage in _org.NavPages.Where(p => p.ParentPageId is null).OrderBy(p => p.SortOrder))
            {
                <a href="/o/@_org.OrgUrlName/@navPage.UrlName" class="btn btn-sm btn-outline-secondary">
                    @navPage.PageTitle
                </a>
            }
        </nav>

        @* ── Home page content ────────────────────────────────────────────── *@
        @if (_org.HomePage is not null)
        {
            @foreach (var section in _org.HomePage.Sections.OrderBy(s => s.SortOrder))
            {
                <OrgPublicSection Section="section" FileBaseUrl="@AdminClient.GetFileDownloadUrl(Guid.Empty).Replace(Guid.Empty.ToString(), "")" />
            }
        }
        else
        {
            <div class="alert alert-light text-center text-muted mt-4">
                This organization has not published a home page yet.
            </div>
        }
    </div>
}

@code {
    [Parameter] public string UrlName { get; set; } = "";

    private OrgPublicHomeResponse? _org;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        StateHasChanged();
        _org     = await AdminClient.GetPublicOrgAsync(UrlName);
        _loading = false;

        // Arrived on an address the group has since changed. The page loads either way — an old
        // link must never simply die — but the browser is moved to the current address so that what
        // gets copied, bookmarked and shared onward is the one that will still be right tomorrow.
        // Replace, not push, so Back goes where the visitor came from rather than round in a loop.
        if (_org is not null
            && !string.Equals(_org.OrgUrlName, UrlName, StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo($"/o/{_org.OrgUrlName}", replace: true);
        }
    }
}
