@* Renders the appropriate content editor for each CmsSection type. *@

@using System.Text.Json
@using System.Text.Json.Nodes
@using Ben.Data.Common.Enums
@using Ben.Web.Library.Services
@inject IBenAdminClient AdminClient

@if (_contentWarning is not null)
{
    <div class="alert alert-warning" role="alert">@_contentWarning</div>
}

@if (SectionType is CmsSectionType.RichText or CmsSectionType.CustomHtml)
{
    <div class="mt-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label fw-semibold mb-0">Content</label>

            @* Ready-made blocks. Picking one adds it to the end of the content with the parts left
               blank to fill in — the editor's own cursor lives inside its rich-text engine and is
               not reachable from C#, and appending is honest about that rather than putting things
               somewhere surprising. *@
            <span class="d-flex gap-2">
                <TelerikDropDownButton Icon="@SvgIcon.Plus">
                    <DropDownButtonContent>Add a block</DropDownButtonContent>
                    <DropDownButtonItems>
                        @foreach (var snippet in CmsSnippets.All)
                        {
                            var chosen = snippet;
                            <DropDownButtonItem OnClick="@(() => InsertSnippetAsync(chosen))">
                                @chosen.Name — <span class="text-secondary">@chosen.Description</span>
                            </DropDownButtonItem>
                        }
                    </DropDownButtonItems>
                </TelerikDropDownButton>

                @* The group's own saved blocks, offered beside ours — from an author's point of
                   view they are the same kind of thing, and separating them into two screens would
                   only make the ones they built themselves harder to find. *@
                @if (OrgId is not null)
                {
                    <TelerikDropDownButton Icon="@SvgIcon.Folder" Enabled="@(_orgTemplates.Count > 0)">
                        <DropDownButtonContent>
                            @(_orgTemplates.Count > 0 ? "Our blocks" : "No saved blocks")
                        </DropDownButtonContent>
                        <DropDownButtonItems>
                            @foreach (var template in _orgTemplates)
                            {
                                var chosen = template;
                                <DropDownButtonItem OnClick="@(() => InsertTemplateAsync(chosen))">
                                    @chosen.Name
                                </DropDownButtonItem>
                            }
                        </DropDownButtonItems>
                    </TelerikDropDownButton>

                    <TelerikButton Icon="@SvgIcon.Save"
                                   FillMode="@ThemeConstants.Button.FillMode.Outline"
                                   Enabled="@(!string.IsNullOrWhiteSpace(_html))"
                                   OnClick="@(() => { _saveTemplateName = ""; _savingTemplate = true; })">
                        Save as ours
                    </TelerikButton>
                }
            </span>
        </div>

        <TelerikEditor Value="@_html"
                       ValueChanged="@OnHtmlChanged"
                       Height="300px" />
        <div class="form-text">
            Blocks are added at the end. Move them where you want them, then replace the placeholder
            text.
        </div>
    </div>
}
else if (SectionType == CmsSectionType.ImageBanner)
{
    <div class="row g-3 mt-1">
        <div class="col-12">
            <label class="form-label fw-semibold">Upload File ID</label>
            <TelerikTextBox Value="@_imgFileId"
                            ValueChanged="@((string v) => { _imgFileId = v; PushImageJson(); })"
                            Width="100%"
                            Placeholder="GUID of an uploaded image file" />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Alt Text</label>
            <TelerikTextBox Value="@_imgAlt"
                            ValueChanged="@((string v) => { _imgAlt = v; PushImageJson(); })"
                            Width="100%" />
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Link URL (optional)</label>
            <TelerikTextBox Value="@_imgLink"
                            ValueChanged="@((string v) => { _imgLink = v; PushImageJson(); })"
                            Width="100%"
                            Placeholder="https://example.com" />
        </div>
    </div>
}
else if (SectionType is CmsSectionType.EmbeddedInvestigations or CmsSectionType.EmbeddedCases)
{
    @* Ben's order, kept deliberately: warn on adding something not already public, THEN ask about
       the address, THEN about identities. The warning is what makes the two questions land as
       decisions rather than as a settings screen. *@
    <div class="mb-3">
        <label class="form-label fw-semibold">
            Which of your @(SectionType == CmsSectionType.EmbeddedCases ? "cases" : "investigations") should this show?
        </label>

        @if (_embedLoading)
        {
            <div class="text-secondary small">Loading…</div>
        }
        else if (_embedChoices.Count == 0)
        {
            <div class="alert alert-light py-2 mb-0">
                Your group has nothing to show here yet.
            </div>
        }
        else
        {
            <div class="border rounded p-2" style="max-height:260px; overflow-y:auto;">
                @foreach (var choice in _embedChoices)
                {
                    var chosen = _embedIds.Contains(choice.Id);
                    <div class="form-check d-flex align-items-start gap-2 py-1">
                        <input class="form-check-input mt-1" type="checkbox" checked="@chosen"
                               id="@($"embed-{choice.Id}")"
                               @onchange="@(e => ToggleEmbed(choice, (bool?)e.Value == true))" />
                        <label class="form-check-label flex-grow-1" for="@($"embed-{choice.Id}")">
                            <span class="fw-semibold">@choice.Title</span>
                            @if (choice.Date is { } d)
                            {
                                <span class="text-secondary small"> — @d.ToString("d MMM yyyy")</span>
                            }
                            @if (!choice.IsAlreadyPublic)
                            {
                                <span class="badge bg-warning text-dark ms-2">Not public yet</span>
                            }
                        </label>
                    </div>
                }
            </div>
        }
    </div>

    @* The warning, shown only once something not already public is selected. *@
    @if (_embedIncludesNonPublic)
    {
        <div class="alert alert-warning py-2">
            <div class="fw-semibold mb-1">Some of these are not public yet.</div>
            <p class="small mb-2">
                Adding them to this page publishes them to anyone who visits your site. Work that is
                private today becomes readable by everyone, including the person it is about.
            </p>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="embed-ack"
                       checked="@_embedIncludeNonPublic"
                       @onchange="@(e => SetIncludeNonPublic((bool?)e.Value == true))" />
                <label class="form-check-label" for="embed-ack">
                    I understand, and I want to publish these.
                </label>
            </div>
            @if (!_embedIncludeNonPublic)
            {
                <div class="small text-secondary mt-1">
                    Until you tick this, the ones marked <em>Not public yet</em> will not appear on
                    the page.
                </div>
            }
        </div>
    }

    <div class="mb-3">
        <label class="form-label fw-semibold">Where it happened</label>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="embed-loc"
                   checked="@_embedShowLocation"
                   @onchange="@(e => SetShowLocation((bool?)e.Value == true))" />
            <label class="form-check-label" for="embed-loc">
                Show the rough area — town, state, and a point on a map
            </label>
        </div>
        <div class="form-text">
            The exact address is never published, whichever way you set this. The point we show is
            the centre of an area several miles across, so it cannot be traced back to a building.
            Leave it off to say nothing about location at all.
        </div>
    </div>

    @if (SectionType == CmsSectionType.EmbeddedCases)
    {
        <div class="mb-3">
            <label class="form-label fw-semibold">Who it was for</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="embed-client"
                       checked="@_embedShowClientName"
                       @onchange="@(e => SetShowClientName((bool?)e.Value == true))" />
                <label class="form-check-label" for="embed-client">
                    Show the client's chosen name
                </label>
            </div>
            <div class="form-text">
                Only the alias the client picked, or the one your group set for them. A client's real
                name is never published here — if neither alias is set, the case appears with no name
                at all.
            </div>
        </div>
    }
}
else if (SectionType == CmsSectionType.ContactInfo)
{
    <div class="row g-2 mt-1">
        <p class="col-12 mb-1 fw-semibold">Show organization contact info:</p>
        <div class="col-6 d-flex align-items-center gap-2">
            <TelerikCheckBox Value="@_contactShowAddresses"
                             ValueChanged="@((bool v) => { _contactShowAddresses = v; PushContactJson(); })"
                             Id="ci-addr" />
            <label for="ci-addr" class="form-label mb-0">Addresses</label>
        </div>
        <div class="col-6 d-flex align-items-center gap-2">
            <TelerikCheckBox Value="@_contactShowEmails"
                             ValueChanged="@((bool v) => { _contactShowEmails = v; PushContactJson(); })"
                             Id="ci-email" />
            <label for="ci-email" class="form-label mb-0">Emails</label>
        </div>
        <div class="col-6 d-flex align-items-center gap-2">
            <TelerikCheckBox Value="@_contactShowPhones"
                             ValueChanged="@((bool v) => { _contactShowPhones = v; PushContactJson(); })"
                             Id="ci-phone" />
            <label for="ci-phone" class="form-label mb-0">Phone Numbers</label>
        </div>
        <div class="col-6 d-flex align-items-center gap-2">
            <TelerikCheckBox Value="@_contactShowLinks"
                             ValueChanged="@((bool v) => { _contactShowLinks = v; PushContactJson(); })"
                             Id="ci-links" />
            <label for="ci-links" class="form-label mb-0">Links</label>
        </div>
    </div>
}
else
{
    @* FileGallery / MemberRoster — raw JSON editor (enhanced in a later phase) *@
    <div class="mt-3">
        <label class="form-label fw-semibold">Content JSON</label>
        <TelerikTextArea Value="@ContentJson"
                         ValueChanged="@ContentJsonChanged"
                         Rows="8"
                         Width="100%" />
        <div class="form-text">
            @if (SectionType == CmsSectionType.FileGallery)
            {
                <span>Format: <code>{ "uploadFileIds": ["guid1", "guid2"] }</code></span>
            }
            else if (SectionType == CmsSectionType.MemberRoster)
            {
                <span>Format: <code>{ "memberIds": ["guid1"], "showRole": true, "showBio": false }</code></span>
            }
        </div>
    </div>
}

@* Saving what is in the editor as one of the group's own reusable blocks. A small
   single-purpose interaction, so it stays a window. *@
<TelerikWindow Visible="@_savingTemplate" VisibleChanged="@(v => _savingTemplate = v)" Modal="true" Width="460px">
    <WindowTitle>Save this as one of our blocks</WindowTitle>
    <WindowContent>
        @if (_templateError is not null)
        {
            <div class="alert alert-danger py-2">@_templateError</div>
        }

        <label class="form-label fw-semibold">Name it</label>
        <input class="form-control mb-2" maxlength="200" value="@_saveTemplateName"
               placeholder="e.g. Investigation write-up layout"
               @oninput="@(e => _saveTemplateName = e.Value?.ToString() ?? string.Empty)" />

        <label class="form-label fw-semibold">What is it for? (optional)</label>
        <input class="form-control" maxlength="500" value="@_saveTemplateDescription"
               @oninput="@(e => _saveTemplateDescription = e.Value?.ToString() ?? string.Empty)" />

        <div class="form-text mt-2">
            Saved for the whole group, not just you. Anyone who can edit pages will be able to
            insert it.
        </div>

        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <TelerikButton OnClick="@(() => _savingTemplate = false)" Enabled="@(!_templateBusy)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Enabled="@(!_templateBusy && !string.IsNullOrWhiteSpace(_saveTemplateName))"
                           OnClick="SaveAsTemplateAsync">Save</TelerikButton>
        </div>
    </WindowContent>
</TelerikWindow>

@code {
    [Parameter] public CmsSectionType SectionType { get; set; }

    /// <summary>
    /// Whose saved blocks to offer. Null in contexts with no organization in scope, where the
    /// palette we ship is still available but the group's own is not.
    /// </summary>
    [Parameter] public Guid? OrgId { get; set; }
    [Parameter] public string ContentJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> ContentJsonChanged { get; set; }

    // RichText / CustomHtml
    private string _html = "";

    /// <summary>
    /// Adds a ready-made block to the content.
    /// </summary>
    /// <remarks>
    /// Goes through the same <c>OnHtmlChanged</c> path a typed edit takes, so the value the editor
    /// shows and the JSON that gets saved cannot disagree. Setting the DOM directly would update
    /// neither — Telerik inputs ignore values written by anything but their own binding, which has
    /// produced a convincing-but-wrong result in this codebase before.
    /// </remarks>
    private Guid? _templatesLoadedFor;


    private async Task InsertSnippetAsync(CmsSnippet snippet)
        => await AppendMarkupAsync(CmsSnippets.Render(snippet));

    // ── The group's own saved blocks ────────────────────────────────────────

    private IReadOnlyList<CmsTemplateRecord> _orgTemplates = [];
    private bool _savingTemplate, _templateBusy;
    private string _saveTemplateName = "", _saveTemplateDescription = "";
    private string? _templateError;

    private async Task LoadOrgTemplatesAsync()
    {
        if (OrgId is not Guid orgId) return;
        _orgTemplates = await AdminClient.GetCmsTemplatesAsync(orgId, CmsTemplateScope.Section);
    }

    /// <summary>
    /// Inserts one of the group's saved blocks. Its stored content is a section's own JSON, so the
    /// markup is read out of it rather than assumed — a saved block of a different section type
    /// contributes nothing here rather than pasting raw JSON into the page.
    /// </summary>
    private async Task InsertTemplateAsync(CmsTemplateRecord template)
    {
        string? markup = null;
        try
        {
            var node = JsonNode.Parse(template.ContentJson);
            markup = node?["html"]?.GetValue<string>();
        }
        catch (JsonException) { }

        if (!string.IsNullOrWhiteSpace(markup)) await AppendMarkupAsync(markup);
    }

    private async Task AppendMarkupAsync(string markup)
    {
        var combined = string.IsNullOrWhiteSpace(_html) ? markup : _html + "\n" + markup;
        await OnHtmlChanged(combined);
    }

    private async Task SaveAsTemplateAsync()
    {
        if (OrgId is not Guid orgId) return;
        _templateBusy = true;
        _templateError = null;

        // Stored as a section's own content shape, so inserting it later is the same operation as
        // inserting one of ours.
        var content = new JsonObject { ["html"] = _html }.ToJsonString();

        var saved = await AdminClient.SaveCmsTemplateAsync(orgId, new SaveCmsTemplateRequest(
            _saveTemplateName.Trim(),
            string.IsNullOrWhiteSpace(_saveTemplateDescription) ? null : _saveTemplateDescription.Trim(),
            CmsTemplateScope.Section,
            SectionType,
            content));

        _templateBusy = false;

        if (saved is null)
        {
            _templateError = "That couldn't be saved. The group may already have a block with that name.";
            return;
        }

        _savingTemplate = false;
        _saveTemplateName = _saveTemplateDescription = "";
        await LoadOrgTemplatesAsync();
    }
    private string? _contentWarning;

    // ImageBanner
    private string _imgFileId = "";
    private string _imgAlt    = "";
    private string _imgLink   = "";

    // ContactInfo
    private bool _contactShowAddresses = true;
    private bool _contactShowEmails    = true;
    private bool _contactShowPhones    = true;
    private bool _contactShowLinks     = true;


    // ── Embedded cases / investigations (item #80 part 4) ────────────────────
    // The editor only ever offers this group's own work, and the server re-checks that on read.
    // Nothing here is a control; it is the place where the group is told what publishing means.

    private List<EmbeddableRecord> _embedChoices = [];
    private bool _embedLoading;
    private List<Guid> _embedIds = [];
    private bool _embedIncludeNonPublic;
    private bool _embedShowLocation;
    private bool _embedShowClientName;

    /// <summary>True when the selection contains work that is not already public.</summary>
    private bool _embedIncludesNonPublic
        => _embedChoices.Any(c => _embedIds.Contains(c.Id) && !c.IsAlreadyPublic);

    private async Task LoadEmbedChoicesAsync()
    {
        if (OrgId is not { } orgId) return;

        _embedLoading = true;
        _embedChoices = SectionType == CmsSectionType.EmbeddedCases
            ? [.. await AdminClient.GetEmbeddableCasesAsync(orgId)]
            : [.. await AdminClient.GetEmbeddableInvestigationsAsync(orgId)];
        _embedLoading = false;
        StateHasChanged();
    }

    private async Task ToggleEmbed(EmbeddableRecord choice, bool selected)
    {
        if (selected)
        {
            if (!_embedIds.Contains(choice.Id)) _embedIds.Add(choice.Id);
        }
        else
        {
            _embedIds.Remove(choice.Id);

            // Nothing non-public left selected, so the acknowledgement no longer applies. Clearing
            // it means re-adding one asks again, rather than inheriting a yes given for a different
            // record entirely.
            if (!_embedIncludesNonPublic) _embedIncludeNonPublic = false;
        }

        await WriteEmbedAsync();
    }

    private async Task SetIncludeNonPublic(bool value)
    {
        _embedIncludeNonPublic = value;
        await WriteEmbedAsync();
    }

    private async Task SetShowLocation(bool value)
    {
        _embedShowLocation = value;
        await WriteEmbedAsync();
    }

    private async Task SetShowClientName(bool value)
    {
        _embedShowClientName = value;
        await WriteEmbedAsync();
    }

    private async Task WriteEmbedAsync()
    {
        var json = new JsonObject
        {
            ["ids"] = new JsonArray([.. _embedIds.Select(id => JsonValue.Create(id.ToString()))]),
            ["includeNonPublic"] = _embedIncludeNonPublic,
            ["showApproximateLocation"] = _embedShowLocation,
            ["showClientName"] = _embedShowClientName,
        }.ToJsonString();

        await ContentJsonChanged.InvokeAsync(json);
    }

    private void ParseEmbed(JsonElement root)
    {
        _embedIds = root.TryGetProperty("ids", out var ids) && ids.ValueKind == JsonValueKind.Array
            ? [.. ids.EnumerateArray()
                     .Select(e => Guid.TryParse(e.GetString(), out var g) ? g : Guid.Empty)
                     .Where(g => g != Guid.Empty)]
            : [];

        _embedIncludeNonPublic = GetBool(root, "includeNonPublic", false);
        _embedShowLocation     = GetBool(root, "showApproximateLocation", false);
        _embedShowClientName   = GetBool(root, "showClientName", false);
    }

    /// <summary>
    /// One override for all three concerns, because there can only be one.
    /// </summary>
    /// <remarks>
    /// Parsing runs first and unconditionally. The template load below returns early once it has
    /// run for this organization, and when that guard lived in its own override it sat in front of
    /// everything — so adding a second override here was the moment the section's own content would
    /// have stopped being parsed. Order matters more than it looks.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        ParseContentJson();

        if (SectionType is CmsSectionType.EmbeddedInvestigations or CmsSectionType.EmbeddedCases
            && _embedChoices.Count == 0 && !_embedLoading)
        {
            await LoadEmbedChoicesAsync();
        }

        if (OrgId is not Guid orgId || _templatesLoadedFor == orgId) return;
        _templatesLoadedFor = orgId;
        await LoadOrgTemplatesAsync();
    }

    private void ParseContentJson()
    {
        // Cleared each parse: OnParametersSet re-runs this, and a warning left over from earlier
        // content would outlive the problem it described.
        _contentWarning = null;
        if (string.IsNullOrWhiteSpace(ContentJson)) return;
        try
        {
            using var doc = JsonDocument.Parse(ContentJson);
            var root = doc.RootElement;

            if (SectionType is CmsSectionType.RichText or CmsSectionType.CustomHtml)
            {
                _html = root.TryGetProperty("html", out var el) ? el.GetString() ?? "" : "";
            }
            else if (SectionType == CmsSectionType.ImageBanner)
            {
                _imgFileId = root.TryGetProperty("uploadFileId", out var id)  ? id.GetString()  ?? "" : "";
                _imgAlt    = root.TryGetProperty("altText",      out var alt) ? alt.GetString() ?? "" : "";
                _imgLink   = root.TryGetProperty("linkUrl",      out var lnk) ? lnk.GetString() ?? "" : "";
            }
            else if (SectionType is CmsSectionType.EmbeddedInvestigations or CmsSectionType.EmbeddedCases)
            {
                ParseEmbed(root);
            }
            else if (SectionType == CmsSectionType.ContactInfo)
            {
                _contactShowAddresses = GetBool(root, "showAddresses", true);
                _contactShowEmails    = GetBool(root, "showEmails",    true);
                _contactShowPhones    = GetBool(root, "showPhones",    true);
                _contactShowLinks     = GetBool(root, "showLinks",     true);
            }
        }
        catch (JsonException)
        {
            // Stored content that won't parse. The editor keeps its defaults rather than throwing,
            // so the section stays editable and can be saved back into a good state — but say so,
            // because silently showing defaults looks identical to the settings never having been
            // set, and the next save would overwrite whatever is really stored.
            _contentWarning = "This section's saved content could not be read, so the fields below "
                            + "show defaults. Saving will replace the stored content.";
        }
    }

    private static bool GetBool(JsonElement root, string key, bool fallback)
        => root.TryGetProperty(key, out var el) ? el.GetBoolean() : fallback;

    private async Task OnHtmlChanged(string value)
    {
        _html = value;
        var json = JsonSerializer.Serialize(new { html = _html });
        await ContentJsonChanged.InvokeAsync(json);
    }

    private void PushImageJson()
    {
        var json = JsonSerializer.Serialize(new
        {
            uploadFileId = _imgFileId,
            altText      = _imgAlt,
            linkUrl      = _imgLink
        });
        ContentJsonChanged.InvokeAsync(json);
    }

    private void PushContactJson()
    {
        var json = JsonSerializer.Serialize(new
        {
            showAddresses = _contactShowAddresses,
            showEmails    = _contactShowEmails,
            showPhones    = _contactShowPhones,
            showLinks     = _contactShowLinks
        });
        ContentJsonChanged.InvokeAsync(json);
    }
}
