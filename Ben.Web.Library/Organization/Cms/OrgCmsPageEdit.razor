@page "/organizations/{OrgId:guid}/cms/pages/{PageId:guid}"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

@using System.Text.Json
@using System.Text.Json.Nodes
@using Ben.Data.Common.Enums

<PageTitle>@(_page?.PageTitle ?? "Edit Page") — CMS</PageTitle>

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <TelerikButton Icon="@SvgIcon.ArrowLeft"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           OnClick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cms"))">
                Back to CMS
            </TelerikButton>
            <h3 class="d-inline-block ms-3 mb-0">@(_page?.PageTitle ?? "Edit Page")</h3>
        </div>
        <div class="col-auto d-flex gap-2">
            <TelerikButton Icon="@SvgIcon.Eye"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="TogglePreview">
                @(_showPreview ? "Hide Preview" : "Preview")
            </TelerikButton>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    @if (_page is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading page…" />
    }
    else
    {
        <div class="row">

            @* ── Main editing column ───────────────────────────────────────── *@
            <div class="@(_showPreview ? "col-md-6" : "col-12")">

                @* Page metadata card *@
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Page Settings</strong>
                        <TelerikButton Icon="@SvgIcon.Save"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       OnClick="SavePageMetadata"
                                       Enabled="@(!_isBusy)">
                            @(_isBusy ? "Saving…" : "Save Settings")
                        </TelerikButton>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                                <TelerikTextBox @bind-Value="@_metaForm.PageTitle" Width="100%" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Sort Order</label>
                                <TelerikNumericTextBox @bind-Value="@_metaForm.SortOrder" Width="100%" Min="0" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">URL Slug <span class="text-danger">*</span></label>
                                <TelerikTextBox @bind-Value="@_metaForm.UrlName" Width="100%" />
                            </div>
                            <div class="col-md-6 d-flex align-items-center gap-2">
                                <TelerikCheckBox @bind-Value="@_metaForm.IsPublished" Id="meta-published" />
                                <label for="meta-published" class="form-label mb-0">Published</label>
                            </div>
                            <div class="col-md-6 d-flex align-items-center gap-2">
                                <TelerikCheckBox @bind-Value="@_metaForm.IsPublic" Id="meta-public" />
                                <label for="meta-public" class="form-label mb-0">Visible to public</label>
                            </div>
                        </div>
                    </div>
                </div>

                @* Page summary / intro HTML *@
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Summary / Intro</strong>
                        <TelerikButton Icon="@SvgIcon.Save"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       OnClick="SavePageMetadata"
                                       Enabled="@(!_isBusy)">
                            Save
                        </TelerikButton>
                    </div>
                    <div class="card-body">
                        <TelerikEditor @bind-Value="@_metaForm.PageHtml"
                                       Height="200px" />
                    </div>
                </div>

                @* Sections list *@
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Sections (@(_sections.Count))</strong>
                        <TelerikButton Icon="@SvgIcon.Plus"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       OnClick="OpenNewSectionDialog">
                            Add Section
                        </TelerikButton>
                    </div>
                    <div class="card-body p-0">
                        @if (_sections.Count == 0)
                        {
                            <p class="p-3 text-secondary mb-0">No sections yet. Click "Add Section" to get started.</p>
                        }
                        else
                        {
                            @for (int i = 0; i < _sections.Count; i++)
                            {
                                var idx = i;
                                var s = _sections[i];
                                <div class="border-bottom p-3 d-flex align-items-start gap-2">
                                    <div class="flex-shrink-0 d-flex flex-column gap-1">
                                        <TelerikButton Icon="@SvgIcon.ArrowUp"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       Size="@ThemeConstants.Button.Size.Small"
                                                       Enabled="@(idx > 0)"
                                                       OnClick="@(() => MoveSection(idx, -1))" />
                                        <TelerikButton Icon="@SvgIcon.ArrowDown"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       Size="@ThemeConstants.Button.Size.Small"
                                                       Enabled="@(idx < _sections.Count - 1)"
                                                       OnClick="@(() => MoveSection(idx, 1))" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-secondary">@s.SectionType</span>
                                            @if (!string.IsNullOrWhiteSpace(s.Title))
                                            {
                                                <strong>@s.Title</strong>
                                            }
                                            @if (!s.IsActive)
                                            {
                                                <span class="badge bg-warning text-dark">Hidden</span>
                                            }
                                        </div>
                                        <div class="text-secondary small text-truncate" style="max-width:400px">
                                            @SectionPreviewText(s)
                                        </div>
                                    </div>
                                    <div class="flex-shrink-0 d-flex gap-1">
                                        <TelerikButton Icon="@SvgIcon.Pencil"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       Size="@ThemeConstants.Button.Size.Small"
                                                       OnClick="@(() => OpenEditSectionDialog(s))" />
                                        <TelerikButton Icon="@SvgIcon.Trash"
                                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                       Size="@ThemeConstants.Button.Size.Small"
                                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                       OnClick="@(() => RequestDeleteSection(s))" />
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>

            @* ── Inline preview column ─────────────────────────────────────── *@
            @if (_showPreview)
            {
                <div class="col-md-6">
                    <div class="card sticky-top" style="top:1rem;max-height:85vh;overflow-y:auto;">
                        <div class="card-header"><strong>Live Preview</strong></div>
                        <div class="card-body cms-preview">
                            <h2>@_metaForm.PageTitle</h2>
                            @if (!string.IsNullOrWhiteSpace(_metaForm.PageHtml))
                            {
                                <div class="mb-4">@((MarkupString)_metaForm.PageHtml)</div>
                            }
                            @foreach (var sec in _sections.Where(s => s.IsActive).OrderBy(s => s.SortOrder))
                            {
                                <div class="mb-4">
                                    @if (!string.IsNullOrWhiteSpace(sec.Title))
                                    {
                                        <h4>@sec.Title</h4>
                                    }
                                    @RenderSectionPreview(sec)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>

@* ── Add/Edit Section dialog ──────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showSectionDialog"
               Title="@(_editingSection is null ? "New Section" : "Edit Section")"
               Width="720px">
    <DialogContent>
        <div class="row g-3">
            @if (_editingSection is null)
            {
                <div class="col-12">
                    <label class="form-label fw-semibold">Section Type <span class="text-danger">*</span></label>
                    <TelerikDropDownList Data="@_sectionTypeOptions"
                                         @bind-Value="@_sectionForm.SectionType"
                                         ValueField="@nameof(SectionTypeOption.Value)"
                                         TextField="@nameof(SectionTypeOption.Label)"
                                         Width="100%" />
                </div>
            }
            else
            {
                <div class="col-12">
                    <p class="mb-0 text-secondary">Type: <strong>@_sectionForm.SectionType</strong></p>
                </div>
            }
            <div class="col-12">
                <label class="form-label fw-semibold">Section Title (optional)</label>
                <TelerikTextBox @bind-Value="@_sectionForm.Title" Width="100%" Placeholder="Optional heading above this section" />
            </div>
            <div class="col-md-6 d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="@_sectionForm.IsActive" Id="sec-active" />
                <label for="sec-active" class="form-label mb-0">Active (visible)</label>
            </div>
        </div>

        @* Type-specific content editor *@
        <CmsSectionEditor SectionType="@_sectionForm.SectionType"
                          @bind-ContentJson="@_sectionForm.ContentJson" />

        @if (_sectionError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_sectionError</div>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="CloseSectionDialog">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Save"
                       OnClick="SaveSection"
                       Enabled="@(!_isBusy)">
            @(_isBusy ? "Saving…" : "Save Section")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Delete section confirmation ──────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showDeleteSectionDialog"
               Title="Delete Section"
               Width="400px">
    <DialogContent>
        <p>Remove this section from the page?</p>
        @if (_pendingDeleteSection is not null && !string.IsNullOrWhiteSpace(_pendingDeleteSection.Title))
        {
            <p class="text-secondary"><strong>@_pendingDeleteSection.Title</strong></p>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@(() => { _showDeleteSectionDialog = false; _pendingDeleteSection = null; })">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                       OnClick="ConfirmDeleteSection"
                       Enabled="@(!_isBusy)">
            @(_isBusy ? "Deleting…" : "Delete")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter] public Guid OrgId  { get; set; }
    [Parameter] public Guid PageId { get; set; }

    private CmsPageDetail? _page;
    private List<CmsSectionRecord> _sections = [];
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isBusy;
    private bool _showPreview;

    // Metadata form
    private MetaFormModel _metaForm = new();

    // Section dialog
    private bool _showSectionDialog;
    private string? _sectionError;
    private CmsSectionRecord? _editingSection;
    private SectionFormModel _sectionForm = new();

    // Delete section
    private bool _showDeleteSectionDialog;
    private CmsSectionRecord? _pendingDeleteSection;

    private static readonly List<SectionTypeOption> _sectionTypeOptions = Enum.GetValues<CmsSectionType>()
        .Select(t => new SectionTypeOption(t, t.ToString()))
        .ToList();

    protected override void OnInitialized()
    {
        if (!UserState.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadPageAsync();
        StateHasChanged();
    }

    private async Task LoadPageAsync()
    {
        _page = await AdminClient.GetCmsPageAsync(OrgId, PageId);
        if (_page is null) { _errorMessage = "Page not found."; return; }

        _sections = [.. _page.Sections.OrderBy(s => s.SortOrder)];
        _metaForm = new MetaFormModel
        {
            PageTitle   = _page.PageTitle,
            UrlName     = _page.UrlName,
            PageHtml    = _page.PageHtml,
            IsPublished = _page.IsPublished,
            IsPublic    = _page.IsPublic,
            SortOrder   = _page.SortOrder
        };
    }

    // ── Metadata ──────────────────────────────────────────────────────────────

    private async Task SavePageMetadata()
    {
        if (string.IsNullOrWhiteSpace(_metaForm.PageTitle) || string.IsNullOrWhiteSpace(_metaForm.UrlName))
        {
            _errorMessage = "Title and URL Slug are required.";
            return;
        }
        _isBusy = true;
        var result = await AdminClient.UpdateCmsPageAsync(OrgId, PageId, new CmsUpdatePageRequest(
            _metaForm.PageTitle.Trim(),
            _metaForm.UrlName.Trim().ToLowerInvariant(),
            _metaForm.PageHtml,
            _metaForm.IsPublished,
            _metaForm.IsPublic,
            _page?.ParentPageId,
            _metaForm.SortOrder));

        _isBusy = false;
        if (result is not null) { _successMessage = "Page settings saved."; _page = result; }
        else _errorMessage = "Failed to save page settings.";
    }

    // ── Preview ───────────────────────────────────────────────────────────────

    private void TogglePreview() => _showPreview = !_showPreview;

    private RenderFragment RenderSectionPreview(CmsSectionRecord section)
    {
        return builder =>
        {
            if (section.SectionType is CmsSectionType.RichText or CmsSectionType.CustomHtml)
            {
                try
                {
                    using var doc = JsonDocument.Parse(section.ContentJson);
                    if (doc.RootElement.TryGetProperty("html", out var el))
                    {
                        builder.AddMarkupContent(0, el.GetString() ?? string.Empty);
                        return;
                    }
                }
                catch { }
            }
            builder.AddMarkupContent(0, $"<em class='text-secondary'>[{section.SectionType}]</em>");
        };
    }

    private static string SectionPreviewText(CmsSectionRecord s)
    {
        if (s.SectionType is CmsSectionType.RichText or CmsSectionType.CustomHtml)
        {
            try
            {
                using var doc = JsonDocument.Parse(s.ContentJson);
                if (doc.RootElement.TryGetProperty("html", out var el))
                {
                    var raw = el.GetString() ?? "";
                    return System.Text.RegularExpressions.Regex.Replace(raw, "<[^>]+>", " ").Trim();
                }
            }
            catch { }
        }
        return s.ContentJson.Length > 80 ? s.ContentJson[..80] + "…" : s.ContentJson;
    }

    // ── Section CRUD ──────────────────────────────────────────────────────────

    private void OpenNewSectionDialog()
    {
        _editingSection  = null;
        _sectionError    = null;
        _sectionForm     = new SectionFormModel { SortOrder = _sections.Count + 1 };
        _showSectionDialog = true;
    }

    private void OpenEditSectionDialog(CmsSectionRecord s)
    {
        _editingSection = s;
        _sectionError   = null;
        _sectionForm    = new SectionFormModel
        {
            SectionType = s.SectionType,
            Title       = s.Title,
            ContentJson = s.ContentJson,
            IsActive    = s.IsActive,
            SortOrder   = s.SortOrder
        };
        _showSectionDialog = true;
    }

    private void CloseSectionDialog()
    {
        _showSectionDialog = false;
        _editingSection    = null;
        _sectionError      = null;
    }

    private async Task SaveSection()
    {
        _isBusy = true;
        _sectionError = null;

        if (_editingSection is null)
        {
            var result = await AdminClient.CreateCmsSectionAsync(OrgId, PageId, new CmsCreateSectionRequest(
                _sectionForm.SectionType, _sectionForm.Title?.Trim(),
                _sectionForm.ContentJson, _sections.Count + 1, _sectionForm.IsActive));

            if (result is null) _sectionError = "Failed to create section.";
            else
            {
                _sections.Add(result);
                _showSectionDialog = false;
                _successMessage = "Section added.";
            }
        }
        else
        {
            var result = await AdminClient.UpdateCmsSectionAsync(OrgId, PageId, _editingSection.Id,
                new CmsUpdateSectionRequest(_sectionForm.Title?.Trim(), _sectionForm.ContentJson, _sectionForm.IsActive));

            if (result is null) _sectionError = "Failed to update section.";
            else
            {
                var idx = _sections.FindIndex(s => s.Id == _editingSection.Id);
                if (idx >= 0) _sections[idx] = result;
                _showSectionDialog = false;
                _successMessage = "Section updated.";
            }
        }

        _isBusy = false;
    }

    private async Task MoveSection(int idx, int direction)
    {
        var newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= _sections.Count) return;

        (_sections[idx], _sections[newIdx]) = (_sections[newIdx], _sections[idx]);

        var orderedIds = _sections.Select(s => s.Id).ToList();
        await AdminClient.ReorderCmsSectionsAsync(OrgId, PageId, orderedIds);

        // Update local sort order numbers
        for (int i = 0; i < _sections.Count; i++)
        {
            var s = _sections[i];
            _sections[i] = s with { SortOrder = i + 1 };
        }
    }

    private void RequestDeleteSection(CmsSectionRecord s)
    {
        _pendingDeleteSection  = s;
        _showDeleteSectionDialog = true;
    }

    private async Task ConfirmDeleteSection()
    {
        if (_pendingDeleteSection is null) return;
        _isBusy = true;
        var ok = await AdminClient.DeleteCmsSectionAsync(OrgId, PageId, _pendingDeleteSection.Id);
        _isBusy = false;
        _showDeleteSectionDialog = false;

        if (ok) { _sections.RemoveAll(s => s.Id == _pendingDeleteSection.Id); _successMessage = "Section removed."; }
        else _errorMessage = "Failed to remove section.";
        _pendingDeleteSection = null;
    }

    // ── Form models ───────────────────────────────────────────────────────────

    private sealed class MetaFormModel
    {
        public string PageTitle  { get; set; } = "";
        public string UrlName    { get; set; } = "";
        public string? PageHtml  { get; set; }
        public bool IsPublished  { get; set; }
        public bool IsPublic     { get; set; }
        public int SortOrder     { get; set; } = 1;
    }

    private sealed class SectionFormModel
    {
        public CmsSectionType SectionType { get; set; } = CmsSectionType.RichText;
        public string? Title    { get; set; }
        public string ContentJson { get; set; } = "{}";
        public bool IsActive   { get; set; } = true;
        public int SortOrder   { get; set; } = 1;
    }

    private sealed record SectionTypeOption(CmsSectionType Value, string Label);
}
