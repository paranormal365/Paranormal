    private void OpenNewGroupDialog()
    {
        _editingGroup = null;
        _groupForm = new GroupFormModel { IsActive = true };
        _groupDialogError = null;
        _showGroupDialog = true;
    }

    private void OpenEditGroupDialog(OrgMemberGroupRecord g)
    {
        _editingGroup = g;
        _groupForm = new GroupFormModel { Name = g.Name, Description = g.Description, IsActive = g.IsActive, SortOrder = g.SortOrder };
        _groupDialogError = null;
        _showGroupDialog = true;
    }

    private async Task SaveGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_groupForm.Name)) { _groupDialogError = "Name is required."; return; }
        _groupDialogError = null;
        var req = new OrgGroupUpsertRequest(_groupForm.Name.Trim(), _groupForm.Description?.Trim(), _groupForm.IsActive, _groupForm.SortOrder);
        if (_editingGroup is null)
        {
            var created = await AdminClient.CreateGroupAsync(OrgId, req);
            if (created is null) { _groupDialogError = "Create failed."; return; }
            _groups = [created, ..(_groups ?? [])];
        }
        else
        {
            var updated = await AdminClient.UpdateGroupAsync(OrgId, _editingGroup.Id, req);
            if (updated is null) { _groupDialogError = "Update failed."; return; }
            _groups = [..(_groups ?? []).Select(g => g.Id == updated.Id ? updated : g)];
        }
        _showGroupDialog = false;
    }

    private void ConfirmDeleteGroup(OrgMemberGroupRecord g)
    {
        _deletingGroup = g;
        _showDeleteGroupDialog = true;
    }

    private async Task ExecuteDeleteGroupAsync()
    {
        if (_deletingGroup is null) return;
        await AdminClient.DeleteGroupAsync(OrgId, _deletingGroup.Id);
        _groups = [..(_groups ?? []).Where(g => g.Id != _deletingGroup.Id)];
        _showDeleteGroupDialog = false;
        _deletingGroup = null;
    }

    // ── Group Members dialog ──────────────────────────────────────────────────

    private async Task OpenMembersDialog(OrgMemberGroupRecord g)
    {
        _membersGroup = g;
        _membersDialogError = null;
        _addMemberMembershipId = Guid.Empty;
        await RefreshMembersDialogAsync();
        _showMembersDialog = true;
    }

    private async Task RefreshMembersDialogAsync()
    {
        if (_membersGroup is null) return;

        var rawMembers = await AdminClient.GetGroupMembersAsync(OrgId, _membersGroup.Id);
        var memberships = _orgMemberships ?? [];
        var users = _orgUsers ?? [];

        _groupMembers = rawMembers.Select(m =>
        {
            var membership = memberships.FirstOrDefault(ms => ms.MembershipId == m.OrganizationUserMembershipId);
            var user = membership is not null ? users.FirstOrDefault(u => u.Id == membership.AppUserId) : null;
            return new GroupMemberRow(m.Id, m.OrganizationUserMembershipId,
                user?.DisplayName ?? user?.Email ?? membership?.AppUserId.ToString() ?? "Unknown",
                membership?.Role.ToString() ?? "");
        }).ToList();

        var alreadyInGroup = rawMembers.Select(m => m.OrganizationUserMembershipId).ToHashSet();
        _availableOrgMembers = memberships
            .Where(m => m.IsActive && !alreadyInGroup.Contains(m.MembershipId))
            .Select(m =>
            {
                var user = users.FirstOrDefault(u => u.Id == m.AppUserId);
                return new OrgMemberOption(m.MembershipId, user?.DisplayName ?? user?.Email ?? m.AppUserId.ToString());
            })
            .OrderBy(o => o.DisplayName)
            .ToList();
    }

    private async Task AddMemberAsync()
    {
        if (_membersGroup is null || _addMemberMembershipId == Guid.Empty) return;
        _membersDialogError = null;
        var result = await AdminClient.AddGroupMemberAsync(OrgId, _membersGroup.Id, _addMemberMembershipId);
        if (result is null) { _membersDialogError = "Failed to add member."; return; }
        _addMemberMembershipId = Guid.Empty;
        await RefreshMembersDialogAsync();
    }

    private async Task RemoveMemberAsync(GroupMemberRow row)
    {
        if (_membersGroup is null) return;
        _membersDialogError = null;
        await AdminClient.RemoveGroupMemberAsync(OrgId, _membersGroup.Id, row.MembershipId);
        await RefreshMembersDialogAsync();
    }

