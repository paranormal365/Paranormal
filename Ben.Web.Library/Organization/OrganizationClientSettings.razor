@page "/organizations/{OrgId:guid}/client-settings"
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@using Ben.Web.Library.Manage.Maps
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

<PageTitle>Client Settings — @(_orgName ?? "Organization")</PageTitle>

<div class="container-fluid py-3" style="max-width:860px;">
    <h3 class="mb-4">Client Settings — @(_orgName ?? OrgId.ToString())</h3>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (!_loaded)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading settings…" />
    }
    else
    {
        @* ── Case Acceptance ────────────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header fw-semibold">Case Acceptance</div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <TelerikSwitch @bind-Value="@_isAcceptingClients"
                                       OnLabel="Accepting Clients"
                                       OffLabel="Not Accepting Clients"
                                       Width="220px" />
                        <span class="text-secondary small">
                            @(_isAcceptingClients
                                ? "Your organization will appear in client search results."
                                : "Your organization is hidden from client search results.")
                        </span>
                    </div>
                    @if (_isAcceptingClients)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <TelerikCheckBox @bind-Value="@_acceptsOutsideRange" Id="outside-range" />
                            <label for="outside-range" class="form-label mb-0">
                                Accept clients outside our operating area
                                <span class="text-secondary small d-block">
                                    Your org will appear in results for clients beyond your radius, sorted below in-range orgs.
                                </span>
                            </label>
                        </div>
                    }
                    <div>
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Enabled="@(!_isBusy)"
                                       OnClick="SaveAcceptance">
                            @(_isBusy ? "Saving…" : "Save Acceptance Settings")
                        </TelerikButton>
                    </div>
                </div>
            </div>
        </div>

        @* ── Area of Operation ───────────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="fw-semibold">Area of Operation</span>
                @if (_area is not null)
                {
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   Icon="@SvgIcon.Pencil"
                                   OnClick="OpenEditArea">Edit</TelerikButton>
                }
            </div>
            <div class="card-body">
                @if (_area is null)
                {
                    <p class="text-secondary mb-3">
                        No operating area configured. Set a center location and radius so clients can find you.
                    </p>
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   Icon="@SvgIcon.Plus"
                                   OnClick="OpenEditArea">
                        Set Operating Area
                    </TelerikButton>
                }
                else
                {
                    <div class="d-flex align-items-start gap-4">
                        <div>
                            <div class="mb-1">
                                <strong>@_area.DisplayLabel</strong>
                            </div>
                            <div class="text-secondary small">
                                Radius: @_area.RadiusMiles mi
                            </div>
                        </div>
                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                       Icon="@SvgIcon.Trash"
                                       OnClick="ConfirmDeleteArea">Remove</TelerikButton>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ── Edit Area dialog ────────────────────────────────────────────────────── *@
<AreaOfOperationDialog @bind-Visible="@_showAreaDialog"
                       OrgId="@OrgId"
                       ExistingArea="@_area"
                       IsAcceptingClients="@_isAcceptingClients"
                       AcceptsClientsOutsideRange="@_acceptsOutsideRange"
                       OnSaved="@OnAreaSaved" />

@* ── Delete confirm ───────────────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showDeleteConfirm" Width="400px" Modal="true">
    <WindowTitle>Remove Operating Area</WindowTitle>
    <WindowContent>
        <p>Remove the operating area configuration? Your organization will no longer appear in client proximity searches.</p>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <TelerikButton OnClick="@(() => _showDeleteConfirm = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           OnClick="DeleteArea"
                           Enabled="@(!_isBusy)">
                @(_isBusy ? "Removing…" : "Remove")
            </TelerikButton>
        </div>
    </WindowContent>
</TelerikWindow>

@code {
    [Parameter] public Guid OrgId { get; set; }

    private string? _orgName;
    private bool _loaded;
    private string? _error;
    private bool _isBusy;

    // Acceptance state
    private bool _isAcceptingClients;
    private bool _acceptsOutsideRange;

    // Area of operation
    private OrganizationAreaOfOperationRecord? _area;
    private bool _showAreaDialog;
    private bool _showDeleteConfirm;

    // Area dialog form state is managed by AreaOfOperationDialog component

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            var org = await AdminClient.GetOrganizationAsync(OrgId);
            _orgName             = org?.Name;
            _isAcceptingClients  = org?.IsAcceptingClients ?? false;
            _acceptsOutsideRange = org?.AcceptsClientsOutsideRange ?? false;

            try { _area = await AdminClient.GetOrgAreaOfOperationAsync(OrgId); }
            catch { _area = null; }

            _loaded = true;
        }
        catch { _error = "Failed to load settings."; _loaded = true; }
    }

    // ── Acceptance ────────────────────────────────────────────────────────────
    private async Task SaveAcceptance()
    {
        _isBusy = true;
        try
        {
            await AdminClient.UpdateClientAcceptanceAsync(OrgId, _isAcceptingClients, _acceptsOutsideRange);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isBusy = false; }
    }

    // ── Area of Operation ─────────────────────────────────────────────────────
    private void OpenEditArea() => _showAreaDialog = true;

    private void OnAreaSaved(OrganizationAreaOfOperationRecord result)
    {
        _area = result;
    }

    private void ConfirmDeleteArea() => _showDeleteConfirm = true;

    private async Task DeleteArea()
    {
        _isBusy = true;
        try
        {
            await AdminClient.DeleteOrgAreaOfOperationAsync(OrgId);
            _area = null;
            _showDeleteConfirm = false;
        }
        catch { _error = "Failed to remove operating area."; }
        finally { _isBusy = false; }
    }
}
