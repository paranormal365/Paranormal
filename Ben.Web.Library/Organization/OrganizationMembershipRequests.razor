@*
  OrganizationMembershipRequests.razor
  ─────────────────────────────────────
  Embedded component showing pending and resolved membership applications.
  Used as a sub-panel on the OrganizationMembers page.
  Org members with MembershipRequests-Update permission can Accept or Deny.
  Applicants can withdraw their own pending request.
*@

@namespace Ben.Web.Library.Organization
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

<div class="mt-4">
    <h5 class="mb-3 fw-semibold">Membership Applications</h5>

    @if (_loading)
    {
        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
    }
    else if (_requests.Count == 0)
    {
        <p class="text-secondary small">No membership applications for this organization.</p>
    }
    else
    {
        @* ── Pending ─────────────────────────────────────────────────────── *@
        var pending = _requests.Where(r => r.Status == OrganizationMembershipRequestStatus.Pending).ToList();
        @if (pending.Any())
        {
            <h6 class="text-warning small text-uppercase fw-semibold mb-2">Pending (@pending.Count)</h6>
            <TelerikGrid Data="@pending" Pageable="true" PageSize="10" Class="mb-4">
                <GridColumns>
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.ApplicantDisplayName)" Title="Applicant" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.ApplicantEmail)" Title="Email" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.RequestMessage)" Title="Message" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.DateCreated)" Title="Applied" DisplayFormat="{0:d}" Width="110px" />
                    <GridCommandColumn Width="260px">
                        <GridCommandButton OnClick="@(e => AcceptAsync((OrganizationMembershipRequestRecord)e.Items.First()))"
                                          ThemeColor="@ThemeConstants.Button.ThemeColor.Success"
                                          Size="@ThemeConstants.Button.Size.Small">Accept</GridCommandButton>
                        <GridCommandButton OnClick="@(e => DenyAsync((OrganizationMembershipRequestRecord)e.Items.First()))"
                                          ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                          Size="@ThemeConstants.Button.Size.Small"
                                          Class="ms-1">Deny</GridCommandButton>
                        <GridCommandButton OnClick="@(e => OpenVoteDialog((OrganizationMembershipRequestRecord)e.Items.First()))"
                                          ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                          Size="@ThemeConstants.Button.Size.Small"
                                          Class="ms-1">Vote</GridCommandButton>
                    </GridCommandColumn>
                </GridColumns>
            </TelerikGrid>
        }

        @* ── Resolved ─────────────────────────────────────────────────────── *@
        var resolved = _requests.Where(r => r.Status != OrganizationMembershipRequestStatus.Pending).ToList();
        @if (resolved.Any())
        {
            <h6 class="text-secondary small text-uppercase fw-semibold mb-2">Resolved (@resolved.Count)</h6>
            <TelerikGrid Data="@resolved" Pageable="true" PageSize="10">
                <GridColumns>
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.ApplicantDisplayName)" Title="Applicant" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.Status)" Title="Status" Width="110px">
                        <Template>
                            @{ var r = (OrganizationMembershipRequestRecord)context; }
                            <span class="badge @StatusBadge(r.Status)">@r.Status</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.RespondedByDisplayName)" Title="Responded By" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.DateResponded)" Title="Date" DisplayFormat="{0:d}" Width="110px" />
                </GridColumns>
            </TelerikGrid>
        }
    }
</div>

@* ── Deny dialog — Phase 3: CanReapply + DenialReason ────────────────────── *@
<TelerikDialog @bind-Visible="@_showDenyDialog" Title="Deny Membership Application" Width="480px">
    <DialogContent>
        <p class="small text-secondary mb-3">
            Applicant: <strong>@_pendingDeny?.ApplicantDisplayName</strong>
        </p>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Denial Reason <span class="text-secondary small">(optional)</span></label>
                <TelerikTextArea @bind-Value="@_denyNote" Rows="3" Width="100%"
                                 Placeholder="Explain why the application was not approved…" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="@_canReapply" Id="can-reapply" />
                <label for="can-reapply" class="form-label mb-0">
                    Allow this applicant to reapply in the future
                </label>
            </div>
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => { _showDenyDialog = false; _pendingDeny = null; _denyNote = string.Empty; _canReapply = false; })">
            Cancel
        </TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                       OnClick="ConfirmDenyAsync">
            Deny Application
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Open vote dialog ─────────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showVoteDialog" Title="Open Committee Vote" Width="420px">
    <DialogContent>
        <p class="small text-secondary mb-3">
            Set a deadline for committee members to vote on <strong>@_pendingVote?.ApplicantDisplayName</strong>'s application.
            When the deadline passes, votes are tallied: majority Approve → Accepted, otherwise → Denied.
        </p>
        <label class="form-label fw-semibold">Vote Deadline <span class="text-danger">*</span></label>
        <TelerikDateTimePicker @bind-Value="@_voteDeadline" Width="100%" Min="@DateTime.Now.AddHours(1)" />
        @if (_voteDialogError is not null)
        {
            <div class="text-danger small mt-2">@_voteDialogError</div>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="@(() => _showVoteDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       OnClick="ConfirmOpenVoteAsync"
                       Enabled="@(!_isBusy)">
            @(_isBusy ? "Opening…" : "Open Vote")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

<TelerikNotification @ref="_toast" HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top" />

@code {
    [Parameter, EditorRequired] public Guid OrgId { get; set; }

    private bool _loading = true;
    private List<OrganizationMembershipRequestRecord> _requests = [];

    private bool _showDenyDialog;
    private OrganizationMembershipRequestRecord? _pendingDeny;
    private string _denyNote = string.Empty;
    private bool _canReapply;

    // Phase 3: committee vote
    private bool _showVoteDialog;
    private OrganizationMembershipRequestRecord? _pendingVote;
    private DateTime? _voteDeadline;
    private string? _voteDialogError;
    private bool _isBusy;

    private TelerikNotification? _toast;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _requests = (await AdminClient.GetMembershipRequestsAsync(OrgId)).ToList(); }
        catch { _requests = []; }
        finally { _loading = false; }
    }

    private async Task AcceptAsync(OrganizationMembershipRequestRecord r)
    {
        var updated = await AdminClient.RespondToMembershipRequestAsync(
            OrgId, r.Id, OrganizationMembershipRequestStatus.Accepted, null);
        if (updated is not null)
        {
            _toast?.Show(new NotificationModel { Text = $"Accepted {r.ApplicantDisplayName}", ThemeColor = ThemeConstants.Notification.ThemeColor.Success, CloseAfter = 4000 });
            await ReloadAsync();
        }
        else
        {
            _toast?.Show(new NotificationModel { Text = $"Failed to accept {r.ApplicantDisplayName}. Please try again.", ThemeColor = ThemeConstants.Notification.ThemeColor.Error, CloseAfter = 4000 });
        }
    }

    private void DenyAsync(OrganizationMembershipRequestRecord r)
    {
        _pendingDeny = r;
        _denyNote    = string.Empty;
        _canReapply  = false;
        _showDenyDialog = true;
    }

    private async Task ConfirmDenyAsync()
    {
        if (_pendingDeny is null) return;
        var updated = await AdminClient.RespondToMembershipRequestAsync(
            OrgId, _pendingDeny.Id, OrganizationMembershipRequestStatus.Denied,
            _denyNote, canReapply: _canReapply,
            denialReason: string.IsNullOrWhiteSpace(_denyNote) ? null : _denyNote);
        _showDenyDialog = false;
        if (updated is not null)
        {
            _toast?.Show(new NotificationModel { Text = $"Denied {_pendingDeny.ApplicantDisplayName}", ThemeColor = ThemeConstants.Notification.ThemeColor.Error, CloseAfter = 4000 });
            _pendingDeny = null;
            await ReloadAsync();
        }
        else
        {
            _toast?.Show(new NotificationModel { Text = "Failed to deny the request. Please try again.", ThemeColor = ThemeConstants.Notification.ThemeColor.Error, CloseAfter = 4000 });
        }
    }

    private void OpenVoteDialog(OrganizationMembershipRequestRecord r)
    {
        _pendingVote     = r;
        _voteDeadline    = DateTime.Now.AddDays(7);
        _voteDialogError = null;
        _showVoteDialog  = true;
    }

    private async Task ConfirmOpenVoteAsync()
    {
        if (_pendingVote is null) return;
        if (!_voteDeadline.HasValue || _voteDeadline.Value <= DateTime.Now)
        {
            _voteDialogError = "Please select a future deadline.";
            return;
        }
        _isBusy = true; _voteDialogError = null;
        try
        {
            var result = await AdminClient.OpenMembershipVoteAsync(OrgId, _pendingVote.Id, _voteDeadline.Value.ToUniversalTime());
            if (result is null) { _voteDialogError = "Failed to open vote. Please try again."; }
            else
            {
                _showVoteDialog = false;
                _toast?.Show(new NotificationModel { Text = $"Vote opened for {_pendingVote.ApplicantDisplayName}", ThemeColor = ThemeConstants.Notification.ThemeColor.Info, CloseAfter = 4000 });
                await ReloadAsync();
            }
        }
        catch (Exception ex) { _voteDialogError = ex.Message; }
        finally { _isBusy = false; }
    }

    private static string StatusBadge(OrganizationMembershipRequestStatus s) => s switch
    {
        OrganizationMembershipRequestStatus.Accepted  => "bg-success",
        OrganizationMembershipRequestStatus.Denied    => "bg-danger",
        OrganizationMembershipRequestStatus.Withdrawn => "bg-secondary",
        _                                             => "bg-warning text-dark",
    };
}
