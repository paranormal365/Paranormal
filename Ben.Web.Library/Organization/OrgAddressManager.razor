@namespace Ben.Web.Library.Organization
@using Ben.Web.Library.Manage.Maps
@using Ben.Web.Library.Shared

@inject IBenAdminClient AdminClient
@inject IJSRuntime JS

@if (_loading)
{
    <TelerikLoaderContainer Visible="true" Text="Loading addresses…" />
}
else
{
    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }

    @* ── Toolbar ───────────────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 fw-semibold">Addresses</h6>
        @if (!_showForm)
        {
            <TelerikButton Icon="@SvgIcon.Plus"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="BeginCreate">
                Add Address
            </TelerikButton>
        }
    </div>

    @* ── Create / Edit form ────────────────────────────────────────────────── *@
    @if (_showForm)
    {
        <div class="card mb-4 border-primary">
            <div class="card-body">
                <h6 class="card-title mb-3">@(_editId.HasValue ? "Edit Address" : "New Address")</h6>

                <div class="row g-3">
                    @* Address type *@
                    <div class="col-12">
                        <label class="form-label fw-semibold">Type <span class="text-danger">*</span></label>
                        <TelerikDropDownList Data="@_addressTypes"
                                             @bind-Value="@_formAddressTypeId"
                                             TextField="@nameof(AddressTypeOption.Name)"
                                             ValueField="@nameof(AddressTypeOption.Id)"
                                             Width="100%" />
                    </div>

                    @* Street address, City/State/Zip, Country, map preview, and
                       "Use my location" button are all inside AddressFieldsWithMap. *@
                    <div class="col-12">
                        <AddressFieldsWithMap @ref="_addrFields" State="@_addrState" />
                    </div>

                    @* Public / SortOrder *@
                    <div class="col-sm-6 d-flex align-items-center gap-2 mt-1">
                        <TelerikCheckBox @bind-Value="@_formIsPublic" Id="addr-public" />
                        <label for="addr-public">Public</label>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Sort Order</label>
                        <TelerikNumericTextBox @bind-Value="@_formSortOrder" Width="100%" />
                    </div>

                    @* Buttons *@
                    <div class="col-12 d-flex gap-2 mt-2">
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Icon="@SvgIcon.Save"
                                       OnClick="SaveAsync"
                                       Enabled="@(!_saving)">
                            @(_saving ? "Saving…" : "Save")
                        </TelerikButton>
                        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       OnClick="CancelForm">
                            Cancel
                        </TelerikButton>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Address list ──────────────────────────────────────────────────────── *@
    @if (_addresses.Any())
    {
        <TelerikGrid Data="@_addresses" Pageable="false" Sortable="true" Class="mb-2">
            <GridColumns>
                <GridColumn Title="Address" Field="@nameof(OrganizationAddressRecord.StreetAddress1)">
                    <Template>
                        @{ var a = (OrganizationAddressRecord)context; }
                        <div>
                            <div class="fw-semibold">@a.StreetAddress1@(a.StreetAddress2 is not null ? ", " + a.StreetAddress2 : "")</div>
                            <div class="text-secondary small">@a.City, @a.State @a.ZipCode — @a.Country</div>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(OrganizationAddressRecord.IsPublic)" Title="Public" Width="80px" />
                <GridColumn Title="" Width="100px">
                    <Template>
                        @{ var a2 = (OrganizationAddressRecord)context; }
                        <div class="d-flex gap-1">
                            <TelerikButton Icon="@SvgIcon.Pencil"
                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                           Size="@ThemeConstants.Button.Size.Small"
                                           OnClick="@(async () => await BeginEdit(a2))" />
                            <TelerikButton Icon="@SvgIcon.Trash"
                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                           Size="@ThemeConstants.Button.Size.Small"
                                           OnClick="@(() => ConfirmDeleteAsync(a2.Id))" />
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    }
    else if (!_showForm)
    {
        <div class="text-muted small fst-italic">No addresses added yet.</div>
    }
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private IReadOnlyList<OrganizationAddressRecord> _addresses = [];
    private IReadOnlyList<AddressTypeOption>         _addressTypes = [];
    private AddressFieldsWithMap?                    _addrFields;
    private AddressFieldsState                       _addrState = new();
    private bool    _loading  = true;
    private bool    _showForm = false;
    private bool    _saving   = false;
    private string? _errorMessage;
    private Guid?   _editId;

    // Stores IsPublic + SortOrder — address text lives in _addrState
    private bool _formIsPublic;
    private int  _formSortOrder;
    private Guid _formAddressTypeId;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        await Task.WhenAll(LoadAddressesAsync(), LoadAddressTypesAsync());
        _loading = false;
    }

    private async Task LoadAddressesAsync()
        => _addresses = await AdminClient.GetOrgAddressesAsync(OrgId);

    private async Task LoadAddressTypesAsync()
    {
        var types = await AdminClient.GetOrgAddressTypesAsync();
        _addressTypes = types.Where(t => t.IsActive)
                             .OrderBy(t => t.SortOrder)
                             .Select(t => new AddressTypeOption(t.Id, t.Name))
                             .ToList();
    }

    // ── Form management ───────────────────────────────────────────────────────

    private async Task BeginCreate()
    {
        await LoadAddressTypesAsync();
        _editId             = null;
        _addrState          = new AddressFieldsState { Country = "US" };
        _formAddressTypeId  = _addressTypes.FirstOrDefault()?.Id ?? Guid.Empty;
        _formIsPublic       = false;
        _formSortOrder      = 0;
        _showForm           = true;
        _errorMessage       = null;
        _addrFields?.ResetPreview();   // clear previous entry's pin
    }

    private async Task BeginEdit(OrganizationAddressRecord address)
    {
        await LoadAddressTypesAsync();
        _editId            = address.Id;
        _addrState         = new AddressFieldsState
        {
            StreetAddress1 = address.StreetAddress1,
            StreetAddress2 = address.StreetAddress2,
            City           = address.City,
            State          = address.State,
            ZipCode        = address.ZipCode,
            Country        = address.Country,
            Latitude       = address.Latitude,    // carried into component so map shows existing pin
            Longitude      = address.Longitude
        };
        _formAddressTypeId = address.OrganizationAddressTypeId;
        _formIsPublic      = address.IsPublic;
        _formSortOrder     = address.SortOrder;
        _showForm          = true;
        _errorMessage      = null;

        // Restore existing pin if available
        if (_addrFields is not null && address.Latitude.HasValue && address.Longitude.HasValue)
            _addrFields.InitPreview((double)address.Latitude.Value, (double)address.Longitude.Value);
    }

    private void CancelForm()
    {
        _showForm = false;
        _editId   = null;
    }

    // ── Save / Delete ─────────────────────────────────────────────────────────

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_addrState.StreetAddress1) || string.IsNullOrWhiteSpace(_addrState.City))
        {
            _errorMessage = "Street Address and City are required.";
            return;
        }
        if (_formAddressTypeId == Guid.Empty)
        {
            _errorMessage = "Address type is required.";
            return;
        }

        _saving = true;
        StateHasChanged();

        var request = new OrgAddressUpsertRequest(
            _formAddressTypeId,
            _addrState.StreetAddress1.Trim(),
            _addrState.StreetAddress2?.Trim(),
            _addrState.City.Trim(),
            _addrState.State.Trim(),
            _addrState.ZipCode.Trim(),
            _addrState.Country.Trim(),
            _formIsPublic,
            _formSortOrder,
            _addrState.Latitude,    // pass preview coords so server skips re-geocoding
            _addrState.Longitude);

        var saved = _editId.HasValue
            ? await AdminClient.UpdateOrgAddressAsync(OrgId, _editId.Value, request)
            : await AdminClient.CreateOrgAddressAsync(OrgId, request);

        _saving = false;

        if (saved is not null) { await LoadAddressesAsync(); CancelForm(); }
        else _errorMessage = "Save failed. You may not have permission to manage addresses.";
    }

    private async Task ConfirmDeleteAsync(Guid addressId)
    {
        var ok = await AdminClient.DeleteOrgAddressAsync(OrgId, addressId);
        if (ok) await LoadAddressesAsync();
        else    _errorMessage = "Delete failed.";
    }

    private sealed record AddressTypeOption(Guid Id, string Name);
}
