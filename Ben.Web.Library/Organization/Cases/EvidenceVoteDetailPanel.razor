@* Org-member view of enriched vote details for a single evidence file. *@
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@if (_loading)
{
    <TelerikLoader Size="sm" />
}
else if (_votes.Count == 0)
{
    <div class="text-secondary small">No votes yet.</div>
}
else
{
    <div class="d-flex flex-column gap-2">
        @foreach (var v in _votes)
        {
            <div class="d-flex align-items-start gap-2 p-2 rounded border @VoteBorder(v.VoteType)">
                @* Vote type badge *@
                <span class="badge @VoteBadge(v.VoteType) flex-shrink-0">@VoteLabel(v.VoteType)</span>

                <div class="flex-grow-1 small">
                    <div class="d-flex align-items-center gap-1 flex-wrap">
                        <strong>@(v.VoterDisplayName ?? "Anonymous")</strong>
                        @* Context chips *@
                        @if (v.IsOriginalUploader)
                        {
                            <span class="badge bg-primary" title="This person uploaded the file">📤 Uploader</span>
                        }
                        @if (v.IsVoterCaseOrgMember)
                        {
                            <span class="badge bg-success" title="Member of the org that owns this case">🏢 Case Org</span>
                        }
                        else if (v.VoterOrganizationId.HasValue)
                        {
                            <span class="badge bg-secondary" title="Member of a different org">🌐 @(v.VoterOrganizationName ?? "Other Org")</span>
                        }
                        @if (v.IsVoterCaseClient)
                        {
                            <span class="badge bg-warning text-dark" title="The client who submitted this case">👤 Case Client</span>
                        }
                        @if (v.IsPublicVoter)
                        {
                            <span class="badge bg-light text-dark border">Public</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(v.Comment))
                    {
                        <div class="text-secondary mt-1">@v.Comment</div>
                    }
                    <div class="text-muted mt-1" style="font-size:.7rem;">
                        @v.DateVoted.ToViewerLocalTime(UserState).ToString("MMM d, yyyy h:mm tt")
                        @if (v.CaseReference is not null)
                        {
                            <span class="ms-2">Case @v.CaseReference</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* Summary stats at the bottom *@
    <div class="d-flex gap-3 mt-2 small text-secondary">
        <span>✓ @_votes.Count(v => v.VoteType == EvidenceVoteType.Confirms) confirms</span>
        <span>✗ @_votes.Count(v => v.VoteType == EvidenceVoteType.Disputes) disputes</span>
        <span>? @_votes.Count(v => v.VoteType == EvidenceVoteType.Inconclusive) inconclusive</span>
        @{ var caseOrgCount = _votes.Count(v => v.IsVoterCaseOrgMember); }
        @if (caseOrgCount > 0) { <span>🏢 @caseOrgCount from case org</span> }
        @{ var crossOrgCount = _votes.Count(v => v.VoterOrganizationId.HasValue && !v.IsVoterCaseOrgMember); }
        @if (crossOrgCount > 0) { <span>🌐 @crossOrgCount cross-org</span> }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid UploadFileId { get; set; }

    private List<EvidenceVoteRecord> _votes = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { _votes = (await AdminClient.GetEvidenceVotesAsync(UploadFileId)).ToList(); }
        catch { /* non-critical — panel just stays empty */ }
        _loading = false;
    }

    private static string VoteBadge(EvidenceVoteType t) => t switch
    {
        EvidenceVoteType.Confirms    => "bg-success",
        EvidenceVoteType.Disputes    => "bg-danger",
        _                            => "bg-secondary",
    };

    private static string VoteBorder(EvidenceVoteType t) => t switch
    {
        EvidenceVoteType.Confirms    => "border-success",
        EvidenceVoteType.Disputes    => "border-danger",
        _                            => "",
    };

    private static string VoteLabel(EvidenceVoteType t) => t switch
    {
        EvidenceVoteType.Confirms    => "Confirms",
        EvidenceVoteType.Disputes    => "Disputes",
        _                            => "Inconclusive",
    };
}
