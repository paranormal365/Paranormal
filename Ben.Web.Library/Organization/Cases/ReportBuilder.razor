@using Ben.Data.Common.Enums
@using Ben.Web.Services
@using Microsoft.JSInterop
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IJSRuntime JS

@* ── Report list or editor ────────────────────────────────────────────────── *@

@if (_loading)
{
    <TelerikLoaderContainer Visible="true" Text="Loading reports…" />
}
else if (_editingReport is null)
{
    @* ── Report list ──────────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-secondary small">@_reports.Count report@(_reports.Count == 1 ? "" : "s")</span>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Plus"
                       OnClick="NewReport">New Report</TelerikButton>
    </div>

    @if (_reports.Count == 0)
    {
        <div class="text-secondary text-center py-4 small">No reports yet. Click 'New Report' to start building.</div>
    }

    @foreach (var r in _reports)
    {
        <div class="card mb-2">
            <div class="card-body d-flex align-items-start justify-content-between gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold">@r.Title</span>
                        <span class="badge @(r.Status == CaseReportStatus.Published ? "bg-success" : "bg-warning text-dark")">
                            @r.Status
                        </span>
                    </div>
                    @if (r.ExpectedDeliveryDate.HasValue)
                    {
                        <div class="text-secondary small">Expected: @r.ExpectedDeliveryDate.Value.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")</div>
                    }
                    @if (r.PublishedAt.HasValue)
                    {
                        <div class="text-secondary small">Published: @r.PublishedAt.Value.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")</div>
                    }
                </div>
                <div class="d-flex gap-1">
                    <TelerikButton Size="sm" Icon="@SvgIcon.Pencil" OnClick="@(() => OpenEditor(r.Id))" />
                    <TelerikButton Size="sm" Icon="@SvgIcon.FilePdf" Title="Download PDF"
                                   OnClick="@(() => DownloadPdf(r.Id, r.Title))" />
                    @if (r.Status == CaseReportStatus.Draft)
                    {
                        <TelerikButton Size="sm" ThemeColor="error" Icon="@SvgIcon.Trash" OnClick="@(() => DeleteReport(r.Id))" />
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    @* ── Report editor ────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-2 mb-3">
        <TelerikButton FillMode="outline" Icon="@SvgIcon.ChevronLeft" OnClick="@(() => _editingReport = null)">Back</TelerikButton>
        <span class="fw-semibold flex-grow-1">@(_editingReport.Title)</span>
        <span class="badge @(_editingReport.Status == CaseReportStatus.Published ? "bg-success" : "bg-warning text-dark")">@_editingReport.Status</span>
        @if (_editingReport.Status == CaseReportStatus.Draft)
        {
            <TelerikButton ThemeColor="success" Size="sm" OnClick="PublishReport" Enabled="@(!_saving)">Publish</TelerikButton>
        }
        <TelerikButton Size="sm" Icon="@SvgIcon.FilePdf"
                       OnClick="@(() => DownloadPdf(_editingReport.Id, _editingReport.Title))">PDF</TelerikButton>
    </div>

    @if (_error is not null) { <div class="alert alert-danger py-2 small mb-3">@_error</div> }
    @if (_publishedTitle is not null)
    {
        <div class="alert alert-success py-2 small mb-3">
            <strong>Published.</strong> Client has been notified via the case message board: "@_publishedTitle"
        </div>
    }

    @* ── Header fields ─────────────────────────────────────────────────────── *@
    <div class="card mb-3">
        <div class="card-header fw-semibold">Report Details</div>
        <div class="card-body row g-2">
            <div class="col-12">
                <label class="form-label small fw-semibold">Title</label>
                <TelerikTextBox @bind-Value="@_form.Title" Width="100%" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Expected Delivery Date</label>
                <TelerikDatePicker @bind-Value="@_form.ExpectedDeliveryDate" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">Executive Summary</label>
                <TelerikTextArea @bind-Value="@_form.Summary" Rows="4" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">Conclusion / Determination</label>
                <TelerikTextArea @bind-Value="@_form.Conclusion" Rows="4" Width="100%" />
            </div>
            <div class="col-12 text-end">
                <TelerikButton ThemeColor="primary" OnClick="SaveReport" Enabled="@(!_saving && !string.IsNullOrWhiteSpace(_form.Title))">
                    @(_saving ? "Saving…" : "Save")
                </TelerikButton>
            </div>
        </div>
    </div>

    @* ── Sections ──────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="fw-semibold">Sections</span>
        <TelerikButton Size="sm" Icon="@SvgIcon.Plus" OnClick="AddSection" Enabled="@(!_saving)">Add Section</TelerikButton>
    </div>

    @foreach (var sec in _editingReport.Sections.OrderBy(s => s.SortOrder))
    {
        var s = sec;
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                    <div class="fw-semibold small">@s.Title <span class="badge bg-secondary ms-1">@s.SectionType</span></div>
                    <TelerikButton Size="sm" FillMode="flat" ThemeColor="error" Icon="@SvgIcon.Trash" OnClick="@(() => RemoveSection(s.Id))" />
                </div>
                @if (!string.IsNullOrWhiteSpace(s.Body))
                {
                    <div class="small text-secondary">@((MarkupString)s.Body)</div>
                }
                @if (s.SectionType == CaseReportSectionType.Evidence && s.Files.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @foreach (var f in s.Files.OrderBy(x => x.SortOrder))
                        {
                            <span class="badge bg-secondary d-flex align-items-center gap-1" title="@f.FileName">
                                <TelerikSvgIcon Icon="@SvgIcon.File" />
                                <span style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@f.FileName</span>
                                <TelerikButton Size="sm" FillMode="flat" Icon="@SvgIcon.X" Class="text-white p-0"
                                               OnClick="@(() => RemoveSectionFile(s.Id, f.Id))" />
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@* ── New Report dialog ────────────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showNewDialog" Width="520px" Modal="true">
    <WindowTitle>New Report</WindowTitle>
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="@_newTitle" Width="100%" Placeholder="e.g. BenCo Investigation Report — Park Residence" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Expected Delivery Date</label>
                <TelerikDatePicker @bind-Value="@_newDeliveryDate" Width="100%" />
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" OnClick="@(() => _showNewDialog = false)" /></WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showNewDialog = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="primary" OnClick="CreateReport"
                           Enabled="@(!_saving && !string.IsNullOrWhiteSpace(_newTitle))">Create</TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@* ── Add Section dialog ───────────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="@_showSectionDialog" Width="480px" Modal="true">
    <WindowTitle>Add Section</WindowTitle>
    <WindowContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Title</label>
                <TelerikTextBox @bind-Value="@_sectionTitle" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Type</label>
                <TelerikDropDownList @bind-Value="@_sectionType"
                                     Data="@_sectionTypeOptions"
                                     TextField="@nameof(SectionTypeOption.Label)"
                                     ValueField="@nameof(SectionTypeOption.Value)"
                                     Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Body (optional)</label>
                <TelerikTextArea @bind-Value="@_sectionBody" Rows="4" Width="100%" />
            </div>
        </div>
    </WindowContent>
    <WindowActions><WindowAction Name="Close" OnClick="@(() => _showSectionDialog = false)" /></WindowActions>
    <WindowFooter>
        <div class="d-flex gap-2 justify-content-end w-100">
            <TelerikButton OnClick="@(() => _showSectionDialog = false)">Cancel</TelerikButton>
            <TelerikButton ThemeColor="primary" OnClick="SaveSection"
                           Enabled="@(!_saving && !string.IsNullOrWhiteSpace(_sectionTitle))">Add</TelerikButton>
        </div>
    </WindowFooter>
</TelerikWindow>

@code {
    [Parameter, EditorRequired] public Guid OrgId { get; set; }
    [Parameter, EditorRequired] public Guid CaseId { get; set; }

    private List<CaseReportSummary> _reports = [];
    private CaseReportDetail? _editingReport;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _publishedTitle;

    // New report dialog
    private bool _showNewDialog;
    private string _newTitle = "";
    private DateTime? _newDeliveryDate;

    // Add section dialog
    private bool _showSectionDialog;
    private string _sectionTitle = "";
    private CaseReportSectionType _sectionType = CaseReportSectionType.Text;
    private string _sectionBody = "";

    // Editor form
    private ReportForm _form = new();

    private static readonly List<SectionTypeOption> _sectionTypeOptions = Enum
        .GetValues<CaseReportSectionType>()
        .Select(t => new SectionTypeOption(t, t.ToString()))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try { _reports = (await AdminClient.GetCaseReportsAsync(OrgId, CaseId)).ToList(); }
        catch { _error = "Failed to load reports."; }
        _loading = false;
    }

    private void NewReport() { _newTitle = ""; _newDeliveryDate = null; _showNewDialog = true; }

    private async Task CreateReport()
    {
        _saving = true;
        try
        {
            var req    = new UpsertCaseReportRequest(_newTitle, null, null, _newDeliveryDate);
            var result = await AdminClient.CreateCaseReportAsync(OrgId, CaseId, req);
            if (result is not null)
            {
                _showNewDialog = false;
                _reports.Insert(0, new CaseReportSummary(result.Id, result.CaseId, result.Title, result.Status, result.ExpectedDeliveryDate, result.PublishedAt, result.DateCreated));
                await OpenEditor(result.Id);
            }
        }
        catch { _error = "Failed to create report."; }
        finally { _saving = false; }
    }

    private async Task OpenEditor(Guid reportId)
    {
        _error = null;
        _editingReport = await AdminClient.GetCaseReportAsync(OrgId, CaseId, reportId);
        if (_editingReport is not null)
            _form = new ReportForm { Title = _editingReport.Title, Summary = _editingReport.Summary, Conclusion = _editingReport.Conclusion, ExpectedDeliveryDate = _editingReport.ExpectedDeliveryDate };
    }

    private async Task SaveReport()
    {
        if (_editingReport is null) return;
        _saving = true;
        try
        {
            var req    = new UpsertCaseReportRequest(_form.Title, _form.Summary, _form.Conclusion, _form.ExpectedDeliveryDate);
            var result = await AdminClient.UpdateCaseReportAsync(OrgId, CaseId, _editingReport.Id, req);
            if (result is not null) { _editingReport = result; UpdateSummaryList(result); }
        }
        catch { _error = "Failed to save."; }
        finally { _saving = false; }
    }

    private async Task PublishReport()
    {
        if (_editingReport is null) return;
        _saving = true; _publishedTitle = null;
        try
        {
            var result = await AdminClient.PublishCaseReportAsync(OrgId, CaseId, _editingReport.Id);
            if (result is not null)
            {
                _editingReport = result;
                UpdateSummaryList(result);
                _publishedTitle = result.Title; // shows success banner
            }
        }
        catch { _error = "Failed to publish."; }
        finally { _saving = false; }
    }

    private async Task DeleteReport(Guid reportId)
    {
        await AdminClient.DeleteCaseReportAsync(OrgId, CaseId, reportId);
        _reports.RemoveAll(r => r.Id == reportId);
    }

    private void AddSection() { _sectionTitle = ""; _sectionBody = ""; _sectionType = CaseReportSectionType.Text; _showSectionDialog = true; }

    private async Task SaveSection()
    {
        if (_editingReport is null) return;
        _saving = true;
        try
        {
            var req    = new UpsertSectionRequest(_sectionTitle, _sectionBody, _sectionType);
            var result = await AdminClient.AddReportSectionAsync(OrgId, CaseId, _editingReport.Id, req);
            if (result is not null)
            {
                _showSectionDialog = false;
                _editingReport = _editingReport with { Sections = [.._editingReport.Sections, result] };
            }
        }
        catch { _error = "Failed to add section."; }
        finally { _saving = false; }
    }

    private async Task RemoveSection(Guid sectionId)
    {
        if (_editingReport is null) return;
        await AdminClient.DeleteReportSectionAsync(OrgId, CaseId, _editingReport.Id, sectionId);
        _editingReport = _editingReport with { Sections = _editingReport.Sections.Where(s => s.Id != sectionId).ToList() };
    }

    private async Task RemoveSectionFile(Guid sectionId, Guid fileId)
    {
        if (_editingReport is null) return;
        await AdminClient.RemoveReportSectionFileAsync(OrgId, CaseId, _editingReport.Id, sectionId, fileId);
        var updatedSections = _editingReport.Sections.Select(s => s.Id != sectionId ? s
            : s with { Files = s.Files.Where(f => f.Id != fileId).ToList() }).ToList();
        _editingReport = _editingReport with { Sections = updatedSections };
    }

    private void UpdateSummaryList(CaseReportDetail r)
    {
        var idx = _reports.FindIndex(x => x.Id == r.Id);
        var summary = new CaseReportSummary(r.Id, r.CaseId, r.Title, r.Status, r.ExpectedDeliveryDate, r.PublishedAt, r.DateCreated);
        if (idx >= 0) _reports[idx] = summary;
        else _reports.Insert(0, summary);
    }

    private class ReportForm
    {
        public string    Title               { get; set; } = "";
        public string?   Summary             { get; set; }
        public string?   Conclusion          { get; set; }
        public DateTime? ExpectedDeliveryDate { get; set; }
    }

    private record SectionTypeOption(CaseReportSectionType Value, string Label);

    private async Task DownloadPdf(Guid reportId, string reportTitle)
    {
        var result = await AdminClient.DownloadCaseReportPdfAsync(OrgId, CaseId, reportId);
        if (result is null) return;
        var base64 = Convert.ToBase64String(result.Value.Data);
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, "application/pdf", result.Value.FileName);
    }
}
