@page "/organizations/{OrgId:guid}/cases"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<div class="container-fluid py-3" style="max-width:1000px;">
    @if (!EmbeddedMode)
    {
        <PageTitle>Cases — @(_orgName ?? "Organization")</PageTitle>
    }
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="mb-0">Cases</h3>
        <div class="d-flex gap-2">
            <TelerikButton Icon="@SvgIcon.Inbox"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           OnClick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/pending-requests"))">
                Pending Requests @(_pendingCount > 0 ? $"({_pendingCount})" : "")
            </TelerikButton>
            <TelerikButton Icon="@SvgIcon.Plus"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/new"))">
                New Case
            </TelerikButton>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_cases is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading cases…" />
    }
    else if (_cases.Count == 0)
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <p class="lead text-secondary mb-3">No cases yet.</p>
                <p class="text-secondary small">Cases are created when a client request is accepted, or proposed internally by a member.</p>
            </div>
        </div>
    }
    else
    {
        @* ── Filters ─────────────────────────────────────────────────────── *@
        <div class="d-flex gap-2 flex-wrap mb-3">
            @foreach (var status in _filterOptions)
            {
                var s = status;
                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@(_activeFilter == s ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline)"
                               ThemeColor="@(_activeFilter == s ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                               OnClick="@(() => _activeFilter = s)">
                    @(s is null ? "All" : s.Value.Label())
                    <span class="badge bg-white text-dark ms-1">
                        @(s is null ? _cases.Count : _cases.Count(c => c.Status == s))
                    </span>
                </TelerikButton>
            }
        </div>

        <div class="d-flex flex-column gap-2">
            @foreach (var c in FilteredCases)
            {
                var caseId = c.Id;
                <div class="card">
                    <div class="card-body d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @c.Status.BadgeClass()">@c.Status.Label()</span>
                                @if (c.IsPublic && c.Status != CaseStatus.Public) { <span class="badge bg-info text-dark">Public</span> }
                                <strong>@c.DisplayLabel</strong>
                            </div>
                            <div class="text-secondary small">
                                @c.City, @c.State ·
                                Opened @c.DateCaseOpened.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")
                                @if (c.DateCaseClosed.HasValue)
                                {
                                    <span> · Closed @c.DateCaseClosed.Value.ToViewerLocalTime(UserState).ToString("MMM d, yyyy")</span>
                                }
                            </div>
                            <div class="text-secondary small mt-1">
                                Manager:
                                @if (!string.IsNullOrEmpty(c.CaseManagerDisplayName))
                                {
                                    <strong>@c.CaseManagerDisplayName</strong>
                                }
                                else
                                {
                                    <em class="text-warning">Unassigned</em>
                                }
                            </div>
                        </div>
                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                       Icon="@SvgIcon.ArrowRight"
                                       OnClick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/{caseId}"))">
                            Open
                        </TelerikButton>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid OrgId        { get; set; }
    [Parameter] public bool EmbeddedMode  { get; set; }

    private List<CaseRecord>? _cases;
    private string? _orgName;
    private string? _error;
    private CaseStatus? _activeFilter;
    private int _pendingCount;

    private static readonly CaseStatus?[] _filterOptions =
        [null, CaseStatus.Proposed, CaseStatus.Accepted, CaseStatus.Active,
         CaseStatus.Summarized, CaseStatus.Public, CaseStatus.Haunted, CaseStatus.Closed];

    private IEnumerable<CaseRecord> FilteredCases =>
        _activeFilter is null ? _cases! : _cases!.Where(c => c.Status == _activeFilter);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        try
        {
            _cases = (await AdminClient.GetOrgCasesAsync(OrgId)).ToList();
            var org = await AdminClient.GetOrganizationAsync(OrgId);
            _orgName = org?.Name;
            // Deliberately quiet: this is the count on a "pending requests" badge. If it can't
            // be fetched the badge simply doesn't appear, which is the same thing the user sees
            // when there is nothing pending — and failing the whole case list over a decoration
            // would be worse than omitting it.
            try { _pendingCount = (await AdminClient.GetOrgPendingRequestsAsync(OrgId)).Count; } catch { }
        }
        catch { _error = "Failed to load cases."; }
        StateHasChanged();
    }

}
