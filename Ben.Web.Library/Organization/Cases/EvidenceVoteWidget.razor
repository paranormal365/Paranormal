@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@*
  Reusable evidence voting widget. Shows vote counts and allows authenticated users to vote.
  Admins/case managers see the full vote list; public sees counts only.
  Place anywhere an UploadFile is displayed as evidence.
*@

<div class="evidence-vote-widget border rounded p-2 d-flex flex-column gap-2" style="min-width:200px;">
    @if (_summary is null && _loading)
    {
        <span class="text-secondary small">Loading votes…</span>
    }
    else if (_summary is not null)
    {
        @* ── Vote counts ─────────────────────────────────────────────────── *@
        <div class="d-flex gap-3 align-items-center">
            <span class="text-success fw-semibold" title="Confirms">
                ✓ @_summary.ConfirmsCount
            </span>
            <span class="text-danger fw-semibold" title="Disputes">
                ✗ @_summary.DisputesCount
            </span>
            <span class="text-secondary fw-semibold" title="Inconclusive">
                ? @_summary.InconclusiveCount
            </span>
            <span class="text-secondary small">(@_summary.TotalVotes total)</span>
        </div>

        @* ── Vote buttons (authenticated users) ───────────────────────────── *@
        @if (UserState.IsAuthenticated)
        {
            <div class="d-flex gap-1 flex-wrap">
                @foreach (var vt in Enum.GetValues<EvidenceVoteType>())
                {
                    var v = vt;
                    var isActive = _summary.CurrentUserVote == v;
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@(isActive ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline)"
                                   ThemeColor="@VoteThemeColor(v)"
                                   OnClick="@(() => CastVote(v))"
                                   Enabled="@(!_isBusy)">
                        @VoteLabel(v)
                    </TelerikButton>
                }
                @if (_summary.CurrentUserVote.HasValue)
                {
                    <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   OnClick="RemoveVote"
                                   Enabled="@(!_isBusy)">
                        Remove
                    </TelerikButton>
                }
            </div>
        }
        else
        {
            <span class="text-secondary" style="font-size:0.75rem;">Sign in to vote</span>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid UploadFileId { get; set; }

    private EvidenceVoteSummary? _summary;
    private bool _loading = true;
    private bool _isBusy;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try { _summary = await AdminClient.GetEvidenceVoteSummaryAsync(UploadFileId); }
        catch { }
        _loading = false;
    }

    private async Task CastVote(EvidenceVoteType voteType)
    {
        _isBusy = true;
        try { _summary = await AdminClient.CastEvidenceVoteAsync(UploadFileId, voteType, null) ?? _summary; }
        catch { }
        finally { _isBusy = false; }
    }

    private async Task RemoveVote()
    {
        _isBusy = true;
        try
        {
            await AdminClient.RemoveEvidenceVoteAsync(UploadFileId);
            _summary = await AdminClient.GetEvidenceVoteSummaryAsync(UploadFileId);
        }
        catch { }
        finally { _isBusy = false; }
    }

    private static string VoteLabel(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "✓ Confirms",
        EvidenceVoteType.Disputes     => "✗ Disputes",
        EvidenceVoteType.Inconclusive => "? Inconclusive",
        _                             => v.ToString(),
    };

    private static string VoteThemeColor(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => ThemeConstants.Button.ThemeColor.Success,
        EvidenceVoteType.Disputes     => ThemeConstants.Button.ThemeColor.Error,
        EvidenceVoteType.Inconclusive => ThemeConstants.Button.ThemeColor.Base,
        _                             => ThemeConstants.Button.ThemeColor.Base,
    };
}
