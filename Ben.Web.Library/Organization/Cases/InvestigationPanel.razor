@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Library.Services
@using Ben.Web.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@* Embedded panel showing investigations for a case — used in CaseDetail.razor *@

<div>
    @* ── Date negotiation with client ─────────────────────────────────────────── *@
    <details class="mb-3">
        <summary class="fw-semibold small text-secondary" style="cursor:pointer;">
            <TelerikSvgIcon Icon="@SvgIcon.Calendar" /> Date Proposals to Client
        </summary>
        <div class="mt-2">
            <SchedulingProposalPanel OrgId="@OrgId" CaseId="@CaseId" />
        </div>
    </details>
    <hr class="my-2" />

    <div class="d-flex align-items-center justify-content-between mb-3">
        <span class="fw-semibold">Investigations (@(_investigations?.Count ?? 0))</span>
        <TelerikButton Icon="@SvgIcon.Plus"
                       Size="@ThemeConstants.Button.Size.Small"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       OnClick="OpenAdd">Schedule Investigation</TelerikButton>
    </div>

    @if (_error is not null) { <div class="alert alert-danger">@_error</div> }

    @if (_investigations is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading investigations…" />
    }
    else if (_investigations.Count == 0)
    {
        <p class="text-secondary">No investigations scheduled yet.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var inv in _investigations.OrderBy(i => i.ScheduledDateTime))
            {
                var i = inv;
                var attendeesOpen = _activeAttendeeInvId == i.Id;
                <div class="card">
                    <div class="card-body d-flex align-items-start justify-content-between gap-3">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <span class="badge @StatusBadge(i.Status)">@StatusLabel(i.Status)</span>
                                <strong>@i.Title</strong>
                            </div>
                            <div class="text-secondary small">
                                @i.ScheduledDateTime.ToViewerLocalTime(UserState).ToString("MMM d, yyyy h:mm tt")
                                @if (i.EndDateTime.HasValue)
                                { <span> – @i.EndDateTime.Value.ToViewerLocalTime(UserState).ToString("h:mm tt")</span> }
                                @if (!string.IsNullOrEmpty(i.Location))
                                { <span> · @i.Location</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(i.Description))
                            {
                                <div class="mt-1 text-secondary small">@i.Description</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(i.Notes))
                            {
                                <div class="mt-2 text-body-secondary" style="font-size:.85rem;">
                                    @((MarkupString)i.Notes)
                                </div>
                            }
                            <div class="mt-2">
                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                               FillMode="@(attendeesOpen ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline)"
                                               Icon="@SvgIcon.User"
                                               OnClick="@(() => ToggleAttendees(i))">
                                    Attendees (@i.AttendeeCount)
                                </TelerikButton>
                            </div>
                            @if (attendeesOpen)
                            {
                                <div class="mt-3 border rounded p-3 bg-body-secondary">
                                    @if (_attendeeBusy && !_attendeeCache.ContainsKey(i.Id))
                                    {
                                        <TelerikLoaderContainer Visible="true" Text="Loading…" />
                                    }
                                    else
                                    {
                                        var attendees = _attendeeCache.GetValueOrDefault(i.Id) ?? [];
                                        @if (attendees.Count == 0)
                                        {
                                            <p class="text-secondary small mb-2">No attendees yet.</p>
                                        }
                                        else
                                        {
                                            <table class="table table-sm mb-2">
                                                <thead>
                                                    <tr>
                                                        <th>Member</th>
                                                        <th>Role</th>
                                                        <th>RSVP</th>
                                                        <th class="text-center">Attended</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var att in attendees)
                                                    {
                                                        var a = att;
                                                        <tr>
                                                            <td class="align-middle small"><UserNameLink AppUserId="@a.AppUserId" DisplayName="@a.DisplayName" /></td>
                                                            <td class="align-middle small">
                                                                @if (_editRoleAttendeeId == a.Id)
                                                                {
                                                                    <TelerikTextBox @bind-Value="@_editRoleValue"
                                                                                    Width="120px"
                                                                                    @onblur="@(() => SaveRole(i, a))" />
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-secondary" @ondblclick="@(() => StartEditRole(a))">@(a.AssignedRole ?? "—")</span>
                                                                    <TelerikButton Size="@ThemeConstants.Button.Size.ExtraSmall"
                                                                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                                                   Icon="@SvgIcon.Pencil"
                                                                                   Title="Edit role"
                                                                                   OnClick="@(() => StartEditRole(a))" />
                                                                }
                                                            </td>
                                                            <td class="align-middle">
                                                                <span class="badge @RsvpBadge(a.Rsvp)" style="font-size:.7rem;">@RsvpLabel(a.Rsvp)</span>
                                                            </td>
                                                            <td class="text-center align-middle">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       checked="@(a.DidAttend == true)"
                                                                       @onchange="@(e => ToggleAttendance(i, a, (bool)e.Value!))" />
                                                            </td>
                                                            <td class="align-middle">
                                                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                                               Icon="@SvgIcon.X"
                                                                               OnClick="@(() => RemoveAttendee(i, a))" />
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        <div class="d-flex gap-2 align-items-end flex-wrap">
                                            <div>
                                                <label class="form-label mb-1" style="font-size:.8rem;">Add member</label>
                                                <TelerikDropDownList Data="@AvailableMembers(i.Id)"
                                                                     @bind-Value="@_newAttendeeUserId"
                                                                     TextField="@nameof(MemberOption.Label)"
                                                                     ValueField="@nameof(MemberOption.UserId)"
                                                                     DefaultText="— select —"
                                                                     Width="180px" />
                                            </div>
                                            <div>
                                                <label class="form-label mb-1" style="font-size:.8rem;">Role (optional)</label>
                                                <TelerikTextBox @bind-Value="@_newAttendeeRole"
                                                                Placeholder="Lead Investigator"
                                                                Width="160px" />
                                            </div>
                                            <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                           Icon="@SvgIcon.Plus"
                                                           OnClick="@(() => AddAttendee(i))"
                                                           Enabled="@(_newAttendeeUserId != Guid.Empty && !_attendeeBusy)">
                                                Add
                                            </TelerikButton>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                       Icon="@SvgIcon.Pencil"
                                       OnClick="@(() => OpenEdit(i))">Edit</TelerikButton>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Add / Edit dialog ─────────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showDialog"
               Title="@(_editInv is null ? "Schedule Investigation" : "Edit Investigation")"
               Width="580px">
    <DialogContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="@_form.Title" Width="100%"
                                Placeholder="Night Investigation #1" />
            </div>            <div class="col-12">
                <label class="form-label fw-semibold">Investigation Plan / Description</label>
                <TelerikTextArea @bind-Value="@_form.Description" Rows="3" Width="100%"
                                 Placeholder="What areas will be investigated? What equipment will be used?" />
            </div>            <div class="col-md-6">
                <label class="form-label fw-semibold">Scheduled Date & Time</label>
                <TelerikDateTimePicker @bind-Value="@_form.ScheduledDateTime" Width="100%" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">End Time (optional)</label>
                <TelerikDateTimePicker @bind-Value="@_form.EndDateTime" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Location within property (optional)</label>
                <TelerikTextBox @bind-Value="@_form.Location" Width="100%"
                                Placeholder="e.g. Basement, Attic" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Status</label>
                <TelerikDropDownList Data="@_statusOptions"
                                     @bind-Value="@_form.Status"
                                     TextField="@nameof(StatusOption.Label)"
                                     ValueField="@nameof(StatusOption.Value)"
                                     Width="100%" />
            </div>
            @if (_editInv is not null)
            {
                <div class="col-12">
                    <label class="form-label fw-semibold">Post-Investigation Notes</label>
                    <TelerikTextArea @bind-Value="@_form.Notes" Rows="4" Width="100%"
                                     Placeholder="Summary of findings…" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Evidence Due Date (optional)</label>
                    <TelerikDateTimePicker @bind-Value="@_form.EvidenceDueDate" Width="100%" />
                    <div class="form-text">After this date, no new evidence may be submitted for this investigation.</div>
                </div>
            }
        </div>
        @if (_dialogError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
        }
    </DialogContent>
    <DialogButtons>
        @if (_editInv is not null)
        {
            @if (_editInv.Status == InvestigationStatus.Scheduled)
            {
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                               Icon="@SvgIcon.Cancel"
                               OnClick="CancelInvestigation"
                               Enabled="@(!_isBusy)">Cancel Visit</TelerikButton>
            }
            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           Icon="@SvgIcon.Trash"
                           OnClick="DeleteInvestigation"
                           Enabled="@(!_isBusy)">Delete</TelerikButton>
        }
        <TelerikButton OnClick="@(() => _showDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Save"
                       OnClick="Save"
                       Enabled="@(!_isBusy && !string.IsNullOrWhiteSpace(_form.Title))">
            @(_isBusy ? "Saving…" : "Save")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    [Parameter] public Guid OrgId  { get; set; }
    [Parameter] public Guid CaseId { get; set; }

    private List<InvestigationRecord>? _investigations;
    private string? _error;
    private bool _isBusy;
    private bool _showDialog;
    private InvestigationRecord? _editInv;
    private string? _dialogError;
    private InvForm _form = new();

    // ── Attendee state ────────────────────────────────────────────────────────
    private Guid? _activeAttendeeInvId;
    private Dictionary<Guid, List<InvestigationAttendeeRecord>> _attendeeCache = [];
    private List<OrgMembershipItem> _orgMembers = [];
    private bool _attendeeBusy;
    private Guid _newAttendeeUserId;
    private string _newAttendeeRole = "";
    private Guid _editRoleAttendeeId;
    private string _editRoleValue = "";

    private static readonly List<StatusOption> _statusOptions = Enum
        .GetValues<InvestigationStatus>()
        .Select(s => new StatusOption(s, StatusLabel(s)))
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        var members = await AdminClient.GetOrganizationMembersAsync(OrgId);
        _orgMembers = members.ToList();
    }

    private async Task LoadAsync()
    {
        try { _investigations = (await AdminClient.GetInvestigationsAsync(OrgId, CaseId)).ToList(); }
        catch { _error = "Failed to load investigations."; }
    }

    private async Task ToggleAttendees(InvestigationRecord inv)
    {
        if (_activeAttendeeInvId == inv.Id) { _activeAttendeeInvId = null; return; }
        _activeAttendeeInvId = inv.Id;
        _newAttendeeUserId = Guid.Empty;
        _newAttendeeRole = "";
        if (!_attendeeCache.ContainsKey(inv.Id))
            await RefreshAttendeesAsync(inv.Id);
    }

    private async Task RefreshAttendeesAsync(Guid invId)
    {
        _attendeeBusy = true;
        try
        {
            var list = await AdminClient.GetInvestigationAttendeesAsync(OrgId, CaseId, invId);
            _attendeeCache[invId] = list.ToList();
        }
        catch { _error = "Failed to load attendees."; }
        finally { _attendeeBusy = false; }
    }

    private async Task AddAttendee(InvestigationRecord inv)
    {
        if (_newAttendeeUserId == Guid.Empty) return;
        _attendeeBusy = true;
        try
        {
            await AdminClient.AddInvestigationAttendeeAsync(OrgId, CaseId, inv.Id,
                new AddInvestigationAttendeeRequest(_newAttendeeUserId,
                    string.IsNullOrWhiteSpace(_newAttendeeRole) ? null : _newAttendeeRole.Trim()));
            _newAttendeeUserId = Guid.Empty;
            _newAttendeeRole = "";
            await RefreshAttendeesAsync(inv.Id);
            await LoadAsync();
        }
        catch { _error = "Failed to add attendee."; }
        finally { _attendeeBusy = false; }
    }

    private async Task RemoveAttendee(InvestigationRecord inv, InvestigationAttendeeRecord att)
    {
        _attendeeBusy = true;
        try
        {
            await AdminClient.RemoveInvestigationAttendeeAsync(OrgId, CaseId, inv.Id, att.Id);
            await RefreshAttendeesAsync(inv.Id);
            await LoadAsync();
        }
        catch { _error = "Failed to remove attendee."; }
        finally { _attendeeBusy = false; }
    }

    private async Task ToggleAttendance(InvestigationRecord inv, InvestigationAttendeeRecord att, bool didAttend)
    {
        _attendeeBusy = true;
        try
        {
            await AdminClient.UpdateInvestigationAttendanceAsync(OrgId, CaseId, inv.Id, att.Id, didAttend, att.AssignedRole);
            await RefreshAttendeesAsync(inv.Id);
        }
        catch { _error = "Failed to update attendance."; }
        finally { _attendeeBusy = false; }
    }

    private void StartEditRole(InvestigationAttendeeRecord att)
    {
        _editRoleAttendeeId = att.Id;
        _editRoleValue      = att.AssignedRole ?? "";
    }

    private async Task SaveRole(InvestigationRecord inv, InvestigationAttendeeRecord att)
    {
        if (_editRoleAttendeeId != att.Id) return;
        _editRoleAttendeeId = Guid.Empty;
        var newRole = string.IsNullOrWhiteSpace(_editRoleValue) ? null : _editRoleValue.Trim();
        if (newRole == att.AssignedRole) return;
        _attendeeBusy = true;
        try
        {
            await AdminClient.UpdateInvestigationAttendanceAsync(OrgId, CaseId, inv.Id, att.Id, att.DidAttend, newRole);
            await RefreshAttendeesAsync(inv.Id);
        }
        catch { _error = "Failed to update role."; }
        finally { _attendeeBusy = false; }
    }

    private List<MemberOption> AvailableMembers(Guid invId)
    {
        var added = _attendeeCache.GetValueOrDefault(invId)?.Select(a => a.AppUserId).ToHashSet() ?? [];
        return _orgMembers
            .Where(m => !added.Contains(m.AppUserId))
            .Select(m => new MemberOption(m.AppUserId, m.DisplayName ?? m.AppUserId.ToString()[..8]))
            .ToList();
    }

    private void OpenAdd()
    {
        _editInv = null;
        _form = new InvForm { ScheduledDateTime = UserState.NowInViewerTimeZone().AddDays(7) };
        _dialogError = null;
        _showDialog = true;
    }

    private void OpenEdit(InvestigationRecord inv)
    {
        _editInv = inv;
        _form = new InvForm
        {
            Title             = inv.Title,
            Description       = inv.Description ?? "",
            Location          = inv.Location ?? "",
            ScheduledDateTime = inv.ScheduledDateTime.ToViewerLocalTime(UserState),
            EndDateTime       = inv.EndDateTime?.ToViewerLocalTime(UserState),
            Status            = inv.Status,
            Notes             = inv.Notes ?? "",
            EvidenceDueDate   = inv.EvidenceDueDate?.ToViewerLocalTime(UserState),
        };
        _dialogError = null;
        _showDialog = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Title)) { _dialogError = "Title is required."; return; }
        _isBusy = true; _dialogError = null;
        try
        {
            var req = new UpsertInvestigationRequest(
                Title:             _form.Title.Trim(),
                Description:       string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
                Location:          string.IsNullOrWhiteSpace(_form.Location) ? null : _form.Location.Trim(),
                ScheduledDateTime: _form.ScheduledDateTime.ToUtcFromViewerLocal(UserState),
                EndDateTime:       _form.EndDateTime?.ToUtcFromViewerLocal(UserState),
                Status:            _form.Status,
                Notes:             string.IsNullOrWhiteSpace(_form.Notes) ? null : _form.Notes.Trim(),
                OrgCalendarEventId: null,
                EvidenceDueDate:   _form.EvidenceDueDate?.ToUtcFromViewerLocal(UserState));

            InvestigationRecord? result;
            if (_editInv is null)
                result = await AdminClient.CreateInvestigationAsync(OrgId, CaseId, req);
            else
                result = await AdminClient.UpdateInvestigationAsync(OrgId, CaseId, _editInv.Id, req);

            if (result is null) { _dialogError = "Save failed."; }
            else { _showDialog = false; await LoadAsync(); }
        }
        catch (Exception ex) { _dialogError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task CancelInvestigation()
    {
        if (_editInv is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.CancelInvestigationByOrgAsync(OrgId, CaseId, _editInv.Id);
            _showDialog = false;
            await LoadAsync();
        }
        catch (Exception ex) { _dialogError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task DeleteInvestigation()
    {
        if (_editInv is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.DeleteInvestigationAsync(OrgId, CaseId, _editInv.Id);
            _showDialog = false;
            await LoadAsync();
        }
        catch { _error = "Delete failed."; }
        finally { _isBusy = false; }
    }

    internal static string StatusLabel(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "Scheduled",
        InvestigationStatus.InProgress => "In Progress",
        InvestigationStatus.Completed  => "Completed",
        InvestigationStatus.Cancelled  => "Cancelled",
        _                              => s.ToString(),
    };

    private static string StatusBadge(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "bg-primary",
        InvestigationStatus.InProgress => "bg-warning text-dark",
        InvestigationStatus.Completed  => "bg-success",
        InvestigationStatus.Cancelled  => "bg-secondary",
        _                              => "bg-secondary",
    };

    private class InvForm
    {
        public string             Title             { get; set; } = "";
        public string             Description       { get; set; } = "";
        public string             Location          { get; set; } = "";
        public DateTime           ScheduledDateTime { get; set; } = DateTime.Now.AddDays(7);
        public DateTime?          EndDateTime       { get; set; }
        public InvestigationStatus Status           { get; set; } = InvestigationStatus.Scheduled;
        public string             Notes             { get; set; } = "";
        public DateTime?          EvidenceDueDate   { get; set; }
    }

    private record StatusOption(InvestigationStatus Value, string Label);
    private record MemberOption(Guid UserId, string Label);

    private static string RsvpLabel(RsvpStatus r) => r switch
    {
        RsvpStatus.Invited   => "Invited",
        RsvpStatus.Accepted  => "Will Attend",
        RsvpStatus.Declined  => "Cannot Attend",
        RsvpStatus.Tentative => "Tentative",
        _                    => r.ToString(),
    };

    private static string RsvpBadge(RsvpStatus r) => r switch
    {
        RsvpStatus.Accepted  => "bg-success",
        RsvpStatus.Declined  => "bg-danger",
        RsvpStatus.Tentative => "bg-warning text-dark",
        _                    => "bg-secondary",
    };
}
