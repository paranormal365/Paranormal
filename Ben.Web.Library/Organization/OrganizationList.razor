@page "/organizations"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>Organizations</PageTitle>

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Organizations</h3>
        </div>
        @if (UserState.IsSuperAdmin && !UserState.IsImpersonating)
        {
            <div class="col-auto">
                <TelerikButton Icon="@SvgIcon.Plus"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               OnClick="@(() => NavManager.NavigateTo("/organizations/create"))">
                    New Organization
                </TelerikButton>
            </div>
        }
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    @if (_orgs is null)
    {
        <TelerikLoaderContainer Visible="true" Text="Loading organizations…" />
    }
    else
    {
        <TelerikGrid Data="@_orgs"
                     TItem="OrganizationListItemResponse"
                     Pageable="true"
                     PageSize="25"
                     Sortable="true"
                     Class="org-list-grid">
            <GridColumns>
                <GridColumn Field="@nameof(OrganizationListItemResponse.Name)" Title="Name" />
                <GridColumn Field="@nameof(OrganizationListItemResponse.UrlName)" Title="URL Name" Width="180px" />
                <GridColumn Title="Applications" Width="120px">
                    <Template>
                        @{ var item = (OrganizationListItemResponse)context; }
                        @if (item.IsAcceptingApplications)
                        {
                            <span class="badge bg-success">Open</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(OrganizationListItemResponse.DateCreated)" Title="Created"
                            DisplayFormat="{0:MM/dd/yyyy}" Width="110px" />
                @if (UserState.IsSuperAdmin)
                {
                    <GridColumn Field="@nameof(OrganizationListItemResponse.MemberCount)" Title="Members" Width="90px" TextAlign="@ColumnTextAlign.Center" />
                    <GridColumn Field="@nameof(OrganizationListItemResponse.CaseCount)" Title="Cases" Width="80px" TextAlign="@ColumnTextAlign.Center" />
                    <GridColumn Field="@nameof(OrganizationListItemResponse.InvestigationCount)" Title="Investigations" Width="110px" TextAlign="@ColumnTextAlign.Center" />
                }
                <GridColumn Title="Actions" Width="110px">
                    <Template>
                        @{
                            var org = (OrganizationListItemResponse)context;
                        }
                        <TelerikDropDownButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                Size="@ThemeConstants.Button.Size.Small"
                                                OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}"))">
                            <DropDownButtonContent>
                                <TelerikSvgIcon Icon="@SvgIcon.Eye" /> View
                            </DropDownButtonContent>
                            <DropDownButtonItems>
                                <DropDownButtonItem Icon="@SvgIcon.GridLayout"
                                                     OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/cms"))">
                                    CMS
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.GridLayout"
                                                     OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/cases"))">
                                    Cases
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.Calendar"
                                                     OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/calendar"))">
                                    Calendar
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.Envelope"
                                                     OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/messages"))">
                                    Messages
                                </DropDownButtonItem>
                                @if (org.CanEdit)
                                {
                                    <DropDownButtonItem Icon="@SvgIcon.Gear"
                                                         OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/client-settings"))">
                                        Clients
                                    </DropDownButtonItem>
                                    <DropDownButtonItem Icon="@SvgIcon.Comment"
                                                         OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/membership-questions"))">
                                        Q&amp;A
                                    </DropDownButtonItem>
                                    <DropDownButtonItem Icon="@SvgIcon.Pencil"
                                                         OnClick="@(() => NavManager.NavigateTo($"/organizations/{org.Id}/edit"))">
                                        Edit
                                    </DropDownButtonItem>
                                }
                                @if (org.CanDelete)
                                {
                                    <DropDownButtonItem Icon="@SvgIcon.Trash"
                                                         OnClick="@(() => RequestDelete(org))">
                                        Delete
                                    </DropDownButtonItem>
                                }
                            </DropDownButtonItems>
                        </TelerikDropDownButton>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    }
</div>

@* ── Delete Confirmation ── *@
<TelerikDialog @bind-Visible="@_showDeleteDialog"
               Title="Delete Organization"
               Width="400px">
    <DialogContent>
        @if (_pendingDelete is not null)
        {
            <p>Permanently delete <strong>@_pendingDelete.Name</strong>?</p>
            <p class="text-secondary small mb-0">This cannot be undone. All associated data will be removed.</p>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton OnClick="CancelDelete">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                       OnClick="ConfirmDelete"
                       Enabled="@(!_isBusy)">
            @(_isBusy ? "Deleting…" : "Delete")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    private IReadOnlyList<OrganizationListItemResponse>? _orgs;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isBusy;
    private bool _showDeleteDialog;
    private OrganizationListItemResponse? _pendingDelete;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;
        await UserState.AuthReady;
        if (!UserState.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOrgs();
            StateHasChanged();
        }
    }

    private async Task LoadOrgs()
        => _orgs = await AdminClient.GetOrganizationsAsync();

    private void RequestDelete(OrganizationListItemResponse org)
    {
        _errorMessage     = null;
        _successMessage   = null;
        _pendingDelete    = org;
        _showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        _showDeleteDialog = false;
        _pendingDelete    = null;
    }

    private async Task ConfirmDelete()
    {
        if (_pendingDelete is null) return;
        _isBusy = true;

        var ok = await AdminClient.DeleteOrganizationAsync(_pendingDelete.Id);
        _isBusy           = false;
        _showDeleteDialog = false;

        if (ok)
        {
            _successMessage = $"'{_pendingDelete.Name}' deleted.";
            _pendingDelete  = null;
            await LoadOrgs();
        }
        else
        {
            _errorMessage  = $"Could not delete '{_pendingDelete?.Name}'. It may have active members or related data.";
            _pendingDelete = null;
        }
    }
}
