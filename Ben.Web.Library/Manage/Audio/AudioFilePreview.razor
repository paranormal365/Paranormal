@*
  AudioFilePreview.razor
  ──────────────────────
  Compact waveform player used in the Files tab of AdminUserDetail.

  • Fetches audio bytes on first render and shows an 80 px WaveSurfer waveform.
  • Shows a ▶ overlay when paused; clicking anywhere on the waveform toggles play/pause.
  • Right-clicking shows a TelerikContextMenu: Play, Pause, Rewind, Open Full View.
  • "Open Full View" opens a TelerikWindow with file info + full-featured WaveSurfer
    (Timeline, Hover, Zoom, Spectrogram, Regions, built-in controls).
*@

@namespace Ben.Web.Library.Manage.Audio
@inject IBenAdminClient AdminClient

@if (_loading)
{
    <div style="height:80px;display:flex;align-items:center;justify-content:center;">
        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
    </div>
}
else if (_source is null)
{
    <span class="badge bg-secondary text-truncate" style="max-width:120px;" title="@FileName">@FileName</span>
}
else
{
    @* ── Compact waveform — click to play/pause, right-click for menu ── *@
    <div id="@_wrapperId"
         style="position:relative;cursor:pointer;border-radius:4px;overflow:hidden;"
         @onclick="TogglePlayAsync"
         @oncontextmenu="ShowContextMenuAsync"
         @oncontextmenu:preventDefault="true"
         title="@(!_playing ? "Click to play" : "Click to pause")">

        @* Play icon overlay — shown when paused and waveform is ready *@
        @if (!_playing && _ready)
        {
            <div style="position:absolute;inset:0;display:flex;align-items:center;
                        justify-content:center;z-index:2;pointer-events:none;
                        background:rgba(0,0,0,.18);border-radius:4px;">
                <span style="font-size:1.6rem;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.7);">▶</span>
            </div>
        }

        <WaveSurferPlayer @ref="_player"
                          Config="@_compactConfig"
                          OnReady="@(() => { _ready = true; StateHasChanged(); })"
                          OnPlay="@(() => { _playing = true; StateHasChanged(); })"
                          OnPause="@(() => { _playing = false; StateHasChanged(); })"
                          OnFinish="@(() => { _playing = false; StateHasChanged(); })"
                          OnTimeUpdate="@(t => _currentTime = t)" />
    </div>
}

@* ── Context menu ────────────────────────────────────────────────────────── *@
<TelerikContextMenu @ref="_contextMenu"
                    Data="@_menuItems"
                    TextField="@nameof(AudioContextMenuItem.Text)"
                    OnClick="@(async (AudioContextMenuItem item) => await OnMenuClickAsync(item))">
</TelerikContextMenu>

@* ── Full-view window ────────────────────────────────────────────────────── *@
<TelerikWindow Visible="@_showModal"
               VisibleChanged="@OnModalVisibleChanged"
               Width="92vw"
               Height="92vh"
               Modal="true">
    <WindowTitle>@FileName</WindowTitle>
    <WindowActions>
        <WindowAction Name="Close" />
    </WindowActions>
    <WindowContent>
        @if (_showModal && _source is not null)
        {
            <div class="d-flex flex-column h-100" style="overflow:hidden;">

                @* Info bar *@
                <div class="d-flex flex-wrap gap-4 mb-2 p-2 rounded flex-shrink-0"
                     style="background:var(--kendo-color-surface,#f5f5f5);font-size:.875rem;">
                    <span><strong>Size:</strong>@(" ")@FormatSize(FileSize)</span>
                    <span><strong>Type:</strong>@(" ")@ContentType</span>
                    <span><strong>Duration:</strong>@(" ")@FormatTime(_modalDuration)</span>
                    <span><strong>Position:</strong>@(" ")@FormatTime(_modalTime)</span>
                    <span class="ms-auto d-flex align-items-center gap-2">
                        @* Timeline toggle *@
                        <TelerikButton ThemeColor="@(_timelineEnabled ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="ToggleTimelineAsync">
                            🕐 @(_timelineEnabled ? "Hide Timeline" : "Show Timeline")
                        </TelerikButton>
                        @* Clear user-drawn regions *@
                        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="ClearUserRegionsAsync">
                            🗑 Clear Regions
                        </TelerikButton>
                        @* Spectrogram toggle *@
                        <TelerikButton ThemeColor="@(_spectrogramEnabled ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="ToggleSpectrogramAsync">
                            📊 @(_spectrogramEnabled ? "Hide Spectrogram" : "Show Spectrogram")
                        </TelerikButton>
                        @* Spectrogram resolution — only shown when spectrogram is active *@
                        @if (_spectrogramEnabled)
                        {
                            <TelerikDropDownList Data="@_resolutionOptions"
                                                 Value="@_spectrogramFftSamples"
                                                 ValueChanged="@((int v) => _ = OnSpectrogramResolutionChangedAsync(v))"
                                                 TextField="@nameof(SpectrogramResolutionOption.Label)"
                                                 ValueField="@nameof(SpectrogramResolutionOption.Value)"
                                                 Width="155px"
                                                 Size="@ThemeConstants.DropDownList.Size.Small"
                                                 Enabled="@_modalReady" />
                            @* Colormap selector *@
                            <TelerikDropDownList Data="@_colormapOptions"
                                                 @bind-Value="_colormap"
                                                 TextField="Label" ValueField="Value"
                                                 Width="115px"
                                                 Size="@ThemeConstants.DropDownList.Size.Small"
                                                 Enabled="@_modalReady"
                                                 OnChange="@(()=>_ = OnColormapChangedAsync())" />
                            @* Mel-scale toggle *@
                            <TelerikButton ThemeColor="@(_melScale ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                                           Size="@ThemeConstants.Button.Size.Small"
                                           Enabled="@_modalReady"
                                           OnClick="ToggleMelScaleAsync">
                                🎵 Mel Scale
                            </TelerikButton>
                            @* Voice frequency band overlay *@
                            <TelerikButton ThemeColor="@(_showVoiceBand ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                                           Size="@ThemeConstants.Button.Size.Small"
                                           Enabled="@_modalReady"
                                           OnClick="ToggleVoiceBandAsync">
                                🗣 Voice Band
                            </TelerikButton>
                        }
                        @* Drag mode toggle: create region (default) vs. scrub the playhead *@
                        <TelerikButton Icon="@SvgIcon.Crop"
                                       ThemeColor="@(_regionDrawMode ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       Title="@(_regionDrawMode ? "Create Region" : "Scrub Playhead")"
                                       OnClick="ToggleDragModeAsync">
                        </TelerikButton>
                        @* EQ toggle *@
                        <TelerikButton ThemeColor="@(_showEq ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="@(() => _showEq = !_showEq)">
                            🎚 @(_showEq ? "Hide EQ" : "EQ / Filters")
                        </TelerikButton>
                        @* EVP Markers toggle *@
                        <TelerikButton ThemeColor="@(_showMarkers ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="@(() => _showMarkers = !_showMarkers)">
                            @* Counts confirmed findings only — dismissed candidates are kept solely
                               for re-scan deduping, and counting them would inflate this. *@
                            🎯 @(_showMarkers ? "Hide Markers" : $"EVP Markers ({ConfirmedMarkers.Count()})")
                        </TelerikButton>
                        @* Destructive edit toggle *@
                        <TelerikButton ThemeColor="@(_showEdit ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="@(() => _showEdit = !_showEdit)">
                            ✂ @(_showEdit ? "Hide Edit" : "Edit")
                        </TelerikButton>
                        @* Silence detection toggle *@
                        <TelerikButton ThemeColor="@(_silenceDetectionEnabled ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Enabled="@_modalReady"
                                       OnClick="ToggleSilenceDetectionAsync">
                            🤫 Silence
                        </TelerikButton>
                        @if (_silenceDetectionEnabled)
                        {
                            <TelerikNumericTextBox @bind-Value="_silenceThresholdDb" Min="-80" Max="-10" Width="90px"
                                                    OnChange="@(() => _ = ApplySilenceDetectionAsync())" />
                            <span class="small text-secondary">dB</span>
                        }
                        <span class="small text-secondary fst-italic">
                            @(_regionDrawMode
                                ? "Click & drag to mark a region — right-click to play, save, or edit"
                                : "Click & drag the waveform to scrub — audio plays while dragging")
                        </span>
                    </span>
                </div>

                @* EQ / Processing panel *@
                @if (_showEq && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex gap-3 flex-wrap">

                            @* 10-band EQ — horizontal sliders *@
                            <div class="flex-grow-1" style="min-width:320px;">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <strong class="small">Graphic EQ</strong>
                                    <TelerikButton Size="sm" FillMode="flat" OnClick="ResetEqAsync">Reset</TelerikButton>
                                </div>
                                @{ var bands = new[] { (0, "32"), (1, "64"), (2, "125"), (3, "250"), (4, "500"), (5, "1k"), (6, "2k"), (7, "4k"), (8, "8k"), (9, "16k") }; }
                                @foreach (var (idx, lbl) in bands)
                                {
                                    var b = idx;
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="text-muted" style="width:28px; text-align:right; font-size:0.7rem;">@lbl</span>
                                        <TelerikSlider Value="@_eqGains[b]" Min="-12" Max="12"
                                                       SmallStep="1" LargeStep="6"
                                                       ValueChanged="@((double v) => _ = OnEqGainChanged(b, v))" />
                                        <span class="text-muted small" style="width:28px;">@(_eqGains[b] > 0 ? "+" : "")@_eqGains[b].ToString("0.#")</span>
                                    </div>
                                }
                            </div>

                            @* HP / LP filters *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Filters</strong>
                                <div class="d-flex align-items-center gap-1">
                                    <TelerikCheckBox @bind-Value="_hpEnabled" OnChange="@(()=>_ = ApplyHighPassAsync())" />
                                    <span class="small">High-pass @_hpFreq Hz</span>
                                </div>
                                <TelerikSlider @bind-Value="_hpFreq" Min="20" Max="500" SmallStep="10" LargeStep="100"
                                               Enabled="@_hpEnabled" OnChange="@(()=>_ = ApplyHighPassAsync())" />
                                <div class="d-flex align-items-center gap-1 mt-2">
                                    <TelerikCheckBox @bind-Value="_lpEnabled" OnChange="@(()=>_ = ApplyLowPassAsync())" />
                                    <span class="small">Low-pass @_lpFreq Hz</span>
                                </div>
                                <TelerikSlider @bind-Value="_lpFreq" Min="1000" Max="20000" SmallStep="500" LargeStep="2000"
                                               Enabled="@_lpEnabled" OnChange="@(()=>_ = ApplyLowPassAsync())" />
                            </div>

                            @* Compressor *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <TelerikCheckBox @bind-Value="_compEnabled" OnChange="@(()=>_ = ApplyCompressorAsync())" />
                                    <strong class="small">Compressor</strong>
                                </div>
                                <span class="small text-muted">Threshold @_compThreshold dB</span>
                                <TelerikSlider @bind-Value="_compThreshold" Min="-60" Max="0" SmallStep="1" LargeStep="6"
                                               Enabled="@_compEnabled" OnChange="@(()=>_ = ApplyCompressorAsync())" />
                                <span class="small text-muted">Ratio @(_compRatio):1</span>
                                <TelerikSlider @bind-Value="_compRatio" Min="1" Max="20" SmallStep="1" LargeStep="5"
                                               Enabled="@_compEnabled" OnChange="@(()=>_ = ApplyCompressorAsync())" />
                            </div>

                            @* Noise Gate *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <TelerikCheckBox @bind-Value="_noiseGateEnabled" OnChange="@(()=>_ = ApplyNoiseGateAsync())" />
                                    <strong class="small">Noise Gate</strong>
                                </div>
                                <span class="small text-muted">Threshold @_noiseGateThreshold dB</span>
                                <TelerikSlider @bind-Value="_noiseGateThreshold" Min="-80" Max="0" SmallStep="1" LargeStep="10"
                                               Enabled="@_noiseGateEnabled" OnChange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Attack @_noiseGateAttack s</span>
                                <TelerikSlider @bind-Value="_noiseGateAttack" Min="0.001" Max="0.5" SmallStep="0.01" LargeStep="0.1"
                                               Enabled="@_noiseGateEnabled" OnChange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Release @_noiseGateRelease s</span>
                                <TelerikSlider @bind-Value="_noiseGateRelease" Min="0.01" Max="1" SmallStep="0.05" LargeStep="0.2"
                                               Enabled="@_noiseGateEnabled" OnChange="@(()=>_ = ApplyNoiseGateAsync())" />
                            </div>
                        </div>
                    </div>
                }

                @* EVP Markers panel *@
                @if (_showMarkers && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <strong class="small">EVP Markers</strong>
                            <TelerikButton Size="sm" ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                           OnClick="AddMarkerAtCurrentTimeAsync">
                                ➕ Add Marker at @FormatTime(_modalTime)
                            </TelerikButton>
                        </div>
                        @if (!ConfirmedMarkers.Any())
                        {
                            <div class="text-secondary small fst-italic">No markers yet — play the file and drop a marker where you hear something.</div>
                        }
                        else
                        {
                            @foreach (var marker in ConfirmedMarkers)
                            {
                                var m = marker;
                                <div class="d-flex align-items-center gap-2 mb-1 p-1 rounded" style="background:var(--kendo-color-surface,#f5f5f5);">
                                    <span class="badge" style="background:@MarkerColor(m);">@FormatMarkerRange(m)</span>
                                    <span class="fw-semibold">@m.Label</span>
                                    <span class="text-secondary small">@m.ConfidenceLevel</span>
                                    @if (m.IsAutoDetected && m.DetectionScore is { } confirmedScore)
                                    {
                                        <span class="badge bg-secondary" title="Signal score from the detector that first proposed this">@confirmedScore.ToString("0")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.Note))
                                    {
                                        <span class="text-secondary small text-truncate" style="max-width:200px;" title="@m.Note">@m.Note</span>
                                    }
                                    <span class="ms-auto d-flex gap-1">
                                        <TelerikButton Size="sm" FillMode="flat" Icon="@SvgIcon.Play"
                                                       OnClick="@(() => SeekToMarkerAsync(m))" />
                                        <TelerikButton Size="sm" FillMode="flat" Icon="@SvgIcon.Pencil"
                                                       OnClick="@(() => OpenEditMarkerDialog(m))" />
                                        <TelerikButton Size="sm" FillMode="flat" Icon="@SvgIcon.Trash"
                                                       OnClick="@(() => DeleteMarkerAsync(m))" />
                                    </span>
                                </div>
                            }
                        }

                        @* ── Detector ────────────────────────────────────────── *@
                        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 flex-wrap">
                            <span class="small fw-semibold">Detect</span>
                            <TelerikDropDownList Data="@_sensitivityOptions"
                                                 @bind-Value="_scanSensitivity"
                                                 Width="110px"
                                                 Enabled="@(!_scanning)" />
                            <TelerikButton Size="sm"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                           Enabled="@(!_scanning)"
                                           OnClick="RunScanAsync">
                                @(_scanning ? "Scanning…" : "Scan for EVP")
                            </TelerikButton>
                            @if (_scanMessage is not null)
                            {
                                <span class="small text-secondary">@_scanMessage</span>
                            }
                        </div>
                        <div class="small text-secondary mt-1">
                            @* Says plainly what the score is, so nobody reads it as "83% likely a voice". *@
                            Finds sounds that rise above the recording's own background noise, in the
                            frequency range speech occupies. Everything it finds needs listening to —
                            the score is how much a sound stood out, not how likely it is to be a voice.
                        </div>

                        @if (PendingCandidates.Any())
                        {
                            @* Candidates exist in the database the moment a scan runs, so say so
                               here rather than leaving amber regions on the waveform with nothing
                               in the panel explaining them. Reviewing them lands in phase E3. *@
                            <div class="mt-2 pt-2 border-top text-secondary small">
                                <span class="badge" style="background:rgba(245,158,11,0.75);">@PendingCandidates.Count()</span>
                                detected @(PendingCandidates.Count() == 1 ? "candidate" : "candidates")
                                awaiting review (shown in amber on the waveform).
                            </div>
                        }
                    </div>
                }

                @* Destructive edit panel *@
                @if (_showEdit && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Region</strong>
                                <span class="text-muted small">
                                    @(_lastDrawnRegion is null ? "Draw a region on the waveform first" : $"{FormatTime(_lastDrawnRegion.Start)}–{FormatTime(_lastDrawnRegion.End)}")
                                </span>
                                <div class="d-flex gap-1">
                                    <TelerikButton Size="sm" Enabled="@CanApplyEdit(requiresRegion: true)"
                                                   OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Cut))">✂ Cut</TelerikButton>
                                    <TelerikButton Size="sm" Enabled="@CanApplyEdit(requiresRegion: true)"
                                                   OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Silence))">🔇 Silence</TelerikButton>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Whole File</strong>
                                <div class="d-flex gap-1">
                                    <TelerikButton Size="sm" Enabled="@CanApplyEdit()"
                                                   OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Normalize))">📶 Normalize</TelerikButton>
                                    <TelerikButton Size="sm" Enabled="@CanApplyEdit()"
                                                   OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Reverse))">⏪ Reverse</TelerikButton>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Gain @(_editGainDb > 0 ? "+" : "")@_editGainDb dB</strong>
                                <TelerikSlider @bind-Value="_editGainDb" Min="-24" Max="24" SmallStep="1" LargeStep="6" />
                                <TelerikButton Size="sm" Enabled="@CanApplyEdit()"
                                               OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Gain))">Apply Gain</TelerikButton>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:200px;">
                                <strong class="small">Fade In / Out (seconds)</strong>
                                <div class="d-flex gap-1">
                                    <TelerikNumericTextBox @bind-Value="_editFadeIn" Min="0" Width="80px" />
                                    <TelerikNumericTextBox @bind-Value="_editFadeOut" Min="0" Width="80px" />
                                </div>
                                <TelerikButton Size="sm" Enabled="@CanApplyEdit()"
                                               OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Fade))">Apply Fade</TelerikButton>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Speed @_editSpeedRatio.ToString("0.0#")×</strong>
                                <TelerikSlider @bind-Value="_editSpeedRatio" Min="0.25" Max="4" SmallStep="0.05" LargeStep="0.5" />
                                <TelerikButton Size="sm" Enabled="@CanApplyEdit()"
                                               OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Speed))">Apply Speed</TelerikButton>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Pitch @(_editPitchSemitones > 0 ? "+" : "")@_editPitchSemitones st</strong>
                                <TelerikSlider @bind-Value="_editPitchSemitones" Min="-12" Max="12" SmallStep="1" LargeStep="4" />
                                <TelerikButton Size="sm" Enabled="@CanApplyEdit()"
                                               OnClick="@(() => ApplyAudioEditAsync(AudioEditOperation.Pitch))">Apply Pitch</TelerikButton>
                            </div>
                        </div>
                        @if (_editError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-1 small">@_editError</div>
                        }
                    </div>
                }

                @* Full WaveSurfer player *@
                <div class="flex-shrink-0">
                    <WaveSurferPlayer @ref="_modalPlayer"
                                      Config="@_fullConfig"
                                      Resizable="true"
                                      OnReady="@OnModalReadyAsync"
                                      OnTimeUpdate="@(t => { _modalTime = t; StateHasChanged(); })"
                                      OnFinish="@(() => { _modalTime = 0; StateHasChanged(); })"
                                      OnRegionContextMenu="@OnRegionRightClick"
                                      OnRegionCreated="@OnModalRegionCreated"
                                      OnRegionUpdated="@OnModalRegionUpdated"
                                      OnSpectrogramReady="@(() => StateHasChanged())"
                                      OnSpectrogramContextMenu="@OnSpectrogramContextMenuFired" />
                </div>

                @* Child clips section *@
                @if (_childClips.Any())
                {
                    <div class="mt-3 flex-shrink-0" style="overflow-y:auto;max-height:40vh;">
                        <h6 class="mb-2 text-secondary small fw-semibold text-uppercase letter-spacing-1">
                            Saved Clips (@_childClips.Count)
                        </h6>
                        @foreach (var clip in _childClips)
                        {
                            <div class="mb-2 p-2 rounded"
                                 style="background:var(--kendo-color-surface,#f5f5f5);">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-success bg-opacity-75 small">
                                        @FormatTime(clip.RegionStart ?? 0)–@FormatTime(clip.RegionEnd ?? 0)
                                    </span>
                                    <span class="small fw-semibold">
                                        @(string.IsNullOrWhiteSpace(clip.Description) ? clip.FileName : clip.Description)
                                    </span>
                                    <span class="small text-secondary ms-auto">
                                        @FormatSize(clip.FileSize)
                                    </span>
                                </div>
                                <AudioFilePreview FileId="@clip.Id"
                                                  FileName="@clip.FileName"
                                                  ContentType="@clip.ContentType"
                                                  FileSize="@clip.FileSize" />
                            </div>
                        }
                    </div>
                }

            </div>
        }
    </WindowContent>
</TelerikWindow>

@* ── Spectrogram context menu (right-click on spectrogram canvas) ───── *@
<TelerikContextMenu @ref="_spectrogramMenu"
                    Data="@_spectrogramMenuItems"
                    TextField="@nameof(SpectrogramMenuItem.Text)"
                    OnClick="@(async (SpectrogramMenuItem item) => await OnSpectrogramMenuClickAsync(item))">
</TelerikContextMenu>

@* ── Region context menu (right-click in full-view player) ───────────── *@
<TelerikContextMenu @ref="_regionMenu"
                    Data="@_regionMenuItems"
                    TextField="@nameof(RegionContextMenuItem.Text)"
                    OnClick="@(async (RegionContextMenuItem item) => await OnRegionMenuClickAsync(item))">
</TelerikContextMenu>

@* ── Region Explorer — playback + save-as-clip + notes for a drawn region ── *@
@if (_explorerRegion is not null)
{
    <WsRegionExplorer FileId="@FileId"
                      FileName="@FileName"
                      ContentType="@ContentType"
                      FileSize="@FileSize"
                      Region="@_explorerRegion"
                      @bind-Visible="@_showRegionExplorer"
                      OnClipSaved="@(async _ => await OverlayChildClipRegionsAsync())" />
}

@* ── Region label edit dialog ────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showEditLabelDialog" Title="Edit Region Label" Width="360px">
    <DialogContent>
        <label class="form-label fw-semibold">Label</label>
        <TelerikTextBox @bind-Value="@_editLabelText" Width="100%" />
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showEditLabelDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       OnClick="SaveRegionLabelAsync">Save</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── EVP marker add/edit dialog ─────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showMarkerDialog" Title="@(_editingMarker is null ? "Add EVP Marker" : "Edit EVP Marker")" Width="400px">
    <DialogContent>
        <div class="mb-2">
            <label class="form-label fw-semibold">Time</label>
            <div>
                @FormatTime(_markerTimeSeconds)
                @if (_markerIsSpan)
                {
                    <text> – @FormatTime(_markerEndSeconds) <span class="text-secondary">(@((_markerEndSeconds - _markerTimeSeconds).ToString("0.0"))s)</span></text>
                }
            </div>
            <label class="d-flex align-items-center gap-2 mt-1 small">
                <input type="checkbox" checked="@_markerIsSpan"
                       @onchange="@(e => ToggleMarkerSpan((bool?)e.Value ?? false))" />
                Mark a stretch of audio rather than an instant
            </label>
            @if (_markerIsSpan)
            {
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="small text-secondary">Ends at</span>
                    <TelerikNumericTextBox @bind-Value="@_markerEndSeconds"
                                           Min="0" Step="0.1" Format="N1" Width="110px" />
                    <span class="small text-secondary">s</span>
                </div>
            }
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold">Label</label>
            <TelerikTextBox @bind-Value="@_markerLabel" Width="100%" PlaceHolder="e.g. Whispered name?" />
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold">Confidence</label>
            <TelerikDropDownList Data="@_confidenceOptions"
                                 @bind-Value="_markerConfidence"
                                 Width="100%" />
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold">Note</label>
            <TelerikTextArea @bind-Value="@_markerNote" Rows="3" Width="100%" />
        </div>
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showMarkerDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Enabled="@(!string.IsNullOrWhiteSpace(_markerLabel))"
                       OnClick="SaveMarkerAsync">Save</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Save region as clip dialog ──────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showSaveClipDialog"
               Title="Create Audio File from Region"
               Width="460px">
    <DialogContent>
        @if (_newUserRegion is not null)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@FormatTime(_newUserRegion.Start)</strong>
                &ndash; <strong>@FormatTime(_newUserRegion.End)</strong>
                from <em>@FileName</em>. Output will be saved as WAV.
            </p>
        }
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Label / Description</label>
                <TelerikTextBox @bind-Value="@_saveClipLabel"
                                PlaceHolder="Optional — auto-generated if blank"
                                Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">File Type <span class="text-danger">*</span></label>
                <TelerikDropDownList Data="@_fileTypes"
                                     @bind-Value="@_saveClipTypeId"
                                     TextField="@nameof(UploadFileTypeRecord.Name)"
                                     ValueField="@nameof(UploadFileTypeRecord.Id)"
                                     DefaultText="— select —"
                                     Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <TelerikCheckBox @bind-Value="@_saveClipIsPublic" Id="clip-pub-afp" />
                <label for="clip-pub-afp" class="form-label mb-0">Public</label>
            </div>
        </div>
        @if (_saveClipError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0 py-2 small">@_saveClipError</div>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => { _showSaveClipDialog = false; _saveClipError = null; })">
            Cancel
        </TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       Icon="@SvgIcon.Save"
                       Enabled="@(!_isSavingClip && _saveClipTypeId != Guid.Empty)"
                       OnClick="SaveClipAsync">
            @(_isSavingClip ? "Saving…" : "Save as WAV")
        </TelerikButton>
    </DialogButtons>
</TelerikDialog>
@* ── Toast notifications ────────────────────────────────────────────── *@
<TelerikNotification @ref="_toast"
                     HorizontalPosition="@NotificationHorizontalPosition.Right"
                     VerticalPosition="@NotificationVerticalPosition.Top" />

@code {
    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter, EditorRequired] public Guid   FileId      { get; set; }
    [Parameter, EditorRequired] public string FileName    { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ContentType { get; set; } = string.Empty;
    [Parameter]                 public long   FileSize    { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private WsAudioSource? _source;
    private bool   _loading = true;
    private bool   _ready;
    private bool   _playing;
    private double _currentTime;
    private double _modalTime;
    private double _modalDuration;
    private bool   _showModal;
    private bool   _modalReady;
    private IReadOnlyList<UploadFileRecord> _childClips = [];

    /// <summary>true = drag creates a region (default); false = drag scrubs the playhead.</summary>
    private bool   _regionDrawMode = true;

    // ── Timeline + Spectrogram state ───────────────────────────────────

    private bool   _timelineEnabled  = true;
    private bool   _spectrogramEnabled;
    private bool   _spectrogramLabels = true;   // show frequency labels by default
    private int    _spectrogramFftSamples = 512;
    private TelerikContextMenu<SpectrogramMenuItem>? _spectrogramMenu;

    private static readonly List<SpectrogramMenuItem> _spectrogramMenuItems =
    [
        new("labels", "🔤  Toggle Labels"),
    ];

    private record SpectrogramResolutionOption(int Value, string Label);
    private static readonly List<SpectrogramResolutionOption> _resolutionOptions =
    [
        new(128,  "128 – Coarse"),
        new(256,  "256 – Low"),
        new(512,  "512 – Standard"),
        new(1024, "1024 – High"),
        new(2048, "2048 – Fine"),
        new(4096, "4096 – Ultra"),
    ];

    // ── Region creation workflow ──────────────────────────────────────────────

    /// <summary>IDs of regions added programmatically (overlays, focus regions) — not user-drawn.</summary>
    private readonly HashSet<string> _programmaticRegionIds = [];

    /// <summary>Region currently being acted on (set from right-click args when saving/clipping).</summary>
    private WsRegionData? _newUserRegion;

    private bool   _showSaveClipDialog;      // save-as-clip form
    private bool   _isSavingClip;
    private string? _saveClipError;
    private string  _saveClipLabel    = string.Empty;
    private Guid    _saveClipTypeId;
    private bool    _saveClipIsPublic;
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];

    private WaveSurferPlayer?                          _player;
    private WaveSurferPlayer?                          _modalPlayer;
    private TelerikContextMenu<AudioContextMenuItem>?  _contextMenu;
    private TelerikNotification?                       _toast;

    // ── Region context menu state ──────────────────────────────────────────────

    private TelerikContextMenu<RegionContextMenuItem>? _regionMenu;
    private WsRegionContextMenuArgs? _pendingRegion;
    private bool   _showEditLabelDialog;
    private string _editLabelText = string.Empty;

    private static readonly List<RegionContextMenuItem> _regionMenuItems =
    [
        new("play",    "▶  Play Region"),
        new("explore", "⤢  Explore Region (clip or add a note)"),
        new("save",    "🎵  Create Audio File from Region"),
        new("label",   "✏  Edit Label"),
        new("delete",  "🗑  Delete Region"),
    ];

    // ── Region Explorer (clip + notes) ──────────────────────────────────────────

    private bool         _showRegionExplorer;
    private WsRegionData? _explorerRegion;

    private readonly string _wrapperId = $"afp-{Guid.NewGuid():N}";

    // ── Context menu items ────────────────────────────────────────────────────

    private static readonly List<AudioContextMenuItem> _menuItems =
    [
        new("play",     "▶  Play"),
        new("pause",    "⏸  Pause"),
        new("rewind",   "⏮  Rewind"),
        new("fullview", "⤢  Open Full View"),
    ];

    // ── WsConfig objects ──────────────────────────────────────────────────────

    private WsConfig _compactConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Interact = false, Normalize = true },
        Plugins = new WsPluginConfig { Hover = true },
        InitialHeight = "80px",
        MinHeight     = "80px",
        MaxHeight     = "80px",
        ShowControls  = false,
    };

    private WsConfig _fullConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Normalize = true },
        Plugins = new WsPluginConfig
        {
            Hover               = true,
            Timeline            = true,
            Zoom                = true,
            Spectrogram         = false,   // built-in plugin disabled; toggle button uses custom canvas
            Regions             = true,
            RegionsDragToCreate = true,
        },
        InitialHeight = "280px",
        MinHeight     = "120px",
        MaxHeight     = "600px",
        ShowControls  = true,
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var result = await AdminClient.GetFileDataAsync(FileId);
            if (result is not null)
                _source = WsAudioSource.FromBytes(result.Value.Data, result.Value.ContentType);
        }
        catch { /* silently fail — component shows filename badge as fallback */ }

        _loading = false;
        StateHasChanged();
    }

    // ── Player event handlers ─────────────────────────────────────────────────

    private async Task OnModalReadyAsync()
    {
        _modalDuration = _modalPlayer?.Duration ?? 0;
        _modalReady    = true;
        StateHasChanged();

        // Re-apply the chosen drag mode — each modal open creates a fresh JS/WaveSurfer
        // instance that defaults back to region mode regardless of the prior selection.
        if (_modalPlayer is not null)
            await _modalPlayer.SetDragModeAsync(_regionDrawMode);

        try
        {
            _fileTypes = await AdminClient.GetPublicFileTypesAsync();
            if (_fileTypes.Any() && _saveClipTypeId == Guid.Empty)
                _saveClipTypeId = _fileTypes[0].Id;
        }
        catch { /* non-critical */ }

        await OverlayChildClipRegionsAsync();
        await OverlayMarkersAsync();

        // Init Web Audio processing chain after player is ready
        if (_modalPlayer is not null)
            await _modalPlayer.InitAudioProcessingAsync();
    }

    private async Task OverlayChildClipRegionsAsync()
    {
        if (_modalPlayer is null) return;
        try
        {
            _childClips = await AdminClient.GetChildClipsAsync(FileId);
            foreach (var clip in _childClips)
            {
                if (clip.RegionStart is null || clip.RegionEnd is null) continue;
                var id = clip.Id.ToString();
                _programmaticRegionIds.Add(id);  // mark as programmatic so it doesn't trigger the confirm dialog
                await _modalPlayer.AddRegionAsync(new WsRegionParams
                {
                    Id      = id,
                    Start   = clip.RegionStart.Value,
                    End     = clip.RegionEnd.Value,
                    Color   = "rgba(16,185,129,0.20)",
                    Drag    = false,
                    Resize  = false,
                    Content = clip.Description ?? clip.FileName,
                });
            }
            StateHasChanged();
        }
        catch { /* silently ignore */ }
    }

    // ── EVP markers ──────────────────────────────────────────────────────────

    /// <summary>Markers a person stands behind — what the marker list shows and edits.</summary>
    private IEnumerable<AudioMarkerRecord> ConfirmedMarkers =>
        _markers.Where(m => m.ReviewStatus == EvpReviewStatus.Confirmed).OrderBy(m => m.TimeSeconds);

    /// <summary>Detector proposals nobody has ruled on yet. Reviewed on the Candidates tab (phase E3).</summary>
    private IEnumerable<AudioMarkerRecord> PendingCandidates =>
        _markers.Where(m => m.ReviewStatus == EvpReviewStatus.Pending).OrderBy(m => m.TimeSeconds);

    private async Task OverlayMarkersAsync()
    {
        if (_modalPlayer is null) return;
        try
        {
            _markers = await AdminClient.GetAudioMarkersAsync(FileId);
            foreach (var marker in _markers)
                await AddMarkerRegionAsync(marker);
            StateHasChanged();
        }
        catch { /* silently ignore */ }
    }

    private async Task AddMarkerRegionAsync(AudioMarkerRecord marker)
    {
        if (_modalPlayer is null) return;

        // A dismissed candidate is kept in the database only so a re-scan can dedupe against it.
        // Drawing it would put rejected noise back on the waveform.
        if (marker.ReviewStatus == EvpReviewStatus.Dismissed) return;

        var id = $"marker-{marker.Id}";
        _programmaticRegionIds.Add(id);
        await _modalPlayer.AddRegionAsync(new WsRegionParams
        {
            Id      = id,
            Start   = marker.TimeSeconds,
            // Equal start and end is how this plugin draws a point marker. A span passes its real
            // end, so the region covers the audio the marker is actually a claim about.
            End     = marker.IsSpan ? marker.EndSeconds : marker.TimeSeconds,
            Color   = MarkerColor(marker),
            Drag    = false,
            Resize  = false,
            Content = MarkerRegionLabel(marker),
        });
    }

    /// <summary>
    /// Candidates are amber regardless of confidence — they carry the detector's default
    /// "Possible", which would otherwise render them identically to a human's least-certain
    /// finding, and those are very different things to see on a waveform.
    /// </summary>
    private static string MarkerColor(AudioMarkerRecord marker) =>
        marker.ReviewStatus == EvpReviewStatus.Pending
            ? "rgba(245,158,11,0.75)"
            : MarkerColor(marker.ConfidenceLevel);

    private static string MarkerColor(EvpConfidenceLevel level) => level switch
    {
        EvpConfidenceLevel.Confirmed => "rgba(16,185,129,0.85)",
        EvpConfidenceLevel.Probable  => "rgba(234,179,8,0.85)",
        _                            => "rgba(148,163,184,0.85)",
    };

    /// <summary>
    /// A candidate is labelled with its score alone. A scan can drop dozens of these onto one
    /// waveform, and repeating "Detected signal" on every band produced overlapping text that hid
    /// the waveform without telling the reader anything — they all say the same words. The number
    /// is the only part that differs, and the panel below carries the full description.
    /// </summary>
    private static string MarkerRegionLabel(AudioMarkerRecord marker) =>
        marker.ReviewStatus == EvpReviewStatus.Pending && marker.DetectionScore is { } score
            ? score.ToString("0")
            : marker.Label;

    /// <summary>"0:03" for a point, "0:03–0:04 (0.6s)" for a span.</summary>
    private static string FormatMarkerRange(AudioMarkerRecord marker) =>
        marker.IsSpan
            ? $"{FormatTime(marker.TimeSeconds)}–{FormatTime(marker.EndSeconds!.Value)} ({marker.EndSeconds!.Value - marker.TimeSeconds:0.0}s)"
            : FormatTime(marker.TimeSeconds);

    private async Task AddMarkerAtCurrentTimeAsync()
    {
        _editingMarker      = null;

        // If the user has a region drawn, they've already shown us the stretch they mean — start
        // from that rather than making them re-enter it as numbers.
        var drawn = _newUserRegion ?? _lastDrawnRegion;
        if (drawn is not null && drawn.End > drawn.Start)
        {
            _markerTimeSeconds = drawn.Start;
            _markerEndSeconds  = drawn.End;
            _markerIsSpan      = true;
        }
        else
        {
            _markerTimeSeconds = _modalTime;
            _markerEndSeconds  = _modalTime + DefaultSpanSeconds;
            _markerIsSpan      = false;
        }

        _markerLabel        = string.Empty;
        _markerConfidence   = EvpConfidenceLevel.Possible;
        _markerNote         = string.Empty;
        _showMarkerDialog   = true;
        await Task.CompletedTask;
    }

    private void OpenEditMarkerDialog(AudioMarkerRecord marker)
    {
        _editingMarker     = marker;
        _markerTimeSeconds = marker.TimeSeconds;
        _markerIsSpan      = marker.IsSpan;
        _markerEndSeconds  = marker.EndSeconds ?? marker.TimeSeconds + DefaultSpanSeconds;
        _markerLabel       = marker.Label;
        _markerConfidence  = marker.ConfidenceLevel;
        _markerNote        = marker.Note ?? string.Empty;
        _showMarkerDialog  = true;
    }

    /// <summary>How long a span starts out when the user asks for one without drawing a region.</summary>
    private const double DefaultSpanSeconds = 1.0;

    private void ToggleMarkerSpan(bool isSpan)
    {
        _markerIsSpan = isSpan;
        // Re-seed rather than leaving a stale end behind the checkbox — an end at or before the
        // start would be rejected by the API, and the user has no reason to expect that.
        if (isSpan && _markerEndSeconds <= _markerTimeSeconds)
            _markerEndSeconds = _markerTimeSeconds + DefaultSpanSeconds;
    }

    /// <summary>The end to persist: null unless the user asked for a span and it's actually one.</summary>
    private double? MarkerEndToSave =>
        _markerIsSpan && _markerEndSeconds > _markerTimeSeconds ? _markerEndSeconds : null;

    private async Task SaveMarkerAsync()
    {
        if (string.IsNullOrWhiteSpace(_markerLabel)) return;

        if (_editingMarker is null)
        {
            var created = await AdminClient.CreateAudioMarkerAsync(FileId, new CreateAudioMarkerRequest(
                _markerTimeSeconds, _markerLabel.Trim(), _markerConfidence,
                string.IsNullOrWhiteSpace(_markerNote) ? null : _markerNote.Trim(),
                MarkerEndToSave));
            if (created is not null)
            {
                _markers = [.. _markers, created];
                await AddMarkerRegionAsync(created);
            }
        }
        else
        {
            var updated = await AdminClient.UpdateAudioMarkerAsync(FileId, _editingMarker.Id, new UpdateAudioMarkerRequest(
                _markerTimeSeconds, _markerLabel.Trim(), _markerConfidence,
                string.IsNullOrWhiteSpace(_markerNote) ? null : _markerNote.Trim(),
                MarkerEndToSave));
            if (updated is not null && _modalPlayer is not null)
            {
                _markers = [.. _markers.Where(m => m.Id != updated.Id), updated];
                await _modalPlayer.RemoveRegionAsync($"marker-{updated.Id}");
                await AddMarkerRegionAsync(updated);
            }
        }

        _showMarkerDialog = false;
        StateHasChanged();
    }

    private async Task DeleteMarkerAsync(AudioMarkerRecord marker)
    {
        var ok = await AdminClient.DeleteAudioMarkerAsync(FileId, marker.Id);
        if (!ok) return;
        _markers = [.. _markers.Where(m => m.Id != marker.Id)];
        if (_modalPlayer is not null)
            await _modalPlayer.RemoveRegionAsync($"marker-{marker.Id}");
        StateHasChanged();
    }

    private async Task SeekToMarkerAsync(AudioMarkerRecord marker)
    {
        if (_modalPlayer is null || _modalDuration <= 0) return;
        await _modalPlayer.SeekToAsync(marker.TimeSeconds / _modalDuration);
    }

    // ── New region drawn by user ──────────────────────────────────────────────

    private async Task OnModalRegionCreated(WsRegionData r)
    {
        // Silently ignore programmatically added overlay regions.
        if (_programmaticRegionIds.Contains(r.Id)) return;

        // Only one user-drawn region is allowed at a time.
        // Remove every other user-drawn region, keeping the new one + saved overlays.
        if (_modalPlayer is not null)
            await _modalPlayer.ClearUserRegionsAsync(
                _programmaticRegionIds.Append(r.Id));

        _lastDrawnRegion = r;
    }

    /// <summary>
    /// Keeps the tracked bounds in step when the user drags or resizes the region they drew.
    /// Without this, <see cref="_lastDrawnRegion"/> held the bounds from the moment the region
    /// was first drawn, so a region-scoped Cut/Silence — and the region readout in the edit
    /// panel — silently used the original bounds rather than what was on screen.
    /// </summary>
    private void OnModalRegionUpdated(WsRegionData r)
    {
        if (_programmaticRegionIds.Contains(r.Id)) return;

        if (_lastDrawnRegion?.Id == r.Id) _lastDrawnRegion = r;
        if (_newUserRegion?.Id   == r.Id) _newUserRegion   = r;
        StateHasChanged();
    }

    private async Task SaveClipAsync()
    {
        if (_newUserRegion is null || _saveClipTypeId == Guid.Empty) return;

        _isSavingClip = true;
        _saveClipError = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.ClipAudioAsync(FileId, new ClipAudioRequest(
                _newUserRegion.Start, _newUserRegion.End,
                string.IsNullOrWhiteSpace(_saveClipLabel) ? null : _saveClipLabel.Trim(),
                _saveClipIsPublic, _saveClipTypeId));

            if (result is not null)
            {
                _showSaveClipDialog  = false;
                _saveClipLabel       = string.Empty;
                _saveClipError       = null;

                // Remove the user-drawn region — replaced by the persisted overlay
                if (_newUserRegion is not null && _modalPlayer is not null)
                    await _modalPlayer.RemoveRegionAsync(_newUserRegion.Id);
                _newUserRegion = null;

                // Refresh child clips and overlay the newly saved one
                await OverlayChildClipRegionsAsync();
                Notify($"Saved \"{result.FileName}\"", "success");
            }
            else
            {
                Notify("Save failed — only WAV and MP3 sources can be clipped.", "error");
                _saveClipError = "Only WAV and MP3 sources can be clipped.";
            }
        }
        catch (Exception ex)
        {
            _saveClipError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSavingClip = false;
        }
    }

    // ── Modal + explorer visibility handlers ──────────────────────────────────

    private void OnModalVisibleChanged(bool visible)
    {
        _showModal = visible;
        if (!visible)
        {
            _timelineEnabled    = true;
            _spectrogramEnabled = false;
            _spectrogramLabels  = false;
            _modalReady         = false;
            _showMarkers        = false;
            _showVoiceBand      = false;
            _silenceDetectionEnabled = false;
            _regionDrawMode     = true;
        }
    }

    // ── Waveform click → toggle play/pause ────────────────────────────────────

    private async Task TogglePlayAsync()
    {
        if (_player is null) return;
        await _player.PlayPauseAsync();
    }

    // ── Context menu ──────────────────────────────────────────────────────────

    private async Task ShowContextMenuAsync(MouseEventArgs e)
    {
        if (_contextMenu is null) return;
        await _contextMenu.ShowAsync(e.ClientX, e.ClientY);
    }

    private async Task OnMenuClickAsync(AudioContextMenuItem item)
    {
        switch (item.Action)
        {
            case "play":
                if (_player is not null) await _player.PlayAsync();
                break;
            case "pause":
                if (_player is not null) await _player.PauseAsync();
                break;
            case "rewind":
                if (_player is not null) await _player.StopAsync();
                _currentTime = 0;
                break;
            case "fullview":
                if (_playing && _player is not null)
                    await _player.PauseAsync();
                _modalTime  = 0;
                _modalDuration = 0;
                _showModal  = true;
                StateHasChanged();
                break;
        }
    }

    // ── Formatting helpers (delegated to AudioFormatUtils) ────────────────────

    private static string FormatTime(double seconds) => AudioFormatUtils.FormatTime(seconds);
    private static string FormatSize(long bytes)      => AudioFormatUtils.FormatSize(bytes);

    private void Notify(string message, string themeColor = "warning") =>
        _toast?.Show(new NotificationModel { Text = message, ThemeColor = themeColor, CloseAfter = 4000 });

    // ── Spectrogram toggle + context menu ─────────────────────────────────────

    private async Task ClearUserRegionsAsync()
    {
        if (_modalPlayer is null) return;
        await _modalPlayer.ClearUserRegionsAsync(_programmaticRegionIds);
    }

    private async Task ToggleTimelineAsync()
    {
        _timelineEnabled = !_timelineEnabled;
        if (_modalPlayer is null) return;
        await _modalPlayer.ToggleTimelineAsync(_timelineEnabled);
    }

    private async Task ToggleDragModeAsync()
    {
        _regionDrawMode = !_regionDrawMode;
        if (_modalPlayer is null) return;
        await _modalPlayer.SetDragModeAsync(_regionDrawMode);
    }

    private async Task ToggleSpectrogramAsync()
    {
        _spectrogramEnabled = !_spectrogramEnabled;
        if (_modalPlayer is null) return;
        await _modalPlayer.ToggleSpectrogramAsync(_spectrogramEnabled, _spectrogramLabels, _spectrogramFftSamples);
    }

    private async Task OnSpectrogramResolutionChangedAsync(int fftSamples)
    {
        _spectrogramFftSamples = fftSamples;
        if (_spectrogramEnabled && _modalPlayer is not null)
            await _modalPlayer.SetSpectrogramResolutionAsync(_spectrogramFftSamples, _spectrogramLabels);
    }

    private async Task OnSpectrogramContextMenuFired(WsPointArgs args)
    {
        if (_spectrogramMenu is not null)
            await _spectrogramMenu.ShowAsync(args.ClientX, args.ClientY);
    }

    private async Task OnSpectrogramMenuClickAsync(SpectrogramMenuItem item)
    {
        if (item.Action == "labels")
        {
            _spectrogramLabels = !_spectrogramLabels;
            if (_modalPlayer is not null)
                await _modalPlayer.UpdateSpectrogramLabelsAsync(_spectrogramLabels);
        }
    }

    // ── Region right-click (full-view modal player) ───────────────────────────

    private async Task OnRegionRightClick(WsRegionContextMenuArgs args)
    {
        _pendingRegion = args;
        if (_regionMenu is not null)
            await _regionMenu.ShowAsync(args.ClientX, args.ClientY);
    }

    private async Task OnRegionMenuClickAsync(RegionContextMenuItem item)
    {
        if (_pendingRegion is null) return;
        switch (item.Action)
        {
            case "play":
                if (_modalPlayer is not null) await _modalPlayer.PlayRegionAsync(_pendingRegion.RegionId);
                break;
            case "explore":
                _explorerRegion = new WsRegionData
                {
                    Id    = _pendingRegion.RegionId,
                    Start = _pendingRegion.Start,
                    End   = _pendingRegion.End,
                    Label = _pendingRegion.Label,
                };
                _showRegionExplorer = true;
                StateHasChanged();
                break;
            case "label":
                _editLabelText       = _pendingRegion.Label ?? string.Empty;
                _showEditLabelDialog = true;
                break;
            case "save":
                // Use the right-clicked region's current position for clipping
                _newUserRegion = new WsRegionData
                {
                    Id    = _pendingRegion.RegionId,
                    Start = _pendingRegion.Start,
                    End   = _pendingRegion.End,
                    Label = _pendingRegion.Label,
                };
                _showSaveClipDialog = true;
                StateHasChanged();
                break;
            case "delete":
                if (_modalPlayer is not null)
                {
                    await _modalPlayer.RemoveRegionAsync(_pendingRegion.RegionId);
                    if (_newUserRegion?.Id == _pendingRegion.RegionId)
                        _newUserRegion = null;
                    if (_lastDrawnRegion?.Id == _pendingRegion.RegionId)
                        _lastDrawnRegion = null;
                }
                break;
        }
    }

    private async Task SaveRegionLabelAsync()
    {
        if (_pendingRegion is null || _modalPlayer is null) return;
        await _modalPlayer.UpdateRegionLabelAsync(_pendingRegion.RegionId, _editLabelText);
        _pendingRegion = new WsRegionContextMenuArgs
        {
            RegionId = _pendingRegion.RegionId,
            Start    = _pendingRegion.Start,
            End      = _pendingRegion.End,
            Label    = _editLabelText,
            ClientX  = _pendingRegion.ClientX,
            ClientY  = _pendingRegion.ClientY,
        };
        _showEditLabelDialog = false;
    }

