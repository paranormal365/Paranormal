    // ── EVP detection ─────────────────────────────────────────────────────────

    private static readonly List<EvpSensitivity> _sensitivityOptions =
    [
        EvpSensitivity.Low, EvpSensitivity.Medium, EvpSensitivity.High,
    ];

    private EvpSensitivity _scanSensitivity = EvpSensitivity.Medium;
    private bool           _scanning;
    private string?        _scanMessage;

    private async Task RunScanAsync()
    {
        if (_scanning) return;
        _scanning    = true;
        _scanMessage = null;
        StateHasChanged();

        try
        {
            var candidates = await AdminClient.ScanAudioForEvpAsync(FileId, _scanSensitivity);

            // Reload everything rather than merging the response in: the scan replaces the previous
            // pending set server-side, so the local list is stale in ways the response alone
            // doesn't describe.
            await ClearMarkerRegionsAsync();
            await OverlayMarkersAsync();

            _scanMessage = candidates.Count switch
            {
                0 => "Nothing stood out from the background.",
                1 => "1 candidate to review.",
                _ => $"{candidates.Count} candidates to review.",
            };
        }
        catch
        {
            _scanMessage = "The scan failed. The file may not be readable audio.";
        }
        finally
        {
            _scanning = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Removes the marker regions currently drawn, so a re-scan doesn't leave the previous scan's
    /// candidates on the waveform as orphans with no row behind them.
    /// </summary>
    private async Task ClearMarkerRegionsAsync()
    {
        if (_modalPlayer is null) return;
        foreach (var marker in _markers)
        {
            var id = $"marker-{marker.Id}";
            await _modalPlayer.RemoveRegionAsync(id);
            _programmaticRegionIds.Remove(id);
        }
    }

    // ── Phase D: destructive edit state ─────────────────────────────────────────

    private bool          _showEdit;
    private bool          _isApplyingEdit;
    private string?       _editError;
    private WsRegionData? _lastDrawnRegion;
    private double        _editGainDb   = 0;
    private double        _editFadeIn   = 1;
    private double        _editFadeOut  = 1;
    private double        _editSpeedRatio     = 1.0;
    private double        _editPitchSemitones = 0;

    private bool CanApplyEdit(bool requiresRegion = false)
        => !_isApplyingEdit
           && _saveClipTypeId != Guid.Empty
           && (!requiresRegion || _lastDrawnRegion is not null);

    private async Task ApplyAudioEditAsync(AudioEditOperation operation)
    {
        if (!CanApplyEdit(requiresRegion: operation is AudioEditOperation.Cut or AudioEditOperation.Silence)) return;

        _isApplyingEdit = true;
        _editError = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.EditAudioAsync(FileId, new AudioEditRequest(
                operation,
                _lastDrawnRegion?.Start,
                _lastDrawnRegion?.End,
                operation == AudioEditOperation.Gain ? _editGainDb : null,
                operation == AudioEditOperation.Fade ? _editFadeIn : null,
                operation == AudioEditOperation.Fade ? _editFadeOut : null,
                null,
                _saveClipIsPublic,
                _saveClipTypeId,
                operation == AudioEditOperation.Speed ? _editSpeedRatio : null,
                operation == AudioEditOperation.Pitch ? _editPitchSemitones : null));

            if (result is not null)
            {
                await OverlayChildClipRegionsAsync();
                Notify($"Saved \"{result.FileName}\"", "success");
            }
            else
            {
                _editError = "Edit failed — only WAV and MP3 sources can be edited.";
            }
        }
        catch (Exception ex)
        {
            _editError = $"Error: {ex.Message}";
        }
        finally
        {
            _isApplyingEdit = false;
            StateHasChanged();
        }
    }

    private async Task OnEqGainChanged(int band, double db)
    {
        _eqGains[band] = db;
        if (_modalPlayer is not null) await _modalPlayer.SetEqBandAsync(band, db);
    }

    private async Task ResetEqAsync()
    {
        Array.Clear(_eqGains);
        if (_modalPlayer is not null) await _modalPlayer.SetAllEqBandsAsync(_eqGains);
    }

    private async Task ApplyHighPassAsync()
    {
        if (_modalPlayer is not null) await _modalPlayer.SetHighPassAsync(_hpFreq, _hpEnabled);
    }

    private async Task ApplyLowPassAsync()
    {
        if (_modalPlayer is not null) await _modalPlayer.SetLowPassAsync(_lpFreq, _lpEnabled);
    }

    private async Task ApplyCompressorAsync()
    {
        if (_modalPlayer is not null)
            await _modalPlayer.SetCompressorAsync(_compEnabled, _compThreshold, _compRatio, _compAttack, _compRelease);
    }

    private async Task OnColormapChangedAsync()
    {
        if (_modalPlayer is not null && _spectrogramEnabled)
            await _modalPlayer.SetSpectrogramColormapAsync(_colormap, _spectrogramLabels, _spectrogramFftSamples);
    }

    private async Task ToggleMelScaleAsync()
    {
        _melScale = !_melScale;
        if (_modalPlayer is not null && _spectrogramEnabled)
            await _modalPlayer.SetSpectrogramMelScaleAsync(_melScale);
    }

    private async Task ToggleVoiceBandAsync()
    {
        _showVoiceBand = !_showVoiceBand;
        if (_modalPlayer is not null && _spectrogramEnabled)
            await _modalPlayer.ToggleVoiceBandOverlayAsync(_showVoiceBand);
    }

    private async Task ToggleSilenceDetectionAsync()
    {
        _silenceDetectionEnabled = !_silenceDetectionEnabled;
        if (_modalPlayer is null) return;
        if (_silenceDetectionEnabled)
            await _modalPlayer.DetectSilenceAsync(_silenceThresholdDb);
        else
            await _modalPlayer.ClearSilenceDetectionAsync();
    }

    private async Task ApplySilenceDetectionAsync()
    {
        if (_modalPlayer is not null && _silenceDetectionEnabled)
            await _modalPlayer.DetectSilenceAsync(_silenceThresholdDb);
    }

    private async Task ApplyNoiseGateAsync()
    {
        if (_modalPlayer is not null)
            await _modalPlayer.SetNoiseGateAsync(_noiseGateEnabled, _noiseGateThreshold, _noiseGateAttack, _noiseGateRelease);
    }
