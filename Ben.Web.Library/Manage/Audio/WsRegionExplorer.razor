@*
  WsRegionExplorer.razor
  ──────────────────────
  Full-featured explorer window for a selected WaveSurfer region.

  • Loads the original audio and highlights the selected region.
  • Plays only the region on "Play Region" (using WaveSurfer Regions plugin).
  • Lets the user add overall or point-in-time notes (rich text via TelerikEditor).
  • Allows clipping the region to a new UploadFile (WAV / MP3 → WAV).
  • Right-clicking a sub-region inside the explorer opens another WsRegionExplorer.
*@

@namespace Ben.Web.Library.Manage.Audio
@using Telerik.Blazor.Components.Editor
@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState

<TelerikWindow @bind-Visible="@Visible"
               Width="96vw" Height="94vh"
               Modal="true">
    <WindowTitle>Region Explorer — @(string.IsNullOrWhiteSpace(Region?.Label) ? $"{FormatTime(Region?.Start ?? 0)} – {FormatTime(Region?.End ?? 0)}" : Region!.Label)</WindowTitle>
    <WindowActions>
        <WindowAction Name="Close" />
    </WindowActions>
    <WindowContent>
        @if (_loading)
        {
            <div class="d-flex align-items-center justify-content-center h-100">
                <span class="spinner-border text-primary" role="status"></span>
                <span class="ms-3">Loading audio…</span>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="alert alert-danger m-3">@_loadError</div>
        }
        else
        {
            <div class="d-flex gap-3 h-100" style="overflow:hidden;">

                @* ══ Left — player + controls ══════════════════════════════════ *@
                <div class="d-flex flex-column" style="flex:2.5;min-width:0;overflow:hidden;">

                    @* Info bar *@
                    <div class="d-flex flex-wrap gap-3 mb-2 p-2 rounded small"
                         style="background:var(--kendo-color-surface,#f5f5f5);flex:0 0 auto;">
                        <span><strong>Start:</strong> @FormatTime(Region!.Start)</span>
                        <span><strong>End:</strong> @FormatTime(Region!.End)</span>
                        <span><strong>Duration:</strong> @FormatTime(Region!.End - Region!.Start)</span>
                        <span><strong>File:</strong> @FileName</span>
                        @if (!string.IsNullOrWhiteSpace(Region!.Label))
                        {
                            <span><strong>Label:</strong> @Region!.Label</span>
                        }
                        <span class="ms-auto"><strong>Position:</strong> @FormatTime(_currentTime)</span>
                    </div>

                    @* WaveSurfer player *@
                    <div style="flex:1;min-height:0;">
                        @if (_source is not null)
                        {
                            <WaveSurferPlayer @ref="_player"
                                              Config="@BuildConfig()"
                                              OnReady="@OnPlayerReady"
                                              OnPlay="@(() => { _isPlaying = true; StateHasChanged(); })"
                                              OnPause="@(() => { _isPlaying = false; StateHasChanged(); })"
                                              OnFinish="@(() => { _isPlaying = false; StateHasChanged(); })"
                                              OnTimeUpdate="@(t => { _currentTime = t; StateHasChanged(); })"
                                              OnRegionContextMenu="@OnSubRegionContextMenu"
                                              Resizable="true" />
                        }
                    </div>

                    @* Speed + playback controls *@
                    <div class="d-flex align-items-center gap-3 mt-2 p-2 rounded"
                         style="background:var(--kendo-color-surface,#f5f5f5);flex:0 0 auto;flex-wrap:wrap;">

                        <TelerikButton Icon="@SvgIcon.Play"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                       Enabled="@(_ready)"
                                       OnClick="PlayRegionAsync">Play Region</TelerikButton>

                        <TelerikButton Icon="@(_isPlaying ? SvgIcon.Pause : SvgIcon.Play)"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Enabled="@(_ready)"
                                       OnClick="TogglePlayAsync">@(_isPlaying ? "Pause" : "Play/Pause")</TelerikButton>

                        <TelerikButton Icon="@SvgIcon.Stop"
                                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                                       Enabled="@(_ready)"
                                       OnClick="StopAsync">Stop</TelerikButton>

                        <label class="d-flex align-items-center gap-2 mb-0 small">
                            <strong>Speed</strong>
                            <input type="range" class="form-range" style="width:7rem;"
                                   min="0.25" max="3" step="0.05"
                                   value="@_playbackRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                   @oninput="OnSpeedInput" />
                            <span style="min-width:2.5rem;">@_playbackRate.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)×</span>
                        </label>
                    </div>

                    @* ── Save / clip section ──────────────────────────────── *@
                    <div class="mt-3 p-2 rounded border" style="flex:0 0 auto;">
                        <h6 class="mb-2">Save Region as New File</h6>
                        @if (_clipSuccess is not null)
                        {
                            <div class="alert alert-success py-1 px-2 small mb-2">@_clipSuccess</div>
                        }
                        @if (_clipError is not null)
                        {
                            <div class="alert alert-danger py-1 px-2 small mb-2">@_clipError</div>
                        }
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label form-label-sm mb-1">File name / label</label>
                                <TelerikTextBox @bind-Value="@_clipLabel" PlaceHolder="Optional — auto-generated if blank" Width="100%" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label form-label-sm mb-1">File type</label>
                                <TelerikDropDownList Data="@_fileTypes"
                                                     @bind-Value="@_clipFileTypeId"
                                                     TextField="@nameof(UploadFileTypeRecord.Name)"
                                                     ValueField="@nameof(UploadFileTypeRecord.Id)"
                                                     DefaultText="— select —"
                                                     Width="100%" />
                            </div>
                            <div class="col-auto d-flex align-items-center gap-2">
                                <TelerikCheckBox @bind-Value="@_clipIsPublic" Id="clip-pub" />
                                <label for="clip-pub" class="form-label form-label-sm mb-0">Public</label>
                            </div>
                            <div class="col-auto">
                                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Success"
                                               Icon="@SvgIcon.Save"
                                               Enabled="@(!_isClipping && _clipFileTypeId != Guid.Empty)"
                                               OnClick="SaveClipAsync">
                                    @(_isClipping ? "Saving…" : "Save as WAV")
                                </TelerikButton>
                            </div>
                        </div>
                    </div>
                </div>

                @* ══ Right — notes panel ═══════════════════════════════════════ *@
                <div class="d-flex flex-column" style="flex:1;min-width:280px;max-width:400px;overflow:hidden;">
                    <h5 class="mb-2" style="flex:0 0 auto;">Region Notes</h5>

                    @* Notes list (scrollable) *@
                    <div style="flex:1;overflow-y:auto;min-height:0;">
                        @if (_loadingNotes)
                        {
                            <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                        }
                        else if (!_notes.Any())
                        {
                            <p class="text-secondary small">No notes yet. Add one below.</p>
                        }
                        else
                        {
                            @foreach (var note in _notes)
                            {
                                <div class="card mb-2" style="font-size:.875rem;">
                                    <div class="card-header py-1 px-2 d-flex align-items-center justify-content-between">
                                        <span>
                                            @if (note.TimeOffset.HasValue)
                                            {
                                                <span class="badge bg-primary me-1" title="Point-in-time note">
                                                    ⏱ @FormatTime(note.TimeOffset.Value)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary me-1">Region</span>
                                            }
                                            @note.DateCreated.ToString("yyyy-MM-dd HH:mm")
                                            @if (note.IsPublic)
                                            {
                                                <span class="badge bg-info ms-1">Public</span>
                                            }
                                        </span>
                                        <span class="d-flex gap-1">
                                            @if (_editNoteId == note.Id)
                                            {
                                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                               OnClick="@(() => SaveEditAsync(note))">Save</TelerikButton>
                                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                               FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                               OnClick="CancelEdit">Cancel</TelerikButton>
                                            }
                                            else
                                            {
                                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                               Icon="@SvgIcon.Pencil"
                                                               FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                               OnClick="@(() => StartEdit(note))"></TelerikButton>
                                                <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                                                               Icon="@SvgIcon.Trash"
                                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                               FillMode="@ThemeConstants.Button.FillMode.Outline"
                                                               OnClick="@(() => DeleteNoteAsync(note.Id))"></TelerikButton>
                                            }
                                        </span>
                                    </div>
                                    <div class="card-body py-1 px-2">
                                        @if (_editNoteId == note.Id)
                                        {
                                            <TelerikEditor @bind-Value="@_editNoteHtml" Height="140px" Tools="@_noteEditorTools" />
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <TelerikCheckBox @bind-Value="@_editNotePublic" Id="@($"enp-{note.Id}")" />
                                                <label for="@($"enp-{note.Id}")" class="form-label form-label-sm mb-0">Public</label>
                                                @if (note.TimeOffset.HasValue)
                                                {
                                                    <span class="text-secondary small ms-2">⏱ @FormatTime(_editTimeOffset ?? note.TimeOffset ?? 0)</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            @((MarkupString)(note.NoteHtml ?? string.Empty))
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @* Add note form *@
                    <div class="border rounded p-2 mt-2" style="flex:0 0 auto;">
                        <h6 class="mb-2">Add Note</h6>
                        @if (_noteError is not null)
                        {
                            <div class="alert alert-danger py-1 px-2 small mb-2">@_noteError</div>
                        }
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <TelerikCheckBox @bind-Value="@_isPointInTime" Id="pit-note" />
                            <label for="pit-note" class="form-label form-label-sm mb-0">
                                Attach to current position (@FormatTime(_currentTime))
                            </label>
                        </div>
                        <TelerikEditor @bind-Value="@_noteHtml" Height="120px" Tools="@_noteEditorTools" />
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <TelerikCheckBox @bind-Value="@_noteIsPublic" Id="note-pub" />
                            <label for="note-pub" class="form-label form-label-sm mb-0">Public</label>
                            <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                           Icon="@SvgIcon.Plus"
                                           Enabled="@(!_addingNote)"
                                           OnClick="AddNoteAsync"
                                           class="ms-auto">
                                @(_addingNote ? "Adding…" : "Add Note")
                            </TelerikButton>
                        </div>
                    </div>
                </div>
            </div>
        }
    </WindowContent>
</TelerikWindow>

@* ── Sub-region context menu (right-click inside explorer's own player) ── *@
<TelerikContextMenu @ref="_subRegionMenu"
                    Data="@_subMenuItems"
                    TextField="@nameof(RegionMenuItem.Text)"
                    OnClick="@(async (RegionMenuItem item) => await OnSubMenuClickAsync(item))">
</TelerikContextMenu>

@* ── Edit label dialog ──────────────────────────────────────────────────── *@
<TelerikDialog @bind-Visible="@_showEditLabelDialog" Title="Edit Region Label" Width="360px">
    <DialogContent>
        <label class="form-label fw-semibold">Label</label>
        <TelerikTextBox @bind-Value="@_editLabelText" Width="100%" />
    </DialogContent>
    <DialogButtons>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showEditLabelDialog = false)">Cancel</TelerikButton>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                       OnClick="SaveRegionLabelAsync">Save</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@* ── Nested region explorer ─────────────────────────────────────────────── *@
@if (_subRegion is not null)
{
    <WsRegionExplorer FileId="@FileId"
                      FileName="@FileName"
                      ContentType="@ContentType"
                      FileSize="@FileSize"
                      Region="@_subRegion"
                      @bind-Visible="@_showSubExplorer" />
}

@code {
    // ── Editor toolbar — Bold / Italic / Underline / Ordered list / Unordered list ──

    private static readonly List<IEditorTool> _noteEditorTools = new()
    {
        new EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.Bold(),
            new Telerik.Blazor.Components.Editor.Italic(),
            new Telerik.Blazor.Components.Editor.Underline()),
        new EditorButtonGroup(
            new UnorderedList(),
            new OrderedList()),
    };

    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter, EditorRequired] public Guid         FileId      { get; set; }
    [Parameter, EditorRequired] public string       FileName    { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string       ContentType { get; set; } = string.Empty;
    [Parameter]                 public long         FileSize    { get; set; }
    [Parameter, EditorRequired] public WsRegionData? Region     { get; set; }

    [Parameter] public bool              Visible        { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>Fired after a new clip file is saved so the parent can refresh its clip overlay.</summary>
    [Parameter] public EventCallback<UploadFileRecord> OnClipSaved { get; set; }

    // ── Player state ──────────────────────────────────────────────────────────

    private WsAudioSource?  _source;
    private bool            _loading = true;
    private string?         _loadError;
    private WaveSurferPlayer? _player;
    private bool            _ready;
    private bool            _isPlaying;
    private double          _currentTime;
    private double          _playbackRate = 1.0;
    private string?         _focusRegionId;   // ID of the locked region representing the selected bounds

    // ── Clip state ────────────────────────────────────────────────────────────

    private bool   _isClipping;
    private string? _clipError;
    private string? _clipSuccess;
    private string  _clipLabel      = string.Empty;
    private bool    _clipIsPublic;
    private Guid    _clipFileTypeId;
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];

    // ── Notes state ───────────────────────────────────────────────────────────

    private IReadOnlyList<UploadFileRegionNoteRecord> _notes = [];
    private bool   _loadingNotes;
    private string? _noteError;
    private bool   _isPointInTime;
    private string _noteHtml     = string.Empty;
    private bool   _noteIsPublic;
    private bool   _addingNote;

    // Edit note state
    private Guid?   _editNoteId;
    private string  _editNoteHtml    = string.Empty;
    private bool    _editNotePublic;
    private double? _editTimeOffset;

    // ── Sub-region context menu state ─────────────────────────────────────────

    private TelerikContextMenu<RegionMenuItem>? _subRegionMenu;
    private WsRegionContextMenuArgs?            _pendingSubRegion;
    private bool                                _showEditLabelDialog;
    private string                              _editLabelText = string.Empty;
    private WsRegionData?                       _subRegion;
    private bool                                _showSubExplorer;

    private static readonly List<RegionMenuItem> _subMenuItems =
    [
        new("play",    "▶  Play Region"),
        new("explore", "⤢  Explore Region"),
        new("label",   "✏  Edit Label"),
        new("delete",  "🗑  Delete Region"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible || _source is not null) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var fileTask  = AdminClient.GetFileDataAsync(FileId);
            var typesTask = AdminClient.GetPublicFileTypesAsync();
            var notesTask = AdminClient.GetRegionNotesAsync(FileId);

            await Task.WhenAll(fileTask, typesTask, notesTask);

            var fileData = fileTask.Result;
            if (fileData is not null)
                _source = WsAudioSource.FromBytes(fileData.Value.Data, fileData.Value.ContentType);
            else
                _loadError = "Could not load audio data.";

            _fileTypes = typesTask.Result;
            _notes     = notesTask.Result;

            if (_fileTypes.Any())
                _clipFileTypeId = _fileTypes[0].Id;
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
        }

        _loading = false;
    }

    private async Task ReloadNotesAsync()
    {
        _loadingNotes = true;
        try { _notes = await AdminClient.GetRegionNotesAsync(FileId); }
        catch { /* silently ignore */ }
        _loadingNotes = false;
    }

    // ── Player ready — add locked region overlay ──────────────────────────────

    private async Task OnPlayerReady()
    {
        _ready = true;
        if (Region is not null && _player is not null)
        {
            var regionId = await _player.AddRegionAsync(new WsRegionParams
            {
                Id      = "focus-region",
                Start   = Region.Start,
                End     = Region.End,
                Color   = "rgba(59,130,246,0.18)",
                Drag    = false,
                Resize  = false,
                Content = Region.Label,
            });
            _focusRegionId = regionId;
        }
        StateHasChanged();
    }

    // ── Playback ──────────────────────────────────────────────────────────────

    private async Task PlayRegionAsync()
    {
        if (_player is null || _focusRegionId is null) return;
        await _player.PlayRegionAsync(_focusRegionId);
    }

    private async Task TogglePlayAsync()
    {
        if (_player is not null) await _player.PlayPauseAsync();
    }

    private async Task StopAsync()
    {
        if (_player is not null) await _player.StopAsync();
    }

    private async Task OnSpeedInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var rate))
        {
            _playbackRate = Math.Clamp(rate, 0.25, 3.0);
            if (_player is not null) await _player.SetPlaybackRateAsync(_playbackRate);
        }
    }

    // ── Clip / Save ───────────────────────────────────────────────────────────

    private async Task SaveClipAsync()
    {
        if (Region is null || _clipFileTypeId == Guid.Empty) return;

        _isClipping  = true;
        _clipError   = null;
        _clipSuccess = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.ClipAudioAsync(FileId, new ClipAudioRequest(
                Region.Start, Region.End, _clipLabel.Trim().Length > 0 ? _clipLabel.Trim() : null,
                _clipIsPublic, _clipFileTypeId));

            if (result is not null)
            {
                _clipSuccess = $"Saved as \"{result.FileName}\" ({FormatSize(result.FileSize)}).";
                await OnClipSaved.InvokeAsync(result);
            }
            else
                _clipError = "Clip failed. WAV and MP3 sources are supported.";
        }
        catch (Exception ex)
        {
            _clipError = $"Error: {ex.Message}";
        }
        finally
        {
            _isClipping = false;
        }
    }

    // ── Notes ─────────────────────────────────────────────────────────────────

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_noteHtml) || Region is null) return;

        _addingNote = true;
        _noteError  = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.CreateRegionNoteAsync(FileId, new CreateRegionNoteRequest(
                RegionStart: Region.Start,
                RegionEnd:   Region.End,
                RegionLabel: Region.Label,
                TimeOffset:  _isPointInTime ? _currentTime : null,
                NoteHtml:    _noteHtml,
                IsPublic:    _noteIsPublic));

            if (result is not null)
            {
                _noteHtml      = string.Empty;
                _isPointInTime = false;
                _noteIsPublic  = false;
                await ReloadNotesAsync();
            }
            else
            {
                _noteError = "Failed to save note.";
            }
        }
        catch (Exception ex)
        {
            _noteError = $"Error: {ex.Message}";
        }
        finally
        {
            _addingNote = false;
        }
    }

    private void StartEdit(UploadFileRegionNoteRecord note)
    {
        _editNoteId     = note.Id;
        _editNoteHtml   = note.NoteHtml;
        _editNotePublic = note.IsPublic;
        _editTimeOffset = note.TimeOffset;
    }

    private void CancelEdit()
    {
        _editNoteId = null;
    }

    private async Task SaveEditAsync(UploadFileRegionNoteRecord note)
    {
        if (_editNoteId is null) return;
        try
        {
            var result = await AdminClient.UpdateRegionNoteAsync(FileId, _editNoteId.Value,
                new UpdateRegionNoteRequest(_editTimeOffset, _editNoteHtml, _editNotePublic));
            if (result is not null) { _editNoteId = null; await ReloadNotesAsync(); }
        }
        catch { /* silently ignore */ }
    }

    private async Task DeleteNoteAsync(Guid noteId)
    {
        try
        {
            if (await AdminClient.DeleteRegionNoteAsync(FileId, noteId))
                await ReloadNotesAsync();
        }
        catch { /* silently ignore */ }
    }

    // ── Sub-region context menu ───────────────────────────────────────────────

    private async Task OnSubRegionContextMenu(WsRegionContextMenuArgs args)
    {
        if (args.RegionId == _focusRegionId) return; // skip the locked focus overlay
        _pendingSubRegion = args;
        if (_subRegionMenu is not null)
            await _subRegionMenu.ShowAsync(args.ClientX, args.ClientY);
    }

    private async Task OnSubMenuClickAsync(RegionMenuItem item)
    {
        if (_pendingSubRegion is null) return;
        switch (item.Action)
        {
            case "play":
                if (_player is not null) await _player.PlayRegionAsync(_pendingSubRegion.RegionId);
                break;
            case "explore":
                _subRegion = new WsRegionData
                {
                    Id    = _pendingSubRegion.RegionId,
                    Start = _pendingSubRegion.Start,
                    End   = _pendingSubRegion.End,
                    Label = _pendingSubRegion.Label,
                };
                _showSubExplorer = true;
                StateHasChanged();
                break;
            case "label":
                _editLabelText       = _pendingSubRegion.Label ?? string.Empty;
                _showEditLabelDialog = true;
                break;
            case "delete":
                if (_player is not null) await _player.RemoveRegionAsync(_pendingSubRegion.RegionId);
                break;
        }
    }

    private async Task SaveRegionLabelAsync()
    {
        if (_pendingSubRegion is null || _player is null) return;
        await _player.UpdateRegionLabelAsync(_pendingSubRegion.RegionId, _editLabelText);
        _pendingSubRegion = new WsRegionContextMenuArgs
        {
            RegionId = _pendingSubRegion.RegionId,
            Start    = _pendingSubRegion.Start,
            End      = _pendingSubRegion.End,
            Label    = _editLabelText,
            ClientX  = _pendingSubRegion.ClientX,
            ClientY  = _pendingSubRegion.ClientY,
        };
        _showEditLabelDialog = false;
    }

    // ── WsConfig builder ──────────────────────────────────────────────────────

    private WsConfig BuildConfig() => new()
    {
        Source        = _source,
        Options       = new WsOptions { Normalize = true },
        Plugins       = new WsPluginConfig
        {
            Hover      = true,
            Timeline   = true,
            Zoom       = true,
            Regions    = true,
        },
        InitialHeight = "260px",
        MinHeight     = "100px",
        MaxHeight     = "600px",
        ShowControls  = false,   // custom controls row is used instead
    };

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1 ? ts.ToString(@"h\:mm\:ss\.ff") : ts.ToString(@"m\:ss\.ff");
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024        => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _             => $"{bytes / (1024.0 * 1024):F1} MB",
    };

    // ── Menu item record ──────────────────────────────────────────────────────

    private sealed record RegionMenuItem(string Action, string Text);
}
