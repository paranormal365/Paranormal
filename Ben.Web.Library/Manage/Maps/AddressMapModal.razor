@namespace Ben.Web.Library.Manage.Maps

@* ── Resizable address map window ───────────────────────────────────────────── *@
@*                                                                               *@
@* Usage:                                                                        *@
@*   <AddressMapModal @ref="_mapModal" />                                        *@
@*                                                                               *@
@*   _mapModal.Show(                                                             *@
@*       title:     "123 Main St, Austin TX 78701",                              *@
@*       latitude:  30.2672,                                                     *@
@*       longitude: -97.7431);                                                   *@

<TelerikWindow @bind-Visible="@_visible"
               Width="@_width"
               Height="@_height"
               Resizable="true"
               Draggable="true"
               Modal="true"
               CloseOnOverlayClick="false">

    <WindowTitle>@_title</WindowTitle>

    <WindowActions>
        <WindowAction Name="Close" OnClick="@Close" />
    </WindowActions>

    <WindowContent>
        @if (_hasCoords)
        {
            @* TelerikMap (Kendo Map) requires an explicit pixel height.          *@
            @* _mapHeight is computed from the window height minus the title bar  *@
            @* (~80px) so the map fills the available content area.               *@
            <AddressMapPlayer Latitude="@_lat"
                              Longitude="@_lon"
                              Title="@_title"
                              ReadOnly="true"
                              ShowConfigPanel="false"
                              Height="@_mapHeight" />
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                <TelerikSvgIcon Icon="@SvgIcon.MapMarker" Size="@ThemeConstants.SvgIcon.Size.Large" />
                <div class="mt-3">No geocoded coordinates for this address.</div>
                <div class="small mt-1">Save the address to trigger geocoding, then reopen this map.</div>
            </div>
        }
    </WindowContent>

</TelerikWindow>

@code {
    private bool   _visible;
    private string _title   = "";
    private double _lat;
    private double _lon;
    private bool   _hasCoords;
    private string _width   = "680px";
    private string _height  = "540px";
    private string _mapHeight = "460px";  // title bar ≈ 44px + 36px footer

    /// <summary>Opens the map window centred on the supplied coordinates.</summary>
    public void Show(string title, double? latitude, double? longitude,
                     string width = "680px", string height = "540px")
    {
        _title     = title;
        _lat       = latitude  ?? 0;
        _lon       = longitude ?? 0;
        _hasCoords = latitude.HasValue && longitude.HasValue
                     && !(latitude == 0 && longitude == 0);
        _width    = width;
        _height   = height;
        _mapHeight = MapHeightFrom(height);
        _visible  = true;
        StateHasChanged();
    }

    /// <summary>Closes the window.</summary>
    public void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    /// <summary>Computes the Kendo Map pixel height from the window height string.</summary>
    private static string MapHeightFrom(string windowHeight)
    {
        // Strip "px" suffix and subtract title bar (~44px) + small padding (~36px)
        if (windowHeight.EndsWith("px", StringComparison.OrdinalIgnoreCase)
            && int.TryParse(windowHeight.AsSpan(0, windowHeight.Length - 2), out var px))
            return $"{Math.Max(200, px - 80)}px";
        return "460px";
    }
}
