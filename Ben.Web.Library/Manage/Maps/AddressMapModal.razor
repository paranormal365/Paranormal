@namespace Ben.Web.Library.Manage.Maps

@* ── Resizable address map modal ────────────────────────────────────────────── *@
@*                                                                               *@
@* Usage:                                                                        *@
@*   <AddressMapModal @ref="_mapModal" />                                        *@
@*                                                                               *@
@*   _mapModal.Show(                                                             *@
@*       title:     "123 Main St, Austin TX 78701",                              *@
@*       latitude:  30.2672,                                                     *@
@*       longitude: -97.7431);                                                   *@

<TelerikDialog @bind-Visible="@_visible"
               Title="@_title"
               Width="@_width"
               Height="@_height"
               Resizable="true"
               CloseOnOverlayClick="false"
               Class="address-map-modal">

    <DialogContent>
        @if (_hasCoords)
        {
            @* The outer div fills dialog body; the map fills that div.           *@
            @* Height is set via CSS on .address-map-modal .k-dialog-content.     *@
            <div style="width:100%; height:100%; min-height:320px;">
                <AddressMapPlayer Latitude="@_lat"
                                  Longitude="@_lon"
                                  Title="@_title"
                                  ReadOnly="true"
                                  ShowConfigPanel="false"
                                  Height="100%" />
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                <TelerikSvgIcon Icon="@SvgIcon.MapMarker" Size="@ThemeConstants.SvgIcon.Size.Large" />
                <div class="mt-3">No geocoded coordinates for this address.</div>
                <div class="small mt-1">Save the address to trigger geocoding, then reopen this map.</div>
            </div>
        }
    </DialogContent>

    <DialogButtons>
        <TelerikButton OnClick="Close">Close</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    private bool   _visible;
    private string _title  = "";
    private double _lat;
    private double _lon;
    private bool   _hasCoords;
    private string _width  = "680px";
    private string _height = "580px";

    /// <summary>
    /// Opens the map modal centred on the supplied coordinates.
    /// </summary>
    /// <param name="title">Dialog title — typically the formatted address.</param>
    /// <param name="latitude">Decimal latitude from the geocoded address.</param>
    /// <param name="longitude">Decimal longitude from the geocoded address.</param>
    /// <param name="width">Initial dialog width (CSS string). Defaults to 680px.</param>
    /// <param name="height">Initial dialog height (CSS string). Defaults to 580px.</param>
    public void Show(string title, double? latitude, double? longitude,
                     string width = "680px", string height = "580px")
    {
        _title     = title;
        _lat       = latitude  ?? 0;
        _lon       = longitude ?? 0;
        _hasCoords = latitude.HasValue && longitude.HasValue
                     && !(latitude == 0 && longitude == 0);
        _width  = width;
        _height = height;
        _visible = true;
        StateHasChanged();
    }

    /// <summary>Closes the modal.</summary>
    public void Close()
    {
        _visible = false;
        StateHasChanged();
    }
}
