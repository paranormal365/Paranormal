@namespace Ben.Web.Library.Manage.Maps

@* ── Resizable address map window ───────────────────────────────────────────── *@
@*                                                                               *@
@* Usage:                                                                        *@
@*   <AddressMapModal @ref="_mapModal" />                                        *@
@*                                                                               *@
@*   _mapModal.Show(                                                             *@
@*       title:     "123 Main St, Austin TX 78701",                              *@
@*       latitude:  30.2672,                                                     *@
@*       longitude: -97.7431);                                                   *@

<TelerikWindow @bind-Visible="@_visible"
               Width="@_width"
               Height="@_height"
               Resizable="true"
               Draggable="true"
               Modal="true"
               CloseOnOverlayClick="false">

    <WindowTitle>@_title</WindowTitle>

    <WindowActions>
        <WindowAction Name="Close" OnClick="@Close" />
    </WindowActions>

    <WindowContent>
        @if (_hasCoords)
        {
            <div style="width:100%; height:100%; min-height:280px;">
                <AddressMapPlayer Latitude="@_lat"
                                  Longitude="@_lon"
                                  Title="@_title"
                                  ReadOnly="true"
                                  ShowConfigPanel="false"
                                  Height="100%" />
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                <TelerikSvgIcon Icon="@SvgIcon.MapMarker" Size="@ThemeConstants.SvgIcon.Size.Large" />
                <div class="mt-3">No geocoded coordinates for this address.</div>
                <div class="small mt-1">Save the address to trigger geocoding, then reopen this map.</div>
            </div>
        }
    </WindowContent>

</TelerikWindow>

@code {
    private bool   _visible;
    private string _title  = "";
    private double _lat;
    private double _lon;
    private bool   _hasCoords;
    private string _width  = "680px";
    private string _height = "540px";

    /// <summary>
    /// Opens the map window centred on the supplied coordinates.
    /// </summary>
    public void Show(string title, double? latitude, double? longitude,
                     string width = "680px", string height = "540px")
    {
        _title     = title;
        _lat       = latitude  ?? 0;
        _lon       = longitude ?? 0;
        _hasCoords = latitude.HasValue && longitude.HasValue
                     && !(latitude == 0 && longitude == 0);
        _width   = width;
        _height  = height;
        _visible = true;
        StateHasChanged();
    }

    /// <summary>Closes the window.</summary>
    public void Close()
    {
        _visible = false;
        StateHasChanged();
    }
}
