@*
  UploadFileVoteBar.razor
  ───────────────────────
  Reusable vote bar for any UploadFile.

  • Shows 👍 N  👎 M  (total score in the middle)
  • Highlights the current user's active vote
  • Clicking the active vote again removes it (toggle off)
  • All API calls use the upsert endpoint — no duplicate-vote possible
*@

@namespace Ben.Web.Library.Manage
@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState

@if (_summary is not null)
{
    <div class="d-flex align-items-center gap-2 flex-wrap" style="font-size:.85rem;">

        @* Upvote *@
        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                       ThemeColor="@(_summary.UserScore > 0 ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                       Enabled="@(!_busy && UserState.IsAuthenticated)"
                       OnClick="UpvoteAsync"
                       title="@(_summary.UserScore > 0 ? "Remove upvote" : "Upvote")">
            👍 @_summary.UpvoteCount
        </TelerikButton>

        @* Score *@
        <span class="fw-semibold small @ScoreClass" title="Total score">
            @(_summary.TotalScore > 0 ? "+" : "")@_summary.TotalScore
        </span>

        @* Downvote *@
        <TelerikButton Size="@ThemeConstants.Button.Size.Small"
                       ThemeColor="@(_summary.UserScore < 0 ? ThemeConstants.Button.ThemeColor.Error : ThemeConstants.Button.ThemeColor.Base)"
                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                       Enabled="@(!_busy && UserState.IsAuthenticated)"
                       OnClick="DownvoteAsync"
                       title="@(_summary.UserScore < 0 ? "Remove downvote" : "Downvote")">
            👎 @_summary.DownvoteCount
        </TelerikButton>

        @if (!UserState.IsAuthenticated)
        {
            <span class="text-secondary small fst-italic">Sign in to vote</span>
        }

        @if (_error is not null)
        {
            <span class="text-danger small">@_error</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid FileId { get; set; }

    private UploadFileVoteSummary? _summary;
    private bool   _busy;
    private string? _error;

    private string ScoreClass => (_summary?.TotalScore ?? 0) switch
    {
        > 0 => "text-success",
        < 0 => "text-danger",
        _   => "text-secondary",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try   { _summary = await AdminClient.GetVoteSummaryAsync(FileId); }
        catch { /* silently ignore — vote bar is non-critical */ }
        StateHasChanged();
    }

    private async Task UpvoteAsync()
    {
        if (_summary is null) return;
        _busy = true; _error = null; StateHasChanged();
        try
        {
            // Toggle: clicking active upvote removes it
            if (_summary.UserScore > 0)
                await AdminClient.RemoveMyVoteAsync(FileId);
            else
                await AdminClient.UpsertMyVoteAsync(FileId, 1);
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DownvoteAsync()
    {
        if (_summary is null) return;
        _busy = true; _error = null; StateHasChanged();
        try
        {
            // Toggle: clicking active downvote removes it
            if (_summary.UserScore < 0)
                await AdminClient.RemoveMyVoteAsync(FileId);
            else
                await AdminClient.UpsertMyVoteAsync(FileId, -1);
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
