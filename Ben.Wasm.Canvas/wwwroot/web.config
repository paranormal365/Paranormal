<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the published canvas editor. Copied from Ben.Wasm.Video/wwwroot/web.config,
  with the cross-origin isolation headers removed (see the comment where they were).

  IIS serves nothing whose file extension it does not recognise: no mapping, no response, 404. A
  Blazor WebAssembly app is almost entirely such files - the runtime and every assembly ship as .wasm
  - so without this file the page loads and then sits on "Loading" forever while the browser collects
  404s for the runtime. Nothing in the logs says "MIME type", which is what makes it worth the comment.

  There is deliberately NO <rewrite> section here. URL Rewrite is a separate IIS download rather than
  part of IIS, and a <rewrite> section on a server without it fails the whole folder with HTTP 500.19.
  If deep links under /editors/canvas/ are ever wanted, install URL Rewrite first and then add a rule
  whose target is the site-absolute "/editors/canvas/index.html".
-->
<configuration>
  <system.webServer>
    <!-- The site and the API drop the "Server: Microsoft-IIS/10.0" line; this child application
         serves static files under its own web.config, so it has to say so too. -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <staticContent>
      <!-- Removed first: a mapping may already exist at the server or site level, and adding a
           duplicate is itself a 500.19. Removing something absent is harmless. -->
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Framing is the attack a static editor holding a case's board actually has, so it is
             closed outright. The standalone app is never framed; inside the site the editor is
             hosted in the site's own document, not an iframe. -->
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="frame-ancestors 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Cross-origin isolation (COOP same-origin + COEP require-corp) is deliberately NOT set,
             unlike the video editor. There it exists only so ffmpeg can use SharedArrayBuffer;
             nothing here needs SharedArrayBuffer, and require-corp would block MapKit tiles from
             cdn.apple-mapkit.com and the link-preview image proxy's responses - so maps and link
             cards would go blank in production only, where the header is served. -->
      </customHeaders>
    </httpProtocol>

    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <!-- Two files must never be cached, and everything else must be. index.html names the
         fingerprinted runtime files and appsettings.json names the API; a cached copy of either
         points a returning visitor at a deployment that no longer exists. Everything else under
         the app is fingerprinted, so the blanket rule is safe. -->
    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
        <add extension=".json" policy="DisableCache" kernelCachePolicy="DisableCache" />
      </profiles>
    </caching>
  </system.webServer>
</configuration>
