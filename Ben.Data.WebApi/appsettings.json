{
  "ConnectionStrings": {
    "BenDbConnectionString": "data source=localhost;initial catalog=BenDb;integrated security=True;persist security info=False;encrypt=True;trustservercertificate=True;"
  },
  "FileStorage": {
    "RootPath": ""
  },
  "SeedData": {
    "DevData": {
      "Enabled": false
    }
  },
  "RateLimits": {
    "GeocodingPerMinute": 20,
    "AuthPerMinute": 20,
    "GlobalPerMinute": 600
  },
  "AzureAd": {
    "TenantId": "common",
    "ClientId": "e75f71ef-cc2e-43ad-ba0f-9e24c6f805f1",
    "Audience": "api://e75f71ef-cc2e-43ad-ba0f-9e24c6f805f1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore.OpenApi": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "data source=localhost;initial catalog=BenDb;integrated security=True;persist security info=False;encrypt=True;trustservercertificate=True;",
          "tableName": "Logs",
          "autoCreateSqlTable": true,
          "restrictedToMinimumLevel": "Error",
          "columnOptionsSection": {
              "additionalColumns": [
                {
                  "ColumnName": "Source",
                  "DataType": "nvarchar",
                  "DataLength": 64
                },
                {
                  "ColumnName": "Application",
                  "DataType": "nvarchar",
                  "DataLength": 128
                },
                {
                  "ColumnName": "EntityType",
                  "DataType": "nvarchar",
                  "DataLength": 128
                },
                {
                  "ColumnName": "Operation",
                  "DataType": "nvarchar",
                  "DataLength": 64
                }
              ]
            }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "Ben.Data.WebApi", "Source": "WebApi" }
  }
}
