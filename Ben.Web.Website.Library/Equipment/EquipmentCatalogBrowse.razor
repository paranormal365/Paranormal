@page "/equipment-catalog"
@namespace Ben.Web.Website.Library.Equipment
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<FeatureGate Flag="@SiteFeatures.Equipment">
    <PageTitle>Equipment Catalog</PageTitle>

    @* Deliberately anonymous. "Makes & models" is pure reference data. "Gear people own" lists only
       items whose owners opted in, and its projection carries no owner identity and no serial — see
       PublicEquipmentItemRecord. *@

    <div class="container-fluid py-3" style="max-width:900px;">
        <h3 class="mb-1">Equipment Catalog<HelpLink Slug="your-equipment" Anchor="the-public-catalog" /></h3>
        <p class="text-secondary small mb-4">
            Gear used for paranormal investigation. The makes and models grow as members add their own
            equipment. Nothing here shows who owns anything.
        </p>

        <div class="row g-2 mb-3">
            <div class="col-md-5">
                <input class="form-control" placeholder="Search make or model…"
                       value="@_search"
                       @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)"
                       @onkeyup="@(async e => { if (e.Key == "Enter") await LoadAsync(); })" />
            </div>
            <div class="col-md-4">
                <BenSelect Data="@_categories" Value="@_categoryId" ValueChanged="@((Guid? v) => OnCategoryChangedAsync(v))" TextField="@nameof(EquipmentCategoryRecord.Name)" ValueField="@nameof(EquipmentCategoryRecord.Id)" DefaultText="All categories" Width="100%" />
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-primary" @onclick="LoadAsync" disabled="@(!(!_loading))">Search</button>
            </div>
        </div>

        @if (_loading)
        {
            <BenLoaderOverlay Visible="true" Text="Loading the catalog…" />
        }
        else
        {
            <BenTabs @bind-ActiveId="@_activeTab">

                <BenTab Title="Makes &amp; models" Id="models">
                    @if (_modelsResult.Failed)
                    {
                        @* A visitor with no account has no way to tell a broken catalogue from
                           an empty one. *@
                        <BenListState TItem="EquipmentModelRecord" Result="@_modelsResult" OnRetry="@LoadAsync" />
                    }
                    else if (_models.Count == 0)
                    {
                        <div class="card mt-2">
                            <div class="card-body text-center py-5">
                                <h6 class="mb-2">Nothing matches that yet</h6>
                                <p class="text-secondary small mb-0">
                                    @(_isAuthenticated
                                        ? "Add the gear you own and its make and model show up here once approved."
                                        : "Sign in to add the gear you own.")
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <TelerikGrid Data="@_models" TItem="EquipmentModelRecord"
                                     Sortable="true" Pageable="true" PageSize="25">
                            <GridColumns>
                                <GridColumn Field="@nameof(EquipmentModelRecord.BrandName)" Title="Make" Width="200px" />
                                <GridColumn Field="@nameof(EquipmentModelRecord.Name)" Title="Model" />
                                <GridColumn Field="@nameof(EquipmentModelRecord.ModelNumber)" Title="Model #" Width="140px" />
                                <GridColumn Field="@nameof(EquipmentModelRecord.CategoryName)" Title="Category" Width="200px" />
                            </GridColumns>
                        </TelerikGrid>
                        <p class="text-secondary small mt-2 mb-0">
                            @_models.Count approved @(_models.Count == 1 ? "entry" : "entries").
                        </p>
                    }
                </BenTab>

                <BenTab Title="Gear people own" Id="items">
                    @if (_itemsResult.Failed)
                    {
                        <BenListState TItem="PublicEquipmentItemRecord" Result="@_itemsResult" OnRetry="@LoadAsync" />
                    }
                    else if (_items.Count == 0)
                    {
                        <div class="card mt-2">
                            <div class="card-body text-center py-5">
                                <h6 class="mb-2">Nobody has listed a piece publicly yet</h6>
                                <p class="text-secondary small mb-0">
                                    Members choose, piece by piece, whether to list their own gear here.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mt-1">
                            @foreach (var item in _items)
                            {
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            @* Two destinations, deliberately: the piece itself, and every
                                               copy of that product pooled together. *@
                                            <h6 class="card-title mb-1">
                                                <a href="@($"/equipment/{item.Id}")"
                                                   class="text-decoration-none">@item.DisplayName</a>
                                            </h6>
                                            <div class="text-secondary small">
                                                <a href="@($"/equipment-models/{item.EquipmentModelId}")"
                                                   class="text-decoration-none text-secondary">@item.BrandName · @item.ModelName</a>
                                                <span class="mx-1">·</span>@item.CategoryName
                                            </div>

                                            @if (item.LoanAudience != EquipmentLoanAudience.NotLoanable)
                                            {
                                                <div class="mt-2 d-flex align-items-center gap-2">
                                                    <span class="badge bg-success">Available to borrow</span>
                                                    @if (_isAuthenticated)
                                                    {
                                                        @* Whether this caller may actually ask is the server's call — the
                                                           dialog asks it and shows the reason when the answer is no. *@
                                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenBorrow(item.Id, item.DisplayName))">Ask to borrow</button>
                                                    }
                                                    else
                                                    {
                                                        <a class="small" href="/login">Sign in to ask</a>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <p class="small mt-2 mb-0">@item.Notes</p>
                                            }

                                            @if (item.Photos.Count > 0)
                                            {
                                                <div class="mt-2">
                                                    <PublicEquipmentPhotos Photos="@item.Photos" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <p class="text-secondary small mt-3 mb-0">
                            @_items.Count publicly listed @(_items.Count == 1 ? "piece" : "pieces").
                        </p>
                    }
                </BenTab>

            </BenTabs>
        }

        @if (_isAuthenticated)
        {
            <div class="mt-4">
                <a class="btn btn-outline-primary btn-sm" href="/my-equipment">Go to my equipment</a>
            </div>
        }
    </div>

    <EquipmentCheckoutRequestDialog Visible="@_borrowVisible"
                                    VisibleChanged="@(v => _borrowVisible = v)"
                                    ItemId="@_borrowItemId"
                                    ItemDisplayName="@_borrowItemName" />
</FeatureGate>

@code {
    private bool _borrowVisible;
    private Guid _borrowItemId;
    private string? _borrowItemName;

    private void OpenBorrow(Guid itemId, string displayName)
    {
        _borrowItemId = itemId;
        _borrowItemName = displayName;
        _borrowVisible = true;
    }

    private List<EquipmentCategoryRecord> _categories = [];
    private List<EquipmentModelRecord> _models = [];
    private List<PublicEquipmentItemRecord> _items = [];
    private Guid? _categoryId;
    private string _search = string.Empty;
    private string _activeTab = "models";
    private bool _loading = true;
    private LoadResult<EquipmentModelRecord> _modelsResult;
    private LoadResult<PublicEquipmentItemRecord> _itemsResult;
    private bool _isAuthenticated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The page itself is anonymous, but whether someone is signed in decides which
        // call-to-action to show — so still wait for auth to settle rather than guessing.
        await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive);
        _isAuthenticated = UserState.IsAuthenticated;

        _categories = [.. (await AdminClient.GetEquipmentCategoriesAsync()).Items];
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnCategoryChangedAsync(Guid? categoryId)
    {
        _categoryId = categoryId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var search = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        _modelsResult = await AdminClient.SearchEquipmentModelsAsync(search, _categoryId);
        _models       = [.. _modelsResult.Items];
        _itemsResult  = await AdminClient.GetPublicEquipmentItemsAsync(search, _categoryId);
        _items        = [.. _itemsResult.Items];

        _loading = false;
        StateHasChanged();
    }
}
