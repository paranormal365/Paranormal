@page "/my-equipment/questions"
@namespace Ben.Web.Website.Library.Equipment
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<FeatureGate Flag="@SiteFeatures.Equipment">
    <PageTitle>Equipment Questions</PageTitle>

    @* A page, not a window: answering questions, declining them and publishing the good ones is a
       whole task somebody sits down to do, not a single interaction. *@

    <div class="container-fluid py-3" style="max-width:900px;">
        <h3 class="mb-1">Equipment questions<HelpLink Slug="your-equipment" Anchor="questions-and-faqs" /></h3>
        <p class="text-secondary small mb-4">
            Questions are anonymous in both directions. You will not see who asked, and whoever asked
            will not see who answered.
        </p>

        @if (_loading)
        {
            <BenLoaderOverlay Visible="true" Text="Loading…" />
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <BenTabs>
                <BenTab Title="@WaitingTabTitle">
                    @RenderReceived
                </BenTab>
                <BenTab Title="@AskedTabTitle">
                    @RenderAsked
                </BenTab>
            </BenTabs>
        }
    </div>
</FeatureGate>

@code {
    // Properties, not inline interpolations: a $"..." nested inside an attribute's own quotes
    // does not parse as a component attribute.
    private string WaitingTabTitle => $"Waiting on you ({_received.Count(q => q.Status == EquipmentQuestionStatus.Open)})";
    private string AskedTabTitle   => $"You asked ({_asked.Count})";

    private RenderFragment RenderReceived => @<text>
        @if (_receivedResult.Failed)
        {
            <BenListState TItem="ReceivedQuestionRecord" Result="@_receivedResult" OnRetry="@LoadAsync" />
        }
        else if (_received.Count == 0)
        {
            <p class="text-secondary small mt-3 mb-0">Nobody has asked about your equipment yet.</p>
        }
        else
        {
            @foreach (var q in _received)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <a href="@($"/equipment/{q.EquipmentItemId}")" class="fw-semibold text-decoration-none">@q.ItemDisplayName</a>
                                <span class="text-secondary small ms-2">@q.BrandName @q.ModelName</span>
                            </div>
                            @RenderStatus(q.Status)
                        </div>

                        <p class="mt-2 mb-1" style="white-space:pre-line;">@q.QuestionText</p>
                        <div class="text-secondary" style="font-size:.75rem;">
                            Asked @q.DateAsked.ToLocalTime().ToDisplayDate() · asker not shown
                        </div>

                        @if (q.AnswerText is not null)
                        {
                            <div class="border-start ps-2 mt-2 small" style="white-space:pre-line;">@q.AnswerText</div>
                        }

                        @if (q.Status == EquipmentQuestionStatus.Open)
                        {
                            @if (_answeringId == q.Id)
                            {
                                <textarea class="form-control form-control-sm mt-2" rows="3" maxlength="4000"
                                          value="@_answerText"
                                          @oninput="@(e => _answerText = e.Value?.ToString() ?? string.Empty)"></textarea>
                                <div class="d-flex gap-2 justify-content-end mt-2">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _answeringId = null)" disabled="@(!(!_busy))">Cancel</button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => AnswerAsync(q.Id, decline: true))" disabled="@(!(!_busy))">Decline</button>
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => AnswerAsync(q.Id, decline: false))" disabled="@(!(!_busy && !string.IsNullOrWhiteSpace(_answerText)))">Answer</button>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => StartAnswer(q.Id))">Answer this</button>
                            }
                        }
                        else if (q.Status == EquipmentQuestionStatus.Answered && !q.PromotedToFaq)
                        {
                            @if (_promotingId == q.Id)
                            {
                                @* Editable before publishing: what reads well as a reply to one
                                   person rarely reads well as a public answer. *@
                                <div class="border rounded p-2 mt-2">
                                    <label class="form-label fw-semibold small mb-1" for="myequipmentquestions-question-as-others-will-71e9">Question, as others will read it</label>
                                    <input id="myequipmentquestions-question-as-others-will-71e9" class="form-control form-control-sm mb-2" maxlength="500" value="@_promoteQuestion"
                                           @oninput="@(e => _promoteQuestion = e.Value?.ToString() ?? string.Empty)" />
                                    <label class="form-label fw-semibold small mb-1" for="myequipmentquestions-answer-ef8c">Answer</label>
                                    <textarea id="myequipmentquestions-answer-ef8c" class="form-control form-control-sm mb-2" rows="3" maxlength="4000"
                                              value="@_promoteAnswer"
                                              @oninput="@(e => _promoteAnswer = e.Value?.ToString() ?? string.Empty)"></textarea>
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _promotingId = null)" disabled="@(!(!_busy))">Cancel</button>
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => PromoteAsync(q.Id))" disabled="@(!(!_busy && !string.IsNullOrWhiteSpace(_promoteQuestion) && !string.IsNullOrWhiteSpace(_promoteAnswer)))">Publish</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => StartPromote(q))">Add this to the FAQ</button>
                            }
                        }
                        else if (q.PromotedToFaq)
                        {
                            <div class="text-secondary mt-2" style="font-size:.75rem;">Published in this item's FAQ.</div>
                        }
                    </div>
                </div>
            }
        }
    </text>;

    private RenderFragment RenderAsked => @<text>
        @if (_askedResult.Failed)
        {
            <BenListState TItem="AskedQuestionRecord" Result="@_askedResult" OnRetry="@LoadAsync" />
        }
        else if (_asked.Count == 0)
        {
            <p class="text-secondary small mt-3 mb-0">You haven't asked anything yet.</p>
        }
        else
        {
            @foreach (var q in _asked)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <a href="@($"/equipment/{q.EquipmentItemId}")" class="fw-semibold text-decoration-none">@q.ItemDisplayName</a>
                                <span class="text-secondary small ms-2">@q.BrandName @q.ModelName</span>
                            </div>
                            @RenderStatus(q.Status)
                        </div>

                        <p class="mt-2 mb-1" style="white-space:pre-line;">@q.QuestionText</p>

                        @if (q.AnswerText is not null)
                        {
                            <div class="border-start ps-2 mt-2 small" style="white-space:pre-line;">@q.AnswerText</div>
                            <div class="text-secondary mt-1" style="font-size:.75rem;">Answered — the person who answered is not shown.</div>
                        }
                        else if (q.Status == EquipmentQuestionStatus.Declined)
                        {
                            <div class="text-secondary small mt-2">Closed without an answer.</div>
                        }
                    </div>
                </div>
            }
        }
    </text>;

    private static RenderFragment RenderStatus(EquipmentQuestionStatus status) => @<text>
        @switch (status)
        {
            case EquipmentQuestionStatus.Open:
                <span class="badge bg-warning text-dark">Waiting</span>
                break;
            case EquipmentQuestionStatus.Answered:
                <span class="badge bg-success">Answered</span>
                break;
            default:
                <span class="badge bg-secondary">Closed</span>
                break;
        }
    </text>;

    private IReadOnlyList<ReceivedQuestionRecord> _received = [];
    private LoadResult<ReceivedQuestionRecord> _receivedResult;
    private IReadOnlyList<AskedQuestionRecord> _asked = [];
    private LoadResult<AskedQuestionRecord> _askedResult;
    private bool _loading = true, _busy;
    private string? _error;

    private Guid? _answeringId, _promotingId;
    private string _answerText = string.Empty;
    private string _promoteQuestion = string.Empty, _promoteAnswer = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _received = (_receivedResult = await AdminClient.GetMyReceivedQuestionsAsync()).Items;
        _asked    = (_askedResult = await AdminClient.GetMyAskedQuestionsAsync()).Items;
        _loading  = false;
        StateHasChanged();
    }

    private void StartAnswer(Guid questionId)
    {
        _answeringId = questionId;
        _answerText  = string.Empty;
        _error       = null;
    }

    private void StartPromote(ReceivedQuestionRecord q)
    {
        _promotingId     = q.Id;
        _promoteQuestion = q.QuestionText;
        _promoteAnswer   = q.AnswerText ?? string.Empty;
        _error           = null;
    }

    private async Task AnswerAsync(Guid questionId, bool decline)
    {
        _busy = true; _error = null;
        var request = new AnswerEquipmentQuestionRequest(decline ? null : _answerText.Trim(), decline);
        if (await AdminClient.AnswerEquipmentQuestionAsync(questionId, request) is null)
            _error = "That couldn't be saved. Somebody else may have already answered it.";
        else
            _answeringId = null;

        _busy = false;
        await LoadAsync();
    }

    private async Task PromoteAsync(Guid questionId)
    {
        _busy = true; _error = null;
        var request = new PromoteQuestionToFaqRequest(_promoteQuestion.Trim(), _promoteAnswer.Trim());
        if (await AdminClient.PromoteQuestionToFaqAsync(questionId, request) is null)
            _error = "That couldn't be published. It may already be in the FAQ.";
        else
            _promotingId = null;

        _busy = false;
        await LoadAsync();
    }
}
