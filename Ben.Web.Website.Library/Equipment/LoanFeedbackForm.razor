@namespace Ben.Web.Website.Library.Equipment
@inject IBenAdminClient AdminClient

@* Leaving feedback after a loan comes back. Shown on the loan page only when the server says this
   caller may — the verdict is rendered, never worked out here. *@

@if (_state?.CanLeaveFeedback == true)
{
    <div class="card mb-3">
        <div class="card-body">
            <h6 class="mb-1">How did it go?<HelpLink Slug="borrowing-equipment" Anchor="feedback-after-a-loan" /></h6>
            <p class="text-secondary small">
                @(_state.AsRole == EquipmentFeedbackRole.Lender
                    ? "About the borrower. Future lenders deciding their requests will see this — they will not."
                    : "About the lender. Other borrowers considering asking them will see this, without your name — they will not see it at all.")
            </p>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <label class="form-label fw-semibold small mb-1" for="loanfeedbackform-field-1f87">
                @(_state.AsRole == EquipmentFeedbackRole.Lender ? "About the borrower" : "About the lender")
            </label>
            <textarea id="loanfeedbackform-field-1f87" class="form-control form-control-sm mb-2" rows="3" maxlength="2000" value="@_comment"
                      @oninput="@(e => _comment = e.Value?.ToString() ?? string.Empty)"></textarea>

            <label class="form-label fw-semibold small mb-1">Rating (optional)</label>
            <div class="d-flex gap-2 align-items-center mb-2">
                @for (var star = 1; star <= 5; star++)
                {
                    var value = star;
                    <button type="button"
                            class="@(_rating == value ? "btn btn-primary btn-sm py-0 px-2" : "btn btn-outline-secondary btn-sm py-0 px-2")"
                            disabled="@_busy"
                            @onclick="@(() => _rating = _rating == value ? null : value)">@value</button>
                }
                <span class="text-secondary small">Leave it blank if you would rather not put a number on it.</span>
            </div>

            @* Borrower only: a lender reviewing their own gear would be an advertisement. *@
            @if (_state.AsRole == EquipmentFeedbackRole.Borrower)
            {
                <label class="form-label fw-semibold small mb-1" for="loanfeedbackform-about-the-equipment-itself-4aa9">About the equipment itself (optional)</label>
                <textarea id="loanfeedbackform-about-the-equipment-itself-4aa9" class="form-control form-control-sm mb-2" rows="3" maxlength="2000" value="@_productComment"
                          @oninput="@(e => _productComment = e.Value?.ToString() ?? string.Empty)"></textarea>
                <div class="form-text mb-2">
                    This one is public — it appears on the make and model's catalog page, without your name.
                </div>
            }

            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-primary" @onclick="SubmitAsync" disabled="@(!(!_busy && HasSomethingToSay))">Submit</button>
            </div>
        </div>
    </div>
}
else if (_state?.AlreadyLeft == true)
{
    <div class="text-secondary small mb-3">
        You have left feedback on this loan. It is not shown to the other party.
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CheckoutId { get; set; }
    [Parameter] public EventCallback OnSubmitted { get; set; }

    private LoanFeedbackStateRecord? _state;
    private string _comment = string.Empty, _productComment = string.Empty;
    private int? _rating;
    private bool _busy;
    private string? _error;
    private Guid _loadedFor;

    private bool HasSomethingToSay
        => !string.IsNullOrWhiteSpace(_comment)
        || _rating is not null
        || !string.IsNullOrWhiteSpace(_productComment);

    protected override async Task OnParametersSetAsync()
    {
        if (CheckoutId == Guid.Empty || _loadedFor == CheckoutId) return;
        _loadedFor = CheckoutId;
        _state = await AdminClient.GetLoanFeedbackStateAsync(CheckoutId);
    }

    private async Task SubmitAsync()
    {
        _busy = true; _error = null;

        var request = new SubmitLoanFeedbackRequest(
            string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim(),
            _rating,
            string.IsNullOrWhiteSpace(_productComment) ? null : _productComment.Trim());

        if (!await AdminClient.SubmitLoanFeedbackAsync(CheckoutId, request))
        {
            _error = "That couldn't be saved. You may have already left feedback on this loan.";
        }
        else
        {
            _state = await AdminClient.GetLoanFeedbackStateAsync(CheckoutId);
            await OnSubmitted.InvokeAsync();
        }

        _busy = false;
    }
}
