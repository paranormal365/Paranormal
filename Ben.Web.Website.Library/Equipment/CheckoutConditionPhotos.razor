@namespace Ben.Web.Website.Library.Equipment
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@* Before and after, side by side — the comparison is the whole reason these exist. Bytes come
   through the authed client as data: URIs; condition photos are never public, so a plain <img src>
   pointing at the API would 401. *@

<div class="row g-3">
    @foreach (var stage in new[] { EquipmentPhotoStage.Handoff, EquipmentPhotoStage.Return })
    {
        <div class="col-md-6">
            <h6 class="mb-2">@(stage == EquipmentPhotoStage.Handoff ? "When it went out" : "When it came back")</h6>

            @{ var stagePhotos = _photos.Where(p => p.Stage == stage).ToList(); }

            @if (_photosResult.Failed)
            {
                @* Condition photos are the evidence in a damage dispute. "None taken" when the
                   fetch was refused is the wrong answer to have on record. *@
                <BenListState TItem="EquipmentCheckoutPhotoRecord" Result="@_photosResult" />
            }
            else if (stagePhotos.Count == 0)
            {
                <p class="text-secondary small">No photos.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var photo in stagePhotos)
                    {
                        <figure class="mb-0" style="width:120px;">
                            @if (_dataUrls.TryGetValue(photo.Id, out var url) && url is not null)
                            {
                                <img src="@url" alt="@(photo.Caption ?? "Condition photo")"
                                     style="width:120px;height:84px;object-fit:cover;border-radius:4px;" />
                            }
                            else
                            {
                                <div class="bg-body-secondary d-flex align-items-center justify-content-center"
                                     style="width:120px;height:84px;border-radius:4px;">
                                    <span class="text-secondary small">…</span>
                                </div>
                            }
                            <figcaption class="text-secondary" style="font-size:.75rem;">
                                @(photo.Caption ?? photo.CreatedByDisplayName ?? "")
                            </figcaption>
                        </figure>
                    }
                </div>
            }

            @if (CanAttach(stage))
            {
                <InputFile OnChange="@(e => UploadAsync(e, stage))" accept="image/*" class="form-control form-control-sm" />
            }
        </div>
    }
</div>

@if (_error is not null)
{
    <div class="alert alert-danger py-2 mt-2 mb-0">@_error</div>
}

@code {
    [Parameter, EditorRequired] public EquipmentCheckoutRecord Loan { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<EquipmentCheckoutPhotoRecord> _photos = [];
    private LoadResult<EquipmentCheckoutPhotoRecord> _photosResult;
    private readonly Dictionary<Guid, string?> _dataUrls = [];
    private string? _error;
    private Guid? _loadedFor;

    /// <summary>
    /// Mirrors the server's own rule: a hand-off photo only means something once the loan is
    /// approved and before it is over, a return photo only once the gear is on its way back. The
    /// server re-checks regardless — this just avoids offering an upload that would be refused.
    /// </summary>
    private bool CanAttach(EquipmentPhotoStage stage) => stage switch
    {
        EquipmentPhotoStage.Handoff => Loan.Status is EquipmentCheckoutStatus.Approved or EquipmentCheckoutStatus.CheckedOut,
        EquipmentPhotoStage.Return  => Loan.Status is EquipmentCheckoutStatus.CheckedOut or EquipmentCheckoutStatus.Returned,
        _                           => false,
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Loan is null || _loadedFor == Loan.Id) return;
        _loadedFor = Loan.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _photosResult = await AdminClient.GetCheckoutPhotosAsync(Loan.Id);
        _photos       = [.. _photosResult.Items];

        foreach (var photo in _photos.Where(p => !_dataUrls.ContainsKey(p.Id)))
        {
            try
            {
                var bytes = await AdminClient.GetCheckoutPhotoBytesAsync(photo.Id);
                _dataUrls[photo.Id] = bytes is null
                    ? null
                    : $"data:{bytes.Value.ContentType};base64,{Convert.ToBase64String(bytes.Value.Data)}";
            }
            catch
            {
                _dataUrls[photo.Id] = null; // a photo that won't load is simply not shown
            }
        }

        StateHasChanged();
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, EquipmentPhotoStage stage)
    {
        _error = null;
        var file = e.File;
        if (file is null) return;

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(maxAllowedSize: long.MaxValue);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var uploaded = await AdminClient.UploadCheckoutPhotoAsync(Loan.Id, stage, content);
            if (uploaded is null)
            {
                _error = "That photo couldn't be attached.";
                return;
            }

            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = $"That photo couldn't be attached: {ex.Message}";
        }
    }
}
