@page "/my-checkouts/{CheckoutId:guid}"
@namespace Ben.Web.Website.Library.Equipment
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

@* One loan in full: its condition photos at each end, and the record of any time asked for.

   Its own page rather than a window — this is the surface where either party manages everything
   about a loan, and it carries two upload columns plus the whole renewal conversation. A modal
   sized to that content stops scrolling before it stops growing. *@

<PageTitle>@(Loan?.ItemDisplayName ?? "Loan")</PageTitle>

<div class="container-fluid py-3" style="max-width:900px;">
    <div class="mb-3">
        <a href="/my-checkouts" class="text-decoration-none small">&larr; Back to my checkouts</a>
    </div>

    <h3 class="mb-3">@(Loan?.ItemDisplayName ?? "Loan")<HelpLink Slug="borrowing-equipment" Anchor="photos-of-its-condition" /></h3>

        @if (_loading)
        {
            <BenLoaderOverlay Visible="true" Text="Loading this loan…" />
        }
        else if (Loan is null)
        {
            <p class="text-secondary mb-0">That loan could not be found, or it isn't yours to see.</p>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <div class="text-secondary small mb-3">
                @Loan.BrandName · @Loan.ModelName
                @if (Loan.BorrowedForOrganizationName is not null)
                {
                    <span> · borrowed for @Loan.BorrowedForOrganizationName</span>
                }
                @if (Loan.DateDue is not null)
                {
                    <span class="@(Loan.IsOverdue ? "text-danger fw-semibold" : "")">
                        · due @Loan.DateDue.Value.ToDisplayDate()@(Loan.IsOverdue ? " (overdue)" : "")
                    </span>
                }
            </div>

            @* Only whoever is deciding this request sees it, and the borrower never does — the
               endpoint refuses them, so the panel is absent rather than hidden. *@
            <BorrowerHistoryPanel CheckoutId="@Loan.Id" />

            <h6 class="mb-2">Condition</h6>
            <CheckoutConditionPhotos Loan="@Loan" OnChanged="LoadAsync" />

            <LoanFeedbackForm CheckoutId="@Loan.Id" OnSubmitted="LoadAsync" />

            <hr />

            <h6 class="mb-2">More time</h6>

            @* Only the borrower can ask, and only while they actually have the gear. *@
            @if (Loan.Flags.IsBorrower && Loan.Status == EquipmentCheckoutStatus.CheckedOut
                 && !_renewals.Any(r => r.Status == EquipmentRenewalStatus.Requested))
            {
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Keep it until</label>
                        <TelerikDatePicker @bind-Value="@_requestedDate" Width="100%" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold mb-1">Why (optional)</label>
                        <input class="form-control form-control-sm" maxlength="1000" value="@_requestNotes"
                               @oninput="@(e => _requestNotes = e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="RequestRenewalAsync" disabled="@(!(!_busy && _requestedDate is not null))">Ask</button>
                    </div>
                </div>
            }

            @if (_renewals.Count == 0)
            {
                <p class="text-secondary small">No requests for more time.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var renewal in _renewals)
                    {
                        <li class="border-bottom py-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <span class="small">
                                    Asked to keep it until <strong>@renewal.RequestedDateDue.ToDisplayDate()</strong>
                                    @if (!string.IsNullOrWhiteSpace(renewal.RequestNotes))
                                    {
                                        <span class="d-block text-secondary">“@renewal.RequestNotes”</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(renewal.ReviewNotes))
                                    {
                                        <span class="d-block text-secondary">
                                            Reply from @(renewal.ReviewedByDisplayName ?? "the lender"): @renewal.ReviewNotes
                                        </span>
                                    }
                                </span>
                                <span class="badge @RenewalClass(renewal.Status)">@RenewalLabel(renewal.Status)</span>
                            </div>

                            @if (renewal.CanReview)
                            {
                                <div class="mt-2">
                                    <input class="form-control form-control-sm mb-2" maxlength="1000"
                                           placeholder="Reason (required to refuse)"
                                           value="@GetReviewNote(renewal.Id)"
                                           @oninput="@(e => _reviewNotes[renewal.Id] = e.Value?.ToString() ?? string.Empty)" />
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => ReviewAsync(renewal, true))" disabled="@(!(!_busy))">Grant</button>
                                        <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => ReviewAsync(renewal, false))" disabled="@(!(!_busy && !string.IsNullOrWhiteSpace(GetReviewNote(renewal.Id))))">Refuse</button>
                                    </div>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        }

</div>

@code {
    [Parameter] public Guid CheckoutId { get; set; }

    private EquipmentCheckoutRecord? Loan { get; set; }

    private List<EquipmentCheckoutRenewalRecord> _renewals = [];
    private readonly Dictionary<Guid, string> _reviewNotes = [];
    private DateTime? _requestedDate;
    private string _requestNotes = string.Empty;
    private bool _busy;
    private bool _loading = true;
    private string? _error;

    private string GetReviewNote(Guid id) => _reviewNotes.TryGetValue(id, out var n) ? n : string.Empty;

    private static string RenewalLabel(EquipmentRenewalStatus s) => s switch
    {
        EquipmentRenewalStatus.Requested => "Waiting",
        EquipmentRenewalStatus.Approved  => "Granted",
        EquipmentRenewalStatus.Denied    => "Refused",
        _                                => s.ToString(),
    };

    private static string RenewalClass(EquipmentRenewalStatus s) => s switch
    {
        EquipmentRenewalStatus.Requested => "bg-warning text-dark",
        EquipmentRenewalStatus.Approved  => "bg-success",
        EquipmentRenewalStatus.Denied    => "bg-secondary",
        _                                => "bg-secondary",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }

        await LoadAsync();
    }

    /// <summary>
    /// Finds this loan among the caller's own. Both queues are asked because the same page serves
    /// borrower and lender, and the server only ever returns loans the caller is a party to — so a
    /// miss here means "not yours", which is the same answer as "does not exist".
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var mine = await AdminClient.GetMyEquipmentCheckoutsAsync("borrower");
        Loan = mine.FirstOrDefault(c => c.Id == CheckoutId);

        if (Loan is null)
        {
            var toApprove = await AdminClient.GetMyEquipmentCheckoutsAsync("approver");
            Loan = toApprove.FirstOrDefault(c => c.Id == CheckoutId);
        }

        if (Loan is not null)
        {
            _requestNotes = string.Empty;
            // Seed with a week past whatever it is due now, since that is the usual ask.
            _requestedDate = (Loan.DateDue ?? DateTime.Today).AddDays(7);
            await LoadRenewalsAsync();
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadRenewalsAsync()
    {
        if (Loan is null) return;
        _renewals = [.. await AdminClient.GetCheckoutRenewalsAsync(Loan.Id)];
        StateHasChanged();
    }

    private async Task RequestRenewalAsync()
    {
        if (Loan is null || _requestedDate is null) return;
        _busy = true;
        _error = null;

        var created = await AdminClient.RequestCheckoutRenewalAsync(Loan.Id, _requestedDate.Value,
            string.IsNullOrWhiteSpace(_requestNotes) ? null : _requestNotes.Trim());

        _busy = false;
        if (created is null)
        {
            _error = "That request couldn't be sent — check the date is later than the one it's already due back.";
            return;
        }

        _requestNotes = string.Empty;
        await LoadAsync();
    }

    private async Task ReviewAsync(EquipmentCheckoutRenewalRecord renewal, bool approve)
    {
        if (Loan is null) return;
        _busy = true;
        _error = null;

        var reviewed = await AdminClient.ReviewCheckoutRenewalAsync(
            Loan.Id, renewal.Id, approve, GetReviewNote(renewal.Id));

        _busy = false;
        if (reviewed is null)
        {
            _error = "That decision couldn't be saved — the request may have been withdrawn.";
            return;
        }

        // Granting one moves the loan's own due date, so re-read the loan, not just its renewals.
        await LoadAsync();
    }
}
