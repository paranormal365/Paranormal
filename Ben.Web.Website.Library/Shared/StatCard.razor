@*
    One number, said plainly — the template's dashboard idiom.

    Generalised from the three hand-rolled tiles on the sidecar telemetry page, which were the only
    stat cards in the app and were about to be copied a fourth and fifth time.

    The delta is optional and deliberately awkward to misuse: it takes the change AND the words for
    what it is change *over*, because "+3" on its own invites the reader to invent a timeframe. If
    you cannot say what the number is compared with, leave it out.
*@

<div class="card h-100">
    <div class="card-body d-flex align-items-start gap-3">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:2.75rem;height:2.75rem;background:color-mix(in srgb, var(--bs-primary) 12%, transparent);">
                <BenIcon Name="@Icon" />
            </div>
        }

        <div class="min-w-0">
            <div class="small text-secondary text-truncate">@Label</div>
            <div class="fs-4 lh-1 my-1">@Value</div>

            @if (Delta is not null)
            {
                <div class="small @DeltaClass">
                    @(Delta > 0 ? "+" : "")@Delta.Value.ToString("N0")
                    <span class="text-secondary">@DeltaCaption</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Caption))
            {
                <div class="small text-secondary">@Caption</div>
            }

            @* A sparkline belongs to the number above it, so it lives in the card rather than
               beside it. This is the slot Peity would have filled. *@
            @if (Sparkline is { Count: > 1 })
            {
                <div class="mt-1">
                    <ApexChart Type="sparkline" Height="34"
                               Series="@(new List<ApexChart.ChartSeries> { new(Label, Sparkline) })" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>What the number counts, in the reader's words.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = default!;

    /// <summary>The number itself, already formatted.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = default!;

    /// <summary>Feather icon name, as used elsewhere in the site.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Change since <see cref="DeltaCaption"/>. Null hides the line entirely.</summary>
    [Parameter] public int? Delta { get; set; }

    /// <summary>What the delta is measured against — "since last week", "this month".</summary>
    [Parameter] public string? DeltaCaption { get; set; }

    /// <summary>A note under the number, when there is no delta to show.</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>Recent values, drawn as a sparkline under the number.</summary>
    [Parameter] public IReadOnlyList<double>? Sparkline { get; set; }

    /// <summary>
    /// More is not always better — a rising count of overdue things is bad news. Callers say which
    /// direction is good rather than the card assuming green-for-up.
    /// </summary>
    [Parameter] public bool HigherIsBetter { get; set; } = true;

    private string DeltaClass => Delta switch
    {
        null or 0 => "text-secondary",
        > 0 => HigherIsBetter ? "text-success" : "text-danger",
        < 0 => HigherIsBetter ? "text-danger" : "text-success",
    };
}
