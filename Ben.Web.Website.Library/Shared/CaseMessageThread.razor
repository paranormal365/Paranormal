@* Reusable chat-style message thread for case client↔org dialogue. *@
@using Ben.Data.Common.Enums
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@using Ben.Web.Website.Library.Messaging
@inject IBenUserState UserState

@* ── Thread display ──────────────────────────────────────────────────────────── *@
@if (_messages is null)
{
    <BenLoaderOverlay Visible="true" Text="Loading messages…" />
}
else if (_result.Failed)
{
    @* "No messages yet" to a client whose group has written to them is the worst version of this
       bug: the thread is the only channel they have, and silence reads as being ignored. *@
    <BenListState TItem="CaseMessageRecord" Result="@_result" OnRetry="@ReloadAsync" />
}
else if (_messages.Count == 0)
{
    <div class="text-secondary small text-center py-3">
        No messages yet.
        @if (CurrentSide == CaseMessageSide.Client)
        {
            <span>Send a message to your investigation group below.</span>
        }
        else
        {
            <span>Send a message to the client below.</span>
        }
    </div>
}
else
{
    <div class="d-flex flex-column gap-2 mb-3" style="max-height:420px; overflow-y:auto;" @ref="_scrollRef">
        @foreach (var msg in _messages)
        {
            var isOwn = msg.SenderSide == CurrentSide;
            <div class="d-flex @(isOwn ? "justify-content-end" : "justify-content-start")">
                @* `bg-body-tertiary` rather than `bg-light`: the received bubble has to follow the
                   theme, and a fixed light fill turns into a white block in night mode. *@
                <div class="rounded-3 px-3 py-2 case-bubble @(isOwn ? "case-bubble--own bg-primary text-white" : "bg-body-tertiary border")"
                     style="max-width:80%; word-break:break-word;" data-testid="case-message-bubble">
                    @if (!isOwn)
                    {
                        <div class="fw-semibold small mb-1">@msg.AuthorDisplayName</div>
                    }
                    @* A message written in the editor (2026-09-14) carries a sanitized BodyHtml and is drawn
                       formatted. Everything else — older messages, and whatever the iPhone app sends — is
                       plain text in Body, drawn with its line breaks, as before. *@
                    <MessageBody Body="@(msg.BodyHtml ?? msg.Body)" Html="@(msg.BodyHtml is not null)" />
                    <div class="@(isOwn ? "text-white-50" : "text-muted") mt-1" style="font-size:.7rem;">
                        @msg.DateCreated.ToViewerLocalTime(UserState).ToDisplayDateTime()
                        @if (isOwn && CurrentSide == CaseMessageSide.Client && !msg.IsReadByOrg)
                        {
                            <span class="ms-1">· Unread</span>
                        }
                        @if (isOwn && CurrentSide == CaseMessageSide.Organization && !msg.IsReadByClient)
                        {
                            <span class="ms-1">· Unread</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Compose box ─────────────────────────────────────────────────────────────── *@
@* A small formatting editor (beta feedback, 2026-09-14), the same short toolbar as case notes. Send is not
   disabled while the box looks empty: the editor's value reaches the server a round trip behind the keyboard,
   so a disabled button would sit dead for someone who types and clicks straight through. Sending nothing says
   so instead. *@
<div class="mt-2" data-testid="case-thread-compose">
    @* Keyed by the number of messages sent: after a send the box is a new editor, so a keystroke update still on
       its way from the old one (Telerik reports typing on a debounce) cannot put the sent words back. *@
    <BenEditor @key="_composeGeneration" @ref="_compose" @bind-Value="@_draft" Height="130px" Tools="@Ben.Web.Website.Library.Organization.Cases.CaseEditorTools.Prose" />
    <BenComposerLinkCard Html="@_draft" />
    <div class="d-flex justify-content-end mt-2">
        <button type="button" class="btn btn-primary" id="case-thread-send"
                disabled="@_sending"
                @onclick="Send">
            <BenIcon Name="mail" Class="me-1" />@(_sending ? "Sending…" : "Send")
        </button>
    </div>
</div>
@if (_error is not null)
{
    <div class="alert alert-danger mt-2 mb-0 py-2 small">@_error</div>
}

@code {
    /// <summary>Which side the current viewer is on (determines bubble alignment and read markers).</summary>
    [Parameter, EditorRequired] public CaseMessageSide CurrentSide { get; set; }

    /// <summary>Async function to load messages.</summary>
    /// <remarks>
    /// Returns <see cref="LoadResult{T}"/> rather than a bare list so a refused thread is not
    /// drawn as an empty one — see item 120.
    /// </remarks>
    [Parameter, EditorRequired] public Func<Task<LoadResult<CaseMessageRecord>>> LoadMessages { get; set; } = null!;

    /// <summary>Async function to post a new message (the editor's HTML) and return the saved record.</summary>
    [Parameter, EditorRequired] public Func<string, Task<CaseMessageRecord?>> PostMessage { get; set; } = null!;

    private List<CaseMessageRecord>? _messages;
    private LoadResult<CaseMessageRecord> _result;
    private string _draft = string.Empty;
    private BenEditor? _compose;
    private int _composeGeneration;
    private bool _sending;
    private string? _error;
    private ElementReference _scrollRef;

    /// <summary>
    /// Bumped whenever the local list is changed by something other than the initial load. A load
    /// that started before that change is stale by the time it returns, and applying it would drop
    /// the newer message — which is exactly what happened when a message was sent while the thread
    /// was still loading: it posted and saved, then vanished from the screen when the load landed.
    /// </summary>
    private int _revision;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        var revision = _revision;
        try
        {
            var loaded = await LoadMessages();
            if (revision != _revision) return;   // superseded by a send
            _result   = loaded;
            _messages = loaded.Items.ToList();
        }
        catch
        {
            if (revision != _revision) return;
            // A throw and a refusal are the same thing to the reader: the thread did not load.
            _result   = LoadResult<CaseMessageRecord>.Failure();
            _messages = [];
        }
    }

    private async Task Send()
    {
        if (_sending) return;
        // What is in the box now, not the last debounced value — see BenEditor.GetCurrentHtmlAsync.
        if (_compose is not null) _draft = await _compose.GetCurrentHtmlAsync() ?? _draft;
        if (!Ben.Data.Common.Text.PlainTextHtml.HasText(_draft))
        {
            _error = "Type a message first.";
            return;
        }
        _sending = true;
        _error = null;
        var body = _draft.Trim();
        try
        {
            var saved = await PostMessage(body);
            if (saved is null)
            {
                // Nothing came back, so there is nothing to show. Say so rather than appending a
                // null, which the previous guard allowed through: it tested `saved` before
                // creating the list but not before adding to it. The words stay in the box.
                _error = "Failed to send message. Please try again.";
                return;
            }

            // Sent: an empty box, and a new editor instance so nothing typed before the send can come back.
            _draft = string.Empty;
            _composeGeneration++;

            _messages ??= [];
            _messages.Add(saved);
            // The thread is on screen now, whatever the earlier load did — leaving the failure
            // panel up beside a message the person can see would be its own untruth.
            _result = LoadResult<CaseMessageRecord>.Ok(_messages);
            _revision++;   // any load still in flight is now stale
        }
        catch
        {
            _error = "Failed to send message. Please try again.";   // the words stay in the box
        }
        finally { _sending = false; }
    }
}
