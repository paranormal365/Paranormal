@page "/places/{PlaceId:guid}"
@namespace Ben.Web.Website.Library.Shared

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@*
   A place, and the history of what has happened there.

   Works signed-out. A visitor gets the anonymous endpoint and sees only what somebody published;
   a member gets the authenticated one and additionally sees their own group's work and anything
   shared with groups who have investigated here. Both filter on the server — this page never
   decides who may see what.
*@

<PageTitle>@(_place?.Name ?? "Place") — IsHaunted</PageTitle>

<div class="container-fluid px-3 py-4" style="max-width:900px; margin:auto;">

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    }
    else if (_place is null)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h5 class="mb-2">We can't find that place</h5>
                <p class="text-secondary mb-0">The link may be incomplete, or the place may have been removed.</p>
            </div>
        </div>
    }
    else
    {
        @* Only for members. The document explaining place pages is written for people who run
           investigations, and a visitor following this link would land on "topic isn't
           available" — worse than no link at all. *@
        <h3 class="mb-1">@Title@if (UserState.IsAuthenticated)
            {
                <HelpLink Slug="working-a-case" Anchor="place-pages" />
            }</h3>
        <p class="text-secondary mb-1">
            @LocationLine
            @if (_place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation)
            {
                <span class="badge bg-info text-dark ms-2">Public location</span>
            }
        </p>

        @* Rooms (item 197). Offered once per group the viewer belongs to, because rooms are named
           PER GROUP for a shared place — a hotel describes its own building, a group that visits
           keeps its own list, and neither sees the other's. Without a link here the page existed
           only for somebody who already knew its address, which is the write-only shape this
           codebase keeps finding. *@
        @if (_myOrgs.Count > 0)
        {
            <p class="mb-2 small">
                @foreach (var org in _myOrgs)
                {
                    <a class="btn btn-sm btn-outline-secondary me-1 mb-1"
                       href="@($"/organizations/{org.OrganizationId}/places/{PlaceId}/rooms")">
                        <BenIcon Name="home" Class="me-1" />Rooms
                        @if (_myOrgs.Count > 1)
                        {
                            <span class="text-secondary">· @org.Name</span>
                        }
                    </a>
                }
            </p>
        }

        @* The line that turns a list into a history. Counted over what this viewer may see, so it
           never advertises how much is being withheld. *@
        @if (_summary is { InvestigationCount: > 0 } s)
        {
            <p class="mb-4">
                <strong>@s.InvestigationCount</strong>
                @(s.InvestigationCount == 1 ? "investigation" : "investigations")
                by <strong>@s.OrganizationCount</strong>
                @(s.OrganizationCount == 1 ? "group" : "groups")
                @if (s.Since is { } year)
                {
                    <text> since @year</text>
                }
            </p>
        }

        @if (_place.Latitude.HasValue && _place.Longitude.HasValue)
        {
            <InvestigationsMap Pins="@_pins" Height="300px" />
        }
        else if (!string.IsNullOrWhiteSpace(_place.GeocodeNote))
        {
            @* Says why there is no map rather than leaving a blank where one should be. *@
            <div class="alert alert-warning py-2 small">@_place.GeocodeNote</div>
        }

        @* ── Signed-in view ───────────────────────────────────────────────── *@
        @if (_rows is not null)
        {
            var mine = _rows.Where(r => r.IsMine).ToList();
            var shared = _rows.Where(r => !r.IsMine).ToList();

            @if (mine.Count > 0)
            {
                @* Plural: somebody can belong to more than one group, and this list then mixes
                   them — as it does in the dev data. "Your group's" would quietly claim otherwise. *@
                <h6 class="fw-semibold mt-4">Your groups' visits</h6>
                @SignedInTable(mine, showVisibility: true)
            }

            <h6 class="fw-semibold mt-4">Shared by other groups</h6>
            @if (shared.Count == 0)
            {
                <p class="text-secondary small fst-italic">
                    Nothing from other groups yet. Anything they choose to share about this place
                    will appear here.
                </p>
            }
            else
            {
                @SignedInTable(shared, showVisibility: false)
            }
        }

        @* ── The field archive ────────────────────────────────────────────── *@
        @* The part of this page no other tool has. One person's readings at a location are an
           anecdote; the same location recorded by eleven people over two years is either a
           persistent artifact or a demonstrated absence of one. Shown to visitor and member
           alike from the anonymous endpoint, because published is published. *@
        @if (_sessions is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">Field archive</h6>
            <p class="text-secondary small mb-2">
                <strong>@_sessions.Count</strong>
                @(_sessions.Count == 1 ? "session" : "sessions")
                by <strong>@_sessions.Select(x => x.ContributorAppUserId).Distinct().Count()</strong>
                @(_sessions.Select(x => x.ContributorAppUserId).Distinct().Count() == 1 ? "person" : "people"),
                <strong>@_sessions.Sum(x => x.MarkerCount)</strong> flagged
                @(_sessions.Sum(x => x.MarkerCount) == 1 ? "moment" : "moments") between them.
                Readings are what people recorded; what they mean is for you to judge.
            </p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr>
                        <th>When</th><th>Who</th><th>Where they stood</th>
                        <th class="text-end">Readings</th><th class="text-end">Flagged</th><th>Device</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var fs in _sessions)
                        {
                            <tr>
                                <td class="text-nowrap">@fs.StartedAt.ToLocalTime().ToDisplayDate()</td>
                                <td><UserNameLink AppUserId="@fs.ContributorAppUserId" DisplayName="@fs.ContributorName" /></td>
                                <td>@(string.IsNullOrWhiteSpace(fs.LocationLabel) ? "—" : fs.LocationLabel)</td>
                                <td class="text-end">@fs.ReadingCount.ToString("N0")</td>
                                @* The single most comparable number across visits — "eleven of
                                   twelve people flagged something on those stairs". *@
                                <td class="text-end">
                                    @if (fs.MarkerCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@fs.MarkerCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">0</span>
                                    }
                                </td>
                                <td class="text-secondary small">@fs.DeviceModel</td>
                            </tr>
                            @* The recordings themselves, in a row under the numbers they belong
                               to. Media shipped as a COUNT nobody could open, which asked a
                               reader to take the archive on faith — the one thing the archive
                               exists to end. Empty while a flag is being looked at. *@
                            @if (fs.ApprovedMediaCount > 0)
                            {
                                <tr>
                                    <td colspan="6" class="pt-0 pb-3">
                                        <div class="d-flex flex-wrap gap-2 align-items-start">
                                            @foreach (var m in fs.Media!)
                                            {
                                                var url = AdminClient.GetArchiveMediaUrl(fs.Id, m.UploadFileId);
                                                @if (m.ContentType.StartsWith("image/"))
                                                {
                                                    <a href="@url" target="_blank" rel="noopener"
                                                       title="@m.RelativePath">
                                                        <img src="@url" alt="@m.RelativePath"
                                                             class="rounded border"
                                                             style="height:96px;width:auto;object-fit:cover;" />
                                                    </a>
                                                }
                                                else if (m.ContentType.StartsWith("audio/"))
                                                {
                                                    <span class="d-inline-block">
                                                        <audio controls preload="none" src="@url"
                                                               style="height:40px;max-width:260px;"></audio>
                                                        <span class="d-block text-secondary"
                                                              style="font-size:.7rem;">@m.RelativePath</span>
                                                    </span>
                                                }
                                                else if (m.ContentType.StartsWith("video/"))
                                                {
                                                    <video controls preload="metadata" src="@url"
                                                           class="rounded border"
                                                           style="height:140px;max-width:260px;"></video>
                                                }
                                                else
                                                {
                                                    <a href="@url" target="_blank" rel="noopener"
                                                       class="btn btn-outline-secondary btn-sm">
                                                        <BenIcon Name="file" Class="me-1" />@m.RelativePath
                                                    </a>
                                                }
                                            }

                                            @* The report path. Shown to everyone, because a
                                               control that appears only for people who can use it
                                               leaves a visitor with nothing to do about a picture
                                               they object to. Flagging needs an account: one flag
                                               hides, so an anonymous version would let anybody
                                               erase the archive. *@
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-secondary text-nowrap align-self-center"
                                                    disabled="@(_flagging == fs.Id)"
                                                    @onclick="@(() => FlagAsync(fs.Id))">
                                                <BenIcon Name="alert-triangle" Class="me-1" />
                                                @(_flagging == fs.Id ? "Reporting…" : "Report")
                                            </button>
                                        </div>
                                        @if (_flagMessage.TryGetValue(fs.Id, out var note))
                                        {
                                            <div class="small mt-1 @(note.Ok ? "text-success" : "text-danger")">
                                                @note.Text
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-secondary small fst-italic mt-2 mb-0">
                Magnetic field readings only — a phone measures the DC field, not the AC fields a
                K-II style meter responds to, and different phones differ. Compare visits with that
                in mind.
            </p>
        }

        @* ── What guests photographed on events here ──────────────────────── *@
        @* A tour walks the same route every week, which makes public events the one activity
           that happens repeatedly at a fixed location — so this is where the archive fills
           fastest. Kept as its own section rather than folded into the sessions table, because
           one picture from a walk is not a night of readings and a table of magnetometer
           columns is the wrong shape for it. *@
        @if (_evidence is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">From events here</h6>
            <p class="text-secondary small mb-2">
                Contributed by the people who took them, on public events at this place.
            </p>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var ev in _evidence)
                {
                    var url = AdminClient.GetEventEvidenceFileUrl(ev.OrgCalendarEventId, ev.SubmissionId);
                    <div class="card" style="width:220px;">
                        @if (ev.ContentType.StartsWith("image/"))
                        {
                            <a href="@url" target="_blank" rel="noopener">
                                <img src="@url" alt="@ev.EventTitle" class="card-img-top"
                                     style="height:150px;object-fit:cover;" />
                            </a>
                        }
                        else if (ev.ContentType.StartsWith("video/"))
                        {
                            <video controls preload="metadata" src="@url" style="width:100%;height:150px;"></video>
                        }
                        else if (ev.ContentType.StartsWith("audio/"))
                        {
                            <audio controls preload="none" src="@url" class="w-100 mt-2"></audio>
                        }
                        <div class="card-body p-2">
                            <div class="small fw-semibold text-truncate">@ev.EventTitle</div>
                            <div class="text-secondary" style="font-size:.75rem;">
                                @* The operator's name, on a page they did not have to buy an ad
                                   on — the tour that ran the walk earned the credit. *@
                                <a href="/organizations/@ev.OrganizationId">@ev.OrganizationName</a>
                                · @ev.EventStartedAt.ToLocalTime().ToDisplayDate()
                            </div>
                            <div class="text-secondary" style="font-size:.75rem;">
                                by <UserNameLink AppUserId="@ev.ContributorAppUserId" DisplayName="@ev.ContributorName" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ev.Note))
                            {
                                <div class="small mt-1">@ev.Note</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Visitor view ─────────────────────────────────────────────────── *@
        @if (_publicRows is not null)
        {
            <h6 class="fw-semibold mt-4">Published investigations</h6>
            @if (_rowsResult.Failed)
            {
                @* A place shown with no investigations reads as somewhere nothing has happened. *@
                <BenListState TItem="PlaceInvestigationRow" Result="@_rowsResult" OnRetry="@LoadSignedInAsync" />
            }
            else if (_publicRows.Count == 0)
            {
                <p class="text-secondary small fst-italic">
                    Nothing has been published about this place yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>When</th><th>Investigation</th><th>Group</th></tr></thead>
                        <tbody>
                            @foreach (var row in _publicRows)
                            {
                                <tr>
                                    <td class="text-nowrap">@row.ScheduledDateTime.ToLocalTime().ToDisplayDate()</td>
                                    <td>
                                        @if (row.UrlName is string invSlug)
                                        {
                                            <a href="@($"/o/{row.OrganizationUrlName}/investigations/{invSlug}")">@row.Title</a>
                                        }
                                        else
                                        {
                                            @row.Title
                                        }
                                    </td>
                                    <td><a href="/@row.OrganizationUrlName">@row.OrganizationName</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public Guid PlaceId { get; set; }

    private List<Ben.Web.Services.PublicPlaceSessionRow>? _sessions;

    private PlaceRecord? _place;
    private PlaceSummary? _summary;
    private List<PlaceInvestigationRow>? _rows;
    private LoadResult<PlaceInvestigationRow> _rowsResult;
    private List<PublicPlaceInvestigationRow>? _publicRows;
    private List<InvestigationMapPin> _pins = [];
    private bool _loading = true;

    /// <summary>
    /// The groups this viewer belongs to, so the rooms link can name which one it means.
    /// </summary>
    /// <remarks>
    /// Empty for a signed-out visitor, and that is the whole gate: rooms are a group's own notes
    /// about a building, so somebody with no group has nothing to link to.
    /// </remarks>
    private IReadOnlyList<MyMembershipOrgItem> _myOrgs = [];

    /// <summary>The session whose Report button is mid-flight, so it can disable just that one.</summary>
    private Guid? _flagging;

    /// <summary>What to say under a session's gallery after its Report button was used.</summary>
    private readonly Dictionary<Guid, (bool Ok, string Text)> _flagMessage = [];

    /// <summary>Guest evidence published to this place from public events held here.</summary>
    private List<PlaceEvidenceRow>? _evidence;

    private string Title => string.IsNullOrWhiteSpace(_place?.Name)
        ? (string.IsNullOrWhiteSpace(_place?.StreetAddress1) ? "Place" : _place!.StreetAddress1!)
        : _place!.Name!;

    private string LocationLine => string.Join(", ",
        new[] { _place?.City, _place?.State }.Where(v => !string.IsNullOrWhiteSpace(v)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Not gated on being signed in — the page has a visitor view. But it does wait for auth to
        // settle, because which of the two views to load depends on the answer.
        await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive);

        if (UserState.IsAuthenticated) await LoadSignedInAsync();
        else await LoadVisitorAsync();

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadSignedInAsync()
    {
        _place = await AdminClient.GetPlaceAsync(PlaceId);
        if (_place is null) return;

        _rowsResult = await AdminClient.GetPlaceInvestigationsAsync(PlaceId);
        _rows       = _rowsResult.Items.ToList();
        _summary = await AdminClient.GetPlaceSummaryAsync(PlaceId);

        // For the rooms link. A failure here costs a link, not the page, so it is not reported —
        // the rest of this view is about the place itself and stands without it.
        _myOrgs = (await AdminClient.GetMyMembershipOrganizationsAsync()).Items;
        await LoadArchiveAsync();
        BuildPins(_rows.Select(r => (r.Id, r.Title)));
    }

    private async Task LoadVisitorAsync()
    {
        var response = await AdminClient.GetPublicPlaceAsync(PlaceId);
        if (response is null) return;

        _place = response.Place;
        _publicRows = response.Investigations.ToList();
        _summary = response.Summary;
        _sessions = response.Sessions?.ToList();
        _evidence = response.EventEvidence?.ToList();
        BuildPins(_publicRows.Select(r => (r.Id, r.Title)));
    }

    /// <summary>
    /// The archive, for a signed-in reader.
    /// </summary>
    /// <remarks>
    /// Deliberately the SAME anonymous endpoint the visitor view uses. Published is published, and
    /// a second query with its own idea of who may see what is how the rule that holds in one
    /// place stops holding in the other. A failure costs the archive, not the page.
    /// </remarks>
    private async Task LoadArchiveAsync()
    {
        var response = await AdminClient.GetPublicPlaceAsync(PlaceId);
        _sessions = response?.Sessions?.ToList();
        _evidence = response?.EventEvidence?.ToList();
    }

    /// <summary>
    /// Reports a session's media, which hides it until somebody looks.
    /// </summary>
    /// <remarks>
    /// <para><b>A visitor is answered here rather than by the server.</b> The endpoint requires an
    /// account — one flag hides, so an anonymous version would let anybody erase the archive's
    /// pictures — and a signed-out reader clicking Report would otherwise get a bare 401 the page
    /// turns into "something went wrong". Saying what to do instead is the whole point of showing
    /// the control to everybody.</para>
    ///
    /// <para>The archive is reloaded on success so the gallery empties in front of the person who
    /// objected. Being told "reported" while the picture stays on screen reads as a report that
    /// did nothing.</para>
    /// </remarks>
    private async Task FlagAsync(Guid sessionId)
    {
        if (!UserState.IsAuthenticated)
        {
            _flagMessage[sessionId] =
                (false, "Please sign in to report this — an account is needed so a report can be traced.");
            return;
        }

        _flagging = sessionId;
        _flagMessage.Remove(sessionId);
        StateHasChanged();

        var (ok, error) = await AdminClient.FlagFieldSessionAsync(sessionId, reason: null);

        _flagging = null;
        _flagMessage[sessionId] = ok
            ? (true, "Reported. It's hidden until a moderator has looked at it.")
            : (false, error ?? "Couldn't report that just now. Please try again.");

        if (ok) await LoadArchiveAsync();
        StateHasChanged();
    }

    /// <summary>
    /// One pin per visible investigation, all at the place's own coordinates.
    /// </summary>
    /// <remarks>
    /// They stack into a single clustered marker with a count, which is the honest picture: this is
    /// one location that has been visited repeatedly, not several nearby ones.
    /// </remarks>
    private void BuildPins(IEnumerable<(Guid Id, string Title)> rows)
    {
        if (_place?.Latitude is null || _place.Longitude is null) return;

        _pins = rows
            .Select(r => new InvestigationMapPin(
                r.Id, r.Title, _place.Latitude, _place.Longitude, IsPast: true))
            .ToList();
    }

    private RenderFragment SignedInTable(List<PlaceInvestigationRow> rows, bool showVisibility) =>@<div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Investigation</th>
                    <th>Group</th>
                    @if (showVisibility)
                    {
                        <th>Shared with</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="text-nowrap">@row.ScheduledDateTime.ToLocalTime().ToDisplayDate()</td>
                        <td>@row.Title</td>
                        <td>@row.OrganizationName</td>
                        @if (showVisibility)
                        {
                            @* Shown only on your own group's rows: how another group chose to share
                               something is their business, not a fact to publish back at everyone. *@
                            <td><span class="badge @VisibilityBadge(row.Visibility)">@VisibilityLabel(row.Visibility)</span></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    private static string VisibilityLabel(Ben.Data.Common.Enums.InvestigationVisibility v) => v switch
    {
        Ben.Data.Common.Enums.InvestigationVisibility.Public => "Anyone",
        Ben.Data.Common.Enums.InvestigationVisibility.PlaceInvestigators => "Groups who investigated here",
        _ => "Just us",
    };

    private static string VisibilityBadge(Ben.Data.Common.Enums.InvestigationVisibility v) => v switch
    {
        Ben.Data.Common.Enums.InvestigationVisibility.Public => "bg-info text-dark",
        Ben.Data.Common.Enums.InvestigationVisibility.PlaceInvestigators => "bg-primary",
        _ => "bg-secondary",
    };
}
