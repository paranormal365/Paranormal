@page "/places/{PlaceId:guid}"
@namespace Ben.Web.Website.Library.Shared

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@* The feed's own composer and card, reused rather than forked (2026-09-17). Without this using,
   Razor does not recognise <FeedComposer> as a component and emits it as a literal HTML element —
   no error, no warning, just an empty <feedcomposer> tag in the page. Which is exactly what
   happened, and what cost an hour of looking at the server. *@
@using Ben.Web.Website.Library.Feed
@* And the scheduling window, for the same reason and after making the same mistake twice in one
   afternoon: without this, <NewInvestigationWindow> emitted an empty <newinvestigationwindow>
   element and the button that opens it did nothing at all. *@
@using Ben.Web.Website.Library.Organization

@*
   A place, and the history of what has happened there.

   Works signed-out. A visitor gets the anonymous endpoint and sees only what somebody published;
   a member gets the authenticated one and additionally sees their own group's work and anything
   shared with groups who have investigated here. Both filter on the server — this page never
   decides who may see what.
*@

<PageTitle>@(_place?.Name ?? "Place") — IsHaunted</PageTitle>

<div class="container-fluid px-3 py-4" style="max-width:900px; margin:0 auto;">

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    }
    else if (_place is null)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h5 class="mb-2">We can't find that place</h5>
                <p class="text-secondary mb-0">The link may be incomplete, or the place may have been removed.</p>
            </div>
        </div>
    }
    else
    {
        @* Only for members. The document explaining place pages is written for people who run
           investigations, and a visitor following this link would land on "topic isn't
           available" — worse than no link at all. *@
        <h3 class="mb-1">@Title@if (UserState.IsAuthenticated)
            {
                <HelpLink Slug="working-a-case" Anchor="place-pages" />
            }</h3>
        <p class="text-secondary mb-1">
            @LocationLine
            @if (_place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation)
            {
                <span class="badge bg-info text-dark ms-2">Public location</span>
            }
        </p>

        @* Rooms (item 197). Offered once per group the viewer belongs to, because rooms are named
           PER GROUP for a shared place — a hotel describes its own building, a group that visits
           keeps its own list, and neither sees the other's. Without a link here the page existed
           only for somebody who already knew its address, which is the write-only shape this
           codebase keeps finding. *@
        @if (_myOrgs.Count > 0)
        {
            <p class="mb-2 small">
                @foreach (var org in _myOrgs)
                {
                    <a class="btn btn-sm btn-outline-secondary me-1 mb-1"
                       href="@($"/organizations/{org.OrganizationId}/places/{PlaceId}/rooms")">
                        <BenIcon Name="home" Class="me-1" />Rooms
                        @if (_myOrgs.Count > 1)
                        {
                            <span class="text-secondary">· @org.Name</span>
                        }
                    </a>
                    @* Item 235 phase 9: where a group notices "this place is ours". *@
                    <a class="btn btn-sm btn-outline-secondary me-1 mb-1 place-our-venue"
                       href="@($"/organizations/{org.OrganizationId}/venue?place={PlaceId}")">
                        <BenIcon Name="map-pin" Class="me-1" />Our venue
                        @if (_myOrgs.Count > 1)
                        {
                            <span class="text-secondary">· @org.Name</span>
                        }
                    </a>
                    @* Ben, 2026-09-17: "if someone wants to create a case at a public case, they
                       are given the option to link to the existing case and create their own
                       investigation." This is the case half — the place is carried in the query, so
                       the form arrives with it settled rather than asking for an address somebody
                       is already looking at. Offered at a public location only: a case at
                       somebody's home starts from the client, not from a page anyone can read. *@
                    @if (_place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation
                         && _mayOpenCaseIn.Contains(org.OrganizationId))
                    {
                        <a class="btn btn-sm btn-outline-secondary me-1 mb-1 place-open-case"
                           href="@($"/organizations/{org.OrganizationId}/cases/new?place={PlaceId}")">
                            <BenIcon Name="folder-plus" Class="me-1" />Open a case here
                            @if (_myOrgs.Count > 1)
                            {
                                <span class="text-secondary">· @org.Name</span>
                            }
                        </a>
                    }

                    @if (_place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation
                         && _mayInvestigateIn.Contains(org.OrganizationId))
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1 place-investigate"
                                @onclick="@(() => InvestigateWith(org.OrganizationId))">
                            <BenIcon Name="calendar" Class="me-1" />Investigate here
                            @if (_myOrgs.Count > 1)
                            {
                                <span class="text-secondary">· @org.Name</span>
                            }
                        </button>
                    }
                }
            </p>
        }

        @* ── The door for somebody in no group at all (2026-09-17) ────────────
           Ben: everything a solo person submits is public by default. Until now a person with no
           group could record from the phone and nothing else — every other feature is org-scoped
           and they had no org, and the endpoint that mints one had no caller anywhere on the site.
           This is it. Offered only at a public location: a visit to somebody's home starts with
           the client, not from a page anyone can read. *@
        @if (UserState.IsAuthenticated && _myOrgs.Count == 0
             && _place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation)
        {
            <p class="mb-2">
                <button type="button" class="btn btn-sm btn-primary place-investigate-solo"
                        disabled="@_startingSolo" @onclick="@(() => _offeringSolo = true)">
                    <BenIcon Name="calendar" Class="me-1" />Start investigating on your own
                </button>
            </p>
        }

        @* The sentence before the act, not after it: minting a space and publishing by default are
           both things somebody should agree to knowingly. BenModal, never TelerikDialog. *@
        <BenModal @bind-Visible="@_offeringSolo" Title="Investigating on your own" Size="sm">
            <ChildContent>
                <p>
                    This creates a private space of your own to keep investigations in. It is free,
                    and it is yours — nobody else joins it and it never appears in any list of groups.
                </p>
                <p class="mb-0">
                    On a free account, what you record at a public location like
                    <strong>@Title</strong> is <strong>public</strong>: it joins this place's page
                    where anybody can read it. That is the bargain, and it is what makes a place's
                    record worth reading. A plan is what makes your work yours instead.
                </p>
                @if (_soloError is not null)
                {
                    <div class="alert alert-danger py-2 small mt-3 mb-0" data-testid="solo-error">@_soloError</div>
                }
            </ChildContent>
            <FooterContent>
                <button type="button" class="btn btn-outline-secondary"
                        disabled="@_startingSolo" @onclick="@(() => _offeringSolo = false)">Cancel</button>
                <button type="button" class="btn btn-primary" data-testid="solo-confirm"
                        disabled="@_startingSolo" @onclick="StartInvestigatingAloneAsync">
                    @(_startingSolo ? "Setting it up…" : "Create it and carry on")
                </button>
            </FooterContent>
        </BenModal>

        @* The scheduling window, for whichever organization was chosen above — one of the reader's
           groups, or the personal one just minted. *@
        @if (_investigatingWith is { } investigatingOrgId)
        {
            <NewInvestigationWindow OrgId="@investigatingOrgId"
                                    PrechosenPlaceId="@PlaceId"
                                    OnCreated="@OnInvestigationScheduledAsync"
                                    OnClosed="@(() => _investigatingWith = null)" />
        }

        @* Who runs this place as its venue, when somebody has been confirmed as it (item 235 phase 9).
           For everybody: which hotel this is, and where its own page is, is not a members' secret. *@
        @if (_venue is { } venue)
        {
            <p class="mb-3" id="place-venue-line">
                Run as a venue by <strong>@venue.OrganizationName</strong>
                @if (venue.VenuePageUrl is { Length: > 0 } url)
                {
                    <text> · </text><a href="@url">Venue page</a>
                }
            </p>
        }

        @* How to reach the place, and — for a signed-in member of a group, when nobody runs it as a
           venue yet — the question that starts a claim (item 235 phase 9). Asked here because this
           is where somebody notices "this is ours". *@
        @if (_venue is null && _myOrgs.Count > 0)
        {
            <p class="small mb-2" id="place-claim-line">
                Is this your venue?
                @foreach (var org in _myOrgs)
                {
                    <a class="ms-1 place-claim-link" href="@($"/organizations/{org.OrganizationId}/venue/claim?place={PlaceId}")">
                        Claim it for @org.Name
                    </a>
                }
            </p>
        }
        <Ben.Web.Website.Library.Manage.Venue.PlaceContactsCard PlaceId="PlaceId"
                                                               SignedIn="UserState.IsAuthenticated"
                                                               MyOrgs="_myOrgs" />

        @* The line that turns a list into a history. Counted over what this viewer may see, so it
           never advertises how much is being withheld. *@
        @if (_summary is { InvestigationCount: > 0 } s)
        {
            <p class="mb-4">
                <strong>@s.InvestigationCount</strong>
                @(s.InvestigationCount == 1 ? "investigation" : "investigations")
                by <strong>@s.OrganizationCount</strong>
                @(s.OrganizationCount == 1 ? "group" : "groups")
                @if (s.Since is { } year)
                {
                    <text> since @year</text>
                }
            </p>
        }

        @if (_place.Latitude.HasValue && _place.Longitude.HasValue)
        {
            <InvestigationsMap Pins="@_pins" Height="300px" />
        }
        else if (!string.IsNullOrWhiteSpace(_place.GeocodeNote))
        {
            @* Says why there is no map rather than leaving a blank where one should be. *@
            <div class="alert alert-warning py-2 small">@_place.GeocodeNote</div>
        }

        @* ── Signed-in view ───────────────────────────────────────────────── *@
        @if (_rows is not null)
        {
            var mine = _rows.Where(r => r.IsMine).ToList();
            var shared = _rows.Where(r => !r.IsMine).ToList();

            @if (mine.Count > 0)
            {
                @* Plural: somebody can belong to more than one group, and this list then mixes
                   them — as it does in the dev data. "Your group's" would quietly claim otherwise. *@
                <h6 class="fw-semibold mt-4">Your groups' visits</h6>
                @SignedInTable(mine, showVisibility: true)
            }

            <h6 class="fw-semibold mt-4">Shared by other groups</h6>
            @if (shared.Count == 0)
            {
                <p class="text-secondary small fst-italic">
                    Nothing from other groups yet. Anything they choose to share about this place
                    will appear here.
                </p>
            }
            else
            {
                @SignedInTable(shared, showVisibility: false)
            }
        }

        @* ── Your own groups' cases here ──────────────────────────────────── *@
        @* The question a member actually arrives with: do we already have a case here? The public
           list below cannot answer it, because the answer is usually a case nobody published and
           never will. Scoped to the reader's own groups — another group's unpublished case is
           their business, and having one is itself something they have not shared. *@
        @if (_myCases is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">Your groups' cases here</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" data-testid="place-my-cases">
                    <thead><tr><th>Opened</th><th>Case</th><th>Group</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var row in _myCases)
                        {
                            <tr>
                                <td class="text-nowrap">@row.DateCaseOpened.ToDisplayDate()</td>
                                <td>
                                    <a href="@($"/organizations/{row.OrganizationId}/cases/{row.Id}")">
                                        @row.CaseReference — @row.Title
                                    </a>
                                </td>
                                <td>@row.OrganizationName</td>
                                <td class="text-nowrap">
                                    <span class="badge @row.Status.BadgeClass()">@row.Status.Label()</span>
                                    @if (row.IsPublished)
                                    {
                                        <span class="badge text-bg-info ms-1 fw-normal">Published</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ── Posts about this place ───────────────────────────────────────── *@
        @* Ben, 2026-09-17: a public location should be "actually public for adding files,
           messages etc". These are ordinary feed posts carrying this place, which is what gives
           them the screener, the upload pause after repeated refusals, reporting, hiding and the
           moderator queues — and the phone app reads them already. The composer is offered to
           anybody signed in, wider than the feed's front page on purpose: this record is the free
           lane's whole point and somebody with no group is exactly who fills it. *@
        @if (_canPost || _posts is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">Posts about this place</h6>

            @if (_canPost)
            {
                <div class="mb-3" data-testid="place-composer">
                    <FeedComposer AboutPlaceId="@PlaceId"
                                  Placeholder="@($"What did you find at {Title}?")"
                                  OnPosted="OnPlacePosted" />
                </div>
            }

            @if (_posts is { Count: > 0 })
            {
                <div class="d-flex flex-column gap-3" data-testid="place-posts">
                    @foreach (var post in _posts)
                    {
                        <FeedPostCard Post="@post" />
                    }
                </div>

                @* Only when there may be more than the page shows, so the link never promises a
                   page identical to the one already being read. *@
                @if (_posts.Count >= PlacePostsShown)
                {
                    <p class="mt-2 mb-0">
                        <a href="@($"/feed/places/{PlaceId}")">See all posts about this place</a>
                    </p>
                }
            }
            else if (_canPost)
            {
                <p class="text-secondary small fst-italic" data-testid="place-posts-empty">
                    Nothing posted about this place yet. Yours would be the first.
                </p>
            }
        }

        @* ── Cases written up here ────────────────────────────────────────── *@
        @* Rendered for visitor and member alike from the anonymous endpoint, because published is
           published. A case reaches this list only when its group published it AND its status says
           so; a client's real name is replaced by the server before it ever arrives here. *@
        @if (_cases is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">Cases written up here</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" data-testid="place-cases">
                    <thead><tr><th>Opened</th><th>Case</th><th>Group</th></tr></thead>
                    <tbody>
                        @foreach (var row in _cases)
                        {
                            <tr>
                                <td class="text-nowrap">@row.OpenedYear</td>
                                <td>
                                    <a href="@($"/o/{row.OrganizationUrlName}/cases/{row.UrlName}")">@row.Title</a>
                                    @if (row.Status == Ben.Data.Common.Enums.CaseStatus.Haunted)
                                    {
                                        <span class="badge text-bg-danger ms-1 fw-normal">Haunted</span>
                                    }
                                </td>
                                <td><a href="@($"/o/{row.OrganizationUrlName}")">@row.OrganizationName</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ── The field archive ────────────────────────────────────────────── *@
        @* The part of this page no other tool has. One person's readings at a location are an
           anecdote; the same location recorded by eleven people over two years is either a
           persistent artifact or a demonstrated absence of one. Shown to visitor and member
           alike from the anonymous endpoint, because published is published. *@
        @if (_sessions is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">Field archive</h6>
            <p class="text-secondary small mb-2">
                <strong>@_sessions.Count</strong>
                @(_sessions.Count == 1 ? "session" : "sessions")
                by <strong>@_sessions.Select(x => x.ContributorAppUserId).Distinct().Count()</strong>
                @(_sessions.Select(x => x.ContributorAppUserId).Distinct().Count() == 1 ? "person" : "people"),
                <strong>@_sessions.Sum(x => x.MarkerCount)</strong> flagged
                @(_sessions.Sum(x => x.MarkerCount) == 1 ? "moment" : "moments") between them.
                Readings are what people recorded; what they mean is for you to judge.
            </p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr>
                        <th>When</th><th>Who</th><th>Where they stood</th>
                        <th class="text-end">Readings</th><th class="text-end">Flagged</th><th>Device</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var fs in _sessions)
                        {
                            <tr>
                                <td class="text-nowrap">@fs.StartedAt.ToLocalTime().ToDisplayDate()</td>
                                <td><UserNameLink AppUserId="@fs.ContributorAppUserId" DisplayName="@fs.ContributorName" /></td>
                                <td>@(string.IsNullOrWhiteSpace(fs.LocationLabel) ? "—" : fs.LocationLabel)</td>
                                <td class="text-end">@fs.ReadingCount.ToString("N0")</td>
                                @* The single most comparable number across visits — "eleven of
                                   twelve people flagged something on those stairs". *@
                                <td class="text-end">
                                    @if (fs.MarkerCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@fs.MarkerCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">0</span>
                                    }
                                </td>
                                <td class="text-secondary small">@fs.DeviceModel</td>
                            </tr>
                            @* The recordings themselves, in a row under the numbers they belong
                               to. Media shipped as a COUNT nobody could open, which asked a
                               reader to take the archive on faith — the one thing the archive
                               exists to end. Empty while a flag is being looked at. *@
                            @if (fs.ApprovedMediaCount > 0)
                            {
                                <tr>
                                    <td colspan="6" class="pt-0 pb-3">
                                        <div class="d-flex flex-wrap gap-2 align-items-start">
                                            @foreach (var m in fs.Media!)
                                            {
                                                var url = AdminClient.GetArchiveMediaUrl(fs.Id, m.UploadFileId);
                                                @if (m.ContentType.StartsWith("image/"))
                                                {
                                                    <a href="@url" target="_blank" rel="noopener"
                                                       title="@m.RelativePath">
                                                        <img src="@url" alt="@m.RelativePath"
                                                             class="rounded border"
                                                             style="height:96px;width:auto;object-fit:cover;" />
                                                    </a>
                                                }
                                                else if (m.ContentType.StartsWith("audio/"))
                                                {
                                                    <span class="d-inline-block">
                                                        <audio controls preload="none" src="@url"
                                                               style="height:40px;max-width:260px;"></audio>
                                                        <span class="d-block text-secondary"
                                                              style="font-size:.7rem;">@m.RelativePath</span>
                                                    </span>
                                                }
                                                else if (m.ContentType.StartsWith("video/"))
                                                {
                                                    <video controls preload="metadata" src="@url"
                                                           class="rounded border"
                                                           style="height:140px;max-width:260px;"></video>
                                                }
                                                else
                                                {
                                                    <a href="@url" target="_blank" rel="noopener"
                                                       class="btn btn-outline-secondary btn-sm">
                                                        <BenIcon Name="file" Class="me-1" />@m.RelativePath
                                                    </a>
                                                }
                                            }

                                            @* The report path. Shown to everyone, because a
                                               control that appears only for people who can use it
                                               leaves a visitor with nothing to do about a picture
                                               they object to. Flagging needs an account: one flag
                                               hides, so an anonymous version would let anybody
                                               erase the archive. *@
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-secondary text-nowrap align-self-center"
                                                    disabled="@(_flagging == fs.Id)"
                                                    @onclick="@(() => FlagAsync(fs.Id))">
                                                <BenIcon Name="alert-triangle" Class="me-1" />
                                                @(_flagging == fs.Id ? "Reporting…" : "Report")
                                            </button>
                                        </div>
                                        @if (_flagMessage.TryGetValue(fs.Id, out var note))
                                        {
                                            <div class="small mt-1 @(note.Ok ? "text-success" : "text-danger")">
                                                @note.Text
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-secondary small fst-italic mt-2 mb-0">
                Magnetic field readings only — a phone measures the DC field, not the AC fields a
                K-II style meter responds to, and different phones differ. Compare visits with that
                in mind.
            </p>
        }

        @* ── What guests photographed on events here ──────────────────────── *@
        @* A tour walks the same route every week, which makes public events the one activity
           that happens repeatedly at a fixed location — so this is where the archive fills
           fastest. Kept as its own section rather than folded into the sessions table, because
           one picture from a walk is not a night of readings and a table of magnetometer
           columns is the wrong shape for it. *@
        @if (_evidence is { Count: > 0 })
        {
            <h6 class="fw-semibold mt-4">From events here</h6>
            <p class="text-secondary small mb-2">
                Contributed by the people who took them, on public events at this place.
            </p>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var ev in _evidence)
                {
                    var url = AdminClient.GetEventEvidenceFileUrl(ev.OrgCalendarEventId, ev.SubmissionId);
                    <div class="card" style="width:220px;">
                        @if (ev.ContentType.StartsWith("image/"))
                        {
                            <a href="@url" target="_blank" rel="noopener">
                                <img src="@url" alt="@ev.EventTitle" class="card-img-top"
                                     style="height:150px;object-fit:cover;" />
                            </a>
                        }
                        else if (ev.ContentType.StartsWith("video/"))
                        {
                            <video controls preload="metadata" src="@url" style="width:100%;height:150px;"></video>
                        }
                        else if (ev.ContentType.StartsWith("audio/"))
                        {
                            <audio controls preload="none" src="@url" class="w-100 mt-2"></audio>
                        }
                        <div class="card-body p-2">
                            <div class="small fw-semibold text-truncate">@ev.EventTitle</div>
                            <div class="text-secondary" style="font-size:.75rem;">
                                @* The operator's name, on a page they did not have to buy an ad
                                   on — the tour that ran the walk earned the credit. *@
                                <a href="/organizations/@ev.OrganizationId">@ev.OrganizationName</a>
                                · @ev.EventStartedAt.ToLocalTime().ToDisplayDate()
                            </div>
                            <div class="text-secondary" style="font-size:.75rem;">
                                by <UserNameLink AppUserId="@ev.ContributorAppUserId" DisplayName="@ev.ContributorName" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ev.Note))
                            {
                                <div class="small mt-1">@ev.Note</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* ── What the evidence here adds up to (item 250) ─────────────────── *@
        @* Ben: "positive, negative, unknown and the average of each overall we can track."
           Per place and never compared across places — he decided against a league table on
           2026-09-21, because Cragfont is a real building with real owners and "the third most
           haunted house in Tennessee" is a claim about them.

           One file counts ONCE here whatever route it arrived by; the server does that
           de-duplication, because three counts added together report more evidence than exists. *@
        @if (_figures is { EvidenceCount: > 0 })
        {
            <div class="card mt-4" id="place-figures">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">What the evidence here says</h6>

                    <div class="d-flex flex-wrap gap-4 mb-3">
                        <div>
                            <div class="h4 mb-0" id="place-figures-evidence">@_figures.EvidenceCount</div>
                            <div class="text-secondary small">
                                @(_figures.EvidenceCount == 1 ? "piece of evidence" : "pieces of evidence")
                            </div>
                        </div>
                        <div>
                            <div class="h4 mb-0" id="place-figures-votes">@_figures.VoteCount</div>
                            <div class="text-secondary small">
                                @(_figures.VoteCount == 1 ? "vote" : "votes")
                                @if (_figures.VoteCount > 0)
                                {
                                    <text>on @_figures.VotedOnCount of them</text>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_figures.VoteCount == 0)
                    {
                        @* Not a bar of zeroes. "Nobody has said" and "everybody said no" are
                           different facts and a chart that draws them alike lies about an empty
                           place. *@
                        <p class="text-secondary small fst-italic mb-0">
                            Nobody has voted on any of it yet.
                        </p>
                    }
                    else
                    {
                        <div class="progress mb-2" style="height:1.25rem;" role="img"
                             aria-label="@AriaForShares()">
                            <div class="progress-bar bg-success"
                                 style="width:@Pct(_figures.ConfirmsShare)"></div>
                            <div class="progress-bar bg-secondary"
                                 style="width:@Pct(_figures.InconclusiveShare)"></div>
                            <div class="progress-bar bg-danger"
                                 style="width:@Pct(_figures.DisputesShare)"></div>
                        </div>
                        <div class="d-flex flex-wrap gap-3 small">
                            <span><span class="badge bg-success">&nbsp;</span>
                                  Something here — @_figures.Confirms (@Pct(_figures.ConfirmsShare))</span>
                            <span><span class="badge bg-secondary">&nbsp;</span>
                                  Can't tell — @_figures.Inconclusive (@Pct(_figures.InconclusiveShare))</span>
                            <span><span class="badge bg-danger">&nbsp;</span>
                                  Not convinced — @_figures.Disputes (@Pct(_figures.DisputesShare))</span>
                        </div>
                        @* The score never travels without its weight — a sum read on its own says
                           nothing, which is the rule EvidenceVoteScore sets for every surface. *@
                        <div class="text-secondary small mt-2" id="place-figures-score">
                            Overall @(_figures.Score > 0 ? "+" : "")@_figures.Score across
                            @_figures.VoteCount @(_figures.VoteCount == 1 ? "vote" : "votes").
                        </div>
                    }
                </div>
            </div>
        }

        @* ── What people have added here themselves (item 250) ────────────── *@
        @* Ben, 2026-09-21: "people don't have to have a dedicated investigation to add files to
           the public location." Its own section rather than folded into the two above, because
           the ROUTE is the thing a reader judges evidence by: a night of readings by a group, a
           photograph from a walk, and something somebody brought back on their own are three
           different claims, and a page that blurs them is a page you cannot weigh. *@
        @if (_place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation)
        {
            <h6 class="fw-semibold mt-4">
                Added by people who have been here
                @if (_added is { Count: > 0 })
                {
                    <span class="badge bg-body-secondary text-body-emphasis border ms-1"
                          id="place-added-count">@_added.Count</span>
                }
            </h6>

            @if (UserState.IsAuthenticated)
            {
                <div class="card mb-3" id="place-add-evidence">
                    <div class="card-body">
                        <label class="form-label" for="place-evidence-file">Add something you recorded here</label>
                        <InputFile id="place-evidence-file" class="form-control mb-2"
                                   OnChange="OnEvidenceChosen" accept="image/*,audio/*,video/*" />
                        <label class="form-label" for="place-evidence-caption">What is it?</label>
                        <input id="place-evidence-caption" class="form-control mb-2" @bind="_evidenceCaption"
                               maxlength="500"
                               placeholder="Where in the building, what time, what to listen for" />
                        <button type="button" class="btn btn-primary" id="place-evidence-add"
                                @onclick="AddEvidenceAsync" disabled="@(_evidenceFile is null || _addingEvidence)">
                            <BenIcon Name="upload-cloud" Class="me-1" />
                            @(_addingEvidence ? "Adding…" : "Add it")
                        </button>
                        @* The screener's answer, in the server's own words. "Added" over something
                           held is what teaches somebody to upload it again. *@
                        @if (_evidenceSays is { Length: > 0 })
                        {
                            <div class="alert @(_evidenceShowing ? "alert-success" : "alert-info") mt-2 mb-0"
                                 id="place-evidence-says">
                                @_evidenceSays
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="text-secondary small">
                    <a href="/login">Sign in</a> to add something you recorded here.
                </p>
            }

            @if (_added is { Count: > 0 })
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var item in _added)
                    {
                        var url = AdminClient.GetPlaceEvidenceFileUrl(PlaceId, item.Id);
                        <div class="card" style="width:220px;">
                            @if (item.ContentType.StartsWith("image/"))
                            {
                                <a href="@url" target="_blank" rel="noopener">
                                    <img src="@url" alt="@(item.Caption ?? item.FileName)"
                                         class="card-img-top" style="height:150px;object-fit:cover;" />
                                </a>
                            }
                            else if (item.ContentType.StartsWith("video/"))
                            {
                                <video controls preload="metadata" src="@url" style="width:100%;height:150px;"></video>
                            }
                            else if (item.ContentType.StartsWith("audio/"))
                            {
                                <audio controls preload="none" src="@url" class="w-100 mt-2"></audio>
                            }
                            <div class="card-body p-2">
                                @if (!string.IsNullOrWhiteSpace(item.Caption))
                                {
                                    <div class="small">@item.Caption</div>
                                }
                                <div class="text-secondary" style="font-size:.75rem;">
                                    by @item.AddedBy · @item.AddedUtc.ToLocalTime().ToDisplayDate()
                                </div>
                                @* The site's one vote widget, not a second set of buttons. It
                                   posts to api/evidence-votes, which is keyed on the FILE — so a
                                   vote cast here is the same vote the file carries anywhere else
                                   it appears, which is what makes the tally above mean anything. *@
                                <div class="mt-2">
                                    <EvidenceVoteWidget UploadFileId="@item.UploadFileId" Compact="true" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-secondary small fst-italic">
                    Nobody has added anything here yet.
                </p>
            }
        }

        @* ── Visitor view ─────────────────────────────────────────────────── *@
        @if (_publicRows is not null)
        {
            <h6 class="fw-semibold mt-4">Published investigations</h6>
            @if (_rowsResult.Failed)
            {
                @* A place shown with no investigations reads as somewhere nothing has happened. *@
                <BenListState TItem="PlaceInvestigationRow" Result="@_rowsResult" OnRetry="@LoadSignedInAsync" />
            }
            else if (_publicRows.Count == 0)
            {
                <p class="text-secondary small fst-italic">
                    Nothing has been published about this place yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>When</th><th>Investigation</th><th>Group</th></tr></thead>
                        <tbody>
                            @foreach (var row in _publicRows)
                            {
                                <tr>
                                    <td class="text-nowrap">@row.ScheduledDateTime.ToLocalTime().ToDisplayDate()</td>
                                    <td>
                                        @if (row.UrlName is string invSlug)
                                        {
                                            <a href="@($"/o/{row.OrganizationUrlName}/investigations/{invSlug}")">@row.Title</a>
                                        }
                                        else
                                        {
                                            @row.Title
                                        }
                                    </td>
                                    <td><a href="/@row.OrganizationUrlName">@row.OrganizationName</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public Guid PlaceId { get; set; }

    private List<Ben.Web.Services.PublicPlaceSessionRow>? _sessions;

    private PlaceRecord? _place;
    private PlaceSummary? _summary;
    private List<PlaceInvestigationRow>? _rows;
    private LoadResult<PlaceInvestigationRow> _rowsResult;
    private List<PublicPlaceInvestigationRow>? _publicRows;
    private List<Ben.Web.Services.PublicPlaceCaseRow>? _cases;
    private List<Ben.Web.Services.PlaceCaseRow>? _myCases;

    // ── Investigating here (2026-09-17) ──────────────────────────────────────
    private Guid? _investigatingWith;
    private bool _offeringSolo;
    private bool _startingSolo;
    private string? _soloError;

    /// <summary>Opens the scheduling window for one of the reader's groups.</summary>
    private void InvestigateWith(Guid organizationId) => _investigatingWith = organizationId;

    /// <summary>
    /// Mints the personal organization and goes straight on to scheduling.
    /// </summary>
    /// <remarks>
    /// <para>Idempotent at the server, so somebody who tapped twice, or who did this on another
    /// place last week, gets the space they already have rather than a second one.</para>
    ///
    /// <para>Straight on to the window rather than back to the page: the person pressed a button
    /// that said "start investigating", and stopping at "you now have a space" would leave them to
    /// work out where investigations live. The visibility is fixed to public by the plan rule
    /// either way, which the sentence they just agreed to said.</para>
    /// </remarks>
    private async Task StartInvestigatingAloneAsync()
    {
        _startingSolo = true;
        _soloError = null;
        try
        {
            var (plan, error) = await AdminClient.StartSoloPlanAsync();
            if (plan is null)
            {
                // The server's own sentence where it gave one; it knows why better than this does.
                _soloError = error ?? "That could not be set up just now. Try again in a moment.";
                return;
            }

            _offeringSolo = false;
            _investigatingWith = plan.OrganizationId;

            // The reader now belongs somewhere, so the per-group buttons and the signed-in
            // sections have something to draw. Re-read rather than guessed at.
            try
            {
                _myOrgs = (await AdminClient.GetMyMembershipOrganizationsAsync()).Items;
                await LoadWhatMyGroupsMayDoAsync();
            }
            catch { /* the window is open either way, which is what they asked for */ }
        }
        catch (Exception ex)
        {
            _soloError = ex.Message;
        }
        finally
        {
            _startingSolo = false;
        }
    }

    /// <summary>Closes the window and re-reads what the page shows about this place.</summary>
    private async Task OnInvestigationScheduledAsync()
    {
        _investigatingWith = null;
        if (UserState.IsAuthenticated) await LoadSignedInAsync();
        else await LoadVisitorAsync();
        StateHasChanged();
    }
    private List<Ben.Service.Models.Feed.FeedPostRecord>? _posts;
    private bool _canPost;

    /// <summary>Matches the server's own page size, so "See all" appears only when it might add.</summary>
    private const int PlacePostsShown = 20;

    /// <summary>
    /// A new post goes straight to the top of the list rather than through a reload.
    /// </summary>
    /// <remarks>
    /// The server would answer with it anyway, but a reload throws away everything else on the
    /// page — the archive, the tables — to redraw one card, and on a slow connection the post
    /// somebody just wrote appears to have vanished while that happens.
    /// </remarks>
    private void OnPlacePosted(Ben.Service.Models.Feed.FeedPostRecord post)
    {
        _posts ??= [];
        _posts.Insert(0, post);
        StateHasChanged();
    }
    private List<InvestigationMapPin> _pins = [];
    private bool _loading = true;

    /// <summary>
    /// The groups this viewer belongs to, so the rooms link can name which one it means.
    /// </summary>
    /// <remarks>
    /// Empty for a signed-out visitor, and that is the whole gate: rooms are a group's own notes
    /// about a building, so somebody with no group has nothing to link to.
    /// </remarks>
    private IReadOnlyList<MyMembershipOrgItem> _myOrgs = [];

    /// <summary>
    /// The groups of mine that may open a case, and the ones that may schedule a visit.
    /// </summary>
    /// <remarks>
    /// <para>Membership is not permission. Both buttons were drawn once per membership and the
    /// servers behind them require grants — <c>Cases.Create</c> and <c>Investigations.Create</c> —
    /// so an ordinary member with no role clicked, filled the whole form, pressed the button and
    /// was refused (2026-09-17 audit). The plan for this page said "members holding Cases.Create"
    /// and the check was dropped in the build.</para>
    ///
    /// <para>One request per group of mine, which is one or two for almost everybody. A failure
    /// leaves that group out of the sets and the button undrawn: refusing to offer something is
    /// the safe direction, and the page still shows everything it is about.</para>
    /// </remarks>
    private readonly HashSet<Guid> _mayOpenCaseIn = [];
    private readonly HashSet<Guid> _mayInvestigateIn = [];

    private async Task LoadWhatMyGroupsMayDoAsync()
    {
        _mayOpenCaseIn.Clear();
        _mayInvestigateIn.Clear();

        foreach (var org in _myOrgs)
        {
            try
            {
                var perms = await AdminClient.GetMyOrgPermissionsAsync(org.OrganizationId);
                if (perms is null) continue;

                if (perms.May(Ben.Data.Common.Enums.OrganizationPermissionArea.Cases,
                              Ben.Data.Common.Enums.OrganizationSecurityAction.Create))
                    _mayOpenCaseIn.Add(org.OrganizationId);

                if (perms.May(Ben.Data.Common.Enums.OrganizationPermissionArea.Investigations,
                              Ben.Data.Common.Enums.OrganizationSecurityAction.Create))
                    _mayInvestigateIn.Add(org.OrganizationId);
            }
            catch { /* left out of both sets, so neither button is offered for this group */ }
        }
    }

    /// <summary>The session whose Report button is mid-flight, so it can disable just that one.</summary>
    private Guid? _flagging;

    /// <summary>What to say under a session's gallery after its Report button was used.</summary>
    private readonly Dictionary<Guid, (bool Ok, string Text)> _flagMessage = [];

    /// <summary>Guest evidence published to this place from public events held here.</summary>
    private List<PlaceEvidenceRow>? _evidence;

    // ── What people added here themselves (item 250) ──────────────────────────
    private List<Ben.Service.Models.Entities.PlaceAddedEvidenceRow>? _added;
    private Ben.Service.Models.Entities.PlaceEvidenceFigures? _figures;
    private IBrowserFile? _evidenceFile;
    private string _evidenceCaption = string.Empty;
    private bool _addingEvidence;
    private string? _evidenceSays;
    private bool _evidenceShowing;

    /// <summary>The verified venue here, when there is one.</summary>
    private PlaceVenueRecord? _venue;

    private string Title => string.IsNullOrWhiteSpace(_place?.Name)
        ? (string.IsNullOrWhiteSpace(_place?.StreetAddress1) ? "Place" : _place!.StreetAddress1!)
        : _place!.Name!;

    private string LocationLine => string.Join(", ",
        new[] { _place?.City, _place?.State }.Where(v => !string.IsNullOrWhiteSpace(v)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Not gated on being signed in — the page has a visitor view. But it does wait for auth to
        // settle, because which of the two views to load depends on the answer.
        await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive);

        if (UserState.IsAuthenticated) await LoadSignedInAsync();
        else await LoadVisitorAsync();

        // A failure here costs one line, not the page.
        _venue = (await AdminClient.GetPlaceVenueAsync(PlaceId)).Item;

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadSignedInAsync()
    {
        _place = await AdminClient.GetPlaceAsync(PlaceId);
        if (_place is null) return;

        _rowsResult = await AdminClient.GetPlaceInvestigationsAsync(PlaceId);
        _rows       = _rowsResult.Items.ToList();
        _summary = await AdminClient.GetPlaceSummaryAsync(PlaceId);

        // For the rooms link. A failure here costs a link, not the page, so it is not reported —
        // the rest of this view is about the place itself and stands without it.
        _myOrgs = (await AdminClient.GetMyMembershipOrganizationsAsync()).Items;
        await LoadWhatMyGroupsMayDoAsync();

        // Quiet on failure: the section simply does not appear, which is the same as having no
        // case here — and is a great deal better than losing the rest of the page over it.
        try { _myCases = (await AdminClient.GetMyPlaceCasesAsync(PlaceId)).Items.ToList(); }
        catch { _myCases = null; }

        // Asked AS SOMEBODY, unlike the archive below. The anonymous place endpoint carries the
        // posts as well, and the website calls it without a token on purpose — so it can only ever
        // answer "no" to whether this reader may post. Both endpoints read the posts through the
        // feed's own method, so the two lists cannot disagree about what is visible.
        try
        {
            if (await AdminClient.GetPlacePostsAsync(PlaceId) is { } mine)
            {
                _posts = mine.Posts.ToList();
                _canPost = mine.CanPost;
            }
        }
        catch { /* the section falls back to what the anonymous read gave it */ }

        await LoadArchiveAsync();
        BuildPins(_rows.Select(r => (r.Id, r.Title)));
    }

    private async Task LoadVisitorAsync()
    {
        var response = await AdminClient.GetPublicPlaceAsync(PlaceId);
        if (response is null) return;

        _place = response.Place;
        _publicRows = response.Investigations.ToList();
        _summary = response.Summary;
        _sessions = response.Sessions?.ToList();
        _evidence = response.EventEvidence?.ToList();
        _added = response.AddedEvidence?.ToList();
        _figures = response.Figures;
        _cases = response.Cases?.ToList();
        _posts = response.Posts?.ToList();
        _canPost = response.CanPost;
        BuildPins(_publicRows.Select(r => (r.Id, r.Title)));
    }

    /// <summary>
    /// The archive, for a signed-in reader.
    /// </summary>
    /// <remarks>
    /// Deliberately the SAME anonymous endpoint the visitor view uses. Published is published, and
    /// a second query with its own idea of who may see what is how the rule that holds in one
    /// place stops holding in the other. A failure costs the archive, not the page.
    /// </remarks>
    private async Task LoadArchiveAsync()
    {
        var response = await AdminClient.GetPublicPlaceAsync(PlaceId);
        _sessions = response?.Sessions?.ToList();
        _evidence = response?.EventEvidence?.ToList();
        _added = response?.AddedEvidence?.ToList();
        _figures = response?.Figures;
        _cases = response?.Cases?.ToList();

        // NOT the posts, and not CanPost. This call is anonymous on purpose, so its answer to
        // "may you post" is always no — and a signed-in reader has already asked that properly
        // through GetPlacePostsAsync. Taking them from here as well would overwrite the real
        // answer with the anonymous one, which is precisely what it did on the first run: the
        // composer never appeared for anybody.
    }

    /// <summary>
    /// Reports a session's media, which hides it until somebody looks.
    /// </summary>
    /// <remarks>
    /// <para><b>A visitor is answered here rather than by the server.</b> The endpoint requires an
    /// account — one flag hides, so an anonymous version would let anybody erase the archive's
    /// pictures — and a signed-out reader clicking Report would otherwise get a bare 401 the page
    /// turns into "something went wrong". Saying what to do instead is the whole point of showing
    /// the control to everybody.</para>
    ///
    /// <para>The archive is reloaded on success so the gallery empties in front of the person who
    /// objected. Being told "reported" while the picture stays on screen reads as a report that
    /// did nothing.</para>
    /// </remarks>
    private async Task FlagAsync(Guid sessionId)
    {
        if (!UserState.IsAuthenticated)
        {
            _flagMessage[sessionId] =
                (false, "Please sign in to report this — an account is needed so a report can be traced.");
            return;
        }

        _flagging = sessionId;
        _flagMessage.Remove(sessionId);
        StateHasChanged();

        var (ok, error) = await AdminClient.FlagFieldSessionAsync(sessionId, reason: null);

        _flagging = null;
        _flagMessage[sessionId] = ok
            ? (true, "Reported. It's hidden until a moderator has looked at it.")
            : (false, error ?? "Couldn't report that just now. Please try again.");

        if (ok) await LoadArchiveAsync();
        StateHasChanged();
    }

    /// <summary>
    /// One pin per visible investigation, all at the place's own coordinates.
    /// </summary>
    /// <remarks>
    /// They stack into a single clustered marker with a count, which is the honest picture: this is
    /// one location that has been visited repeatedly, not several nearby ones.
    /// </remarks>
    private void BuildPins(IEnumerable<(Guid Id, string Title)> rows)
    {
        if (_place?.Latitude is null || _place.Longitude is null) return;

        _pins = rows
            .Select(r => new InvestigationMapPin(
                r.Id, r.Title, _place.Latitude, _place.Longitude, IsPast: true,
                IsPublicPlace: _place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation))
            .ToList();

        // A place whose only record is its archive — field sessions, no investigations — used to
        // draw an empty map of the whole continent. The place itself is the pin then, so the map
        // fits to it (seen on the walk, 2026-09-16).
        if (_pins.Count == 0)
        {
            _pins.Add(new InvestigationMapPin(
                _place.Id, _place.Name, _place.Latitude, _place.Longitude, IsPast: true,
                IsPublicPlace: _place.Kind == Ben.Data.Common.Enums.PlaceKind.PublicLocation));
        }
    }

    private RenderFragment SignedInTable(List<PlaceInvestigationRow> rows, bool showVisibility) =>@<div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Investigation</th>
                    <th>Group</th>
                    @if (showVisibility)
                    {
                        <th>Shared with</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="text-nowrap">@row.ScheduledDateTime.ToLocalTime().ToDisplayDate()</td>
                        <td>@row.Title</td>
                        <td>@row.OrganizationName</td>
                        @if (showVisibility)
                        {
                            @* Shown only on your own group's rows: how another group chose to share
                               something is their business, not a fact to publish back at everyone. *@
                            <td><span class="badge @VisibilityBadge(row.Visibility)">@VisibilityLabel(row.Visibility)</span></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    private static string VisibilityLabel(Ben.Data.Common.Enums.InvestigationVisibility v) => v switch
    {
        Ben.Data.Common.Enums.InvestigationVisibility.Public => "Anyone",
        Ben.Data.Common.Enums.InvestigationVisibility.PlaceInvestigators => "Groups who investigated here",
        _ => "Just us",
    };

    private static string VisibilityBadge(Ben.Data.Common.Enums.InvestigationVisibility v) => v switch
    {
        Ben.Data.Common.Enums.InvestigationVisibility.Public => "bg-info text-dark",
        Ben.Data.Common.Enums.InvestigationVisibility.PlaceInvestigators => "bg-primary",
        _ => "bg-secondary",
    };

    private void OnEvidenceChosen(InputFileChangeEventArgs e)
    {
        _evidenceFile = e.FileCount > 0 ? e.File : null;
        _evidenceSays = null;
    }

    /// <summary>
    /// Sends one file to this place's evidence.
    /// </summary>
    /// <remarks>
    /// <para>The server's own sentence is shown rather than a word of this page's choosing,
    /// because whether it is SHOWING is the part that matters and only the screener knows. A page
    /// that says "added" over something held teaches people to upload it again.</para>
    ///
    /// <para>No size cap here on purpose: the account allowance and the server's own limits are
    /// the rule, and a second number invented in the browser would be a different rule that
    /// nothing enforces.</para>
    /// </remarks>
    private async Task AddEvidenceAsync()
    {
        if (_evidenceFile is null || _addingEvidence) return;

        _addingEvidence = true;
        _evidenceSays = null;
        try
        {
            await using var content = _evidenceFile.OpenReadStream(long.MaxValue);
            var (added, error) = await AdminClient.AddPlaceEvidenceAsync(
                PlaceId, content, _evidenceFile.Name,
                string.IsNullOrWhiteSpace(_evidenceFile.ContentType)
                    ? "application/octet-stream"
                    : _evidenceFile.ContentType,
                _evidenceCaption);

            if (added is null)
            {
                _evidenceShowing = false;
                _evidenceSays = error ?? "That could not be added just now. Try again.";
                return;
            }

            _evidenceShowing = added.Showing;
            _evidenceSays = added.Says;
            _evidenceFile = null;
            _evidenceCaption = string.Empty;

            // Only an APPROVED file is on the page, so only then is there anything new to fetch.
            // Reloading after a held one would show the contributor nothing and read as a failure.
            if (added.Showing) await LoadSignedInAsync();
        }
        finally { _addingEvidence = false; }
    }

    /// <summary>A share as a percentage string, or nothing when nobody has voted.</summary>
    private static string Pct(double? share)
        => share is { } value ? $"{value * 100:0}%" : "0%";

    /// <summary>
    /// The bar in words, for anybody who cannot see it.
    /// </summary>
    /// <remarks>
    /// The bar is the only place three numbers are compared visually, so the alternative has to
    /// carry the comparison rather than repeat the counts listed beneath it.
    /// </remarks>
    private string AriaForShares()
        => _figures is null
            ? "No votes yet"
            : $"Of {_figures.VoteCount} votes: {Pct(_figures.ConfirmsShare)} say something is here, "
            + $"{Pct(_figures.InconclusiveShare)} cannot tell, "
            + $"{Pct(_figures.DisputesShare)} are not convinced";
}
