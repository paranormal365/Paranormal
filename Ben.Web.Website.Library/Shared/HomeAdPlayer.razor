@namespace Ben.Web.Website.Library.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<Ben.Data.Common.SiteIdentity> SiteOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@*
    The thirty-second ad on Home (Ben, 10/05/2026), between the app and the plans, for everybody.

    What Ben asked for: it plays muted; the mouse over it gives sound; a click stops it and another
    click plays it. On a phone, which has no hover, a tap turns the sound on and off.

    THE BROWSER RULE THIS WORKS AROUND. No browser lets a page start sound on hover alone: hovering
    is not a "user activation", and Chrome PAUSES a video that a page unmutes without one. Sound is
    only allowed once the visitor has clicked, tapped or pressed a key somewhere on the page. So:
      - already interacted with the page: hover = sound, click = pause / play, exactly as asked;
      - not yet: the badge says "Click for sound", and that first click turns the sound on rather
        than pausing (it is the click that unlocks sound). Every click after it pauses / plays.

    It starts when scrolled into view and pauses when scrolled away or the tab is hidden. The video
    file is only fetched once the player is near the viewport (720p on narrow screens, 1080p
    otherwise), so the page's first load never pays for it. "Reduce motion" gets the poster and a
    play button instead of autoplay. Keyboard: the frame is focusable; Enter/Space = pause / play,
    M = sound.

    All of it runs in the browser (HomeAdPlayer.razor.js): no round trip to the circuit per hover.
    Files: /static/video/ishaunted-ad-{1080,720}.mp4 and ishaunted-ad-poster.jpg (the end card).
    Until the 1080p file is in wwwroot the section renders nothing at all, so the page never shows
    an empty frame; it appears on its own once the files are deployed.
*@

@if (_hasVideo)
{
    <section class="ad-player" data-testid="home-ad">
        <div class="ad-player__card">
            <div class="ben-kicker">Thirty seconds</div>
            <h2 class="ad-player__title">From the driveway <span class="ben-accent-text">to the dance floor.</span></h2>
            <p class="ad-player__lede">
                A guest, a pass on their phone, and a front desk with a scanner. One scan, one guest
                confirmed, and the door opens on the party.
            </p>

            <div class="ad-player__frame" @ref="_frame" tabindex="0" role="button"
                 aria-label="@(SiteOptions.Value.Name) ad. Press Enter to pause or play, M for sound." data-state="loading">
                <video @ref="_video" class="ad-player__video" muted loop playsinline preload="none"
                       poster="/static/video/ishaunted-ad-poster.jpg" aria-hidden="true"></video>

                <span class="ad-player__play" aria-hidden="true"><BenIcon Name="play" /></span>

                <span class="ad-player__hint" aria-hidden="true">
                    <BenIcon Name="volume-x" Class="ad-player__ico ad-player__ico--off" />
                    <BenIcon Name="volume-2" Class="ad-player__ico ad-player__ico--on" />
                    <span class="ad-player__hint-text">Click for sound</span>
                </span>
            </div>
        </div>
    </section>
}

@code {
    private ElementReference _frame;
    private ElementReference _video;
    private IJSObjectReference? _module;
    private bool _disposed;
    private bool _hasVideo;

    protected override void OnInitialized() =>
        _hasVideo = Env.WebRootFileProvider.GetFileInfo("static/video/ishaunted-ad-1080.mp4").Exists;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_hasVideo) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/_content/Ben.Web.Website.Library/Shared/HomeAdPlayer.razor.js");
            if (_disposed) return;
            await _module.InvokeVoidAsync("init", _frame, _video);
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // No module, no autoplay: the poster still shows. Nothing to tell the visitor.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("dispose", _frame);
            await _module.DisposeAsync();
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The circuit is already gone.
        }
    }
}
