@namespace Ben.Web.Website.Library.Shared
@using Ben.Data.Common.Enums
@implements IAsyncDisposable

@inject IBenAdminClient  AdminClient
@inject IBenUserState    UserState
@inject IJSRuntime       JS

@* ── Loading ─────────────────────────────────────────────────────────────── *@
@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading investigations…" />
    </div>
}
else
{
    @* ── Section header ───────────────────────────────────────────────────── *@
    <div class="container-fluid px-3 mt-5" style="max-width:1000px;">
        <div class="d-flex align-items-baseline justify-content-between mb-2">
            <h4 class="mb-0">Public Investigations</h4>
            <span class="text-muted small">@_totalCount case@(_totalCount == 1 ? "" : "s") worldwide</span>
        </div>
        <p class="text-secondary small mb-3">
            Click a marker or case below to view details.
            @if (!UserState.IsAuthenticated)
            {
                <a href="/login" class="text-decoration-none">Sign in</a><span> to vote on evidence.</span>
            }
        </p>
    </div>

    @* ── Map ──────────────────────────────────────────────────────────────── *@
    <div class="container-fluid px-3 mb-4" style="max-width:1000px;">
        <div style="height:420px; border-radius:.5rem; overflow:hidden;">
            <TelerikMap @ref="_mapRef"
                        Center="@_mapCenter"
                        Zoom="@_mapZoom"
                        Height="420px">
                <MapLayers>
                    <MapLayer Type="@MapLayersType.Tile"
                              Attribution="© OpenStreetMap contributors"
                              Subdomains="@(new[] {"a","b","c"})"
                              UrlTemplate="caseMapTileTemplate" />

                    @if (_markers.Count > 0)
                    {
                        <MapLayer Type="@MapLayersType.Marker"
                                  Data="@_markers"
                                  LocationField="@nameof(CaseMapMarker.LatLng)"
                                  TitleField="@nameof(CaseMapMarker.Title)">
                            <MapLayerMarkerSettings Template="caseMapMarkerTemplate" />
                        </MapLayer>
                    }
                </MapLayers>
            </TelerikMap>

            @* Said plainly, because a pin on a map reads as an address whether or not it is one.
               These are cell centres several miles across; the property is somewhere nearby. *@
            <p class="text-secondary small mt-2 mb-0">
                Pins show an approximate area, not an address. Case locations are deliberately
                published to within a few miles.
            </p>
        </div>
    </div>

    @* ── Case popup ───────────────────────────────────────────────────────── *@
    @* Was a non-modal, resizable TelerikWindow floating over the map. As a modal, choosing a
       different pin means dismissing this one first — worth it for a single dialog primitive that
       is known to keep its inputs bound (the vote widget below is interactive). *@
    <BenModal @bind-Visible="@_popupVisible"
              Title="@(_selectedCase != null ? _selectedCase.Title : _selectedCity)"
              Static="false">
        <ChildContent>
            @if (_clusterCases.Count > 1 && _selectedCase is null)
            {
                @* City cluster list *@
                <p class="text-secondary small mb-2">@_clusterCases.Count cases in @_selectedCity</p>
                <div class="list-group list-group-flush">
                    @foreach (var c in _clusterCases)
                    {
                        <button class="list-group-item list-group-item-action py-2 px-0"
                                @onclick="@(() => _selectedCase = c)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="font-monospace small text-muted">@c.CaseReference</span>
                                    @if (c.IsHaunted) { <span class="ms-1">👻</span> }
                                    <div class="fw-semibold">@c.Title</div>
                                </div>
                                <CaseVoteBar Confirms="@c.ConfirmsCount" Disputes="@c.DisputesCount" Inconclusive="@c.InconclusiveCount" Total="@c.TotalVotes" Score="@c.Score" Compact="true" />
                            </div>
                        </button>
                    }
                </div>
            }
            else if (_selectedCase is not null)
            {
                @* Single case detail *@
                @if (_clusterCases.Count > 1)
                {
                    <button class="btn btn-sm btn-link ps-0 mb-2 text-decoration-none"
                            @onclick="@(() => _selectedCase = null)">← All cases in @_selectedCity</button>
                }
                <div class="mb-2">
                    <span class="font-monospace small text-muted">@_selectedCase.CaseReference</span>
                    @if (_selectedCase.IsHaunted) { <span class="ms-1 badge bg-warning text-dark">Haunted 👻</span> }
                </div>
                <h6 class="mb-1">@_selectedCase.Title</h6>
                <p class="text-secondary small mb-2">@_selectedCase.City, @_selectedCase.State · @_selectedCase.OrgName</p>
                @if (_selectedCase.ClientName is not null)
                {
                    <p class="text-muted small mb-2">Client: @_selectedCase.ClientName</p>
                }

                @* Community votes *@
                <CaseVoteWidget CaseId="@_selectedCase.CaseId" />

                <div class="d-flex gap-2 mt-3 flex-wrap">
                    <a href="/o/@_selectedCase.OrgUrlName/cases/@_selectedCase.CaseReference.TrimStart('#')"
                       class="btn btn-sm btn-outline-primary">View Investigation</a>
                    <a href="/o/@_selectedCase.OrgUrlName"
                       class="btn btn-sm btn-outline-secondary">View Group</a>
                </div>
            }
        </ChildContent>
    </BenModal>

    @* ── Paged list ────────────────────────────────────────────────────────── *@
    <div class="container-fluid px-3 mb-5" style="max-width:1000px;">
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <span class="fw-semibold">Sort by</span>
            <div class="btn-group" role="group" aria-label="Sort investigations">
                <button type="button"
                        class="btn @(_sort == "votes" ? "btn-primary" : "btn-outline-primary")"
                        aria-pressed="@((_sort == "votes").ToString().ToLowerInvariant())"
                        @onclick="@(() => SetSort("votes"))">Most Votes</button>
                <button type="button"
                        class="btn @(_sort == "date" ? "btn-primary" : "btn-outline-primary")"
                        aria-pressed="@((_sort == "date").ToString().ToLowerInvariant())"
                        @onclick="@(() => SetSort("date"))">Newest</button>
            </div>
        </div>

        @if (_pagedItems.Count == 0)
        {
            <div class="alert alert-light text-muted text-center">No public investigations yet.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in _pagedItems)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 @(item.IsHaunted ? "border-warning" : "")">
                            <div class="card-body pb-1">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="font-monospace text-muted" style="font-size:.75rem;">@item.CaseReference</span>
                                    @if (item.IsHaunted)
                                    { <span class="badge bg-warning text-dark">👻 Haunted</span> }
                                </div>
                                <h6 class="card-title mb-1">@item.Title</h6>
                                <p class="card-text text-secondary mb-1" style="font-size:.8rem;">@item.City, @item.State</p>
                                <p class="card-text text-muted mb-2" style="font-size:.78rem;">@item.OrgName</p>
                                <CaseVoteBar Confirms="@item.ConfirmsCount"
                                         Disputes="@item.DisputesCount"
                                         Inconclusive="@item.InconclusiveCount"
                                         Total="@item.TotalVotes"
                                         Score="@item.Score" />
                                @if (UserState.IsAuthenticated)
                                {
                                    <div class="mt-2">
                                        <CaseVoteWidget CaseId="@item.CaseId"
                                                        PreloadedSummary="@(_voteSummaries.GetValueOrDefault(item.CaseId))" />
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-transparent d-flex gap-2 pt-2">
                                <a href="/o/@item.OrgUrlName/cases/@item.CaseReference.TrimStart('#')"
                                   class="btn btn-sm btn-outline-primary">View</a>
                                <a href="/o/@item.OrgUrlName"
                                   class="btn btn-sm btn-outline-secondary">Group</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_totalCount > _pageSize)
            {
                <div class="mt-3 d-flex justify-content-center">
                    <BenPager Total="@_totalCount"
                              PageSize="@_pageSize"
                              Page="@_page"
                              PageChanged="@OnPageChanged"
                              AriaLabel="Investigation pages" />
                </div>
            }
        }
    </div>
}

@* ── Vote bar helper ──────────────────────────────────────────────────────── *@
@* Renders inline vote counts for a case *@

@code {
    // ── Map state ────────────────────────────────────────────────────────────
    /// <summary>
    /// The map's own handle. Everything that used to be done to this map through a global
    /// <c>kendo</c> object is done through here instead: Telerik UI for Blazor ships no jQuery
    /// and defines no such global, so every one of those calls returned without doing anything.
    /// </summary>
    private TelerikMap? _mapRef;

    private double[] _mapCenter = [39.5, -98.35];   // US center default
    private int      _mapZoom   = 4;

    // ── Data ─────────────────────────────────────────────────────────────────
    private bool   _loading    = true;
    private int    _totalCount = 0;
    private int    _page       = 1;
    private int    _pageSize   = 18;
    private string _sort       = "votes";

    private List<PublicCaseDiscoveryItem> _pagedItems = [];
    private List<CaseMapMarker>           _markers    = [];
    private Dictionary<Guid, CaseVoteSummary> _voteSummaries = [];

    // Per-marker cluster data (index = marker.Index)
    private List<List<PublicCaseDiscoveryItem>> _clusters = [];

    // ── Popup state ──────────────────────────────────────────────────────────
    private bool   _popupVisible  = false;
    private string _selectedCity  = "";
    private List<PublicCaseDiscoveryItem> _clusterCases = [];
    private PublicCaseDiscoveryItem? _selectedCase;

    // ── JS interop ───────────────────────────────────────────────────────────
    private IJSObjectReference? _module;
    private DotNetObjectReference<PublicCaseDiscovery>? _dotnetRef;
    private bool _mapResized;

    /// <summary>
    /// Re-measures the map after its container changes size.
    /// </summary>
    /// <remarks>
    /// The map measures its container once, when it mounts, and never again — so widening the
    /// window left it drawing tiles at the old width with an empty strip beside them, which is
    /// how this was reported. The JS side owns only the debounced resize event; the redraw
    /// itself has to come from the component.
    /// </remarks>
    [JSInvokable]
    public Task OnContainerResized()
    {
        _mapRef?.Refresh();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module     = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Ben.Web.Website.Library/Shared/PublicCaseDiscovery.razor.js");
            _dotnetRef  = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _dotnetRef);
            await _module.InvokeVoidAsync("tryGetUserLocation", _dotnetRef);

            await LoadAsync();
            return;
        }

        // The map is first mounted on the render where _loading flips false — its
        // container wasn't in the DOM yet during firstRender above, so it would have
        // measured a stale/zero width if we asked it to redraw any earlier.
        // Refresh once, now that the real container is actually laid out.
        if (!_loading && !_mapResized)
        {
            _mapResized = true;
            _mapRef?.Refresh();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        // Load all cases for the map + first page for the list
        // We load up to 500 for map coverage; list is sliced client-side
        var response = await AdminClient.GetPublicCaseDiscoveryAsync(page: 1, pageSize: 500, sort: _sort);
        if (response is null)
        {
            _loading = false;
            StateHasChanged();
            return;
        }

        _totalCount  = response.TotalCount;
        var allItems = response.Items.ToList();

        BuildMarkers(allItems);
        SlicePage(allItems);
        await LoadVoteSummariesAsync();

        _loading = false;
        StateHasChanged();
    }

    private void BuildMarkers(List<PublicCaseDiscoveryItem> all)
    {
        _markers  = [];
        _clusters = [];

        // The coordinates arriving here are already a grid-cell centre, not a property — the server
        // redacts them before they leave the WebApi, so this rounding is only about grouping
        // markers, not about hiding anything. Items with no coordinates are map-excluded.
        var groups = all
            .Where(i => i.ApproxLatitude.HasValue && i.ApproxLongitude.HasValue)
            .GroupBy(i => (
                Lat: Math.Round((double)i.ApproxLatitude!.Value, 2),
                Lon: Math.Round((double)i.ApproxLongitude!.Value, 2)))
            .ToList();

        foreach (var group in groups)
        {
            var idx   = _clusters.Count;
            var cases = group.ToList();
            _clusters.Add(cases);

            var first = cases[0];
            _markers.Add(new CaseMapMarker
            {
                LatLng    = [group.Key.Lat, group.Key.Lon],
                Title     = cases.Count == 1 ? first.Title : $"{cases.Count} cases near {first.City}",
                Count     = cases.Count,
                Index     = idx,
                IsHaunted = cases.Any(c => c.IsHaunted),
                CaseId    = first.CaseId,
            });
        }
    }

    private void SlicePage(List<PublicCaseDiscoveryItem> all)
    {
        _pagedItems = all
            .Skip((_page - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    [JSInvokable]
    public async Task SetUserLocation(double? lat, double? lon)
    {
        if (lat.HasValue && lon.HasValue)
        {
            _mapCenter = [lat.Value, lon.Value];
            _mapZoom   = 9;
            await InvokeAsync(StateHasChanged);

            // Re-render alone does not reload the tiles, so the map has to be told. This used to
            // go out to JS and drive the widget through a global `kendo` object that Telerik UI
            // for Blazor does not define — so recentring the map on a searched location quietly
            // did nothing at all.
            _mapRef?.Refresh();
        }
    }

    [JSInvokable]
    public void OnMarkerClicked(int index)
    {
        if (index < 0 || index >= _clusters.Count) return;

        _clusterCases = _clusters[index];
        _selectedCity = _clusterCases[0].City;
        _selectedCase = _clusterCases.Count == 1 ? _clusterCases[0] : null;
        _popupVisible = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task SetSort(string sort)
    {
        if (_sort == sort) return;
        _sort  = sort;
        _page  = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int newPage)
    {
        _page = newPage;
        var response = await AdminClient.GetPublicCaseDiscoveryAsync(page: _page, pageSize: _pageSize, sort: _sort);
        if (response is not null)
        {
            _totalCount = response.TotalCount;
            _pagedItems = response.Items.ToList();
        }
        await LoadVoteSummariesAsync();
        StateHasChanged();
    }

    // Fetches vote summaries for the current page items in a single request.
    private async Task LoadVoteSummariesAsync()
    {
        // Item #103: this used to read IsAuthenticated straight off the initial load, and auth
        // resolves asynchronously after the circuit connects — so on a hard navigation a
        // signed-in user's own votes never appeared until they paged or re-sorted. Wait for the
        // answer before asking the question. During prerender the wait returns false and we skip;
        // the interactive circuit re-runs the whole load path and comes through here again.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated || _pagedItems.Count == 0) return;
        var ids = _pagedItems.Select(i => i.CaseId);
        // A decoration: these only mark which cards the viewer has already voted on. A failed
        // lookup leaves the marks off, which is what an empty answer already did — no panel.
        var summaries = await AdminClient.GetCaseVoteSummariesAsync(ids);
        _voteSummaries = summaries.Items.ToDictionary(s => s.CaseId);
    }

    public async ValueTask DisposeAsync()
    {
        // Same as NearbyDiscovery: a disconnected circuit is the ordinary way off this page.
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _dotnetRef?.Dispose();
    }

    // ── Marker data model ─────────────────────────────────────────────────────

    private sealed class CaseMapMarker
    {
        public double[]? LatLng    { get; set; }
        public string    Title     { get; set; } = string.Empty;
        public int       Count     { get; set; } = 1;
        public int       Index     { get; set; }
        public bool      IsHaunted { get; set; }
        public Guid      CaseId    { get; set; }
    }
}
