@namespace Ben.Web.Website.Library.Shared
@using Ben.Web.Website.Library.Kit.Maps

@*
   A map of where investigations happened. Reusable across the organization view, a person's own
   list, and the place pages, because all three ask the same question of different data.

   Since item 228 this is a thin adapter over Kit/Maps/BenMap, which owns the map library. What
   stays here is the domain: pins that share a spot are gathered into one, because the same
   place accumulating visits over years is the normal case and forty markers on one pixel is
   not a map; a past visit is dimmed, not hidden; a known public landmark is marked out.
*@

<BenMap Pins="@_mapPins" Height="@Height" OnPinClicked="@OnMapPinClicked" OnViewportChanged="@OnMapViewportChanged" />

@code {
    /// <summary>The investigations to plot. Ones without coordinates are ignored here — see the remarks.</summary>
    /// <remarks>
    /// Silently dropping unplaceable rows would make the map disagree with the list beside it, so
    /// the caller is expected to show those separately with their <c>GeocodeNote</c>. This
    /// component's job is only the pins.
    /// </remarks>
    [Parameter, EditorRequired] public IReadOnlyList<InvestigationMapPin> Pins { get; set; } = [];

    [Parameter] public string Height { get; set; } = "420px";

    /// <summary>Raised with the pin's id when someone clicks a marker. A shared spot raises the first pin at it.</summary>
    [Parameter] public EventCallback<Guid> OnPinClicked { get; set; }

    /// <summary>
    /// Raised when the person finishes a pan or a zoom, with the bounds now in view.
    /// </summary>
    /// <remarks>
    /// This is the seam that lets a page load pins for the part of the world somebody is looking
    /// at rather than everything at once. One event per gesture; debouncing beyond that is the
    /// caller's business, because only the caller knows what a request costs. Not raised for
    /// the map's own framing — that is not something the person did.
    /// </remarks>
    [Parameter] public EventCallback<MapViewport> OnViewportChanged { get; set; }

    private IReadOnlyList<BenMapPin> _mapPins = [];
    private List<List<InvestigationMapPin>> _groups = [];
    private int _builtFor = -1;

    protected override void OnParametersSet()
    {
        // Rebuilt only when the pin set actually changes: OnParametersSet runs on every parent
        // render, and regrouping on each one would move the map under the person's cursor.
        if (Pins.Count == _builtFor) return;
        _builtFor = Pins.Count;

        _groups = Pins
            .Where(p => p.Latitude.HasValue && p.Longitude.HasValue)
            // Rounded to about eleven metres. Two visits to the same building should share a pin
            // even when their coordinates differ in the last decimal place.
            .GroupBy(p => (Lat: Math.Round(p.Latitude!.Value, 4), Lon: Math.Round(p.Longitude!.Value, 4)))
            .Select(g => g.ToList())
            .ToList();

        _mapPins = _groups.Select(group =>
        {
            var first = group[0];
            var shared = group.Count > 1;
            return new BenMapPin(
                (double)first.Latitude!.Value, (double)first.Longitude!.Value,
                Title: shared ? $"{group.Count} investigations here" : first.Title,
                // A landmark anyone can visit is told apart by colour AND by its subtitle, so the
                // difference survives colour vision. Only a KNOWN landmark: null means nobody checked.
                Subtitle: first.IsPublicPlace == true ? "A place anyone can visit" : null,
                Glyph: shared ? group.Count.ToString() : "🔦",
                Color: first.IsPublicPlace == true ? "#3f9fd6" : null,
                // A group reads as past only when every visit in it is.
                Dimmed: group.All(p => p.IsPast),
                // Distinct spots that overlap at a low zoom gather into a count; zooming in separates them.
                Cluster: "investigations");
        }).ToList();
    }

    private Task OnMapPinClicked(int index) =>
        index >= 0 && index < _groups.Count ? OnPinClicked.InvokeAsync(_groups[index][0].Id) : Task.CompletedTask;

    private Task OnMapViewportChanged(BenMapViewport v) =>
        OnViewportChanged.InvokeAsync(new MapViewport(v.North, v.South, v.East, v.West, v.Zoom));
}
