@* Small reusable page-header shell — title + subtitle line — repeated verbatim across the
   SuperAdmin list pages with only the text differing. *@
<div class="row mb-3 align-items-center">
    <div class="col">
        <h3 class="mb-0">@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="text-secondary small mb-0">@Subtitle</p>
        }
    </div>
    @if (ActionsContent is not null)
    {
        <div class="col-auto">
            @ActionsContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ActionsContent { get; set; }
}
