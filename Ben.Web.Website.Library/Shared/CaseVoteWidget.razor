@namespace Ben.Web.Website.Library.Shared
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject SiteFeaturesProvider Features
@inject NavigationManager NavManager
@inject IJSRuntime JS

@*
  What people think of a published case: the counts, and the row of small round buttons under
  them (Ben, 2026-09-11).

  The vote is ONE button, not three. It carries a hollow thumb until you have voted and the filled
  icon of your own vote afterwards, so the control says what you did without a legend; pressing it
  again takes the vote back, which is what the separate Remove button used to be for. The three
  choices — up, neutral, down — appear when you press it with no vote cast.

  Every button in the row is the same height and the row never wraps: it is a strip of actions, and
  a strip that reflows onto two lines stops reading as one.
*@

@* Item 154: the voting switch — off means this renders nothing at all. *@
@if (Features.IsOn(SiteFeatures.Voting))
{
    <div class="case-vote-widget">
        @if (_summary is null && _loading)
        {
            <span class="text-secondary small">Loading votes…</span>
        }
        else if (_summary is null && _error is not null)
        {
            <span class="text-danger small">@_error</span>
        }
        else if (_summary is not null)
        {
            @* ── How it stands ─────────────────────────────────────────────── *@
            @if (_summary.TotalVotes > 0)
            {
                <div class="mb-1">
                    <div class="progress" style="height:5px; border-radius:3px;">
                        <div class="progress-bar bg-success" style="width:@ConfirmsPct%" title="@_summary.ConfirmsCount confirms"></div>
                        <div class="progress-bar bg-danger"  style="width:@DisputesPct%" title="@_summary.DisputesCount disputes"></div>
                        <div class="progress-bar bg-warning" style="width:@InconclusivePct%" title="@_summary.InconclusiveCount inconclusive"></div>
                    </div>
                </div>
            }
            <div class="d-flex gap-2 align-items-center" style="font-size:.78rem;">
                <span class="text-success">✓ @_summary.ConfirmsCount</span>
                <span class="text-danger">✗ @_summary.DisputesCount</span>
                <span class="text-warning-emphasis">? @_summary.InconclusiveCount</span>
                <span class="text-muted ms-auto">@_summary.TotalVotes vote@(_summary.TotalVotes == 1 ? "" : "s")</span>
                <VoteScoreBadge Score="@_summary.Score" Total="@_summary.TotalVotes" />
            </div>

            @* ── The actions ───────────────────────────────────────────────── *@
            <div class="vote-actions">
                <div class="vote-actions__vote">
                    <button type="button" class="vote-btn @(MyVote is { } cast ? $"vote-btn--{ToneOf(cast)}" : "")"
                            aria-label="@VoteButtonLabel"
                            aria-pressed="@((MyVote is not null).ToString().ToLowerInvariant())"
                            aria-expanded="@_picking.ToString().ToLowerInvariant()"
                            title="@VoteButtonLabel"
                            @onclick="VoteButtonPressedAsync"
                            disabled="@_isBusy">
                        <BenIcon Name="@(MyVote is { } icon ? IconOf(icon) : "thumbs-up")"
                                 Class="@(MyVote is null ? "" : "vote-btn__icon--filled")" />
                    </button>

                    @* A dropdown off the button (Ben, 2026-09-11), not a row of its own: three
                       choices hanging under the control that asked for them, rather than a second
                       strip of buttons competing with the first.

                       A plain panel rather than a dialog — a dialog would take the focus and the
                       page away from somebody halfway down a case, for a decision that is one
                       click. Each choice is a hollow icon; its meaning is a tooltip, which appears
                       when the reader pauses on it. *@
                    @if (_picking)
                    {
                        <div class="vote-choices" role="menu" aria-label="How do you read this case?">
                            @foreach (var choice in Choices)
                            {
                                var v = choice;
                                <button type="button" class="vote-btn vote-btn--@ToneOf(v)"
                                        title="@VoteTitle(v)" aria-label="@VoteTitle(v)"
                                        @onclick="@(() => CastVoteAsync(v))" disabled="@_isBusy">
                                    <BenIcon Name="@IconOf(v)" />
                                </button>
                            }
                        </div>
                    }
                </div>

                @* Share. No backend and none needed: the address of this page is the whole of
                   what is being shared.

                   Hovering opens the places it can go (Ben, 2026-09-11) — most people know these
                   marks on sight, so each carries its name in a tooltip rather than a word inside
                   the button. Opened on focus too, or the row would be unreachable by keyboard,
                   and pressing the button itself still does the sensible thing on a phone, where
                   there is no hover and the browser has a share sheet of its own. *@
                <div class="vote-actions__share">
                    <button type="button" class="vote-btn" title="Share" aria-label="Share this case"
                            @onclick="ShareAsync">
                        <BenIcon Name="share-2" />
                    </button>

                    <div class="share-choices">
                        @foreach (var target in ShareTargets)
                        {
                            <a class="vote-btn" href="@target.Href" title="@target.Name"
                               aria-label="@($"Share on {target.Name}")"
                               target="_blank" rel="noopener noreferrer">
                                <BenIcon Name="@target.Icon" />
                            </a>
                        }
                        <button type="button" class="vote-btn" title="Copy link"
                                aria-label="Copy a link to this case" @onclick="CopyLinkAsync">
                            <BenIcon Name="link" />
                        </button>
                    </div>
                </div>

                @if (_shareNote is not null)
                {
                    <span class="vote-actions__note" role="status">@_shareNote</span>
                }
            </div>

            @if (_actionError is not null)
            {
                <span class="text-danger small">@_actionError</span>
            }

            @if (!UserState.IsAuthenticated)
            {
                <div class="vote-actions__signin">
                    <a href="@SignInUrl"><strong>Sign in</strong></a> to vote.
                </div>
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    /// <summary>When provided, skips the API fetch. Used by list views that pre-load summaries in batch.</summary>
    [Parameter] public CaseVoteSummary? PreloadedSummary { get; set; }

    private CaseVoteSummary? _summary;
    private bool _loading = true;
    private bool _isBusy;
    private bool _picking;
    private string? _error;
    private string? _actionError;
    private string? _shareNote;

    /// <summary>Up, level, down — the order they are offered in, and the order they read in.</summary>
    private static readonly EvidenceVoteType[] Choices =
    [
        EvidenceVoteType.Confirms,
        EvidenceVoteType.Inconclusive,
        EvidenceVoteType.Disputes,
    ];

    private EvidenceVoteType? MyVote => _summary?.CurrentUserVote;

    private string SignInUrl => $"/login?returnUrl={Uri.EscapeDataString(NavManager.Uri)}";

    /// <summary>
    /// What the one button says it will do, which changes with what the reader has already done.
    /// </summary>
    private string VoteButtonLabel => MyVote is { } v
        ? $"Your vote: {VoteWord(v)}. Press to take it back."
        : "Vote";

    // Item #103: this widget renders differently for a signed-in viewer (vote buttons, own
    // score) and reads UserState at render — but auth resolves asynchronously after the circuit
    // connects, so on a hard navigation the first load can run against the anonymous state and
    // stay that way. When auth lands late, reload: the summary itself is viewer-specific
    // (UserScore), so a repaint alone would show buttons beside stale anonymous data.
    protected override async Task OnInitializedAsync()
    {
        var before = UserState.IsAuthenticated;
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)
            && UserState.IsAuthenticated != before)
        {
            await LoadSummaryAsync();
            StateHasChanged();
        }
    }

    protected override Task OnParametersSetAsync() => LoadSummaryAsync();

    private async Task LoadSummaryAsync()
    {
        if (PreloadedSummary is not null)
        {
            _summary = PreloadedSummary;
            _loading = false;
            return;
        }
        _loading = true;
        try { _summary = await AdminClient.GetCaseVoteSummaryAsync(CaseId); }
        catch { _error = "Failed to load votes."; }
        _loading = false;
    }

    /// <summary>
    /// Pressing the vote button: take the vote back if there is one, otherwise offer the three.
    /// </summary>
    /// <remarks>
    /// A reader who is not signed in is sent to sign in rather than shown three choices that would
    /// be refused — the sentence under the button already says so, and the button agreeing with it
    /// is better than the button disagreeing.
    /// </remarks>
    private async Task VoteButtonPressedAsync()
    {
        if (!UserState.IsAuthenticated)
        {
            NavManager.NavigateTo(SignInUrl);
            return;
        }

        if (MyVote is not null)
        {
            _picking = false;
            await RemoveVoteAsync();
            return;
        }

        _picking = !_picking;
    }

    private async Task CastVoteAsync(EvidenceVoteType voteType)
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            var updated = await AdminClient.CastCaseVoteAsync(CaseId, voteType);
            if (updated is not null) _summary = updated;
            else _actionError = "Failed to cast your vote. Please try again.";
        }
        catch { _actionError = "Failed to cast your vote. Please try again."; }
        finally
        {
            _picking = false;
            _isBusy = false;
        }
    }

    private async Task RemoveVoteAsync()
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            await AdminClient.RemoveCaseVoteAsync(CaseId);
            _summary = await AdminClient.GetCaseVoteSummaryAsync(CaseId);
        }
        catch { _actionError = "Failed to remove your vote. Please try again."; }
        finally { _isBusy = false; }
    }

    /// <summary>
    /// Hands this page's address to the browser's own share sheet, or to the clipboard.
    /// </summary>
    /// <remarks>
    /// Both can be refused — a share sheet is dismissable and the clipboard needs permission — and
    /// neither refusal is worth an error, so the note simply does not appear. What must not happen
    /// is an exception escaping into the circuit for a button somebody pressed idly.
    /// </remarks>
    private Task ShareAsync() => CopyLinkAsync();

    private async Task CopyLinkAsync()
    {
        try
        {
            var copied = await JS.InvokeAsync<bool>("benShareLink", NavManager.Uri);
            _shareNote = copied ? "Link copied" : null;
        }
        catch (JSException) { _shareNote = null; }
        catch (JSDisconnectedException) { _shareNote = null; }
    }

    /// <summary>
    /// Where a link can be handed to, with the mark people recognise it by.
    /// </summary>
    /// <remarks>
    /// Each one is that service's own share address with this page's URL on it — nothing is posted
    /// on anybody's behalf, and the reader lands in their own account to decide what to say. The
    /// marks come from the site's sprite, which is Feather: there is no glyph for X, so it keeps
    /// the bird it has always had rather than shipping a second icon set for one letter.
    /// </remarks>
    private IReadOnlyList<(string Name, string Icon, string Href)> ShareTargets
    {
        get
        {
            var url = Uri.EscapeDataString(NavManager.Uri);
            return
            [
                ("Facebook", "facebook", $"https://www.facebook.com/sharer/sharer.php?u={url}"),
                ("X",        "twitter",  $"https://twitter.com/intent/tweet?url={url}"),
                ("LinkedIn", "linkedin", $"https://www.linkedin.com/sharing/share-offsite/?url={url}"),
                ("Email",    "mail",     $"mailto:?body={url}"),
            ];
        }
    }

    private double ConfirmsPct     => _summary is { TotalVotes: > 0 } ? _summary.ConfirmsCount     * 100.0 / _summary.TotalVotes : 0;
    private double DisputesPct     => _summary is { TotalVotes: > 0 } ? _summary.DisputesCount     * 100.0 / _summary.TotalVotes : 0;
    private double InconclusivePct => _summary is { TotalVotes: > 0 } ? _summary.InconclusiveCount * 100.0 / _summary.TotalVotes : 0;

    /// <summary>Thumb up, level, thumb down — Ben's +1 / 0 / −1, in the sprite's names.</summary>
    private static string IconOf(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "thumbs-up",
        EvidenceVoteType.Disputes     => "thumbs-down",
        EvidenceVoteType.Inconclusive => "minus",
        _                             => "circle",
    };

    private static string ToneOf(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "up",
        EvidenceVoteType.Disputes     => "down",
        EvidenceVoteType.Inconclusive => "level",
        _                             => "level",
    };

    private static string VoteWord(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "confirms",
        EvidenceVoteType.Disputes     => "disputes",
        EvidenceVoteType.Inconclusive => "can't say",
        _                             => v.ToString(),
    };

    /// <summary>The full sentence, for the tooltip and screen readers.</summary>
    private static string VoteTitle(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "Confirms the findings",
        EvidenceVoteType.Disputes     => "Disputes the findings",
        EvidenceVoteType.Inconclusive => "Inconclusive — can't say either way",
        _                             => v.ToString(),
    };
}
