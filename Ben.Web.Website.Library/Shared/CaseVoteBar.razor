@namespace Ben.Web.Website.Library.Shared

@if (Total == 0)
{
    <span class="text-muted" style="font-size:.75rem;">No votes yet</span>
}
else if (Compact)
{
    <span class="d-flex gap-1 align-items-center" style="font-size:.75rem; white-space:nowrap;">
        <span title="Confirms"  class="text-success">✓@Confirms</span>
        <span title="Disputes"  class="text-danger">✗@Disputes</span>
        <span title="Inconclusive" class="text-warning-emphasis">?@Inconclusive</span>
        <VoteScoreBadge Score="@Score" Total="@Total" Compact="true" />
    </span>
}
else
{
    <div class="mb-1">
        @* Progress bar: confirms=green, disputes=red, inconclusive=amber *@
        <div class="progress" style="height:6px; border-radius:3px;">
            <div class="progress-bar bg-success" style="width:@ConfirmsPct%"  title="@Confirms confirms"></div>
            <div class="progress-bar bg-danger"  style="width:@DisputesPct%"  title="@Disputes disputes"></div>
            <div class="progress-bar bg-warning" style="width:@InconclusivePct%" title="@Inconclusive inconclusive"></div>
        </div>
        <div class="d-flex gap-2 mt-1" style="font-size:.75rem;">
            <span class="text-success">✓ @Confirms</span>
            <span class="text-danger">✗ @Disputes</span>
            <span class="text-warning-emphasis">? @Inconclusive</span>
            <span class="text-muted ms-auto">@Total vote@(Total == 1 ? "" : "s")</span>
            <VoteScoreBadge Score="@Score" Total="@Total" />
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int  Confirms     { get; set; }
    [Parameter, EditorRequired] public int  Disputes     { get; set; }
    [Parameter, EditorRequired] public int  Inconclusive { get; set; }
    [Parameter, EditorRequired] public int  Total        { get; set; }

    /// <summary>
    /// The server's signed score. Passed in rather than worked out from the three counts: one place
    /// computes it, and a renderer that did its own arithmetic would be a fifth answer.
    /// </summary>
    [Parameter] public int Score { get; set; }
    [Parameter]                 public bool Compact      { get; set; }

    private double ConfirmsPct     => Total > 0 ? Confirms     * 100.0 / Total : 0;
    private double DisputesPct     => Total > 0 ? Disputes     * 100.0 / Total : 0;
    private double InconclusivePct => Total > 0 ? Inconclusive * 100.0 / Total : 0;
}
