@using Ben.Web.Services
@using Microsoft.JSInterop
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject IJSRuntime JS
@implements IDisposable

@*
    Item 161: the two decisions that block OTHER people — a client waiting on an answer, an
    applicant waiting at the door — surfaced right below the site-wide announcement, for the
    people who can act on them and nobody else.

    The server (action-needed) already scopes every count to the caller's own gates, so this
    component renders whatever arrives without re-deriving permissions. Dismissal is per
    group-and-counts in sessionStorage: quiet for the rest of the tab session, but a NEW
    arrival changes the counts and the banner returns — it nags without becoming wallpaper.
*@

@* Item 186 F10: the dark-launch reminder. SuperAdmin-only — the one person who can flip the
   switch — and only while the feed has content AND is off. Says the screening posture too,
   so nobody launches on manual-only screening without having read that they are. *@
@if (_feedReminder is { } reminder)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="status"
         id="feed-dark-reminder">
        <span aria-hidden="true">📣</span>
        <div class="flex-grow-1">
            The public feed has <strong>@reminder.FeedPostCount post@(reminder.FeedPostCount == 1 ? "" : "s")</strong>
            and is switched <strong>off</strong> — nobody outside this reminder can see any of it.
            The switch is at <a href="/admin/site-settings">Site Settings</a>.
            Screening is currently
            <strong>@(reminder.ScreeningIsAutomatic ? "automatic" : "manual-only — every photo and video waits for a moderator")</strong>.
        </div>
        <button type="button" class="btn-close" aria-label="Dismiss"
                @onclick="DismissFeedReminderAsync"></button>
    </div>
}

@foreach (var item in _visible)
{
    <div class="alert alert-info d-flex align-items-start gap-2 mb-3 action-needed-banner" role="status">
        <span aria-hidden="true">🔔</span>
        <div class="flex-grow-1">
            <strong>@item.OrganizationName</strong> has work waiting:
            @if (item.PendingClientRequests > 0)
            {
                <a href="/organizations/@item.OrganizationId?tab=requests">
                    @item.PendingClientRequests investigation request@(item.PendingClientRequests == 1 ? "" : "s")
                </a>
            }
            @if (item.PendingClientRequests > 0 && item.PendingMembershipRequests > 0)
            {
                <span> and </span>
            }
            @if (item.PendingMembershipRequests > 0)
            {
                <a href="/organizations/@item.OrganizationId?tab=members">
                    @item.PendingMembershipRequests membership application@(item.PendingMembershipRequests == 1 ? "" : "s")
                </a>
            }
        </div>
        <button type="button" class="btn-close" aria-label="Dismiss"
                @onclick="() => DismissAsync(item)"></button>
    </div>
}

@code {
    private readonly List<OrgActionNeededItem> _visible = [];
    private bool _loaded;
    private bool _loading;

    // Same two triggers as OnboardingGate, for the same reason: login happens INSIDE a
    // circuit, so a first-render-only fetch never runs for someone who just signed in.
    protected override void OnInitialized()
        => UserState.StateChanged += OnAuthChanged;

    /// <summary>
    /// The viewer changed — everything below was worked out for somebody else.
    /// </summary>
    /// <remarks>
    /// <b>IH-02, found in Ben's 2026-08-26 production sweep.</b> This used to call
    /// <see cref="LoadAsync"/> directly, which returned immediately because <c>_loaded</c> was
    /// already true — so after impersonating somebody, the banners on screen were still the
    /// ADMIN's. A client with no memberships at all sat looking at two organizations' pending
    /// work, named. The server scopes /action-needed to the caller correctly; nothing leaked out
    /// of it. What leaked was the previous identity's answer, kept on screen.
    ///
    /// The generation counter matters as much as the reset: a fetch already in flight for the old
    /// viewer must not be allowed to land after this one starts.
    /// </remarks>
    private void OnAuthChanged()
        => _ = InvokeAsync(async () =>
        {
            _generation++;
            _loaded = false;
            _visible.Clear();
            _feedReminder = null;
            StateHasChanged();
            await LoadAsync();
        });

    /// <summary>Bumped whenever the viewer changes; a load whose generation is stale is dropped.</summary>
    private int _generation;

    public void Dispose()
        => UserState.StateChanged -= OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Re-entrancy guard, same as OnboardingGate's: BOTH triggers (first render and the
        // sign-in StateChanged) can arrive before either finishes, and the old loaded-check
        // yielded to an await before setting its flag — so both proceeded and every banner
        // rendered twice (Ben's live report: each request showing as two identical rows).
        if (_loaded || _loading) return;
        _loading = true;
        var generation = _generation;
        try
        {
            await UserState.AuthReady;
            if (!UserState.IsAuthenticated) return;   // not loaded — a later sign-in retries

            IReadOnlyList<OrgActionNeededItem> items;
            try
            {
                items = (await AdminClient.GetActionNeededAsync()).Items;
            }
            catch
            {
                // A banner must never be the reason a page errors; it simply does not appear.
                return;
            }

            // Somebody else's answer, arriving late. Drop it rather than render it.
            if (generation != _generation) return;
            _loaded = true;

            // Rebuild rather than append — belt to the guard's braces.
            _visible.Clear();
            foreach (var item in items)
            {
                if (await IsDismissedAsync(item)) continue;
                _visible.Add(item);
            }

            await LoadFeedReminderAsync();

            if (generation != _generation) return;
            // Always re-render, including when the new viewer has NOTHING to show: the old
            // viewer's banners are what we are here to take off the screen.
            StateHasChanged();
        }
        finally { _loading = false; }
    }

    // ── The dark-launch reminder (item 186 F10) ──────────────────────────────

    private Ben.Service.Models.Feed.FeedModerationSummary? _feedReminder;

    private async Task LoadFeedReminderAsync()
    {
        // SuperAdmin holds the switch; nobody else is nagged about it.
        if (!UserState.IsSuperAdmin) return;
        try
        {
            var summary = await AdminClient.GetModerationSummaryAsync();
            if (summary is { FeedIsOn: false, FeedPostCount: > 0 }
                && await JS.InvokeAsync<string?>("sessionStorage.getItem", FeedReminderKey(summary)) is null)
            {
                _feedReminder = summary;
            }
        }
        catch { /* same rule as every banner here: never the reason a page errors */ }
    }

    // Counts in the key, like the org banners: new content since the dismissal brings it back.
    private static string FeedReminderKey(Ben.Service.Models.Feed.FeedModerationSummary summary)
        => $"feed-dark-reminder:{summary.FeedPostCount}";

    private async Task DismissFeedReminderAsync()
    {
        if (_feedReminder is not { } summary) return;
        _feedReminder = null;
        try { await JS.InvokeVoidAsync("sessionStorage.setItem", FeedReminderKey(summary), "1"); }
        catch { }
    }

    // The key carries the counts, so any CHANGE (a new arrival, or a queue that shrank and
    // grew again) invalidates an old dismissal and the banner comes back.
    private static string KeyFor(OrgActionNeededItem item)
        => $"action-needed:{item.OrganizationId}:{item.PendingClientRequests}:{item.PendingMembershipRequests}";

    private async Task<bool> IsDismissedAsync(OrgActionNeededItem item)
    {
        try
        {
            return await JS.InvokeAsync<string?>("sessionStorage.getItem", KeyFor(item)) is not null;
        }
        catch { return false; }
    }

    private async Task DismissAsync(OrgActionNeededItem item)
    {
        _visible.Remove(item);
        try
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", KeyFor(item), "1");
        }
        catch { /* Dismissal is a courtesy; losing it re-shows a true banner, never hides one. */ }
    }
}
