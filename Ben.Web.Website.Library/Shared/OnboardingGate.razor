@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@implements IDisposable

@*
    Item 166 W2: sends a never-onboarded person to /onboarding, once. Renders nothing itself.

    Two triggers, both needed: the first interactive render covers arriving at the site already
    signed in (a fresh circuit restoring a stored token), and the StateChanged subscription
    covers SIGNING IN, because login happens INSIDE a circuit — the layout does not re-render
    from scratch, so a first-render-only gate never fires for the person it exists for. That
    exact miss was caught by the W2 journey e2e.

    Null from the state call reads as onboarded — the gate must never trap someone in a wizard
    it cannot verify they need — and the wizard stamps on skip as well as finish, so this
    navigation can only ever happen before the person's first answer.
*@

@code {
    private bool _done;      // verified onboarded, or already sent — either way, this circuit is finished gating
    private bool _checking;

    protected override void OnInitialized()
        => UserState.StateChanged += OnAuthChanged;

    private void OnAuthChanged()
        => _ = InvokeAsync(CheckAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        await CheckAsync();
    }

    private async Task CheckAsync()
    {
        if (_done || _checking) return;
        _checking = true;
        try
        {
            await UserState.AuthReady;
            if (!UserState.IsAuthenticated) return;   // not done — a later sign-in re-enters here

            var path = new Uri(NavManager.Uri).AbsolutePath;
            if (path.StartsWith("/onboarding", StringComparison.OrdinalIgnoreCase)) { _done = true; return; }

            var state = await AdminClient.GetMyOnboardingStateAsync();
            if (state is null) return;                // unknown state = no gate, and another chance later

            _done = true;
            if (state == false) NavManager.NavigateTo($"/onboarding{NextQuery()}");
        }
        catch { /* see the note above: never trap, never crash the layout */ }
        finally { _checking = false; }
    }

    /// <summary>
    /// The page this person was heading for, as a query the wizard can hand back.
    /// </summary>
    /// <remarks>
    /// <para>Without this the wizard is a trapdoor: somebody follows a link to a case, a group or
    /// an invite, signs in, and lands on the home page with no idea where their link went. It
    /// happened on both accounts in the 2026-09-04 walkthrough, and a link that quietly forgets
    /// itself is worse than one that asks you to sign in twice.</para>
    ///
    /// <para>Signing in is the awkward case: the gate fires while the person is still on
    /// <c>/login</c>, which is not a destination — so the login page's own <c>returnUrl</c> is
    /// what gets carried, and it has already been through that page's open-redirect guard. The
    /// wizard checks again anyway, because a value that arrives in a query string is never
    /// trusted twice by the same code.</para>
    /// </remarks>
    private string NextQuery()
    {
        var uri = new Uri(NavManager.Uri);
        var path = uri.AbsolutePath;

        var next = path.Equals("/login", StringComparison.OrdinalIgnoreCase)
            ? Microsoft.AspNetCore.WebUtilities.QueryHelpers
                .ParseQuery(uri.Query).TryGetValue("returnUrl", out var fromLogin)
                    ? fromLogin.ToString()
                    : null
            : path + uri.Query;

        // Nowhere in particular is not worth carrying, and neither is the wizard itself.
        if (string.IsNullOrWhiteSpace(next)
            || next == "/"
            || next.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            || next.StartsWith("/onboarding", StringComparison.OrdinalIgnoreCase)
            || !next.StartsWith('/')
            || next.StartsWith("//"))
            return string.Empty;

        return $"?next={Uri.EscapeDataString(next)}";
    }

    public void Dispose()
        => UserState.StateChanged -= OnAuthChanged;
}
