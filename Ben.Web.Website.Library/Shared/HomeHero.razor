@namespace Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager
@inject Microsoft.Extensions.Options.IOptions<Ben.Data.Common.SiteIdentity> SiteOptions

@* ── Hero ─────────────────────────────────────────────────────────────────── *@
<div class="home-hero">
    <div class="home-hero__brand">
        @* The logo carries the site's name, so there is no title line under it.
           ONE picture now, and it is the vector.
           It used to be two rasters with the glow BAKED IN — logo-glass-white.png blended to white
           and logo-glass-gray.png to #363c41 — which meant each was tied to one palette. Signal's
           dark is #0C1017, not #363c41, so the baked halo showed as a grey box around the mark the
           moment the skin changed, and every future palette change would need both files redrawn.
           The glow is a CSS drop-shadow off the accent token instead, so it blends into whatever
           the page is, in either mode, with nothing to regenerate. *@
        <img src="/static/images/is-haunted-logo.svg" alt="@SiteOptions.Value.Name"
             class="home-hero__logo" width="627" height="627" />
        <p class="home-hero__tagline">Connect with paranormal investigation groups near you</p>
    </div>

    @* ── Location search ─────────────────────────────────────────────────── *@
    <div class="home-hero__search-box">
        <div class="home-hero__search-row">
            @* Enter submits, which a plain button in a div would not do — the search box is the
               one control on this page most people will use, and typing an address then pressing
               Enter is the natural way to use it. *@
            <input type="search" class="form-control home-hero__search-input"
                   placeholder="Enter your city, address, or zip code"
                   aria-label="City, address, or zip code"
                   value="@_query"
                   @oninput="OnQueryInput"
                   @onkeydown="OnQueryKeyDown" />
            <button type="button" class="btn btn-primary"
                    @onclick="SearchAsync"
                    disabled="@(_searching || string.IsNullOrWhiteSpace(_query))">
                @if (_searching)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    <span>Searching…</span>
                }
                else
                {
                    <span>Find Groups</span>
                }
            </button>
        </div>

        @if (_geocodeError is not null)
        {
            <div class="alert alert-warning mt-2 mb-0">@_geocodeError</div>
        }
    </div>

    @* ── CTA buttons ──────────────────────────────────────────────────────── *@
    <div class="home-hero__ctas">
        <a href="/find" class="btn btn-outline-secondary">Browse All Groups</a>
        @* The request wizard runs signed out and makes the account at Submit (site evaluation
           2026-09-06, phase 1), so this no longer routes the one person the page exists for
           through a sign-in screen first. *@
        <a href="/my-requests/new" class="btn btn-outline-info">Request an Investigation</a>
    </div>
</div>

@* ── Search results ────────────────────────────────────────────────────────── *@
@if (_searched && _results.Count == 0)
{
    <div class="container mt-4" style="max-width:760px;">
        <div class="alert alert-light text-muted text-center py-4">
            No organizations accepting cases were found near <strong>@_searchedQuery</strong>.
            <br /><a href="/find" class="text-decoration-none">Try a broader search on the full discovery page →</a>
        </div>
    </div>
}

@if (_results.Count > 0)
{
    <div class="container mt-4" style="max-width:900px;">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
            <h5 class="mb-0">Groups near <strong>@_searchedQuery</strong></h5>
            @if (_hasMore)
            {
                <a href="/find" class="small text-decoration-none">See all results →</a>
            }
        </div>
        <div class="row g-3">
            @foreach (var org in _results)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            @if (org.ActiveLogoFileId.HasValue)
                            {
                                <div class="mb-2">
                                    <Ben.Web.Website.Library.Kit.BenImage
                                        Src="@AdminClient.GetFileThumbnailUrl(org.ActiveLogoFileId.Value)"
                                        Alt="@org.Name"
                                        Style="max-height:36px; max-width:72px; object-fit:contain;" />
                                </div>
                            }
                            <h6 class="card-title mb-1">@org.Name</h6>
                            @if (!string.IsNullOrWhiteSpace(org.DisplayLabel))
                            {
                                <p class="text-secondary small mb-1">@org.DisplayLabel</p>
                            }
                            <p class="text-muted mb-0" style="font-size:.8rem;">
                                @if (org.IsWithinRange)
                                {
                                    <span class="text-success fw-semibold">✓ Within range</span>
                                    <span> · @(org.DistanceFromSearchMiles.ToString("F1")) mi</span>
                                }
                                else
                                {
                                    <span>@(org.DistanceFromSearchMiles.ToString("F1")) mi away</span>
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <a href="/o/@org.UrlName" class="btn btn-sm btn-outline-primary">View Group</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .home-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem 1rem 1rem;
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Fluid: follows the window as it is resized — never under 220px on a phone, never over 460px. */
    .home-hero__logo {
        --logo-w: clamp(220px, 42vw, 460px);
        width: var(--logo-w);
        max-width: 90vw;
        height: auto;
    }

    /* The glow, which used to be painted into the two rasters and is now cast off the accent.
       Two shadows rather than one: a tight dark lift so the white ghost keeps an edge on a white
       page, and a wide accent bloom that ties the mark to the rest of the skin. Both read in
       either mode because they are drawn from tokens, and nothing has to be redrawn when the
       palette moves again. */
    .home-hero__logo {
        filter:
            drop-shadow(0 2px 10px rgba(0, 0, 0, .18))
            drop-shadow(0 0 48px rgba(var(--ben-accent-rgb), .40));
    }

    /* The vector has no reflection under it, so the tagline no longer has to climb into one. */
    .home-hero__logo { margin-bottom: .35rem; }

    .home-hero__tagline {
        color: var(--kendo-color-subtle-text, #888);
        font-size: 1.05rem;
        margin: 0;
    }

    .home-hero__brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .4rem;
    }

    .home-hero__search-box {
        width: 100%;
        max-width: 560px;
    }

    .home-hero__search-row {
        display: flex;
        gap: .5rem;
    }

    .home-hero__search-input {
        flex: 1;
    }

    .home-hero__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        justify-content: center;
    }

</style>

@code {
    // Item #103: the hero's call-to-action row is auth-gated in markup, and auth resolves
    // asynchronously after the circuit connects — without this, a signed-in user hard-navigating
    // to the home page kept seeing the signed-out buttons until something else re-rendered.
    protected override async Task OnInitializedAsync()
    {
        var before = UserState.IsAuthenticated;
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)
            && UserState.IsAuthenticated != before)
        {
            StateHasChanged();
        }
    }

    private string  _query         = "";
    private string  _searchedQuery = "";
    private bool    _searching;
    private bool    _searched;
    private bool    _hasMore;
    private string? _geocodeError;
    private IReadOnlyList<OrgSearchResult> _results = [];

    // Typing invalidates the previous answer: the old error and the "no results" state both refer
    // to a query that is no longer on screen. This is what the TextBox's OnChange used to do.
    private void OnQueryInput(ChangeEventArgs e)
    {
        _query        = e.Value?.ToString() ?? "";
        _geocodeError = null;
        _searched     = false;
    }

    private async Task OnQueryKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;

        _searching    = true;
        _geocodeError = null;
        StateHasChanged();

        var geo = await AdminClient.SearchGeocodingAsync(_query.Trim());

        if (geo?.Latitude is null || geo.Longitude is null)
        {
            _geocodeError = $"Could not locate \"{_query.Trim()}\". Try a city name or zip code.";
            _searching    = false;
            return;
        }

        // Fetch one extra to detect whether there are more results than we show
        var all      = await AdminClient.SearchOrganizationsAsync((double)geo.Latitude, (double)geo.Longitude, maxResults: 7);

        // The front page, signed out: the audience least able to tell a broken search from a part
        // of the country with no groups in it. Item 120.
        if (all.Failed)
        {
            _geocodeError = all.Reason ?? "The search could not be run just now. Please try again.";
            _searching    = false;
            return;
        }

        _hasMore     = all.Items.Count > 6;
        _results     = all.Items.Take(6).ToList();
        _searchedQuery = _query.Trim();
        _searched    = true;
        _searching   = false;
    }
}
