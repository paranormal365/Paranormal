@namespace Ben.Web.Website.Library.Shared
@implements IAsyncDisposable

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@*
   Who is on tonight's team and who has turned up.

   Polls rather than pushes: no real-time infrastructure exists in this app, and adding SignalR for
   a handful of chips that change a few times an evening would be a large piece of machinery to
   maintain for a small effect. A timer every few seconds is ample and can be deleted in a line.
*@

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h6 class="card-title mb-1">Team<HelpLink Slug="working-a-case" Anchor="arriving-on-site" /></h6>
                <p class="text-secondary small mb-0">
                    @_arrivedCount of @_roster.Count arrived
                </p>
            </div>

            @if (_myEntry is not null && _myEntry.DidAttend != true)
            {
                <button type="button" class="btn btn-primary"
                        disabled="@_checkingIn"
                        @onclick="@OpenCheckIn">
                    <BenIcon Name="map-pin" Class="me-1" />@(_checkingIn ? "Saving…" : "I've arrived")
                </button>
            }
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mt-3 mb-0">@_error</div>
        }

        @* ── Check-in ─────────────────────────────────────────────────────── *@
        @if (_showCheckIn)
        {
            <div class="border rounded p-3 mt-3">
                <label class="form-label small mb-1" for="investigationroster-when-did-you-get-ab36">When did you get there?</label>
                @* Editable rather than assumed-now. Most sites have no signal, so checking in the
                   next morning and correcting the time is the ordinary path, not an edge case. *@
                <BenDateField Mode="DateEntryMode.DateTime" Id="investigationroster-when-did-you-get-ab36" Width="260px" @bind-Value="_statedArrival" />
                <div class="form-text">Leave as-is if you are checking in now.</div>

                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-primary"
                            disabled="@_checkingIn" @onclick="CheckInAsync">Check in</button>
                    <button type="button" class="btn btn-link text-decoration-none"
                            @onclick="@(() => _showCheckIn = false)">Cancel</button>
                </div>
            </div>
        }

        @* ── Roster ───────────────────────────────────────────────────────── *@
        @if (_rosterResult.Failed)
        {
            @* Who attended is evidence. An empty roster over a refusal is a record that says
               nobody was there. *@
            <BenListState TItem="InvestigationRosterEntry" Result="@_rosterResult" />
        }
        else if (_roster.Count == 0)
        {
            <p class="text-secondary small fst-italic mt-3 mb-0">Nobody has been added to this investigation yet.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                @foreach (var entry in _roster)
                {
                    @* Keyed: naming a lead reorders this list, and without a key Blazor reuses
                       elements by position, so the badges would follow the slot rather than the
                       person. *@
                    <span @key="entry.AttendeeId"
                          class="badge rounded-pill @ChipClass(entry) d-inline-flex align-items-center gap-1"
                          style="font-size:.8rem;padding:.45rem .7rem;"
                          title="@ChipTitle(entry)">
                        @entry.DisplayName
                        @if (entry.IsLead)
                        {
                            <span class="badge bg-body-secondary text-body-emphasis border">Lead</span>
                        }
                        @if (entry.DateArrived is { } arrived)
                        {
                            <span class="opacity-75">@arrived.ToViewerLocalTime(UserState).ToDisplayTime()</span>
                        }
                    </span>
                }
            </div>

            @* ── Who's doing what (item 158) ──────────────────────────────── *@
            @if (_board is { } board && board.Duties.Count > 0)
            {
                <div class="mt-4">
                    <h6 class="fw-semibold mb-1">
                        Who's doing what<HelpLink Slug="working-a-case" Anchor="duties-whos-doing-what-tonight" />
                    </h6>
                    <p class="text-secondary small mb-2">
                        Duties for this visit only. An unfilled duty is the gap to close before
                        the night of.
                    </p>

                    @if (_dutyError is not null)
                    {
                        <div class="alert alert-warning py-2 small d-flex align-items-center gap-2 flex-wrap">
                            <span>@_dutyError</span>
                            @if (_pendingOverride is { } pending)
                            {
                                <button type="button" class="btn btn-warning btn-sm"
                                        @onclick="@(() => AssignDutyAsync(pending.AttendeeId, pending.DutyId, overrideEligibility: true))">
                                    Assign anyway
                                </button>
                            }
                        </div>
                    }

                    <div class="d-flex flex-column gap-2" style="max-width:560px;">
                        @foreach (var duty in board.Duties)
                        {
                            var holders = board.Assignments.Where(a => a.DutyId == duty.Id).ToList();
                            <div class="d-flex align-items-center gap-2 flex-wrap border rounded px-2 py-1" @key="duty.Id">
                                <span class="fw-semibold" style="min-width:10rem;">@duty.Name</span>
                                @if (duty.MinimumLevelName is not null)
                                {
                                    <span class="badge bg-secondary" title="Minimum title to hold this duty">@duty.MinimumLevelName+</span>
                                }
                                @if (holders.Count == 0)
                                {
                                    <span class="badge bg-warning text-dark">Unfilled</span>
                                }
                                @foreach (var holder in holders)
                                {
                                    var entry = _roster.FirstOrDefault(r => r.AttendeeId == holder.AttendeeId);
                                    <span class="badge bg-info d-inline-flex align-items-center gap-1" @key="holder.AttendeeId">
                                        @(entry?.DisplayName ?? "—")
                                        @if (holder.EligibilityOverridden)
                                        {
                                            <span title="Assigned past the duty's minimum title, deliberately">⚠</span>
                                        }
                                        @if (CanManage)
                                        {
                                            <a href="#" class="text-reset text-decoration-none" title="Take this duty back"
                                               @onclick:preventDefault
                                               @onclick="@(() => UnassignDutyAsync(holder.AttendeeId, duty.Id))">✕</a>
                                        }
                                    </span>
                                }
                                @if (CanManage && _roster.Count > 0)
                                {
                                    <select class="form-select form-select-sm ms-auto" style="max-width:12rem;"
                                            id="duty-assign-@duty.Id" value=""
                                            @onchange="@(e => OnDutyPick(duty.Id, e.Value?.ToString()))">
                                        <option value="">assign…</option>
                                        @foreach (var entry in _roster.Where(r => holders.All(h => h.AttendeeId != r.AttendeeId)))
                                        {
                                            <option value="@entry.AttendeeId">@entry.DisplayName</option>
                                        }
                                    </select>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── What people saw ──────────────────────────────────────────── *@
            <div class="mt-4">
                <h6 class="fw-semibold mb-1">
                    What people saw<HelpLink Slug="working-a-case" Anchor="writing-up-what-you-saw" />
                </h6>
                <p class="text-secondary small">
                    One account each, in their own words. Four people in a building at night see
                    four different nights.
                </p>

                @if (_findings.Count == 0 && _myEntry is null)
                {
                    <p class="text-secondary small fst-italic mb-0">Nothing written up yet.</p>
                }

                @foreach (var finding in _findings.Where(f => f.AppUserId != UserState.UserId))
                {
                    <div class="border rounded p-3 mb-2">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-semibold">@(finding.DisplayName ?? "Somebody")</span>
                            <span class="text-secondary small">
                                @finding.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                                @if (finding.DateUpdated is { } revised)
                                {
                                    @* Said out loud: a first draft and a revision a week later are
                                       different claims, and a reader comparing accounts wants to
                                       know which one they have. *@
                                    <span title="@revised.ToViewerLocalTime(UserState).ToDisplayDateTime()"> · revised</span>
                                }
                            </span>
                        </div>
                        <div class="mt-1" style="white-space:pre-wrap;">@finding.Narrative</div>
                    </div>
                }

                @* Only people who were on the team have anything to file — the server refuses
                   anyone else, so offering the box would be offering a rejection. *@
                @if (_myEntry is not null)
                {
                    <div class="border rounded p-3 bg-body-tertiary">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <span class="fw-semibold">Your account</span>
                            @if (_myFinding is { } mine)
                            {
                                <span class="text-secondary small">
                                    Filed @mine.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                                </span>
                            }
                        </div>

                        @* Plain textarea: this gates the Save button, and Telerik binds on blur —
                           somebody who types and clicks Save without leaving the box would be told
                           it is empty while looking at their own words. *@
                        <textarea class="form-control" rows="4" value="@_narrative"
                                  placeholder="What did you see, hear, or measure? Anything that struck you as ordinary is worth saying too."
                                  @oninput="@(e => _narrative = e.Value?.ToString() ?? string.Empty)"></textarea>

                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-primary"
                                    disabled="@(string.IsNullOrWhiteSpace(_narrative) || _savingFinding)"
                                    @onclick="SaveMyFindingAsync">
                                @(_savingFinding ? "Saving…" : _myFinding is null ? "File it" : "Save changes")
                            </button>

                            @if (_myFinding is not null)
                            {
                                <button type="button" class="btn btn-link text-decoration-none"
                                        disabled="@_savingFinding"
                                        @onclick="DeleteMyFindingAsync">Withdraw</button>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Manage-gated: correcting somebody else's attendance is not a participant's job. *@
            @if (CanManage)
            {
                @* Below 768px each person is a card (10/16/2026); see InvestigationRoster.razor.css.
                   Every cell names its column in data-label for that reason. *@
                <div class="table-responsive mt-3">
                    <table class="table table-sm align-middle mb-0 roster-manage">
                        <thead>
                            <tr>
                                <th>Who</th><th>Arrived</th><th class="text-center">Attended</th><th class="text-center">Lead</th>
                                @if (CanChangeTeam)
                                {
                                    <th class="text-end"><span class="visually-hidden">Take off the team</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _roster)
                            {
                                @* Keyed, and this row is why: the checkbox and the radio hold
                                   their own DOM state, so an unkeyed reorder leaves the previous
                                   lead's radio marked next to the new lead's name. Seen live —
                                   the chips above said one person and the radio below said the
                                   other. *@
                                <tr @key="entry.AttendeeId">
                                    <td class="roster-manage__who" data-label="Who">@entry.DisplayName</td>
                                    <td class="text-nowrap" data-label="Arrived">
                                        @(entry.DateArrived?.ToViewerLocalTime(UserState).ToDisplayDateTime() ?? "—")
                                        @if (entry.DidAttend == true && !entry.SelfReported)
                                        {
                                            <span class="badge bg-secondary ms-1" title="Recorded by someone else, not by them">Recorded</span>
                                        }
                                    </td>
                                    <td class="text-center" data-label="Attended">
                                        <input type="checkbox" class="form-check-input"
                                               @key="@($"{entry.AttendeeId}-{_refusedAttendance}")"
                                               id="@($"roster-attended-{entry.AttendeeId}")"
                                               aria-label="@($"{entry.DisplayName} attended")"
                                               checked="@(entry.DidAttend == true)"
                                               @onchange="@(e => OverrideAsync(entry, (bool)(e.Value ?? false)))" />
                                    </td>
                                    <td class="text-center" data-label="Lead">
                                        @* A radio, not a checkbox: exactly one person leads a
                                           visit, and the server clears the previous holder either
                                           way. A checkbox would suggest several are allowed. *@
                                        <input type="radio" class="form-check-input"
                                               id="@($"roster-lead-{entry.AttendeeId}")"
                                               aria-label="@($"{entry.DisplayName} leads this visit")"
                                               name="@($"lead-{InvestigationId}")"
                                               checked="@entry.IsLead"
                                               @onchange="@(() => SetLeadAsync(entry, true))" />
                                    </td>
                                    @if (CanChangeTeam)
                                    {
                                        <td class="text-end roster-manage__remove" data-label="Team">
                                            @* Asks first (10/16/2026). It used to take somebody off
                                               in one click, and their duties went with them unsaid. *@
                                            <button type="button" class="btn btn-outline-danger btn-sm text-nowrap"
                                                    id="@($"roster-remove-{entry.AttendeeId}")"
                                                    title="Take @entry.DisplayName off the team"
                                                    disabled="@_teamBusy"
                                                    @onclick="@(() => AskToRemove(entry))">
                                                <BenIcon Name="x" /><span class="visually-hidden">Take @entry.DisplayName off the team</span>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_confirmRemove is { } leaving)
                {
                    <div class="alert alert-warning py-2 small mt-2 mb-0 d-flex flex-wrap align-items-center gap-2"
                         role="alert" id="@($"roster-remove-ask-{InvestigationId}")">
                        <span class="flex-grow-1">@RemovalQuestion(leaving.DisplayName, DutiesOf(leaving.AttendeeId), leaving.IsLead)</span>
                        <button type="button" class="btn btn-danger btn-sm roster-touch"
                                id="@($"roster-remove-yes-{InvestigationId}")"
                                disabled="@_teamBusy" @onclick="@(() => RemoveFromTeamAsync(leaving))">
                            @(_teamBusy ? "Taking them off…" : "Take them off")
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm roster-touch"
                                id="@($"roster-remove-no-{InvestigationId}")"
                                disabled="@_teamBusy" @onclick="@(() => _confirmRemove = null)">Keep them</button>
                    </div>
                }

                <div class="form-text mt-1">
                    The lead can edit this investigation, and stops being able to when the lead
                    changes.
                    @if (_roster.FirstOrDefault(r => r.IsLead) is { } lead)
                    {
                        <a href="#" class="ms-1" @onclick:preventDefault
                           @onclick="@(() => SetLeadAsync(lead, false))">Nobody leads this visit</a>
                    }
                </div>
            }
        }

        @* ── Who's on the team (10/16/2026) ──────────────────────────────────
           A visit booked from the group's Investigations page has no case, and the only way onto
           a team used to be the case page's attendee table — so these teams could never be filled,
           and check-in, the lead and duties were all out of reach. Manage-gated, on the server's
           verdict, like everything else that changes somebody else's record here. *@
        @if (CanManage && CanChangeTeam && !_rosterResult.Failed)
        {
            <div class="mt-3 roster-add" id="@($"investigation-team-add-{InvestigationId}")">
                @if (_teamError is not null)
                {
                    <div class="alert alert-danger py-2 small mb-2" role="alert">@_teamError</div>
                }

                @if (!_membersLoaded)
                {
                    <p class="text-secondary small mb-0">Loading the group's members…</p>
                }
                else if (_membersFailed)
                {
                    <p class="text-danger small mb-0">
                        The group's member list couldn't be read, so nobody can be added just now.
                    </p>
                }
                else if (Addable.Count == 0)
                {
                    <p class="text-secondary small mb-0">
                        Everyone in the group who can take part is already on this team.
                    </p>
                }
                else
                {
                    <label class="form-label small mb-1" for="@($"investigation-team-pick-{InvestigationId}")">Add to the team</label>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <BenSelect Id="@($"investigation-team-pick-{InvestigationId}")"
                                   Data="@Addable" @bind-Value="@_addUserId"
                                   TextField="@nameof(TeamOption.Label)" ValueField="@nameof(TeamOption.UserId)"
                                   DefaultText="Choose a member…" Width="240px" Class="form-select-sm" />
                        <button type="button" class="btn btn-primary btn-sm roster-touch"
                                disabled="@(_addUserId == Guid.Empty || _teamBusy)"
                                @onclick="AddToTeamAsync">
                            <BenIcon Name="plus" Class="me-1" />@(_adding ? "Adding…" : "Add")
                        </button>
                    </div>
                    <div class="form-text">
                        Once they're on the team they can check in, write up what they saw, and be
                        made the lead or given a duty.
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid OrgId { get; set; }
    [Parameter, EditorRequired] public Guid InvestigationId { get; set; }

    /// <summary>The server's verdict, passed down. Not worked out here.</summary>
    [Parameter] public bool CanManage { get; set; }

    /// <summary>
    /// Whether this panel offers putting people on the team and taking them off (10/16/2026).
    /// </summary>
    /// <remarks>
    /// Off by default because a case's own page already has an attendee table that does this, with
    /// roles; two add controls on one screen that do not refresh each other would disagree. The
    /// group's Investigations page turns it on — it is the only screen a visit with no case has.
    /// Still shown only to <see cref="CanManage"/>.
    /// </remarks>
    [Parameter] public bool CanChangeTeam { get; set; }

    /// <summary>Raised with the new team size after somebody is added or taken off.</summary>
    [Parameter] public EventCallback<int> OnTeamChanged { get; set; }

    /// <summary>How often to re-read the roster. A few seconds is ample for a handful of chips.</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(12);

    /// <summary>
    /// Bumped by the host after it writes something this panel shows, so the panel re-reads at
    /// once instead of on its next poll (site evaluation 2026-09-06, W-A7).
    /// </summary>
    /// <remarks>
    /// A token rather than a component reference: the host renders one of these per investigation
    /// inside a loop, and <c>@@ref</c> cannot be captured per iteration. The panel used to show
    /// "0 of 0 arrived / Nobody has been added to this investigation yet" and hide the duty board
    /// for up to twelve seconds after somebody had just been added right above it, which reads as
    /// the add having failed.
    /// </remarks>
    [Parameter] public int ReloadToken { get; set; }

    private List<InvestigationRosterEntry> _roster = [];
    private InvestigationDutyBoard? _board;
    private string? _dutyError;
    private (Guid AttendeeId, Guid DutyId)? _pendingOverride;
    private LoadResult<InvestigationRosterEntry> _rosterResult;
    private InvestigationRosterEntry? _myEntry;
    private int _arrivedCount;

    private List<InvestigationFindingRecord> _findings = [];
    private InvestigationFindingRecord? _myFinding;
    private string _narrative = string.Empty;
    private bool _savingFinding;

    private bool _showCheckIn;
    private bool _checkingIn;
    private DateTime? _statedArrival;
    private string? _error;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private Guid _loadedFor;
    private int  _loadedToken;

    protected override async Task OnParametersSetAsync()
    {
        if (InvestigationId == Guid.Empty) return;
        if (InvestigationId == _loadedFor && ReloadToken == _loadedToken) return;

        var isNewInvestigation = InvestigationId != _loadedFor;
        _loadedFor   = InvestigationId;
        _loadedToken = ReloadToken;
        if (isNewInvestigation) _statedArrival = null;
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null) return;
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(PollInterval);
        _ = PollAsync(_cts.Token);
    }

    /// <summary>Re-reads the roster until the component goes away.</summary>
    private async Task PollAsync(CancellationToken ct)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Ordinary teardown — the page was left. Nothing to report.
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _rosterResult = await AdminClient.GetInvestigationRosterAsync(OrgId, InvestigationId);
            _roster       = _rosterResult.Items.ToList();
            _arrivedCount = _roster.Count(r => r.DidAttend == true);
            _myEntry = _roster.FirstOrDefault(r => r.AppUserId == UserState.UserId);

            _board = await AdminClient.GetInvestigationDutyBoardAsync(OrgId, InvestigationId);

            _findings = (await AdminClient.GetInvestigationFindingsAsync(OrgId, InvestigationId)).Items.ToList();
            _myFinding = _findings.FirstOrDefault(f => f.AppUserId == UserState.UserId);

            // Only seeded from the server when the box is untouched. Overwriting what somebody is
            // halfway through typing, on a poll they did not ask for, would be its own small
            // disaster.
            if (!_savingFinding && string.IsNullOrWhiteSpace(_narrative))
                _narrative = _myFinding?.Narrative ?? string.Empty;

            // Once, not every poll: the group's members change far less often than who has arrived.
            if (CanManage && CanChangeTeam && !_membersLoaded)
                await LoadMembersAsync();
        }
        catch
        {
            // A failed poll is not worth an error banner that appears and vanishes on its own —
            // the previous roster stays on screen and the next tick tries again.
        }
    }

    private async Task OnDutyPick(Guid dutyId, string? raw)
    {
        if (!Guid.TryParse(raw, out var attendeeId)) return;
        await AssignDutyAsync(attendeeId, dutyId, overrideEligibility: false);
    }

    private async Task AssignDutyAsync(Guid attendeeId, Guid dutyId, bool overrideEligibility)
    {
        _dutyError = null;
        _pendingOverride = null;

        var (board, refusal) = await AdminClient.AssignInvestigationDutyAsync(
            OrgId, InvestigationId, attendeeId, dutyId, overrideEligibility);

        if (board is null)
        {
            // The eligibility sentence, with the confirm the server asked for. Any other refusal
            // renders without one — there is nothing to confirm past a Forbid.
            _dutyError = refusal;
            if (refusal?.Contains("Assign anyway", StringComparison.OrdinalIgnoreCase) == true)
                _pendingOverride = (attendeeId, dutyId);
            return;
        }

        _board = board;
        // Assigning the lead duty writes through to IsLead, which reorders the chips above —
        // refresh the roster so both tellings agree.
        await LoadAsync();
    }

    private async Task UnassignDutyAsync(Guid attendeeId, Guid dutyId)
    {
        _dutyError = null;
        _pendingOverride = null;
        _board = await AdminClient.UnassignInvestigationDutyAsync(OrgId, InvestigationId, attendeeId, dutyId)
                 ?? _board;
        await LoadAsync();
    }

    private async Task SaveMyFindingAsync()
    {
        if (string.IsNullOrWhiteSpace(_narrative) || _savingFinding) return;

        _savingFinding = true;
        _error = null;

        try
        {
            _myFinding = await AdminClient.SaveMyInvestigationFindingAsync(
                OrgId, InvestigationId, _narrative);
            await LoadAsync();
        }
        catch
        {
            _error = "That could not be saved just now.";
        }

        _savingFinding = false;
    }

    private async Task DeleteMyFindingAsync()
    {
        _savingFinding = true;
        _error = null;

        try
        {
            await AdminClient.DeleteMyInvestigationFindingAsync(OrgId, InvestigationId);
            _myFinding = null;
            _narrative = string.Empty;
            await LoadAsync();
        }
        catch
        {
            _error = "That could not be withdrawn just now.";
        }

        _savingFinding = false;
    }

    private async Task SetLeadAsync(InvestigationRosterEntry entry, bool isLead)
    {
        _error = null;
        try
        {
            // The whole roster comes back, because naming a lead also clears somebody else's row.
            // The whole roster comes back, so a refused change must not be applied as one:
            // an empty roster here would wipe everybody off the screen as though it had worked.
            var (roster, error) = await AdminClient.SetInvestigationLeadAsync(
                OrgId, InvestigationId, entry.AttendeeId, isLead);

            if (error is not null) { _error = error; return; }

            _roster  = roster.ToList();
            _myEntry = _roster.FirstOrDefault(r => r.AppUserId == UserState.UserId);
        }
        catch
        {
            // Said out loud, unlike a failed poll: this was a deliberate action, and silently
            // leaving the old lead in place would look like it worked.
            _error = "That could not be saved just now.";
            await LoadAsync();
        }
    }

    /// <summary>
    /// Opens the check-in box with the time filled in as now, on the reader's own clock.
    /// </summary>
    /// <remarks>
    /// Filled when the box opens rather than when the investigation loads: the reader's zone is
    /// only known once the browser has said what it is, and on a Blazor Server page
    /// <c>DateTime.Now</c> is the server's clock, which is nobody's in particular (10/16/2026).
    /// </remarks>
    private void OpenCheckIn()
    {
        if (_statedArrival is null)
        {
            var now = UserState.NowInViewerTimeZone();
            _statedArrival = new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0);
        }
        _showCheckIn = true;
    }

    private async Task CheckInAsync()
    {
        _checkingIn = true;
        _error = null;

        // Read on the person's own clock and sent as UTC, because the field is what they are
        // reading off their own watch. Converted through the reader's zone, not the server's.
        DateTime? stated = _statedArrival?.ToUtcFromViewerLocal(UserState);

        // The server's own sentence (10/16/2026). This used to say "Check the arrival time is not in
        // the future." for every failure, including ones that had nothing to do with the time.
        var (result, error) = await AdminClient.CheckInToInvestigationAsync(OrgId, InvestigationId, stated);

        _checkingIn = false;

        if (result is null)
        {
            _error = error ?? "Your arrival couldn't be saved just now.";
            return;
        }

        _showCheckIn = false;
        await LoadAsync();
    }

    private async Task OverrideAsync(InvestigationRosterEntry entry, bool didAttend)
    {
        _error = null;

        var (result, error) = await AdminClient.OverrideInvestigationAttendanceAsync(
            OrgId, InvestigationId, entry.AttendeeId, didAttend,
            didAttend ? entry.DateArrived ?? DateTime.UtcNow : null);

        if (result is null)
        {
            // The server's sentence (10/16/2026), and the box put back to what is saved: the
            // browser has already ticked it, and a tick over a refusal reads as success.
            _error = error ?? "That attendance couldn't be saved just now.";
            // A new key draws a fresh box from what is saved; Blazor would otherwise leave the
            // browser's own tick in place, because what it rendered has not changed.
            _refusedAttendance++;
            await LoadAsync();
            return;
        }

        await LoadAsync();
    }

    // ── Who's on the team (10/16/2026) ───────────────────────────────────────

    private sealed record TeamOption(Guid UserId, string Label);

    private List<OrgMembershipItem> _members = [];
    private bool _membersLoaded;
    private bool _membersFailed;
    private Guid _addUserId;
    private bool _teamBusy;
    private bool _adding;
    private string? _teamError;

    /// <summary>
    /// The group's members who could be put on this team: active, able to take part (a Viewer can
    /// only look), and not on it already. The server applies the same rule and says why if not.
    /// </summary>
    private List<TeamOption> Addable => _members
        .Where(m => m.IsActive && m.Role != Ben.Data.Common.Enums.OrganizationMemberRole.Viewer)
        .Where(m => _roster.All(r => r.AppUserId != m.AppUserId))
        .Select(m => new TeamOption(m.AppUserId, m.DisplayName ?? "A member"))
        .OrderBy(o => o.Label, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private async Task LoadMembersAsync()
    {
        var members = await AdminClient.GetOrganizationMembersAsync(OrgId);
        _membersFailed = members.Failed;
        _members = members.Items.ToList();
        _membersLoaded = true;
    }

    private async Task AddToTeamAsync()
    {
        if (_addUserId == Guid.Empty || _teamBusy) return;

        _teamBusy = true;
        _adding = true;
        _teamError = null;
        try
        {
            // The whole roster comes back; on a refusal it is empty and is not applied, so the
            // people already on the team stay on screen beside the reason.
            var (roster, error) = await AdminClient.AddInvestigationTeamMemberAsync(OrgId, InvestigationId, _addUserId);
            if (error is not null) { _teamError = error; return; }

            _addUserId = Guid.Empty;
            await LoadAsync();
            await OnTeamChanged.InvokeAsync(roster.Count);
        }
        catch
        {
            _teamError = "That could not be saved just now.";
        }
        finally
        {
            _teamBusy = false;
            _adding = false;
        }
    }

    /// <summary>Who the ✕ was pressed for, waiting for a yes. Asked inline, never in a dialog.</summary>
    private InvestigationRosterEntry? _confirmRemove;

    /// <summary>Bumped when an Attended change is refused, so the box is drawn again from what is saved.</summary>
    private int _refusedAttendance;

    private void AskToRemove(InvestigationRosterEntry entry)
    {
        _teamError = null;
        _confirmRemove = entry;
    }

    /// <summary>The names of the duties this person holds on this visit, in the board's order.</summary>
    private IReadOnlyList<string> DutiesOf(Guid attendeeId)
    {
        if (_board is not { } board) return [];
        return board.Duties
            .Where(d => board.Assignments.Any(a => a.AttendeeId == attendeeId && a.DutyId == d.Id))
            .Select(d => d.Name)
            .ToList();
    }

    /// <summary>
    /// The question the ✕ asks: who is going, and what goes with them (10/16/2026).
    /// </summary>
    /// <remarks>
    /// "Take James off the team? Their duty (Lead) goes too." Before, the ✕ removed them in one
    /// click and their duties went with them without a word.
    /// </remarks>
    internal static string RemovalQuestion(string? name, IReadOnlyList<string> duties, bool isLead)
    {
        var who = string.IsNullOrWhiteSpace(name) ? "this person" : name.Trim();
        var question = $"Take {who} off the team?";

        if (duties.Count == 1)
            question += $" Their duty ({duties[0]}) goes too.";
        else if (duties.Count > 1)
            question += $" Their duties ({string.Join(", ", duties)}) go too.";

        if (isLead)
            question += " They lead this visit, so nobody will lead it until you choose someone.";

        return question;
    }

    private async Task RemoveFromTeamAsync(InvestigationRosterEntry entry)
    {
        if (_teamBusy) return;

        _teamBusy = true;
        _teamError = null;
        try
        {
            var (roster, error) = await AdminClient.RemoveInvestigationTeamMemberAsync(OrgId, InvestigationId, entry.AttendeeId);
            _confirmRemove = null;
            if (error is not null) { _teamError = error; return; }

            await LoadAsync();
            await OnTeamChanged.InvokeAsync(roster.Count);
        }
        catch
        {
            _teamError = "That could not be saved just now.";
        }
        finally
        {
            _teamBusy = false;
        }
    }

    private static string ChipClass(InvestigationRosterEntry entry) => entry.DidAttend switch
    {
        true => "bg-success",
        false => "bg-secondary",
        // Not yet known reads as waiting, not as a problem — most of the evening is spent here.
        _ => "bg-body-secondary text-body-emphasis border",
    };

    private static string ChipTitle(InvestigationRosterEntry entry)
    {
        if (entry.DidAttend == false) return "Marked as not attending";
        if (entry.DidAttend != true) return $"Not arrived yet · {entry.Rsvp}";
        return entry.SelfReported
            ? "Checked in themselves"
            : "Attendance recorded by someone else";
    }

    public async ValueTask DisposeAsync()
    {
        // Without this the timer keeps ticking against a dead circuit after navigation.
        if (_cts is not null) await _cts.CancelAsync();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
