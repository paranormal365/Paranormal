@using Ben.Web.Services.Help

@*
    A small question-mark badge that opens the relevant help document.

    Opens in a new tab on purpose. Several screens in this app hold unsaved work — the video
    editor, the case and occurrence dialogs — and navigating away in-tab risks losing it. An
    in-page overlay would be worse still: it covers the very interface the document is explaining.
    A new tab lets someone read the guidance beside the screen it describes.
*@

<a class="help-link-badge @CssClass"
   href="@Href"
   target="_blank"
   rel="noopener"
   title="Link to help..."
   aria-label="@($"Help: {(Anchor is null ? Slug : Anchor)}")">?</a>

@code {
    /// <summary>Slug of the help document, e.g. <c>your-profile</c>.</summary>
    [Parameter, EditorRequired] public string Slug { get; set; } = string.Empty;

    /// <summary>
    /// Optional heading anchor within the document. Use the heading text lower-cased with spaces
    /// as hyphens — the same id the document's own contents list links to.
    /// </summary>
    [Parameter] public string? Anchor { get; set; }

    /// <summary>Extra classes for the caller's layout.</summary>
    [Parameter] public string? CssClass { get; set; }

    private string Href => Anchor is { Length: > 0 }
        ? $"/help/{Slug}#{Anchor}"
        : $"/help/{Slug}";
}
