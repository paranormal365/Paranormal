@page "/help"
@using Ben.Web.Services.Help
@inject HelpContentService Content
@inject HelpViewerResolver Viewers
@inject Microsoft.Extensions.Options.IOptions<Ben.Data.Common.SiteIdentity> SiteOptions

<PageTitle>Help</PageTitle>

<div class="container-fluid py-3 help-page">
    <div class="mb-4">
        <h3 class="mb-1">Help</h3>
        <p class="text-secondary mb-0">
            Guides to using @SiteOptions.Value.Name. You see the topics that apply to you — signing in, or
            joining a group, adds more.
        </p>
    </div>

    @if (_sections is null)
    {
        <BenLoaderOverlay Visible="true" Text="Loading help…" />
    }
    else
    {
        @foreach (var section in _sections)
        {
            @* Collapsible per the request: a reader opens the part that concerns them rather
               than scrolling past every other role's documents. The first section starts open
               so the page never looks empty. *@
            <details class="card mb-3 help-section" open="@(section == _sections[0])">
                <summary class="card-header d-flex align-items-center justify-content-between">
                    <span class="fw-semibold">@section.Name</span>
                    <span class="badge bg-secondary">@section.Documents.Count</span>
                </summary>
                <div class="list-group list-group-flush">
                    @foreach (var doc in section.Documents)
                    {
                        <a class="list-group-item list-group-item-action" href="@($"/help/{doc.Slug}")">
                            <div class="fw-semibold">@doc.Title</div>
                            @if (!string.IsNullOrWhiteSpace(doc.Summary))
                            {
                                <div class="small text-secondary">@doc.Summary</div>
                            }
                        </a>
                    }
                </div>
            </details>
        }
    }
</div>

@code {
    private IReadOnlyList<HelpSection>? _sections;

    protected override async Task OnInitializedAsync()
    {
        // Resolving the audience awaits AuthReady, which is only ever signalled from the
        // interactive circuit — awaiting it during the static prerender would hang the response.
        // The loader stays on screen until the interactive render runs a moment later.
        if (!RendererInfo.IsInteractive) return;

        var viewer = await Viewers.ResolveAsync();
        _sections = Content.SectionsFor(viewer);
    }
}
