@page "/admin/investigations"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Website.Library.Shared

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — All Investigations</PageTitle>

<div class="container-fluid px-3">

    <AdminPageHeader Title="All Investigations" Subtitle="Every scheduled investigation across every organization." />

    @* A refused cross-org list used to render as an empty grid — the same untruth that left
       both admin pages blank on the deployment for a day (items 120, 126). *@
    <BenListState TItem="AdminInvestigationSummaryRecord" Result="@_investigations" Loading="@_loading"
                  LoadingText="Loading investigations…"
                  EmptyText="No investigations anywhere yet."
                  OnRetry="@LoadAsync">
        <TelerikGrid Data="@_investigations.Items"
                     TItem="AdminInvestigationSummaryRecord"
                     Sortable="true"
                     FilterMode="@GridFilterMode.FilterRow"
                     Pageable="true"
                     PageSize="25">
            <GridColumns>
                <GridColumn Field="@nameof(AdminInvestigationSummaryRecord.OrganizationName)" Title="Organization" Width="220px" />
                <GridColumn Field="@nameof(AdminInvestigationSummaryRecord.CaseReference)" Title="Case" Width="120px" />
                <GridColumn Field="@nameof(AdminInvestigationSummaryRecord.Title)" Title="Investigation" />
                <GridColumn Field="@nameof(AdminInvestigationSummaryRecord.Status)" Title="Status" Width="130px" />
                <GridColumn Field="@nameof(AdminInvestigationSummaryRecord.ScheduledDateTime)" Title="Scheduled" Width="180px">
                    <Template>
                        @{ var inv = (AdminInvestigationSummaryRecord)context; }
                        @inv.ScheduledDateTime.ToViewerLocalTime(UserState).ToDisplayDateTime()
                    </Template>
                </GridColumn>
                <GridCommandColumn Width="90px">
                    <GridCommandButton OnClick="@((GridCommandEventArgs e) => OpenCase((AdminInvestigationSummaryRecord)e.Items.First()))">
                        Open
                    </GridCommandButton>
                </GridCommandColumn>
            </GridColumns>
        </TelerikGrid>
    </BenListState>
</div>

@code {
    private LoadResult<AdminInvestigationSummaryRecord> _investigations;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating)
            NavManager.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _investigations = await AdminClient.GetAllInvestigationsAsync();
        _loading = false;
        StateHasChanged();
    }

    private void OpenCase(AdminInvestigationSummaryRecord i)
        => NavManager.NavigateTo($"/organizations/{i.OrganizationId}/cases/{i.CaseId}");
}
