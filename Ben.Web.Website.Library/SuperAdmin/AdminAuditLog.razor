@page "/admin/audit-log"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Service.Models.Admin
@using Ben.Data.Common.Enums
@using Ben.Web.Website.Library.Shared

@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Audit Log</PageTitle>

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Audit Log</h3>
        </div>
    </div>

    @* ── Filter bar ─────────────────────────────────────────────────────────── *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-sm-3">
                    <label class="form-label small mb-1">Entity Type</label>
                    <BenSelect Data="@_entityTypeOptions" @bind-Value="@_filterEntityType" DefaultText="All types" Width="100%" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small mb-1">Action</label>
                    <BenSelect Data="@_actionOptions" @bind-Value="@_filterAction" TextField="Label" ValueField="Value" DefaultText="All actions" Width="100%" />
                </div>
                <div class="col-sm-3">
                    <label class="form-label small mb-1">User</label>
                    @* DropDownList rather than ComboBox: the two filters beside it already use this
                       component with the same nullable-value / non-nullable-ValueField shape and
                       bind correctly, whereas the ComboBox equivalent silently dropped the
                       selection and snapped back to its placeholder. *@
                    @* Stays Telerik: this filters a list of every user on the platform, and it is the type-to-filter
                       behaviour that makes that usable. The template ships no searchable-select plugin, and a
                       native <select> has no equivalent — scrolling hundreds of names is not the same control. *@
                    <TelerikDropDownList Data="@_allUsers"
                                         @bind-Value="@_filterUserId"
                                         TextField="@nameof(UserSearchResult.Display)"
                                         ValueField="@nameof(UserSearchResult.Id)"
                                         Filterable="true"
                                         FilterOperator="@StringFilterOperator.Contains"
                                         DefaultText="All users"
                                         Width="100%" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small mb-1">From</label>
                    <TelerikDatePicker Format="@DateTimeViewerExtensions.DatePattern" @bind-Value="@_filterDateFrom" Width="100%" />
                </div>
                <div class="col-sm-2">
                    <label class="form-label small mb-1">To</label>
                    <TelerikDatePicker Format="@DateTimeViewerExtensions.DatePattern" @bind-Value="@_filterDateTo" Width="100%" />
                </div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-12 d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@(!(!_loading))">
                        @(_loading ? "Loading…" : "Search")
                    </button>
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="ClearFilters">
                        Clear
                    </button>
                    <span class="text-secondary small ms-2">
                        Dates are your local calendar days (@UserState.BrowserTimeZone.Id).
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }

    @* ── Grid ─────────────────────────────────────────────────────────────────
       Server-driven via OnRead: the table is far too large to hold client-side, and
       the endpoint already does the filtering/paging. Deliberately NOT Sortable and
       with no FilterRow — both would only have reordered/filtered the 25 rows of the
       current page while appearing to act on the whole log, silently contradicting
       the server filter bar above. Order is fixed newest-first, which is what an
       audit log wants. *@
    <TelerikGrid @ref="@_grid"
                 TItem="AuditLogRecord"
                 OnRead="@OnGridReadAsync"
                 Pageable="true"
                 PageSize="@_pageSize"
                 SelectionMode="@GridSelectionMode.Single"
                 @bind-SelectedItems="@_selectedItems"
                 OnRowClick="@OnRowClick"
                 Height="600px">

        <GridToolBarTemplate>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@ExportToExcel" title="Exports the rows currently on screen"><BenIcon Name="grid" Class="me-1" />
                Excel (page)
            </button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@ExportToCsv" title="Exports the rows currently on screen"><BenIcon Name="file-text" Class="me-1" />
                CSV (page)
            </button>
            <span class="ms-3 text-secondary small">@_totalCount total records</span>
        </GridToolBarTemplate>

        <DetailTemplate>
            @{ var log = (AuditLogRecord)context; }
            <div class="p-3 bg-body-tertiary border rounded ms-3" style="max-width:860px;">
                <div class="row g-2 mb-2">
                    <div class="col-sm-3 text-secondary small">Entity ID</div>
                    <div class="col-sm-9 font-monospace small">@log.EntityId</div>
                    <div class="col-sm-3 text-secondary small">User</div>
                    <div class="col-sm-9 small"><UserNameLink AppUserId="@log.UserId" DisplayName="@log.UserDisplayName" /></div>
                    <div class="col-sm-3 text-secondary small">Source</div>
                    <div class="col-sm-9 small">@log.Source</div>
                    <div class="col-sm-3 text-secondary small">Occurred</div>
                    <div class="col-sm-9 small">@log.OccurredAt.ToDisplayDateTime() UTC</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(log.ChangesJson))
                {
                    <div class="text-secondary small mb-1">Changes</div>
                    <pre class="bg-body border rounded p-2 small" style="max-height:200px; overflow:auto; white-space:pre-wrap; word-break:break-all;">@FormatJson(log.ChangesJson)</pre>
                }
            </div>
        </DetailTemplate>

        <GridColumns>
            <GridColumn Field="@nameof(AuditLogRecord.OccurredAt)" Title="Time" Width="170px">
                <Template>
                    @{ var r = (AuditLogRecord)context; }
                    <span class="small">@r.OccurredAt.ToDisplayDateTime()</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.EntityType)" Title="Entity" Width="180px" />
            <GridColumn Field="@nameof(AuditLogRecord.Action)" Title="Action" Width="90px">
                <Template>
                    @{ var r2 = (AuditLogRecord)context; }
                    <span class="badge @ActionBadge(r2.Action)">@ActionLabel(r2.Action)</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.EntityId)" Title="Entity ID" Width="110px">
                <Template>
                    @{ var r3 = (AuditLogRecord)context; }
                    <span class="font-monospace small text-secondary">@r3.EntityId.ToString()[..8]…</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.UserId)" Title="User" Width="150px">
                <Template>
                    @{ var r4 = (AuditLogRecord)context; }
                    <span class="small"><UserNameLink AppUserId="@r4.UserId" DisplayName="@r4.UserDisplayName" /></span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AuditLogRecord.Source)" Title="Source" Width="100px" />
            <GridColumn Title="" Width="60px" Filterable="false" Sortable="false">
                <Template>
                    @{ var r5 = (AuditLogRecord)context; }
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => OpenMailDialog(r5))" title="Send as message"><BenIcon Name="mail" /></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>

    @* Pagination note for large result sets *@
    @if (_totalCount > _pageSize * 10)
    {
        <div class="text-muted small mt-1">
            Showing page @_currentPage of @((_totalCount + _pageSize - 1) / _pageSize). Use filters to narrow results.
        </div>
    }

</div>

@* ── Mail Dialog ─────────────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_mailDialogVisible" Title="Send Audit Log Record" Size="lg" Static="true">
    <ChildContent>
        @if (_mailTarget is not null)
        {
            <div class="mb-3 p-2 bg-body-tertiary rounded small">
                <strong>@_mailTarget.EntityType</strong> · @ActionLabel(_mailTarget.Action) ·
                @_mailTarget.OccurredAt.ToDisplayDateTime() UTC
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="adminauditlog-recipients-cafc">Recipients</label>
                <div class="d-flex gap-2 mb-2">
                    <input id="adminauditlog-recipients-cafc" type="text" class="form-control" placeholder="Search users…" @bind="@_userSearchQuery" @bind:event="oninput" />
                </div>
                @if (_userSearchResults.Any())
                {
                    <div class="border rounded p-2 mb-2" style="max-height:140px; overflow-y:auto;">
                        @foreach (var u in _userSearchResults)
                        {
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="small">@(u.DisplayName ?? u.Email) <span class="text-secondary">(@u.Email)</span></span>
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => AddRecipient(u))" disabled="@(!(!_selectedRecipients.Any(r => r.Id == u.Id)))"><BenIcon Name="plus" /></button>
                            </div>
                        }
                    </div>
                }
                @if (_selectedRecipients.Any())
                {
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var r in _selectedRecipients)
                        {
                            <span class="badge bg-secondary d-flex align-items-center gap-1">
                                @(r.DisplayName ?? r.Email)
                                <button class="btn-close btn-close-white" style="font-size:0.6rem;"
                                        @onclick="@(() => RemoveRecipient(r))"></button>
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="adminauditlog-subject-b648">Subject</label>
                <input id="adminauditlog-subject-b648" type="text" class="form-control" @bind="@_mailSubject" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold" for="adminauditlog-body-63f4">Body</label>
                <textarea id="adminauditlog-body-63f4" class="form-control" rows="6" @bind="@_mailBody"></textarea>
            </div>

            @if (_mailError is not null)
            {
                <div class="alert alert-danger py-2 small">@_mailError</div>
            }
            @if (_mailSuccess)
            {
                <div class="alert alert-success py-2 small">Message sent successfully.</div>
            }
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-primary" @onclick="SendMessageAsync" disabled="@(!(!_mailSending && _selectedRecipients.Any()))"><BenIcon Name="mail" Class="me-1" />
                @(_mailSending ? "Sending…" : "Send")
            </button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="CloseMailDialog">
                Close
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    // ── Grid state ─────────────────────────────────────────────────────────────

    private TelerikGrid<AuditLogRecord>? _grid;
    private IEnumerable<AuditLogRecord>  _items        = [];
    private IEnumerable<AuditLogRecord>  _selectedItems = [];
    private int     _totalCount  = 0;
    private int     _currentPage = 1;
    private int     _pageSize    = 25;
    private bool    _loading     = false;
    private bool    _initialReadRequested;
    private string? _errorMessage;

    // ── Filter state ───────────────────────────────────────────────────────────

    private string?   _filterEntityType;
    private AuditAction? _filterAction;
    private Guid?     _filterUserId;
    // A calendar day in the viewer's zone (not a UTC instant) — see ToUtcBoundary.
    private DateTime? _filterDateFrom = DateTime.Today.AddDays(-30);
    private DateTime? _filterDateTo;

    /// <summary>All users, fetched once and shared by the User filter and the recipient picker.</summary>
    private List<UserSearchResult> _allUsers = [];

    private IReadOnlyList<string>       _entityTypeOptions = [];
    private static readonly ActionOption[] _actionOptions = [
        new(AuditAction.Create, "Create"),
        new(AuditAction.Update, "Update"),
        new(AuditAction.Delete, "Delete"),
    ];

    // ── Mail dialog state ──────────────────────────────────────────────────────

    private bool            _mailDialogVisible = false;
    private AuditLogRecord? _mailTarget;
    private string          _mailSubject    = "";
    private string          _mailBody       = "";
    private string          _userSearchQuery = "";
    private bool            _mailSending    = false;
    private bool            _mailSuccess    = false;
    private string?         _mailError;

    private IReadOnlyList<UserSearchResult> _userSearchResults   = [];
    private List<UserSearchResult>          _selectedRecipients  = [];

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo("/"); return; }
        // The grid loads itself through OnRead; only the filter-bar sources are fetched here.
        await Task.WhenAll(LoadEntityTypesAsync(), EnsureUsersLoadedAsync());
    }

    /// <summary>
    /// Kicks off the grid's first read. The Telerik grid does not issue its initial OnRead during
    /// static SSR prerender (there is no interactivity yet) and does not re-issue it on hydration,
    /// so without this explicit rebind the grid sat permanently empty while the pager reported
    /// "0 - 0 of 0" — even though the endpoint had rows. Waits for auth first, like every other
    /// deferred fetch in this codebase, so the request goes out with a bearer token attached.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialReadRequested) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) return;

        _initialReadRequested = true;
        _grid?.Rebind();
    }

    private async Task LoadEntityTypesAsync()
    {
        // Options for the type filter. A failed fetch narrows the filter; it does not misreport
        // the log itself, which has its own state.
        _entityTypeOptions = (await AdminClient.GetAuditLogEntityTypesAsync()).Items;
    }

    /// <summary>
    /// Fetches the user list once per page visit and shares it between the User filter and the
    /// send-as-message recipient picker. The picker used to re-fetch the whole table on every
    /// keystroke.
    /// </summary>
    private async Task EnsureUsersLoadedAsync()
    {
        if (_allUsers.Count > 0) return;
        try
        {
            var users = (await AdminClient.GetAllUsersAsync()).Items;
            _allUsers = users
                .Select(u => new UserSearchResult(u.Id, u.Email ?? "", u.DisplayName))
                .OrderBy(u => u.Display)
                .ToList();
        }
        catch { /* non-fatal — filter and picker just stay empty */ }
    }

    // ── Grid data (server-driven) ──────────────────────────────────────────────

    /// <summary>
    /// The grid is bound through OnRead so paging reaches the server. Previously it was bound to
    /// a plain 25-row list with Pageable="true", so Telerik believed that page *was* the entire
    /// result set: the pager rendered "1 of 1" and pages 2+ of the server result were unreachable.
    /// </summary>
    private async Task OnGridReadAsync(GridReadEventArgs args)
    {
        // A read can be raised before the bearer token is attached; without this the request
        // would go out unauthenticated and the grid would render a silently empty page.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive))
        {
            args.Data  = Array.Empty<AuditLogRecord>();
            args.Total = 0;
            return;
        }

        _loading      = true;
        _errorMessage = null;

        try
        {
            var page = args.Request.Page > 0 ? args.Request.Page : 1;
            var size = args.Request.PageSize > 0 ? args.Request.PageSize : _pageSize;

            var result = await AdminClient.GetAuditLogsAsync(
                page:       page,
                pageSize:   size,
                entityType: _filterEntityType,
                action:     _filterAction.HasValue ? (int)_filterAction.Value : null,
                userId:     _filterUserId,
                dateFrom:   ToUtcBoundary(_filterDateFrom, endOfDay: false),
                dateTo:     ToUtcBoundary(_filterDateTo,   endOfDay: true));

            _items       = result?.Items ?? [];
            _totalCount  = result?.TotalCount ?? 0;
            _currentPage = page;

            args.Data  = _items;
            args.Total = _totalCount;
        }
        catch
        {
            _errorMessage = "Failed to load audit log.";
            args.Data  = Array.Empty<AuditLogRecord>();
            args.Total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Converts a date picked in the viewer's calendar into the UTC instant that day starts or
    /// ends at for them. <c>TelerikDatePicker</c> hands back midnight with
    /// <see cref="DateTimeKind.Unspecified"/>, but <c>AuditLog.OccurredAt</c> is stored UTC, so
    /// passing the raw value shifted the whole window by the viewer's offset — and a "To" date
    /// excluded everything that happened during that day.
    /// </summary>
    private DateTime? ToUtcBoundary(DateTime? picked, bool endOfDay)
    {
        if (picked is null) return null;

        var day  = picked.Value.Date;
        var wall = DateTime.SpecifyKind(endOfDay ? day.AddDays(1).AddTicks(-1) : day,
                                        DateTimeKind.Unspecified);

        var tz = UserState.BrowserTimeZone;
        // Spring-forward can make local midnight itself a non-existent instant; step past the gap.
        if (tz.IsInvalidTime(wall)) wall = wall.AddHours(1);

        return TimeZoneInfo.ConvertTimeToUtc(wall, tz);
    }

    /// <summary>
    /// Re-runs the query with the current filter bar. Resets to page 1 through the grid's own
    /// state rather than just calling Rebind(): under OnRead the grid owns the page number, so a
    /// bare Rebind() would re-read whatever page you were on — narrowing a filter while on page 2
    /// could land you past the end of the new result set and show nothing.
    /// </summary>
    private async Task ApplyFiltersAsync()
    {
        if (_grid is null) return;

        var state = _grid.GetState();
        state.Page = 1;
        await _grid.SetStateAsync(state);   // raises OnRead with the new filters at page 1
    }

    private async Task ClearFilters()
    {
        _filterEntityType = null;
        _filterAction     = null;
        _filterUserId     = null;
        _filterDateFrom   = DateTime.Today.AddDays(-30);
        _filterDateTo     = null;
        await ApplyFiltersAsync();
    }

    // ── Row click ──────────────────────────────────────────────────────────────

    private void OnRowClick(GridRowClickEventArgs args)
    {
        // Row expand is handled by the grid's built-in detail template toggle
    }

    // ── Export ─────────────────────────────────────────────────────────────────

    private async Task ExportToExcel() => await _grid!.ExportToExcelAsync();
    private async Task ExportToCsv()   => await _grid!.ExportToCsvAsync();

    // ── Mail dialog ────────────────────────────────────────────────────────────

    private void OpenMailDialog(AuditLogRecord log)
    {
        _mailTarget          = log;
        _mailSubject         = $"Audit: {log.EntityType} {ActionLabel(log.Action)} at {log.OccurredAt:yyyy-MM-dd HH:mm} UTC";
        _mailBody            = BuildDefaultBody(log);
        _userSearchQuery     = "";
        _userSearchResults   = [];
        _selectedRecipients  = [];
        _mailError           = null;
        _mailSuccess         = false;
        _mailDialogVisible   = true;
    }

    private void CloseMailDialog()
    {
        _mailDialogVisible = false;
        _mailTarget        = null;
    }

    private async Task SearchUsersAsync()
    {
        if (string.IsNullOrWhiteSpace(_userSearchQuery)) { _userSearchResults = []; return; }

        // Filters the cached list — this used to re-fetch the entire user table on every keystroke.
        await EnsureUsersLoadedAsync();
        var q = _userSearchQuery.Trim();
        _userSearchResults = _allUsers
            .Where(u => u.Display.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(10)
            .ToList();
    }

    private void AddRecipient(UserSearchResult user)
    {
        if (!_selectedRecipients.Any(r => r.Id == user.Id))
            _selectedRecipients.Add(user);
    }

    private void RemoveRecipient(UserSearchResult user)
        => _selectedRecipients.RemoveAll(r => r.Id == user.Id);

    private async Task SendMessageAsync()
    {
        if (_mailTarget is null || !_selectedRecipients.Any()) return;

        _mailError   = null;
        _mailSuccess = false;
        _mailSending = true;

        var ok = await AdminClient.SendAuditLogMessageAsync(new SendAuditLogMessageRequest(
            AuditLogId:       _mailTarget.Id,
            RecipientUserIds: _selectedRecipients.Select(r => r.Id).ToList(),
            Subject:          _mailSubject,
            Body:             _mailBody));

        _mailSending = false;

        if (ok) _mailSuccess = true;
        else    _mailError   = "Failed to send message. Please try again.";
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static string ActionLabel(AuditAction action) => action switch
    {
        AuditAction.Create => "Create",
        AuditAction.Update => "Update",
        AuditAction.Delete => "Delete",
        _                  => action.ToString()
    };

    private static string ActionBadge(AuditAction action) => action switch
    {
        AuditAction.Create => "bg-success",
        AuditAction.Update => "bg-warning text-dark",
        AuditAction.Delete => "bg-danger",
        _                  => "bg-secondary"
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string BuildDefaultBody(AuditLogRecord log)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Audit Log Entry");
        sb.AppendLine($"───────────────");
        sb.AppendLine($"Action:      {ActionLabel(log.Action)}");
        sb.AppendLine($"Entity Type: {log.EntityType}");
        sb.AppendLine($"Entity ID:   {log.EntityId}");
        sb.AppendLine($"User ID:     {log.UserId}");
        sb.AppendLine($"Source:      {log.Source}");
        sb.AppendLine($"Occurred:    {log.OccurredAt:yyyy-MM-dd HH:mm:ss} UTC");
        if (!string.IsNullOrWhiteSpace(log.ChangesJson))
        {
            sb.AppendLine();
            sb.AppendLine("Changes:");
            sb.AppendLine(FormatJson(log.ChangesJson));
        }
        return sb.ToString();
    }

    // ── Inner types ────────────────────────────────────────────────────────────

    private sealed record ActionOption(AuditAction Value, string Label);

    private sealed record UserSearchResult(Guid Id, string Email, string? DisplayName)
    {
        /// <summary>Label used by both the User filter combobox and the recipient picker.</summary>
        public string Display => string.IsNullOrWhiteSpace(DisplayName)
            ? Email
            : $"{DisplayName} ({Email})";
    }
}
