@page "/admin/mail"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Outgoing Mail</PageTitle>

@* This page exists because a sign-up produced no email and there was no way to find out why: the
   sender swallowed its own failure and the only record of it was below the log's storage
   threshold. Everything here runs INSIDE the application on purpose — the SMTP password arrives as
   an environment variable on the API's app pool, and the server's own firewall decides whether it
   can reach port 465, so a probe from anywhere else proves the mail host is up and nothing about
   whether this machine can send through it. *@

<div class="container-fluid px-3">

    <div class="row mb-3">
        <div class="col">
            <h3 class="mb-0">Outgoing Mail</h3>
            <p class="text-secondary small mb-0">
                Whether this machine can actually send. Run it on the server you care about —
                the answer is different on each one.
            </p>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_loading)
    {
        <p class="text-secondary">Loading mail settings…</p>
    }
    else if (_settings is null)
    {
        <div class="alert alert-warning" role="alert" data-testid="mail-settings-missing">
            Could not read the mail settings from the API. That is itself a finding — this page is
            SuperAdmin-only, so a refusal here means the request never arrived as you.
        </div>
    }
    else
    {
        @if (!_settings.IsConfigured)
        {
            <div class="alert alert-danger" data-testid="mail-not-configured">
                <strong>Mail is switched off on this machine.</strong>
                No SMTP host is set, so nothing is attempted at all — every confirmation,
                invitation and reset is going nowhere silently. On a deployed site that means people
                can sign up and never be able to finish.
            </div>
        }
        else if (!_settings.HasPassword)
        {
            @* The likeliest real fault, and the one that looks like nothing is wrong. *@
            <div class="alert alert-danger" data-testid="mail-no-password">
                <strong>A host is set but no password is present.</strong>
                Every visible setting can be correct and sending will still fail. The value comes
                from the <code>Smtp__Password</code> environment variable on the API's
                <em>application pool</em> — not from a file, and not from your shell — so it can be
                missing here while looking fine everywhere else.
            </div>
        }

        <div class="card mb-3">
            <div class="card-header fw-semibold">What this machine will send with</div>
            <div class="card-body">
                <dl class="row mb-0" data-testid="mail-settings">
                    <dt class="col-sm-3">Host</dt>
                    <dd class="col-sm-9">@(_settings.Host ?? "(none)")</dd>

                    <dt class="col-sm-3">Port</dt>
                    <dd class="col-sm-9">@_settings.Port</dd>

                    <dt class="col-sm-3">Security</dt>
                    <dd class="col-sm-9">@_settings.Security</dd>

                    <dt class="col-sm-3">User</dt>
                    <dd class="col-sm-9">@(_settings.User ?? "(none)")</dd>

                    <dt class="col-sm-3">From</dt>
                    <dd class="col-sm-9">@(_settings.FromAddress ?? "(none)")</dd>

                    <dt class="col-sm-3">Password</dt>
                    <dd class="col-sm-9">
                        @* Presence only. A diagnostic that prints a secret is one nobody can
                           safely run in front of another person. *@
                        @if (_settings.HasPassword)
                        {
                            <span class="text-success">present</span>
                            <span class="text-secondary small ms-1">(value never shown)</span>
                        }
                        else
                        {
                            <span class="text-danger">missing</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Send a test message</div>
            <div class="card-body">
                <p class="text-secondary small">
                    A real send, not a connection check — the failures that matter happen after the
                    socket opens: authentication rejected, sender not permitted, relay denied. None
                    of those appear until a message is actually offered.
                </p>

                <div class="row g-2 align-items-end">
                    <div class="col-sm-6">
                        <label class="form-label" for="mail-test-to">Send to</label>
                        <input id="mail-test-to" type="email" class="form-control"
                               data-testid="mail-test-to"
                               @bind="@_to" @bind:event="oninput"
                               placeholder="you@example.com" />
                    </div>
                    <div class="col-sm-auto">
                        <button class="btn btn-primary text-nowrap" data-testid="mail-test-send"
                                disabled="@(_sending || string.IsNullOrWhiteSpace(_to))"
                                @onclick="SendAsync">
                            @(_sending ? "Sending…" : "Send test")
                        </button>
                    </div>
                </div>

                @if (_test is not null)
                {
                    <div class="alert @(_test.Sent ? "alert-success" : "alert-danger") mt-3"
                         role="alert" data-testid="mail-test-result">
                        <div>@_test.Message</div>
                        @if (!string.IsNullOrWhiteSpace(_test.ServerSaid))
                        {
                            @* Verbatim, deliberately: "535 authentication failed" and "connection
                               timed out" need completely different fixes. *@
                            <div class="mt-2">
                                <div class="small fw-semibold">The server said:</div>
                                <pre class="small mb-0 mt-1" style="white-space:pre-wrap;"
                                     data-testid="mail-test-server-said">@_test.ServerSaid</pre>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── The outbox (item 239; wired 2026-09-17) ─────────────────────────────
       The controller's own note says this "would have answered the 2026-08-31 question — I signed
       up and got nothing — in five seconds instead of not at all". It still answered it in zero,
       because the three routes behind it had no caller anywhere.

       No bodies. A body carries somebody's name, what they booked and, for a hosted event, a
       working door code — so the list says whether the words are still held, which is the only
       thing about a body anybody here needs to know. *@
    <div class="row mt-4">
        <div class="col">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <span class="fw-semibold">Recent letters</span>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Which letters to show">
                            @foreach (var (value, label) in OutboxFilters)
                            {
                                <button type="button"
                                        class="btn @(_outboxState == value ? "btn-primary" : "btn-outline-primary")"
                                        disabled="@_outboxBusy"
                                        @onclick="@(() => SwitchOutboxAsync(value))">
                                    @label
                                </button>
                            }
                        </div>
                        @if (_failedCount > 0)
                        {
                            @* The button somebody presses after fixing the relay. *@
                            <button type="button" class="btn btn-sm btn-warning"
                                    id="outbox-retry-all" disabled="@_outboxBusy"
                                    @onclick="RetryAllAsync">
                                Put @_failedCount given-up
                                @(_failedCount == 1 ? "letter" : "letters") back in the queue
                            </button>
                        }
                    </div>
                </div>

                <div class="card-body">
                    @if (_outboxMessage is not null)
                    {
                        <div class="alert alert-info py-2" data-testid="outbox-message">@_outboxMessage</div>
                    }
                    @if (_outboxError is not null)
                    {
                        <div class="alert alert-danger py-2" data-testid="outbox-error">@_outboxError</div>
                    }

                    @if (_outboxResult.Failed)
                    {
                        <BenListState TItem="OutboxLetterItem" Result="@_outboxResult"
                                      OnRetry="@(() => LoadOutboxAsync())" />
                    }
                    else if (_outbox.Count == 0)
                    {
                        <p class="text-secondary mb-0" data-testid="outbox-empty">
                            @(_outboxState == "failed"
                                ? "Nothing has been given up on."
                                : "No letters recorded.")
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" data-testid="outbox-table">
                                <thead>
                                    <tr>
                                        <th scope="col">To</th>
                                        <th scope="col">Subject</th>
                                        <th scope="col">Kind</th>
                                        <th scope="col">Written</th>
                                        <th scope="col">State</th>
                                        <th scope="col"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var letter in _outbox)
                                    {
                                        <tr>
                                            <td class="text-break">@letter.To</td>
                                            <td class="text-break">
                                                @letter.Subject
                                                @if (letter.AttachmentCount > 0)
                                                {
                                                    <span class="text-secondary small">
                                                        · @letter.AttachmentCount attachment@(letter.AttachmentCount == 1 ? "" : "s")
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-secondary small">@letter.Kind</td>
                                            <td class="text-secondary small">
                                                @letter.CreatedUtc.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                            </td>
                                            <td>
                                                @if (letter.AcceptedBySmtpUtc is { } accepted)
                                                {
                                                    @* Taken by the mail server, which is NOT the
                                                       same as received — bounce reports are not
                                                       collected, so the word matters. *@
                                                    <span class="badge text-bg-success">Accepted</span>
                                                    <div class="text-secondary small">
                                                        @accepted.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                                    </div>
                                                }
                                                else if (letter.FailedUtc is not null)
                                                {
                                                    <span class="badge text-bg-danger">Given up</span>
                                                    @if (!string.IsNullOrWhiteSpace(letter.LastError))
                                                    {
                                                        <div class="text-secondary small text-break">@letter.LastError</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-secondary">Waiting</span>
                                                    <div class="text-secondary small">
                                                        attempt @letter.Attempts · next
                                                        @letter.NextAttemptUtc.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (letter.FailedUtc is not null && letter.HasBody)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                                            disabled="@_outboxBusy"
                                                            data-testid="outbox-retry"
                                                            @onclick="@(() => RetryOneAsync(letter))">
                                                        Send again
                                                    </button>
                                                }
                                                else if (letter.BodyScrubbedUtc is not null)
                                                {
                                                    @* The trade the scrub makes, said rather than
                                                       offered and then refused. *@
                                                    <span class="text-secondary small">Words cleared</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private MailSettingsRecord?   _settings;
    private MailTestResultRecord? _test;
    private string  _to      = "";
    private bool    _loading = true;
    private bool    _sending;
    private string? _error;

    // ── The outbox (item 239; wired 2026-09-17) ──────────────────────────────

    private static readonly (string? Value, string Label)[] OutboxFilters =
    [
        ("failed",   "Given up"),
        ("waiting",  "Waiting"),
        ("accepted", "Accepted"),
        (null,       "Everything"),
    ];

    private readonly List<OutboxLetterItem> _outbox = [];
    private LoadResult<OutboxLetterItem> _outboxResult;

    /// <summary>
    /// Opens on the given-up pile.
    /// </summary>
    /// <remarks>
    /// That is the pile somebody came to this page about. "Accepted" is the reassuring list and
    /// nobody opens a diagnostics screen for reassurance.
    /// </remarks>
    private string? _outboxState = "failed";

    private bool _outboxBusy;
    private string? _outboxError;
    private string? _outboxMessage;

    /// <summary>How many given-up letters could be requeued, for the bulk button's label.</summary>
    private int _failedCount;

    private async Task SwitchOutboxAsync(string? state)
    {
        if (_outboxState == state) return;
        _outboxState = state;
        await LoadOutboxAsync();
    }

    private async Task LoadOutboxAsync()
    {
        _outboxBusy = true;
        _outboxError = null;
        try
        {
            _outboxResult = await AdminClient.GetOutboxAsync(_outboxState);
            _outbox.Clear();
            _outbox.AddRange(_outboxResult.Items);

            // Counted from the failed pile specifically, so the bulk button's number is the
            // number it will actually requeue — scrubbed rows are skipped by the server and are
            // not offered here either.
            _failedCount = _outboxState == "failed"
                ? _outbox.Count(l => l.FailedUtc is not null && l.HasBody)
                : (await AdminClient.GetOutboxAsync("failed")).Items.Count(l => l.HasBody);
        }
        catch (Exception ex)
        {
            _outboxError = $"The outbox could not be read: {ex.Message}";
        }
        finally { _outboxBusy = false; }
    }

    private async Task RetryOneAsync(OutboxLetterItem letter)
    {
        _outboxBusy = true;
        _outboxError = null;
        _outboxMessage = null;
        try
        {
            var (result, error) = await AdminClient.RetryOutboxLetterAsync(letter.Id);

            // The server refuses a scrubbed or already-accepted letter in words, and those words
            // are the whole value of the refusal — "sending it again would send a duplicate" is
            // not something a page should paraphrase.
            if (result is null) { _outboxError = error ?? "That letter could not be requeued."; return; }

            _outboxMessage = result.Message;
        }
        finally
        {
            _outboxBusy = false;
            await LoadOutboxAsync();
        }
    }

    private async Task RetryAllAsync()
    {
        _outboxBusy = true;
        _outboxError = null;
        _outboxMessage = null;
        try
        {
            var (result, error) = await AdminClient.RetryFailedOutboxAsync();
            if (result is null) { _outboxError = error ?? "Nothing could be requeued."; return; }

            _outboxMessage = result.Message;
        }
        finally
        {
            _outboxBusy = false;
            await LoadOutboxAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Auth is not ready during prerender; checking IsSuperAdmin before it is, is the race this
        // app has been caught by repeatedly.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo(Ben.Web.Website.Library.Kit.SignInLink.ForRefusal(NavManager, UserState)); return; }

        await LoadAsync();
        await LoadOutboxAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            _settings = await AdminClient.GetMailSettingsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not read the mail settings: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SendAsync()
    {
        _sending = true;
        _test    = null;
        _error   = null;
        try
        {
            _test = await AdminClient.SendTestEmailAsync(_to.Trim());

            // A refusal the UI discards is worse than no rule at all — say so rather than
            // re-rendering an unchanged page and letting it read as success.
            if (_test is null)
                _error = "The API did not answer the test send. Nothing can be concluded from that "
                       + "except that the request itself failed.";
        }
        catch (Exception ex)
        {
            _error = $"The test send could not be attempted: {ex.Message}";
        }
        finally
        {
            _sending = false;
        }
    }
}
