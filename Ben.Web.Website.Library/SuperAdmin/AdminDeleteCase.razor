@page "/admin/delete-case"
@page "/admin/delete-case/{CaseId:guid}"
@namespace Ben.Web.Website.Library.SuperAdmin

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Admin
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Kit

@*
    Deleting a case — the verb that did not exist until item 183.

    Its own page, like the group and person deletes, so nobody arrives here by clicking a row.
    The all-cases grid links in with the case already chosen, which keeps a deliberate trip from
    being a tedious one.

    The preview is the screen. Destroyed and kept-but-unlinked are two blocks because they are two
    different things happening: a case's timeline dies with it, a person's field session does not.
*@

<PageTitle>SuperAdmin — Delete a case</PageTitle>

<div class="container-fluid px-3 py-4" style="max-width:900px; margin:auto;">

    <h3 class="mb-1">Delete a case</h3>
    <p class="text-secondary small">
        Destroys the case and everything that exists only because of it.
        <strong>This cannot be undone.</strong>
    </p>

    <div class="alert alert-info py-2 small">
        <strong>Groups cannot do this.</strong> A case is a record of real work, usually for a
        paying client, so a group closes a case rather than deleting it. This page is for the
        mistakes closing cannot cover — a duplicate, a test row, a case opened against the wrong
        group.
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger">@_loadError</div>
    }

    <div class="card mb-3"><div class="card-body">
        <label class="form-label" for="case-picker">Case</label>
        <select id="case-picker" class="form-select" @bind="_selectedId" @bind:after="LoadPreviewAsync">
            <option value="@Guid.Empty">— choose a case —</option>
            @foreach (var c in _cases)
            {
                <option value="@c.Id">@Label(c)</option>
            }
        </select>
    </div></div>

    @if (_busy)
    {
        <BenLoaderOverlay Visible="true" Text="Working…" />
    }

    @if (_preview is not null)
    {
        <div class="card border-danger mb-3" data-testid="case-purge-preview">
            <div class="card-header bg-danger text-white">
                Deleting @_preview.CaseReference “@_preview.Title” would destroy
            </div>
            <div class="card-body">
                <p class="text-secondary small">
                    @_preview.OrganizationName · @_preview.Status
                    @if (_preview.IsPublic) { <span class="badge bg-info text-dark ms-1">Public</span> }
                </p>

                <div class="row g-2">
                    @foreach (var line in Destroyed(_preview))
                    {
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2 text-center">
                                <div class="fs-4 fw-semibold">@line.Count.ToString("N0")</div>
                                <div class="text-secondary small">@line.Label</div>
                            </div>
                        </div>
                    }
                </div>

                @if (KeptTotal(_preview) > 0)
                {
                    <h6 class="mt-4 mb-2">and keep, with the case reference removed</h6>
                    <div class="row g-2">
                        @foreach (var line in Kept(_preview))
                        {
                            <div class="col-6 col-md-3">
                                <div class="border rounded p-2 text-center">
                                    <div class="fs-4 fw-semibold">@line.Count.ToString("N0")</div>
                                    <div class="text-secondary small">@line.Label</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* ── what survives, said before the button ────────────────────
                   A field session is somebody's own recording that happens to be attached to one
                   of this case's investigations. It goes back to them, whole. *@
                @if (_preview.FieldSessionsDetached > 0)
                {
                    <div class="alert alert-success py-2 small mt-3" data-testid="sessions-detached">
                        <strong>@Plural(_preview.FieldSessionsDetached, "field session") will survive.</strong>
                        A recording belongs to the person who made it, so each one goes back to
                        them as a personal session — its files, its readings and its share links
                        untouched.
                    </div>
                }

                @if (_preview.ClientName is not null)
                {
                    <div class="alert alert-warning py-2 small mt-2 mb-0" data-testid="has-client">
                        <strong>This case has a client: @_preview.ClientName.</strong>
                        Deleting it removes their record of work they asked for, and any access
                        they were given. Their original request is kept.
                    </div>
                }

                @if (_preview.IsPublic)
                {
                    <div class="alert alert-warning py-2 small mt-2 mb-0" data-testid="is-public">
                        <strong>This case is public.</strong> Its public page and any link anyone
                        has to it will stop working.
                    </div>
                }

                <hr />

                <label class="form-label" for="confirm-title">
                    Type <strong>@_preview.Title</strong> to confirm
                </label>
                <input id="confirm-title" class="form-control" style="max-width:420px;"
                       @bind="_confirmTitle" @bind:event="oninput"
                       placeholder="@_preview.Title" />

                <div class="mt-3">
                    @* Dead until the title matches exactly. A dialog somebody can click through
                       out of habit is not a confirmation. *@
                    <button type="button" class="btn btn-danger" id="confirm-delete-case"
                            disabled="@(_busy || !TitleMatches)" @onclick="PurgeAsync">
                        <BenIcon Name="trash-2" Class="me-1" />Delete this case permanently
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-2" @onclick="Clear">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_result is not null)
    {
        <div class="alert alert-success" data-testid="case-purge-result">
            <strong>@_result.CaseReference “@_result.Title” is gone.</strong>
            Destroyed @_result.TimelineEntries timeline entr@(_result.TimelineEntries == 1 ? "y" : "ies"),
            @_result.Files file(s) and @_result.Investigations investigation(s).
            @if (_result.FieldSessionsDetached > 0)
            {
                <text>@_result.FieldSessionsDetached field session(s) went back to the people who recorded them.</text>
            }
        </div>
    }

    @if (_error is not null)
    {
        @* The server's own sentence. A mistyped title and a database refusal are different
           problems; "something went wrong" would leave a SuperAdmin with nowhere to go. *@
        <div class="alert alert-danger" data-testid="case-purge-error">@_error</div>
    }
</div>

@code {
    /// <summary>Preselected when the all-cases grid links in, so the trip here is one click.</summary>
    [Parameter] public Guid? CaseId { get; set; }

    private List<AdminCaseSummaryRecord> _cases = [];
    private Guid _selectedId = Guid.Empty;
    private CasePurgePreview? _preview;
    private CasePurgeResult? _result;
    private string _confirmTitle = "";
    private bool _busy;
    private string? _error;
    private string? _loadError;

    private bool TitleMatches =>
        _preview is not null
        && string.Equals(_confirmTitle.Trim(), _preview.Title, StringComparison.Ordinal);

    private static string Label(AdminCaseSummaryRecord c)
        => $"{c.CaseReference} — {c.Title} ({c.OrganizationName})";

    private static string Plural(int n, string word) => n == 1 ? $"1 {word}" : $"{n} {word}s";

    private static IEnumerable<(string Label, int Count)> Destroyed(CasePurgePreview p) =>
    [
        ("timeline entries", p.TimelineEntries),
        ("files", p.Files),
        ("notes", p.Notes),
        ("messages", p.Messages),
        ("research entries", p.ResearchEntries),
        ("reports", p.Reports),
        ("investigations", p.Investigations),
        ("contacts", p.Contacts),
        ("votes", p.Votes),
        ("transfer records", p.TransferLogs),
        ("client access rows", p.ClientAccessRows),
        ("stored files", p.StoredFiles),
    ];

    private static IEnumerable<(string Label, int Count)> Kept(CasePurgePreview p) =>
    [
        ("field sessions", p.FieldSessionsDetached),
        ("feed posts", p.FeedPostsUnlinked),
        ("calendar events", p.CalendarEventsUnlinked),
        ("video projects", p.VideoProjectsUnlinked),
        ("evidence votes", p.EvidenceVotesUnlinked),
        ("public pages", p.PublicPagesUnlinked),
    ];

    private static int KeptTotal(CasePurgePreview p) => Kept(p).Sum(l => l.Count);

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating)
            NavManager.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        var cases = await AdminClient.GetAllCasesAsync();
        _cases = [.. cases.Items.OrderBy(c => c.OrganizationName).ThenByDescending(c => c.DateCaseOpened)];
        // A refused list must say so rather than render as "no cases" — item 141's rule, and the
        // one screen where an empty picker would look like there is nothing to delete.
        _loadError = cases.Failed ? "Couldn't load the list of cases." : null;

        if (CaseId is { } preselected && preselected != Guid.Empty)
        {
            _selectedId = preselected;
            await LoadPreviewAsync();
        }

        StateHasChanged();
    }

    private async Task LoadPreviewAsync()
    {
        _preview = null; _result = null; _error = null; _confirmTitle = "";
        if (_selectedId == Guid.Empty) { StateHasChanged(); return; }

        _busy = true; StateHasChanged();
        _preview = await AdminClient.GetCasePurgePreviewAsync(_selectedId);
        _busy = false;
        if (_preview is null) _error = "That case could not be read.";
        StateHasChanged();
    }

    private async Task PurgeAsync()
    {
        if (_preview is null) return;
        _busy = true; _error = null; StateHasChanged();

        var (result, error) = await AdminClient.PurgeCaseAsync(_preview.CaseId, _confirmTitle.Trim());

        _busy = false;
        if (result is null)
        {
            _error = error ?? "The case was not deleted.";
            StateHasChanged();
            return;
        }

        _result   = result;
        _preview  = null;
        _cases    = [.. _cases.Where(c => c.Id != result.CaseId)];
        _selectedId = Guid.Empty;
        _confirmTitle = "";
        StateHasChanged();
    }

    private void Clear()
    {
        _preview = null; _confirmTitle = ""; _selectedId = Guid.Empty; _error = null;
    }
}
