@page "/admin/equipment-taxonomy"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>SuperAdmin — Equipment Taxonomy</PageTitle>

<div class="container-fluid px-3">
    <div class="row mb-3 align-items-center">
        <div class="col"><h3 class="mb-0">Equipment Taxonomy</h3></div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <p class="text-secondary small">
        Categories are the fixed vocabulary. Makes and models accumulate from what members add —
        they stay out of the public catalog until approved here, though whoever proposed one can
        keep using it in the meantime.
    </p>

    <BenTabs @bind-ActiveId="@_activeTab">
        <BenTab Title="Makes" Id="brands">
            @if (_taxonomyResult.Failed)
            {
                @* One result covers all three lists: they load together, and a taxonomy that
                   failed to load must not read as a taxonomy nobody has filled in. *@
                <BenListState TItem="EquipmentBrandRecord" Result="@_taxonomyResult" OnRetry="@LoadAsync" />
            }
            else if (_loading)
            {
                <BenLoaderOverlay Visible="true" Text="Loading…" />
            }
            else
            {
                <TelerikGrid Data="@_brands" TItem="EquipmentBrandRecord" Sortable="true" Pageable="true" PageSize="20">
                    <GridColumns>
                        <GridColumn Field="@nameof(EquipmentBrandRecord.Name)" Title="Make" />
                        <GridColumn Title="Status" Width="130px">
                            <Template>
                                @{ var row = (EquipmentBrandRecord)context; }
                                @if (row.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(EquipmentBrandRecord.DateCreated)" Title="Added" Width="160px" DisplayFormat="@DateTimeViewerExtensions.GridDateFormat" />
                        <GridColumn Title="" Width="200px">
                            <Template>
                                @{ var row = (EquipmentBrandRecord)context; }
                                <div class="d-flex gap-1">
                                    @if (!row.IsApproved)
                                    {
                                        <BenGridAction Icon="check" Label="Approve" Tone="GridActionTone.Success" OnClick="@(() => ApproveBrandAsync(row.Id))" Disabled="@_busy" />
                                    }
                                    @* Ben's question was "what happens when I try to change
                                       Samsung to Sansung?" The server could rename and merge from
                                       the day that was asked, and no button ever called either —
                                       so a typo was permanently unfixable, because delete is
                                       refused while anything references the row (2026-09-17). *@
                                    <BenGridAction Icon="edit-2" Label="Rename" OnClick="@(() => OpenRenameBrand(row))" Disabled="@_busy" />
                                    <BenGridAction Icon="x" Label="Reject" Tone="GridActionTone.Danger" OnClick="@(() => RejectBrandAsync(row.Id))" Disabled="@_busy" />
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </BenTab>

        <BenTab Title="Models" Id="models">
            @if (_loading)
            {
                <BenLoaderOverlay Visible="true" Text="Loading…" />
            }
            else
            {
                <TelerikGrid Data="@_models" TItem="EquipmentModelRecord" Sortable="true" Pageable="true" PageSize="20">
                    <GridColumns>
                        <GridColumn Field="@nameof(EquipmentModelRecord.BrandName)" Title="Make" Width="180px" />
                        <GridColumn Field="@nameof(EquipmentModelRecord.Name)" Title="Model" />
                        <GridColumn Field="@nameof(EquipmentModelRecord.CategoryName)" Title="Category" Width="180px" />
                        <GridColumn Title="Status" Width="130px">
                            <Template>
                                @{ var row = (EquipmentModelRecord)context; }
                                @if (row.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Title="" Width="200px">
                            <Template>
                                @{ var row = (EquipmentModelRecord)context; }
                                <div class="d-flex gap-1">
                                    @if (!row.IsApproved)
                                    {
                                        <BenGridAction Icon="check" Label="Approve" Tone="GridActionTone.Success" OnClick="@(() => ApproveModelAsync(row.Id))" Disabled="@_busy" />
                                    }
                                    <BenGridAction Icon="edit-2" Label="Rename" OnClick="@(() => OpenRenameModel(row))" Disabled="@_busy" />
                                    <BenGridAction Icon="x" Label="Reject" Tone="GridActionTone.Danger" OnClick="@(() => RejectModelAsync(row.Id))" Disabled="@_busy" />
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </BenTab>

        <BenTab Title="Categories" Id="categories">
            @if (_loading)
            {
                <BenLoaderOverlay Visible="true" Text="Loading…" />
            }
            else
            {
                <div class="mb-2">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenCreateCategory"><BenIcon Name="plus" Class="me-1" />New category</button>
                </div>
                <TelerikGrid Data="@_categories" TItem="EquipmentCategoryRecord" Sortable="true" Pageable="true" PageSize="20">
                    <GridColumns>
                        <GridColumn Field="@nameof(EquipmentCategoryRecord.Name)" Title="Name" />
                        <GridColumn Field="@nameof(EquipmentCategoryRecord.Description)" Title="Description" />
                        <GridColumn Field="@nameof(EquipmentCategoryRecord.SortOrder)" Title="Order" Width="90px" />
                        <GridColumn Title="Active" Width="90px">
                            <Template>
                                @{ var row = (EquipmentCategoryRecord)context; }
                                @(row.IsActive ? "Yes" : "No")
                            </Template>
                        </GridColumn>
                        <GridColumn Title="" Width="160px">
                            <Template>
                                @{ var row = (EquipmentCategoryRecord)context; }
                                <div class="d-flex gap-1">
                                    <BenGridAction Icon="edit-2" Label="Edit" OnClick="@(() => OpenEditCategory(row))" Disabled="@_busy" />
                                    <BenGridAction Icon="trash-2" Label="Delete" Tone="GridActionTone.Danger" OnClick="@(() => DeleteCategoryAsync(row.Id))" Disabled="@_busy" />
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </BenTab>
    </BenTabs>
</div>

<BenModal @bind-Visible="@_categoryEditorVisible" Title="@(_editingCategory is null ? "New category" : "Edit category")">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="adminequipmenttaxonomy-name-03f7">Name</label>
            <input id="adminequipmenttaxonomy-name-03f7" class="form-control" maxlength="100" value="@_catName"
                   @oninput="@(e => _catName = e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="adminequipmenttaxonomy-description-668a">Description</label>
            <input id="adminequipmenttaxonomy-description-668a" class="form-control" maxlength="500" value="@_catDescription"
                   @oninput="@(e => _catDescription = e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label class="form-label fw-semibold" for="adminequipmenttaxonomy-icon-class-a1c4">Icon class</label>
                <input id="adminequipmenttaxonomy-icon-class-a1c4" class="form-control" maxlength="100" value="@_catIconClass"
                       @oninput="@(e => _catIconClass = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <div class="col-3 mb-3">
                <label class="form-label fw-semibold" for="adminequipmenttaxonomy-order-a78d">Order</label>
                <input id="adminequipmenttaxonomy-order-a78d" type="number" class="form-control" min="0" max="100" step="1" @bind="@_catSortOrder" @bind:event="oninput" />
            </div>
            <div class="col-3 mb-3 d-flex align-items-end">
                <label class="d-flex align-items-center gap-2 mb-2">
                    <input type="checkbox" class="form-check-input mt-0" checked="@_catIsActive"
                           @onchange="@(e => _catIsActive = (bool)(e.Value ?? false))" />
                    Active
                </label>
            </div>
        </div>

        @* In-content footer rather than WindowActions — see MyEquipmentItemEditor for why. *@
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-secondary" @onclick="@(() => _categoryEditorVisible = false)" disabled="@(!(!_busy))">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveCategoryAsync" disabled="@(!(!_busy && !string.IsNullOrWhiteSpace(_catName)))">Save</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Rename, and the merge a taken name would take (2026-09-17 audit) ──────
   One dialog for both brands and models: the two answer the same 409 with the same
   TaxonomyMergeOffer, and a second copy of this wording would be a second copy of the only
   warning anybody gets before two rows become one. *@
<BenModal @bind-Visible="@_renameVisible" Title="@($"Rename {_renameKindLabel}")">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="equipment-rename-name">New name</label>
            <input id="equipment-rename-name" class="form-control" maxlength="100" value="@_renameName"
                   @oninput="@(e => { _renameName = e.Value?.ToString() ?? string.Empty; _renameOffer = null; })" />
            <div class="form-text">
                The address for this @_renameKindLabel follows the corrected name.
            </div>
        </div>

        @if (_renameError is not null)
        {
            <div class="alert alert-danger" data-testid="equipment-rename-error">@_renameError</div>
        }

        @if (_renameOffer is { } offer)
        {
            <div class="alert alert-warning" data-testid="equipment-merge-offer">
                <div class="mb-2">@offer.Message</div>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="btn btn-warning btn-sm" disabled="@_busy"
                            data-testid="equipment-merge-accept"
                            @onclick="AcceptEquipmentMergeAsync">
                        @(_busy ? "Merging…" : $"Merge into \"{offer.TargetName}\"")
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_busy"
                            @onclick="@(() => _renameOffer = null)">
                        Keep both — I'll pick another name
                    </button>
                </div>
            </div>
        }

        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-secondary" @onclick="CloseRename" disabled="@_busy">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveRenameAsync"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_renameName))">Save</button>
        </div>
    </ChildContent>
</BenModal>

@code {
    private List<EquipmentBrandRecord> _brands = [];
    private List<EquipmentModelRecord> _models = [];
    private List<EquipmentCategoryRecord> _categories = [];

    private string _activeTab = "brands";
    private bool _loading = true;
    private LoadResult<EquipmentBrandRecord> _taxonomyResult;
    private bool _busy;
    private string? _error;

    // ── Renaming a brand or a model (2026-09-17 audit) ───────────────────────
    //
    // Four server routes existed with no caller: rename and merge, for brands and for models. So
    // a make or model name typed wrong stayed wrong — delete is refused while anything references
    // the row, and nothing could rename. One dialog serves both because both answer a taken name
    // with the same TaxonomyMergeOffer.

    private bool _renameVisible;
    private bool _renameIsBrand;
    private Guid _renameId;
    private string _renameName = string.Empty;
    private string? _renameError;
    private TaxonomyMergeOffer? _renameOffer;

    private string _renameKindLabel => _renameIsBrand ? "brand" : "model";

    private void OpenRenameBrand(EquipmentBrandRecord row)
    {
        _renameIsBrand = true;
        _renameId = row.Id;
        _renameName = row.Name;
        _renameError = null;
        _renameOffer = null;
        _renameVisible = true;
    }

    private void OpenRenameModel(EquipmentModelRecord row)
    {
        _renameIsBrand = false;
        _renameId = row.Id;
        _renameName = row.Name;
        _renameError = null;
        _renameOffer = null;
        _renameVisible = true;
    }

    private void CloseRename()
    {
        _renameVisible = false;
        // Cleared with the dialog, or the next row opens carrying the last one's offer.
        _renameOffer = null;
        _renameError = null;
    }

    private async Task SaveRenameAsync()
    {
        if (string.IsNullOrWhiteSpace(_renameName)) return;

        _busy = true;
        _renameError = null;
        _renameOffer = null;
        try
        {
            if (_renameIsBrand)
            {
                var (result, error, offer) = await AdminClient.RenameEquipmentBrandAsync(
                    _renameId, new UpsertEquipmentBrandRequest(_renameName.Trim()));

                if (offer is not null) { _renameOffer = offer; return; }
                if (result is null) { _renameError = error ?? "The rename could not be saved."; return; }
            }
            else
            {
                var (result, error, offer) = await AdminClient.RenameEquipmentModelAsync(
                    _renameId, new RenameEquipmentModelRequest(_renameName.Trim()));

                if (offer is not null) { _renameOffer = offer; return; }
                if (result is null) { _renameError = error ?? "The rename could not be saved."; return; }
            }

            CloseRename();
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Takes the merge the server offered instead of the rename.
    /// </summary>
    /// <remarks>
    /// Merge can still refuse, with a sentence rather than a shape, when the direction would lose
    /// an approved name for an unapproved one — somebody correcting "Sansung" usually has the two
    /// the wrong way round. That refusal is shown where the offer was.
    /// </remarks>
    private async Task AcceptEquipmentMergeAsync()
    {
        if (_renameOffer is not { } offer) return;

        _busy = true;
        try
        {
            var (ok, error) = _renameIsBrand
                ? await AdminClient.MergeEquipmentBrandAsync(offer.SourceId, offer.TargetId)
                : await AdminClient.MergeEquipmentModelAsync(offer.SourceId, offer.TargetId);

            if (!ok) { _renameError = error ?? "The merge could not be completed."; return; }

            CloseRename();
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private bool _categoryEditorVisible;
    private EquipmentCategoryRecord? _editingCategory;
    private string _catName = string.Empty;
    private string _catDescription = string.Empty;
    private string _catIconClass = string.Empty;
    private int _catSortOrder;
    private bool _catIsActive = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated || !UserState.IsSuperAdmin) { NavManager.NavigateTo(Ben.Web.Website.Library.Kit.SignInLink.ForRefusal(NavManager, UserState)); return; }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _taxonomyResult = await AdminClient.GetAdminEquipmentBrandsAsync();
            _brands         = [.. _taxonomyResult.Items];
            _models     = [.. (await AdminClient.GetAdminEquipmentModelsAsync()).Items];
            _categories = [.. (await AdminClient.GetAdminEquipmentCategoriesAsync()).Items];
        }
        catch (Exception ex)
        {
            _error = $"The taxonomy could not be loaded: {ex.Message}";
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task ApproveBrandAsync(Guid id)
    {
        _busy = true; _error = null;
        if (await AdminClient.ApproveEquipmentBrandAsync(id) is null) _error = "That make could not be approved.";
        _busy = false;
        await LoadAsync();
    }

    private async Task RejectBrandAsync(Guid id)
    {
        _busy = true; _error = null;
        if (!await AdminClient.RejectEquipmentBrandAsync(id))
            _error = "That make could not be rejected — it may still have models attached.";
        _busy = false;
        await LoadAsync();
    }

    private async Task ApproveModelAsync(Guid id)
    {
        _busy = true; _error = null;
        if (await AdminClient.ApproveEquipmentModelAsync(id) is null) _error = "That model could not be approved.";
        _busy = false;
        await LoadAsync();
    }

    private async Task RejectModelAsync(Guid id)
    {
        _busy = true; _error = null;
        if (!await AdminClient.RejectEquipmentModelAsync(id))
            _error = "That model could not be rejected — it may still be in use by someone's equipment.";
        _busy = false;
        await LoadAsync();
    }

    private void OpenCreateCategory()
    {
        _editingCategory = null;
        _catName = string.Empty;
        _catDescription = string.Empty;
        _catIconClass = string.Empty;
        _catSortOrder = _categories.Count == 0 ? 1 : _categories.Max(c => c.SortOrder) + 1;
        _catIsActive = true;
        _categoryEditorVisible = true;
    }

    private void OpenEditCategory(EquipmentCategoryRecord row)
    {
        _editingCategory = row;
        _catName = row.Name;
        _catDescription = row.Description ?? string.Empty;
        _catIconClass = row.IconClass ?? string.Empty;
        _catSortOrder = row.SortOrder;
        _catIsActive = row.IsActive;
        _categoryEditorVisible = true;
    }

    private async Task SaveCategoryAsync()
    {
        _busy = true; _error = null;
        var request = new UpsertEquipmentCategoryRequest(
            _catName.Trim(),
            string.IsNullOrWhiteSpace(_catDescription) ? null : _catDescription.Trim(),
            string.IsNullOrWhiteSpace(_catIconClass) ? null : _catIconClass.Trim(),
            _catSortOrder,
            _catIsActive);

        var saved = _editingCategory is null
            ? await AdminClient.CreateEquipmentCategoryAsync(request)
            : await AdminClient.UpdateEquipmentCategoryAsync(_editingCategory.Id, request);

        if (saved is null) _error = "That category could not be saved.";
        else _categoryEditorVisible = false;

        _busy = false;
        await LoadAsync();
    }

    private async Task DeleteCategoryAsync(Guid id)
    {
        _busy = true; _error = null;
        if (!await AdminClient.DeleteEquipmentCategoryAsync(id))
            _error = "That category could not be deleted — models are still using it.";
        _busy = false;
        await LoadAsync();
    }
}
