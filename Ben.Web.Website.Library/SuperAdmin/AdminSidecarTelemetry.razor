@page "/admin/sidecar-telemetry"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Sidecar Installs</PageTitle>

@* Makes the telemetry table readable. Writing rows nobody can see is the write-only pattern the
   code audit flagged elsewhere in this app; recording who is running which sidecar build is only
   useful if the answer can actually be looked up. *@

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Sidecar Installs</h3>
            <p class="text-secondary small mb-0">
                The native sidecar runs on a user's own machine and talks only to their browser, so
                these events are the only way to see which builds are in use.
            </p>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_summary is not null)
    {
        <div class="row g-2 mb-3">
            <div class="col-sm-4">
                <StatCard Label="Installations seen" Icon="download"
                          Value="@_summary.DistinctInstalls.ToString("N0")" />
            </div>
            <div class="col-sm-4">
                <StatCard Label="Paired to an account" Icon="link"
                          Value="@_summary.InstallsPairedToAnAccount.ToString("N0")"
                          Caption="@PairedCaption" />
            </div>
            <div class="col-sm-4">
                <StatCard Label="People" Icon="users"
                          Value="@_summary.DistinctPeople.ToString("N0")" />
            </div>
        </div>

        @if (_summary.ByVersion.Count > 0)
        {
            @* These were a row of badges reading "1.2.0 — 7", which is a bar chart with the bars
               left out: the numbers were all there and the shape of the distribution was not.
               Which version most installs are on is the actual question this panel answers. *@
            <div class="card mb-3"><div class="card-body">
                <div class="small text-secondary mb-2">Installations by version</div>
                <ApexChart Type="bar" Height="220"
                           Categories="@_summary.ByVersion.Select(v => v.Version).ToList()"
                           Series="@VersionSeries"
                           NoDataText="No sidecar has reported in yet." />
            </div></div>
        }
    }

    @if (_rowsResult.Failed)
    {
        @* "Nothing recorded yet" over a refusal would read as "no sidecar has ever reported",
           which is exactly the conclusion somebody debugging an install must not jump to. *@
        <BenListState TItem="SidecarInstallLogRecord" Result="@_rowsResult" Loading="@_loading"
                      LoadingText="Loading telemetry…" OnRetry="@LoadAsync" />
    }
    else if (_loading)
    {
        <p class="text-secondary">Loading…</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="text-secondary">
            Nothing recorded yet. Installs are reported only when the installer is given a site URL;
            pairings are reported whenever a signed-in browser pairs.
        </p>
    }
    else
    {
        <TelerikGrid Data="@_rows" Pageable="true" PageSize="25" Sortable="true" Height="60vh">
            <GridColumns>
                <GridColumn Field="@nameof(SidecarInstallLogRecord.DateCreated)" Title="When" Width="180px" DisplayFormat="@DateTimeViewerExtensions.GridDateTimeFormat" />
                <GridColumn Field="@nameof(SidecarInstallLogRecord.EventType)" Title="Event" Width="100px" />
                <GridColumn Field="@nameof(SidecarInstallLogRecord.Version)" Title="Version" Width="120px" />
                <GridColumn Field="@nameof(SidecarInstallLogRecord.Platform)" Title="Platform" Width="120px" />
                <GridColumn Field="@nameof(SidecarInstallLogRecord.AppUserDisplay)" Title="Account">
                    <Template>
                        @{ var row = (SidecarInstallLogRecord)context; }
                        @if (row.AppUserDisplay is null)
                        {
                            <span class="text-secondary">— not signed in</span>
                        }
                        else
                        {
                            @row.AppUserDisplay
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SidecarInstallLogRecord.IpAddress)" Title="Address" Width="150px" />
                <GridColumn Field="@nameof(SidecarInstallLogRecord.InstallId)" Title="Installation" Width="300px" />
            </GridColumns>
        </TelerikGrid>
    }
</div>

@code {
    /// <summary>The version bars, as the one series this chart draws.</summary>
    private List<ApexChart.ChartSeries> VersionSeries =>
    [
        new("Installations", _summary!.ByVersion.Select(v => (double)v.Installs).ToList())
    ];

    /// <summary>
    /// How many of the installs seen are tied to an account. Stated as a share because the raw
    /// pair of numbers invites the reader to do the division themselves and get it wrong.
    /// </summary>
    private string? PairedCaption => _summary is { DistinctInstalls: > 0 }
        ? $"of {_summary.DistinctInstalls:N0} seen"
        : null;

    private IReadOnlyList<SidecarInstallLogRecord> _rows = [];
    private LoadResult<SidecarInstallLogRecord> _rowsResult;
    private SidecarTelemetrySummaryRecord? _summary;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo("/"); return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;

        try
        {
            _summary = await AdminClient.GetSidecarTelemetrySummaryAsync();
            _rowsResult = await AdminClient.GetSidecarTelemetryAsync();
            _rows       = _rowsResult.Items;
        }
        catch (Exception ex)
        {
            // Said out loud rather than left as an empty grid — an empty grid here would read as
            // "no sidecars are installed", which is a different and misleading answer.
            _error = $"Could not load sidecar telemetry. {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
