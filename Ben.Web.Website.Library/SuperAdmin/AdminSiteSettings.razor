@page "/admin/site-settings"
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject SiteFeaturesProvider Features

<PageTitle>SuperAdmin — Site Settings</PageTitle>

<div class="container-fluid py-3" style="max-width:900px;">
    <h3 class="mb-1">Site Settings<HelpLink Slug="site-administration" Anchor="site-settings" /></h3>
    <p class="text-secondary small mb-4">
        These apply to the whole site — every group and every visitor. Nothing personal belongs
        here; settings about one person live on their profile, settings about one group live in
        that group's settings.
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_savedKey is not null)
    {
        <div class="alert alert-success py-2">Saved.</div>
    }

    @* Was `@if (_settings is null) { Loading… }`, which stayed true after a failed load — so the
       page showed the red error banner and a spinner at the same time, reading as "it failed, but
       it is also still trying". BenListState is exactly the missing third and fourth state, and it
       is what tells a signed-out SuperAdmin to sign in rather than quoting a 401 at them.
       Item 133. *@
    <BenListState TItem="SiteSettingRecord" Result="@_result" Loading="@_loading"
                  LoadingText="Loading site settings…"
                  EmptyText="No site settings are defined yet"
                  OnRetry="@LoadAsync">
        <ChildContent>
        @foreach (var setting in _settings ?? [])
        {
            var s = setting;
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="flex-grow-1">
                            @* The key is the API's name for it, not a label a person should have
                               to read first — description leads, key is shown small for support. *@
                            <div class="fw-semibold">@s.Label</div>
                            <div class="text-secondary small">@s.Description</div>
                            <div class="text-muted font-monospace" style="font-size:.7rem;">@s.Key</div>
                        </div>
                        <span class="badge @(string.IsNullOrWhiteSpace(_drafts[s.Key]) ? "bg-secondary" : "bg-success")">
                            @(string.IsNullOrWhiteSpace(_drafts[s.Key]) ? "Not set" : "Set")
                        </span>
                    </div>

                    <div class="d-flex gap-2 align-items-start mt-2 flex-wrap">
                        @* Plain input rather than TelerikTextBox: Telerik inputs bind on blur in
                           this codebase, which loses the last edit when Save is clicked directly. *@
                        @if (s.IsBoolean)
                        {
                            @* On/off settings get a switch. They used to get the same text box as
                               everything else, which is why the self-registration setting's
                               description had to end with "Accepts true or false" — the control
                               was making the admin do its job. Saving happens on the toggle: a
                               switch that needs a separate Save button reads as already applied. *@
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       id="@($"sw-{s.Key}")"
                                       checked="@IsOn(s)"
                                       disabled="@(_savingKey == s.Key)"
                                       @onchange="@(e => ToggleAsync(s.Key, e.Value is true))" />
                                <label class="form-check-label" for="@($"sw-{s.Key}")">
                                    @(IsOn(s) ? "On" : "Off")
                                    @if (string.IsNullOrWhiteSpace(_drafts[s.Key]))
                                    {
                                        <span class="text-secondary small ms-1">(default)</span>
                                    }
                                </label>
                            </div>
                        }
                        else if (s.IsMultiLine)
                        {
                            @* A postal address in a one-line input is technically editable and
                               miserable to edit. The server says which settings need the room. *@
                            <textarea class="form-control" style="max-width:420px;" rows="4"
                                      placeholder="@Placeholder(s.Key)"
                                      value="@_drafts[s.Key]"
                                      @oninput="@(e => _drafts[s.Key] = e.Value?.ToString() ?? string.Empty)"></textarea>
                        }
                        else if (s.Key == DefaultAvatarKey)
                        {
                            @* An upload, not a Guid box (Ben, 2026-08-23): the value IS a file id,
                               but asking an administrator to mint one elsewhere and paste it here
                               was the plumbing showing through. Same flow as anyone's avatar —
                               upload as a public file, then point the setting at it; both steps
                               happen behind this one control. *@
                            <label class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") mb-0" for="default-avatar-upload">
                                @(_savingKey == s.Key ? "Uploading…" : "Upload image")
                            </label>
                            <InputFile id="default-avatar-upload" style="display:none;"
                                       accept="image/png,image/jpeg,image/gif,image/webp"
                                       OnChange="OnDefaultAvatarSelectedAsync" />
                        }
                        else
                        {
                            <input class="form-control" style="max-width:420px;"
                                   placeholder="@Placeholder(s.Key)"
                                   value="@_drafts[s.Key]"
                                   @oninput="@(e => _drafts[s.Key] = e.Value?.ToString() ?? string.Empty)" />
                        }
                        @if (!s.IsBoolean && s.Key != DefaultAvatarKey)
                        {
                        <button type="button" class="btn btn-primary" @onclick="@(() => SaveAsync(s.Key))" disabled="@(!(_savingKey != s.Key))">Save</button>
                        }
                        @if (!s.IsBoolean && !string.IsNullOrWhiteSpace(s.Value))
                        {
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => ClearAsync(s.Key))" disabled="@(!(_savingKey != s.Key))">Clear</button>
                        }
                    </div>

                    @* The default avatar is a file id, which is unreadable as text — show the
                       image so a wrong or deleted id is obvious rather than silently inert. *@
                    @if (s.Key == DefaultAvatarKey && _avatarPreview is not null)
                    {
                        <div class="mt-2 d-flex align-items-center gap-2">
                            <img src="@_avatarPreview" alt="Default avatar"
                                 class="rounded-circle border"
                                 style="width:56px;height:56px;object-fit:cover;" />
                            <span class="text-secondary small">Current default</span>
                        </div>
                    }
                    else if (s.Key == DefaultAvatarKey && !string.IsNullOrWhiteSpace(s.Value))
                    {
                        <div class="alert alert-warning py-2 mt-2 mb-0 small">
                            That file id doesn't resolve to a readable image. People with no photo
                            will fall back to their initials until it's fixed.
                        </div>
                    }
                </div>
            </div>
        }
        </ChildContent>
    </BenListState>
</div>

@code {
    private const string DefaultAvatarKey = "avatar.default.upload-file-id";

    private List<SiteSettingRecord>? _settings;
    private LoadResult<SiteSettingRecord> _result;
    private bool _loading = true;
    private readonly Dictionary<string, string> _drafts = [];
    private string? _savingKey;
    private string? _savedKey;
    private string? _error;
    private string? _avatarPreview;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo("/"); return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _settings is not null) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            // LoadSiteSettings, not GetSiteSettings: the old call turned any refusal into an empty
            // list, so this page rendered blank on the ishaunted.com deploy with no error anywhere
            // — the catch below never fired, because nothing threw (items 120 and 126).
            _result = await AdminClient.GetSiteSettingsAsync();

            if (_result.Failed)
            {
                // No _error banner: BenListState renders the failure, and a signed-out reader gets
                // a way back rather than a status code. Setting both would say it twice.
                return;
            }

            _settings = _result.Items.ToList();
            foreach (var s in _settings) _drafts[s.Key] = s.Value ?? string.Empty;
            await LoadAvatarPreviewAsync();
        }
        catch { _result = LoadResult<SiteSettingRecord>.Failure(); }
        finally { _loading = false; }
    }

    /// <summary>
    /// Fetches the configured default avatar through the authenticated client and renders it as a
    /// data URI — a plain img src to the file endpoint carries no bearer token and would 401 for
    /// any non-public file.
    /// </summary>
    private async Task LoadAvatarPreviewAsync()
    {
        _avatarPreview = null;
        var raw = _settings?.FirstOrDefault(s => s.Key == DefaultAvatarKey)?.Value;
        if (!Guid.TryParse(raw, out var fileId)) return;
        try
        {
            var file = await AdminClient.GetFileDataAsync(fileId);
            if (file is { } f)
                _avatarPreview = $"data:{f.ContentType};base64,{Convert.ToBase64String(f.Data)}";
        }
        catch { /* leaves the "doesn't resolve" warning showing, which is the useful signal */ }
    }

    /// <summary>Ceiling for the default avatar image. Matches the profile-photo limit.</summary>
    private const long MaxDefaultAvatarBytes = 10 * 1024 * 1024;

    private async Task OnDefaultAvatarSelectedAsync(InputFileChangeEventArgs e)
    {
        _savingKey = DefaultAvatarKey; _error = null; _savedKey = null;
        StateHasChanged();
        try
        {
            var file = e.File;
            var typeId = await AdminClient.GetProfilePhotoFileTypeIdAsync();
            if (typeId is null) { _error = "Photo uploads aren't configured."; return; }

            // Buffered before it goes anywhere: a RemoteBrowserFileStream fed straight into
            // request content freezes the page and replays the click on reconnect.
            using var ms = new MemoryStream();
            await using (var browserStream = file.OpenReadStream(MaxDefaultAvatarBytes))
                await browserStream.CopyToAsync(ms);

            // Public on purpose: this image renders for people with no photo, to viewers who may
            // not be signed in at all. A private default would be a broken image for exactly the
            // audience it exists for.
            var uploaded = await AdminClient.UploadUserFileAsync(
                typeId.Value, UserState.UserId ?? Guid.Empty,
                file.Name, file.ContentType, ms.ToArray(),
                description: "Site default avatar", isPublic: true);
            if (uploaded is null)
            {
                _error = "Upload failed — the image must be JPEG, PNG, GIF or WebP.";
                return;
            }

            // Replace, not accumulate (Ben): once the setting points at the new image, the old
            // one has no job left. Remembered before the save, deleted best-effort after it — a
            // file that is genuinely in use elsewhere (someone's own photo pointed at by the old
            // Guid workflow) survives because its references make the hard delete refuse, which
            // is exactly the right arbiter.
            Guid? previous = Guid.TryParse(_drafts.GetValueOrDefault(DefaultAvatarKey), out var prev)
                ? prev : null;

            _drafts[DefaultAvatarKey] = uploaded.Id.ToString();
            await SaveAsync(DefaultAvatarKey);

            if (previous is { } old && old != uploaded.Id && _savedKey == DefaultAvatarKey)
                await AdminClient.DeleteUploadFileAdminAsync(old);
        }
        catch (IOException)
        {
            _error = "That image is too large — 10 MB at most.";
        }
        finally
        {
            if (_savingKey == DefaultAvatarKey) _savingKey = null;
            StateHasChanged();
        }
    }

    private async Task SaveAsync(string key)
    {
        _savingKey = key; _error = null; _savedKey = null;
        try
        {
            var updated = await AdminClient.SetSiteSettingAsync(key, new SetSiteSettingRequest(_drafts[key]));
            if (updated is null) { _error = "Couldn't save that setting."; return; }

            var idx = _settings!.FindIndex(s => s.Key == key);
            if (idx >= 0) _settings[idx] = updated;
            _drafts[key] = updated.Value ?? string.Empty;
            _savedKey = key;

            if (key == DefaultAvatarKey) await LoadAvatarPreviewAsync();

            // Feature switches are read from a snapshot that refreshes on its own every 30
            // seconds. That is right for every other reader and wrong for the person who just
            // moved the switch: without this they save, look at the site, see no change, and
            // reasonably conclude it did not work. Awaited, not just invalidated: Invalidate
            // schedules a refresh behind the NEXT reader, so the admin's own next page could
            // still render the old snapshot — exactly the "did it save?" moment this exists
            // to prevent (found by the announcement-banner e2e test).
            await Features.PrimeAsync();
        }
        catch { _error = "Couldn't save that setting."; }
        finally { _savingKey = null; StateHasChanged(); }
    }

    /// <summary>A stored value is text; "true" in any casing is on, everything else is off.</summary>
    private static bool IsTrue(string? raw) => bool.TryParse(raw, out var v) && v;

    /// <summary>
    /// What the switch should show: the stored value when there is one, otherwise what the site
    /// actually does with nothing stored. Drawing this from the stored value alone made the page
    /// report seven running features as "Off" — the switch has to describe the site, not the row.
    /// </summary>
    private bool IsOn(SiteSettingRecord s)
        => string.IsNullOrWhiteSpace(_drafts[s.Key])
            ? s.DefaultWhenUnset
            : IsTrue(_drafts[s.Key]);

    /// <summary>Writes a switch immediately — see the note on the switch markup.</summary>
    private async Task ToggleAsync(string key, bool on)
    {
        _drafts[key] = on ? "true" : "false";
        await SaveAsync(key);
    }

    private async Task ClearAsync(string key)
    {
        _drafts[key] = string.Empty;
        await SaveAsync(key);
    }

    private static string Placeholder(string key) => key switch
    {
        DefaultAvatarKey => "UploadFile id (GUID)",
        "org.allow-self-registration" => "true or false",
        "site.public-contact-email" => "contact@example.com",
        _ => "Leave empty to unset",
    };
}
