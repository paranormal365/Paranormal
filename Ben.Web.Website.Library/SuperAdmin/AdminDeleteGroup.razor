@page "/admin/delete-group"
@namespace Ben.Web.Website.Library.SuperAdmin

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@using Ben.Service.Models.Admin
@using Ben.Web.Services
@using Ben.Web.Website.Library.Kit

@*
    The most destructive screen in the product, and deliberately its own page.

    The ordinary delete on the groups list refuses a group that still has cases, files or events
    — which is right, and useless for clearing test data out of a database that is also the live
    one. This is the named exception, kept somewhere nobody reaches by accident: you have to come
    here on purpose, choose a group, read what it would destroy, and type its name.
*@

<PageTitle>SuperAdmin — Delete a group</PageTitle>

<div class="container-fluid px-3 py-4" style="max-width:820px; margin:auto;">

    <h3 class="mb-1">Delete a group</h3>
    <p class="text-secondary small">
        Removes a group and everything belonging to it — members' memberships, cases,
        investigations, events, evidence and files. <strong>This cannot be undone.</strong>
    </p>

    <div class="alert alert-info py-2 small">
        <strong>What survives:</strong> the people themselves (they keep their accounts and any
        other groups), the places involved — they're shared, and other people's visits are
        recorded there — and all site-wide lookup data. Anyone's personal field sessions that
        weren't part of this group's investigations stay theirs too.
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger">@_loadError</div>
    }

    <div class="card mb-3"><div class="card-body">
        <label class="form-label" for="group-picker">Group</label>
        <select id="group-picker" class="form-select" @bind="_selectedId" @bind:after="LoadPreviewAsync">
            <option value="@Guid.Empty">— choose a group —</option>
            @foreach (var org in _groups)
            {
                <option value="@org.Id">@org.Name</option>
            }
        </select>
    </div></div>

    @if (_busy)
    {
        <BenLoaderOverlay Visible="true" Text="Working…" />
    }

    @if (_preview is not null)
    {
        <div class="card border-danger mb-3">
            <div class="card-header bg-danger text-white">
                Deleting “@_preview.OrganizationName” would destroy
            </div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var line in Lines(_preview))
                    {
                        <div class="col-6 col-md-4">
                            <div class="border rounded p-2 text-center">
                                <div class="fs-4 fw-semibold">@line.Count.ToString("N0")</div>
                                <div class="text-secondary small">@line.Label</div>
                            </div>
                        </div>
                    }
                </div>

                <hr />

                <label class="form-label" for="confirm-name">
                    Type <strong>@_preview.OrganizationName</strong> to confirm
                </label>
                <input id="confirm-name" class="form-control" style="max-width:420px;"
                       @bind="_confirmName" @bind:event="oninput"
                       placeholder="@_preview.OrganizationName" />

                <div class="mt-3">
                    @* Enabled only on an exact match. The button being dead until the name is
                       right is the confirmation — a dialog you can click through out of habit is
                       not one. *@
                    <button type="button" class="btn btn-danger"
                            id="confirm-delete"
                            disabled="@(_busy || !NameMatches)"
                            @onclick="PurgeAsync">
                        <BenIcon Name="trash-2" Class="me-1" />Delete this group permanently
                    </button>
                    <button type="button" class="btn btn-outline-secondary ms-2" @onclick="Clear">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_result is not null)
    {
        <div class="alert alert-success">
            <strong>“@_result.OrganizationName” is gone.</strong>
            Removed @_result.Members membership(s), @_result.Cases case(s),
            @_result.Investigations investigation(s), @_result.Events event(s) and
            @_result.StoredFiles file(s).
        </div>
    }

    @if (_error is not null)
    {
        @* The server's own sentence, rendered as-is. A mistyped name and a database constraint
           are very different problems and both arrive here; replacing either with "something
           went wrong" would leave a SuperAdmin with nowhere to go. *@
        <div class="alert alert-danger">@_error</div>
    }
</div>

@code {
    private List<OrganizationListItemResponse> _groups = [];
    private Guid _selectedId = Guid.Empty;
    private OrganizationPurgePreview? _preview;
    private OrganizationPurgePreview? _result;
    private string _confirmName = "";
    private bool _busy;
    private string? _error;
    private string? _loadError;

    private bool NameMatches =>
        _preview is not null
        && string.Equals(_confirmName.Trim(), _preview.OrganizationName, StringComparison.Ordinal);

    private static IEnumerable<(string Label, int Count)> Lines(OrganizationPurgePreview p) =>
    [
        ("memberships", p.Members),
        ("cases", p.Cases),
        ("investigations", p.Investigations),
        ("events", p.Events),
        ("field sessions", p.FieldSessions),
        ("event evidence", p.EventEvidence),
        ("stored files", p.StoredFiles),
        ("public pages", p.CmsPages),
        ("billing rows", p.BillingRows),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive);
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo("/"); return; }

        var result = await AdminClient.GetOrganizationsAsync();
        _groups = result.Items.OrderBy(o => o.Name).ToList();
        _loadError = result.Failed ? "Couldn't load the list of groups." : null;

        StateHasChanged();
    }

    private async Task LoadPreviewAsync()
    {
        _preview = null;
        _result = null;
        _error = null;
        _confirmName = "";

        if (_selectedId == Guid.Empty) { StateHasChanged(); return; }

        _busy = true;
        StateHasChanged();

        _preview = await AdminClient.GetOrganizationPurgePreviewAsync(_selectedId);
        if (_preview is null) _error = "Couldn't read what that group holds, so nothing is offered.";

        _busy = false;
        StateHasChanged();
    }

    private async Task PurgeAsync()
    {
        if (_preview is null || !NameMatches) return;

        _busy = true;
        _error = null;
        StateHasChanged();

        var (removed, error) = await AdminClient.PurgeOrganizationAsync(_selectedId, _confirmName.Trim());

        _busy = false;

        if (error is not null)
        {
            _error = error;
        }
        else
        {
            _result = removed ?? _preview;
            _preview = null;
            _confirmName = "";
            _selectedId = Guid.Empty;

            // The list is refetched rather than filtered in place: the group is gone on the
            // server, and a stale option somebody could pick again is exactly the kind of thing
            // that produces a confusing second error.
            var refreshed = await AdminClient.GetOrganizationsAsync();
            _groups = refreshed.Items.OrderBy(o => o.Name).ToList();
        }

        StateHasChanged();
    }

    private void Clear()
    {
        _preview = null;
        _confirmName = "";
        _selectedId = Guid.Empty;
        _error = null;
    }
}
