@page "/admin/test-posts"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

@*
    Feed posts by the seeded accounts — what a Playwright run leaves on the live feed.

    Development and production share a database, so an e2e run's posts land on ishaunted.com's
    front page. Until this page the only way down was a member reporting each one and a moderator
    upholding it, one at a time.

    The rule is a fact about the author, not a guess about the text: the account's email is on a
    domain only the seeder uses. That means the curated posts — the ones the App Store screenshots
    show — are on this list too, because the same accounts wrote them. So: checkboxes, the whole
    body visible, and nothing hidden that was not chosen. Hiding is what a moderator does anyway,
    and it is reversible from here.
*@

<PageTitle>Test posts — IsHaunted</PageTitle>

<div class="container-fluid px-3 py-3" style="max-width:1100px;">

    <h3 class="mb-1">Test posts on the feed</h3>
    <p class="text-muted">
        Public-feed posts written by the seeded accounts. Hiding one takes it off the feed for
        everybody at once; it can be put back from this page.
    </p>

    @* Outside every branch: the banner must survive the reload that follows a hide. *@
    @if (_result is not null)
    {
        <div class="alert alert-success py-2" data-testid="hide-result">@_result</div>
    }

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" />
    }
    else if (_refusal is not null)
    {
        <div class="alert alert-warning" data-testid="test-posts-refusal">@_refusal</div>
    }
    else if (_rows is null || _rows.Count == 0)
    {
        <div class="alert alert-success" data-testid="no-test-posts">
            No posts by a seeded account. The feed is all real people.
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
            <button type="button" class="btn btn-danger btn-sm text-nowrap"
                    data-testid="hide-posts"
                    disabled="@(_working || SelectedVisible == 0)" @onclick="ConfirmAsync">
                <BenIcon Name="eye-off" Class="me-1" />
                @(_working ? "Working…" : SelectedVisible == 0 ? "Hide selected" : $"Hide {SelectedVisible} selected")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                    data-testid="unhide-posts"
                    disabled="@(_working || SelectedHidden == 0)" @onclick="UnhideAsync">
                <BenIcon Name="eye" Class="me-1" />
                @(SelectedHidden == 0 ? "Unhide selected" : $"Unhide {SelectedHidden} selected")
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                    disabled="@_working" @onclick="LoadAsync">
                <BenIcon Name="refresh-cw" Class="me-1" />Look again
            </button>
            <span class="text-muted small" data-testid="counts">
                @_rows.Count post@(_rows.Count == 1 ? "" : "s"), @_rows.Count(r => r.Hidden) hidden
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:2.5rem;">
                            <input type="checkbox" class="form-check-input" id="test-post-check-all"
                                   data-testid="check-all"
                                   checked="@AllSelected" @onchange="ToggleAll"
                                   aria-label="Select every post" />
                        </th>
                        <th>Posted</th>
                        <th>Who</th>
                        <th>What it says</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr data-testid="test-post-row" class="@(row.Hidden ? "text-muted" : null)">
                            <td>
                                <input type="checkbox" class="form-check-input"
                                       data-testid="test-post-check"
                                       checked="@_selected.Contains(row.Id)"
                                       @onchange="@(e => Toggle(row.Id, e.Value is true))"
                                       aria-label="@($"Select the post from {row.DateCreated.ToLocalTime():MM/dd/yyyy}")" />
                            </td>
                            <td class="text-nowrap">@row.DateCreated.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</td>
                            <td class="text-nowrap">
                                @row.AuthorName
                                <div class="small text-secondary">@row.AuthorEmail</div>
                            </td>
                            <td data-testid="test-post-body" style="white-space:pre-wrap; max-width:36rem;">@Trim(row.Body)@(row.IsReply ? " " : "")@if (row.IsReply) { <span class="badge text-bg-light">reply</span> }</td>
                            <td class="text-nowrap">
                                @if (row.Hidden)
                                {
                                    <span class="badge text-bg-secondary" data-testid="state-hidden">hidden</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success" data-testid="state-visible">on the feed</span>
                                    @if (row.VisibleReplies > 0)
                                    {
                                        <span class="small text-secondary ms-1">+@row.VisibleReplies repl@(row.VisibleReplies == 1 ? "y" : "ies")</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<BenConfirmDialog @bind-Visible="@_confirming"
                  Title="Hide these posts?"
                  Busy="@_working"
                  BusyText="Hiding…"
                  ConfirmText="Hide them"
                  OnConfirm="HideAsync">
    <p>
        This takes <strong>@SelectedVisible</strong> post@(SelectedVisible == 1 ? "" : "s") off the
        public feed, along with any replies under them. Nothing is deleted, and they can be put
        back from this page.
    </p>
</BenConfirmDialog>

@code {
    private IReadOnlyList<TestFeedPostRecord>? _rows;
    private readonly HashSet<Guid> _selected = [];
    private bool    _confirming;
    private bool    _loading = true;
    private bool    _working;
    private string? _refusal;
    private string? _result;

    private int SelectedVisible => _rows?.Count(r => _selected.Contains(r.Id) && !r.Hidden) ?? 0;
    private int SelectedHidden  => _rows?.Count(r => _selected.Contains(r.Id) &&  r.Hidden) ?? 0;
    private bool AllSelected => _rows is { Count: > 0 } && _selected.Count == _rows.Count;

    private static string Trim(string body) => body.Length <= 240 ? body : body[..240] + "…";

    private void Toggle(Guid id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true && _rows is not null)
            foreach (var row in _rows) _selected.Add(row.Id);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo("/"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _refusal = null;
        StateHasChanged();

        var result = await AdminClient.GetTestFeedPostsAsync();
        if (result.Failed)
            _refusal = result.Reason ?? "Couldn't list the feed's test posts just now.";
        else
        {
            _rows = result.Items;
            _selected.IntersectWith(_rows.Select(r => r.Id));
        }

        _loading = false;
    }

    private void ConfirmAsync() => _confirming = true;

    private Task HideAsync()   => ApplyAsync(hide: true);
    private Task UnhideAsync() => ApplyAsync(hide: false);

    private async Task ApplyAsync(bool hide)
    {
        if (_rows is null) return;
        var chosen = _rows.Where(r => _selected.Contains(r.Id) && r.Hidden != hide).Select(r => r.Id).ToList();
        if (chosen.Count == 0) return;

        _working = true; _refusal = null; _result = null;
        StateHasChanged();

        var (outcome, error) = hide
            ? await AdminClient.HideTestFeedPostsAsync(chosen)
            : await AdminClient.UnhideTestFeedPostsAsync(chosen);

        _working = false;
        _confirming = false;

        if (error is not null) { _refusal = error; await LoadAsync(); return; }
        if (outcome is null)
        {
            _refusal = "The change did not go through, and the server did not say why. Nothing was changed.";
            await LoadAsync();
            return;
        }
        if (outcome.Refusal is not null) { _refusal = outcome.Refusal; await LoadAsync(); return; }

        _selected.Clear();
        await LoadAsync();
        _result = hide
            ? $"Hid {outcome.Changed} post{(outcome.Changed == 1 ? "" : "s")}"
              + (outcome.RepliesAlso > 0 ? $" and {outcome.RepliesAlso} repl{(outcome.RepliesAlso == 1 ? "y" : "ies")} under them." : ".")
            : $"Put {outcome.Changed} post{(outcome.Changed == 1 ? "" : "s")} back on the feed.";
    }
}
