@page "/admin/referrals"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject BenToastService Toasts
@using Ben.Service.Models.Admin
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@using Ben.Web.Website.Library.Manage.Icon
@using Ben.Web.Website.Library.Help

<PageTitle>SuperAdmin — Referrals</PageTitle>

@*
    Item 168: referral standings. A referrer is anyone a coupon campaign is attributed to (set on
    the campaign, by email). The platform shows what their codes brought in and what has been paid
    out — it does NOT compute what is owed, because the reward rule is a product decision Ben has
    not made. Both sides are on screen so a human can settle it, and the payout is recorded here.
*@

<div class="container-fluid px-3" style="max-width:60rem;">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Referrals<HelpLink Slug="site-administration" Anchor="the-money-trail" /></h3>
            <p class="text-secondary small mb-0">
                Attribute a coupon campaign to a person (on the campaign, by their account email) and every
                redemption counts as their referral. Payouts land on the ledger.
            </p>
        </div>
    </div>

    <BenListState TItem="ReferrerSummaryRecord" Result="@_result" Loading="@_loading"
                  EmptyText="No campaigns are attributed to a referrer yet" OnRetry="@LoadAsync">
        <TelerikGrid Data="@_result.Items" TItem="ReferrerSummaryRecord" Sortable="false">
            <GridColumns>
                <GridColumn Field="@nameof(ReferrerSummaryRecord.ReferrerName)" Title="Referrer" />
                <GridColumn Title="Campaigns" Width="100px">
                    <Template>@(((ReferrerSummaryRecord)context).CouponCount)</Template>
                </GridColumn>
                <GridColumn Title="Referrals" Width="100px">
                    <Template>@(((ReferrerSummaryRecord)context).RedemptionCount)</Template>
                </GridColumn>
                <GridColumn Title="Revenue brought in" Width="150px">
                    <Template>@($"${((ReferrerSummaryRecord)context).RevenueAttributed:0.00}")</Template>
                </GridColumn>
                <GridColumn Title="Discount given" Width="130px">
                    <Template>@($"${((ReferrerSummaryRecord)context).DiscountGiven:0.00}")</Template>
                </GridColumn>
                <GridColumn Title="Paid out" Width="110px">
                    <Template>@($"${((ReferrerSummaryRecord)context).PaidOut:0.00}")</Template>
                </GridColumn>
                <GridColumn Title="Actions" Width="130px">
                    <Template>
                        @{ var r = (ReferrerSummaryRecord)context; }
                        <button type="button" class="btn btn-outline-primary btn-sm text-nowrap"
                                @onclick="@(() => OpenPayout(r))">Record payout…</button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    </BenListState>
</div>

<BenModal @bind-Visible="@_showPayout" Title="Record a referral payout">
    <ChildContent>
        <p class="mb-3">Paying <strong>@_payoutTo?.ReferrerName</strong> — they have brought in
            $@($"{_payoutTo?.RevenueAttributed ?? 0:0.00}") and been paid $@($"{_payoutTo?.PaidOut ?? 0:0.00}") so far.</p>
        <div class="row g-3">
            <div class="col-6">
                <label class="form-label fw-semibold" for="payout-amount">Amount ($)</label>
                <input id="payout-amount" type="number" step="0.01" min="0" class="form-control" @bind="@_payoutAmount" />
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold" for="payout-ref">Payment reference (optional)</label>
                <input id="payout-ref" type="text" class="form-control" @bind="@_payoutReference" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="payout-desc">Which referrals this settles</label>
                <input id="payout-desc" type="text" class="form-control"
                       placeholder="e.g. Q3 2026 referrals, 4 redemptions" @bind="@_payoutDescription" @bind:event="oninput" />
            </div>
        </div>
        @if (_payoutError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_payoutError</div>
        }
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-secondary" @onclick="@(() => _showPayout = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SavePayoutAsync"
                    disabled="@(_busy || _payoutAmount <= 0 || string.IsNullOrWhiteSpace(_payoutDescription))">
                @(_busy ? "Recording…" : "Record payout")
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    private bool _loading = true;
    private bool _busy;
    private LoadResult<ReferrerSummaryRecord> _result;

    private bool _showPayout;
    private ReferrerSummaryRecord? _payoutTo;
    private decimal _payoutAmount;
    private string? _payoutReference;
    private string _payoutDescription = "";
    private string? _payoutError;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo("/"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        _result = await AdminClient.GetReferrersAsync();
        _loading = false;
        StateHasChanged();
    }

    private void OpenPayout(ReferrerSummaryRecord r)
    {
        _payoutTo = r;
        _payoutAmount = 0;
        _payoutReference = null;
        _payoutDescription = "";
        _payoutError = null;
        _showPayout = true;
    }

    private async Task SavePayoutAsync()
    {
        if (_payoutTo is null) return;
        _busy = true; _payoutError = null;
        try
        {
            var (result, error) = await AdminClient.RecordReferralPayoutAsync(new RecordReferralPayoutRequest(
                _payoutTo.ReferrerAppUserId, _payoutAmount, _payoutDescription, _payoutReference));
            if (result is null) { _payoutError = error ?? "Recording failed."; return; }
            Toasts.Success($"Paid ${result.Amount:0.00} to {_payoutTo.ReferrerName} — it is on the ledger.");
            _showPayout = false;
            await LoadAsync();
        }
        finally { _busy = false; }
    }
}
