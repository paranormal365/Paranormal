@page "/admin/store/orders/{Id:guid}/invoice"
@using Ben.Web.Website.Library.Store.Orders
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Invoice</PageTitle>

@*
    An order's invoice from the desk (storefront S5.5) — the same sheet the buyer prints
    (StoreInvoiceSheet), so what the admin sends and what the buyer holds cannot differ.
*@

<div class="container-fluid px-3 py-3" style="max-width:64rem;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 ben-invoice-toolbar">
        <a class="small d-inline-flex align-items-center gap-1" href="@($"/admin/store/orders/{Id}")"><BenIcon Name="arrow-left" /> Back to the order</a>
        <div class="d-flex align-items-center gap-2">
            <HelpLink Slug="site-administration" Anchor="orders-and-fulfilment" />
            @if (_invoice.Item is not null)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" id="invoice-print" onclick="window.print()"><BenIcon Name="printer" /> Print</button>
            }
        </div>
    </div>
    @if (!_loading && _invoice.IsEmpty)
    {
        <div class="alert alert-secondary" data-testid="invoice-none">There's no invoice for this order — it isn't paid.</div>
    }
    else
    {
        <BenItemState TItem="StoreInvoiceRecord" Result="_invoice" Loading="_loading">
            <ChildContent>
                <StoreInvoiceSheet Invoice="context" />
            </ChildContent>
        </BenItemState>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ItemResult<StoreInvoiceRecord> _invoice;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo(SignInLink.ForRefusal(NavManager, UserState)); return; }
        _invoice = await AdminClient.GetStoreOrderInvoiceAdminAsync(Id);
        _loading = false;
    }
}
