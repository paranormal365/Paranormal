@page "/admin/store/orders"
@using Ben.Web.Website.Library.Store.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject BenToastService Toasts
@inject IJSRuntime JS

<PageTitle>SuperAdmin — Store Orders</PageTitle>

@*
    The order desk's list (storefront S5.5): what is waiting to go out, what needs looking at, and
    every order by number, buyer, SKU, tracking or code. The filters live in the address, so the
    dashboard's tiles and a code's "N orders" open the list already filtered.

    Checkouts that were never paid and are finished stay out of the list unless asked for; an open
    one (still waiting for payment) is listed, with Release. Export is a button — the file comes from
    the API with the admin's token.
*@

<div class="container-fluid px-3" style="max-width:80rem;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h3 class="mb-0">Orders<HelpLink Slug="site-administration" Anchor="orders-and-fulfilment" /></h3>
            <p class="text-secondary small mb-0">Pack, ship and refund. Newest first.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" id="orders-export" disabled="@_exporting" @onclick="ExportAsync">Export CSV</button>
            <button type="button" class="btn btn-outline-secondary" id="orders-export-refunds" disabled="@_exporting" @onclick="ExportRefundsAsync">Export refunds</button>
        </div>
    </div>

    <div class="row g-2 mb-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small" for="orders-search">Search</label>
            <input id="orders-search" type="search" class="form-control" placeholder="Order no., buyer, SKU, product or tracking"
                   @bind="_q" @bind:event="oninput" @bind:after="ApplyAsync" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="orders-status">Status</label>
            <select id="orders-status" class="form-select" value="@(_status?.ToString() ?? "")"
                    @onchange="@(e => { _status = Enum.TryParse<StoreOrderStatus>(e.Value?.ToString(), out var s) ? s : null; return ApplyAsync(); })">
                <option value="">Any</option>
                @foreach (var s in Enum.GetValues<StoreOrderStatus>())
                {
                    <option value="@s">@StoreOrderStatusText.Label(s)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="orders-coupon">Discount code</label>
            <input id="orders-coupon" class="form-control" placeholder="Any" @bind="_coupon" @bind:event="oninput" @bind:after="ApplyAsync" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="orders-from">From</label>
            <BenDateField Mode="DateEntryMode.Date" Id="orders-from" @bind-Value="_from" @bind-Value:after="ApplyAsync" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="orders-to">To</label>
            <BenDateField Mode="DateEntryMode.Date" Id="orders-to" @bind-Value="_to" @bind-Value:after="ApplyAsync" />
        </div>
        <div class="col-12 d-flex flex-wrap gap-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="orders-needs-action" checked="@_needsAction"
                       @onchange="@(e => { _needsAction = (bool)(e.Value ?? false); return ApplyAsync(); })" />
                <label class="form-check-label" for="orders-needs-action">Waiting to go out or needing attention</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="orders-attention" checked="@_attention"
                       @onchange="@(e => { _attention = (bool)(e.Value ?? false); return ApplyAsync(); })" />
                <label class="form-check-label" for="orders-attention">Needing attention</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="orders-refund-attention" checked="@_refundAttention"
                       @onchange="@(e => { _refundAttention = (bool)(e.Value ?? false); return ApplyAsync(); })" />
                <label class="form-check-label" for="orders-refund-attention">Refunds that failed or are stuck</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="orders-unpaid" checked="@_unpaid"
                       @onchange="@(e => { _unpaid = (bool)(e.Value ?? false); return ApplyAsync(); })" />
                <label class="form-check-label" for="orders-unpaid">Include checkouts that were never paid</label>
            </div>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert" id="orders-refusal">@_error</div>
    }

    <BenListState TItem="StoreOrderListRecord" Result="_result" Loading="_loading"
                  EmptyText="No orders match" OnRetry="LoadAsync">
        <div class="table-responsive">
            <table class="table align-middle" id="orders" style="min-width:48rem;">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Placed</th>
                        <th>Buyer</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th style="width:10rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in _result.Items)
                    {
                        <tr data-testid="order-row">
                            <td>
                                <a href="@($"/admin/store/orders/{o.Id}")" class="fw-semibold">#@o.OrderNumber</a>
                                @if (o.NeedsAttention)
                                {
                                    <span class="badge bg-danger ms-1" title="@o.AttentionReason" data-testid="order-attention">Needs attention</span>
                                }
                                @if (o.HasRefundAttention)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis ms-1">Refund problem</span>
                                }
                                <div class="small text-secondary">@o.ItemCount @(o.ItemCount == 1 ? "item" : "items")@(o.CouponCode is { } c ? $" · {c}" : null)</div>
                            </td>
                            <td class="text-nowrap small">@o.PlacedUtc.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy h:mm tt")</td>
                            <td>
                                <div>@o.BuyerName</div>
                                <div class="small text-secondary">@o.BuyerEmail@(o.IsGuest ? " · guest" : null) · @o.ShipState</div>
                            </td>
                            <td class="text-end text-nowrap">
                                @StoreMoney.Format(o.Total)
                                @if (o.RefundedAmount > 0) { <div class="small text-warning-emphasis">−@StoreMoney.Format(o.RefundedAmount)</div> }
                            </td>
                            <td>
                                <span class="fw-medium text-@StoreOrderStatusText.Tone(o.Status)-emphasis">@StoreOrderStatusText.Label(o.Status)</span>
                                <div class="small text-secondary">@o.PaymentStatus</div>
                            </td>
                            <td>
                                <span class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/store/orders/{o.Id}")">Open</a>
                                    @if (o.Status == StoreOrderStatus.PendingPayment)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="@(() => ReleaseAsync(o))">Release</button>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </BenListState>
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QQuery { get; set; }
    [SupplyParameterFromQuery(Name = "coupon")] public string? CouponQuery { get; set; }
    [SupplyParameterFromQuery(Name = "needsAction")] public bool? NeedsActionQuery { get; set; }
    [SupplyParameterFromQuery(Name = "refunds")] public string? RefundsQuery { get; set; }
    [SupplyParameterFromQuery(Name = "attention")] public bool? AttentionQuery { get; set; }

    private LoadResult<StoreOrderListRecord> _result;
    private bool _loading = true, _busy, _exporting;
    private string? _error, _q, _coupon;
    private StoreOrderStatus? _status;
    private DateTime? _from, _to;
    private bool _needsAction, _refundAttention, _unpaid, _attention;
    private int _loads;

    private StoreOrderListQuery Query => new(_status, _q, _coupon, _from, _to, _needsAction, _refundAttention, _unpaid, _attention);

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo(SignInLink.ForRefusal(NavManager, UserState)); return; }
        _status = Enum.TryParse<StoreOrderStatus>(StatusQuery, out var s) ? s : null;
        _q = QQuery;
        _coupon = CouponQuery;
        _needsAction = NeedsActionQuery == true;
        _refundAttention = RefundsQuery == "attention";
        _attention = AttentionQuery == true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var mine = ++_loads;
        _loading = true;
        var result = await AdminClient.GetStoreOrdersAsync(Query);
        if (mine != _loads) return;   // a newer search is on its way; this answer is stale
        _result = result;
        _loading = false;
    }

    /// <summary>Keeps the address in step with the filters, so a refresh or a shared link shows the same list.</summary>
    private async Task ApplyAsync()
    {
        NavManager.NavigateTo("/admin/store/orders" + Query.ToQueryString(), replace: true);
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        _exporting = true; _error = null;
        try
        {
            var file = await AdminClient.DownloadStoreOrdersCsvAsync(Query);
            if (file is null) { var error = "The orders could not be downloaded."; _error = error; return; }
            await JS.InvokeVoidAsync("downloadFileFromBase64", Convert.ToBase64String(file.Value.Data), "text/csv", file.Value.FileName);
        }
        finally { _exporting = false; }
    }

    /// <summary>Every refund in the chosen dates (or all of them), with its status and Stripe's ids.</summary>
    private async Task ExportRefundsAsync()
    {
        _exporting = true; _error = null;
        try
        {
            var file = await AdminClient.DownloadStoreRefundsCsvAsync(_from, _to);
            if (file is null) { var error = "The refunds could not be downloaded."; _error = error; return; }
            await JS.InvokeVoidAsync("downloadFileFromBase64", Convert.ToBase64String(file.Value.Data), "text/csv", file.Value.FileName);
        }
        finally { _exporting = false; }
    }

    private async Task ReleaseAsync(StoreOrderListRecord o)
    {
        _busy = true; _error = null;
        try
        {
            var (released, error) = await AdminClient.ReleaseStoreOrderAsync(o.Id);
            if (released is null) { _error = error ?? "The checkout could not be released."; return; }
            Toasts.Success($"Checkout #{o.OrderNumber} released — its stock and code are free again.");
            await LoadAsync();
        }
        finally { _busy = false; }
    }
}
