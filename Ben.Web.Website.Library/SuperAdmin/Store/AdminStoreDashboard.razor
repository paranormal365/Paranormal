@page "/admin/store"
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>SuperAdmin — Store</PageTitle>

@*
    The store at a glance (storefront S1.11). Works with the shop switched off — that is when the
    catalogue gets built — and says plainly when it is, with the way to the switch.
*@

<div class="container-fluid px-3" style="max-width:72rem;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h3 class="mb-0">Store<HelpLink Slug="site-administration" Anchor="the-store" /></h3>
            <p class="text-secondary small mb-0">Orders waiting, sales, and what is running low.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <label class="form-label small mb-0" for="dashboard-days">Sales over</label>
            <select id="dashboard-days" class="form-select form-select-sm w-auto" value="@_days" @onchange="OnDaysChangedAsync">
                <option value="7">7 days</option>
                <option value="30">30 days</option>
                <option value="90">90 days</option>
                <option value="365">a year</option>
            </select>
        </div>
    </div>

    <BenItemState TItem="StoreDashboardRecord" Result="_result" Loading="_loading"
                  LoadingText="Loading the store…" OnRetry="LoadAsync">
        <ChildContent Context="d">
            @if (!d.StoreIsOn)
            {
                <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" id="store-off">
                    <span>The store is switched off — visitors can't see it. Everything here still works, so the catalogue can be built first.</span>
                    <a class="btn btn-sm btn-warning text-nowrap" href="/admin/site-settings?setting=features.store">Go to the switch</a>
                </div>
            }
            else if (!d.CheckoutEnabled)
            {
                <div class="alert alert-warning" id="store-paused">
                    The store is showing but not taking orders. <a href="/admin/store/settings">Take orders</a> is off.
                </div>
            }

            <div class="row g-3 mb-3">
                @* Each tile opens the order list filtered to exactly what it counts (S5.5). *@
                <div class="col-6 col-lg-3"><StatCard Label="To pack" Value="@d.OrdersToPack.ToString()" Icon="package" Href="/admin/store/orders?status=Paid" LinkLabel="Open the orders to pack" /></div>
                <div class="col-6 col-lg-3"><StatCard Label="To ship" Value="@d.OrdersToShip.ToString()" Icon="truck" Href="/admin/store/orders?needsAction=true" LinkLabel="Open the orders to ship" /></div>
                <div class="col-6 col-lg-3"><StatCard Label="Needs attention" Value="@d.OrdersNeedingAttention.ToString()" Icon="alert-triangle" HigherIsBetter="false" Href="/admin/store/orders?attention=true" LinkLabel="Open the orders needing attention" /></div>
                <div class="col-6 col-lg-3"><StatCard Label="Reviews waiting" Value="@d.ReviewsPending.ToString()" Icon="message-square" HigherIsBetter="false" Href="/admin/store/reviews" LinkLabel="Open the review queue" /></div>
                @* Store sellers P3: sellers asking for their items to go on sale. *@
                <div class="col-6 col-lg-3"><StatCard Label="Sale requests" Value="@d.SaleRequestsWaiting.ToString()" Icon="inbox" HigherIsBetter="false" Href="/admin/store/sale-requests" LinkLabel="Open the sale requests" /></div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-8">
                    <div class="card h-100" id="store-sales">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Store sales <span class="text-secondary small fw-normal">— last @Window(d.Days)</span></h5>
                            <div class="row text-center g-2">
                                <div class="col-4">
                                    <div class="text-secondary small">Taken</div>
                                    <div class="fs-4 fw-semibold">@StoreMoney.Format(d.Sales.GrossUsd)</div>
                                    <div class="text-secondary small">@d.OrdersInRange @(d.OrdersInRange == 1 ? "order" : "orders")</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-secondary small">Refunded</div>
                                    <div class="fs-4 fw-semibold">@StoreMoney.Format(d.Sales.RefundedUsd)</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-secondary small">Net</div>
                                    <div class="fs-4 fw-semibold">@StoreMoney.Format(d.Sales.NetUsd)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <StatCard Label="Units held by open checkouts" Value="@d.UnitsHeldByOpenCheckouts.ToString()" Icon="clock"
                              Caption="On the shelf, but promised to buyers still paying." />
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Running low</span>
                    <a class="small" href="/admin/store/stock?low=true">Open the stock page</a>
                </div>
                @if (d.LowStock.Count == 0)
                {
                    <div class="card-body text-secondary small" id="low-stock-none">Nothing live is at or under its low-stock number.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 align-middle" id="low-stock">
                            <thead><tr><th>Product</th><th>Variant</th><th>SKU</th><th class="text-end">Free to sell</th></tr></thead>
                            <tbody>
                                @foreach (var row in d.LowStock)
                                {
                                    <tr>
                                        <td><a href="@($"/admin/store/products/{row.ProductId}/edit")">@row.ProductName</a></td>
                                        <td>@row.VariantName</td>
                                        <td class="font-monospace small">@row.Sku</td>
                                        <td class="text-end @(row.Available <= 0 ? "text-danger fw-semibold" : null)">@row.Available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </ChildContent>
    </BenItemState>
</div>

@code {
    private ItemResult<StoreDashboardRecord> _result;
    private bool _loading = true;
    private int _days = 30;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating) { NavManager.NavigateTo(SignInLink.ForRefusal(NavManager, UserState)); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await AdminClient.GetStoreDashboardAsync(_days);
        _loading = false;
    }

    private async Task OnDaysChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var days)) _days = days;
        await LoadAsync();
    }

    private static string Window(int days) => days switch
    {
        365 or 366 => "year",
        1 => "day",
        _ => $"{days} days",
    };
}
