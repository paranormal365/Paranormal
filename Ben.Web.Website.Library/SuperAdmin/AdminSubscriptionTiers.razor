    private async Task ToggleCapabilityAsync(
        SubscriptionTierAdminRecord tier, Ben.Data.Common.Enums.TierCapability capability, bool on)
    {
        _savingAreasTierId = tier.Id;
        try
        {
            var next = (tier.IncludedCapabilities ?? []).ToHashSet();
            if (on) next.Add(capability); else next.Remove(capability);

            var (updated, error) = await AdminClient.SetTierCapabilitiesAsync(tier.Id, next.ToList());
            if (updated is null)
            {
                _saveError = error ?? "The capability change couldn't be saved.";
                return;
            }
            await LoadAsync();
        }
        finally
        {
            _savingAreasTierId = null;
        }
    }

    private async Task ToggleAreaAsync(
        SubscriptionTierAdminRecord tier, Ben.Data.Common.Enums.OrganizationPermissionArea area, bool on)
    {
        _savingAreasTierId = tier.Id;
        try
        {
            var next = (tier.IncludedAreas ?? []).ToHashSet();
            if (on) next.Add(area); else next.Remove(area);

            var (updated, error) = await AdminClient.SetTierPermissionAreasAsync(tier.Id, next.ToList());
            if (updated is null)
            {
                _saveError = error ?? "The area change couldn't be saved.";
                return;
            }
            // Reload rather than patch in place: LoadResult items are immutable snapshots, and
            // the list is small.
            await LoadAsync();
        }
        finally
        {
            _savingAreasTierId = null;
        }
    }

