@page "/admin/support-tickets"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Support

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>Support Tickets</PageTitle>

<div class="container-fluid py-3" style="max-width:1100px;">

    <div class="d-flex align-items-baseline gap-2 mb-1 flex-wrap">
        <h3 class="mb-0">Support Tickets</h3>
        <HelpLink Slug="site-administration" Anchor="support-tickets" />
        @if (_page is not null)
        {
            <span class="badge bg-secondary">@_page.TotalCount total</span>
        }
    </div>
    <p class="text-secondary small mb-4">Messages sent through the public contact form.</p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @* ── Filters ──────────────────────────────────────────────────────────── *@
    <div class="row g-2 mb-3 align-items-end">
        <div class="col-auto">
            <label class="form-label small mb-1" for="adminsupporttickets-status-31c8">Status</label>
            <select id="adminsupporttickets-status-31c8" class="form-select form-select-sm" @onchange="OnStatusChanged">
                <option value="" selected="@(_status is null)">All</option>
                @foreach (var s in Enum.GetValues<SupportTicketStatus>())
                {
                    <option value="@((int)s)" selected="@(_status == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1" for="adminsupporttickets-topic-d559">Topic</label>
            <select id="adminsupporttickets-topic-d559" class="form-select form-select-sm" @onchange="OnTopicChanged">
                <option value="" selected="@(_topic is null)">All</option>
                @foreach (var t in Enum.GetValues<SupportTicketTopic>())
                {
                    <option value="@((int)t)" selected="@(_topic == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1" for="adminsupporttickets-search-ee3d">Search</label>
            <input id="adminsupporttickets-search-ee3d" class="form-control form-control-sm" placeholder="Reference, subject, name or email"
                   value="@_search"
                   @oninput="@(e => _search = e.Value?.ToString() ?? "")" />
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => LoadAsync(1))">Apply</button>
        </div>
    </div>

    @if (_loading && _page is null)
    {
        <BenLoaderOverlay Visible="true" Text="Loading tickets…" />
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <div class="alert alert-light text-muted text-center py-4">No tickets match those filters.</div>
    }
    else
    {
        @foreach (var ticket in _page.Items)
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div style="cursor:pointer;" @onclick="@(() => ToggleAsync(ticket))">
                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <span class="font-monospace text-secondary small">@ticket.Reference</span>
                                <span class="fw-semibold">@ticket.Subject</span>
                                <span class="badge @StatusClass(ticket.Status)">@ticket.Status</span>
                                <span class="badge bg-body-secondary text-body-emphasis border">@ticket.Topic</span>
                            </div>
                            <div class="text-secondary small">
                                @ticket.FromName &lt;@ticket.FromEmail&gt;
                                · @ticket.DateCreated.ToLocalTime().ToDisplayDateTime()
                                @if (ticket.ReplyCount > 0)
                                {
                                    <span> · @ticket.ReplyCount @(ticket.ReplyCount == 1 ? "reply" : "replies")</span>
                                }
                                @if (ticket.AssignedToDisplayName is not null)
                                {
                                    <span> · with @ticket.AssignedToDisplayName</span>
                                }
                            </div>
                        </div>
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ToggleAsync(ticket))">
                            @(_openTicketId == ticket.Id ? "Hide" : "Open")
                        </button>
                    </div>

                    @if (_openTicketId == ticket.Id)
                    {
                        <hr class="my-2" />
                        <div class="mb-3" style="white-space:pre-wrap;">@ticket.Body</div>

                        @if (_repliesResult.Failed)
                        {
                            @* A thread that failed to load is not a ticket nobody answered. *@
                            <BenListState TItem="SupportTicketReplyRecord" Result="@_repliesResult" />
                        }
                        @foreach (var reply in _replies)
                        {
                            <div class="card mb-2 @(reply.IsInternalNote ? "border-warning" : "")">
                                <div class="card-body py-2">
                                    <div class="text-secondary small mb-1">
                                        @(reply.IsFromStaff ? (reply.AuthorDisplayName ?? "Staff") : ticket.FromName)
                                        · @reply.DateCreated.ToLocalTime().ToDisplayDateTime()
                                        @if (reply.IsInternalNote)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Internal note</span>
                                        }
                                    </div>
                                    <div style="white-space:pre-wrap;">@reply.Body</div>
                                </div>
                            </div>
                        }

                        <textarea class="form-control mb-2" rows="4" maxlength="8000"
                                  placeholder="Write a reply to the sender, or an internal note"
                                  value="@_replyDraft"
                                  @oninput="@(e => _replyDraft = e.Value?.ToString() ?? "")"></textarea>

                        <div class="d-flex gap-2 align-items-center flex-wrap">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => ReplyAsync(ticket, internalNote: false))" disabled="@(!(!_busy && !string.IsNullOrWhiteSpace(_replyDraft)))">Reply to sender</button>
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ReplyAsync(ticket, internalNote: true))" disabled="@(!(!_busy && !string.IsNullOrWhiteSpace(_replyDraft)))">Add internal note</button>

                            <span class="ms-auto d-flex gap-2">
                                @if (ticket.Status != SupportTicketStatus.Closed)
                                {
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => SetStatusAsync(ticket, SupportTicketStatus.Closed))" disabled="@(!(!_busy))">Close</button>
                                }
                                else
                                {
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => SetStatusAsync(ticket, SupportTicketStatus.Open))" disabled="@(!(!_busy))">Reopen</button>
                                }
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => AssignToMeAsync(ticket))" disabled="@(!(!_busy && ticket.AssignedToAppUserId != UserState.UserId))">Assign to me</button>
                            </span>
                        </div>

                        <div class="form-text mt-2">
                            The sender reads this thread through their tracking link. Internal notes
                            are never shown there.
                        </div>
                    }
                </div>
            </div>
        }

        @if (TotalPages > 1)
        {
            <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => LoadAsync(_page.Page - 1))" disabled="@(!(!_loading && _page.Page > 1))">← Previous</button>
                <span class="text-secondary small">Page @_page.Page of @TotalPages</span>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => LoadAsync(_page.Page + 1))" disabled="@(!(!_loading && _page.Page < TotalPages))">Next →</button>
            </div>
        }
    }
</div>

@code {
    private SupportTicketPage? _page;
    private IReadOnlyList<SupportTicketReplyRecord> _replies = [];
    private LoadResult<SupportTicketReplyRecord> _repliesResult;
    private Guid? _openTicketId;
    private string _replyDraft = "";

    private SupportTicketStatus? _status;
    private SupportTicketTopic? _topic;
    private string _search = "";

    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private int TotalPages => _page is null || _page.PageSize == 0
        ? 1
        : (int)Math.Ceiling(_page.TotalCount / (double)_page.PageSize);

    protected override async Task OnInitializedAsync()
    {
        // Two things at once, and both matter. AuthReady is only ever signalled from the
        // interactive circuit, so awaiting it during the static prerender hangs the response
        // outright — hence the RendererInfo check that WaitUntilAuthReadyAsync wraps. And a fresh
        // circuit starts unauthenticated until MainLayout restores the session, so checking the
        // role before it completes would bounce a signed-in administrator to Home.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        if (!UserState.IsSuperAdmin && !UserState.IsAdmin)
        {
            NavManager.NavigateTo("/");
            return;
        }

        await LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            _page = await AdminClient.GetSupportTicketsAsync(_status, _topic, _search, page);
            if (_page is null) _error = "Could not load tickets.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ToggleAsync(SupportTicketAdminRecord ticket)
    {
        if (_openTicketId == ticket.Id)
        {
            _openTicketId = null;
            _replies = [];
            return;
        }

        _openTicketId = ticket.Id;
        _replyDraft = "";
        _repliesResult = await AdminClient.GetSupportTicketRepliesAsync(ticket.Id);
        _replies       = _repliesResult.Items;
    }

    private async Task ReplyAsync(SupportTicketAdminRecord ticket, bool internalNote)
    {
        if (string.IsNullOrWhiteSpace(_replyDraft)) return;

        _busy = true;
        try
        {
            var ok = await AdminClient.AddSupportTicketReplyAsync(
                ticket.Id, new AddSupportTicketReplyRequest(_replyDraft, internalNote));

            if (!ok) { _error = "Could not save that reply."; return; }

            _replyDraft = "";
            _repliesResult = await AdminClient.GetSupportTicketRepliesAsync(ticket.Id);
            _replies       = _repliesResult.Items;
            // Reload the list too: replying changes status and assignment on the server, and a
            // stale row would show the old ones.
            await LoadAsync(_page?.Page ?? 1);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetStatusAsync(SupportTicketAdminRecord ticket, SupportTicketStatus status)
    {
        _busy = true;
        try
        {
            var updated = await AdminClient.UpdateSupportTicketAsync(
                ticket.Id, new UpdateSupportTicketRequest(status, null));
            if (updated is null) { _error = "Could not update that ticket."; return; }
            await LoadAsync(_page?.Page ?? 1);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AssignToMeAsync(SupportTicketAdminRecord ticket)
    {
        if (UserState.UserId is not { } me) return;

        _busy = true;
        try
        {
            var updated = await AdminClient.UpdateSupportTicketAsync(
                ticket.Id, new UpdateSupportTicketRequest(null, me));
            if (updated is null) { _error = "Could not assign that ticket."; return; }
            await LoadAsync(_page?.Page ?? 1);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _status = string.IsNullOrEmpty(raw) ? null : (SupportTicketStatus)int.Parse(raw);
    }

    private void OnTopicChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _topic = string.IsNullOrEmpty(raw) ? null : (SupportTicketTopic)int.Parse(raw);
    }

    private static string StatusClass(SupportTicketStatus status) => status switch
    {
        SupportTicketStatus.New      => "bg-danger",
        SupportTicketStatus.Open     => "bg-primary",
        SupportTicketStatus.Answered => "bg-success",
        SupportTicketStatus.Closed   => "bg-dark",
        _                            => "bg-secondary",
    };
}
