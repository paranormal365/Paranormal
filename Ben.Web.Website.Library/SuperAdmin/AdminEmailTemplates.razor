@page "/admin/email-templates"
@namespace Ben.Web.Website.Library.SuperAdmin
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject IJSRuntime      JS

<PageTitle>SuperAdmin — Email templates</PageTitle>

<div class="container-fluid py-3" id="admin-email-templates">

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0">Email templates</h1>
        <HelpLink Slug="site-administration" Anchor="email-templates" />
        <div class="ms-auto">
            <a class="btn btn-sm btn-outline-secondary" href="/admin/mail">
                <BenIcon Name="mail" Class="me-1" />Recent letters
            </a>
        </div>
    </div>

    <p class="text-secondary">
        Every letter the site sends is written in code. Writing one here replaces it; deleting what
        you wrote puts the original back, because the original never left the code.
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <div class="row g-3">

        @* ── which letter ─────────────────────────────────────────────────── *@
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header py-2"><strong>Letters</strong></div>
                <div class="list-group list-group-flush" style="max-height: 70vh; overflow-y: auto;">
                    @foreach (var row in _letters)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action @(row.Kind == _openKind ? "active" : "")"
                                data-testid="template-row"
                                @onclick="@(() => OpenAsync(row.Kind))">
                            <div class="d-flex align-items-start gap-2">
                                <div class="flex-grow-1">
                                    <div>@row.Title</div>
                                    <div class="small @(row.Kind == _openKind ? "" : "text-secondary")">@row.Description</div>
                                </div>
                                @if (row.IsLive)
                                {
                                    <span class="badge text-bg-success">Yours</span>
                                }
                                @if (row.HasUnpublishedDraft)
                                {
                                    <span class="badge text-bg-warning">Draft</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* ── writing it ───────────────────────────────────────────────────── *@
        <div class="col-12 col-lg-8">
            @if (_open is null)
            {
                <div class="card"><div class="card-body text-secondary">
                    Pick a letter on the left to write your own version of it.
                </div></div>
            }
            else
            {
                <div class="card">
                    <div class="card-header d-flex flex-wrap align-items-center gap-2 py-2">
                        <strong>@_open.Title</strong>
                        @if (_open.PublishedUtc is { } live)
                        {
                            <span class="badge text-bg-success">In use since @live.ToViewerLocalTime(UserState).ToDisplayDate()</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">The site's own letter</span>
                        }
                        <span class="ms-auto small text-secondary">@_status</span>
                    </div>

                    <div class="card-body">

                        @* ── the token builder ───────────────────────────── *@
                        <div class="border rounded p-2 mb-3 bg-body-tertiary">
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-4">
                                    <label class="form-label small mb-1" for="token-table">Table</label>
                                    <BenSelect Id="token-table" TItem="TableOption" TValue="string" Data="@TableOptions"
                                               TextField="Label" ValueField="Value"
                                               DefaultText="Pick a table" Width="100%"
                                               Value="@_table" ValueChanged="@OnTableChosen" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label small mb-1" for="token-column">Column</label>
                                    <BenSelect Id="token-column" TItem="ColumnOption" TValue="string" Data="@ColumnOptions"
                                               TextField="Label" ValueField="Value"
                                               DefaultText="Pick a column" Width="100%"
                                               @bind-Value="@_column" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <button type="button" class="btn btn-outline-primary w-100"
                                            data-testid="insert-token"
                                            disabled="@(_table is null || _column is null)"
                                            @onclick="InsertColumnTokenAsync">
                                        <BenIcon Name="plus" Class="me-1" />Add token
                                    </button>
                                </div>
                            </div>

                            @if (_lastToken is not null)
                            {
                                <div class="small mt-2" data-testid="last-token">
                                    Added <code>@_lastToken</code> to the body.
                                </div>
                            }

                            <div class="mt-2">
                                <div class="form-label small mb-1">Ready-made</div>
                                @foreach (var t in _open.Common)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1"
                                            title="@($"{t.What} Looks like: {t.Looks}")"
                                            @onclick="@(() => AppendToBodyAsync("{" + t.Name + "}"))">
                                        {@t.Name}
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="template-subject">Subject</label>
                            <input id="template-subject" class="form-control" data-testid="template-subject"
                                   @bind="_subject" @bind:event="oninput" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="template-body">Body</label>
                            @* A plain box on purpose: this is email HTML — tables for layout and
                               every style inline, because Outlook renders with Word's engine and
                               Gmail drops <style> blocks. A rich editor would quietly rewrite
                               exactly the markup that makes a letter survive those clients. *@
                            <textarea id="template-body" class="form-control font-monospace" rows="14"
                                      data-testid="template-body"
                                      @bind="_body" @bind:event="oninput"></textarea>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary" data-testid="template-save"
                                    disabled="@_busy" @onclick="SaveAsync">Save draft</button>
                            <button type="button" class="btn btn-outline-primary" data-testid="template-preview"
                                    disabled="@_busy" @onclick="PreviewAsync">Preview</button>
                            <button type="button" class="btn btn-primary" data-testid="template-publish"
                                    disabled="@_busy" @onclick="PublishAsync">Publish</button>
                            <button type="button" class="btn btn-outline-danger ms-auto" data-testid="template-revert"
                                    disabled="@_busy" @onclick="@(() => _confirmRevert = true)">
                                Use the site's letter
                            </button>
                        </div>
                    </div>
                </div>

                @if (_preview is not null)
                {
                    <div class="card mt-3">
                        <div class="card-header py-2">
                            <strong>Preview</strong>
                            <span class="small text-secondary ms-2">
                                Made-up details, shown in @_preview.ZoneId.
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Subject:</strong> <span data-testid="preview-subject">@_preview.Subject</span></div>
                            @* Sealed frame, same reasoning as reading a sent letter: this is HTML
                               somebody typed, and an administration page that ran it would be a
                               worse problem than the one it was opened to solve. *@
                            <iframe sandbox="" srcdoc="@AsItWouldArrive(_preview.Html)" title="The letter"
                                    data-testid="preview-body"
                                    class="w-100 border rounded" style="height: min(55vh, 520px);"></iframe>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<BenModal @bind-Visible="@_confirmRevert" Title="Use the site's letter?" Size="sm">
    <p>
        What you wrote for this letter is deleted and the site's own version is used again. The
        original never left the code, so nothing is lost but your draft.
    </p>
    <div class="d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _confirmRevert = false)">Keep mine</button>
        <button type="button" class="btn btn-danger" data-testid="confirm-revert" @onclick="RevertAsync">Use the site's</button>
    </div>
</BenModal>

@code {
    private readonly List<EmailTemplateSummaryRecord> _letters = [];
    private EmailTemplateDetailRecord? _open;
    private EmailTemplatePreviewRecord? _preview;

    private string? _openKind;
    private string? _subject;
    private string? _body;
    private string? _table;
    private string? _column;
    private string? _lastToken;
    private string? _status;
    private string? _error;
    private bool _busy;
    private bool _confirmRevert;

    private sealed record TableOption(string Value, string Label);
    private sealed record ColumnOption(string Value, string Label);

    private List<TableOption> TableOptions =>
        _open?.Tables.Select(t => new TableOption(t.Name, t.Name)).ToList() ?? [];

    /// <summary>The second dropdown, filled from whichever table is chosen.</summary>
    private List<ColumnOption> ColumnOptions
    {
        get
        {
            var table = _open?.Tables.FirstOrDefault(t => t.Name == _table);
            return table is null
                ? []
                : table.Columns.Select(c => new ColumnOption(c.Name, $"{c.Name} ({c.Type})")).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadListAsync();
    }

    private async Task LoadListAsync()
    {
        var result = await AdminClient.GetEmailTemplatesAsync();
        _letters.Clear();
        if (result.Items is { } items) _letters.AddRange(items);
        _error = result.Items is null ? "Couldn't load the letters." : null;
    }

    private async Task OpenAsync(string kind)
    {
        _openKind = kind;
        _preview = null;
        _lastToken = null;
        _table = null;
        _column = null;
        _status = null;

        _open = await AdminClient.GetEmailTemplateAsync(kind);
        if (_open is null) { _error = "Couldn't open that letter."; return; }

        _subject = _open.DraftSubject;
        _body = _open.DraftBodyHtml;
    }

    /// <summary>Choosing a table empties the column beside it, which no longer belongs to it.</summary>
    private void OnTableChosen(string? table)
    {
        _table = table;
        _column = null;
    }

    private Task InsertColumnTokenAsync()
    {
        if (_table is null || _column is null) return Task.CompletedTask;
        _lastToken = "{" + _table + "." + _column + "}";
        return AppendToBodyAsync(_lastToken);
    }

    /// <summary>
    /// Puts a token in the body.
    /// </summary>
    /// <remarks>
    /// Appended rather than inserted at the cursor: a plain textarea's caret is not reachable from
    /// C#, and a JS interop that reached into it would fight Blazor's binding over the same value.
    /// Appending always works, and an author moves it where they want it.
    /// </remarks>
    private Task AppendToBodyAsync(string token)
    {
        _body = string.IsNullOrEmpty(_body) ? token : _body.TrimEnd() + " " + token;
        _status = null;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var (result, error) = await AdminClient.SaveEmailTemplateDraftAsync(
                _openKind!, new SaveEmailTemplateBody(_subject, _body));

            _status = result?.Message ?? error ?? "Couldn't save that.";
            if (result?.Ok == true) await LoadListAsync();
        }
        finally { _busy = false; }
    }

    private async Task PreviewAsync()
    {
        _busy = true;
        try
        {
            _preview = await AdminClient.PreviewEmailTemplateAsync(
                _openKind!, new SaveEmailTemplateBody(_subject, _body));
            if (_preview is null) _status = "Couldn't build a preview.";
        }
        finally { _busy = false; }
    }

    private async Task PublishAsync()
    {
        _busy = true;
        try
        {
            // Saved first, so Publish always sends what is on the screen rather than whatever was
            // last saved — the two buttons sitting together is exactly how that goes wrong.
            var (saved, saveError) = await AdminClient.SaveEmailTemplateDraftAsync(
                _openKind!, new SaveEmailTemplateBody(_subject, _body));

            if (saved?.Ok != true) { _status = saved?.Message ?? saveError ?? "Couldn't save that."; return; }

            var (result, error) = await AdminClient.PublishEmailTemplateAsync(_openKind!);
            _status = result?.Message ?? error ?? "Couldn't publish that.";
            if (result?.Ok == true) { await LoadListAsync(); await OpenAsync(_openKind!); }
        }
        finally { _busy = false; }
    }

    private async Task RevertAsync()
    {
        _confirmRevert = false;
        _busy = true;
        try
        {
            var (result, error) = await AdminClient.RevertEmailTemplateAsync(_openKind!);
            _status = result?.Message ?? error ?? "Couldn't do that.";
            if (result?.Ok == true) { await LoadListAsync(); await OpenAsync(_openKind!); }
        }
        finally { _busy = false; }
    }

    /// <summary>Wraps a letter in the white canvas mail is written for.</summary>
    /// <remarks>
    /// The white belongs to the letter, not to this page: mail chooses its text colours against a
    /// white background, so drawing one on the site's own dark surface is black text on a dark
    /// panel. Same reasoning as the recent-letters screen, and the same guard catches it.
    /// </remarks>
    private static string AsItWouldArrive(string html)
        => "<!doctype html><html><head><meta charset=\"utf-8\">"
         + "<style>html,body{margin:0;padding:12px;background:#fff;color:#111;"
         + "font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}"
         + "img{max-width:100%}</style></head><body>"
         + html
         + "</body></html>";
}
