@namespace Ben.Web.Website.Library.Manage.Maps
@using Ben.Web.Website.Library.Kit.Maps
@inject IJSRuntime JS

@*
    Driving directions to an address (item 228, phase 5: on Apple Maps through BenMap).

    The route comes from the map provider, drawn on the map and read out beneath it. The starting
    point is either an address in words, which the provider looks up itself, or the person's own
    location from the browser. Neither the OSRM demo server nor a metered geocoding call is
    involved any more.
*@

<style>
    @@media print {
        body > * { display: none !important; }
        .directions-print-area { display: block !important; }
    }
    .directions-print-area { display: block; }
</style>

<BenModal @bind-Visible="@_visible" Title="@($"Directions to {_toTitle}")" Static="true">
    <ChildContent>
        <div class="directions-print-area d-flex flex-column" style="height:100%; gap:8px; padding:8px;">

            @* ── To address (destination) ──────────────────────────────────── *@
            <div class="d-flex align-items-center gap-2 small">
                <span class="text-secondary fw-semibold" style="min-width:36px;">To:</span>
                <span class="fw-semibold">@_toTitle</span>
            </div>

            @* ── From address input ─────────────────────────────────────── *@
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <div class="flex-grow-1" style="min-width:200px;">
                    <input type="text" class="form-control" placeholder="From address…" @bind="@_fromAddress" @bind:event="oninput" />
                </div>
                <button type="button" class="btn btn-outline-secondary" @onclick="@UseMyLocationAsync" disabled="@(!(!_locating))" title="Use my current location"><BenIcon Name="map-pin" Class="me-1" />
                    @(_locating ? "Locating…" : "My Location")
                </button>
                <button type="button" class="btn btn-primary" @onclick="@GetRouteAsync" disabled="@(!(!string.IsNullOrWhiteSpace(_fromAddress) && _toLat != 0 && !_loading))"><BenIcon Name="navigation" Class="me-1" />
                    @(_loading ? "Routing…" : "Get Route")
                </button>
            </div>

            @if (_errorMessage is not null)
            {
                <div class="alert alert-warning py-1 small mb-0">@_errorMessage</div>
            }

            @* ── Map ──────────────────────────────────────────────────────── *@
            <div style="flex:0 0 @_mapHeight;">
                <BenMap @ref="_map" Pins="@_pins" Height="@_mapHeight" FitToPins="false"
                        CenterLatitude="@_toLat" CenterLongitude="@_toLon" Zoom="13" />
            </div>

            @* ── Summary + action buttons ─────────────────────────────────── *@
            @if (_result is not null)
            {
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span class="fw-semibold small" data-testid="directions-summary">
                        @($"{_result.DistanceMiles:F1} mi") &nbsp;·&nbsp;
                        @FormatDuration(_result.DurationMinutes)
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="@OpenInMaps" title="Open in maps app (works on phones)"><BenIcon Name="globe" Class="me-1" />
                            Open in Maps
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="@PrintAsync"><BenIcon Name="printer" Class="me-1" />
                            Print
                        </button>
                    </div>
                </div>

                @* ── Step-by-step directions ──────────────────────────────── *@
                <div style="flex:1; overflow-y:auto; border:1px solid #dee2e6; border-radius:4px; padding:8px;">
                    <ol class="mb-0 ps-3" style="font-size:0.875rem;">
                        @foreach (var step in _result.Steps)
                        {
                            <li class="mb-1">
                                @step.Instructions
                                @if (step.DistanceMiles > 0.01)
                                {
                                    <span class="text-secondary ms-1">(@($"{step.DistanceMiles:F1} mi"))</span>
                                }
                            </li>
                        }
                    </ol>
                </div>
            }
        </div>
    </ChildContent>
</BenModal>

@code {
    private bool   _visible;
    private string _toTitle  = "";
    private double _toLat;
    private double _toLon;
    private string _width    = "760px";
    private string _height   = "700px";
    private string _mapHeight = "300px";

    private BenMap? _map;
    private IReadOnlyList<BenMapPin> _pins = [];

    // From state
    private string  _fromAddress = "";
    private double? _fromLat;
    private double? _fromLon;
    private bool    _locating;

    // Route state
    private bool         _loading;
    private string?      _errorMessage;
    private BenMapRoute? _result;

    // ── Public API ────────────────────────────────────────────────────────────

    public void Show(string toTitle, double toLat, double toLon,
                     string width = "760px", string height = "700px")
    {
        _toTitle      = toTitle;
        _toLat        = toLat;
        _toLon        = toLon;
        _width        = width;
        _height       = height;
        _mapHeight    = MapHeightFrom(height);
        _fromAddress     = "";
        _fromLat         = null;
        _fromLon         = null;
        _result          = null;
        _errorMessage    = null;
        _pins            = [new BenMapPin(toLat, toLon, toTitle, Glyph: "B", Color: "#d93025")];
        _visible         = true;
        StateHasChanged();
    }

    public void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    // ── From address ──────────────────────────────────────────────────────────

    private async Task UseMyLocationAsync()
    {
        _locating     = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            var coords = await JS.InvokeAsync<GeoCoords>("benGetCurrentPosition");
            _fromLat     = coords.Latitude;
            _fromLon     = coords.Longitude;
            _fromAddress = "My current location";
        }
        catch (JSException ex) when (ex.Message.Contains("denied") || ex.Message.Contains("not supported"))
        {
            _errorMessage = "Location access was denied or not supported.";
        }
        catch
        {
            _errorMessage = "Could not get current location.";
        }
        finally { _locating = false; }
        StateHasChanged();
    }

    // ── Route ─────────────────────────────────────────────────────────────────

    private async Task GetRouteAsync()
    {
        if (string.IsNullOrWhiteSpace(_fromAddress)) { _errorMessage = "Enter or locate a starting address first."; return; }

        if (_map is null) { _errorMessage = "The map is not ready yet."; return; }

        _loading      = true;
        _errorMessage = null;
        _result       = null;
        StateHasChanged();

        // "My current location" carries coordinates; anything typed is looked up by the provider.
        var typed = _fromLat is null;
        var route = await _map.RouteAsync(new BenMapRouteRequest(
            typed ? _fromAddress : null, _fromLat, _fromLon, _toLat, _toLon));

        if (route.Error is not null)
        {
            _errorMessage = typed
                ? $"{route.Error} Try adding the city and state, e.g. \"123 Main St, Nashville, TN\"."
                : route.Error;
        }
        else
        {
            _result = route;
        }
        _loading = false;
        StateHasChanged();
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    private void OpenInMaps()
    {
        var from = _fromLat.HasValue
            ? $"{_fromLat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)},{_fromLon!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            : "My+Location";
        var to = $"{_toLat.ToString(System.Globalization.CultureInfo.InvariantCulture)},{_toLon.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        // Apple Maps, to match the map on the page; on a device without it the link opens the web
        // version, and Android hands it to whatever maps app is installed.
        var url = $"https://maps.apple.com/?saddr={from}&daddr={to}&dirflg=d";
        _ = JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string MapHeightFrom(string windowHeight)
    {
        if (windowHeight.EndsWith("px", StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(windowHeight.AsSpan(0, windowHeight.Length - 2), out var px))
            return $"{Math.Max(200, px - 280)}px";
        return "300px";
    }

    private static string FormatDuration(double minutes)
    {
        var h = (int)(minutes / 60);
        var m = (int)(minutes % 60);
        return h > 0 ? $"{h} hr {m} min" : $"{m} min";
    }

    private sealed record GeoCoords(double Latitude, double Longitude);
}
