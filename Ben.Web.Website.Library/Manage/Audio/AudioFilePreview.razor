@* ── Confirm a detected candidate ────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showConfirmCandidateDialog" Title="Keep this as an EVP">
    <ChildContent>
        @if (_confirmingCandidate is { } cc)
        {
            <div class="mb-2 small text-secondary">
                @FormatMarkerRange(cc)
                · detector score @cc.DetectionScore?.ToString("0")
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold" for="audiofilepreview-what-did-you-hear-83cf">What did you hear?</label>
                @* A plain input bound on oninput, not a TelerikTextBox. Telerik's textbox only
                   pushes its value on change/blur, which deadlocked this dialog: the Keep button
                   is gated on the label, so the only thing left to click was disabled, focus never
                   left the field, and the label never bound. *@
                <input id="audiofilepreview-what-did-you-hear-83cf" type="text" class="form-control form-control-sm"
                       placeholder="e.g. Whispered name?"
                       value="@_confirmLabel"
                       @oninput="@(e => _confirmLabel = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold">Confidence</label>
                <BenSelect Class="form-select-sm" Data="@_confidenceOptions" @bind-Value="_confirmConfidence" Width="100%" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold" for="audiofilepreview-note-795d">Note</label>
                <textarea id="audiofilepreview-note-795d" class="form-control" rows="2" @bind="@_confirmNote"></textarea>
            </div>
            @if (_confirmError is not null)
            {
                <div class="text-danger small">@_confirmError</div>
            }
            <div class="small text-secondary">
                The detector's score and bounds are kept alongside your label.
            </div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showConfirmCandidateDialog = false)">Cancel</button>
            @* Deliberately always enabled. Gating this on the label deadlocked the dialog: the field
               only pushed its value on blur, and the one thing left to click was the disabled button,
               so focus never left and the label never bound. Validation lives in the handler instead. *@
            <button type="button" class="btn btn-primary" @onclick="ConfirmCandidateAsync">Keep it</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Save region as clip dialog ──────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showSaveClipDialog" Title="Create Audio File from Region">
    <ChildContent>
        @if (_clipSourceMarker is { } clipMarker)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@clipMarker.Label</strong>
                (@FormatMarkerRange(clipMarker)) from <em>@FileName</em>.
                With padding: <strong>@FormatTime(ClipStart) &ndash; @FormatTime(ClipEnd)</strong>.
                Output will be saved as WAV.
            </p>
        }
        else if (_newUserRegion is not null)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@FormatTime(ClipStart)</strong>
                &ndash; <strong>@FormatTime(ClipEnd)</strong>
                from <em>@FileName</em>. Output will be saved as WAV.
            </p>
        }
        <div class="row g-3">
            <div class="col-12 d-flex gap-3 flex-wrap align-items-end">
                <label class="small mb-0">
                    Lead-in (s)
                    @* Extra room either side of the marked sound. A clip trimmed exactly to the
                       words is hard to judge — you want a moment of the room before and after. *@
                    <input type="number" class="form-control form-control-sm" style="width:90px;"
                           min="0" max="10" step="0.1" value="@_clipPrePad"
                           @oninput="@(e => SetOption(e.Value, v => _clipPrePad = Math.Clamp(v, 0, 10)))" />
                </label>
                <label class="small mb-0">
                    Tail (s)
                    <input type="number" class="form-control form-control-sm" style="width:90px;"
                           min="0" max="10" step="0.1" value="@_clipPostPad"
                           @oninput="@(e => SetOption(e.Value, v => _clipPostPad = Math.Clamp(v, 0, 10)))" />
                </label>
                <label class="small mb-0 d-flex align-items-center gap-2">
                    <input type="checkbox" checked="@_clipNormalize"
                           @onchange="@(e => _clipNormalize = (bool?)e.Value ?? false)" />
                    Boost volume (normalize)
                </label>
            </div>
            <div class="col-12">
                <div class="small text-secondary">
                    Normalizing raises the clip's loudest point to just under maximum. An EVP is
                    usually far quieter than the rest of the recording, so without it the clip can be
                    almost inaudible. The original is never modified — a clip can always be re-cut.
                </div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="audiofilepreview-label-description-7e59">Label / Description</label>
                <input id="audiofilepreview-label-description-7e59" type="text" class="form-control" placeholder="Optional — auto-generated if blank" @bind="@_saveClipLabel" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">File Type <span class="text-danger">*</span></label>
                <BenSelect Class="form-select-sm" Data="@_fileTypes" @bind-Value="@_saveClipTypeId" TextField="@nameof(UploadFileTypeRecord.Name)" ValueField="@nameof(UploadFileTypeRecord.Id)" DefaultText="— select —" Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="clip-pub-afp" @bind="@_saveClipIsPublic" />
                <label for="clip-pub-afp" class="form-label mb-0">Public</label>
            </div>
        </div>
        @if (_saveClipError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0 py-2 small">@_saveClipError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => { _showSaveClipDialog = false; _saveClipError = null; })">
                Cancel
            </button>
            <button type="button" class="btn btn-primary" @onclick="SaveClipAsync" disabled="@(!(!_isSavingClip && _saveClipTypeId != Guid.Empty))"><BenIcon Name="save" Class="me-1" />
                @(_isSavingClip ? "Saving…" : "Save as WAV")
            </button>
            @* Nothing else in this dialog is gated on the file type, so a missing type reads as a dead
               button. Say why. *@
            @if (_saveClipTypeId == Guid.Empty)
            {
                <span class="small text-secondary ms-2">Pick a file type first.</span>
            }
        </div>
    </ChildContent>
</BenModal>
@* ── Toast notifications ────────────────────────────────────────────── *@

@code {

    /// <summary>
    /// Reads a range input's value. The DOM hands back a string; the handlers these replaced took
    /// a number, so parse once here rather than at each call site. A half-typed or empty value
    /// falls back to 0 instead of throwing.
    /// </summary>
    private static int AsRangeValue(object? raw)
        => int.TryParse(raw?.ToString(), System.Globalization.NumberStyles.Integer,
                        System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter, EditorRequired] public Guid   FileId      { get; set; }
    [Parameter, EditorRequired] public string FileName    { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ContentType { get; set; } = string.Empty;
    [Parameter]                 public long   FileSize    { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private WsAudioSource? _source;
    private bool   _loading = true;
    private bool   _ready;
    private bool   _playing;
    private double _currentTime;
    private double _modalTime;
    private double _modalDuration;
    private bool   _showModal;
    private bool   _modalReady;
    private IReadOnlyList<UploadFileRecord> _childClips = [];

    /// <summary>true = drag creates a region (default); false = drag scrubs the playhead.</summary>
    private bool   _regionDrawMode = true;

    // ── Timeline + Spectrogram state ───────────────────────────────────

    private bool   _timelineEnabled  = true;
    private bool   _spectrogramEnabled;
    private bool   _spectrogramLabels = true;   // show frequency labels by default
    private int    _spectrogramFftSamples = 512;
    private BenContextMenu<SpectrogramMenuItem>? _spectrogramMenu;

    private static readonly List<SpectrogramMenuItem> _spectrogramMenuItems =
    [
        new("labels", "🔤  Toggle Labels"),
    ];

    private record SpectrogramResolutionOption(int Value, string Label);
    private static readonly List<SpectrogramResolutionOption> _resolutionOptions =
    [
        new(128,  "128 – Coarse"),
        new(256,  "256 – Low"),
        new(512,  "512 – Standard"),
        new(1024, "1024 – High"),
        new(2048, "2048 – Fine"),
        new(4096, "4096 – Ultra"),
    ];

    // ── Region creation workflow ──────────────────────────────────────────────

    /// <summary>IDs of regions added programmatically (overlays, focus regions) — not user-drawn.</summary>
    private readonly HashSet<string> _programmaticRegionIds = [];

    /// <summary>Region currently being acted on (set from right-click args when saving/clipping).</summary>
    private WsRegionData? _newUserRegion;

    private bool   _showSaveClipDialog;      // save-as-clip form

    // ── Clipping an EVP marker (phase E4) ─────────────────────────────────────

    /// <summary>Set when the clip dialog was opened from a marker rather than a drawn region.</summary>
    private AudioMarkerRecord? _clipSourceMarker;
    private double _clipPrePad  = 1.0;
    private double _clipPostPad = 1.0;
    /// <summary>On by default — the usual reason to clip an EVP is to be able to hear it.</summary>
    private bool   _clipNormalize = true;

    /// <summary>Where the clip actually starts once padding is applied, never before the file does.</summary>
    private double ClipStart => Math.Max(0, ClipSourceStart - _clipPrePad);

    /// <summary>Where it ends, clamped to the recording so the request can't run past the audio.</summary>
    private double ClipEnd =>
        _modalDuration > 0
            ? Math.Min(_modalDuration, ClipSourceEnd + _clipPostPad)
            : ClipSourceEnd + _clipPostPad;

    private double ClipSourceStart =>
        _clipSourceMarker?.TimeSeconds ?? _newUserRegion?.Start ?? 0;

    private double ClipSourceEnd =>
        _clipSourceMarker is { } m
            ? (m.EndSeconds ?? m.TimeSeconds)
            : _newUserRegion?.End ?? 0;

    /// <summary>Opens the clip dialog for a confirmed EVP marker, seeded with listening padding.</summary>
    private void OpenClipFromMarkerDialog(AudioMarkerRecord marker)
    {
        _clipSourceMarker   = marker;
        _saveClipLabel      = marker.Label;
        _clipPrePad         = 1.0;
        _clipPostPad        = 1.0;
        _clipNormalize      = true;
        _saveClipError      = null;
        _showSaveClipDialog = true;
    }
    private bool   _isSavingClip;
    private string? _saveClipError;
    private string  _saveClipLabel    = string.Empty;
    private Guid    _saveClipTypeId;
    private bool    _saveClipIsPublic;
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];

    private WaveSurferPlayer?                          _player;
    private WaveSurferPlayer?                          _modalPlayer;
    private BenContextMenu<AudioContextMenuItem>?  _contextMenu;

    // ── Region context menu state ──────────────────────────────────────────────

    private BenContextMenu<RegionContextMenuItem>? _regionMenu;
    private WsRegionContextMenuArgs? _pendingRegion;
    private bool   _showEditLabelDialog;
    private string _editLabelText = string.Empty;

    private static readonly List<RegionContextMenuItem> _regionMenuItems =
    [
        new("play",    "▶  Play Region"),
        new("explore", "⤢  Explore Region (clip or add a note)"),
        new("save",    "🎵  Create Audio File from Region"),
        new("label",   "✏  Edit Label"),
        new("delete",  "🗑  Delete Region"),
    ];

    // ── Region Explorer (clip + notes) ──────────────────────────────────────────

    private bool         _showRegionExplorer;
    private WsRegionData? _explorerRegion;

    private readonly string _wrapperId = $"afp-{Guid.NewGuid():N}";

    // ── Context menu items ────────────────────────────────────────────────────

    private static readonly List<AudioContextMenuItem> _menuItems =
    [
        new("play",     "▶  Play"),
        new("pause",    "⏸  Pause"),
        new("rewind",   "⏮  Rewind"),
        new("fullview", "⤢  Open Full View"),
    ];

    // ── WsConfig objects ──────────────────────────────────────────────────────

    private WsConfig _compactConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Interact = false, Normalize = true },
        Plugins = new WsPluginConfig { Hover = true },
        InitialHeight = "80px",
        MinHeight     = "80px",
        MaxHeight     = "80px",
        ShowControls  = false,
    };

    private WsConfig _fullConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Normalize = true },
        Plugins = new WsPluginConfig
        {
            Hover               = true,
            Timeline            = true,
            Zoom                = true,
            Spectrogram         = false,   // built-in plugin disabled; toggle button uses custom canvas
            Regions             = true,
            RegionsDragToCreate = true,
        },
        InitialHeight = "280px",
        MinHeight     = "120px",
        MaxHeight     = "600px",
        ShowControls  = true,
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var result = await AdminClient.GetFileDataAsync(FileId);
            if (result is not null)
                _source = WsAudioSource.FromBytes(result.Value.Data, result.Value.ContentType);
        }
        catch { /* silently fail — component shows filename badge as fallback */ }

        _loading = false;
        StateHasChanged();
    }

    // ── Player event handlers ─────────────────────────────────────────────────

    private async Task OnModalReadyAsync()
    {
        _modalDuration = _modalPlayer?.Duration ?? 0;
        _modalReady    = true;
        StateHasChanged();

        // Re-apply the chosen drag mode — each modal open creates a fresh JS/WaveSurfer
        // instance that defaults back to region mode regardless of the prior selection.
        if (_modalPlayer is not null)
            await _modalPlayer.SetDragModeAsync(_regionDrawMode);

        try
        {
            _fileTypes = (await AdminClient.GetPublicFileTypesAsync()).Items;
            if (_fileTypes.Any() && _saveClipTypeId == Guid.Empty)
                _saveClipTypeId = _fileTypes[0].Id;
        }
        catch { /* non-critical */ }

        await OverlayChildClipRegionsAsync();
        await OverlayMarkersAsync();

        // Init Web Audio processing chain after player is ready
        if (_modalPlayer is not null)
            await _modalPlayer.InitAudioProcessingAsync();
    }

    private async Task OverlayChildClipRegionsAsync()
    {
        if (_modalPlayer is null) return;
        try
        {
            _childClips = (await AdminClient.GetChildClipsAsync(FileId)).Items;
            foreach (var clip in _childClips)
            {
                if (clip.RegionStart is null || clip.RegionEnd is null) continue;
                var id = clip.Id.ToString();
                _programmaticRegionIds.Add(id);  // mark as programmatic so it doesn't trigger the confirm dialog
                await _modalPlayer.AddRegionAsync(new WsRegionParams
                {
                    Id      = id,
                    Start   = clip.RegionStart.Value,
                    End     = clip.RegionEnd.Value,
                    Color   = "rgba(16,185,129,0.20)",
                    Drag    = false,
                    Resize  = false,
                    Content = clip.Description ?? clip.FileName,
                });
            }
            StateHasChanged();
        }
        catch { /* silently ignore */ }
    }

    // ── EVP markers ──────────────────────────────────────────────────────────

    /// <summary>Markers a person stands behind — what the marker list shows and edits.</summary>
    private IEnumerable<AudioMarkerRecord> ConfirmedMarkers =>
        _markers.Where(m => m.ReviewStatus == EvpReviewStatus.Confirmed).OrderBy(m => m.TimeSeconds);

    /// <summary>Detector proposals nobody has ruled on yet. Reviewed on the Candidates tab (phase E3).</summary>
    private IEnumerable<AudioMarkerRecord> PendingCandidates =>
        _markers.Where(m => m.ReviewStatus == EvpReviewStatus.Pending).OrderBy(m => m.TimeSeconds);

    private async Task OverlayMarkersAsync()
    {
        if (_modalPlayer is null) return;
        try
        {
            _markersResult = await AdminClient.GetAudioMarkersAsync(FileId);
            _markers       = _markersResult.Items;
            foreach (var marker in _markers)
                await AddMarkerRegionAsync(marker);
            StateHasChanged();
        }
        catch { /* silently ignore */ }
    }

    private async Task AddMarkerRegionAsync(AudioMarkerRecord marker)
    {
        if (_modalPlayer is null) return;

        // A dismissed candidate is kept in the database only so a re-scan can dedupe against it.
        // Drawing it would put rejected noise back on the waveform.
        if (marker.ReviewStatus == EvpReviewStatus.Dismissed) return;

        var id = $"marker-{marker.Id}";
        _programmaticRegionIds.Add(id);
        await _modalPlayer.AddRegionAsync(new WsRegionParams
        {
            Id      = id,
            Start   = marker.TimeSeconds,
            // Equal start and end is how this plugin draws a point marker. A span passes its real
            // end, so the region covers the audio the marker is actually a claim about.
            End     = marker.IsSpan ? marker.EndSeconds : marker.TimeSeconds,
            Color   = MarkerColor(marker),
            Drag    = false,
            Resize  = false,
            Content = MarkerRegionLabel(marker),
        });
    }

    /// <summary>
    /// Candidates are amber regardless of confidence — they carry the detector's default
    /// "Possible", which would otherwise render them identically to a human's least-certain
    /// finding, and those are very different things to see on a waveform.
    /// </summary>
    private static string MarkerColor(AudioMarkerRecord marker) =>
        marker.ReviewStatus == EvpReviewStatus.Pending
            ? "rgba(245,158,11,0.75)"
            : MarkerColor(marker.ConfidenceLevel);

    private static string MarkerColor(EvpConfidenceLevel level) => level switch
    {
        EvpConfidenceLevel.Confirmed => "rgba(16,185,129,0.85)",
        EvpConfidenceLevel.Probable  => "rgba(234,179,8,0.85)",
        _                            => "rgba(148,163,184,0.85)",
    };

    /// <summary>
    /// A candidate is labelled with its score alone. A scan can drop dozens of these onto one
    /// waveform, and repeating "Detected signal" on every band produced overlapping text that hid
    /// the waveform without telling the reader anything — they all say the same words. The number
    /// is the only part that differs, and the panel below carries the full description.
    /// </summary>
    private static string MarkerRegionLabel(AudioMarkerRecord marker) =>
        marker.ReviewStatus == EvpReviewStatus.Pending && marker.DetectionScore is { } score
            ? score.ToString("0")
            : marker.Label;

    /// <summary>"0:03" for a point, "0:03–0:04 (0.6s)" for a span.</summary>
    private static string FormatMarkerRange(AudioMarkerRecord marker) =>
        marker.IsSpan
            ? $"{FormatTime(marker.TimeSeconds)}–{FormatTime(marker.EndSeconds!.Value)} ({marker.EndSeconds!.Value - marker.TimeSeconds:0.0}s)"
            : FormatTime(marker.TimeSeconds);

    private async Task AddMarkerAtCurrentTimeAsync()
    {
        _editingMarker      = null;

        // If the user has a region drawn, they've already shown us the stretch they mean — start
        // from that rather than making them re-enter it as numbers.
        var drawn = _newUserRegion ?? _lastDrawnRegion;
        if (drawn is not null && drawn.End > drawn.Start)
        {
            _markerTimeSeconds = drawn.Start;
            _markerEndSeconds  = drawn.End;
            _markerIsSpan      = true;
        }
        else
        {
            _markerTimeSeconds = _modalTime;
            _markerEndSeconds  = _modalTime + DefaultSpanSeconds;
            _markerIsSpan      = false;
        }

        _markerLabel        = string.Empty;
        _markerConfidence   = EvpConfidenceLevel.Possible;
        _markerNote         = string.Empty;
        _showMarkerDialog   = true;
        await Task.CompletedTask;
    }

    private void OpenEditMarkerDialog(AudioMarkerRecord marker)
    {
        _editingMarker     = marker;
        _markerTimeSeconds = marker.TimeSeconds;
        _markerIsSpan      = marker.IsSpan;
        _markerEndSeconds  = marker.EndSeconds ?? marker.TimeSeconds + DefaultSpanSeconds;
        _markerLabel       = marker.Label;
        _markerConfidence  = marker.ConfidenceLevel;
        _markerNote        = marker.Note ?? string.Empty;
        _showMarkerDialog  = true;
    }

    /// <summary>How long a span starts out when the user asks for one without drawing a region.</summary>
    private const double DefaultSpanSeconds = 1.0;

    private void ToggleMarkerSpan(bool isSpan)
    {
        _markerIsSpan = isSpan;
        // Re-seed rather than leaving a stale end behind the checkbox — an end at or before the
        // start would be rejected by the API, and the user has no reason to expect that.
        if (isSpan && _markerEndSeconds <= _markerTimeSeconds)
            _markerEndSeconds = _markerTimeSeconds + DefaultSpanSeconds;
    }

    /// <summary>The end to persist: null unless the user asked for a span and it's actually one.</summary>
    private double? MarkerEndToSave =>
        _markerIsSpan && _markerEndSeconds > _markerTimeSeconds ? _markerEndSeconds : null;

    private async Task SaveMarkerAsync()
    {
        if (string.IsNullOrWhiteSpace(_markerLabel)) return;

        if (_editingMarker is null)
        {
            var created = await AdminClient.CreateAudioMarkerAsync(FileId, new CreateAudioMarkerRequest(
                _markerTimeSeconds, _markerLabel.Trim(), _markerConfidence,
                string.IsNullOrWhiteSpace(_markerNote) ? null : _markerNote.Trim(),
                MarkerEndToSave));
            if (created is not null)
            {
                _markers = [.. _markers, created];
                await AddMarkerRegionAsync(created);
            }
        }
        else
        {
            var updated = await AdminClient.UpdateAudioMarkerAsync(FileId, _editingMarker.Id, new UpdateAudioMarkerRequest(
                _markerTimeSeconds, _markerLabel.Trim(), _markerConfidence,
                string.IsNullOrWhiteSpace(_markerNote) ? null : _markerNote.Trim(),
                MarkerEndToSave));
            if (updated is not null && _modalPlayer is not null)
            {
                _markers = [.. _markers.Where(m => m.Id != updated.Id), updated];
                await _modalPlayer.RemoveRegionAsync($"marker-{updated.Id}");
                await AddMarkerRegionAsync(updated);
            }
        }

        _showMarkerDialog = false;
        StateHasChanged();
    }

    private async Task DeleteMarkerAsync(AudioMarkerRecord marker)
    {
        var ok = await AdminClient.DeleteAudioMarkerAsync(FileId, marker.Id);
        if (!ok) return;
        _markers = [.. _markers.Where(m => m.Id != marker.Id)];
        if (_modalPlayer is not null)
            await _modalPlayer.RemoveRegionAsync($"marker-{marker.Id}");
        StateHasChanged();
    }

    private async Task SeekToMarkerAsync(AudioMarkerRecord marker)
    {
        if (_modalPlayer is null || _modalDuration <= 0) return;
        await _modalPlayer.SeekToAsync(marker.TimeSeconds / _modalDuration);
    }

    // ── New region drawn by user ──────────────────────────────────────────────

    private async Task OnModalRegionCreated(WsRegionData r)
    {
        // Silently ignore programmatically added overlay regions.
        if (_programmaticRegionIds.Contains(r.Id)) return;

        // Only one user-drawn region is allowed at a time.
        // Remove every other user-drawn region, keeping the new one + saved overlays.
        if (_modalPlayer is not null)
            await _modalPlayer.ClearUserRegionsAsync(
                _programmaticRegionIds.Append(r.Id));

        _lastDrawnRegion = r;
    }

    /// <summary>
    /// Keeps the tracked bounds in step when the user drags or resizes the region they drew.
    /// Without this, <see cref="_lastDrawnRegion"/> held the bounds from the moment the region
    /// was first drawn, so a region-scoped Cut/Silence — and the region readout in the edit
    /// panel — silently used the original bounds rather than what was on screen.
    /// </summary>
    private void OnModalRegionUpdated(WsRegionData r)
    {
        // Checked before the programmatic-region bail-out below: a candidate's region *is*
        // programmatic, so without this the drags that adjust-bounds depends on are thrown away.
        if (_adjustingCandidateId is { } adjustingId && r.Id == $"marker-{adjustingId}")
        {
            _adjustedStart = r.Start;
            _adjustedEnd   = r.End;
            StateHasChanged();
            return;
        }

        if (_programmaticRegionIds.Contains(r.Id)) return;

        if (_lastDrawnRegion?.Id == r.Id) _lastDrawnRegion = r;
        if (_newUserRegion?.Id   == r.Id) _newUserRegion   = r;
        StateHasChanged();
    }

    private async Task SaveClipAsync()
    {
        // Either a drawn region or a marker can be the source; one of them must be.
        if (_clipSourceMarker is null && _newUserRegion is null) return;
        if (_saveClipTypeId == Guid.Empty) return;

        _isSavingClip = true;
        _saveClipError = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.ClipAudioAsync(FileId, new ClipAudioRequest(
                ClipStart, ClipEnd,
                string.IsNullOrWhiteSpace(_saveClipLabel) ? null : _saveClipLabel.Trim(),
                _saveClipIsPublic, _saveClipTypeId,
                _clipNormalize, _clipSourceMarker?.Id));

            if (result is not null)
            {
                _showSaveClipDialog  = false;
                _saveClipLabel       = string.Empty;
                _saveClipError       = null;

                if (_clipSourceMarker is not null)
                {
                    // Reload so the marker row picks up its new LinkedClipUploadFileId — the server
                    // set it, and nothing else would tell this list about it.
                    _clipSourceMarker = null;
                    _markers = (await AdminClient.GetAudioMarkersAsync(FileId)).Items;
                }

                // Remove the user-drawn region — replaced by the persisted overlay
                if (_newUserRegion is not null && _modalPlayer is not null)
                    await _modalPlayer.RemoveRegionAsync(_newUserRegion.Id);
                _newUserRegion = null;

                // Refresh child clips and overlay the newly saved one
                await OverlayChildClipRegionsAsync();
                Notify($"Saved \"{result.FileName}\"", "success");
            }
            else
            {
                Notify("Save failed — only WAV and MP3 sources can be clipped.", "error");
                _saveClipError = "Only WAV and MP3 sources can be clipped.";
            }
        }
        catch (Exception ex)
        {
            _saveClipError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSavingClip = false;
        }
    }

