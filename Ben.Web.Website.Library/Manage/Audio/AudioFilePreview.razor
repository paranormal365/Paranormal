    // ── Phase C: EQ + processing state ───────────────────────────────────────

    private static readonly int[]    _eqFreqs  = [32, 64, 125, 250, 500, 1000, 2000, 4000, 8000, 16000];
    private double[]                 _eqGains  = new double[10];
    private bool                     _showEq;
    private bool                     _hpEnabled;
    private int                      _hpFreq   = 80;
    private bool                     _lpEnabled;
    private int                      _lpFreq   = 16000;
    private bool                     _compEnabled;
    private double                   _compThreshold = -24;
    private double                   _compRatio     = 4;
    private double                   _compAttack    = 0.003;
    private double                   _compRelease   = 0.25;
    private bool                     _noiseGateEnabled;
    private double                   _noiseGateThreshold = -40;
    private double                   _noiseGateAttack    = 0.01;
    private double                   _noiseGateRelease   = 0.15;
    private string                   _colormap      = "jet";
    private bool                     _melScale;
    private bool                     _showVoiceBand;
    private bool                     _silenceDetectionEnabled;
    private double                   _silenceThresholdDb = -40;

    /// <summary>
    /// A record, not a value tuple.
    /// </summary>
    /// <remarks>
    /// These were <c>(string Value, string Label)</c>, and a tuple's element names exist only at
    /// compile time — at runtime it has fields <c>Item1</c>/<c>Item2</c> and no properties at all,
    /// so <c>SelectValue.GetMember(item, "Label")</c> found nothing and fell back to the item
    /// itself. The picker rendered every option as "(viridis, Viridis)" and, because the value
    /// never matched the selected string either, showed blank until something was chosen. The
    /// resolution picker beside it always worked because it uses a record
    /// (2026-09-06 audio walk, finding T).
    /// </remarks>
    private record ColormapOption(string Value, string Label);
    private static readonly List<ColormapOption> _colormapOptions =
    [
        new("jet", "Jet"), new("viridis", "Viridis"), new("inferno", "Inferno"), new("grayscale", "Grayscale"),
    ];

    // ── Phase D: EVP markers state ─────────────────────────────────────────────

    private IReadOnlyList<AudioMarkerRecord> _markers = [];
    private LoadResult<AudioMarkerRecord> _markersResult;
    private bool                    _showMarkers;
    private bool                    _showMarkerDialog;
    private AudioMarkerRecord?      _editingMarker;
    private double                  _markerTimeSeconds;
    private bool                    _markerIsSpan;
    private double                  _markerEndSeconds;
    private string                  _markerLabel      = string.Empty;
    private EvpConfidenceLevel      _markerConfidence = EvpConfidenceLevel.Possible;
    private string                  _markerNote       = string.Empty;
    private static readonly List<EvpConfidenceLevel> _confidenceOptions =
    [
        EvpConfidenceLevel.Possible, EvpConfidenceLevel.Probable, EvpConfidenceLevel.Confirmed,
    ];

    // ── EVP detection ─────────────────────────────────────────────────────────

    private static readonly List<EvpSensitivity> _sensitivityOptions =
    [
        EvpSensitivity.Low, EvpSensitivity.Medium, EvpSensitivity.High,
    ];

    private EvpSensitivity      _scanSensitivity = EvpSensitivity.Medium;
    private EvpDetectionOptions _scanOptions     = EvpDetectionOptions.FromSensitivity(EvpSensitivity.Medium);
    private bool                _showScanTuning;
    private bool                _scanning;
    private string?             _scanMessage;

    /// <summary>
    /// Picking a preset reseeds every setting. That's the intent: the presets are starting points
    /// you then adjust from, not a separate mode — so switching preset after fine-tuning gives you
    /// a clean base again rather than a mix of the two.
    /// </summary>
    private void ApplySensitivityPreset(EvpSensitivity sensitivity)
    {
        _scanSensitivity = sensitivity;
        _scanOptions     = EvpDetectionOptions.FromSensitivity(sensitivity);
    }

    private void SetThreshold(object? raw) =>
        SetOption(raw, v => _scanOptions = _scanOptions with { ThresholdDb = v });

    /// <summary>
    /// Applies a numeric input, ignoring values mid-edit. A partially typed number ("0." or "")
    /// parses to nothing useful, and writing it back would fight the user's cursor.
    /// </summary>
    private static void SetOption(object? raw, Action<double> apply)
    {
        if (double.TryParse(raw?.ToString(), out var value)) apply(value);
    }

    // ── Candidate review ──────────────────────────────────────────────────────

    private bool                _candidatesByScore = true;
    private Guid?               _reviewingCandidateId;
    private bool                _showConfirmCandidateDialog;
    private AudioMarkerRecord?  _confirmingCandidate;
    private string              _confirmLabel      = string.Empty;
    private EvpConfidenceLevel  _confirmConfidence = EvpConfidenceLevel.Possible;
    private string              _confirmNote       = string.Empty;
    private string?             _confirmError;

    /// <summary>
    /// Score order first by default — the strongest signals are the best use of the first few
    /// minutes of review. Playback order is a click away for working straight through a recording.
    /// </summary>
    private IEnumerable<AudioMarkerRecord> SortedCandidates =>
        _candidatesByScore
            ? PendingCandidates.OrderByDescending(c => c.DetectionScore ?? 0).ThenBy(c => c.TimeSeconds)
            : PendingCandidates;

    /// <summary>
    /// Plays just this candidate. The stored span already includes the detector's context padding,
    /// so this plays the lead-in and tail too rather than starting mid-sound.
    /// </summary>
    private async Task PlayCandidateAsync(AudioMarkerRecord candidate)
    {
        if (_modalPlayer is null) return;
        await _modalPlayer.PlayRegionAsync($"marker-{candidate.Id}");
    }

    private void OpenConfirmCandidateDialog(AudioMarkerRecord candidate)
    {
        _confirmingCandidate = candidate;
        _confirmLabel        = string.Empty;   // never pre-fill "Detected signal" as a finding
        _confirmConfidence   = EvpConfidenceLevel.Possible;
        _confirmNote         = string.Empty;
        _confirmError        = null;
        _showConfirmCandidateDialog = true;
    }

    private async Task ConfirmCandidateAsync()
    {
        if (_confirmingCandidate is not { } candidate) return;
        if (string.IsNullOrWhiteSpace(_confirmLabel))
        {
            _confirmError = "Say what you heard before keeping it — a marker with no description isn't a finding.";
            return;
        }

        _confirmError = null;
        _showConfirmCandidateDialog = false;
        await ReviewCandidateAsync(candidate, new ReviewAudioMarkerRequest(
            EvpReviewStatus.Confirmed,
            _confirmLabel.Trim(),
            _confirmConfidence,
            string.IsNullOrWhiteSpace(_confirmNote) ? null : _confirmNote.Trim()));
    }

    private Task DismissCandidateAsync(AudioMarkerRecord candidate) =>
        ReviewCandidateAsync(candidate, new ReviewAudioMarkerRequest(EvpReviewStatus.Dismissed));

    // ── Adjusting a candidate's bounds ────────────────────────────────────────

    private Guid?  _adjustingCandidateId;
    private double _adjustedStart;
    private double _adjustedEnd;

    /// <summary>
    /// Hands one candidate's region over to the mouse. The detector's edges are an estimate — it
    /// finds where energy crossed a threshold, which is often a little inside or outside the sound
    /// a person actually hears — so the bounds need to be correctable before the span is kept as a
    /// finding and later cut into a clip.
    /// </summary>
    private async Task StartAdjustingAsync(AudioMarkerRecord candidate)
    {
        if (_modalPlayer is null) return;

        // Region drag has to be on for the handles to respond; the capture-phase handler otherwise
        // claims the gesture and draws a new region instead.
        await _modalPlayer.SetDragModeAsync(regionMode: true);

        var bounds = await _modalPlayer.SetRegionEditableAsync($"marker-{candidate.Id}");
        if (bounds is null) return;

        _adjustingCandidateId = candidate.Id;
        _adjustedStart        = bounds.Start;
        _adjustedEnd          = bounds.End;
        StateHasChanged();
    }

    /// <summary>Locks every region again, optionally putting the one being edited back where it was.</summary>
    private async Task StopAdjustingAsync(bool revert)
    {
        if (_modalPlayer is null) { _adjustingCandidateId = null; return; }

        if (revert && _adjustingCandidateId is { } id
                   && _markers.FirstOrDefault(m => m.Id == id) is { } original)
        {
            var regionId = $"marker-{original.Id}";
            await _modalPlayer.RemoveRegionAsync(regionId);
            _programmaticRegionIds.Remove(regionId);
            await AddMarkerRegionAsync(original);
        }

        await _modalPlayer.SetRegionEditableAsync(null);
        _adjustingCandidateId = null;
        StateHasChanged();
    }

    private async Task SaveAdjustedBoundsAsync()
    {
        if (_adjustingCandidateId is not { } id) return;
        if (_markers.FirstOrDefault(m => m.Id == id) is not { } candidate) return;

        // Read the bounds off the waveform rather than trusting what the drag events told us.
        // region-updated only arrives at the end of a pointer sequence, and anything that
        // interrupts that sequence would otherwise save stale numbers — silently persisting
        // something different from what the reviewer is looking at. Pulling at save time makes the
        // region itself the single source of truth.
        if (_modalPlayer is not null)
        {
            var live = (await _modalPlayer.GetRegionsAsync())
                .FirstOrDefault(r => r.Id == $"marker-{id}");
            if (live is not null)
            {
                _adjustedStart = live.Start;
                _adjustedEnd   = live.End;
            }
        }

        if (_adjustedEnd <= _adjustedStart)
        {
            // The API would reject this too; catching it here keeps the region editable so the
            // reviewer can just drag it back rather than starting over.
            _scanMessage = "That span ends before it starts — drag the edges apart.";
            StateHasChanged();
            return;
        }

        // Update, not review: moving the edges is not a decision about the candidate, and the
        // review endpoint deliberately refuses anything that isn't confirm-or-dismiss. Update
        // leaves ReviewStatus alone, so the candidate stays in the queue with better bounds.
        _reviewingCandidateId = id;
        try
        {
            var updated = await AdminClient.UpdateAudioMarkerAsync(FileId, id, new UpdateAudioMarkerRequest(
                _adjustedStart,
                candidate.Label,
                candidate.ConfidenceLevel,
                candidate.Note,
                _adjustedEnd));

            if (updated is not null)
            {
                _markers = [.. _markers.Where(m => m.Id != updated.Id), updated];
                if (_modalPlayer is not null)
                {
                    var regionId = $"marker-{updated.Id}";
                    await _modalPlayer.RemoveRegionAsync(regionId);
                    _programmaticRegionIds.Remove(regionId);
                    await AddMarkerRegionAsync(updated);
                }
                _scanMessage = "Bounds updated.";
            }
        }
        catch { _scanMessage = "Couldn't save those bounds."; }
        finally
        {
            _reviewingCandidateId = null;
            _adjustingCandidateId = null;
            if (_modalPlayer is not null) await _modalPlayer.SetRegionEditableAsync(null);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Sends a decision and re-draws the affected marker. Only that one region is touched — a full
    /// reload would restart the waveform's region layer mid-review for no reason.
    /// </summary>
    private async Task ReviewCandidateAsync(AudioMarkerRecord candidate, ReviewAudioMarkerRequest request)
    {
        _reviewingCandidateId = candidate.Id;
        try
        {
            var updated = await AdminClient.ReviewAudioMarkerAsync(FileId, candidate.Id, request);
            if (updated is null) return;

            _markers = [.. _markers.Where(m => m.Id != updated.Id), updated];

            if (_modalPlayer is not null)
            {
                var id = $"marker-{updated.Id}";
                await _modalPlayer.RemoveRegionAsync(id);
                _programmaticRegionIds.Remove(id);
                // Re-adds in confirmed colours, or draws nothing at all when dismissed.
                await AddMarkerRegionAsync(updated);
            }
        }
        catch { /* leave the candidate in the queue rather than pretending it was decided */ }
        finally
        {
            _reviewingCandidateId = null;
            _confirmingCandidate  = null;
            StateHasChanged();
        }
    }

    private async Task RunScanAsync()
    {
        if (_scanning) return;

        if (_scanOptions.Validate() is { } problem)
        {
            _scanMessage = problem;
            return;
        }

        _scanning    = true;
        _scanMessage = null;
        StateHasChanged();

        try
        {
            var candidates = await AdminClient.ScanAudioForEvpAsync(FileId, _scanSensitivity, _scanOptions);

            // Null means the scan did not run. "Nothing stood out from the background" is a
            // finding somebody acts on, so it must never be printed for a request that failed.
            if (candidates is null)
            {
                _scanMessage = "The scan couldn't be run just now. This recording has not been "
                             + "examined — try again rather than reading anything into it.";
                return;
            }

            // Reload everything rather than merging the response in: the scan replaces the previous
            // pending set server-side, so the local list is stale in ways the response alone
            // doesn't describe.
            await ClearMarkerRegionsAsync();
            await OverlayMarkersAsync();

            _scanMessage = candidates.Count switch
            {
                0 => "Nothing stood out from the background.",
                1 => "1 candidate to review.",
                _ => $"{candidates.Count} candidates to review.",
            };
        }
        catch
        {
            _scanMessage = "The scan failed. The file may not be readable audio.";
        }
        finally
        {
            _scanning = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Removes the marker regions currently drawn, so a re-scan doesn't leave the previous scan's
    /// candidates on the waveform as orphans with no row behind them.
    /// </summary>
    private async Task ClearMarkerRegionsAsync()
    {
        if (_modalPlayer is null) return;
        foreach (var marker in _markers)
        {
            var id = $"marker-{marker.Id}";
            await _modalPlayer.RemoveRegionAsync(id);
            _programmaticRegionIds.Remove(id);
        }
    }

    // ── Phase D: destructive edit state ─────────────────────────────────────────

    private bool          _showEdit;
    private bool          _isApplyingEdit;
    private string?       _editError;
    /// <summary>
    /// Which region an edit would act on. See <see cref="RegionSelection"/> for the two rules and
    /// for what went wrong when they lived here as loose fields.
    /// </summary>
    private readonly RegionSelection _regionSelection = new();
    private double        _editGainDb   = 0;
    private double        _editFadeIn   = 1;
    private double        _editFadeOut  = 1;
    private double        _editSpeedRatio     = 1.0;
    private double        _editPitchSemitones = 0;

    private bool CanApplyEdit(bool requiresRegion = false)
        => !_isApplyingEdit
           && _saveClipTypeId != Guid.Empty
           && (!requiresRegion || _regionSelection.HasTarget);

    private async Task ApplyAudioEditAsync(AudioEditOperation operation)
    {
        if (!CanApplyEdit(requiresRegion: operation is AudioEditOperation.Cut or AudioEditOperation.Silence)) return;

        _isApplyingEdit = true;
        _editError = null;
        StateHasChanged();

        try
        {
            // Only Cut and Silence act on a region. Sending the drawn bounds with Gain, Fade, Speed
            // or Pitch said something about those edits that was not true — the panel put the
            // region readout next to them, and the server took bounds it then ignored, so an
            // operation on the whole file looked like an operation on the selection
            // (2026-09-06 audio walk, finding G).
            var isRegionEdit = operation is AudioEditOperation.Cut or AudioEditOperation.Silence;
            var region       = isRegionEdit ? _regionSelection.Target : null;

            var (result, error) = await AdminClient.EditAudioWithReasonAsync(FileId, new AudioEditRequest(
                operation,
                region?.Start,
                region?.End,
                operation == AudioEditOperation.Gain ? _editGainDb : null,
                operation == AudioEditOperation.Fade ? _editFadeIn : null,
                operation == AudioEditOperation.Fade ? _editFadeOut : null,
                null,
                _saveClipIsPublic,
                _saveClipTypeId,
                operation == AudioEditOperation.Speed ? _editSpeedRatio : null,
                operation == AudioEditOperation.Pitch ? _editPitchSemitones : null));

            if (result is not null)
            {
                await OverlayChildClipRegionsAsync();
                Notify($"Saved \"{result.FileName}\"", "success");
            }
            else
            {
                // The server's own sentence, whatever it refused for. This line used to say "only
                // WAV and MP3 sources can be edited" for every failure — true for one of the
                // reasons and misleading for all the others (2026-09-06 audio walk, phase 1).
                _editError = error ?? "That edit could not be applied.";
            }
        }
        catch (Exception ex)
        {
            _editError = $"Error: {ex.Message}";
        }
        finally
        {
            _isApplyingEdit = false;
            StateHasChanged();
        }
    }

