@*
  AudioFilePreview.razor
  ──────────────────────
  The compact waveform player shown wherever an audio file is listed.

  • Shows an 80 px waveform streamed from the file's URL; clicking toggles play/pause.
  • Right-click: Play, Pause, Rewind, Quick look, Open in editor.
  • The editor itself is AudioEditor, on its own page (AudioEditorPage, /audio/{id}).
*@

@namespace Ben.Web.Website.Library.Manage.Audio
@inject IBenAdminClient AdminClient
@inject Ben.Web.Services.IMediaUrlBuilder MediaUrls
@inject BenToastService Toasts
@inject NavigationManager Nav
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@if (_loading)
{
    <div style="height:80px;display:flex;align-items:center;justify-content:center;">
        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
    </div>
}
else if (_source is null)
{
    <div class="d-flex flex-column align-items-center justify-content-center text-center gap-1 p-1"
         data-testid="preview-unavailable" title="@FileName — this audio could not be loaded">
        <span class="text-danger" style="font-size:1.1rem;line-height:1;">&#9888;</span>
        <span class="text-danger" style="font-size:.68rem;line-height:1.1;">Couldn't load this audio</span>
    </div>
}
else if (_decodeFailed)
{
    @* The player's own text here was "PipelineStatus::DEMUXER_ERROR_COULD_NOT_OPEN:
       FFmpegDemuxer: open context", which is true and useless. Say what it means. *@
    <div class="d-flex flex-column align-items-center justify-content-center text-center gap-1 p-1"
         data-testid="preview-unavailable" title="@FileName — this recording could not be played">
        <span class="text-danger" style="font-size:1.1rem;line-height:1;">&#9888;</span>
        <span class="text-danger" style="font-size:.68rem;line-height:1.1;">Recording can't be played</span>
    </div>
}
else
{
    @* ── Compact waveform — click to play/pause, right-click for menu ── *@
    <div id="@_wrapperId"
         style="position:relative;cursor:pointer;border-radius:4px;overflow:hidden;"
         @onclick="TogglePlayAsync"
         @oncontextmenu="ShowContextMenuAsync"
         @oncontextmenu:preventDefault="true"
         title="@(!_playing ? "Click to play" : "Click to pause")">

        @* Play icon overlay — shown when paused and waveform is ready *@
        @if (!_playing && _ready)
        {
            <div style="position:absolute;inset:0;display:flex;align-items:center;
                        justify-content:center;z-index:2;pointer-events:none;
                        background:rgba(0,0,0,.18);border-radius:4px;">
                <span style="font-size:1.6rem;color:#fff;filter:drop-shadow(0 1px 6px rgba(0,0,0,.7));"><BenIcon Name="play" /></span>
            </div>
        }

        <WaveSurferPlayer @ref="_player"
                          Config="@_compactConfig"
                          OnError="@OnPlayerErrorAsync"
                          OnReady="@(() => { _ready = true; StateHasChanged(); })"
                          OnPlay="@(() => { _playing = true; StateHasChanged(); })"
                          OnPause="@(() => { _playing = false; StateHasChanged(); })"
                          OnFinish="@(() => { _playing = false; StateHasChanged(); })"
                          OnTimeUpdate="@(t => _currentTime = t)" />
    </div>
}

@* ── Context menu ────────────────────────────────────────────────────────── *@
<BenContextMenu @ref="_contextMenu"
                    Data="@_menuItems"
                    TextField="@nameof(AudioContextMenuItem.Text)"
                    OnClick="@(async (AudioContextMenuItem item) => await OnMenuClickAsync(item))">
</BenContextMenu>

@* ── Quick look ─────────────────────────────────────────────────────────── *@
@* A bigger player with its own controls, for listening without leaving the list. The editor
   itself is a page (AudioEditorPage); this window used to BE the editor, fullscreen. *@
<BenModal @bind-Visible="_showQuickLook" Title="@FileName" Size="lg">
    <ChildContent>
        @if (_showQuickLook && _source is not null)
        {
            <div data-testid="audio-quick-look">
                <WaveSurferPlayer Config="@_quickLookConfig" />
            </div>
        }
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            @if (CanOpenEditor)
            {
                <a class="btn btn-primary" href="@EditorHref" data-testid="open-in-editor"><BenIcon Name="maximize-2" Class="me-1" />Open in editor</a>
            }
            <button type="button" class="btn btn-secondary" @onclick="@(() => _showQuickLook = false)">Close</button>
        </div>
    </ChildContent>
</BenModal>

@code {
    private WsAudioSource? _source;
    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter, EditorRequired] public Guid   FileId      { get; set; }
    [Parameter, EditorRequired] public string FileName    { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ContentType { get; set; } = string.Empty;
    [Parameter]                 public long   FileSize    { get; set; }

    /// <summary>Reports whether the waveform actually appeared, so a caller can say so.</summary>
    /// <remarks>
    /// Same reason as <c>UserMediaPreview</c>: this used to catch its own failure and render a
    /// filename badge, which is indistinguishable from a file that simply has nothing to draw.
    /// </remarks>
    [Parameter] public EventCallback<Ben.Web.Website.Library.User.MediaPreviewOutcome> OnOutcome { get; set; }

    /// <summary>
    /// A URL WaveSurfer can stream from, instead of this component fetching the bytes.
    /// </summary>
    /// <remarks>
    /// <para><b>Set this anywhere more than one player exists on a page.</b> Fetching bytes puts
    /// a copy of the recording in the SERVER's memory and then a base64 copy in the page — about
    /// 2.3× the file, per player, per render. A media library of recordings did exactly that and
    /// took the website process to sixteen gigabytes before the host was killed.</para>
    ///
    /// <para>With a URL the browser does the fetching, streams as it plays, and caches. The
    /// server holds nothing.</para>
    /// </remarks>
    [Parameter] public string? SourceUrl { get; set; }

    private bool   _loading = true;
    private bool   _ready;
    private bool   _playing;
    private double _currentTime;
    private WaveSurferPlayer?                          _player;
    private BenContextMenu<AudioContextMenuItem>?  _contextMenu;
    private readonly string _wrapperId = $"afp-{Guid.NewGuid():N}";
    // ── Context menu items ────────────────────────────────────────────────────

    private static readonly List<AudioContextMenuItem> _baseMenuItems =
    [
        new("play",      "Play"),
        new("pause",     "Pause"),
        new("rewind",    "Rewind"),
        new("quicklook", "Quick look"),
    ];

    private static readonly List<AudioContextMenuItem> _editorMenuItems =
        [.. _baseMenuItems, new("editor", "Open in editor")];

    /// <summary>"Open in editor" only for someone signed in: the page asks a visitor to sign in,
    /// and these players also sit on public place pages that visitors read.</summary>
    private List<AudioContextMenuItem> _menuItems => CanOpenEditor ? _editorMenuItems : _baseMenuItems;

    private bool CanOpenEditor => UserState.IsAuthenticated;

    /// <summary>The editor's address, with this page as where Back returns to.</summary>
    private string EditorHref =>
        $"/audio/{FileId}?return={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}";

    // ── WsConfig objects ──────────────────────────────────────────────────────

    private WsConfig _compactConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Interact = false, Normalize = true },
        Plugins = new WsPluginConfig { Hover = true },
        InitialHeight = "80px",
        MinHeight     = "80px",
        MaxHeight     = "80px",
        ShowControls  = false,
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Always a URL: the browser fetches and streams it, and nothing passes through this
        // process. Fetching the bytes here put a copy of the recording in the server's memory and
        // a larger base64 copy in the page — per player. A list of clips did that once per clip.
        _source = WsAudioSource.FromUrl(
            string.IsNullOrWhiteSpace(SourceUrl) ? MediaUrls.Download(FileId) : SourceUrl);

        _loading = false;
        StateHasChanged();

        if (OnOutcome.HasDelegate)
        {
            await OnOutcome.InvokeAsync(_source is null
                ? Ben.Web.Website.Library.User.MediaPreviewOutcome.Unavailable
                : Ben.Web.Website.Library.User.MediaPreviewOutcome.Shown);
        }
        // "Open in editor" is offered to signed-in people only, and on a hard navigation sign-in is
        // still being resolved when this first renders. The waveform does not wait for it (a list
        // holds many of these); the menu is redrawn once it is known. Without this the item stayed
        // missing for a signed-in person until something else re-rendered the player
        // (AuthReadyPrerenderGuardTests, 10/26/2026).
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive))
            StateHasChanged();
    }

    /// <summary>
    /// The waveform could not be drawn — the browser could not decode what it was given.
    /// </summary>
    /// <remarks>
    /// A real outcome, not noise: an empty or truncated recording fails exactly here. It is
    /// reported so the card can mark the file rather than leaving WaveSurfer's own
    /// "DEMUXER_ERROR_COULD_NOT_OPEN" on screen, which tells a viewer nothing they can act on.
    /// </remarks>
    private async Task OnPlayerErrorAsync(string message)
    {
        _decodeFailed = true;
        StateHasChanged();
        if (OnOutcome.HasDelegate)
            await OnOutcome.InvokeAsync(Ben.Web.Website.Library.User.MediaPreviewOutcome.Unavailable);
    }

    private bool _decodeFailed;
    // ── Waveform click → toggle play/pause ────────────────────────────────────

    private async Task TogglePlayAsync()
    {
        if (_player is null) return;
        await _player.PlayPauseAsync();
    }

    // ── Context menu ──────────────────────────────────────────────────────────

    private async Task ShowContextMenuAsync(MouseEventArgs e)
    {
        if (_contextMenu is null) return;
        await _contextMenu.ShowAsync(e.ClientX, e.ClientY);
    }

    private async Task OnMenuClickAsync(AudioContextMenuItem item)
    {
        switch (item.Action)
        {
            case "play":
                if (_player is not null) await _player.PlayAsync();
                break;
            case "pause":
                if (_player is not null) await _player.PauseAsync();
                break;
            case "rewind":
                if (_player is not null) await _player.StopAsync();
                _currentTime = 0;
                break;
            case "quicklook":
                if (_playing && _player is not null)
                    await _player.PauseAsync();
                _showQuickLook = true;
                StateHasChanged();
                break;
            case "editor":
                if (_playing && _player is not null)
                    await _player.PauseAsync();
                Nav.NavigateTo(EditorHref);
                break;
        }
    }

    private sealed record AudioContextMenuItem(string Action, string Text);

    private bool _showQuickLook;

    private WsConfig _quickLookConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Normalize = true },
        Plugins = new WsPluginConfig { Hover = true, Timeline = true, Zoom = true },
        InitialHeight = "160px",
        MinHeight     = "120px",
        MaxHeight     = "160px",
        ShowControls  = true,
    };
}
