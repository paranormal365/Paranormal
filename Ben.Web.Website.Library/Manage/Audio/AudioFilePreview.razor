@*
  AudioFilePreview.razor
  ──────────────────────
  Compact waveform player used in the Files tab of AdminUserDetail.

  • Fetches audio bytes on first render and shows an 80 px WaveSurfer waveform.
  • Shows a ▶ overlay when paused; clicking anywhere on the waveform toggles play/pause.
  • Right-clicking shows a TelerikContextMenu: Play, Pause, Rewind, Open Full View.
  • "Open Full View" opens a TelerikWindow with file info + full-featured WaveSurfer
    (Timeline, Hover, Zoom, Spectrogram, Regions, built-in controls).
*@

@namespace Ben.Web.Website.Library.Manage.Audio
@inject IBenAdminClient AdminClient
@inject Ben.Web.Services.IMediaUrlBuilder MediaUrls
@inject BenToastService Toasts
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@if (_loading)
{
    <div style="height:80px;display:flex;align-items:center;justify-content:center;">
        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
    </div>
}
else if (_source is null)
{
    <div class="d-flex flex-column align-items-center justify-content-center text-center gap-1 p-1"
         data-testid="preview-unavailable" title="@FileName — this audio could not be loaded">
        <span class="text-danger" style="font-size:1.1rem;line-height:1;">&#9888;</span>
        <span class="text-danger" style="font-size:.68rem;line-height:1.1;">Couldn't load this audio</span>
    </div>
}
else if (_decodeFailed)
{
    @* The player's own text here was "PipelineStatus::DEMUXER_ERROR_COULD_NOT_OPEN:
       FFmpegDemuxer: open context", which is true and useless. Say what it means. *@
    <div class="d-flex flex-column align-items-center justify-content-center text-center gap-1 p-1"
         data-testid="preview-unavailable" title="@FileName — this recording could not be played">
        <span class="text-danger" style="font-size:1.1rem;line-height:1;">&#9888;</span>
        <span class="text-danger" style="font-size:.68rem;line-height:1.1;">Recording can't be played</span>
    </div>
}
else
{
    @* ── Compact waveform — click to play/pause, right-click for menu ── *@
    <div id="@_wrapperId"
         style="position:relative;cursor:pointer;border-radius:4px;overflow:hidden;"
         @onclick="TogglePlayAsync"
         @oncontextmenu="ShowContextMenuAsync"
         @oncontextmenu:preventDefault="true"
         title="@(!_playing ? "Click to play" : "Click to pause")">

        @* Play icon overlay — shown when paused and waveform is ready *@
        @if (!_playing && _ready)
        {
            <div style="position:absolute;inset:0;display:flex;align-items:center;
                        justify-content:center;z-index:2;pointer-events:none;
                        background:rgba(0,0,0,.18);border-radius:4px;">
                <span style="font-size:1.6rem;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.7);">▶</span>
            </div>
        }

        <WaveSurferPlayer @ref="_player"
                          Config="@_compactConfig"
                          OnError="@OnPlayerErrorAsync"
                          OnReady="@(() => { _ready = true; StateHasChanged(); })"
                          OnPlay="@(() => { _playing = true; StateHasChanged(); })"
                          OnPause="@(() => { _playing = false; StateHasChanged(); })"
                          OnFinish="@(() => { _playing = false; StateHasChanged(); })"
                          OnTimeUpdate="@(t => _currentTime = t)" />
    </div>
}

@* ── Context menu ────────────────────────────────────────────────────────── *@
<BenContextMenu @ref="_contextMenu"
                    Data="@_menuItems"
                    TextField="@nameof(AudioContextMenuItem.Text)"
                    OnClick="@(async (AudioContextMenuItem item) => await OnMenuClickAsync(item))">
</BenContextMenu>

@* ── Full-view window ────────────────────────────────────────────────────── *@
@* The editor gets the room again. It opened as a 92vw x 92vh window until the Manage-area
   restyle (bde4e03f, 2026-08-18) swapped that for a modal and chose the SMALLEST size — 300px,
   with the toolbar scrolling sideways, the waveform a 270px strip and every panel below the fold.
   The same commit dropped VisibleChanged, which is why closing it did not stick and why
   OnModalVisibleChangedAsync became dead code. Both halves are restored here (2026-09-06 audio walk,
   findings P and A). *@
<BenModal Visible="@_showModal" VisibleChanged="@OnModalVisibleChangedAsync" Title="@FileName" Size="fullscreen">
    <ChildContent>
        @if (_showModal && _source is not null)
        {
            <div class="d-flex flex-column h-100" style="overflow:hidden;">

                @* Info bar *@
                @* align-content:flex-start — this bar wraps onto two lines at ordinary widths (the
                   file's details, then the toolbar), and a wrapped flex container's default is to
                   spread its lines through whatever height it has. In a fullscreen modal that put
                   two bands of empty space between the details and the toolbar, which is what the
                   help screenshots showed. *@
                <div class="d-flex flex-wrap gap-4 mb-2 p-2 rounded flex-shrink-0"
                     style="background:var(--kendo-color-surface,#f5f5f5);font-size:.875rem;align-content:flex-start;">
                    <span><strong>Size:</strong>@(" ")@FormatSize(FileSize)</span>
                    <span><strong>Type:</strong>@(" ")@ContentType</span>
                    <span><strong>Duration:</strong>@(" ")@FormatTime(_modalDuration)</span>
                    <span><strong>Position:</strong>@(" ")@FormatTime(_modalTime)</span>
                    <span class="ms-auto d-flex align-items-center gap-2">
                        <HelpLink Slug="using-the-audio-editor" />
                        @* Timeline toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleTimelineAsync" disabled="@(!(_modalReady))">
                            🕐 @(_timelineEnabled ? "Hide Timeline" : "Show Timeline")
                        </button>
                        @* Clear user-drawn regions *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ClearUserRegionsAsync" disabled="@(!(_modalReady))">
                            🗑 Clear Regions
                        </button>
                        @* Spectrogram toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleSpectrogramAsync" disabled="@(!(_modalReady))">
                            📊 @(_spectrogramEnabled ? "Hide Spectrogram" : "Show Spectrogram")
                        </button>
                        @* Spectrogram resolution — only shown when spectrogram is active *@
                        @if (_viewNotSavedReason is not null)
                        {
                            <span class="small text-secondary" title="Only the owner of a recording can save how it is set up">@_viewNotSavedReason</span>
                        }
                        @if (_spectrogramEnabled)
                        {
                            <BenSelect Class="form-select-sm" Data="@_resolutionOptions" Value="@_spectrogramFftSamples" ValueChanged="@((int v) => _ = OnSpectrogramResolutionChangedAsync(v))" TextField="@nameof(SpectrogramResolutionOption.Label)" ValueField="@nameof(SpectrogramResolutionOption.Value)" Width="155px" Enabled="@_modalReady" />
                            @* Colormap selector *@
                            <BenSelect Class="form-select-sm" Data="@_colormapOptions" @bind-Value="_colormap" TextField="@nameof(ColormapOption.Label)" ValueField="@nameof(ColormapOption.Value)" Width="115px" Enabled="@_modalReady" OnChange="@((string? value) => { _ = OnColormapChangedAsync(); })" />
                            @* Mel-scale toggle *@
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleMelScaleAsync" disabled="@(!(_modalReady))">
                                🎵 Mel Scale
                            </button>
                            @* Voice frequency band overlay *@
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleVoiceBandAsync" disabled="@(!(_modalReady))">
                                🗣 Voice Band
                            </button>
                        }
                        @* Drag mode toggle: create region (default) vs. scrub the playhead *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleDragModeAsync" disabled="@(!(_modalReady))" title="@(_regionDrawMode ? "Create Region" : "Scrub Playhead")"><BenIcon Name="crop" />
                        </button>
                        @* EQ toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showEq = !_showEq)" disabled="@(!(_modalReady))">
                            🎚 @(_showEq ? "Hide EQ" : "EQ / Filters")
                        </button>
                        @* EVP Markers toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showMarkers = !_showMarkers)" disabled="@(!(_modalReady))">
                            @* Counts confirmed findings only — dismissed candidates are kept solely
                               for re-scan deduping, and counting them would inflate this. *@
                            🎯 @(_showMarkers ? "Hide Markers" : $"EVP Markers ({ConfirmedMarkers.Count()})")
                        </button>
                        @* Destructive edit toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showEdit = !_showEdit)" disabled="@(!(_modalReady))">
                            ✂ @(_showEdit ? "Hide Edit" : "Edit")
                        </button>
                        @* Silence detection toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleSilenceDetectionAsync" disabled="@(!(_modalReady))">
                            🤫 Silence
                        </button>
                        @if (_silenceDetectionEnabled)
                        {
                            <input type="number" class="form-control" min="-80" max="-10" step="1" style="max-width:90px;" @bind="_silenceThresholdDb" @bind:event="oninput" @onchange="@(() => _ = ApplySilenceDetectionAsync())" />
                            <span class="small text-secondary">dB</span>
                        }
                        <span class="small text-secondary fst-italic">
                            @(_regionDrawMode
                                ? "Click & drag to mark a region — right-click to play, save, or edit"
                                : "Click & drag the waveform to scrub — audio plays while dragging")
                        </span>
                    </span>
                </div>

                @* EQ / Processing panel *@
                @if (_showEq && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex gap-3 flex-wrap">

                            @* 10-band EQ — horizontal sliders *@
                            <div class="flex-grow-1" style="min-width:320px;">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <strong class="small">Graphic EQ</strong>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetEqAsync">Reset</button>
                                </div>
                                @{ var bands = new[] { (0, "32"), (1, "64"), (2, "125"), (3, "250"), (4, "500"), (5, "1k"), (6, "2k"), (7, "4k"), (8, "8k"), (9, "16k") }; }
                                @foreach (var (idx, lbl) in bands)
                                {
                                    var b = idx;
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="text-muted" style="width:28px; text-align:right; font-size:0.7rem;">@lbl</span>
                                        <input type="range" class="form-range" min="-12" max="12" step="1" value="@_eqGains[b]" @oninput="@(e => { var v = AsRangeValue(e.Value); _ = OnEqGainChanged(b, v); })" />
                                        <span class="text-muted small" style="width:28px;">@(_eqGains[b] > 0 ? "+" : "")@_eqGains[b].ToString("0.#")</span>
                                    </div>
                                }
                            </div>

                            @* HP / LP filters *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Filters</strong>
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" @bind="_hpEnabled" @bind:after="ApplyHighPassAsync" />
                                    <span class="small">High-pass @_hpFreq Hz</span>
                                </div>
                                <input type="range" class="form-range" min="20" max="500" step="10" @bind="_hpFreq" @bind:event="oninput" @onchange="@(()=>_ = ApplyHighPassAsync())" />
                                <div class="d-flex align-items-center gap-1 mt-2">
                                    <input type="checkbox" class="form-check-input" @bind="_lpEnabled" @bind:after="ApplyLowPassAsync" />
                                    <span class="small">Low-pass @_lpFreq Hz</span>
                                </div>
                                <input type="range" class="form-range" min="1000" max="20000" step="500" @bind="_lpFreq" @bind:event="oninput" @onchange="@(()=>_ = ApplyLowPassAsync())" />
                            </div>

                            @* Compressor *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" @bind="_compEnabled" @bind:after="ApplyCompressorAsync" />
                                    <strong class="small">Compressor</strong>
                                </div>
                                <span class="small text-muted">Threshold @_compThreshold dB</span>
                                <input type="range" class="form-range" min="-60" max="0" step="1" @bind="_compThreshold" @bind:event="oninput" @onchange="@(()=>_ = ApplyCompressorAsync())" />
                                <span class="small text-muted">Ratio @(_compRatio):1</span>
                                <input type="range" class="form-range" min="1" max="20" step="1" @bind="_compRatio" @bind:event="oninput" @onchange="@(()=>_ = ApplyCompressorAsync())" />
                            </div>

                            @* Noise Gate *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" @bind="_noiseGateEnabled" @bind:after="ApplyNoiseGateAsync" />
                                    <strong class="small">Noise Gate</strong>
                                </div>
                                <span class="small text-muted">Threshold @_noiseGateThreshold dB</span>
                                <input type="range" class="form-range" min="-80" max="0" step="1" @bind="_noiseGateThreshold" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Attack @_noiseGateAttack s</span>
                                <input type="range" class="form-range" min="0.001" max="0.5" step="0.01" @bind="_noiseGateAttack" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Release @_noiseGateRelease s</span>
                                <input type="range" class="form-range" min="0.01" max="1" step="0.05" @bind="_noiseGateRelease" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                            </div>
                        </div>
                    </div>
                }

                @* EVP Markers panel *@
                @if (_showMarkers && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" id="evp-markers-panel" style="font-size:0.8rem;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <strong class="small">EVP Markers</strong>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="AddMarkerAtCurrentTimeAsync">
                                ➕ Add Marker at @FormatTime(_modalTime)
                            </button>
                        </div>
                        @if (_markersError is not null)
                        {
                            @* The transport itself failed, which BenListState never sees. *@
                            <div class="alert alert-warning py-1 px-2 small mb-2">@_markersError</div>
                        }
                        else if (_markersResult.Failed)
                        {
                            @* Markers are somebody's analysis of a recording. "No markers yet"
                               over a refusal says the file was reviewed and found empty. *@
                            <BenListState TItem="AudioMarkerRecord" Result="@_markersResult" />
                        }
                        else if (!ConfirmedMarkers.Any())
                        {
                            <div class="text-secondary small fst-italic">No markers yet — play the file and drop a marker where you hear something.</div>
                        }
                        else
                        {
                            @foreach (var marker in ConfirmedMarkers)
                            {
                                var m = marker;
                                <div class="d-flex align-items-center gap-2 mb-1 p-1 rounded" style="background:var(--kendo-color-surface,#f5f5f5);">
                                    <span class="badge" style="background:@MarkerColor(m);">@FormatMarkerRange(m)</span>
                                    <span class="fw-semibold">@m.Label</span>
                                    <span class="text-secondary small">@m.ConfidenceLevel</span>
                                    @if (m.IsAutoDetected && m.DetectionScore is { } confirmedScore)
                                    {
                                        <span class="badge bg-secondary" title="Signal score from the detector that first proposed this">@confirmedScore.ToString("0")</span>
                                    }
                                    @if (m.LinkedClipUploadFileId is not null)
                                    {
                                        <span class="badge bg-success" title="A clip has been cut from this marker">🎧 clip</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.Note))
                                    {
                                        <span class="text-secondary small text-truncate" style="max-width:200px;" title="@m.Note">@m.Note</span>
                                    }
                                    <span class="ms-auto d-flex gap-1">
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => PlayMarkerAsync(m))" title="Play this marker"><BenIcon Name="play" /></button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenClipFromMarkerDialog(m))" title="@(m.LinkedClipUploadFileId is null
                                                                 ? "Save this as its own audio file"
                                                                 : "Save another clip from this marker")"><BenIcon Name="crop" /></button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenEditMarkerDialog(m))"><BenIcon Name="edit-2" /></button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => DeleteMarkerAsync(m))"><BenIcon Name="trash-2" /></button>
                                    </span>
                                </div>
                            }
                        }

                        @* ── Detector ────────────────────────────────────────── *@
                        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 flex-wrap">
                            <span class="small fw-semibold">Detect</span>
                            @* Nothing scans on its own — a scan only happens when this is clicked. *@
                            <BenSelect Class="form-select-sm" Data="@_sensitivityOptions" Value="@_scanSensitivity" ValueChanged="@((EvpSensitivity s) => ApplySensitivityPreset(s))" Width="110px" Enabled="@(!_scanning)" />
                            <button type="button" class="btn btn-primary btn-sm" @onclick="RunScanAsync" disabled="@(!(!_scanning))">
                                @(_scanning ? "Scanning…" : "Scan for EVP")
                            </button>
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showScanTuning = !_showScanTuning)">
                                @(_showScanTuning ? "Hide settings" : "Fine-tune")
                            </button>
                            @if (_scanMessage is not null)
                            {
                                <span class="small text-secondary">@_scanMessage</span>
                            }
                        </div>
                        <div class="small text-secondary mt-1">
                            @* Says plainly what the score is, so nobody reads it as "83% likely a voice". *@
                            Finds sounds that rise above the recording's own background noise, in the
                            frequency range speech occupies. Everything it finds needs listening to —
                            the score is how much a sound stood out, not how likely it is to be a voice.
                        </div>

                        @if (_showScanTuning)
                        {
                            @* The preset seeds these; from here they're yours. Every recording is
                               different, and a threshold that suits a quiet bedroom floods the queue
                               in a room with a furnace. *@
                            <div class="mt-2 p-2 rounded border">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="small fw-semibold">Detector settings</span>
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ApplySensitivityPreset(_scanSensitivity))">
                                        Reset to @_scanSensitivity
                                    </button>
                                </div>

                                <div class="mb-2">
                                    <label class="small d-block" for="audiofilepreview-tolerance-how-far-above-0bad">
                                        Tolerance — how far above the background a sound must rise:
                                        <strong>@_scanOptions.ThresholdDb.ToString("0.0") dB</strong>
                                    </label>
                                    <input id="audiofilepreview-tolerance-how-far-above-0bad" type="range" class="form-range"
                                           min="@EvpDetectionOptions.ThresholdRange.Min"
                                           max="@EvpDetectionOptions.ThresholdRange.Max"
                                           step="0.5"
                                           value="@_scanOptions.ThresholdDb"
                                           @oninput="@(e => SetThreshold(e.Value))" />
                                    <div class="d-flex justify-content-between small text-secondary">
                                        <span>lower — finds more, more to review</span>
                                        <span>higher — only the obvious</span>
                                    </div>
                                </div>

                                <div class="d-flex gap-3 flex-wrap">
                                    <label class="small">
                                        Shortest sound (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.MinDurationRange.Min"
                                               max="@EvpDetectionOptions.MinDurationRange.Max"
                                               step="0.05"
                                               value="@_scanOptions.MinDurationSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { MinDurationSeconds = v }))" />
                                    </label>
                                    <label class="small">
                                        Join sounds within (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.MergeGapRange.Min"
                                               max="@EvpDetectionOptions.MergeGapRange.Max"
                                               step="0.05"
                                               value="@_scanOptions.MergeGapSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { MergeGapSeconds = v }))" />
                                    </label>
                                    <label class="small">
                                        Context either side (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.ContextPadRange.Min"
                                               max="@EvpDetectionOptions.ContextPadRange.Max"
                                               step="0.1"
                                               value="@_scanOptions.ContextPadSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { ContextPadSeconds = v }))" />
                                    </label>
                                    <label class="small">
                                        Longest candidate (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.MaxEventRange.Min"
                                               max="@EvpDetectionOptions.MaxEventRange.Max"
                                               step="0.5"
                                               value="@_scanOptions.MaxEventSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { MaxEventSeconds = v }))" />
                                    </label>
                                </div>

                                @if (_scanOptions.Validate() is { } settingsProblem)
                                {
                                    <div class="text-danger small mt-2">@settingsProblem</div>
                                }
                            </div>
                        }

                        @if (PendingCandidates.Any())
                        {
                            <div class="mt-2 pt-2 border-top">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge" style="background:rgba(245,158,11,0.75);">@PendingCandidates.Count()</span>
                                    <strong class="small">
                                        @(PendingCandidates.Count() == 1 ? "candidate" : "candidates") to review
                                    </strong>
                                    <span class="ms-auto d-flex align-items-center gap-1 small text-secondary">
                                        Sort
                                        <button type="button" class="btn @((_candidatesByScore ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Flat) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _candidatesByScore = true)">Score</button>
                                        <button type="button" class="btn @((!_candidatesByScore ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Flat) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _candidatesByScore = false)">Time</button>
                                    </span>
                                </div>

                                <div style="max-height:180px; overflow-y:auto;">
                                    @foreach (var candidate in SortedCandidates)
                                    {
                                        var c = candidate;
                                        var isAdjusting = _adjustingCandidateId == c.Id;
                                        <div class="d-flex align-items-center gap-2 mb-1 p-1 rounded"
                                             style="background:@(isAdjusting ? "rgba(245,158,11,0.18)" : "var(--kendo-color-surface,#f5f5f5)");">
                                            <span class="badge" style="background:rgba(245,158,11,0.75);"
                                                  title="How much this stood out from the background — not a likelihood of speech">
                                                @c.DetectionScore?.ToString("0")
                                            </span>
                                            @if (isAdjusting)
                                            {
                                                @* Live values, not the stored ones — the point is to see
                                                   what you're about to save while dragging. *@
                                                <span class="small fw-semibold">
                                                    @FormatTime(_adjustedStart)–@FormatTime(_adjustedEnd)
                                                    (@((_adjustedEnd - _adjustedStart).ToString("0.0"))s)
                                                </span>
                                                <span class="small text-secondary">
                                                    drag the edges on the waveform, then save
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="small">@FormatMarkerRange(c)</span>
                                            }
                                            <span class="ms-auto d-flex gap-1">
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => PlayCandidateAsync(c))" title="Play this stretch with its surrounding context"><BenIcon Name="play" /></button>
                                                @if (isAdjusting)
                                                {
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAdjustedBoundsAsync">Save bounds</button>
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => StopAdjustingAsync(revert: true))">Cancel</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => StartAdjustingAsync(c))" disabled="@(!(_reviewingCandidateId != c.Id))" title="Adjust where this starts and ends"><BenIcon Name="edit-2" /></button>
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => OpenConfirmCandidateDialog(c))" disabled="@(!(_reviewingCandidateId != c.Id))" title="Keep as an EVP marker"><BenIcon Name="check" /></button>
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => DismissCandidateAsync(c))" disabled="@(!(_reviewingCandidateId != c.Id))" title="Not an EVP — won't be proposed again"><BenIcon Name="x" /></button>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* Destructive edit panel *@
                @if (_showEdit && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        @if (_fileTypesError is not null)
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2">@_fileTypesError</div>
                        }
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Region</strong>
                                <span class="text-muted small" id="edit-region-readout">
                                    @(_regionSelection.Target is not { } sel ? "Draw a region on the waveform first" : $"{FormatTime(sel.Start)}–{FormatTime(sel.End)}")
                                </span>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-cut" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Cut))" disabled="@(!(CanApplyEdit(requiresRegion: true)))">✂ Cut</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-silence" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Silence))" disabled="@(!(CanApplyEdit(requiresRegion: true)))">🔇 Silence</button>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Whole File</strong>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-normalize" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Normalize))" disabled="@(!(CanApplyEdit()))">📶 Normalize</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-reverse" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Reverse))" disabled="@(!(CanApplyEdit()))">⏪ Reverse</button>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Gain @(_editGainDb > 0 ? "+" : "")@_editGainDb dB</strong>
                                <input type="range" class="form-range" min="-24" max="24" step="1" @bind="_editGainDb" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-gain" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Gain))" disabled="@(!(CanApplyEdit()))">Apply Gain</button>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:200px;">
                                <strong class="small">Fade In / Out (seconds)</strong>
                                <div class="d-flex gap-1">
                                    <input type="number" class="form-control" min="0" max="100" step="1" style="max-width:80px;" @bind="_editFadeIn" @bind:event="oninput" />
                                    <input type="number" class="form-control" min="0" max="100" step="1" style="max-width:80px;" @bind="_editFadeOut" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-fade" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Fade))" disabled="@(!(CanApplyEdit()))">Apply Fade</button>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Speed @_editSpeedRatio.ToString("0.0#")×</strong>
                                <input type="range" class="form-range" min="0.25" max="4" step="0.05" @bind="_editSpeedRatio" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-speed" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Speed))" disabled="@(!(CanApplyEdit()))">Apply Speed</button>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Pitch @(_editPitchSemitones > 0 ? "+" : "")@_editPitchSemitones st</strong>
                                <input type="range" class="form-range" min="-12" max="12" step="1" @bind="_editPitchSemitones" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-pitch" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Pitch))" disabled="@(!(CanApplyEdit()))">Apply Pitch</button>
                            </div>
                        </div>
                        @if (_editError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-1 small">@_editError</div>
                        }
                    </div>
                }

                @* Full WaveSurfer player *@
                <div class="flex-shrink-0" id="modal-player-pane">
                    <WaveSurferPlayer @ref="_modalPlayer"
                                      Config="@_fullConfig"
                                      Resizable="true"
                                      OnReady="@OnModalReadyAsync"
                                      OnTimeUpdate="@(t => { _modalTime = t; StateHasChanged(); })"
                                      OnFinish="@(() => { _modalTime = 0; StateHasChanged(); })"
                                      OnRegionContextMenu="@OnRegionRightClick"
                                      OnRegionCreated="@OnModalRegionCreated"
                                      OnRegionUpdated="@OnModalRegionUpdated"
                                      OnRegionRemoved="@OnModalRegionRemoved"
                                      OnSpectrogramReady="@(() => StateHasChanged())"
                                      OnSpectrogramContextMenu="@OnSpectrogramContextMenuFired" />
                </div>

                @* Child clips section *@
                @if (_childClipsError is not null)
                {
                    @* An empty history of a recording somebody has already worked on is a lie the
                       panel used to tell whenever this list failed to load (finding O). *@
                    <div class="alert alert-warning py-1 px-2 small mt-3 mb-0">@_childClipsError</div>
                }
                else if (_childClips.Any())
                {
                    <div class="mt-3 flex-shrink-0" style="overflow-y:auto;max-height:40vh;">
                        <h6 class="mb-2 text-secondary small fw-semibold text-uppercase letter-spacing-1">
                            Saved Clips (@_childClips.Count)
                        </h6>
                        @foreach (var clip in _childClips)
                        {
                            <div class="mb-2 p-2 rounded"
                                 style="background:var(--kendo-color-surface,#f5f5f5);">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-success bg-opacity-75 small">
                                        @FormatTime(clip.RegionStart ?? 0)–@FormatTime(clip.RegionEnd ?? 0)
                                    </span>
                                    <span class="small fw-semibold">
                                        @(string.IsNullOrWhiteSpace(clip.Description) ? clip.FileName : clip.Description)
                                    </span>
                                    <span class="small text-secondary ms-auto">
                                        @FormatSize(clip.FileSize)
                                    </span>
                                </div>
                                @* Why this stretch was worth saving. Written in the region explorer,
                                   and until now visible only there (finding M). *@
                                @foreach (var note in NotesForClip(clip))
                                {
                                    <div class="small text-secondary border-start ps-2 mb-1"
                                         style="border-width:3px !important;">
                                        @((MarkupString)note.NoteHtml)
                                    </div>
                                }
                                <AudioFilePreview FileId="@clip.Id"
                                                  FileName="@clip.FileName"
                                                  ContentType="@clip.ContentType"
                                                  FileSize="@clip.FileSize" />
                            </div>
                        }
                    </div>
                }

            </div>
        }
    </ChildContent>
</BenModal>

@* ── Spectrogram context menu (right-click on spectrogram canvas) ───── *@
<BenContextMenu @ref="_spectrogramMenu"
                    Data="@_spectrogramMenuItems"
                    TextField="@nameof(SpectrogramMenuItem.Text)"
                    OnClick="@(async (SpectrogramMenuItem item) => await OnSpectrogramMenuClickAsync(item))">
</BenContextMenu>

@* ── Region context menu (right-click in full-view player) ───────────── *@
<BenContextMenu @ref="_regionMenu"
                    Data="@_regionMenuItems"
                    TextField="@nameof(RegionContextMenuItem.Text)"
                    OnClick="@(async (RegionContextMenuItem item) => await OnRegionMenuClickAsync(item))">
</BenContextMenu>

@* ── Region Explorer — playback + save-as-clip + notes for a drawn region ── *@
@if (_explorerRegion is not null)
{
    <WsRegionExplorer FileId="@FileId"
                      FileName="@FileName"
                      ContentType="@ContentType"
                      FileSize="@FileSize"
                      Region="@_explorerRegion"
                      @bind-Visible="@_showRegionExplorer"
                      OnClipSaved="@(async _ => await OverlayChildClipRegionsAsync())" />
}

@* ── Region label edit dialog ────────────────────────────────── *@
<BenModal @bind-Visible="@_showEditLabelDialog" Title="Edit Region Label" Size="sm">
    <ChildContent>
        <label class="form-label fw-semibold" for="audiofilepreview-label-10d4">Label</label>
        <input id="audiofilepreview-label-10d4" type="text" class="form-control" @bind="@_editLabelText" @bind:event="oninput" />
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showEditLabelDialog = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveRegionLabelAsync">Save</button>
        </div>
    </ChildContent>
</BenModal>

@* ── EVP marker add/edit dialog ─────────────────────────────────────── *@
<BenModal @bind-Visible="@_showMarkerDialog" Title="@(_editingMarker is null ? "Add EVP Marker" : "Edit EVP Marker")">
    <ChildContent>
        <div class="mb-2">
            <label class="form-label fw-semibold">Time</label>
            <div>
                @FormatTime(_markerTimeSeconds)
                @if (_markerIsSpan)
                {
                    <text> – @FormatTime(_markerEndSeconds) <span class="text-secondary">(@((_markerEndSeconds - _markerTimeSeconds).ToString("0.0"))s)</span></text>
                }
            </div>
            <label class="d-flex align-items-center gap-2 mt-1 small" for="audiofilepreview-togglemarkerspan-bool-e-value-dc5d">
                <input type="checkbox" checked="@_markerIsSpan"
                       @onchange="@(e => ToggleMarkerSpan((bool?)e.Value ?? false))" />
                Mark a stretch of audio rather than an instant
            </label>
            @if (_markerIsSpan)
            {
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="small text-secondary">Ends at</span>
                    <input id="audiofilepreview-togglemarkerspan-bool-e-value-dc5d" type="number" class="form-control" min="0" max="100" step="0.1" style="max-width:110px;" @bind="@_markerEndSeconds" @bind:event="oninput" />
                    <span class="small text-secondary">s</span>
                </div>
            }
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold" for="audiofilepreview-label-2807">Label</label>
            <input id="audiofilepreview-label-2807" type="text" class="form-control" placeholder="e.g. Whispered name?" @bind="@_markerLabel" @bind:event="oninput" />
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold">Confidence</label>
            <BenSelect Class="form-select-sm" Data="@_confidenceOptions" @bind-Value="_markerConfidence" Width="100%" />
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold" for="audiofilepreview-note-79d2">Note</label>
            <textarea id="audiofilepreview-note-79d2" class="form-control" rows="3" @bind="@_markerNote"></textarea>
        </div>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showMarkerDialog = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveMarkerAsync" disabled="@(!(!string.IsNullOrWhiteSpace(_markerLabel)))">Save</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Confirm a detected candidate ────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showConfirmCandidateDialog" Title="Keep this as an EVP">
    <ChildContent>
        @if (_confirmingCandidate is { } cc)
        {
            <div class="mb-2 small text-secondary">
                @FormatMarkerRange(cc)
                · detector score @cc.DetectionScore?.ToString("0")
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold" for="audiofilepreview-what-did-you-hear-83cf">What did you hear?</label>
                @* A plain input bound on oninput, not a TelerikTextBox. Telerik's textbox only
                   pushes its value on change/blur, which deadlocked this dialog: the Keep button
                   is gated on the label, so the only thing left to click was disabled, focus never
                   left the field, and the label never bound. *@
                <input id="audiofilepreview-what-did-you-hear-83cf" type="text" class="form-control form-control-sm"
                       placeholder="e.g. Whispered name?"
                       value="@_confirmLabel"
                       @oninput="@(e => _confirmLabel = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold">Confidence</label>
                <BenSelect Class="form-select-sm" Data="@_confidenceOptions" @bind-Value="_confirmConfidence" Width="100%" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold" for="audiofilepreview-note-795d">Note</label>
                <textarea id="audiofilepreview-note-795d" class="form-control" rows="2" @bind="@_confirmNote"></textarea>
            </div>
            @if (_confirmError is not null)
            {
                <div class="text-danger small">@_confirmError</div>
            }
            <div class="small text-secondary">
                The detector's score and bounds are kept alongside your label.
            </div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showConfirmCandidateDialog = false)">Cancel</button>
            @* Deliberately always enabled. Gating this on the label deadlocked the dialog: the field
               only pushed its value on blur, and the one thing left to click was the disabled button,
               so focus never left and the label never bound. Validation lives in the handler instead. *@
            <button type="button" class="btn btn-primary" @onclick="ConfirmCandidateAsync">Keep it</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Save region as clip dialog ──────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showSaveClipDialog" Title="Create Audio File from Region">
    <ChildContent>
        @if (_clipSourceMarker is { } clipMarker)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@clipMarker.Label</strong>
                (@FormatMarkerRange(clipMarker)) from <em>@FileName</em>.
                With padding: <strong>@FormatTime(ClipStart) &ndash; @FormatTime(ClipEnd)</strong>.
                Output will be saved as WAV.
            </p>
        }
        else if (_newUserRegion is not null)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@FormatTime(ClipStart)</strong>
                &ndash; <strong>@FormatTime(ClipEnd)</strong>
                from <em>@FileName</em>. Output will be saved as WAV.
            </p>
        }
        <div class="row g-3">
            <div class="col-12 d-flex gap-3 flex-wrap align-items-end">
                <label class="small mb-0">
                    Lead-in (s)
                    @* Extra room either side of the marked sound. A clip trimmed exactly to the
                       words is hard to judge — you want a moment of the room before and after. *@
                    <input type="number" class="form-control form-control-sm" style="width:90px;"
                           min="0" max="10" step="0.1" value="@_clipPrePad"
                           @oninput="@(e => SetOption(e.Value, v => _clipPrePad = Math.Clamp(v, 0, 10)))" />
                </label>
                <label class="small mb-0">
                    Tail (s)
                    <input type="number" class="form-control form-control-sm" style="width:90px;"
                           min="0" max="10" step="0.1" value="@_clipPostPad"
                           @oninput="@(e => SetOption(e.Value, v => _clipPostPad = Math.Clamp(v, 0, 10)))" />
                </label>
                <label class="small mb-0 d-flex align-items-center gap-2">
                    <input type="checkbox" checked="@_clipNormalize"
                           @onchange="@(e => _clipNormalize = (bool?)e.Value ?? false)" />
                    Boost volume (normalize)
                </label>
            </div>
            <div class="col-12">
                <div class="small text-secondary">
                    Normalizing raises the clip's loudest point to just under maximum. An EVP is
                    usually far quieter than the rest of the recording, so without it the clip can be
                    almost inaudible. The original is never modified — a clip can always be re-cut.
                </div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="audiofilepreview-label-description-7e59">Label / Description</label>
                <input id="audiofilepreview-label-description-7e59" type="text" class="form-control" placeholder="Optional — auto-generated if blank" @bind="@_saveClipLabel" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">File Type <span class="text-danger">*</span></label>
                <BenSelect Class="form-select-sm" Data="@_fileTypes" @bind-Value="@_saveClipTypeId" TextField="@nameof(UploadFileTypeRecord.Name)" ValueField="@nameof(UploadFileTypeRecord.Id)" DefaultText="— select —" Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="clip-pub-afp" @bind="@_saveClipIsPublic" />
                <label for="clip-pub-afp" class="form-label mb-0">Public</label>
            </div>
        </div>
        @if (_saveClipError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0 py-2 small">@_saveClipError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => { _showSaveClipDialog = false; _saveClipError = null; })">
                Cancel
            </button>
            <button type="button" class="btn btn-primary" @onclick="SaveClipAsync" disabled="@(!(!_isSavingClip && _saveClipTypeId != Guid.Empty))"><BenIcon Name="save" Class="me-1" />
                @(_isSavingClip ? "Saving…" : "Save as WAV")
            </button>
            @* Nothing else in this dialog is gated on the file type, so a missing type reads as a dead
               button. Say why. *@
            @if (_saveClipTypeId == Guid.Empty)
            {
                <span class="small text-secondary ms-2">Pick a file type first.</span>
            }
        </div>
    </ChildContent>
</BenModal>
@* ── Toast notifications ────────────────────────────────────────────── *@

@code {

    /// <summary>
    /// Reads a range input's value. The DOM hands back a string; the handlers these replaced took
    /// a number, so parse once here rather than at each call site. A half-typed or empty value
    /// falls back to 0 instead of throwing.
    /// </summary>
    private static int AsRangeValue(object? raw)
        => int.TryParse(raw?.ToString(), System.Globalization.NumberStyles.Integer,
                        System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    // ── Parameters ────────────────────────────────────────────────────────────

    [Parameter, EditorRequired] public Guid   FileId      { get; set; }
    [Parameter, EditorRequired] public string FileName    { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ContentType { get; set; } = string.Empty;
    [Parameter]                 public long   FileSize    { get; set; }

    /// <summary>Reports whether the waveform actually appeared, so a caller can say so.</summary>
    /// <remarks>
    /// Same reason as <c>UserMediaPreview</c>: this used to catch its own failure and render a
    /// filename badge, which is indistinguishable from a file that simply has nothing to draw.
    /// </remarks>
    [Parameter] public EventCallback<Ben.Web.Website.Library.User.MediaPreviewOutcome> OnOutcome { get; set; }

    /// <summary>
    /// A URL WaveSurfer can stream from, instead of this component fetching the bytes.
    /// </summary>
    /// <remarks>
    /// <para><b>Set this anywhere more than one player exists on a page.</b> Fetching bytes puts
    /// a copy of the recording in the SERVER's memory and then a base64 copy in the page — about
    /// 2.3× the file, per player, per render. A media library of recordings did exactly that and
    /// took the website process to sixteen gigabytes before the host was killed.</para>
    ///
    /// <para>With a URL the browser does the fetching, streams as it plays, and caches. The
    /// server holds nothing.</para>
    /// </remarks>
    [Parameter] public string? SourceUrl { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private WsAudioSource? _source;
    private bool   _loading = true;
    private bool   _ready;
    private bool   _playing;
    private double _currentTime;
    private double _modalTime;
    private double _modalDuration;
    private bool   _showModal;
    private bool   _modalReady;
    private IReadOnlyList<UploadFileRecord> _childClips = [];

    /// <summary>true = drag creates a region (default); false = drag scrubs the playhead.</summary>
    private bool   _regionDrawMode = true;

    // ── Timeline + Spectrogram state ───────────────────────────────────

    private bool   _timelineEnabled  = true;
    private bool   _spectrogramEnabled;
    private bool   _spectrogramLabels = true;   // show frequency labels by default
    private int    _spectrogramFftSamples = 512;
    private BenContextMenu<SpectrogramMenuItem>? _spectrogramMenu;

    private static readonly List<SpectrogramMenuItem> _spectrogramMenuItems =
    [
        new("labels", "🔤  Toggle Labels"),
    ];

    private record SpectrogramResolutionOption(int Value, string Label);
    private static readonly List<SpectrogramResolutionOption> _resolutionOptions =
    [
        new(128,  "128 – Coarse"),
        new(256,  "256 – Low"),
        new(512,  "512 – Standard"),
        new(1024, "1024 – High"),
        new(2048, "2048 – Fine"),
        new(4096, "4096 – Ultra"),
    ];

    // ── Region creation workflow ──────────────────────────────────────────────

    /// <summary>IDs of regions added programmatically (overlays, focus regions) — not user-drawn.</summary>
    private readonly HashSet<string> _programmaticRegionIds = [];

    /// <summary>Region currently being acted on (set from right-click args when saving/clipping).</summary>
    private WsRegionData? _newUserRegion;

    private bool   _showSaveClipDialog;      // save-as-clip form

    // ── Clipping an EVP marker (phase E4) ─────────────────────────────────────

    /// <summary>Set when the clip dialog was opened from a marker rather than a drawn region.</summary>
    private AudioMarkerRecord? _clipSourceMarker;
    private double _clipPrePad  = 1.0;
    private double _clipPostPad = 1.0;
    /// <summary>On by default — the usual reason to clip an EVP is to be able to hear it.</summary>
    private bool   _clipNormalize = AudioClipDefaults.Normalize;

    /// <summary>Where the clip actually starts once padding is applied, never before the file does.</summary>
    private double ClipStart => Math.Max(0, ClipSourceStart - _clipPrePad);

    /// <summary>Where it ends, clamped to the recording so the request can't run past the audio.</summary>
    private double ClipEnd =>
        _modalDuration > 0
            ? Math.Min(_modalDuration, ClipSourceEnd + _clipPostPad)
            : ClipSourceEnd + _clipPostPad;

    private double ClipSourceStart =>
        _clipSourceMarker?.TimeSeconds ?? _newUserRegion?.Start ?? 0;

    private double ClipSourceEnd =>
        _clipSourceMarker is { } m
            ? (m.EndSeconds ?? m.TimeSeconds)
            : _newUserRegion?.End ?? 0;

