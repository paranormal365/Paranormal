@*
  AudioFilePreview.razor
  ──────────────────────
  Compact waveform player used in the Files tab of AdminUserDetail.

  • Fetches audio bytes on first render and shows an 80 px WaveSurfer waveform.
  • Shows a ▶ overlay when paused; clicking anywhere on the waveform toggles play/pause.
  • Right-clicking shows a TelerikContextMenu: Play, Pause, Rewind, Open Full View.
  • "Open Full View" opens a TelerikWindow with file info + full-featured WaveSurfer
    (Timeline, Hover, Zoom, Spectrogram, Regions, built-in controls).
*@

@namespace Ben.Web.Website.Library.Manage.Audio
@inject IBenAdminClient AdminClient
@inject BenToastService Toasts
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@if (_loading)
{
    <div style="height:80px;display:flex;align-items:center;justify-content:center;">
        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
    </div>
}
else if (_source is null)
{
    <span class="badge bg-secondary text-truncate" style="max-width:120px;" title="@FileName">@FileName</span>
}
else
{
    @* ── Compact waveform — click to play/pause, right-click for menu ── *@
    <div id="@_wrapperId"
         style="position:relative;cursor:pointer;border-radius:4px;overflow:hidden;"
         @onclick="TogglePlayAsync"
         @oncontextmenu="ShowContextMenuAsync"
         @oncontextmenu:preventDefault="true"
         title="@(!_playing ? "Click to play" : "Click to pause")">

        @* Play icon overlay — shown when paused and waveform is ready *@
        @if (!_playing && _ready)
        {
            <div style="position:absolute;inset:0;display:flex;align-items:center;
                        justify-content:center;z-index:2;pointer-events:none;
                        background:rgba(0,0,0,.18);border-radius:4px;">
                <span style="font-size:1.6rem;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.7);">▶</span>
            </div>
        }

        <WaveSurferPlayer @ref="_player"
                          Config="@_compactConfig"
                          OnReady="@(() => { _ready = true; StateHasChanged(); })"
                          OnPlay="@(() => { _playing = true; StateHasChanged(); })"
                          OnPause="@(() => { _playing = false; StateHasChanged(); })"
                          OnFinish="@(() => { _playing = false; StateHasChanged(); })"
                          OnTimeUpdate="@(t => _currentTime = t)" />
    </div>
}

@* ── Context menu ────────────────────────────────────────────────────────── *@
<BenContextMenu @ref="_contextMenu"
                    Data="@_menuItems"
                    TextField="@nameof(AudioContextMenuItem.Text)"
                    OnClick="@(async (AudioContextMenuItem item) => await OnMenuClickAsync(item))">
</BenContextMenu>

@* ── Full-view window ────────────────────────────────────────────────────── *@
<BenModal Visible="@_showModal" Title="@FileName" Size="sm">
    <ChildContent>
        @if (_showModal && _source is not null)
        {
            <div class="d-flex flex-column h-100" style="overflow:hidden;">

                @* Info bar *@
                <div class="d-flex flex-wrap gap-4 mb-2 p-2 rounded flex-shrink-0"
                     style="background:var(--kendo-color-surface,#f5f5f5);font-size:.875rem;">
                    <span><strong>Size:</strong>@(" ")@FormatSize(FileSize)</span>
                    <span><strong>Type:</strong>@(" ")@ContentType</span>
                    <span><strong>Duration:</strong>@(" ")@FormatTime(_modalDuration)</span>
                    <span><strong>Position:</strong>@(" ")@FormatTime(_modalTime)</span>
                    <span class="ms-auto d-flex align-items-center gap-2">
                        @* Timeline toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleTimelineAsync" disabled="@(!(_modalReady))">
                            🕐 @(_timelineEnabled ? "Hide Timeline" : "Show Timeline")
                        </button>
                        @* Clear user-drawn regions *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ClearUserRegionsAsync" disabled="@(!(_modalReady))">
                            🗑 Clear Regions
                        </button>
                        @* Spectrogram toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleSpectrogramAsync" disabled="@(!(_modalReady))">
                            📊 @(_spectrogramEnabled ? "Hide Spectrogram" : "Show Spectrogram")
                        </button>
                        @* Spectrogram resolution — only shown when spectrogram is active *@
                        @if (_spectrogramEnabled)
                        {
                            <BenSelect Class="form-select-sm" Data="@_resolutionOptions" Value="@_spectrogramFftSamples" ValueChanged="@((int v) => _ = OnSpectrogramResolutionChangedAsync(v))" TextField="@nameof(SpectrogramResolutionOption.Label)" ValueField="@nameof(SpectrogramResolutionOption.Value)" Width="155px" Enabled="@_modalReady" />
                            @* Colormap selector *@
                            <BenSelect Class="form-select-sm" Data="@_colormapOptions" @bind-Value="_colormap" TextField="Label" ValueField="Value" Width="115px" Enabled="@_modalReady" OnChange="@((string? value) => { _ = OnColormapChangedAsync(); })" />
                            @* Mel-scale toggle *@
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleMelScaleAsync" disabled="@(!(_modalReady))">
                                🎵 Mel Scale
                            </button>
                            @* Voice frequency band overlay *@
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleVoiceBandAsync" disabled="@(!(_modalReady))">
                                🗣 Voice Band
                            </button>
                        }
                        @* Drag mode toggle: create region (default) vs. scrub the playhead *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleDragModeAsync" disabled="@(!(_modalReady))" title="@(_regionDrawMode ? "Create Region" : "Scrub Playhead")"><BenIcon Name="crop" />
                        </button>
                        @* EQ toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showEq = !_showEq)" disabled="@(!(_modalReady))">
                            🎚 @(_showEq ? "Hide EQ" : "EQ / Filters")
                        </button>
                        @* EVP Markers toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showMarkers = !_showMarkers)" disabled="@(!(_modalReady))">
                            @* Counts confirmed findings only — dismissed candidates are kept solely
                               for re-scan deduping, and counting them would inflate this. *@
                            🎯 @(_showMarkers ? "Hide Markers" : $"EVP Markers ({ConfirmedMarkers.Count()})")
                        </button>
                        @* Destructive edit toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showEdit = !_showEdit)" disabled="@(!(_modalReady))">
                            ✂ @(_showEdit ? "Hide Edit" : "Edit")
                        </button>
                        @* Silence detection toggle *@
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="ToggleSilenceDetectionAsync" disabled="@(!(_modalReady))">
                            🤫 Silence
                        </button>
                        @if (_silenceDetectionEnabled)
                        {
                            <input type="number" class="form-control" min="-80" max="-10" step="1" style="max-width:90px;" @bind="_silenceThresholdDb" @bind:event="oninput" @onchange="@(() => _ = ApplySilenceDetectionAsync())" />
                            <span class="small text-secondary">dB</span>
                        }
                        <span class="small text-secondary fst-italic">
                            @(_regionDrawMode
                                ? "Click & drag to mark a region — right-click to play, save, or edit"
                                : "Click & drag the waveform to scrub — audio plays while dragging")
                        </span>
                    </span>
                </div>

                @* EQ / Processing panel *@
                @if (_showEq && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex gap-3 flex-wrap">

                            @* 10-band EQ — horizontal sliders *@
                            <div class="flex-grow-1" style="min-width:320px;">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <strong class="small">Graphic EQ</strong>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetEqAsync">Reset</button>
                                </div>
                                @{ var bands = new[] { (0, "32"), (1, "64"), (2, "125"), (3, "250"), (4, "500"), (5, "1k"), (6, "2k"), (7, "4k"), (8, "8k"), (9, "16k") }; }
                                @foreach (var (idx, lbl) in bands)
                                {
                                    var b = idx;
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="text-muted" style="width:28px; text-align:right; font-size:0.7rem;">@lbl</span>
                                        <input type="range" class="form-range" min="-12" max="12" step="1" value="@_eqGains[b]" @oninput="@(e => { var v = AsRangeValue(e.Value); _ = OnEqGainChanged(b, v); })" />
                                        <span class="text-muted small" style="width:28px;">@(_eqGains[b] > 0 ? "+" : "")@_eqGains[b].ToString("0.#")</span>
                                    </div>
                                }
                            </div>

                            @* HP / LP filters *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Filters</strong>
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" @bind="_hpEnabled" />
                                    <span class="small">High-pass @_hpFreq Hz</span>
                                </div>
                                <input type="range" class="form-range" min="20" max="500" step="10" @bind="_hpFreq" @bind:event="oninput" @onchange="@(()=>_ = ApplyHighPassAsync())" />
                                <div class="d-flex align-items-center gap-1 mt-2">
                                    <input type="checkbox" class="form-check-input" @bind="_lpEnabled" />
                                    <span class="small">Low-pass @_lpFreq Hz</span>
                                </div>
                                <input type="range" class="form-range" min="1000" max="20000" step="500" @bind="_lpFreq" @bind:event="oninput" @onchange="@(()=>_ = ApplyLowPassAsync())" />
                            </div>

                            @* Compressor *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" @bind="_compEnabled" />
                                    <strong class="small">Compressor</strong>
                                </div>
                                <span class="small text-muted">Threshold @_compThreshold dB</span>
                                <input type="range" class="form-range" min="-60" max="0" step="1" @bind="_compThreshold" @bind:event="oninput" @onchange="@(()=>_ = ApplyCompressorAsync())" />
                                <span class="small text-muted">Ratio @(_compRatio):1</span>
                                <input type="range" class="form-range" min="1" max="20" step="1" @bind="_compRatio" @bind:event="oninput" @onchange="@(()=>_ = ApplyCompressorAsync())" />
                            </div>

                            @* Noise Gate *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" @bind="_noiseGateEnabled" />
                                    <strong class="small">Noise Gate</strong>
                                </div>
                                <span class="small text-muted">Threshold @_noiseGateThreshold dB</span>
                                <input type="range" class="form-range" min="-80" max="0" step="1" @bind="_noiseGateThreshold" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Attack @_noiseGateAttack s</span>
                                <input type="range" class="form-range" min="0.001" max="0.5" step="0.01" @bind="_noiseGateAttack" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Release @_noiseGateRelease s</span>
                                <input type="range" class="form-range" min="0.01" max="1" step="0.05" @bind="_noiseGateRelease" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                            </div>
                        </div>
                    </div>
                }

                @* EVP Markers panel *@
                @if (_showMarkers && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <strong class="small">EVP Markers</strong>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="AddMarkerAtCurrentTimeAsync">
                                ➕ Add Marker at @FormatTime(_modalTime)
                            </button>
                        </div>
                        @if (_markersResult.Failed)
                        {
                            @* Markers are somebody's analysis of a recording. "No markers yet"
                               over a refusal says the file was reviewed and found empty. *@
                            <BenListState TItem="AudioMarkerRecord" Result="@_markersResult" />
                        }
                        else if (!ConfirmedMarkers.Any())
                        {
                            <div class="text-secondary small fst-italic">No markers yet — play the file and drop a marker where you hear something.</div>
                        }
                        else
                        {
                            @foreach (var marker in ConfirmedMarkers)
                            {
                                var m = marker;
                                <div class="d-flex align-items-center gap-2 mb-1 p-1 rounded" style="background:var(--kendo-color-surface,#f5f5f5);">
                                    <span class="badge" style="background:@MarkerColor(m);">@FormatMarkerRange(m)</span>
                                    <span class="fw-semibold">@m.Label</span>
                                    <span class="text-secondary small">@m.ConfidenceLevel</span>
                                    @if (m.IsAutoDetected && m.DetectionScore is { } confirmedScore)
                                    {
                                        <span class="badge bg-secondary" title="Signal score from the detector that first proposed this">@confirmedScore.ToString("0")</span>
                                    }
                                    @if (m.LinkedClipUploadFileId is not null)
                                    {
                                        <span class="badge bg-success" title="A clip has been cut from this marker">🎧 clip</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.Note))
                                    {
                                        <span class="text-secondary small text-truncate" style="max-width:200px;" title="@m.Note">@m.Note</span>
                                    }
                                    <span class="ms-auto d-flex gap-1">
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => SeekToMarkerAsync(m))"><BenIcon Name="play" /></button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenClipFromMarkerDialog(m))" title="@(m.LinkedClipUploadFileId is null
                                                                 ? "Save this as its own audio file"
                                                                 : "Save another clip from this marker")"><BenIcon Name="crop" /></button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenEditMarkerDialog(m))"><BenIcon Name="edit-2" /></button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => DeleteMarkerAsync(m))"><BenIcon Name="trash-2" /></button>
                                    </span>
                                </div>
                            }
                        }

                        @* ── Detector ────────────────────────────────────────── *@
                        <div class="mt-2 pt-2 border-top d-flex align-items-center gap-2 flex-wrap">
                            <span class="small fw-semibold">Detect</span>
                            @* Nothing scans on its own — a scan only happens when this is clicked. *@
                            <BenSelect Class="form-select-sm" Data="@_sensitivityOptions" Value="@_scanSensitivity" ValueChanged="@((EvpSensitivity s) => ApplySensitivityPreset(s))" Width="110px" Enabled="@(!_scanning)" />
                            <button type="button" class="btn btn-primary btn-sm" @onclick="RunScanAsync" disabled="@(!(!_scanning))">
                                @(_scanning ? "Scanning…" : "Scan for EVP")
                            </button>
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _showScanTuning = !_showScanTuning)">
                                @(_showScanTuning ? "Hide settings" : "Fine-tune")
                            </button>
                            @if (_scanMessage is not null)
                            {
                                <span class="small text-secondary">@_scanMessage</span>
                            }
                        </div>
                        <div class="small text-secondary mt-1">
                            @* Says plainly what the score is, so nobody reads it as "83% likely a voice". *@
                            Finds sounds that rise above the recording's own background noise, in the
                            frequency range speech occupies. Everything it finds needs listening to —
                            the score is how much a sound stood out, not how likely it is to be a voice.
                        </div>

                        @if (_showScanTuning)
                        {
                            @* The preset seeds these; from here they're yours. Every recording is
                               different, and a threshold that suits a quiet bedroom floods the queue
                               in a room with a furnace. *@
                            <div class="mt-2 p-2 rounded border">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="small fw-semibold">Detector settings</span>
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ApplySensitivityPreset(_scanSensitivity))">
                                        Reset to @_scanSensitivity
                                    </button>
                                </div>

                                <div class="mb-2">
                                    <label class="small d-block" for="audiofilepreview-tolerance-how-far-above-0bad">
                                        Tolerance — how far above the background a sound must rise:
                                        <strong>@_scanOptions.ThresholdDb.ToString("0.0") dB</strong>
                                    </label>
                                    <input id="audiofilepreview-tolerance-how-far-above-0bad" type="range" class="form-range"
                                           min="@EvpDetectionOptions.ThresholdRange.Min"
                                           max="@EvpDetectionOptions.ThresholdRange.Max"
                                           step="0.5"
                                           value="@_scanOptions.ThresholdDb"
                                           @oninput="@(e => SetThreshold(e.Value))" />
                                    <div class="d-flex justify-content-between small text-secondary">
                                        <span>lower — finds more, more to review</span>
                                        <span>higher — only the obvious</span>
                                    </div>
                                </div>

                                <div class="d-flex gap-3 flex-wrap">
                                    <label class="small">
                                        Shortest sound (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.MinDurationRange.Min"
                                               max="@EvpDetectionOptions.MinDurationRange.Max"
                                               step="0.05"
                                               value="@_scanOptions.MinDurationSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { MinDurationSeconds = v }))" />
                                    </label>
                                    <label class="small">
                                        Join sounds within (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.MergeGapRange.Min"
                                               max="@EvpDetectionOptions.MergeGapRange.Max"
                                               step="0.05"
                                               value="@_scanOptions.MergeGapSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { MergeGapSeconds = v }))" />
                                    </label>
                                    <label class="small">
                                        Context either side (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.ContextPadRange.Min"
                                               max="@EvpDetectionOptions.ContextPadRange.Max"
                                               step="0.1"
                                               value="@_scanOptions.ContextPadSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { ContextPadSeconds = v }))" />
                                    </label>
                                    <label class="small">
                                        Longest candidate (s)
                                        <input type="number" class="form-control form-control-sm" style="width:90px;"
                                               min="@EvpDetectionOptions.MaxEventRange.Min"
                                               max="@EvpDetectionOptions.MaxEventRange.Max"
                                               step="0.5"
                                               value="@_scanOptions.MaxEventSeconds"
                                               @oninput="@(e => SetOption(e.Value, v => _scanOptions = _scanOptions with { MaxEventSeconds = v }))" />
                                    </label>
                                </div>

                                @if (_scanOptions.Validate() is { } settingsProblem)
                                {
                                    <div class="text-danger small mt-2">@settingsProblem</div>
                                }
                            </div>
                        }

                        @if (PendingCandidates.Any())
                        {
                            <div class="mt-2 pt-2 border-top">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge" style="background:rgba(245,158,11,0.75);">@PendingCandidates.Count()</span>
                                    <strong class="small">
                                        @(PendingCandidates.Count() == 1 ? "candidate" : "candidates") to review
                                    </strong>
                                    <span class="ms-auto d-flex align-items-center gap-1 small text-secondary">
                                        Sort
                                        <button type="button" class="btn @((_candidatesByScore ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Flat) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _candidatesByScore = true)">Score</button>
                                        <button type="button" class="btn @((!_candidatesByScore ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Flat) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _candidatesByScore = false)">Time</button>
                                    </span>
                                </div>

                                <div style="max-height:180px; overflow-y:auto;">
                                    @foreach (var candidate in SortedCandidates)
                                    {
                                        var c = candidate;
                                        var isAdjusting = _adjustingCandidateId == c.Id;
                                        <div class="d-flex align-items-center gap-2 mb-1 p-1 rounded"
                                             style="background:@(isAdjusting ? "rgba(245,158,11,0.18)" : "var(--kendo-color-surface,#f5f5f5)");">
                                            <span class="badge" style="background:rgba(245,158,11,0.75);"
                                                  title="How much this stood out from the background — not a likelihood of speech">
                                                @c.DetectionScore?.ToString("0")
                                            </span>
                                            @if (isAdjusting)
                                            {
                                                @* Live values, not the stored ones — the point is to see
                                                   what you're about to save while dragging. *@
                                                <span class="small fw-semibold">
                                                    @FormatTime(_adjustedStart)–@FormatTime(_adjustedEnd)
                                                    (@((_adjustedEnd - _adjustedStart).ToString("0.0"))s)
                                                </span>
                                                <span class="small text-secondary">
                                                    drag the edges on the waveform, then save
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="small">@FormatMarkerRange(c)</span>
                                            }
                                            <span class="ms-auto d-flex gap-1">
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => PlayCandidateAsync(c))" title="Play this stretch with its surrounding context"><BenIcon Name="play" /></button>
                                                @if (isAdjusting)
                                                {
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAdjustedBoundsAsync">Save bounds</button>
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => StopAdjustingAsync(revert: true))">Cancel</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => StartAdjustingAsync(c))" disabled="@(!(_reviewingCandidateId != c.Id))" title="Adjust where this starts and ends"><BenIcon Name="edit-2" /></button>
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => OpenConfirmCandidateDialog(c))" disabled="@(!(_reviewingCandidateId != c.Id))" title="Keep as an EVP marker"><BenIcon Name="check" /></button>
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => DismissCandidateAsync(c))" disabled="@(!(_reviewingCandidateId != c.Id))" title="Not an EVP — won't be proposed again"><BenIcon Name="x" /></button>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* Destructive edit panel *@
                @if (_showEdit && _modalReady)
                {
                    <div class="p-2 mb-2 rounded border bg-body-secondary" style="font-size:0.8rem;">
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Region</strong>
                                <span class="text-muted small">
                                    @(_lastDrawnRegion is null ? "Draw a region on the waveform first" : $"{FormatTime(_lastDrawnRegion.Start)}–{FormatTime(_lastDrawnRegion.End)}")
                                </span>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Cut))" disabled="@(!(CanApplyEdit(requiresRegion: true)))">✂ Cut</button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Silence))" disabled="@(!(CanApplyEdit(requiresRegion: true)))">🔇 Silence</button>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Whole File</strong>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Normalize))" disabled="@(!(CanApplyEdit()))">📶 Normalize</button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Reverse))" disabled="@(!(CanApplyEdit()))">⏪ Reverse</button>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Gain @(_editGainDb > 0 ? "+" : "")@_editGainDb dB</strong>
                                <input type="range" class="form-range" min="-24" max="24" step="1" @bind="_editGainDb" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Gain))" disabled="@(!(CanApplyEdit()))">Apply Gain</button>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:200px;">
                                <strong class="small">Fade In / Out (seconds)</strong>
                                <div class="d-flex gap-1">
                                    <input type="number" class="form-control" min="0" max="100" step="1" style="max-width:80px;" @bind="_editFadeIn" @bind:event="oninput" />
                                    <input type="number" class="form-control" min="0" max="100" step="1" style="max-width:80px;" @bind="_editFadeOut" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Fade))" disabled="@(!(CanApplyEdit()))">Apply Fade</button>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Speed @_editSpeedRatio.ToString("0.0#")×</strong>
                                <input type="range" class="form-range" min="0.25" max="4" step="0.05" @bind="_editSpeedRatio" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Speed))" disabled="@(!(CanApplyEdit()))">Apply Speed</button>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Pitch @(_editPitchSemitones > 0 ? "+" : "")@_editPitchSemitones st</strong>
                                <input type="range" class="form-range" min="-12" max="12" step="1" @bind="_editPitchSemitones" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Pitch))" disabled="@(!(CanApplyEdit()))">Apply Pitch</button>
                            </div>
                        </div>
                        @if (_editError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-1 small">@_editError</div>
                        }
                    </div>
                }

                @* Full WaveSurfer player *@
                <div class="flex-shrink-0">
                    <WaveSurferPlayer @ref="_modalPlayer"
                                      Config="@_fullConfig"
                                      Resizable="true"
                                      OnReady="@OnModalReadyAsync"
                                      OnTimeUpdate="@(t => { _modalTime = t; StateHasChanged(); })"
                                      OnFinish="@(() => { _modalTime = 0; StateHasChanged(); })"
                                      OnRegionContextMenu="@OnRegionRightClick"
                                      OnRegionCreated="@OnModalRegionCreated"
                                      OnRegionUpdated="@OnModalRegionUpdated"
                                      OnSpectrogramReady="@(() => StateHasChanged())"
                                      OnSpectrogramContextMenu="@OnSpectrogramContextMenuFired" />
                </div>

                @* Child clips section *@
                @if (_childClips.Any())
                {
                    <div class="mt-3 flex-shrink-0" style="overflow-y:auto;max-height:40vh;">
                        <h6 class="mb-2 text-secondary small fw-semibold text-uppercase letter-spacing-1">
                            Saved Clips (@_childClips.Count)
                        </h6>
                        @foreach (var clip in _childClips)
                        {
                            <div class="mb-2 p-2 rounded"
                                 style="background:var(--kendo-color-surface,#f5f5f5);">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-success bg-opacity-75 small">
                                        @FormatTime(clip.RegionStart ?? 0)–@FormatTime(clip.RegionEnd ?? 0)
                                    </span>
                                    <span class="small fw-semibold">
                                        @(string.IsNullOrWhiteSpace(clip.Description) ? clip.FileName : clip.Description)
                                    </span>
                                    <span class="small text-secondary ms-auto">
                                        @FormatSize(clip.FileSize)
                                    </span>
                                </div>
                                <AudioFilePreview FileId="@clip.Id"
                                                  FileName="@clip.FileName"
                                                  ContentType="@clip.ContentType"
                                                  FileSize="@clip.FileSize" />
                            </div>
                        }
                    </div>
                }

            </div>
        }
    </ChildContent>
</BenModal>

