    private async Task ShowContextMenuAsync(MouseEventArgs e)
    {
        if (_contextMenu is null) return;
        await _contextMenu.ShowAsync(e.ClientX, e.ClientY);
    }

    private async Task OnMenuClickAsync(AudioContextMenuItem item)
    {
        switch (item.Action)
        {
            case "play":
                if (_player is not null) await _player.PlayAsync();
                break;
            case "pause":
                if (_player is not null) await _player.PauseAsync();
                break;
            case "rewind":
                if (_player is not null) await _player.StopAsync();
                _currentTime = 0;
                break;
            case "fullview":
                if (_playing && _player is not null)
                    await _player.PauseAsync();
                _modalTime  = 0;
                _modalDuration = 0;
                _showModal  = true;
                StateHasChanged();
                break;
        }
    }

    // ── Formatting helpers (delegated to AudioFormatUtils) ────────────────────

    private static string FormatTime(double seconds) => AudioFormatUtils.FormatTime(seconds);
    private static string FormatSize(long bytes)      => AudioFormatUtils.FormatSize(bytes);

    // Through BenToastService, the layout-rendered queue that replaced TelerikNotification.
    // The old version showed these on a TelerikNotification field that no markup ever rendered,
    // so every message here — including "Save failed" — went to nobody (item #102).
    private void Notify(string message, string themeColor = "warning")
    {
        switch (themeColor)
        {
            case "success": Toasts.Success(message); break;
            case "error":   Toasts.Error(message);   break;
            default:        Toasts.Warning(message); break;
        }
    }

