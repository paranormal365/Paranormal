    // ── Region right-click (full-view modal player) ───────────────────────────

    private async Task OnRegionRightClick(WsRegionContextMenuArgs args)
    {
        _pendingRegion = args;
        if (_regionMenu is not null)
            await _regionMenu.ShowAsync(args.ClientX, args.ClientY);
    }

    private async Task OnRegionMenuClickAsync(RegionContextMenuItem item)
    {
        if (_pendingRegion is null) return;
        switch (item.Action)
        {
            case "play":
                if (_modalPlayer is not null) await _modalPlayer.PlayRegionAsync(_pendingRegion.RegionId);
                break;
            case "explore":
                _explorerRegion = new WsRegionData
                {
                    Id    = _pendingRegion.RegionId,
                    Start = _pendingRegion.Start,
                    End   = _pendingRegion.End,
                    Label = _pendingRegion.Label,
                };
                _showRegionExplorer = true;
                StateHasChanged();
                break;
            case "label":
                _editLabelText       = _pendingRegion.Label ?? string.Empty;
                _showEditLabelDialog = true;
                break;
            case "save":
                // Use the right-clicked region's current position for clipping
                _newUserRegion = new WsRegionData
                {
                    Id    = _pendingRegion.RegionId,
                    Start = _pendingRegion.Start,
                    End   = _pendingRegion.End,
                    Label = _pendingRegion.Label,
                };
                _showSaveClipDialog = true;
                StateHasChanged();
                break;
            case "delete":
                if (_modalPlayer is not null)
                {
                    await _modalPlayer.RemoveRegionAsync(_pendingRegion.RegionId);
                    if (_newUserRegion?.Id == _pendingRegion.RegionId)
                        _newUserRegion = null;
                    _regionSelection.Removed(_pendingRegion.RegionId);
                }
                break;
        }
    }

    private async Task SaveRegionLabelAsync()
    {
        if (_pendingRegion is null || _modalPlayer is null) return;
        await _modalPlayer.UpdateRegionLabelAsync(_pendingRegion.RegionId, _editLabelText);
        _pendingRegion = new WsRegionContextMenuArgs
        {
            RegionId = _pendingRegion.RegionId,
            Start    = _pendingRegion.Start,
            End      = _pendingRegion.End,
            Label    = _editLabelText,
            ClientX  = _pendingRegion.ClientX,
            ClientY  = _pendingRegion.ClientY,
        };
        _showEditLabelDialog = false;
    }

