    // ── Candidate review ──────────────────────────────────────────────────────

    private CandidateOrder      _candidateOrder = CandidateOrder.StoodOut;

    /// <summary>Hide pending candidates whose voice-like reading is below this (0–100); 0 hides nothing (phase 9b).</summary>
    private int                 _hideBelowVoice;

    /// <summary>The person reviews blind (their profile, phase 11): pending candidates show no readings.</summary>
    private bool                _blindReview;

    /// <summary>Whether this server measures voice-likeness, and why not when it doesn't.</summary>
    private VoiceModelStatusRecord? _voiceStatus;
    private Guid?               _reviewingCandidateId;
    private bool                _showConfirmCandidateDialog;
    private AudioMarkerRecord?  _confirmingCandidate;
    private string              _confirmLabel      = string.Empty;
    private EvpConfidenceLevel  _confirmConfidence = EvpConfidenceLevel.Possible;
    private string              _confirmNote       = string.Empty;
    private string?             _confirmError;

    // Item 253: whether a ruling was made after listening is kept with it, because a Dismiss
    // made without hearing the sound says much less about the sound.
    private bool                _modalPlaying;
    private bool                _showLearningInfo;
    private readonly HashSet<Guid> _heardCandidates = [];

    /// <summary>The longest step between two time updates still taken as playing on, not a jump.</summary>
    private const double MaxPlaybackStepSeconds = 1.0;

    /// <summary>
    /// The playhead moved. A candidate is "heard" once playback runs through its middle.
    /// </summary>
    /// <remarks>
    /// <para>It used to be heard as soon as playback entered its region (WaveSurfer's region-in).
    /// A candidate's region carries 0.4 s of context either side, so two sounds half a second
    /// apart have overlapping regions, and playing the first ran into the second's lead-in: the
    /// second was recorded as heard though its sound never played
    /// (<c>Playing_one_candidate_does_not_mark_its_neighbor_heard</c>, 10/26/2026). WaveSurfer 8
    /// fires region-in about 50 ms early, which would have made that worse.</para>
    ///
    /// <para>The middle of the padded span is where the sound is. Only forward playback counts: a
    /// click or a drag that jumps the playhead past a candidate has not played it. The candidate's
    /// Play button no longer counts on its own either, because stopping a quarter-second in is not
    /// having heard it.</para>
    /// </remarks>
    private void OnModalTimeUpdate(double t)
    {
        var before = _modalTime;
        _modalTime = t;

        if (_modalPlaying && t > before && t - before <= MaxPlaybackStepSeconds)
        {
            foreach (var c in PendingCandidates)
            {
                var middle = (c.TimeSeconds + (c.EndSeconds ?? c.TimeSeconds)) / 2;
                if (before < middle && middle <= t) _heardCandidates.Add(c.Id);
            }
        }
        StateHasChanged();
    }

    /// <summary>
    /// Score order first by default — the strongest signals are the best use of the first few
    /// minutes of review. Playback order is a click away for working straight through a recording.
    /// </summary>
    private IEnumerable<AudioMarkerRecord> SortedCandidates => _blindReview ? PendingCandidates : _candidateOrder switch
    {
        CandidateOrder.StoodOut  => PendingCandidates.OrderByDescending(c => c.DetectionScore ?? 0).ThenBy(c => c.TimeSeconds),
        // Unmeasured last: they have nothing to be ranked by.
        CandidateOrder.VoiceLike => PendingCandidates.OrderByDescending(c => c.VoiceLikelihood ?? -1).ThenBy(c => c.TimeSeconds),
        _                        => PendingCandidates,
    };

    private enum CandidateOrder { StoodOut, VoiceLike, Time }

    private static readonly (CandidateOrder Order, string Label)[] CandidateOrders =
        [(CandidateOrder.StoodOut, "Stood out"), (CandidateOrder.VoiceLike, "Voice-like"), (CandidateOrder.Time, "Time")];

    /// <summary>The sorted list less what the voice-like filter hides. Unmeasured candidates are never hidden.</summary>
    private IEnumerable<AudioMarkerRecord> VisibleCandidates =>
        SortedCandidates.Where(c => !HiddenByVoice(c));

    private bool HiddenByVoice(AudioMarkerRecord c)
        => !_blindReview && HiddenByVoiceSetting(c);

    private bool HiddenByVoiceSetting(AudioMarkerRecord c)
        // Compared as shown: a reading displayed as 50 stays at "hide below 50".
        => _hideBelowVoice > 0 && c.VoiceLikelihood is { } v && Math.Round(Math.Clamp(v * 100, 0, 100), MidpointRounding.AwayFromZero) < _hideBelowVoice;

    private int HiddenByVoiceCount => _hideBelowVoice == 0 ? 0 : PendingCandidates.Count(HiddenByVoice);

    private string VoiceUnmeasuredTitle => _voiceStatus is { Available: false, Reason: { Length: > 0 } reason }
        ? reason
        : "Not measured: this candidate was found before voice-likeness was measured. Scan again to measure it.";

