@* ── Save region as clip dialog ──────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showSaveClipDialog" Title="Create Audio File from Region">
    <ChildContent>
        @if (_clipSourceMarker is { } clipMarker)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@clipMarker.Label</strong>
                (@FormatMarkerRange(clipMarker)) from <em>@FileName</em>.
                With padding: <strong>@FormatTime(ClipStart) &ndash; @FormatTime(ClipEnd)</strong>.
                Output will be saved as WAV.
            </p>
        }
        else if (_newUserRegion is not null)
        {
            <p class="text-secondary small mb-3">
                Clipping <strong>@FormatTime(ClipStart)</strong>
                &ndash; <strong>@FormatTime(ClipEnd)</strong>
                from <em>@FileName</em>. Output will be saved as WAV.
            </p>
        }
        <div class="row g-3">
            <div class="col-12 d-flex gap-3 flex-wrap align-items-end">
                <label class="small mb-0">
                    Lead-in (s)
                    @* Extra room either side of the marked sound. A clip trimmed exactly to the
                       words is hard to judge — you want a moment of the room before and after. *@
                    <BenTextBox type="number" class="form-control form-control-sm" style="width:90px;"
                                min="0" max="10" step="0.1" Value="@_clipPrePad"
                                OnInput="@(e => SetOption(e.Value, v => _clipPrePad = Math.Clamp(v, 0, 10)))" />
                </label>
                <label class="small mb-0">
                    Tail (s)
                    <BenTextBox type="number" class="form-control form-control-sm" style="width:90px;"
                                min="0" max="10" step="0.1" Value="@_clipPostPad"
                                OnInput="@(e => SetOption(e.Value, v => _clipPostPad = Math.Clamp(v, 0, 10)))" />
                </label>
                <label class="small mb-0 d-flex align-items-center gap-2">
                    <input type="checkbox" checked="@_clipNormalize"
                           @onchange="@(e => _clipNormalize = (bool?)e.Value ?? false)" />
                    Boost volume (normalize)
                </label>
            </div>
            <div class="col-12">
                <SaveFormatChoice @bind-SaveAsWav="@_saveAsWav" Id="clip-save-as-wav" />
            </div>
            <div class="col-12">
                <div class="small text-secondary">
                    Normalizing raises the clip's loudest point to just under maximum. An EVP is
                    usually far quieter than the rest of the recording, so without it the clip can be
                    almost inaudible. The original is never modified — a clip can always be re-cut.
                </div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="audiofilepreview-label-description-7e59">Label / Description</label>
                <input id="audiofilepreview-label-description-7e59" type="text" class="form-control" placeholder="Optional — auto-generated if blank" @bind="@_saveClipLabel" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">File Type <span class="text-danger">*</span></label>
                <BenSelect Class="form-select-sm" Data="@_fileTypes" @bind-Value="@_saveClipTypeId" TextField="@nameof(UploadFileTypeRecord.Name)" ValueField="@nameof(UploadFileTypeRecord.Id)" DefaultText="— select —" Width="100%" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="clip-pub-afp" @bind="@_saveClipIsPublic" />
                <label for="clip-pub-afp" class="form-label mb-0">Public</label>
            </div>
        </div>
        @if (_saveClipError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0 py-2 small">@_saveClipError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => { _showSaveClipDialog = false; _saveClipError = null; })">
                Cancel
            </button>
            <button type="button" class="btn btn-primary" @onclick="SaveClipAsync" disabled="@(!(!_isSavingClip && _saveClipTypeId != Guid.Empty))"><BenIcon Name="save" Class="me-1" />
                @(_isSavingClip ? "Saving…" : "Save clip")
            </button>
            @* Nothing else in this dialog is gated on the file type, so a missing type reads as a dead
               button. Say why. *@
            @if (_saveClipTypeId == Guid.Empty)
            {
                <span class="small text-secondary ms-2">Pick a file type first.</span>
            }
        </div>
    </ChildContent>
</BenModal>
