    private async Task ZoomToCandidateAsync(AudioMarkerRecord candidate)
    {
        _focusedCandidateId = candidate.Id;
        if (_modalPlayer is not null)
            await _modalPlayer.ZoomToRangeAsync(candidate.TimeSeconds, candidate.EndSeconds ?? candidate.TimeSeconds + 1);
    }

    private AudioMarkerRecord? FocusedCandidate =>
        _focusedCandidateId is { } id ? PendingCandidates.FirstOrDefault(c => c.Id == id) : null;

    /// <summary>A key from the editor's page (AudioEditor.razor.js). See the shortcuts window for the list.</summary>
    [JSInvokable]
    public async Task OnShortcutAsync(string action, bool shift)
    {
        if (!_modalReady || _modalPlayer is null) return;
        try
        {
            switch (action)
            {
                case "space":
                    if (await _modalPlayer.IsPlayingAsync()) await _modalPlayer.PauseAsync();
                    else if (_loop && _regionSelection.Target is { } loopSel) await _modalPlayer.PlayRangeAsync(loopSel.Start, loopSel.End);
                    else await _modalPlayer.PlayAsync();
                    break;

                case "left" or "right":
                    if (_modalDuration <= 0) break;
                    var step = (shift ? 5 : 1) * (action == "left" ? -1 : 1);
                    var now  = await _modalPlayer.GetCurrentTimeAsync();
                    await _modalPlayer.SeekToAsync(Math.Clamp((now + step) / _modalDuration, 0, 1));
                    break;

                case "start":
                    _selectionStartMark = await _modalPlayer.GetCurrentTimeAsync();
                    Notify($"Selection starts at {FormatTime(_selectionStartMark.Value)}. Press ] where it should end.", "info");
                    break;

                case "end":
                    var end = await _modalPlayer.GetCurrentTimeAsync();
                    if (_selectionStartMark is not { } start || end - start < 0.05)
                    {
                        Notify("Press [ where the selection should start, then ] after it.", "info");
                        break;
                    }
                    await ClearUserRegionsAsync();
                    await _modalPlayer.AddRegionAsync(new WsRegionParams
                    {
                        Start = start, End = end, Kind = "user", Drag = true, Resize = true,
                        Color = "rgba(var(--ben-audio-region-rgb, 91, 61, 245),0.2)",
                    });
                    _selectionStartMark = null;
                    break;

                case "next" or "previous":
                    var list = PendingCandidates.ToList();
                    if (list.Count == 0) break;
                    var at = FocusedCandidate is { } f ? list.FindIndex(c => c.Id == f.Id) : -1;
                    var to = action == "next" ? Math.Min(list.Count - 1, at + 1) : Math.Max(0, at < 0 ? 0 : at - 1);
                    _focusedCandidateId = list[to].Id;
                    await PlayCandidateAsync(list[to]);
                    break;

                case "keep":
                    if (FocusedCandidate is { } keep) OpenConfirmCandidateDialog(keep);
                    break;

                case "dismiss":
                    if (FocusedCandidate is { } dismiss)
                    {
                        // The next one down the list takes the highlight, so D can be pressed again.
                        var rest = PendingCandidates.ToList();
                        var i = rest.FindIndex(c => c.Id == dismiss.Id);
                        await DismissCandidateAsync(dismiss);
                        var after = PendingCandidates.ToList();
                        _focusedCandidateId = after.Count == 0 ? null : after[Math.Min(i, after.Count - 1)].Id;
                    }
                    break;

                case "zoom": await ZoomToSelectionAsync(); break;
                case "fit":  await _modalPlayer.SetZoomAsync(0); break;
                case "loop": await ToggleLoopAsync(); break;
                case "compare": await ToggleCompareAsync(); break;

                case "escape":
                    if (_volumeCurve) await CloseVolumeCurveAsync();
                    else { _selectionStartMark = null; await ClearUserRegionsAsync(); }
                    break;

                case "help": _showShortcuts = true; break;
            }
        }
        catch (Exception gone) when (gone is JSDisconnectedException or OperationCanceledException) { return; }
        StateHasChanged();
    }

    // ── Phase 8: the detector's own view ──────────────────────────────────────

    private bool    _levelLane;
    private bool    _detectorLane;
    private bool    _compareOriginal;
    private ElementReference _meterCanvas;

    /// <summary>The candidate whose "Why?" is open, and what the server said about it.</summary>
    private Guid?                     _explainingId;
    private EvpCandidateDetailRecord? _explanation;
    private string?                   _explainError;

    private async Task ToggleLevelLaneAsync()
    {
        _levelLane = !_levelLane;
        await RefreshLevelLaneAsync();
        await SaveViewAsync();
    }

    private async Task RefreshLevelLaneAsync()
    {
        if (_modalPlayer is null) return;
        await _modalPlayer.SetLevelLaneAsync(_levelLane, _silenceDetectionEnabled ? _silenceThresholdDb : null);
    }

    private async Task ToggleDetectorLaneAsync()
    {
        _detectorLane = !_detectorLane;
        if (_detectorLane) await RefreshDetectorLaneAsync(sayWhyNot: true);
        else if (_modalPlayer is not null) await _modalPlayer.SetDetectorLaneAsync(null);
        await SaveViewAsync();
    }

    /// <summary>
    /// Draws the detector lane from the latest scan's trace. When there is none to draw (never
    /// scanned, or scanned before traces were kept), the lane stays off the screen and, when asked,
    /// the server's sentence says why.
    /// </summary>
    private async Task RefreshDetectorLaneAsync(bool sayWhyNot)
    {
        if (_modalPlayer is null) return;
        var (trace, why) = await AdminClient.GetScanTraceAsync(FileId);
        await _modalPlayer.SetDetectorLaneAsync(trace);
        if (trace is null && sayWhyNot)
            Notify($"The detector lane is on, with nothing to show yet: {why}", "info");
    }

    /// <summary>B, or Listen ▸ Hear the original: the recording as it is, round every listening tool.</summary>
    private async Task ToggleCompareAsync()
    {
        _compareOriginal = !_compareOriginal;
        if (_modalPlayer is not null) await _modalPlayer.SetChainBypassAsync(_compareOriginal);
    }

    private async Task ToggleExplanationAsync(AudioMarkerRecord candidate)
    {
        if (_explainingId == candidate.Id) { _explainingId = null; return; }
        _explainingId = candidate.Id;
        _explanation  = null;
        _explainError = null;
        StateHasChanged();

        var (detail, error) = await AdminClient.GetCandidateDetailAsync(FileId, candidate.Id);
        if (_explainingId != candidate.Id) return;   // another row was opened meanwhile
        _explanation  = detail;
        _explainError = detail is null ? error ?? "Why this was found couldn't be loaded just now." : null;
    }

    /// <summary>A mark on the candidate strip: go there, highlight it if it's a candidate, and play it.</summary>
    private async Task GoToMarkAsync(AudioMarkerRecord mark)
    {
        if (mark.ReviewStatus == EvpReviewStatus.Pending)
        {
            _focusedCandidateId = mark.Id;
            await PlayCandidateAsync(mark);
        }
        else if (_modalPlayer is not null && _modalDuration > 0)
        {
            await _modalPlayer.SeekToAsync(mark.TimeSeconds / _modalDuration);
            await _modalPlayer.PlayAsync();
        }
    }

    // ── Turning parts down: the volume line (phase 7) ─────────────────────────

    private async Task OpenVolumeCurveAsync()
    {
        if (_modalPlayer is null || _volumeCurve) return;
        _volumeError = null;
        await _modalPlayer.StartEnvelopeAsync();
        _volumeCurve = true;
    }

    private async Task CloseVolumeCurveAsync()
    {
        _volumeCurve = false;
        _volumeError = null;
        if (_modalPlayer is not null) await _modalPlayer.StopEnvelopeAsync();
    }

    /// <summary>Saves the recording with the line applied, as a new file like every edit.</summary>
    private async Task SaveVolumeCurveAsync()
    {
        if (_modalPlayer is null || _savingVolume) return;
        var points = await _modalPlayer.GetEnvelopePointsAsync();
        if (points.All(p => p.Volume >= 0.999))
        {
            _volumeError = "The line is still at full volume everywhere. Drag it down where something is too loud.";
            return;
        }

        _savingVolume = true;
        _volumeError  = null;
        StateHasChanged();
        try
        {
            var (result, error) = await AdminClient.EditAudioWithReasonAsync(FileId, new AudioEditRequest(
                AudioEditOperation.Envelope, null, null, null, null, null, null,
                _saveClipIsPublic, _saveClipTypeId,
                Format: SaveFormat,
                Volume: points.Select(p => new VolumePoint(p.Time, p.Volume)).ToList()));

            if (result is null)
            {
                _volumeError = error ?? "That couldn't be saved.";
                return;
            }
            await CloseVolumeCurveAsync();
            await OverlayChildClipRegionsAsync();
            _lastSaveSummary = AudioSaveSummary.For(result, SaveFormat);
            Notify($"Saved \"{result.FileName}\". {_lastSaveSummary}", "success");
            OpenTab("clips");
        }
        finally
        {
            _savingVolume = false;
            StateHasChanged();
        }
    }

    // ── Background scans (phase 6) ────────────────────────────────────────────

    /// <summary>The scan being watched, if any; the editor stays usable while it runs.</summary>
    private Guid?                    _scanJobId;
    private int                      _scanPercent;
    private CancellationTokenSource? _scanWatch;
    private bool                     _stoppingScan;

    /// <summary>How often a running scan is looked at. The first look comes sooner, for a short recording.</summary>
    private static readonly TimeSpan ScanPollEvery = TimeSpan.FromSeconds(1.5);
    private static readonly TimeSpan ScanFirstLook = TimeSpan.FromMilliseconds(300);

    /// <summary>
    /// Starts a background scan and watches it (phase 6). The page stays usable: the waveform is
    /// dimmed where the scan hasn't reached and turns solid as it goes, and leaving does not stop it.
    /// </summary>
    private async Task RunScanAsync()
    {
        if (_scanning) return;

        if (_scanOptions.Validate() is { } problem)
        {
            _scanMessage = problem;
            return;
        }

        _scanning    = true;
        _scanPercent = 0;
        _scanMessage = null;
        StateHasChanged();

        var (job, refusal) = await AdminClient.StartScanJobAsync(
            FileId, new StartScanJobRequest(_scanSensitivity, _scanOptions));

        // Null means the scan did not start. "Nothing stood out from the background" is a finding
        // somebody acts on, so it must never be printed for a request that failed. The server's own
        // sentence comes first: "This server cannot read .m4a yet." is about the server, and only it
        // knows that.
        if (job is null)
        {
            _scanning    = false;
            _scanMessage = refusal is { Length: > 0 }
                ? $"{refusal} This recording has not been examined."
                : "The scan couldn't be started just now. This recording has not been "
                  + "examined — try again rather than reading anything into it.";
            StateHasChanged();
            return;
        }

        _ = WatchScanAsync(job.Id);
    }

    /// <summary>Picks up a scan of this recording that was started before the page was opened.</summary>
    private async Task ResumeLiveScanAsync()
    {
        if (_scanning) return;
        var (live, _) = await AdminClient.GetLiveScanJobAsync(FileId);
        if (live is null) return;

        _scanning    = true;
        _scanPercent = live.Percent;
        _scanMessage = "Picking up the scan that was already running.";
        StateHasChanged();
        _ = WatchScanAsync(live.Id);
    }

    /// <summary>Looks at the scan every second and a half until it finishes, drawing its progress.</summary>
    private async Task WatchScanAsync(Guid jobId)
    {
        _scanWatch?.Cancel();
        var watch = _scanWatch = new CancellationTokenSource();
        _scanJobId = jobId;
        string? etag = null;
        var failures = 0;
        var delay = ScanFirstLook;

        try
        {
            while (!watch.IsCancellationRequested)
            {
                await Task.Delay(delay, watch.Token);
                delay = ScanPollEvery;

                var poll = await AdminClient.GetScanJobAsync(jobId, etag, watch.Token);
                if (poll.Unchanged) continue;
                if (poll.Job is not { } job)
                {
                    // One missed look is a blip; several mean the scan can't be followed from here.
                    if (++failures < 5) continue;
                    _scanMessage = $"{poll.Error} The scan may still be running; reopen the editor to check.";
                    break;
                }

                failures = 0;
                etag = poll.ETag;
                _scanPercent = job.Percent;
                await DrawScanProgressAsync(job);

                if (!job.IsLive)
                {
                    await FinishScanAsync(job);
                    break;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* the page closed, or a newer watch took over */ }
        finally
        {
            if (ReferenceEquals(_scanWatch, watch))
            {
                _scanning     = false;
                _stoppingScan = false;
                _scanJobId    = null;
                try
                {
                    if (_modalPlayer is not null) await _modalPlayer.SetScanProgressAsync(null, null, null);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or OperationCanceledException) { }
            }
        }
    }

    /// <summary>The dimmed and solid parts of the waveform, from the recording's segment of the scan.</summary>
    private async Task DrawScanProgressAsync(EvpScanJobRecord job)
    {
        if (_modalPlayer is null) return;
        var segment = job.Segments.FirstOrDefault(s => s.UploadFileId == FileId);
        var total   = segment?.TotalSeconds is > 0 and var t ? t : _modalDuration;
        if (segment is null || total <= 0) return;
        await _modalPlayer.SetScanProgressAsync(
            Math.Clamp(segment.ProcessedSeconds / total, 0, 1),
            Math.Clamp(segment.SettledSeconds / total, 0, 1),
            segment.Status == EvpScanJobStatus.Queued ? "queued" : null);
    }

    private async Task FinishScanAsync(EvpScanJobRecord job)
    {
        var segment = job.Segments.FirstOrDefault(s => s.UploadFileId == FileId);
        switch (job.Status)
        {
            case EvpScanJobStatus.Done when segment?.Status == EvpScanJobStatus.Done:
                // Reload everything rather than merging: the scan replaced the previous pending set
                // server-side, so the local list is stale in ways the job alone doesn't describe.
                await ClearMarkerRegionsAsync();
                await OverlayMarkersAsync();
                if (_detectorLane) await RefreshDetectorLaneAsync(sayWhyNot: true);
                _explainingId = null;
                _scanMessage = (segment.CandidateCount ?? 0) switch
                {
                    0 => "Nothing stood out from the background.",
                    1 => "1 candidate to review.",
                    var n => $"{n} candidates to review.",
                };
                break;

            case EvpScanJobStatus.Canceled:
                _scanMessage = "Stopped. The candidates from before are still here.";
                break;

            default:
                var why = segment?.Error ?? job.Error;
                _scanMessage = why is { Length: > 0 }
                    ? $"{why} This recording has not been examined."
                    : "The scan couldn't be finished. This recording has not been examined — try again "
                      + "rather than reading anything into it.";
                break;
        }
    }

    private async Task StopScanAsync()
    {
        if (_scanJobId is not { } id || _stoppingScan) return;
        _stoppingScan = true;
        var (stopped, error) = await AdminClient.CancelScanJobAsync(id);
        if (!stopped)
        {
            _stoppingScan = false;
            _scanMessage  = error ?? "The scan couldn't be stopped just now.";
        }
        // The watch sees it finish and says so.
    }

    /// <summary>
    /// Removes the marker regions currently drawn, so a re-scan doesn't leave the previous scan's
    /// candidates on the waveform as orphans with no row behind them.
    /// </summary>
    private async Task ClearMarkerRegionsAsync()
    {
        if (_modalPlayer is null) return;
        foreach (var marker in _markers)
        {
            var id = $"marker-{marker.Id}";
            await _modalPlayer.RemoveRegionAsync(id);
            _programmaticRegionIds.Remove(id);
        }
    }

    // ── Phase D: destructive edit state ─────────────────────────────────────────

    private bool          _isApplyingEdit;
    private string?       _editError;
    /// <summary>
    /// Which region an edit would act on. See <see cref="RegionSelection"/> for the two rules and
    /// for what went wrong when they lived here as loose fields.
    /// </summary>
    private readonly RegionSelection _regionSelection = new();
    private double        _editGainDb   = 0;
    private double        _editFadeIn   = 1;
    private double        _editFadeOut  = 1;
    private double        _editSpeedRatio     = 1.0;
    private double        _editPitchSemitones = 0;

    private bool CanApplyEdit(bool requiresRegion = false)
        => !_isApplyingEdit
           && _saveClipTypeId != Guid.Empty
           && (!requiresRegion || _regionSelection.HasTarget);

    private async Task ApplyAudioEditAsync(AudioEditOperation operation)
    {
        if (!CanApplyEdit(requiresRegion: operation is AudioEditOperation.Cut or AudioEditOperation.Silence)) return;

        _isApplyingEdit = true;
        _editError = null;
        StateHasChanged();

        try
        {
            // Only Cut and Silence act on a region. Sending the drawn bounds with Gain, Fade, Speed
            // or Pitch said something about those edits that was not true — the panel put the
            // region readout next to them, and the server took bounds it then ignored, so an
            // operation on the whole file looked like an operation on the selection
            // (2026-09-06 audio walk, finding G).
            var isRegionEdit = operation is AudioEditOperation.Cut or AudioEditOperation.Silence;
            var region       = isRegionEdit ? _regionSelection.Target : null;

            var (result, error) = await AdminClient.EditAudioWithReasonAsync(FileId, new AudioEditRequest(
                operation,
                region?.Start,
                region?.End,
                operation == AudioEditOperation.Gain ? _editGainDb : null,
                operation == AudioEditOperation.Fade ? _editFadeIn : null,
                operation == AudioEditOperation.Fade ? _editFadeOut : null,
                null,
                _saveClipIsPublic,
                _saveClipTypeId,
                operation == AudioEditOperation.Speed ? _editSpeedRatio : null,
                operation == AudioEditOperation.Pitch ? _editPitchSemitones : null,
                SaveFormat));

            if (result is not null)
            {
                await OverlayChildClipRegionsAsync();
                _lastSaveSummary = AudioSaveSummary.For(result, SaveFormat);
                Notify($"Saved \"{result.FileName}\". {_lastSaveSummary}", "success");
                // Show where it went: the new file is the first thing in the Clips tab.
                OpenTab("clips");
            }
            else
            {
                // The server's own sentence, whatever it refused for. This line used to say "only
                // WAV and MP3 sources can be edited" for every failure — true for one of the
                // reasons and misleading for all the others (2026-09-06 audio walk, phase 1).
                _editError = error ?? "That edit could not be applied.";
            }
        }
        catch (Exception ex)
        {
            _editError = $"Error: {ex.Message}";
        }
        finally
        {
            _isApplyingEdit = false;
            StateHasChanged();
        }
    }

