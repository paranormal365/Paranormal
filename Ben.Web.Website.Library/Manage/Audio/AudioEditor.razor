        _spectrogramEnabled = !_spectrogramEnabled;
        if (_modalPlayer is null) return;
        await _modalPlayer.ToggleSpectrogramAsync(
            _spectrogramEnabled, _spectrogramLabels, _spectrogramFftSamples, _colormap, _melScale);
        await SaveViewAsync();
    }

