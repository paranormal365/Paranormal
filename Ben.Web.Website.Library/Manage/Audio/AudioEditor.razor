@code {

    /// <summary>
    /// Reads a range input's value. The DOM hands back a string; the handlers these replaced took
    /// a number, so parse once here rather than at each call site. A half-typed or empty value
    /// falls back to 0 instead of throwing.
    /// </summary>
    private static int AsRangeValue(object? raw)
        => int.TryParse(raw?.ToString(), System.Globalization.NumberStyles.Integer,
                        System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;

    // ── The recording ─────────────────────────────────────────────────────────

    /// <summary>The recording this editor has open.</summary>
    [Parameter, EditorRequired] public IAudioEditorSource Source { get; set; } = default!;

    // The names the editor's code has always used, read from the source.
    private Guid   FileId      => Source.AnalysisFileId;
    private string FileName    => Source.FileName;
    private string ContentType => Source.ContentType;
    private long   FileSize    => Source.FileSize;

    protected override void OnParametersSet()
    {
        // Always a URL: the browser fetches and streams it, and nothing passes through this
        // process (see AudioFilePreview.SourceUrl for what fetching bytes here once cost).
        if (_source is null || _sourceUrl != Source.Url)
        {
            _sourceUrl = Source.Url;
            _source    = WsAudioSource.FromUrl(Source.Url);
        }
    }

    private string? _sourceUrl;

    /// <summary>
    /// Leaving the editor saves nothing.
    /// </summary>
    /// <remarks>
    /// <para>Phase 1 made this the save that the modal's close used to be. It was wrong on a page:
    /// after a full reload the old page's circuit lingers for minutes and is disposed long after a
    /// newer page has saved, so its stale view overwrote the newer one (a saved zoom came back as
    /// "fit", 10/26/2026). Every change saves as it happens instead; zoom, which the wheel changes
    /// many times a second, saves a second after the last change.</para>
    /// </remarks>
    public async ValueTask DisposeAsync()
    {
        _zoomSave?.Cancel();
        _zoomSave?.Dispose();
        // Only the watching stops; the scan itself carries on in the background.
        _scanWatch?.Cancel();
        try
        {
            if (_keys is not null)
            {
                await _keys.InvokeVoidAsync("detach");
                await _keys.DisposeAsync();
            }
        }
        catch (Exception gone) when (gone is JSDisconnectedException or OperationCanceledException or ObjectDisposedException) { }
        _selfRef?.Dispose();
    }

    /// <summary>Pending save of a zoom change; replaced by each newer zoom.</summary>
    private CancellationTokenSource? _zoomSave;

    /// <summary>The player zoomed (wheel, slider, buttons). Saved once it has settled.</summary>
    private void OnPlayerZoomed(double pxPerSec)
    {
        // Until the saved view is back, these are the player's own load-time zooms, not anyone's
        // choice; taking them would replace the saved zoom before it was applied.
        if (!_viewRestored) return;
        _zoomPxPerSec = pxPerSec;
        _zoomSave?.Cancel();
        _zoomSave?.Dispose();
        var cts = _zoomSave = new CancellationTokenSource();
        _ = Task.Delay(1000, cts.Token).ContinueWith(
            t => { if (!t.IsCanceled) _ = InvokeAsync(SaveViewAsync); },
            TaskScheduler.Default);
    }


    // ── State ─────────────────────────────────────────────────────────────────

    private WsAudioSource? _source;
    private double _modalTime;
    private double _modalDuration;

    /// <summary>The recording's length for an input's max, in the invariant culture. Empty until the
    /// player knows the length, which leaves the input unbounded rather than capped at a guess.</summary>
    private string? MaxSecondsAttribute => _modalDuration > 0
        ? Math.Ceiling(_modalDuration).ToString(System.Globalization.CultureInfo.InvariantCulture)
        : null;
    private bool   _modalReady;
    private IReadOnlyList<UploadFileRecord> _childClips = [];

    /// <summary>true = drag creates a region (default); false = drag scrubs the playhead.</summary>
    private bool   _regionDrawMode = true;

    // ── Timeline + Spectrogram state ───────────────────────────────────

    private bool   _timelineEnabled  = true;
    private bool   _spectrogramEnabled;
    private bool   _spectrogramLabels = true;   // show frequency labels by default
    private int    _spectrogramFftSamples = 512;
    private BenContextMenu<SpectrogramMenuItem>? _spectrogramMenu;

    private static readonly List<SpectrogramMenuItem> _spectrogramMenuItems =
    [
        new("labels", "Toggle Labels"),
    ];


    // ── Region creation workflow ──────────────────────────────────────────────

    /// <summary>IDs of regions added programmatically (overlays, focus regions) — not user-drawn.</summary>
    private readonly HashSet<string> _programmaticRegionIds = [];

    /// <summary>Region currently being acted on (set from right-click args when saving/clipping).</summary>
    private WsRegionData? _newUserRegion;

    private bool   _showSaveClipDialog;      // save-as-clip form

    // ── Clipping an EVP marker (phase E4) ─────────────────────────────────────

    /// <summary>Set when the clip dialog was opened from a marker rather than a drawn region.</summary>
    private AudioMarkerRecord? _clipSourceMarker;
    private double _clipPrePad  = 1.0;
    private double _clipPostPad = 1.0;
    /// <summary>On by default — the usual reason to clip an EVP is to be able to hear it.</summary>
    private bool   _clipNormalize = AudioClipDefaults.Normalize;

    /// <summary>
    /// Clips and edits are saved as FLAC, the same samples as WAV at about half the size, unless
    /// this is on (phase 4b). One choice for the clip dialog, the Edit tab and the explorer.
    /// </summary>
    private bool    _saveAsWav;
    private string? _lastSaveSummary;
    private AudioSaveFormat SaveFormat => _saveAsWav ? AudioSaveFormat.Wav : AudioSaveFormat.Flac;

    /// <summary>Where the clip actually starts once padding is applied, never before the file does.</summary>
    private double ClipStart => Math.Max(0, ClipSourceStart - _clipPrePad);

    /// <summary>Where it ends, clamped to the recording so the request can't run past the audio.</summary>
    private double ClipEnd =>
        _modalDuration > 0
            ? Math.Min(_modalDuration, ClipSourceEnd + _clipPostPad)
            : ClipSourceEnd + _clipPostPad;

    private double ClipSourceStart =>
        _clipSourceMarker?.TimeSeconds ?? _newUserRegion?.Start ?? 0;

    private double ClipSourceEnd =>
        _clipSourceMarker is { } m
            ? (m.EndSeconds ?? m.TimeSeconds)
            : _newUserRegion?.End ?? 0;

    /// <summary>Opens the clip dialog for a confirmed EVP marker, seeded with listening padding.</summary>
    private void OpenClipFromMarkerDialog(AudioMarkerRecord marker)
    {
        _clipSourceMarker   = marker;
        _saveClipLabel      = marker.Label;
        _clipPrePad         = 1.0;
        _clipPostPad        = 1.0;
        _clipNormalize      = AudioClipDefaults.Normalize;
        _saveClipError      = null;
        _showSaveClipDialog = true;
    }
    private bool   _isSavingClip;
    private string? _saveClipError;
    private string  _saveClipLabel    = string.Empty;
    private Guid    _saveClipTypeId;
    private bool    _saveClipIsPublic;
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];

    /// <summary>Why saving is unavailable, when it is. Null while everything loaded.</summary>
    private string? _fileTypesError;

    /// <summary>Why the marker list is empty, when the reason is not "there are none".</summary>
    private string? _markersError;

    /// <summary>Why the saved-clip list is empty, when the reason is not "there are none".</summary>
    private string? _childClipsError;

    /// <summary>Every note on this recording, matched to clips by the range each was written about.</summary>
    private IReadOnlyList<UploadFileRegionNoteRecord> _regionNotes = [];

    /// <summary>The notes written about the stretch a saved clip came from.</summary>
    /// <remarks>
    /// A clip with no region of its own — an edit of the whole file — has no stretch to match, so
    /// it gets none rather than every note on the recording.
    /// </remarks>
    private IReadOnlyList<UploadFileRegionNoteRecord> NotesForClip(UploadFileRecord clip)
        => clip.RegionStart is { } start && clip.RegionEnd is { } end
            ? RegionNoteMatching.For(_regionNotes, start, end)
            : [];

    private WaveSurferPlayer?                          _modalPlayer;

    // ── Region context menu state ──────────────────────────────────────────────

    private BenContextMenu<RegionContextMenuItem>? _regionMenu;
    private WsRegionContextMenuArgs? _pendingRegion;
    private bool   _showEditLabelDialog;
    private string _editLabelText = string.Empty;

    private static readonly List<RegionContextMenuItem> _regionMenuItems =
    [
        new("play",    "Play Region"),
        new("explore", "Explore Region (clip or add a note)"),
        new("save",    "Create Audio File from Region"),
        new("label",   "Edit Label"),
        new("delete",  "Delete Region"),
    ];

    // ── Region Explorer (clip + notes) ──────────────────────────────────────────

    private bool         _showRegionExplorer;
    private WsRegionData? _explorerRegion;


    private WsConfig _fullConfig => new()
    {
        Source  = _source,
        Options = new WsOptions { Normalize = true },
        Plugins = new WsPluginConfig
        {
            Hover               = true,
            Timeline            = true,
            Zoom                = true,
            Spectrogram         = false,   // built-in plugin disabled; toggle button uses custom canvas
            Regions             = true,
            RegionsDragToCreate = true,
        },
        InitialHeight = "280px",
        MinHeight     = "120px",
        MaxHeight     = "600px",
        ShowControls  = true,
    };


    // ── Player event handlers ─────────────────────────────────────────────────

    private async Task OnModalReadyAsync()
    {
        _modalDuration = _modalPlayer?.Duration ?? 0;
        _modalReady    = true;
        StateHasChanged();

        // Re-apply the chosen drag mode — each modal open creates a fresh JS/WaveSurfer
        // instance that defaults back to region mode regardless of the prior selection.
        if (_modalPlayer is not null)
            await _modalPlayer.SetDragModeAsync(_regionDrawMode);

        try { await RestoreSavedViewAsync(); }
        finally
        {
            // Whatever happened to the restore, the toolbar is usable from here.
            _restoreFinished = true;
            StateHasChanged();
        }

        // Far from non-critical: every one of the eight edit buttons and both Save-as-clip buttons
        // are disabled while there is no file type to save into, so a failed load here turns the
        // whole panel off with nothing said and no way to tell it from a slow one
        // (2026-09-06 audio walk, findings E and O).
        try
        {
            _fileTypesError = null;
            _fileTypes = (await AdminClient.GetPublicFileTypesAsync()).Items;
            if (_fileTypes.Any() && _saveClipTypeId == Guid.Empty)
                _saveClipTypeId = _fileTypes[0].Id;
            if (_fileTypes.Count == 0)
                _fileTypesError = "No file types are available to save into, so nothing can be saved from here.";
        }
        catch (Exception ex)
        {
            _fileTypesError = $"The list of file types could not be loaded, so saving is unavailable: {ex.Message}";
        }

        await OverlayChildClipRegionsAsync();
        await OverlayMarkersAsync();

        // Init Web Audio processing chain after player is ready
        if (_modalPlayer is not null)
        {
            await _modalPlayer.InitAudioProcessingAsync();
            await _modalPlayer.StartMeterAsync(_meterCanvas);

            // And only now the saved chain: the graph is built fresh on every open, so applying it
            // any earlier sets filters on nodes that do not exist yet and the panel would claim a
            // high-pass over audio that had none (2026-09-06 audio audit, phase 5b).
            await ApplyChainToPlayerAsync();
        }
    }

    private async Task OverlayChildClipRegionsAsync()
    {
        if (_modalPlayer is null) return;
        try
        {
            _childClipsError = null;
            _childClips = (await AdminClient.GetChildClipsAsync(FileId)).Items;

            // What somebody wrote while listening to that stretch. Without this a note lived only
            // inside the region explorer it was typed in, so saving the region as a clip lost every
            // trace of why it was worth saving (2026-09-06 audio walk, finding M).
            _regionNotes = (await AdminClient.GetRegionNotesAsync(FileId)).Items;
            foreach (var clip in _childClips)
            {
                if (clip.RegionStart is null || clip.RegionEnd is null) continue;
                var id = clip.Id.ToString();
                _programmaticRegionIds.Add(id);  // mark as programmatic so it doesn't trigger the confirm dialog
                await _modalPlayer.AddRegionAsync(new WsRegionParams
                {
                    Id      = id,
                    Kind    = "clip",
                    Start   = clip.RegionStart.Value,
                    End     = clip.RegionEnd.Value,
                    Color   = "rgba(var(--ben-audio-clip-rgb, 5, 150, 105),0.20)",
                    Drag    = false,
                    Resize  = false,
                    Content = clip.Description ?? clip.FileName,
                });
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // "No clips have been saved" and "the list could not be loaded" looked identical, which
            // is the worse of the two to be wrong about: the panel showed an empty history of a
            // recording somebody had already worked on (finding O).
            _childClipsError = $"Saved clips could not be loaded: {ex.Message}";
            StateHasChanged();
        }
    }

    // ── EVP markers ──────────────────────────────────────────────────────────

    /// <summary>Markers a person stands behind — what the marker list shows and edits.</summary>
    private IEnumerable<AudioMarkerRecord> ConfirmedMarkers =>
        _markers.Where(m => m.ReviewStatus == EvpReviewStatus.Confirmed).OrderBy(m => m.TimeSeconds);

    /// <summary>Detector proposals nobody has ruled on yet. Reviewed on the Candidates tab (phase E3).</summary>
    private IEnumerable<AudioMarkerRecord> PendingCandidates =>
        _markers.Where(m => m.ReviewStatus == EvpReviewStatus.Pending).OrderBy(m => m.TimeSeconds);

    private async Task OverlayMarkersAsync()
    {
        if (_modalPlayer is null) return;
        try
        {
            _markersError  = null;
            _markersResult = await AdminClient.GetAudioMarkersAsync(FileId);
            _markers       = _markersResult.Items;
            foreach (var marker in _markers)
                await AddMarkerRegionAsync(marker);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // A recording whose markers failed to load looked exactly like one nobody had marked
            // — on the panel whose whole job is to show what was found (finding O).
            _markersError = $"Markers could not be loaded: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task AddMarkerRegionAsync(AudioMarkerRecord marker)
    {
        if (_modalPlayer is null) return;

        // A dismissed candidate is kept in the database only so a re-scan can dedupe against it.
        // Drawing it would put rejected noise back on the waveform.
        if (marker.ReviewStatus == EvpReviewStatus.Dismissed) return;

        var id = $"marker-{marker.Id}";
        _programmaticRegionIds.Add(id);
        await _modalPlayer.AddRegionAsync(new WsRegionParams
        {
            Id      = id,
            Kind    = "marker",
            Start   = marker.TimeSeconds,
            // Equal start and end is how this plugin draws a point marker. A span passes its real
            // end, so the region covers the audio the marker is actually a claim about.
            End     = marker.IsSpan ? marker.EndSeconds : marker.TimeSeconds,
            Color   = MarkerColor(marker),
            Drag    = false,
            Resize  = false,
            Content = MarkerRegionLabel(marker),
        });
    }

    /// <summary>
    /// Candidates are amber regardless of confidence — they carry the detector's default
    /// "Possible", which would otherwise render them identically to a human's least-certain
    /// finding, and those are very different things to see on a waveform.
    /// </summary>
    private static string MarkerColor(AudioMarkerRecord marker) =>
        marker.ReviewStatus == EvpReviewStatus.Pending
            ? "rgba(var(--ben-audio-candidate-rgb, 217, 119, 6),0.75)"
            : MarkerColor(marker.ConfidenceLevel);

    private static string MarkerColor(EvpConfidenceLevel level) => level switch
    {
        // Theme tokens (signal-tokens.css), so the marks follow light and dark. Region colors are
        // inline styles in WaveSurfer's shadow DOM, which custom properties inherit into.
        EvpConfidenceLevel.Confirmed => "rgba(var(--ben-audio-confirmed-rgb, 5, 150, 105),0.85)",
        EvpConfidenceLevel.Probable  => "rgba(var(--ben-audio-probable-rgb, 202, 138, 4),0.85)",
        _                            => "rgba(var(--ben-audio-possible-rgb, 100, 116, 139),0.85)",
    };

    /// <summary>
    /// A candidate is labelled with its score alone. A scan can drop dozens of these onto one
    /// waveform, and repeating "Detected signal" on every band produced overlapping text that hid
    /// the waveform without telling the reader anything — they all say the same words. The number
    /// is the only part that differs, and the panel below carries the full description.
    /// </summary>
    private static string MarkerRegionLabel(AudioMarkerRecord marker) =>
        marker.ReviewStatus == EvpReviewStatus.Pending && marker.DetectionScore is { } score
            ? score.ToString("0")
            : marker.Label;

    /// <summary>"0:03" for a point, "0:03–0:04 (0.6s)" for a span.</summary>
    private static string FormatMarkerRange(AudioMarkerRecord marker) =>
        marker.IsSpan
            ? $"{FormatTime(marker.TimeSeconds)}–{FormatTime(marker.EndSeconds!.Value)} ({marker.EndSeconds!.Value - marker.TimeSeconds:0.0}s)"
            : FormatTime(marker.TimeSeconds);

    private async Task AddMarkerAtCurrentTimeAsync()
    {
        _editingMarker      = null;

        // If the user has a region drawn, they've already shown us the stretch they mean — start
        // from that rather than making them re-enter it as numbers.
        var drawn = _newUserRegion ?? _regionSelection.Target;
        if (drawn is not null && drawn.End > drawn.Start)
        {
            _markerTimeSeconds = drawn.Start;
            _markerEndSeconds  = drawn.End;
            _markerIsSpan      = true;
        }
        else
        {
            _markerTimeSeconds = _modalTime;
            _markerEndSeconds  = _modalTime + DefaultSpanSeconds;
            _markerIsSpan      = false;
        }

        _markerLabel        = string.Empty;
        _markerConfidence   = EvpConfidenceLevel.Possible;
        _markerNote         = string.Empty;
        _showMarkerDialog   = true;
        await Task.CompletedTask;
    }

    private void OpenEditMarkerDialog(AudioMarkerRecord marker)
    {
        _editingMarker     = marker;
        _markerTimeSeconds = marker.TimeSeconds;
        _markerIsSpan      = marker.IsSpan;
        _markerEndSeconds  = marker.EndSeconds ?? marker.TimeSeconds + DefaultSpanSeconds;
        _markerLabel       = marker.Label;
        _markerConfidence  = marker.ConfidenceLevel;
        _markerNote        = marker.Note ?? string.Empty;
        _showMarkerDialog  = true;
    }

    /// <summary>How long a span starts out when the user asks for one without drawing a region.</summary>
    private const double DefaultSpanSeconds = 1.0;

    private void ToggleMarkerSpan(bool isSpan)
    {
        _markerIsSpan = isSpan;
        // Re-seed rather than leaving a stale end behind the checkbox — an end at or before the
        // start would be rejected by the API, and the user has no reason to expect that.
        if (isSpan && _markerEndSeconds <= _markerTimeSeconds)
            _markerEndSeconds = _markerTimeSeconds + DefaultSpanSeconds;
    }

    /// <summary>The end to persist: null unless the user asked for a span and it's actually one.</summary>
    private double? MarkerEndToSave =>
        _markerIsSpan && _markerEndSeconds > _markerTimeSeconds ? _markerEndSeconds : null;

    private async Task SaveMarkerAsync()
    {
        if (string.IsNullOrWhiteSpace(_markerLabel)) return;

        if (_editingMarker is null)
        {
            var created = await AdminClient.CreateAudioMarkerAsync(FileId, new CreateAudioMarkerRequest(
                _markerTimeSeconds, _markerLabel.Trim(), _markerConfidence,
                string.IsNullOrWhiteSpace(_markerNote) ? null : _markerNote.Trim(),
                MarkerEndToSave));
            if (created is not null)
            {
                _markers = [.. _markers, created];
                await AddMarkerRegionAsync(created);
            }
        }
        else
        {
            var updated = await AdminClient.UpdateAudioMarkerAsync(FileId, _editingMarker.Id, new UpdateAudioMarkerRequest(
                _markerTimeSeconds, _markerLabel.Trim(), _markerConfidence,
                string.IsNullOrWhiteSpace(_markerNote) ? null : _markerNote.Trim(),
                MarkerEndToSave));
            if (updated is not null && _modalPlayer is not null)
            {
                _markers = [.. _markers.Where(m => m.Id != updated.Id), updated];
                await _modalPlayer.RemoveRegionAsync($"marker-{updated.Id}");
                await AddMarkerRegionAsync(updated);
            }
        }

        _showMarkerDialog = false;
        StateHasChanged();
    }

    private async Task DeleteMarkerAsync(AudioMarkerRecord marker)
    {
        var ok = await AdminClient.DeleteAudioMarkerAsync(FileId, marker.Id);
        if (!ok) return;
        _markers = [.. _markers.Where(m => m.Id != marker.Id)];
        if (_modalPlayer is not null)
            await _modalPlayer.RemoveRegionAsync($"marker-{marker.Id}");
        StateHasChanged();
    }

    /// <summary>How much of the recording either side of a point marker its play button covers.</summary>
    /// <remarks>
    /// A point marker names an instant, and an instant cannot be listened to. Two seconds either
    /// side is long enough to hear a word and short enough not to wander into the next one.
    /// </remarks>
    private const double MarkerContextSeconds = 2.0;

    /// <summary>
    /// Plays what a marker is a claim about.
    /// </summary>
    /// <remarks>
    /// <para>This only seeked. The playhead moved and nothing was heard, on the one button whose
    /// entire purpose is to let a reviewer hear the thing again — while the identical button on a
    /// candidate a row above played its audio, because candidates are always spans and went through
    /// a different path (2026-09-06 audio walk, finding J).</para>
    ///
    /// <para>A span plays its own audio. A point has none, so it plays a window of context around
    /// itself, which is what a person listening for an EVP needs anyway: the syllable before it is
    /// usually how you tell a voice from a bump.</para>
    /// </remarks>
    private async Task PlayMarkerAsync(AudioMarkerRecord marker)
    {
        if (_modalPlayer is null || _modalDuration <= 0) return;

        var (start, end) = marker.IsSpan && marker.EndSeconds is { } spanEnd
            ? (marker.TimeSeconds, spanEnd)
            : (marker.TimeSeconds - MarkerContextSeconds, marker.TimeSeconds + MarkerContextSeconds);

        await _modalPlayer.PlayRangeAsync(Math.Max(0, start), Math.Min(_modalDuration, end));
    }

    // ── New region drawn by user ──────────────────────────────────────────────

    /// <summary>
    /// A region has appeared. Only one a person drew becomes what an edit would act on.
    /// </summary>
    /// <remarks>
    /// The guard used to be "is this id one the editor added?", which covered the overlays this
    /// component draws and missed every region JavaScript draws — so each of silence detection's
    /// regions arrived looking user-drawn, cleared the others and the person's own selection, and
    /// the last one became the edit target (2026-09-06 audio walk, finding B).
    /// </remarks>
    private async Task OnModalRegionCreated(WsRegionData r)
    {
        if (!_regionSelection.Created(r)) return;

        // One drawn region at a time — the edit panel has room to name exactly one range. Overlays
        // and detected silence are left where they are.
        if (_modalPlayer is not null)
            await _modalPlayer.ClearUserRegionsAsync(exceptId: r.Id);

        StateHasChanged();
    }

    /// <summary>Forgets the edit target when the region behind it is removed.</summary>
    /// <remarks>
    /// A target that outlives its region leaves Cut enabled and pointed at a range nobody can see.
    /// </remarks>
    private void OnModalRegionRemoved(string regionId)
    {
        _regionSelection.Removed(regionId);
        if (_newUserRegion?.Id == regionId) _newUserRegion = null;
        StateHasChanged();
    }

    /// <summary>
    /// Keeps the tracked bounds in step when the user drags or resizes the region they drew.
    /// Without this, the edit target held the bounds from the moment the region
    /// was first drawn, so a region-scoped Cut/Silence — and the region readout in the edit
    /// panel — silently used the original bounds rather than what was on screen.
    /// </summary>
    private void OnModalRegionUpdated(WsRegionData r)
    {
        // Checked before the programmatic-region bail-out below: a candidate's region *is*
        // programmatic, so without this the drags that adjust-bounds depends on are thrown away.
        if (_adjustingCandidateId is { } adjustingId && r.Id == $"marker-{adjustingId}")
        {
            _adjustedStart = r.Start;
            _adjustedEnd   = r.End;
            StateHasChanged();
            return;
        }

        if (r.Kind != RegionKind.User) return;

        _regionSelection.Updated(r);
        if (_newUserRegion?.Id == r.Id) _newUserRegion = r;
        StateHasChanged();
    }

    private async Task SaveClipAsync()
    {
        // Either a drawn region or a marker can be the source; one of them must be.
        if (_clipSourceMarker is null && _newUserRegion is null) return;
        if (_saveClipTypeId == Guid.Empty) return;

        _isSavingClip = true;
        _saveClipError = null;
        StateHasChanged();

        try
        {
            var (result, error) = await AdminClient.ClipAudioWithReasonAsync(FileId, new ClipAudioRequest(
                ClipStart, ClipEnd,
                string.IsNullOrWhiteSpace(_saveClipLabel) ? null : _saveClipLabel.Trim(),
                _saveClipIsPublic, _saveClipTypeId,
                _clipNormalize, _clipSourceMarker?.Id, SaveFormat));

            if (result is not null)
            {
                _showSaveClipDialog  = false;
                _saveClipLabel       = string.Empty;
                _saveClipError       = null;

                if (_clipSourceMarker is not null)
                {
                    // Reload so the marker row picks up its new LinkedClipUploadFileId — the server
                    // set it, and nothing else would tell this list about it.
                    _clipSourceMarker = null;
                    _markers = (await AdminClient.GetAudioMarkersAsync(FileId)).Items;
                }

                // Remove the user-drawn region — replaced by the persisted overlay
                if (_newUserRegion is not null && _modalPlayer is not null)
                    await _modalPlayer.RemoveRegionAsync(_newUserRegion.Id);
                _newUserRegion = null;

                // Refresh child clips and overlay the newly saved one
                await OverlayChildClipRegionsAsync();
                _lastSaveSummary = AudioSaveSummary.For(result, SaveFormat);
                Notify($"Saved \"{result.FileName}\". {_lastSaveSummary}", "success");
                // Show where it went: the new file is the first thing in the Clips tab.
                OpenTab("clips");
            }
            else
            {
                _saveClipError = error ?? "That clip could not be saved.";
                Notify(_saveClipError, "error");
            }
        }
        catch (Exception ex)
        {
            _saveClipError = $"Error: {ex.Message}";
        }
        finally
        {
            _isSavingClip = false;
        }
    }

    // ── Formatting helpers (delegated to AudioFormatUtils) ────────────────────

    private static string FormatTime(double seconds) => AudioFormatUtils.FormatTime(seconds);
    private static string FormatSize(long bytes)      => AudioFormatUtils.FormatSize(bytes);

    // Through BenToastService, the layout-rendered queue that replaced TelerikNotification.
    // The old version showed these on a TelerikNotification field that no markup ever rendered,
    // so every message here — including "Save failed" — went to nobody (item #102).
    private void Notify(string message, string themeColor = "warning")
    {
        switch (themeColor)
        {
            case "success": Toasts.Success(message); break;
            case "error":   Toasts.Error(message);   break;
            default:        Toasts.Warning(message); break;
        }
    }

    // ── Spectrogram toggle + context menu ─────────────────────────────────────

    /// <summary>The Clear Regions button: removes what a person drew, and nothing else.</summary>
    /// <remarks>
    /// Marker overlays, saved-clip overlays and detected silence stay. Clearing them would delete
    /// the evidence the person is working from rather than the selection they want to redo.
    /// </remarks>
    private async Task ClearUserRegionsAsync()
    {
        if (_modalPlayer is null) return;
        await _modalPlayer.ClearUserRegionsAsync();
        _regionSelection.Clear();
        _newUserRegion = null;
        StateHasChanged();
    }

    // ── Remembering how you look at this recording ────────────────────────────

    /// <summary>The saved row, kept so a save can leave every other setting on it alone.</summary>
    private UploadFileAudioConfigRecord? _savedConfig;

    /// <summary>What was on screen when the view was last saved, so an unchanged view is not re-sent.</summary>
    private AudioViewState _savedView = AudioViewState.Default;

    /// <summary>
    /// Why the last save did not land, or null when the last one did.
    /// </summary>
    /// <remarks>
    /// <para>Saving the view needs the same grant as changing the file, so somebody a recording was
    /// shared with can set the spectrogram up for themselves without it sticking. That is not an
    /// error — they did not ask to save anything — but it should not be a secret either.</para>
    ///
    /// <para><b>This does not stop the editor trying again.</b> It used to: the first failure
    /// switched persistence off for the rest of the session, so one refused request — a rate limit,
    /// a dropped connection, a restarted API — silently turned the feature off, and every setting
    /// changed afterwards was lost with no further sign. A refusal that will not change and one
    /// that is over in a second look identical from here, and only the second is worth giving up
    /// on (2026-09-06 audio audit, phase 6).</para>
    /// </remarks>
    private string? _viewNotSavedReason;

    /// <summary>The view as it stands on screen.</summary>
    private AudioViewState CurrentView => new()
    {
        SpectrogramVisible = _spectrogramEnabled,
        SpectrogramLabels  = _spectrogramLabels,
        FftSamples         = _spectrogramFftSamples,
        Colormap           = _colormap,
        MelScale           = _melScale,
        TimelineVisible    = _timelineEnabled,
        Chain              = CurrentChain,
        Workspace          = CurrentWorkspace,
    };

    /// <summary>The rest of how the editor stands (phase 3): zoom, speed, tabs, the Display dials.</summary>
    private AudioWorkspace CurrentWorkspace => new()
    {
        ZoomPxPerSec  = _zoomPxPerSec,
        Speed         = _speed,
        VoiceBand     = _showVoiceBand,
        DragScrub     = !_regionDrawMode,
        DetectSilence = _silenceDetectionEnabled,
        InspectorOpen = _inspectorOpen,
        InspectorTab  = _inspectorTab,
        Analysis      = _spectrogramAnalysis,
        Minimap       = _minimap,
        SpectrogramHeight = _spectrogramHeight,
        LevelLane     = _levelLane,
        DetectorLane  = _detectorLane,
    };

    /// <summary>The listening chain as the controls stand.</summary>
    private AudioListeningChain CurrentChain => new()
    {
        EqGains               = [.. _eqGains],
        HighPassOn            = _hpEnabled,
        HighPassHz            = _hpFreq,
        LowPassOn             = _lpEnabled,
        LowPassHz             = _lpFreq,
        CompressorOn          = _compEnabled,
        CompressorThresholdDb = _compThreshold,
        CompressorRatio       = _compRatio,
        CompressorAttack      = _compAttack,
        CompressorRelease     = _compRelease,
        NoiseGateOn           = _noiseGateEnabled,
        NoiseGateThresholdDb  = _noiseGateThreshold,
        NoiseGateAttack       = _noiseGateAttack,
        NoiseGateRelease      = _noiseGateRelease,
        SilenceThresholdDb    = _silenceThresholdDb,
    };

    /// <summary>
    /// Puts the editor back the way this recording was left.
    /// </summary>
    /// <remarks>
    /// The table this reads has existed since 2026-07-18 and nothing had ever read or written it,
    /// so every setting was reset on every open — for somebody working through a long recording,
    /// several times an hour (2026-09-06 audio walk, finding L).
    /// </remarks>
    private async Task RestoreSavedViewAsync()
    {
        try { _savedConfig = await AdminClient.GetAudioConfigAsync(FileId); }
        catch
        {
            // A view that could not be loaded is not worth a message, but saving may go ahead:
            // there is nothing stored to overwrite that this page knows of.
            _viewRestored = true;
            return;
        }

        var view = AudioViewState.From(_savedConfig);
        _savedView = view;

        _timelineEnabled       = view.TimelineVisible;
        _spectrogramEnabled    = view.SpectrogramVisible;
        _spectrogramLabels     = view.SpectrogramLabels;
        _spectrogramFftSamples = view.FftSamples;
        _colormap              = view.Colormap;
        _melScale              = view.MelScale;

        // The workspace (phase 3). Its scale is the Display tab's; mel is also stored on its own
        // (the spectrogram options, older than this), and the two must not disagree: a row written
        // before the workspace existed has only the mel flag, and said "Linear" over a mel picture.
        var ws = view.Workspace;
        var scale = ws.Analysis.Scale == "mel" || ws.Analysis.Scale == "linear"
            ? (view.MelScale ? "mel" : "linear")
            : ws.Analysis.Scale;
        _spectrogramAnalysis     = ws.Analysis with { Scale = scale };
        _speed                   = ws.Speed;
        _zoomPxPerSec            = ws.ZoomPxPerSec;
        _showVoiceBand           = ws.VoiceBand;
        _regionDrawMode          = !ws.DragScrub;
        _silenceDetectionEnabled = ws.DetectSilence;
        _inspectorOpen           = ws.InspectorOpen;
        _inspectorTab            = ws.InspectorTab;
        _minimap                 = ws.Minimap;
        _spectrogramHeight       = ws.SpectrogramHeight;
        _levelLane               = ws.LevelLane;
        _detectorLane            = ws.DetectorLane;

        ApplyChainToControls(view.Chain);

        if (_modalPlayer is null) { _viewRestored = true; return; }

        await _modalPlayer.ToggleTimelineAsync(_timelineEnabled);
        // Before the spectrogram, so it opens at its remembered height (phase 7).
        await _modalPlayer.SetSpectrogramHeightAsync(_spectrogramHeight);
        if (_minimap) await _modalPlayer.ToggleMinimapAsync(true);
        if (_levelLane) await RefreshLevelLaneAsync();
        if (_detectorLane) await RefreshDetectorLaneAsync(sayWhyNot: false);
        if (_spectrogramEnabled)
        {
            await _modalPlayer.ToggleSpectrogramAsync(
                true, _spectrogramLabels, _spectrogramFftSamples, _colormap, _melScale);
            if (_spectrogramAnalysis != SpectrogramAnalysis.Default with { Scale = _spectrogramAnalysis.Scale } || scale is not ("mel" or "linear"))
                await ApplySpectrogramAnalysisAsync();
        }
        await _modalPlayer.SetVoiceBandAsync(_scanOptions.BandLowHz, _scanOptions.BandHighHz);
        if (_showVoiceBand) await _modalPlayer.ToggleVoiceBandOverlayAsync(true);
        if (!_regionDrawMode) await _modalPlayer.SetDragModeAsync(false);
        if (_silenceDetectionEnabled) await _modalPlayer.DetectSilenceAsync(_silenceThresholdDb);
        if (Math.Abs(_speed - 1.0) > 0.001) await _modalPlayer.SetPlaybackRateAsync(_speed);
        // The saved zoom, not the field: the awaits above let the player's own load-time zoom
        // reports (0) through, and they reset the field before this line read it (10/26/2026).
        _zoomPxPerSec = ws.ZoomPxPerSec;
        if (ws.ZoomPxPerSec > 0) await _modalPlayer.SetZoomAsync(ws.ZoomPxPerSec);

        await ApplyChainToPlayerAsync();

        _viewRestored = true;
        StateHasChanged();

        // After the view, not before it: the presets are a second round trip, and the toolbar
        // waits for the view (ToolbarState.Ready).
        await SeedScanSettingsAsync();
        await ResumeLiveScanAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Saves the view, if it has changed and if this caller is allowed to.
    /// </summary>
    /// <remarks>
    /// Called after every control that changes it. Cheap, because an unchanged view sends nothing.
    /// </remarks>
    /// <summary>The save in flight, so two never overlap.</summary>
    /// <remarks>
    /// Several controls save, and the colour-ramp picker does it without being awaited, so two
    /// changes a second apart put two requests in the air at once. On a recording with no saved
    /// row yet, both found nothing, both inserted, and the second hit the one-to-one unique index
    /// and came back a 500 — reported in the panel as "this isn't yours to change", which was not
    /// true and not helpful (2026-09-06 audio audit, phase 6). The server survives the race now
    /// too; this stops it happening.
    /// </remarks>
    private Task _viewSave = Task.CompletedTask;

    /// <summary>Puts the saved chain back on the controls.</summary>
    private void ApplyChainToControls(AudioListeningChain chain)
    {
        for (var band = 0; band < _eqGains.Length && band < chain.EqGains.Count; band++)
            _eqGains[band] = chain.EqGains[band];

        _hpEnabled          = chain.HighPassOn;
        _hpFreq             = chain.HighPassHz;
        _lpEnabled          = chain.LowPassOn;
        _lpFreq             = chain.LowPassHz;
        _compEnabled        = chain.CompressorOn;
        _compThreshold      = chain.CompressorThresholdDb;
        _compRatio          = chain.CompressorRatio;
        _compAttack         = chain.CompressorAttack;
        _compRelease        = chain.CompressorRelease;
        _noiseGateEnabled   = chain.NoiseGateOn;
        _noiseGateThreshold = chain.NoiseGateThresholdDb;
        _noiseGateAttack    = chain.NoiseGateAttack;
        _noiseGateRelease   = chain.NoiseGateRelease;
        _silenceThresholdDb = chain.SilenceThresholdDb;
    }

    /// <summary>
    /// Puts the chain back into the Web Audio graph, so it is heard and not just displayed.
    /// </summary>
    /// <remarks>
    /// The graph is built fresh on every open, so restoring the controls without this would show
    /// a high-pass filter switched on over audio that had none — the worst of both, because the
    /// person would trust what the panel says about what they are hearing.
    /// </remarks>
    private async Task ApplyChainToPlayerAsync()
    {
        if (_modalPlayer is null) return;

        await _modalPlayer.SetAllEqBandsAsync(_eqGains);
        await _modalPlayer.SetHighPassAsync(_hpFreq, _hpEnabled);
        await _modalPlayer.SetLowPassAsync(_lpFreq, _lpEnabled);
        await _modalPlayer.SetCompressorAsync(_compEnabled, _compThreshold, _compRatio, _compAttack, _compRelease);
        await _modalPlayer.SetNoiseGateAsync(_noiseGateEnabled, _noiseGateThreshold, _noiseGateAttack, _noiseGateRelease);
    }

    /// <summary>
    /// False until the saved view has been read and applied. A save before then would write the
    /// defaults over what was stored: the player reports its starting zoom as it loads, before the
    /// saved one is put back.
    /// </summary>
    private bool _viewRestored;

    /// <summary>
    /// The restore has run, successfully or not. Separate from <see cref="_viewRestored"/>, which
    /// also allows saving and so must stay false after a failed restore, while the toolbar must not.
    /// </summary>
    private bool _restoreFinished;

    private async Task SaveViewAsync()
    {
        if (!_viewRestored) return;

        // Let whatever is already going finish, so the second save sees the first one's row.
        try { await _viewSave; } catch { /* its own caller reported it */ }

        var view = CurrentView;
        if (view.SameAs(_savedView)) return;

        var save = SendViewAsync(view);
        _viewSave = save;
        await save;
    }

    private async Task SendViewAsync(AudioViewState view)
    {
        try
        {
            var (saved, error) = await AdminClient.UpsertAudioConfigWithReasonAsync(
                FileId, view.ToRequest(_savedConfig));

            if (saved is null)
            {
                // Say what is known. This used to assert "it isn't yours to change" whenever the
                // server sent nothing readable — which covers a validation failure and a server
                // error just as much as a refusal, and sent somebody looking at permissions while
                // the real answer was a duplicate-key crash (finding W).
                _viewNotSavedReason = error is null
                    ? "These settings couldn't be saved. If this recording isn't yours, that is why."
                    : $"These settings aren't saved: {error}";
                StateHasChanged();
                return;
            }

            _savedConfig        = saved;
            _savedView          = view;
            _viewNotSavedReason = null;   // it landed; whatever went wrong before is over
        }
        catch
        {
            _viewNotSavedReason = "These settings couldn't be saved just now.";
            StateHasChanged();
        }
    }

    private async Task ToggleTimelineAsync()
    {
        _timelineEnabled = !_timelineEnabled;
        if (_modalPlayer is null) return;
        await _modalPlayer.ToggleTimelineAsync(_timelineEnabled);
        await SaveViewAsync();
    }

    private async Task ToggleDragModeAsync()
    {
        _regionDrawMode = !_regionDrawMode;
        if (_modalPlayer is not null)
            await _modalPlayer.SetDragModeAsync(_regionDrawMode);
        await SaveViewAsync();
    }

    private async Task ToggleSpectrogramAsync()
