    /// <summary>What the spectrogram's marks were last drawn from, so they are only sent when that changes.</summary>
    private string? _spectroMarksDrawn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _keys    = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "/_content/Ben.Web.Website.Library/Manage/Audio/AudioEditor.razor.js");
                _selfRef = DotNetObjectReference.Create(this);
                await _keys.InvokeVoidAsync("attach", _selfRef);
            }
            catch (Exception gone) when (gone is JSDisconnectedException or OperationCanceledException or JSException) { }
        }
        await PushSpectrogramMarksAsync();
    }

    /// <summary>
    /// Candidates and kept markers on the spectrogram, sent whenever the list changes (phase 7).
    /// The player keeps them through the spectrogram being turned off and on.
    /// </summary>
    private async Task PushSpectrogramMarksAsync()
    {
        if (_modalPlayer is null || !_modalReady) return;
        var marks = _markers
            .Where(m => m.ReviewStatus != EvpReviewStatus.Dismissed)
            .Select(m => new WsSpan(m.TimeSeconds, m.EndSeconds ?? m.TimeSeconds,
                                    m.ReviewStatus == EvpReviewStatus.Pending ? "candidate" : "confirmed"))
            .ToList();
        var key = string.Join(";", marks.Select(m => FormattableString.Invariant($"{m.Start:0.###}-{m.End:0.###}{m.Kind[0]}")));
        if (key == _spectroMarksDrawn) return;
        _spectroMarksDrawn = key;
        try { await _modalPlayer.SetSpectrogramOverlaysAsync(marks); }
        catch (Exception gone) when (gone is JSDisconnectedException or OperationCanceledException) { }
    }

