@*
  AudioEditor.razor
  ─────────────────
  The full audio editor: waveform, spectrogram, listening tools, EVP markers and scanning, edits
  and saved clips. Hosted by AudioEditorPage (its own address) since phase 1 of the 10/26/2026 plan
  (ProjectNotes/AudioEditor-EVP-Plan-2026-10-26.md); before that it lived inside a fullscreen modal
  in AudioFilePreview, which is where most of the history in the comments below happened.

  The recording comes in as an IAudioEditorSource, so the same editor can open an uploaded file or,
  later, a clip from a field session.
*@

@namespace Ben.Web.Website.Library.Manage.Audio
@implements IAsyncDisposable
@inject IBenAdminClient AdminClient
@inject Ben.Web.Services.IMediaUrlBuilder MediaUrls
@inject BenToastService Toasts
@inject IJSRuntime JS
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@* Grows to its content and the page scrolls. It was h-100 with overflow hidden, which fitted the
   fullscreen window it lived in and cut off the panels under the player once it had a page. *@
<div id="audio-editor" class="audio-editor d-flex flex-column">

    @* ── Info bar ─────────────────────────────────────────────────
       AE-2 of the 2026-09-06 audio walk: this row and the toolbar below it used to be
       ONE flex container, with the whole toolbar inside a single ms-auto child. At
       1440x900 with the spectrogram controls showing, that child was wider than the
       space ms-auto pushed it into, so it overflowed to the LEFT — the first button
       read "e Timeline" — the drag hint at its end collapsed to one word per line, and
       a ~150px band of nothing opened between the two. Two rows, each wrapping on its
       own, and nothing pushed anywhere. *@
    <div class="audio-facts">
        <span><strong>Size:</strong>@(" ")@FormatSize(FileSize)</span>
        <span><strong>Type:</strong>@(" ")@ContentType</span>
        <span><strong>Duration:</strong>@(" ")@FormatTime(_modalDuration)</span>
        <span><strong>Position:</strong>@(" ")@FormatTime(_modalTime)</span>
        @* The help link is in the page's header now; a second one here sat a line below it. *@
    </div>

    @* ── Toolbar (phase 2) ─────────────────────────────────────────
       The everyday buttons on the bar, the rest in View / Listen / Edit menus. It keeps no
       state: AudioToolbarState is built from this component's fields each render. *@
    <AudioEditorToolbar State="@ToolbarState" OnAction="@OnToolbarActionAsync" OnSpeed="@SetSpeedAsync" />

    @* The hint gets its own line. Inside the toolbar's flex row it was the item that
       absorbed the overflow, and a sentence squeezed to 40px wide is one word per
       line — the column the walk photographed. *@
    <div class="audio-hint small text-secondary fst-italic mb-2 flex-shrink-0">
        @* What is heard, live (phase 8), and a word when it is the original rather than the tools' version. *@
        <span class="audio-hint__meters fst-normal">
            @if (_compareOriginal)
            {
                <span class="audio-hint__original" id="audio-original-chip" title="Playing the recording as it is, round every listening tool (B to switch back)">Original</span>
            }
            <canvas class="audio-meter" id="audio-meter" @ref="_meterCanvas" aria-label="Level and frequencies of what is playing" role="img"
                    title="What you're hearing: its frequencies and level, while it plays"></canvas>
        </span>
        @(_regionDrawMode
            ? "Click & drag to mark a region — right-click to play, save, or edit"
            : "Click & drag the waveform to scrub — audio plays while dragging")
        @* Why this setup won't be remembered. It sat between the Spectrogram button and
           its options, where it read as a spectrogram message. *@
        @if (_viewNotSavedReason is not null)
        {
            <span class="fst-normal ms-2" title="Only the owner of a recording can save how it is set up">@_viewNotSavedReason</span>
        }
    </div>

    @* Drawing the volume (phase 7). While it is up the waveform takes points, not regions. *@
    @if (_volumeCurve)
    {
        <div class="audio-volume-bar" id="audio-volume-bar" role="region" aria-label="Turn parts down">
            <BenIcon Name="volume-1" />
            <span class="small">
                Drag the line down where something is too loud. Double-click the line to add a point;
                double-click a point to remove it. Playing follows the line.
            </span>
            <span class="ms-auto d-flex gap-2 flex-wrap">
                <SaveFormatChoice @bind-SaveAsWav="@_saveAsWav" Id="volume-save-as-wav" />
                <button type="button" class="btn btn-primary btn-sm" id="audio-volume-save" disabled="@_savingVolume" @onclick="SaveVolumeCurveAsync">
                    @(_savingVolume ? "Saving…" : "Save as a new file")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_savingVolume" @onclick="CloseVolumeCurveAsync">Cancel</button>
            </span>
            @if (_volumeError is not null)
            {
                <div class="w-100 text-danger small">@_volumeError</div>
            }
        </div>
    }

    @* Every candidate and kept marker across the whole recording, at a glance (phase 8): stronger
       candidates are bolder. A click goes there and plays it. *@
    @if (_modalReady && _modalDuration > 0 && _markers.Any(m => m.ReviewStatus != EvpReviewStatus.Dismissed))
    {
        <div class="evp-strip" id="evp-strip" aria-label="Candidates and markers across the recording">
            @foreach (var m in _markers.Where(m => m.ReviewStatus != EvpReviewStatus.Dismissed))
            {
                var mark = m;
                var left  = Math.Clamp(mark.TimeSeconds / _modalDuration * 100, 0, 100);
                var width = Math.Max(0.5, ((mark.EndSeconds ?? mark.TimeSeconds) - mark.TimeSeconds) / _modalDuration * 100);
                var pending = mark.ReviewStatus == EvpReviewStatus.Pending;
                <button type="button" class="evp-strip__mark @(pending ? "is-candidate" : "is-kept") @(_focusedCandidateId == mark.Id ? "is-focused" : null)"
                        style="left:@(left.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%;width:@(width.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%;--strength:@((((pending && _blindReview ? null : mark.DetectionScore) ?? 100) / 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                        title="@(pending ? (_blindReview ? $"Candidate at {FormatTime(mark.TimeSeconds)}" : $"Candidate at {FormatTime(mark.TimeSeconds)}, score {mark.DetectionScore:0}") : $"{mark.Label} at {FormatTime(mark.TimeSeconds)}")"
                        aria-label="@(pending ? $"Candidate at {FormatTime(mark.TimeSeconds)}" : $"Marker at {FormatTime(mark.TimeSeconds)}")"
                        @onclick="@(() => GoToMarkAsync(mark))"></button>
            }
        </div>
    }

    @* Full WaveSurfer player *@
    <div class="flex-shrink-0" id="modal-player-pane">
        <WaveSurferPlayer @ref="_modalPlayer"
                          Config="@_fullConfig"
                          Resizable="true"
                          OnReady="@OnModalReadyAsync"
                          OnTimeUpdate="@OnModalTimeUpdate"
                          OnFinish="@(() => { _modalTime = 0; _modalPlaying = false; StateHasChanged(); })"
                          OnPlay="@(() => _modalPlaying = true)"
                          OnPause="@(() => _modalPlaying = false)"
                          OnRegionContextMenu="@OnRegionRightClick"
                          OnRegionCreated="@OnModalRegionCreated"
                          OnRegionUpdated="@OnModalRegionUpdated"
                          OnRegionRemoved="@OnModalRegionRemoved"
                          OnSpectrogramReady="@(() => StateHasChanged())"
                          OnSpectrogramContextMenu="@OnSpectrogramContextMenuFired"
                          OnZoom="@OnPlayerZoomed"
                          OnRateChanged="@(async r => { _speed = r; await SaveViewAsync(); })" />
    </div>

    @* ── Inspector (phase 2) ───────────────────────────────────────
       The panels that used to stack between the toolbar and the waveform, one tab each, under
       the player. Nothing pushes the waveform down when one opens any more, which is what left
       bands of empty space with several open (audit finding U). Toolbar buttons only ever OPEN
       a tab; the Hide button folds the whole area away. *@
    <section class="audio-inspector @(_inspectorOpen ? "is-open" : "is-folded")" aria-label="Editor panels">
        <button type="button" class="btn btn-link btn-sm audio-inspector__fold" @onclick="@(async () => { _inspectorOpen = !_inspectorOpen; await SaveViewAsync(); })"
                aria-expanded="@(_inspectorOpen ? "true" : "false")">
            <BenIcon Name="@(_inspectorOpen ? "chevron-down" : "chevron-up")" Class="me-1" />@(_inspectorOpen ? "Hide panels" : "Show panels")
        </button>
        <BenTabs ActiveId="@_inspectorTab" ActiveIdChanged="@OnInspectorTabChanged">

            <BenTab Title="EVP Markers" Id="markers" Icon="target">
                @if (_inspectorOpen && _modalReady)
                {
                    <section class="evp-lab mb-2" id="evp-markers-panel" aria-label="EVP markers">
                        @if (_scanning)
                        {
                            <div class="evp-lab__sweep" aria-hidden="true"></div>
                        }

                        <header class="evp-lab__head">
                            <div>
                                <div class="evp-lab__kicker"><BenIcon Name="radio" /> EVP lab</div>
                                <h2 class="evp-lab__title">
                                    <span class="evp-lab__title-text">EVP Markers</span>
                                    <span class="evp-lab__chip" title="Markers kept on this recording">@ConfirmedMarkers.Count()</span>
                                </h2>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="AddMarkerAtCurrentTimeAsync">
                                <BenIcon Name="plus" Class="me-1" />Add Marker at @FormatTime(_modalTime)
                            </button>
                        </header>

                        @* ── Item 253, said as the feature it is. The explanation, including what
                           is and is not kept, is one click away in the How it works modal. Worded
                           to what is true today: the rulings train the NEXT version; nothing
                           re-fits yet. *@
                        <div class="evp-lab__promo" id="evp-learning-notice">
                            <span class="evp-lab__promo-mark" aria-hidden="true"><BenIcon Name="zap" /></span>
                            <div class="evp-lab__promo-text">
                                <strong>Help build a smarter EVP detector.</strong>
                                <span>Every Keep and Dismiss you make is kept to teach the scanner which sounds are worth your time.</span>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => _showLearningInfo = true)">
                                <BenIcon Name="info" Class="me-1" />How it works
                            </button>
                        </div>

                        @* ── Kept markers ─────────────────────────────────────── *@
                        <div class="evp-lab__section">
                            <div class="evp-lab__section-head">Your markers</div>
                            @if (_markersError is not null)
                            {
                                @* The transport itself failed, which BenListState never sees. *@
                                <div class="alert alert-warning py-1 px-2 small mb-0">@_markersError</div>
                            }
                            else if (_markersResult.Failed)
                            {
                                @* Markers are somebody's analysis of a recording. "No markers yet"
                                   over a refusal says the file was reviewed and found empty. *@
                                <BenListState TItem="AudioMarkerRecord" Result="@_markersResult" />
                            }
                            else if (!ConfirmedMarkers.Any())
                            {
                                <div class="evp-lab__empty">No markers yet. Play the file and drop a marker where you hear something, or scan for EVP below.</div>
                            }
                            else
                            {
                                <div class="evp-lab__list">
                                    @foreach (var marker in ConfirmedMarkers)
                                    {
                                        var m = marker;
                                        <div class="evp-row evp-row--marker" style="--marker-color:@MarkerColor(m);">
                                            <span class="evp-row__time">@FormatMarkerRange(m)</span>
                                            <span class="evp-row__label">@m.Label</span>
                                            <span class="evp-row__meta">@m.ConfidenceLevel</span>
                                            @if (m.IsAutoDetected && m.DetectionScore is { } confirmedScore)
                                            {
                                                <span class="evp-row__pill" title="Signal score from the detector that first proposed this">score @confirmedScore.ToString("0")</span>
                                            }
                                            @if (m.LinkedClipUploadFileId is not null)
                                            {
                                                <span class="evp-row__pill evp-row__pill--clip" title="A clip has been cut from this marker"><BenIcon Name="headphones" /> clip</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(m.Note))
                                            {
                                                <span class="evp-row__note" title="@m.Note">@m.Note</span>
                                            }
                                            <span class="evp-row__actions">
                                                <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => PlayMarkerAsync(m))" title="Play this marker"><BenIcon Name="play" /></button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => OpenClipFromMarkerDialog(m))" title="@(m.LinkedClipUploadFileId is null
                                                                         ? "Save this as its own audio file"
                                                                         : "Save another clip from this marker")"><BenIcon Name="crop" /></button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => OpenEditMarkerDialog(m))" title="Edit this marker"><BenIcon Name="edit-2" /></button>
                                                <button type="button" class="btn btn-outline-danger btn-sm ben-grid-action" @onclick="@(() => DeleteMarkerAsync(m))" title="Delete this marker"><BenIcon Name="trash-2" /></button>
                                            </span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @* ── Detector ────────────────────────────────────────── *@
                        <div class="evp-lab__detector">
                            <div class="evp-lab__detector-row">
                                <span class="evp-lab__section-head mb-0">Detect</span>
                                @* Nothing scans on its own — a scan only happens when Scan is clicked. *@
                                <div class="evp-seg" role="group" aria-label="Sensitivity">
                                    @foreach (var level in _sensitivityOptions)
                                    {
                                        var l = level;
                                        <button type="button" class="evp-seg__btn @(l == _scanSensitivity ? "is-active" : null)"
                                                aria-pressed="@(l == _scanSensitivity ? "true" : "false")"
                                                disabled="@_scanning"
                                                @onclick="@(() => ApplySensitivityPreset(l))">@l</button>
                                    }
                                </div>
                                <button type="button" class="btn btn-primary btn-sm evp-lab__scan @(_scanning ? "is-scanning" : null)" @onclick="RunScanAsync" disabled="@_scanning">
                                    <BenIcon Name="activity" Class="me-1" />@(_scanning ? $"Scanning {_scanPercent}%" : "Scan for EVP")
                                </button>
                                @if (_scanning && _scanJobId is not null)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="evp-scan-stop"
                                            @onclick="StopScanAsync" disabled="@_stoppingScan">
                                        <BenIcon Name="square" Class="me-1" />@(_stoppingScan ? "Stopping…" : "Stop")
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => _showScanTuning = !_showScanTuning)">
                                    <BenIcon Name="sliders" Class="me-1" />@(_showScanTuning ? "Hide settings" : "Fine-tune")
                                </button>
                                @if (_scanMessage is not null)
                                {
                                    <span class="evp-lab__msg">@_scanMessage</span>
                                }
                            </div>
                            <p class="evp-lab__hint">
                                @* Says plainly what the score is, so nobody reads it as "83% likely a voice". *@
                                Finds sounds that rise above the recording's own background noise, in the
                                frequency range speech occupies. Everything it finds needs listening to:
                                the score is how much a sound stood out, not how likely it is to be a voice.
                            </p>

                            @if (_showScanTuning)
                            {
                                @* The preset seeds these; from here they're yours. Every recording is
                                   different, and a threshold that suits a quiet bedroom floods the queue
                                   in a room with a furnace. Every dial the detector has is here (phase 5). *@
                                <EvpScanSettingsEditor Value="@_scanOptions" ValueChanged="@OnScanOptionsChanged"
                                                       @bind-Presets="@_scanPresets" />
                                @* Phase 10: the natural next step after changing a setting, right where it was changed. *@
                                <div class="d-flex justify-content-end mt-2">
                                    <button type="button" class="btn btn-primary btn-sm" id="evp-rescan"
                                            disabled="@_scanning" @onclick="RunScanAsync">
                                        <BenIcon Name="refresh-cw" Class="me-1" />Rescan with these settings
                                    </button>
                                </div>
                            }
                        </div>

                        @* ── Candidates to review ───────────────────────────────── *@
                        @if (PendingCandidates.Any())
                        {
                            <div class="evp-lab__section">
                                <div class="evp-lab__review-head">
                                    <span class="evp-lab__chip evp-lab__chip--hot">@PendingCandidates.Count()</span>
                                    <strong>@(PendingCandidates.Count() == 1 ? "candidate" : "candidates") to review</strong>
                                    @if (_blindReview)
                                    {
                                        <span class="ms-auto small text-muted" id="evp-blind-note"
                                              title="Turned on in your profile. Readings show once you keep or dismiss a candidate.">Reviewing blind, in time order</span>
                                    }
                                    else
                                    {
                                    <div class="evp-seg evp-seg--sm ms-auto" role="group" aria-label="Sort candidates" id="evp-sort">
                                        @foreach (var (order, label) in CandidateOrders)
                                        {
                                            var o = order;
                                            <button type="button" class="evp-seg__btn @(_candidateOrder == o ? "is-active" : null)"
                                                    aria-pressed="@(_candidateOrder == o ? "true" : "false")" @onclick="@(() => _candidateOrder = o)">@label</button>
                                        }
                                    </div>
                                    }
                                </div>
                                @* The person's own filter over the model's reading (phase 9b): applied here, never by the
                                   server, and at 0 it hides nothing. A candidate the model never measured is never hidden. *@
                                @if (!_blindReview)
                                {
                                <div class="evp-lab__voice-filter">
                                    <label for="evp-voice-filter" class="evp-lab__voice-filter-label">
                                        Hide below voice-like <strong>@_hideBelowVoice</strong>
                                    </label>
                                    <input id="evp-voice-filter" type="range" class="form-range" min="0" max="100" step="1"
                                           value="@_hideBelowVoice" @oninput="@(e => _hideBelowVoice = int.TryParse(e.Value?.ToString(), out var v) ? v : 0)" />
                                    @if (HiddenByVoiceCount > 0)
                                    {
                                        <span class="evp-lab__voice-filter-note" id="evp-voice-hidden">@HiddenByVoiceCount hidden</span>
                                    }
                                </div>
                                }

                                <div class="evp-lab__list evp-lab__list--scroll">
                                    @foreach (var candidate in VisibleCandidates)
                                    {
                                        var c = candidate;
                                        var isAdjusting = _adjustingCandidateId == c.Id;
                                        var score = Math.Clamp(c.DetectionScore ?? 0, 0, 100);
                                        var heard = _heardCandidates.Contains(c.Id);
                                        <div class="evp-row evp-row--candidate @(isAdjusting ? "is-adjusting" : null) @(_focusedCandidateId == c.Id ? "is-focused" : null)"
                                             data-heard="@(heard ? "true" : "false")" aria-current="@(_focusedCandidateId == c.Id ? "true" : null)">
                                            @if (!_blindReview)
                                            {
                                            <span class="evp-score" title="Stood out: how much this rose above the background, not a likelihood of speech">
                                                <span class="evp-score__label">Stood out</span>
                                                <span class="evp-score__num">@score.ToString("0")</span>
                                                <span class="evp-score__meter"><span style="width:@(score.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%;"></span></span>
                                            </span>
                                            @if (c.VoiceLikelihood is { } likeness)
                                            {
                                                var voiceLike = Math.Clamp(likeness * 100, 0, 100);
                                                <span class="evp-score evp-score--voice" data-voice="@voiceLike.ToString("0")"
                                                      title="Voice-like: how much this is shaped like a human voice. A ranking, never a likelihood that it is an EVP.">
                                                    <span class="evp-score__label">Voice-like</span>
                                                    <span class="evp-score__num">@voiceLike.ToString("0")</span>
                                                    <span class="evp-score__meter"><span style="width:@(voiceLike.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%;"></span></span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="evp-score evp-score--voice is-unmeasured" title="@VoiceUnmeasuredTitle">
                                                    <span class="evp-score__label">Voice-like</span>
                                                    <span class="evp-score__none">not measured</span>
                                                </span>
                                            }
                                            }
                                            @if (isAdjusting)
                                            {
                                                @* Live values, not the stored ones — the point is to see
                                                   what you're about to save while dragging. *@
                                                <span class="evp-row__time">
                                                    @FormatTime(_adjustedStart)–@FormatTime(_adjustedEnd)
                                                    (@((_adjustedEnd - _adjustedStart).ToString("0.0"))s)
                                                </span>
                                                <span class="evp-row__meta">drag the edges on the waveform, then save</span>
                                            }
                                            else
                                            {
                                                <span class="evp-row__time">@FormatMarkerRange(c)</span>
                                            }
                                            @* Which candidates have been listened to. A ruling made after listening counts for
                                               more in the detector's learning (PlayedFirst, item 253), and a reviewer working
                                               down a long list can see what is left to hear. *@
                                            @if (heard)
                                            {
                                                <span class="evp-row__pill evp-row__pill--heard" title="You have listened to this one">heard</span>
                                            }
                                            @if (c.IsExploratory)
                                            {
                                                @* So nobody wonders why a low score is in the list (phase 5). *@
                                                <span class="evp-row__pill evp-row__pill--sample"
                                                      title="The scan found more than fit, and kept this lower-scoring one as a sample. Your ruling on it teaches the detector the most.">sample</span>
                                            }
                                            <span class="evp-row__actions">
                                                <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => PlayCandidateAsync(c))" title="Play this stretch with its surrounding context"><BenIcon Name="play" /></button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => ZoomToCandidateAsync(c))" title="Zoom in on this one"><BenIcon Name="maximize-2" /></button>
                                                @if (!_blindReview)
                                                {
                                                <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action evp-row__why" @onclick="@(() => ToggleExplanationAsync(c))"
                                                        aria-expanded="@(_explainingId == c.Id ? "true" : "false")" title="Why the scan found this"><BenIcon Name="info" /></button>
                                                }
                                                @if (isAdjusting)
                                                {
                                                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAdjustedBoundsAsync">Save bounds</button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => StopAdjustingAsync(revert: true))">Cancel</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => StartAdjustingAsync(c))" disabled="@(_reviewingCandidateId == c.Id)" title="Adjust where this starts and ends"><BenIcon Name="edit-2" /></button>
                                                    <button type="button" class="btn btn-primary btn-sm ben-grid-action" @onclick="@(() => OpenConfirmCandidateDialog(c))" disabled="@(_reviewingCandidateId == c.Id)" title="Keep as an EVP marker"><BenIcon Name="check" /></button>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm ben-grid-action" @onclick="@(() => DismissCandidateAsync(c))" disabled="@(_reviewingCandidateId == c.Id)" title="Not an EVP — won't be proposed again"><BenIcon Name="x" /></button>
                                                }
                                            </span>
                                        </div>
                                        @if (_explainingId == c.Id)
                                        {
                                            @* Why it was found (phase 8): its score in three parts, and what was measured. *@
                                            <div class="evp-why" id="evp-why-@c.Id">
                                                @if (_explanation is { } why)
                                                {
                                                    <div class="evp-why__bar" role="img" aria-label="@($"Score {why.Score:0} of 100")">
                                                        @foreach (var term in why.Terms)
                                                        {
                                                            <span class="evp-why__part evp-why__part--@(why.Terms.ToList().IndexOf(term))"
                                                                  style="width:@(term.Points.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"
                                                                  title="@term.Name: @term.Points.ToString("0") of @term.MaxPoints.ToString("0")"></span>
                                                        }
                                                    </div>
                                                    <ul class="evp-why__terms">
                                                        @foreach (var term in why.Terms)
                                                        {
                                                            <li><strong>@term.Name, @term.Points.ToString("0") of @term.MaxPoints.ToString("0").</strong> @term.Sentence</li>
                                                        }
                                                    </ul>
                                                    <dl class="evp-why__measures">
                                                        <dt>The room around it</dt><dd>@why.MeanFloorDb.ToString("0") dB</dd>
                                                        <dt>Its loudest moment</dt><dd>@why.PeakBandDb.ToString("0") dB</dd>
                                                        <dt>How much its level moved</dt><dd>@why.BandLevelSpreadDb.ToString("0.0") dB (speech rises and falls; a hum holds steady)</dd>
                                                        <dt>Hiss-like</dt><dd>@((why.ZeroCrossingRate * 100).ToString("0"))% (higher is more like hiss)</dd>
                                                    </dl>
                                                    <p class="evp-why__note">The score is how much a sound stood out, not how likely it is to be a voice. Listen to it.</p>
                                                }
                                                else if (_explainError is not null)
                                                {
                                                    <p class="evp-why__note mb-0">@_explainError</p>
                                                }
                                                else
                                                {
                                                    <p class="evp-why__note mb-0">Loading…</p>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </section>

                }
            </BenTab>

            <BenTab Title="Clips" Id="clips" Icon="paperclip" Badge="@_childClips.Count">
                @if (_inspectorOpen)
                {
                @* What the last save made, in which format and at what size. Kept here because the
                   notice that says it first fades (phase 4b). *@
                @if (_lastSaveSummary is not null)
                {
                    <div class="audio-save-note small mt-2" id="audio-last-save">@_lastSaveSummary</div>
                }
                @* Child clips section *@
                @if (_childClipsError is not null)
                {
                    @* An empty history of a recording somebody has already worked on is a lie the
                       panel used to tell whenever this list failed to load (finding O). *@
                    <div class="alert alert-warning py-1 px-2 small mt-3 mb-0">@_childClipsError</div>
                }
                else if (_childClips.Any())
                {
                    <div class="audio-clips">
                        @foreach (var clip in _childClips)
                        {
                            <div class="audio-clip">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="audio-clip__range">
                                        @FormatTime(clip.RegionStart ?? 0)–@FormatTime(clip.RegionEnd ?? 0)
                                    </span>
                                    <span class="small fw-semibold">
                                        @(string.IsNullOrWhiteSpace(clip.Description) ? clip.FileName : clip.Description)
                                    </span>
                                    <span class="small text-secondary ms-auto">
                                        @FormatSize(clip.FileSize)
                                    </span>
                                </div>
                                @* Why this stretch was worth saving. Written in the region explorer,
                                   and until now visible only there (finding M). *@
                                @foreach (var note in NotesForClip(clip))
                                {
                                    <div class="small text-secondary border-start ps-2 mb-1"
                                         style="border-width:3px !important;">
                                        @((MarkupString)note.NoteHtml)
                                    </div>
                                }
                                <AudioFilePreview FileId="@clip.Id"
                                                  FileName="@clip.FileName"
                                                  ContentType="@clip.ContentType"
                                                  FileSize="@clip.FileSize" />
                            </div>
                        }
                    </div>
                }

                    @if (_childClipsError is null && !_childClips.Any())
                    {
                        <div class="text-secondary small py-2">No clips yet. Draw a region, then choose Edit ▸ Make a clip from the selection.</div>
                    }
                }
            </BenTab>

            <BenTab Title="Listen" Id="listen" Icon="headphones">
                @if (_inspectorOpen && _modalReady)
                {
                    <div class="audio-inspector__row mb-2">
                        <label class="small fw-semibold" for="listen-speed">Playback speed @SpeedText</label>
                        <input id="listen-speed" type="range" class="form-range" min="0.25" max="3" step="0.05" style="max-width:260px;"
                               value="@_speed.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="@(e => _ = SetSpeedAsync(ParseDouble(e.Value, _speed)))" />
                        <span class="small text-secondary">Only how it plays here. To make a copy at a new speed, use Edit ▸ Change speed.</span>
                    </div>
                    <div class="audio-panel">
                        <div class="d-flex gap-3 flex-wrap">

                            @* 10-band EQ — horizontal sliders *@
                            <div class="flex-grow-1" style="min-width:320px;">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <strong class="small">Graphic EQ</strong>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="ResetEqAsync">Reset</button>
                                </div>
                                @{ var bands = new[] { (0, "32"), (1, "64"), (2, "125"), (3, "250"), (4, "500"), (5, "1k"), (6, "2k"), (7, "4k"), (8, "8k"), (9, "16k") }; }
                                @foreach (var (idx, lbl) in bands)
                                {
                                    var b = idx;
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="text-muted" style="width:28px; text-align:right; font-size:0.7rem;">@lbl</span>
                                        <input type="range" class="form-range" min="-12" max="12" step="1" value="@_eqGains[b]" @oninput="@(e => { var v = AsRangeValue(e.Value); _ = OnEqGainChanged(b, v); })" />
                                        <span class="text-muted small" style="width:28px;">@(_eqGains[b] > 0 ? "+" : "")@_eqGains[b].ToString("0.#")</span>
                                    </div>
                                }
                            </div>

                            @* HP / LP filters *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Filters</strong>
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" id="chain-highpass" @bind="_hpEnabled" @bind:after="ApplyHighPassAsync" />
                                    <span class="small">High-pass @_hpFreq Hz</span>
                                </div>
                                <input type="range" class="form-range" min="20" max="500" step="10" @bind="_hpFreq" @bind:event="oninput" @onchange="@(()=>_ = ApplyHighPassAsync())" />
                                <div class="d-flex align-items-center gap-1 mt-2">
                                    <input type="checkbox" class="form-check-input" id="chain-lowpass" @bind="_lpEnabled" @bind:after="ApplyLowPassAsync" />
                                    <span class="small">Low-pass @_lpFreq Hz</span>
                                </div>
                                <input type="range" class="form-range" min="1000" max="20000" step="500" @bind="_lpFreq" @bind:event="oninput" @onchange="@(()=>_ = ApplyLowPassAsync())" />
                            </div>

                            @* Compressor *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" id="chain-compressor" @bind="_compEnabled" @bind:after="ApplyCompressorAsync" />
                                    <strong class="small">Compressor</strong>
                                </div>
                                <span class="small text-muted">Threshold @_compThreshold dB</span>
                                <input type="range" class="form-range" min="-60" max="0" step="1" @bind="_compThreshold" @bind:event="oninput" @onchange="@(()=>_ = ApplyCompressorAsync())" />
                                <span class="small text-muted">Ratio @(_compRatio):1</span>
                                <input type="range" class="form-range" min="1" max="20" step="1" @bind="_compRatio" @bind:event="oninput" @onchange="@(()=>_ = ApplyCompressorAsync())" />
                            </div>

                            @* Noise Gate *@
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <div class="d-flex align-items-center gap-1">
                                    <input type="checkbox" class="form-check-input" id="chain-noisegate" @bind="_noiseGateEnabled" @bind:after="ApplyNoiseGateAsync" />
                                    <strong class="small">Noise Gate</strong>
                                </div>
                                <span class="small text-muted">Threshold @_noiseGateThreshold dB</span>
                                <input type="range" class="form-range" min="-80" max="0" step="1" @bind="_noiseGateThreshold" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Attack @_noiseGateAttack s</span>
                                <input type="range" class="form-range" min="0.001" max="0.5" step="0.01" @bind="_noiseGateAttack" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                                <span class="small text-muted">Release @_noiseGateRelease s</span>
                                <input type="range" class="form-range" min="0.01" max="1" step="0.05" @bind="_noiseGateRelease" @bind:event="oninput" @onchange="@(()=>_ = ApplyNoiseGateAsync())" />
                            </div>
                        </div>
                    </div>

                }
            </BenTab>

            <BenTab Title="Display" Id="display" Icon="eye">
                @if (_inspectorOpen && _modalReady)
                {
                    <AudioDisplaySettings Spectrogram="@_spectrogramEnabled"
                                          FftSamples="@_spectrogramFftSamples"
                                          FftSamplesChanged="@(v => OnSpectrogramResolutionChangedAsync(v))"
                                          Colormap="@_colormap"
                                          ColormapChanged="@OnColormapPickedAsync"
                                          Analysis="@_spectrogramAnalysis"
                                          AnalysisChanged="@OnSpectrogramAnalysisChangedAsync"
                                          SpectrogramHeight="@_spectrogramHeight"
                                          SpectrogramHeightChanged="@OnSpectrogramHeightChangedAsync"
                                          SilenceOn="@_silenceDetectionEnabled"
                                          SilenceThresholdDb="@_silenceThresholdDb"
                                          SilenceThresholdDbChanged="@OnSilenceThresholdChangedAsync" />
                }
            </BenTab>

            <BenTab Title="Edit" Id="edit" Icon="scissors">
                @if (_inspectorOpen && _modalReady)
                {
                    <div class="audio-panel">
                        @if (_fileTypesError is not null)
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2">@_fileTypesError</div>
                        }
                        <SaveFormatChoice @bind-SaveAsWav="@_saveAsWav" Id="edit-save-as-wav" />
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="d-flex flex-column gap-1" style="min-width:180px;">
                                <strong class="small">Region</strong>
                                <span class="text-muted small" id="edit-region-readout">
                                    @(_regionSelection.Target is not { } sel ? "Draw a region on the waveform first" : $"{FormatTime(sel.Start)}–{FormatTime(sel.End)}")
                                </span>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-cut" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Cut))" disabled="@(!(CanApplyEdit(requiresRegion: true)))"><BenIcon Name="scissors" Class="me-1" />Cut</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-silence" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Silence))" disabled="@(!(CanApplyEdit(requiresRegion: true)))"><BenIcon Name="volume-x" Class="me-1" />Silence selection</button>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1" style="min-width:160px;">
                                <strong class="small">Whole File</strong>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-normalize" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Normalize))" disabled="@(!(CanApplyEdit()))"><BenIcon Name="bar-chart-2" Class="me-1" />Normalize</button>
                                    <button type="button" class="btn btn-secondary btn-sm" id="edit-op-reverse" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Reverse))" disabled="@(!(CanApplyEdit()))"><BenIcon Name="rewind" Class="me-1" />Reverse</button>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1 @EditGroupClass(AudioEditOperation.Gain)" style="min-width:180px;">
                                <strong class="small">Gain @(_editGainDb > 0 ? "+" : "")@_editGainDb dB</strong>
                                <input type="range" class="form-range" min="-24" max="24" step="1" @bind="_editGainDb" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-gain" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Gain))" disabled="@(!(CanApplyEdit()))">Apply Gain</button>
                            </div>
                            <div class="d-flex flex-column gap-1 @EditGroupClass(AudioEditOperation.Fade)" style="min-width:200px;">
                                <strong class="small">Fade In / Out (seconds)</strong>
                                <div class="d-flex gap-1">
                                    <input type="number" class="form-control form-control-sm" min="0" max="@MaxSecondsAttribute" step="0.5" style="max-width:80px;" aria-label="Fade in, in seconds" @bind="_editFadeIn" @bind:event="oninput" />
                                    <input type="number" class="form-control form-control-sm" min="0" max="@MaxSecondsAttribute" step="0.5" style="max-width:80px;" aria-label="Fade out, in seconds" @bind="_editFadeOut" @bind:event="oninput" />
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-fade" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Fade))" disabled="@(!(CanApplyEdit()))">Apply Fade</button>
                            </div>
                            <div class="d-flex flex-column gap-1 @EditGroupClass(AudioEditOperation.Speed)" style="min-width:180px;">
                                <strong class="small">Speed @_editSpeedRatio.ToString("0.0#")×</strong>
                                <input type="range" class="form-range" min="0.25" max="4" step="0.05" @bind="_editSpeedRatio" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-speed" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Speed))" disabled="@(!(CanApplyEdit()))">Apply Speed</button>
                            </div>
                            <div class="d-flex flex-column gap-1 @EditGroupClass(AudioEditOperation.Pitch)" style="min-width:180px;">
                                <strong class="small">Pitch @(_editPitchSemitones > 0 ? "+" : "")@_editPitchSemitones st</strong>
                                <input type="range" class="form-range" min="-12" max="12" step="1" @bind="_editPitchSemitones" @bind:event="oninput" />
                                <button type="button" class="btn btn-secondary btn-sm" id="edit-op-pitch" @onclick="@(() => ApplyAudioEditAsync(AudioEditOperation.Pitch))" disabled="@(!(CanApplyEdit()))">Apply Pitch</button>
                            </div>
                        </div>
                        @if (_editError is not null)
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-1 small">@_editError</div>
                        }
                    </div>

                }
            </BenTab>
        </BenTabs>
    </section>

</div>

@* ── Spectrogram context menu (right-click on spectrogram canvas) ───── *@
<BenContextMenu @ref="_spectrogramMenu"
                    Data="@_spectrogramMenuItems"
                    TextField="@nameof(SpectrogramMenuItem.Text)"
                    OnClick="@(async (SpectrogramMenuItem item) => await OnSpectrogramMenuClickAsync(item))">
</BenContextMenu>

@* ── Region context menu (right-click in full-view player) ───────────── *@
<BenContextMenu @ref="_regionMenu"
                    Data="@_regionMenuItems"
                    TextField="@nameof(RegionContextMenuItem.Text)"
                    OnClick="@(async (RegionContextMenuItem item) => await OnRegionMenuClickAsync(item))">
</BenContextMenu>

@* ── Region Explorer — playback + save-as-clip + notes for a drawn region ── *@
@if (_explorerRegion is not null)
{
    <WsRegionExplorer FileId="@FileId"
                      FileName="@FileName"
                      ContentType="@ContentType"
                      FileSize="@FileSize"
                      Region="@_explorerRegion"
                      @bind-Visible="@_showRegionExplorer"
                      Speed="@_speed"
                      SpeedChanged="@SetSpeedAsync"
                      @bind-SaveAsWav="@_saveAsWav"
                      OnClipSaved="@(async saved => { _lastSaveSummary = AudioSaveSummary.For(saved, SaveFormat); await OverlayChildClipRegionsAsync(); })" />
}

@* ── Keyboard shortcuts (phase 7) ───────────────────────────────── *@
<BenModal @bind-Visible="@_showShortcuts" Title="Keyboard shortcuts" Size="sm">
    <ChildContent>
        <p class="small text-secondary">They work anywhere on the editor's page, except while you're typing in a box.</p>
        <dl class="audio-shortcuts" id="audio-shortcuts">
            <dt><kbd>Space</kbd></dt><dd>Play or pause. With Loop on and a selection, play the selection round.</dd>
            <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>Back or on a second; with <kbd>Shift</kbd>, five.</dd>
            <dt><kbd>[</kbd> <kbd>]</kbd></dt><dd>Start a selection at the playhead, then end it there.</dd>
            <dt><kbd>N</kbd> <kbd>P</kbd></dt><dd>Next or previous candidate: it is highlighted and played.</dd>
            <dt><kbd>K</kbd></dt><dd>Keep the highlighted candidate.</dd>
            <dt><kbd>D</kbd></dt><dd>Dismiss the highlighted candidate.</dd>
            <dt><kbd>Z</kbd></dt><dd>Zoom to the selection, or to the highlighted candidate.</dd>
            <dt><kbd>F</kbd></dt><dd>Fit the whole recording.</dd>
            <dt><kbd>L</kbd></dt><dd>Loop on or off.</dd>
            <dt><kbd>B</kbd></dt><dd>Hear the original, without the listening tools, and back.</dd>
            <dt><kbd>Esc</kbd></dt><dd>Clear the selection, or put the volume line away.</dd>
            <dt><kbd>?</kbd></dt><dd>This list.</dd>
        </dl>
    </ChildContent>
</BenModal>

@* ── Region label edit dialog ────────────────────────────────── *@
<BenModal @bind-Visible="@_showEditLabelDialog" Title="Edit Region Label" Size="sm">
    <ChildContent>
        <label class="form-label fw-semibold" for="audiofilepreview-label-10d4">Label</label>
        <input id="audiofilepreview-label-10d4" type="text" class="form-control" @bind="@_editLabelText" @bind:event="oninput" />
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showEditLabelDialog = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveRegionLabelAsync">Save</button>
        </div>
    </ChildContent>
</BenModal>

@* ── EVP marker add/edit dialog ─────────────────────────────────────── *@
<BenModal @bind-Visible="@_showMarkerDialog" Title="@(_editingMarker is null ? "Add EVP Marker" : "Edit EVP Marker")">
    <ChildContent>
        <div class="mb-2">
            <label class="form-label fw-semibold">Time</label>
            <div>
                @FormatTime(_markerTimeSeconds)
                @if (_markerIsSpan)
                {
                    <text> – @FormatTime(_markerEndSeconds) <span class="text-secondary">(@((_markerEndSeconds - _markerTimeSeconds).ToString("0.0"))s)</span></text>
                }
            </div>
            @* The label names its own checkbox. It used to point at the "Ends at" box, which does not
               exist until the box is ticked, so clicking the sentence did nothing. *@
            <label class="d-flex align-items-center gap-2 mt-1 small" for="marker-is-span">
                <input id="marker-is-span" type="checkbox" checked="@_markerIsSpan"
                       @onchange="@(e => ToggleMarkerSpan((bool?)e.Value ?? false))" />
                Mark a stretch of audio rather than an instant
            </label>
            @if (_markerIsSpan)
            {
                <div class="d-flex align-items-center gap-2 mt-1">
                    <span class="small text-secondary">Ends at</span>
                    @* No max of 100: that capped a marker's end at 1:40 on every longer recording. *@
                    <input id="marker-end-seconds" type="number" class="form-control form-control-sm" min="0" max="@MaxSecondsAttribute" step="0.1" style="max-width:110px;" aria-label="Ends at, in seconds" @bind="@_markerEndSeconds" @bind:event="oninput" />
                    <span class="small text-secondary">s</span>
                </div>
            }
        </div>
        <div class="mb-2">
            @* The same question the keep dialog asks: a mark says what was heard, and the session's
               page shows it as that (10/28/2026). *@
            <label class="form-label fw-semibold" for="audiofilepreview-label-2807">What did you hear?</label>
            <input id="audiofilepreview-label-2807" type="text" class="form-control" placeholder="e.g. Whispered name?" @bind="@_markerLabel" @bind:event="oninput" />
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold">Confidence</label>
            <BenSelect Class="form-select-sm" Data="@_confidenceOptions" @bind-Value="_markerConfidence" Width="100%" />
        </div>
        <div class="mb-2">
            <label class="form-label fw-semibold" for="audiofilepreview-note-79d2">Note</label>
            <textarea id="audiofilepreview-note-79d2" class="form-control" rows="3" @bind="@_markerNote"></textarea>
        </div>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showMarkerDialog = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveMarkerAsync" disabled="@(!(!string.IsNullOrWhiteSpace(_markerLabel)))">Save</button>
        </div>
    </ChildContent>
</BenModal>

@* ── How the smarter detector works (item 253) ───────────────────────────────
   The panel advertises the feature in one line; this is where it is explained, including what
   is kept and what is not. Every sentence here has to stay true: today the rulings are COLLECTED
   for a future version — nothing re-fits yet — so it says "the next version", never "learns as
   you go". Keep it in step with the privacy page and the help article. *@
<BenModal @bind-Visible="@_showLearningInfo" Title="A smarter EVP detector">
    <ChildContent>
        <div class="evp-info">
            <p class="evp-info__lede">
                The EVP scanner gets better at its job by watching what investigators keep. You
                don't have to do anything extra: reviewing candidates the way you already do is
                the training.
            </p>

            <div class="evp-info__steps">
                <div class="evp-info__step">
                    <span class="evp-info__num">1</span>
                    <div>
                        <strong>Scan.</strong> For each sound it finds, the scanner notes a few
                        measurements: how far it rose above the background, how much of it sat in
                        the voice band, how long it lasted, how steady it was and how hiss-like.
                    </div>
                </div>
                <div class="evp-info__step">
                    <span class="evp-info__num">2</span>
                    <div>
                        <strong>Review.</strong> Your Keep or Dismiss is saved beside those
                        measurements, along with whether you played the candidate first. A choice
                        made after listening counts for more.
                    </div>
                </div>
                <div class="evp-info__step">
                    <span class="evp-info__num">3</span>
                    <div>
                        <strong>A smarter next version.</strong> Choices from many recordings and
                        many groups are used to re-weight how candidates are ranked, so the sounds
                        investigators keep rise to the top. A new version only replaces the old one
                        if it ranks better.
                    </div>
                </div>
            </div>

            <div class="evp-info__facts">
                <div><BenIcon Name="check" /> <span><strong>No audio is copied.</strong> Only the measurements and your choice.</span></div>
                <div><BenIcon Name="check" /> <span><strong>Nothing records who made the choice.</strong></span></div>
                <div><BenIcon Name="check" /> <span><strong>Delete the recording</strong> and its measurements and choices go with it.</span></div>
            </div>

            <p class="evp-info__fine">
                What it learns is which sounds people tend to keep, not whether a sound is
                paranormal. The score will still be how much a sound stands out, and every
                candidate still needs your ears. More in the
                <a href="/privacy">privacy policy</a>.
            </p>
        </div>
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-primary" @onclick="@(() => _showLearningInfo = false)">Got it</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Confirm a detected candidate ────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showConfirmCandidateDialog" Title="Keep this as an EVP">
    <ChildContent>
        @if (_confirmingCandidate is { } cc)
        {
            <div class="mb-2 small text-secondary">
                @FormatMarkerRange(cc)
                @if (!_blindReview)
                {
                    <text>· detector score @cc.DetectionScore?.ToString("0")</text>
                }
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold" for="audiofilepreview-what-did-you-hear-83cf">What did you hear?</label>
                @* A plain input bound on oninput, not a TelerikTextBox. Telerik's textbox only
                   pushes its value on change/blur, which deadlocked this dialog: the Keep button
                   is gated on the label, so the only thing left to click was disabled, focus never
                   left the field, and the label never bound. *@
                <BenTextBox id="audiofilepreview-what-did-you-hear-83cf" type="text" class="form-control form-control-sm"
                            placeholder="e.g. Whispered name?"
                            Value="@_confirmLabel"
                            OnInput="@(e => _confirmLabel = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold">Confidence</label>
                <BenSelect Class="form-select-sm" Data="@_confidenceOptions" @bind-Value="_confirmConfidence" Width="100%" />
            </div>
            <div class="mb-2">
                <label class="form-label fw-semibold" for="audiofilepreview-note-795d">Note</label>
                <textarea id="audiofilepreview-note-795d" class="form-control" rows="2" @bind="@_confirmNote"></textarea>
            </div>
            @if (_confirmError is not null)
            {
                <div class="text-danger small">@_confirmError</div>
            }
            <div class="small text-secondary">
