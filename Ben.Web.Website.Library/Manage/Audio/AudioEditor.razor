    private async Task OnInspectorTabChanged(string tab)
    {
        OpenTab(tab);
        await SaveViewAsync();
    }

    private async Task OnToolbarActionAsync(AudioToolbarAction action)
    {
        switch (action)
        {
            case AudioToolbarAction.ToggleScrub:             await ToggleDragModeAsync(); break;
            case AudioToolbarAction.ClearRegions:            await ClearUserRegionsAsync(); break;
            case AudioToolbarAction.ToggleSpectrogram:       await ToggleSpectrogramAsync(); break;

            case AudioToolbarAction.Scan:                    OpenTab("markers"); await RunScanAsync(); break;
            case AudioToolbarAction.ScanLow:                 await ScanAtAsync(EvpSensitivity.Low); break;
            case AudioToolbarAction.ScanMedium:              await ScanAtAsync(EvpSensitivity.Medium); break;
            case AudioToolbarAction.ScanHigh:                await ScanAtAsync(EvpSensitivity.High); break;
            case AudioToolbarAction.FineTune:                OpenTab("markers"); _showScanTuning = true; break;
            case AudioToolbarAction.Markers:                 OpenTab("markers"); break;

            case AudioToolbarAction.ZoomOut:                 await ZoomByAsync(1 / ZoomStep); break;
            case AudioToolbarAction.ZoomIn:                  await ZoomByAsync(ZoomStep); break;
            case AudioToolbarAction.ZoomFit:
                if (_modalPlayer is not null) await _modalPlayer.SetZoomAsync(0);
                break;
            case AudioToolbarAction.ZoomSelection:           await ZoomToSelectionAsync(); break;
            case AudioToolbarAction.ToggleLoop:              await ToggleLoopAsync(); break;
