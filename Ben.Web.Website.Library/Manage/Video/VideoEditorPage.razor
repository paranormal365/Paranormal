@page "/video-editor"
@using Microsoft.Extensions.Options

@using Ben.Web.Website.Library.Feed
@using Ben.Service.Models.Feed
@inject IOptions<VideoEditorOptions> EditorOptions
@inject IBenUserState UserState
@inject VideoExportPublisher ExportPublisher
@inject IBenAdminClient AdminClient
@using Ben.Web.Services

<FeatureGate Flag="@SiteFeatures.VideoEditor">
    <PageTitle>Video Editor</PageTitle>

    @* Auth state is not known during prerender, and this page used to read IsAuthenticated straight
       away — so arriving here signed in showed "You must be signed in" and stayed that way, because
       nothing re-rendered when auth resolved. Wait for AuthReady first, the same as every other
       auth-gated page. *@
    @if (!_authResolved)
    {
        <p class="text-muted">Loading…</p>
    }
    else if (!UserState.IsAuthenticated)
    {
        <p class="text-muted">You must be signed in to use the video editor.<HelpLink Slug="using-the-video-editor" /></p>
    }
    else
    {
        <VideoEditor OnPublishExport="OnPublishExportAsync"
                         EnablePostToFeed="@_canPostToFeed"
                         OnPostToFeed="OnPostToFeedAsync"
                         ShowDiagnostics="@(UserState.IsSuperAdmin || UserState.IsAdmin)" />

    @* "Post to the feed" confirmation (item 186 F7) — a personal render, no case lineage. *@
    <FeedPostFromEditorDialog @bind-Visible="_feedDialogVisible"
                              Exported="_pendingFeedExport"
                              OnPosted="OnFeedPostedAsync"
                              OnCancelled="OnFeedCancelled" />
    }
</FeatureGate>

@code {
    /// <summary>False until AuthReady has been awaited; see the guard above.</summary>
    private bool _authResolved;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        _authResolved = true;
        if (UserState.IsAuthenticated)
            _canPostToFeed = (await AdminClient.GetFeedAsync())?.CanPost == true;
    }

    // ── "Post to the feed" (item 186 F7) — personal render, no case lineage ──
    private bool _canPostToFeed;
    private bool _feedDialogVisible;
    private ExportedVideo? _pendingFeedExport;
    private TaskCompletionSource? _feedFlowDone;

    private async Task OnPostToFeedAsync(ExportedVideo exported)
    {
        _pendingFeedExport = exported;
        _feedFlowDone = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _feedDialogVisible = true;
        StateHasChanged();
        await _feedFlowDone.Task;
    }

    private Task OnFeedPostedAsync(Ben.Service.Models.Feed.FeedPostRecord post)
    {
        _pendingFeedExport = null;
        _feedFlowDone?.TrySetResult();
        return Task.CompletedTask;
    }

    private void OnFeedCancelled()
    {
        _pendingFeedExport = null;
        _feedFlowDone?.TrySetException(new InvalidOperationException("Posting was cancelled."));
    }


    /// <summary>Server project id from an earlier publish this session, so a second export in the
    /// same session updates that project rather than creating another row.</summary>
    private Guid? _publishedProjectId;

    /// <summary>
    /// Sends a finished render to the server as a personal (non-case) video project. This page has
    /// no project list of its own, so there is nothing to refresh afterwards — MyVideosPage is
    /// where the result shows up.
    /// </summary>
    /// <remarks>
    /// Deliberately no try/catch: the editor's destination prompt uses the exception to keep itself
    /// open and leave "Save to my machine" available. Catching here would report success and let
    /// the editor discard the render.
    /// </remarks>
    private async Task OnPublishExportAsync(ExportedVideo exported)
    {
        var result = await ExportPublisher.PublishAsync(exported, caseId: null, _publishedProjectId);
        _publishedProjectId = result.ProjectId;
    }
}
