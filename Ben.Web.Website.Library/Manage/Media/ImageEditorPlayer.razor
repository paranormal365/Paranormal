@*
  ImageEditorPlayer.razor
  ────────────────────────
  Full-featured image editor backed by Fabric.js v6 (CDN).
  Phase A: adjustments, filters, basic drawing, rotate/flip, save/export.
  Phase B: layers panel, anomaly highlight, grid overlay, timestamp stamp, ruler.
*@

@namespace Ben.Web.Website.Library.Manage.Media
@implements IAsyncDisposable
@inject IBenAdminClient AdminClient
@inject Ben.Web.Services.IMediaUrlBuilder MediaUrls
@inject IJSRuntime JS
@inject BenToastService Toasts
@using System.Text.Json

@if (_show)
{
    @* Full screen, not "sm". The small dialog left the picture a width of zero once the two side
       panels had taken theirs, so the editor opened with no photo in it and nothing to show what
       any of the unlabelled buttons would do (Ben, 09/25/2026). The audio region explorer made the
       same move for the same reason. *@
    <BenModal @bind-Visible="_show" Title="@($"Edit: {FileName}")" Size="fullscreen" Scrollable="false"
              OnClose="OnClosedAsync">
    <ChildContent>
            <div class="img-editor d-flex gap-0" style="height:100%; min-height:0; overflow:hidden;">

                @* ── Left toolbar: every tool says what it is ─────────────────── *@
                <div class="d-flex flex-column gap-1 p-2 border-end bg-body-secondary"
                     style="width:150px; flex:0 0 150px; overflow-y:auto;">
                    <div class="small text-muted text-uppercase fw-semibold px-1">Tools</div>
                    @foreach (var t in _tools)
                    {
                        var tool = t;
                        <button type="button" data-tool="@tool.Id"
                                class="btn btn-sm text-start text-nowrap @(_tool == tool.Id ? "btn-primary" : "btn-outline-secondary")"
                                aria-pressed="@(_tool == tool.Id ? "true" : "false")"
                                @onclick="@(() => SetTool(tool.Id))" title="@tool.Hint">
                            <BenIcon Name="@tool.Icon" Class="me-1" />@tool.Label
                        </button>
                    }
                    <div class="small text-muted text-uppercase fw-semibold px-1 mt-2">Selected mark</div>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="DeleteSelected" title="Delete the selected mark"><BenIcon Name="trash-2" Class="me-1" />Delete</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="BringForward" title="Bring the selected mark forward"><BenIcon Name="chevron-up" Class="me-1" />Forward</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="SendBackward" title="Send the selected mark backward"><BenIcon Name="chevron-down" Class="me-1" />Backward</button>
                    <div class="small text-muted text-uppercase fw-semibold px-1 mt-2">Picture</div>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="@(()=>RotateAsync(-90))" title="Turn a quarter to the left"><BenIcon Name="rotate-ccw" Class="me-1" />Turn left</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="@(()=>RotateAsync(90))" title="Turn a quarter to the right"><BenIcon Name="rotate-cw" Class="me-1" />Turn right</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="@(()=>FlipAsync("h"))" title="Mirror left to right"><BenIcon Name="columns" Class="me-1" />Flip across</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-start text-nowrap" @onclick="@(()=>FlipAsync("v"))" title="Mirror top to bottom"><BenIcon Name="align-justify" Class="me-1" />Flip down</button>
                </div>

                @* ── The picture, with its zoom bar ──────────────────────────── *@
                <div class="d-flex flex-column" style="flex:1 1 auto; min-width:0; min-height:0;">
                    <div class="d-flex align-items-center flex-wrap gap-1 px-2 py-1 border-bottom bg-body-tertiary">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ZoomAsync("out"))" title="Zoom out" aria-label="Zoom out"><BenIcon Name="zoom-out" /></button>
                        <span class="small text-center" style="min-width:3.5rem;" data-testid="image-editor-zoom">@(_zoomPct)%</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ZoomAsync("in"))" title="Zoom in" aria-label="Zoom in"><BenIcon Name="zoom-in" /></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ZoomAsync("fit"))" title="Show the whole picture">Fit</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => ZoomAsync("actual"))" title="One photo pixel per screen pixel">100%</button>
                        <span class="small text-muted ms-2 text-truncate" style="min-width:0;" data-testid="image-editor-hint">@CurrentHint</span>
                    </div>
                    <div class="position-relative" style="flex:1 1 auto; min-height:0; background:#111;">
                        <div id="@_containerId" class="position-absolute top-0 start-0 w-100 h-100" style="overflow:hidden;"></div>
                        @if (_load != LoadState.Loaded)
                        {
                            <div class="position-absolute top-50 start-50 translate-middle text-center text-light small">
                                @if (_load == LoadState.Failed)
                                {
                                    <BenIcon Name="alert-triangle" Class="me-1" />@("This photo couldn't be loaded, so there is nothing to edit.")
                                }
                                else
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@("Loading the photo…")
                                }
                            </div>
                        }
                    </div>
                </div>

                @* ── Right panel ─────────────────────────────────────────────── *@
                <div class="d-flex flex-column p-2 border-start bg-body-secondary"
                     style="width:260px; flex:0 0 260px; overflow-y:auto; gap:0.4rem;">

                    @* Drawing options — first, and only while a tool that uses them is chosen *@
                    @if (_tool is "pen" or "text" or "rect" or "circle" or "arrow")
                    {
                        <BenPanel Title="Tool Options" Collapsed="false" Class="mb-2">
                                <div class="d-flex flex-column gap-1 pt-1">
                                    <label class="small">Color</label>
                                    <BenColorPicker @bind-Value="_drawColor" @bind-Value:after="PushToolOptionsAsync" />
                                    @if (_tool is not "text")
                                    {
                                        <label class="small" for="imageeditorplayer-width-6d61">Width @_drawWidth</label>
                                        <input id="imageeditorplayer-width-6d61" type="range" class="form-range" min="1" max="20" step="1" @bind="_drawWidth" @bind:event="oninput" @onchange="PushToolOptionsAsync" />
                                    }
                                    @if (_tool is "text")
                                    {
                                        <label class="small" for="imageeditorplayer-font-size-c8f7">Font size @_fontSize</label>
                                        <input id="imageeditorplayer-font-size-c8f7" type="range" class="form-range" min="10" max="72" step="2" @bind="_fontSize" @bind:event="oninput" @onchange="PushToolOptionsAsync" />
                                    }
                                </div>
                            </BenPanel>
                    }

                    @* Adjustments *@
                    <BenPanel Title="Adjustments" Collapsed="false" Class="mb-2">
                            <div class="d-flex flex-column gap-1 pt-1">
                                <label class="small" for="imageeditorplayer-brightness-238c">Brightness <span>@_brightness</span></label>
                                <input id="imageeditorplayer-brightness-238c" type="range" class="form-range" min="-100" max="100" step="5" @bind="_brightness" @bind:event="oninput" @onchange="@ApplyAdjustments" />
                                <label class="small" for="imageeditorplayer-contrast-8472">Contrast <span>@_contrast</span></label>
                                <input id="imageeditorplayer-contrast-8472" type="range" class="form-range" min="-100" max="100" step="5" @bind="_contrast" @bind:event="oninput" @onchange="@ApplyAdjustments" />
                                <label class="small" for="imageeditorplayer-saturation-a39c">Saturation <span>@_saturation</span></label>
                                <input id="imageeditorplayer-saturation-a39c" type="range" class="form-range" min="-100" max="100" step="5" @bind="_saturation" @bind:event="oninput" @onchange="@ApplyAdjustments" />
                                <label class="small" for="imageeditorplayer-blur-fc1c">Blur <span>@_blur</span></label>
                                <input id="imageeditorplayer-blur-fc1c" type="range" class="form-range" min="0" max="10" step="1" @bind="_blur" @bind:event="oninput" @onchange="@ApplyAdjustments" />
                            </div>
                        </BenPanel>

                    @* Filter presets *@
                    <BenPanel Title="Filter" Collapsed="true" Class="mb-2">
                            <div class="pt-1">
                                <BenSelect Data="@_presets" @bind-Value="_preset" TextField="@nameof(PresetOption.Label)" ValueField="@nameof(PresetOption.Value)" OnChange="@((string? _) => ApplyPreset())" />
                            </div>
                        </BenPanel>

                    @* Evidence tools *@
                    <BenPanel Title="Evidence Tools" Collapsed="true" Class="mb-2">
                            <div class="d-flex flex-column gap-2 pt-1">
                                <div>
                                    <strong class="small">Anomaly Highlight</strong>
                                    <div class="small text-muted">Rings in the middle of the view; drag them into place with Select.</div>
                                    <div class="d-flex gap-1 align-items-center mt-1">
                                        <BenColorPicker @bind-Value="_anomalyColor" />
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="AddAnomalyHighlight">Add</button>
                                    </div>
                                </div>
                                <div>
                                    <strong class="small">Grid Overlay</strong>
                                    <div class="mt-1">
                                        <button type="button" class="btn @(_gridOn ? "btn-warning" : "btn-secondary") btn-sm" @onclick="ToggleGrid">
                                            @(_gridOn ? "Remove Grid" : "Add Grid")
                                        </button>
                                    </div>
                                </div>
                                <div>
                                    <strong class="small">Timestamp Stamp</strong>
                                    <input type="text" class="form-control" placeholder="Text (leave blank for now)" @bind="_stampText" @bind:event="oninput" />
                                    <div class="d-flex gap-1 mt-1 flex-wrap">
                                        @foreach (var pos in new[] { ("tl","↖","Top left"), ("tr","↗","Top right"), ("bl","↙","Bottom left"), ("br","↘","Bottom right") })
                                        {
                                            var p = pos;
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(()=>AddTimestampStamp(p.Item1))" title="@p.Item3" aria-label="@p.Item3">@p.Item2</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </BenPanel>

                    @* Layers panel *@
                    <BenPanel Collapsed="false" Class="mb-2"><HeaderContent><h2>@($"Layers ({_layers.Count})")</h2></HeaderContent><ChildContent>
                            @if (_layers.Count == 0)
                            {
                                <p class="text-muted small mt-1 mb-0">Nothing added yet. Marks you draw appear here.</p>
                            }
                            else
                            {
                                <div class="d-flex flex-column gap-0 mt-1">
                                    @foreach (var layer in _layers)
                                    {
                                        var l = layer;
                                        <div class="d-flex align-items-center gap-1 py-1 border-bottom" style="font-size:0.73rem;">
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(()=>ToggleLayerVisible(l))" title="@(l.Visible ? "Hide" : "Show")"><BenIcon Name="@(l.Visible ? "eye" : "eye-off")" /></button>
                                            <span class="text-truncate flex-grow-1" title="@l.Name">@l.Name</span>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(()=>MoveLayerUp(l.Id))" title="Up"><BenIcon Name="chevron-up" /></button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(()=>MoveLayerDown(l.Id))" title="Down"><BenIcon Name="chevron-down" /></button>
                                            <button type="button" class="btn btn-danger btn-sm" @onclick="@(()=>DeleteLayer(l.Id))" title="Delete"><BenIcon Name="trash-2" /></button>
                                        </div>
                                        <div class="d-flex align-items-center gap-1 py-1">
                                            <span class="small text-muted" style="width:40px;">@l.Opacity%</span>
                                            <input type="range" class="form-range" min="0" max="100" step="5" value="@l.Opacity" @oninput="@(async e => { var v = AsRangeValue(e.Value); await SetLayerOpacity(l.Id, v); })" />
                                        </div>
                                    }
                                </div>
                            }
                        </ChildContent></BenPanel>

                </div>
            </div>
        </ChildContent>
    <FooterContent>
        @if (_imageSize is { } size)
        {
            <span class="small text-muted me-auto">
                @size.Width × @size.Height pixels · saved at this size
                @if (_restored)
                {
                    <span data-testid="image-editor-restored"> · your saved work was reopened</span>
                }
            </span>
        }
        @* These were WindowActions on the Telerik window — buttons in its title bar — and the
           conversion to a Bootstrap modal dropped them, leaving both save handlers with nothing
           calling them. There was no way to keep an edit: the editor worked and then discarded
           everything on close. They live in the footer now, which is where a modal's actions
           belong and where they are visible rather than hidden in a title bar. *@
        @if (_isDirty)
        {
            <button type="button" class="btn btn-outline-primary" @onclick="SaveEditStateAsync" disabled="@_saving"
                    title="Keep your marks and adjustments on this photo, to carry on next time. The photo itself is not changed.">
                <BenIcon Name="save" Class="me-1" />Save State
            </button>
            <button type="button" class="btn btn-primary" @onclick="SaveAsNewVersionAsync" disabled="@_saving">
                <BenIcon Name="copy" Class="me-1" />@(_saving ? "Saving…" : "Save as New Version")
            </button>
        }
        <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _show = false)">Close</button>
    </FooterContent>
</BenModal>
}

@code {

    /// <summary>
    /// Reads a range input's value. The DOM hands back a string; the handlers these replaced took
    /// a number, so parse once here rather than at each call site. A half-typed or empty value
    /// falls back to 0 instead of throwing.
    /// </summary>
    private static int AsRangeValue(object? raw)
        => int.TryParse(raw?.ToString(), System.Globalization.NumberStyles.Integer,
                        System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;
    [Parameter, EditorRequired] public Guid UploadFileId { get; set; }
    [Parameter] public string? FileName { get; set; }
    /// <summary>Override the image source URL. When null the UploadFile download URL is used.</summary>
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public EventCallback<UploadFileRecord> OnSaved { get; set; }

    private string _containerId = $"img-editor-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<ImageEditorPlayer>? _dotNetRef;

    private bool _show;
    private bool _isDirty;
    private bool _saving;
    private string _tool = "select";

    private enum LoadState { Loading, Loaded, Failed }
    private LoadState _load = LoadState.Loading;
    private int _zoomPct = 100;
    private (int Width, int Height)? _imageSize;
    private bool _restored;

    /// <summary>
    /// The tools, each with a name and a sentence on how to use it. The toolbar used to be eight
    /// bare icons - a globe for Text, a funnel for the ruler - and nothing said what any of them
    /// did. The sentence is the button's tooltip and shows above the picture while it is chosen.
    /// </summary>
    private sealed record ToolOption(string Id, string Label, string Icon, string Hint);
    private static readonly List<ToolOption> _tools =
    [
        new("select",  "Select",    "mouse-pointer",  "Drag the picture to move around it, scroll to zoom. Click a mark you added to move or resize it."),
        new("pen",     "Pen",       "edit-2",         "Draw freehand on the picture."),
        new("text",    "Text",      "type",           "Click where the text should go, then type."),
        new("rect",    "Rectangle", "square",         "Drag to draw a rectangle."),
        new("circle",  "Ellipse",   "circle",         "Drag to draw an ellipse."),
        new("arrow",   "Line",      "arrow-up-right", "Drag from one end of the line to the other."),
        new("redact",  "Redact",    "eye-off",        "Drag over anything to black it out."),
        new("measure", "Ruler",     "crosshair",      "Drag between two points to measure them, in the photo's own pixels."),
    ];

    private string CurrentHint =>
        (_tools.FirstOrDefault(t => t.Id == _tool)?.Hint ?? "")
        + (_tool == "select" ? "" : " Hold Alt and drag to move around; scroll to zoom.");

    // Adjustment state
    private int _brightness, _contrast, _saturation, _blur;
    private string _preset    = "none";
    private string _drawColor = "#ff0000";
    private int    _drawWidth = 3;
    private int    _fontSize  = 24;

    // Evidence tool state
    private string _anomalyColor = "#ff6600";
    private bool   _gridOn;
    private string _stampText = string.Empty;

    // Layers
    private List<LayerItem> _layers = [];

    /// <summary>
    /// A record, not a value tuple — see <c>SelectOptionsAreNotValueTuplesTests</c>. A tuple's
    /// element names exist only at compile time, so the picker rendered every filter as
    /// "(sepia, Sepia)" and showed blank until one was chosen (found alongside the same bug in the
    /// audio editor's colormap picker, 2026-09-06).
    /// </summary>
    private record PresetOption(string Value, string Label);
    private static readonly List<PresetOption> _presets =
    [
        new("none", "None"), new("grayscale", "Grayscale"), new("sepia", "Sepia"),
        new("invert", "Invert"), new("highcontrast", "High Contrast"),
        new("nightvision", "Night Vision"), new("heatmap", "Heat Map"),
    ];

    // ── Public API ────────────────────────────────────────────────────────────

    public async Task OpenAsync()
    {
        // A fresh start each time: the component outlives the dialog, and a second photo opened
        // from the same list should not inherit the first one's sliders, tool or layers.
        _tool = "select";
        _load = LoadState.Loading;
        _zoomPct = 100;
        _imageSize = null;
        _isDirty = false;
        _brightness = _contrast = _saturation = _blur = 0;
        _preset = "none";
        _gridOn = false;
        _layers = [];
        _restored = false;
        _show = true;
        StateHasChanged();
        await Task.Yield();
        await InitEditorAsync();
    }

    private async Task InitEditorAsync()
    {
        _module    ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/image-editor.js");
        _dotNetRef ??= DotNetObjectReference.Create(this);

        // The note that used to sit here was right at the time: the download endpoint is
        // [Authorize]-protected, so Fabric's own fromURL() — a plain, unauthenticated image load —
        // could not fetch it, and the bytes were pulled server-side instead. There is now a
        // media URL that carries the viewer's identity, so the canvas can load the image
        // directly and this process never holds a copy of it. An image being edited is a full-
        // size photograph, which made this one of the more expensive instances of that pattern.
        var imageUrl = ImageUrl ?? MediaUrls.Download(UploadFileId);
        // What "Save State" kept last time, so the photo reopens where it was left. Null for a
        // photo nobody has saved work on, and for one this person may not change.
        var editState = await AdminClient.GetImageEditStateAsync(UploadFileId);

        await _module.InvokeVoidAsync("init", _containerId, imageUrl, editState, _dotNetRef);
    }

    // ── Tools ─────────────────────────────────────────────────────────────────

    private async Task SetTool(string tool)
    {
        _tool = tool;
        if (_module is null) return;
        await _module.InvokeVoidAsync("setDrawingMode", _containerId, tool, ToolOptions());
    }

    private async Task PushToolOptionsAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("setToolOptions", _containerId, ToolOptions());
    }

    private object ToolOptions() => new { color = _drawColor, width = _drawWidth, fontSize = _fontSize };

    private async Task ZoomAsync(string action)
    {
        if (_module is not null) await _module.InvokeVoidAsync("zoom", _containerId, action);
    }

    private async Task OnClosedAsync()
    {
        // Tear the canvas down with the dialog, rather than leaving Fabric and its resize observer
        // attached to markup that is no longer on the page.
        try { if (_module is not null) await _module.InvokeVoidAsync("destroy", _containerId); }
        catch (JSDisconnectedException) { }
    }

    // ── Adjustments ───────────────────────────────────────────────────────────

    private async Task ApplyAdjustments()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("applyAdjustments", _containerId,
            new { brightness = _brightness, contrast = _contrast, saturation = _saturation, blur = _blur, hue = 0, noise = 0 });
    }

    private async Task ApplyPreset()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("applyPreset", _containerId, _preset);
    }

    // ── Transform ─────────────────────────────────────────────────────────────

    private async Task RotateAsync(int d)
    {
        if (_module is null) return;
        var size = await _module.InvokeAsync<int[]?>("rotate", _containerId, d);
        if (size is [var w, var h] && _imageSize is not null) _imageSize = (w, h);
    }
    private async Task FlipAsync(string a) { if (_module is not null) await _module.InvokeVoidAsync("flip",   _containerId, a); }

    private async Task DeleteSelected()
    {
        if (_module is not null) { await _module.InvokeVoidAsync("deleteSelected", _containerId); await RefreshLayersAsync(); }
    }

    private async Task BringForward() { if (_module is not null) await _module.InvokeVoidAsync("bringForward", _containerId); }
    private async Task SendBackward() { if (_module is not null) await _module.InvokeVoidAsync("sendBackward", _containerId); }

    // ── Evidence tools ────────────────────────────────────────────────────────

    private async Task AddAnomalyHighlight()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("addAnomalyHighlight", _containerId, new { color = _anomalyColor });
        await RefreshLayersAsync();
    }

    private async Task ToggleGrid()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("toggleGrid", _containerId,
            new { cols = 10, rows = 10, color = "rgba(255,255,255,0.3)" });
        _gridOn = !_gridOn;
        await RefreshLayersAsync();
    }

    private async Task AddTimestampStamp(string position)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("addTimestampStamp", _containerId, _stampText, position);
        await RefreshLayersAsync();
    }

    // ── Layers ────────────────────────────────────────────────────────────────

    private async Task RefreshLayersAsync()
    {
        if (_module is null) return;
        var json = await _module.InvokeAsync<string?>("getLayersJson", _containerId);
        if (!string.IsNullOrEmpty(json))
            _layers = JsonSerializer.Deserialize<List<LayerItem>>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
        StateHasChanged();
    }

    private async Task ToggleLayerVisible(LayerItem layer)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("setLayerVisible", _containerId, layer.Id, !layer.Visible);
        await RefreshLayersAsync();
    }

    private async Task SetLayerOpacity(string id, int pct)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("setLayerOpacity", _containerId, id, pct);
        await RefreshLayersAsync();
    }

    private async Task DeleteLayer(string id)
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("deleteLayer", _containerId, id);
        await RefreshLayersAsync();
    }

    private async Task MoveLayerUp(string id)   { if (_module is not null) { await _module.InvokeVoidAsync("moveLayerUp",   _containerId, id); await RefreshLayersAsync(); } }
    private async Task MoveLayerDown(string id) { if (_module is not null) { await _module.InvokeVoidAsync("moveLayerDown", _containerId, id); await RefreshLayersAsync(); } }

    // ── Save / Export ─────────────────────────────────────────────────────────

    private async Task SaveEditStateAsync()
    {
        if (_module is null || _saving) return;
        _saving = true; StateHasChanged();
        try
        {
            var json   = System.Text.Encoding.UTF8.GetString(await ReadBytesAsync("getStateBytes"));
            var result = await AdminClient.SaveImageEditStateAsync(UploadFileId, json);
            if (result is not null)
            {
                _isDirty = false;
                Toasts.Success("Edit state saved.");
                await OnSaved.InvokeAsync(result);
            }
            else
            {
                // The server refuses anybody who may not change this photo (09/25/2026); saying
                // nothing left the button looking broken.
                Toasts.Error(NotSaved);
            }
        }
        finally { _saving = false; }
    }

    private async Task SaveAsNewVersionAsync()
    {
        if (_module is null || _saving) return;
        _saving = true; StateHasChanged();
        try
        {
            // A photograph stays a JPEG: the same picture as a PNG is several times the size.
            var ext    = Path.GetExtension(FileName ?? "").ToLowerInvariant();
            var format = ext is ".jpg" or ".jpeg" ? "jpeg" : "png";
            var bytes  = await ReadBytesAsync("exportBytes", format, 0.92);
            if (bytes.Length == 0) return;
            var result = await AdminClient.SaveImageAsNewVersionAsync(UploadFileId, bytes, format);
            if (result is not null)
            {
                _isDirty = false;
                Toasts.Success("Saved as new version.");
                await OnSaved.InvokeAsync(result);
            }
            else
            {
                // The server refuses anybody who may not change this photo (09/25/2026); saying
                // nothing left the button looking broken.
                Toasts.Error(NotSaved);
            }
        }
        finally { _saving = false; }
    }

    private const string NotSaved =
        "The edit wasn't saved. A photo can only be changed by its owner, by the owners and "
        + "administrators of the group it belongs to, or by a site administrator.";

    /// <summary>
    /// Bytes from the editor through a stream, not a return value: a return value is one SignalR
    /// message, capped at 128 KB for this site, and every saved picture is bigger than that.
    /// </summary>
    private async Task<byte[]> ReadBytesAsync(string function, params object?[] extra)
    {
        if (_module is null) return [];
        var args = new object?[] { _containerId }.Concat(extra).ToArray();
        var reference = await _module.InvokeAsync<IJSStreamReference?>(function, args);
        if (reference is null) return [];
        await using (reference)
        {
            await using var stream = await reference.OpenReadStreamAsync(maxAllowedSize: 250L * 1024 * 1024);
            using var copy = new MemoryStream();
            await stream.CopyToAsync(copy);
            return copy.ToArray();
        }
    }

    // ── JS callback ───────────────────────────────────────────────────────────

    [JSInvokable]
    public void OnImageLoaded(int width, int height)
    {
        _load = LoadState.Loaded;
        _imageSize = (width, height);
        StateHasChanged();
    }

    /// <summary>Saved work was reopened: put the sliders and switches back where they were.</summary>
    [JSInvokable]
    public async Task OnStateRestored(RestoredState state)
    {
        _brightness = state.Brightness;
        _contrast   = state.Contrast;
        _saturation = state.Saturation;
        _blur       = state.Blur;
        _preset     = string.IsNullOrEmpty(state.Preset) ? "none" : state.Preset;
        _gridOn     = state.Grid;
        _restored   = true;
        _isDirty    = false;
        await RefreshLayersAsync();
    }

    public sealed record RestoredState(int Brightness, int Contrast, int Saturation, int Blur, string? Preset, bool Grid);

    [JSInvokable]
    public void OnImageFailed()
    {
        _load = LoadState.Failed;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnZoomChanged(int percent)
    {
        _zoomPct = percent;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnEditorChanged()
    {
        _isDirty = true;
        _ = RefreshLayersAsync();
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("destroy", _containerId);
            await _module.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }

    // ── Types ─────────────────────────────────────────────────────────────────

    private sealed record LayerItem(string Id, string Name, bool Visible, int Opacity, string Type);
}
