@page "/publications"
@namespace Ben.Web.Website.Library.Publications
@using Ben.Service.Models.Publications

@inject IBenAdminClient Client
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>Publications</PageTitle>

@*
    The public directory.

    No sign-in check anywhere in this file, and that is the point: a publication a stranger cannot
    read is a newsletter with no readers. The client's public calls send no bearer token even when
    the reader happens to be signed in, so this page renders for the author exactly what it renders
    for a visitor — which is the only way the visitor's path ever gets tested.

    Publications with nothing published in them are not listed. The API leaves them out; the page
    does not need to know that, but a reader clicking a title always lands on something.
*@

<FeatureGate Flag="@SiteFeatures.Publications">
    @* Signal phase 2: the photograph and the title in one frame, the count in its tile. *@
    <PageHero Photo="v3-hotel-lobby" TestId="publications-hero" Compact="true"
              Kicker="Long-form writing" Title="Publications"
              Lede="From investigation groups — case write-ups, field notes and research, free for anyone to read."
              Facts="@HeroFacts">
        <div><a class="btn btn-sm btn-outline-light" href="/help/reading-publications">How publications work</a></div>
    </PageHero>

    <div class="home-band">

        @* Subscriptions appear only for somebody signed in, and only when they have some. A
           reader with no account never sees an empty box asking about a concept they have not
           met yet. This is also the only place the subscription list is readable — an endpoint
           with no surface is a feature nobody can use. *@
        @if (_subscriptions.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header"><strong>You subscribe to</strong></div>
                <ul class="list-group list-group-flush">
                    @foreach (var subscription in _subscriptions)
                    {
                        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <a class="fw-bold text-decoration-none"
                                   href="/publications/@subscription.PublicationUrlName">
                                    @subscription.PublicationTitle
                                </a>
                                <div class="small text-secondary">@subscription.OrganizationName</div>
                            </div>
                            <div class="small text-secondary">
                                @if (subscription.LatestPostUtc is { } latest)
                                {
                                    <span>Latest @latest.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy")</span>
                                }
                                else
                                {
                                    <span>Nothing posted yet</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        @if (_loading)
        {
            <p class="text-secondary">Loading…</p>
        }
        else if (_publicationsResult.Failed)
        {
            @* A visitor browsing the directory cannot tell a broken list from an empty one. *@
            <BenListState TItem="PublicPublicationRecord" Result="@_publicationsResult" OnRetry="@OnInitializedAsync" />
        }
        else if (_publications.Count == 0)
        {
            <div class="ben-empty">
                <img class="ben-empty__mark" src="/static/images/is-haunted-logo.svg" alt="" aria-hidden="true" />
                <div class="ben-empty__title">No group has published anything yet.</div>
                <p class="ben-empty__text">
                    When a group writes up a case or its field notes for the public, it appears here —
                    and anyone can read it, with or without an account.
                </p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var publication in _publications)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        @* A journal's cover: a plate in its own color with its initials set
                           large, then what it is and who writes it. *@
                        <a class="pub-card" href="/publications/@publication.UrlName" style="@TourPlate.HueStyle(publication.Title)">
                            <span class="pub-card__cover" aria-hidden="true">
                                <span class="pub-card__mono">@TourPlate.Monogram(publication.Title)</span>
                            </span>
                            <span class="pub-card__body">
                                <span class="pub-card__by">@publication.OrganizationName</span>
                                <span class="pub-card__title">@publication.Title</span>
                                @if (!string.IsNullOrWhiteSpace(publication.Description))
                                {
                                    <span class="pub-card__desc">@publication.Description</span>
                                }
                                <span class="pub-card__meta">
                                    <span class="pub-card__count">@publication.PostCount @(publication.PostCount == 1 ? "post" : "posts")</span>
                                    @if (publication.LatestPostUtc is { } latest)
                                    {
                                        <span>latest @latest.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy")</span>
                                    }
                                </span>
                            </span>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</FeatureGate>

@code {
    /// <summary>What the directory holds, once loaded — never a typed number.</summary>
    private IReadOnlyList<BenFactItem>? HeroFacts =>
        _publications.Count == 0 ? null :
        [
            new("Publications", _publications.Count.ToString(), "to read", Emphasis: true),
            new("Posts", _publications.Sum(p => p.PostCount).ToString(), "published"),
        ];

    private IReadOnlyList<PublicPublicationRecord> _publications = [];
    private LoadResult<PublicPublicationRecord> _publicationsResult;
    private IReadOnlyList<MySubscriptionRecord> _subscriptions = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // The directory itself never waits for auth. Waiting would delay the one page that has to
        // work for somebody who will never sign in — and the wait can never complete for them.
        try
        {
            _publicationsResult = await Client.GetPublicPublicationsAsync();
            _publications       = _publicationsResult.Items;
        }
        finally
        {
            _loading = false;
        }

        // Only then, and only for a reader who has an account, the subscriptions strip.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) return;

        _subscriptions = (await Client.GetMySubscriptionsAsync()).Items;
        StateHasChanged();
    }
}
