@page "/notifications"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@implements IDisposable

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NotificationState Notifications
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>Notifications</PageTitle>

<div class="container py-3" style="max-width:900px;">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0">Notifications<HelpLink Slug="getting-started" Anchor="notifications" /></h3>
        <button type="button" class="btn btn-outline-secondary" @onclick="RefreshAllAsync"><BenIcon Name="rotate-ccw" Class="me-1" />Refresh</button>
    </div>

    @* ── Waiting on you ───────────────────────────────────────────────────── *@
    <h6 class="text-secondary text-uppercase small mb-2">Waiting on you</h6>
    @* W-CL3: the same list the bell and the sidebar badge read, so "nothing is waiting" and the
       rows below it can never disagree. See NotificationRows. *@
    @if (_rows.Count == 0)
    {
        <div class="alert alert-light border">You're all caught up — nothing is waiting on you.</div>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var row in _rows)
            {
                <button type="button"
                        class="list-group-item list-group-item-action d-flex align-items-center gap-3"
                        @onclick="@(() => NavManager.NavigateTo(row.Destination))">
                    <BenIcon Name="@row.Icon" />
                    <span class="flex-grow-1 text-start">
                        <span class="d-block">@row.Title</span>
                        <span class="d-block text-secondary small">@row.Detail</span>
                    </span>
                    <span class="@NotificationBadge.CssClass(row.Bucket)">
                        @NotificationBadge.Text(row.Bucket.Count)
                    </span>
                </button>
            }
        </div>
    }

    @* ── Permission requests ──────────────────────────────────────────────── *@
    @if (_pendingRequests.Count > 0)
    {
        <h6 class="text-secondary text-uppercase small mb-2">File permission requests</h6>
        <div class="list-group mb-4">
            @foreach (var req in _pendingRequests)
            {
                <div class="list-group-item">
                    <div class="d-flex align-items-start gap-3">
                        <div class="flex-grow-1">
                            <div>
                                <strong>@(req.RequestedByDisplayName ?? "Someone")</strong>
                                requested <strong>@req.PermissionType</strong> access to
                                <strong>@(req.FileName ?? "a file")</strong>
                                @if (req.OrganizationName is not null)
                                {
                                    <text> on behalf of @req.OrganizationName</text>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(req.RequestNotes))
                            {
                                <div class="text-secondary small mt-1">“@req.RequestNotes”</div>
                            }
                            <div class="text-secondary small mt-1">
                                @req.DateCreated.ToViewerLocalTime(UserState).ToDisplayDateTime()
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => ReviewAsync(req, FilePermissionRequestStatus.Approved))" disabled="@(!(_reviewingId != req.Id))">Approve</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => ReviewAsync(req, FilePermissionRequestStatus.Denied))" disabled="@(!(_reviewingId != req.Id))">Deny</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Platform messages ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h6 class="text-secondary text-uppercase small mb-0">Messages</h6>
        @if (_messages.Any(m => m.ReadUtc is null))
        {
            <button type="button" class="btn btn-link text-decoration-none btn-sm" @onclick="MarkAllReadAsync" disabled="@(!(!_markingAll))">Mark all read</button>
        }
    </div>

    @if (_loadingMessages)
    {
        <div class="text-secondary small">Loading…</div>
    }
    @* The list is edited in place when a message is marked read, so the failure is branched on
       rather than wrapping the list — a wrapped BenListState would keep reporting the load's own
       emptiness. "No messages." to somebody who has been written to is the whole of item 120. *@
    else if (_messagesResult.Failed)
    {
        <BenListState TItem="MyMessageRecord" Result="@_messagesResult" OnRetry="@LoadDetailAsync" />
    }
    else if (_messages.Count == 0)
    {
        <div class="alert alert-light border">No messages.</div>
    }
    else
    {
        @* The same rows as a group's inbox. Platform messages are mail — a sender, a subject, a
           body — so they read as mail here too, rather than as a second list style someone has to
           learn. The two sections above stay list-groups on purpose: they are actions waiting on a
           decision, not correspondence, and a mail row has nowhere to put an Approve button. *@
        <div class="card">
            <div class="card-body p-0">
                <ul class="notification">
                    @foreach (var m in _messages)
                    {
                        var msg = m;
                        <MailRow Sender="@SenderLabel(msg)"
                                 Subject="@msg.Subject"
                                 Body="@msg.Body"
                                 BodyIsHtml="true"
                                 When="@msg.SentUtc.ToViewerLocalTime(UserState).ToDisplayDateTime()"
                                 Unread="@(msg.ReadUtc is null)"
                                 Selected="@(_openMessage?.Id == msg.Id)"
                                 OnOpen="@(() => OpenMessageAsync(msg))">
                            <Badge>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@msg.TypeName</span>
                            </Badge>
                        </MailRow>
                    }
                </ul>
            </div>
        </div>

        @* Read below the list, not in a dialog — the same shape a group's inbox uses, and it keeps
           the list in view while reading. *@
        @if (_openMessage is not null)
        {
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <div class="flex-grow-1">
                            <h5 class="mb-1">@(string.IsNullOrWhiteSpace(_openMessage.Subject) ? "(no subject)" : _openMessage.Subject)</h5>
                            <div class="text-secondary small">
                                From: @SenderLabel(_openMessage)
                                · @_openMessage.SentUtc.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                · <span class="badge bg-secondary-subtle text-secondary-emphasis">@_openMessage.TypeName</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm"
                                @onclick="@(() => _openMessage = null)">Close</button>
                    </div>
                    <div class="border-top pt-3">
                        <MessageBody Body="@_openMessage.Body" Html="true" />
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<MyMessageRecord> _messages = [];
    private LoadResult<MyMessageRecord> _messagesResult;
    private LoadResult<PendingPermissionRequestRecord> _pendingRequestsResult;
    private List<PendingPermissionRequestRecord> _pendingRequests = [];

    private MyMessageRecord? _openMessage;
    private bool  _loadingMessages = true;
    private bool  _markingAll;
    private Guid? _reviewingId;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }

        Notifications.Changed += OnNotificationsChanged;
        await Notifications.EnsureStartedAsync(RendererInfo.IsInteractive);
        SetSummary(Notifications.Current);

        await LoadDetailAsync();
    }

    private void OnNotificationsChanged() => InvokeAsync(() =>
    {
        SetSummary(Notifications.Current);
        StateHasChanged();
    });

    /// <summary>
    /// The rows this page shows, and therefore the number it stands over (W-CL3).
    /// </summary>
    /// <remarks>
    /// The page used to keep the summary and read <c>TotalCount</c> off it to decide whether to
    /// say "you're all caught up", then render a list built separately — so it could say
    /// something was waiting and show nothing. It now holds only the rows.
    /// </remarks>
    private void SetSummary(NotificationSummaryResponse summary) =>
        _rows = NotificationRows.For(summary);

    private async Task LoadDetailAsync()
    {
        _loadingMessages = true;
        try
        {
            var messagesTask = AdminClient.GetMyMessagesAsync();
            var requestsTask = AdminClient.GetPendingPermissionRequestsForMeAsync();
            await Task.WhenAll(messagesTask, requestsTask);
            _messagesResult  = await messagesTask;
            _messages        = _messagesResult.Items.ToList();
            _pendingRequestsResult = await requestsTask;
            _pendingRequests       = [.. _pendingRequestsResult.Items];
        }
        catch
        {
            _messagesResult  = LoadResult<MyMessageRecord>.Failure();
            _messages        = [];
            _pendingRequests = [];
        }
        finally
        {
            _loadingMessages = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAllAsync()
    {
        await Notifications.RefreshAsync(force: true);
        await LoadDetailAsync();
    }

    private async Task OpenMessageAsync(MyMessageRecord msg)
    {
        _openMessage = msg;

        if (msg.ReadUtc is not null) return;

        if (await AdminClient.MarkMyMessageReadAsync(msg.Id))
        {
            // Patch locally instead of refetching the list — the reading pane is already showing
            // this message, and a refetch would reorder nothing but cost a round trip.
            var index = _messages.IndexOf(msg);
            if (index >= 0) _messages[index] = msg with { ReadUtc = DateTime.UtcNow };
            await Notifications.RefreshAsync(force: true);
        }
    }

    private async Task MarkAllReadAsync()
    {
        _markingAll = true;
        try
        {
            if (await AdminClient.MarkAllMyMessagesReadAsync() > 0)
            {
                var now = DateTime.UtcNow;
                _messages = [.. _messages.Select(m => m.ReadUtc is null ? m with { ReadUtc = now } : m)];
                await Notifications.RefreshAsync(force: true);
            }
        }
        finally { _markingAll = false; }
    }

    private async Task ReviewAsync(PendingPermissionRequestRecord req, FilePermissionRequestStatus status)
    {
        _reviewingId = req.Id;
        try
        {
            if (await AdminClient.ReviewPermissionRequestAsync(req.Id, status, reviewNotes: null))
            {
                _pendingRequests.Remove(req);
                await Notifications.RefreshAsync(force: true);
            }
        }
        finally { _reviewingId = null; }
    }

    /// <summary>
    /// What is waiting, from the one shared list (W-CL3). Recomputed whenever the summary does.
    /// </summary>
    /// <remarks>
    /// Buckets with nothing in them produce no row, so this page stays a to-do list rather than a
    /// dashboard of zeroes.
    /// </remarks>
    private IReadOnlyList<NotificationRow> _rows = [];

    /// <summary>
    /// How to name a message's author. "Anonymous" states that we are withholding it; "Unknown" is
    /// what a missing name means. Conflating them would tell someone who asked a question
    /// anonymously that their identity merely got lost.
    /// </summary>
    private static string SenderLabel(MyMessageRecord msg)
        => msg.SenderHidden ? "Anonymous" : (msg.SentByDisplayName ?? "Unknown");

    public void Dispose() => Notifications.Changed -= OnNotificationsChanged;
}
