@*
    The order summary (storefront S3.5), after Smarty's cart summary (shop-page-cart-1.html):
    Products, Discount, Shipping, Sales tax, the total, the way on, and the small print.

    Two substitutions, stated once in the plan: Smarty's "Fees" line is our Sales tax — its own
    line, never folded into a total — and on the cart the total is "Total before tax", because
    Stripe Tax only works the tax out at checkout from the address. Every figure comes from the
    server: the cart record on the cart, and at checkout — once the order is placed — the order's
    own totals (Totals), which is what the card will be charged. This component adds nothing up.
*@

<div class="ben-summary @(Sticky ? "ben-summary--sticky" : null)" data-testid="order-summary">
    <h2 class="h5 mb-3">Order summary</h2>

    <div class="ben-summary__row" data-testid="summary-products">
        <span>Products</span><span>@StoreMoney.Format(Totals?.Subtotal ?? Cart.Subtotal)</span>
    </div>
    @if ((Totals?.Discount ?? Cart.Discount) is > 0 and var discount)
    {
        <div class="ben-summary__row text-success" data-testid="summary-discount">
            <span>Discount@(Cart.CouponCode is { } code ? $" ({code})" : null)</span><span>−@StoreMoney.Format(discount)</span>
        </div>
    }
    <div class="ben-summary__row" data-testid="summary-shipping">
        <span>Shipping</span>
        @if (Totals is { } placed)
        {
            <span class="@(placed.Shipping == 0 ? "text-success fw-medium" : null)">@(placed.Shipping == 0 ? "Free" : StoreMoney.Format(placed.Shipping))</span>
        }
        else
        {
            <span class="@(Cart.Shipping is null ? "text-secondary" : Cart.ShippingIsFree ? "text-success fw-medium" : null)">@Cart.ShippingText</span>
        }
    </div>
    <StoreParcelRows Parcels="@(Totals is { } t0 ? t0.Parcels : Cart.Parcels)" ShowNotes="@(Totals is null)" />
    @* fees slot — Smarty's "Fees" line; the store charges none beyond sales tax *@
    <div class="ben-summary__row" data-testid="summary-tax">
        <span>Sales tax</span>
        @if ((Totals?.Tax ?? Tax) is { } tax)
        {
            <span>@StoreMoney.Format(tax)</span>
        }
        else
        {
            <span class="text-secondary">–</span>
        }
    </div>
    @if (Totals is null && Tax is null)
    {
        <div class="small text-secondary">@(AtCheckout ? "Sales tax is worked out from your address when you continue." : "Sales tax is worked out at checkout.")</div>
    }
    @if (Totals is null && FreeShippingNote is { } note)
    {
        <div class="small text-secondary mt-1" data-testid="summary-free-note">@note</div>
    }

    <div class="ben-summary__row ben-summary__total" data-testid="summary-total">
        <span>@(Totals is null && Tax is null ? "Total before tax" : "Total")</span>
        <span>@StoreMoney.Format(Totals?.Total ?? (Tax is { } t ? Cart.TotalBeforeTax + t : Cart.TotalBeforeTax))</span>
    </div>

    @* reward-points slot — Smarty's points line; not in v1 *@

    <div class="mt-3">
        @if (!Cart.CanCheckout && Cart.WhyNotCheckout is { } why)
        {
            <p class="small text-warning-emphasis mb-0" data-testid="summary-why-not">@why</p>
        }
        else
        {
            @Cta
        }
    </div>

    <hr />
    <ul class="list-unstyled small mb-0 d-flex flex-wrap gap-3">
        <li><a class="ben-link-muted" href="/store/returns">Returns</a></li>
        <li><a class="ben-link-muted" href="/privacy">Privacy</a></li>
        <li><a class="ben-link-muted" href="/terms">Terms</a></li>
    </ul>
    <div class="text-end small pt-2">
        Need help?
        @if (!string.IsNullOrWhiteSpace(Cart.SupportEmail))
        {
            <a href="@($"mailto:{Cart.SupportEmail}")">Contact us</a>
        }
        else
        {
            <a href="/contact">Contact us</a>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StoreCartView Cart { get; set; } = default!;

    /// <summary>The worked-out sales tax at checkout; null on the cart, where it is not known yet.</summary>
    [Parameter] public decimal? Tax { get; set; }

    /// <summary>The placed order's figures at checkout — what the card will be charged. Wins over the cart's.</summary>
    [Parameter] public StoreCheckoutTotals? Totals { get; set; }

    /// <summary>On the checkout page, before the order is placed: the tax note says when it will be known.</summary>
    [Parameter] public bool AtCheckout { get; set; }

    /// <summary>The way on — "To checkout" — shown only when the cart can check out.</summary>
    [Parameter] public RenderFragment? Cta { get; set; }

    [Parameter] public bool Sticky { get; set; }

    /// <summary>
    /// "Spend $12.50 more for free shipping", while that is true — for a cart that ships as one
    /// package. Split into packages, each package's row says it for itself (store sellers P6).
    /// </summary>
    private string? FreeShippingNote
        => Cart is { IsEmpty: false, ShippingIsFree: false, FreeShippingThreshold: > 0, IsSplit: false }
           && (Cart.Parcels is [{ MoreForFree: { } left }] ? left : Cart.FreeShippingThreshold - (Cart.Subtotal - Cart.Discount)) is var more && more > 0
            ? $"Spend {StoreMoney.Format(more)} more for free shipping."
            : null;
}
