@inject IBenUserState UserState

@*
    A seller's earnings, whole (store sellers, backlog 251, P10): what's owed, what's payable now,
    what's still inside the returns window, what's been paid — then by item, by order, the payments,
    each year's totals and every line. The seller's own page and the store's page for them both draw
    this, so the two never disagree about a number. It injects nothing that can change anything.
*@

<div class="row g-3 mb-3" data-testid="earnings-summary">
    <div class="col-6 col-lg-3"><StatCard Label="Owed to you" Value="@StoreMoney.Format(Earnings.Owed)" Icon="dollar-sign" /></div>
    <div class="col-6 col-lg-3" data-testid="earnings-payable"><StatCard Label="Ready to pay" Value="@StoreMoney.Format(Earnings.PayableNow)" Icon="check-circle" /></div>
    <div class="col-6 col-lg-3"><StatCard Label="Inside the returns window" Value="@StoreMoney.Format(Earnings.Waiting)" Icon="clock" /></div>
    <div class="col-6 col-lg-3" data-testid="earnings-paid"><StatCard Label="Paid to date" Value="@StoreMoney.Format(Earnings.PaidToDate)" Icon="archive" /></div>
</div>
<p class="small text-secondary">
    Earnings count when a package ships: cost + asking price for each unit, and the label credit. They're ready to pay once they're
    older than the returns window (up to @Earnings.Cutoff.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy")), so a return can't take them back after.
</p>

<div class="row g-3">
    <div class="col-lg-6">
        <h2 class="h6 fw-bold">By item</h2>
        @if (Earnings.Items.Count == 0) { <p class="small text-secondary">Nothing yet.</p> }
        else
        {
            <table class="table table-sm small" data-testid="earnings-items">
                <thead><tr><th>Item</th><th class="text-end">Units</th><th class="text-end">Earned</th></tr></thead>
                <tbody>
                    @foreach (var i in Earnings.Items)
                    {
                        <tr><td>@i.Name</td><td class="text-end">@i.Units</td><td class="text-end">@StoreMoney.Format(i.Earned)</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h6 fw-bold">By order</h2>
        @if (Earnings.Orders.Count == 0) { <p class="small text-secondary">Nothing yet.</p> }
        else
        {
            <table class="table table-sm small" data-testid="earnings-orders">
                <thead><tr><th>Order</th><th>Earned on</th><th class="text-end">Earned</th><th></th></tr></thead>
                <tbody>
                    @foreach (var o in Earnings.Orders)
                    {
                        <tr>
                            <td>@o.OrderNumber</td><td>@o.EarnedUtc.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy")</td>
                            <td class="text-end">@StoreMoney.Format(o.Earned)</td>
                            <td>@if (o.Paid) { <span class="badge bg-success-subtle text-success-emphasis">Paid</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h6 fw-bold">Payments</h2>
        @if (Earnings.Payouts.Count == 0) { <p class="small text-secondary">No payments yet.</p> }
        else
        {
            <table class="table table-sm small" data-testid="earnings-payouts">
                <thead><tr><th>Paid on</th><th>Covers up to</th><th class="text-end">Amount</th><th>Reference</th>@if (Actions is not null) { <th></th> }</tr></thead>
                <tbody>
                    @foreach (var p in Earnings.Payouts)
                    {
                        <tr class="@(p.VoidedUtc is not null ? "text-decoration-line-through text-secondary" : null)" data-testid="earnings-payout">
                            <td>@p.PaidOnUtc.ToString("MM/dd/yyyy")</td><td>@p.CutoffUtc.ToString("MM/dd/yyyy")</td>
                            <td class="text-end">@StoreMoney.Format(p.Amount)</td>
                            <td>@p.Reference@(p.VoidedUtc is not null ? $" — voided: {p.VoidReason}" : null)</td>
                            @if (Actions is not null) { <td class="text-end">@Actions(p)</td> }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h6 fw-bold">By year</h2>
        @if (Earnings.Years.Count == 0) { <p class="small text-secondary">Nothing yet.</p> }
        else
        {
            <table class="table table-sm small" data-testid="earnings-years">
                <thead><tr><th>Year</th><th class="text-end">Earned</th><th class="text-end">Paid</th></tr></thead>
                <tbody>
                    @foreach (var y in Earnings.Years)
                    {
                        <tr><td>@y.Year</td><td class="text-end">@StoreMoney.Format(y.Earned)</td><td class="text-end">@StoreMoney.Format(y.Paid)</td></tr>
                    }
                </tbody>
            </table>
            <p class="small text-secondary">What was paid in a calendar year is what goes on that year's tax forms.</p>
        }
    </div>
</div>

<h2 class="h6 fw-bold mt-2">Every line</h2>
<div class="table-responsive">
    <table class="table table-sm small" data-testid="earnings-lines">
        <thead><tr><th>Date</th><th>For</th><th>Order</th><th class="text-end">Amount</th><th></th></tr></thead>
        <tbody>
            @foreach (var l in Earnings.Lines)
            {
                <tr data-testid="earnings-line">
                    <td class="text-nowrap">@l.OccurredUtc.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy")</td>
                    <td>@Kind(l.Kind)@(l.Note is { } n ? $" — {n}" : null)</td>
                    <td>@l.OrderNumber</td>
                    <td class="text-end @(l.Amount < 0 ? "text-danger" : null)">@StoreMoney.Format(l.Amount)</td>
                    <td>@if (l.PayoutId is not null) { <span class="badge bg-success-subtle text-success-emphasis">Paid</span> }</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public SellerEarningsRecord Earnings { get; set; } = null!;

    /// <summary>The store's page puts a Void button on each payment; the seller's has none.</summary>
    [Parameter] public RenderFragment<SellerPayoutRecord>? Actions { get; set; }

    private static string Kind(StoreEarningKind kind) => kind switch
    {
        StoreEarningKind.Sale => "Sale",
        StoreEarningKind.Shipping => "Label credit",
        StoreEarningKind.Refund => "Refund",
        _ => "Adjustment",
    };
}
