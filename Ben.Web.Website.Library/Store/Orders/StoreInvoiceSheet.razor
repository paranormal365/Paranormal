@inject IBenUserState User

@*
    The invoice itself (storefront S4.13), after Smarty's invoice.html: who it is from and to, the
    lines with quantity, unit price, discount and tax, and the totals — refunds and the balance
    included. A component so the buyer's invoice page and the admin's (S5) print the same sheet.
*@

<div class="card ben-invoice" data-testid="invoice-sheet">
    <div class="card-header px-sm-5 py-4">
        <div class="row">
            <div class="col-sm-6 mb-2 mb-sm-0">
                <span class="h4 mb-0">@Invoice.BillFrom.Name</span>
            </div>
            <div class="col-sm-6 text-sm-end">
                <h1 class="h4 mb-0">Invoice: #@Invoice.OrderNumber</h1>
                <p class="mb-0">@((Invoice.PaidUtc ?? Invoice.PlacedUtc).ToViewerLocalTime(User).ToString("MM/dd/yyyy h:mm tt"))</p>
            </div>
        </div>
    </div>
    <div class="card-body px-sm-5">
        <div class="row my-3">
            <div class="col-sm-4 mb-4">
                <h2 class="h6">Bill from</h2>
                @Party(Invoice.BillFrom)
            </div>
            <div class="col-sm-4 mb-4">
                <h2 class="h6">Bill to</h2>
                @Party(Invoice.BillTo)
            </div>
            <div class="col-sm-4 mb-4 text-sm-end">
                <h2 class="h6">Ship to</h2>
                @Party(Invoice.ShipTo)
            </div>
        </div>

        <div class="table-responsive mb-4">
            <table class="table table-borderless border-bottom mb-0">
                <thead class="border-top border-bottom">
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col" class="text-center">Qty</th>
                        <th scope="col" class="text-end">Unit price</th>
                        <th scope="col" class="text-end">Discount</th>
                        <th scope="col" class="text-end">Tax</th>
                        <th scope="col" class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Invoice.Lines)
                    {
                        <tr data-testid="invoice-line">
                            <th scope="row" class="fw-medium">
                                @line.Description
                                <small class="d-block text-secondary fw-normal">SKU: @line.Sku</small>
                            </th>
                            <td class="text-center">@line.Quantity</td>
                            <td class="text-end text-nowrap">@StoreMoney.Format(line.UnitPrice)</td>
                            <td class="text-end text-nowrap">@(line.Discount > 0 ? $"−{StoreMoney.Format(line.Discount)}" : "–")</td>
                            <td class="text-end text-nowrap">@StoreMoney.Format(line.Tax)</td>
                            <td class="text-end text-nowrap">@StoreMoney.Format(line.Subtotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-sm-8 col-lg-6">
                <dl class="row g-0 text-end mb-0" data-testid="invoice-totals">
                    <dt class="col-7 fw-normal">Products</dt><dd class="col-5">@StoreMoney.Format(Invoice.Subtotal)</dd>
                    @if (Invoice.Discount > 0)
                    {
                        <dt class="col-7 fw-normal">Discount@(Invoice.CouponCode is { } c ? $" ({c})" : null)</dt><dd class="col-5">−@StoreMoney.Format(Invoice.Discount)</dd>
                    }
                    <dt class="col-7 fw-normal">Shipping</dt><dd class="col-5">@(Invoice.Shipping == 0 ? "Free" : StoreMoney.Format(Invoice.Shipping))</dd>
                    <dt class="col-7 fw-normal">Sales tax</dt><dd class="col-5">@StoreMoney.Format(Invoice.Tax)</dd>
                    <dt class="col-7">Total</dt><dd class="col-5 fw-bold">@StoreMoney.Format(Invoice.Total)</dd>
                    @if (Invoice.Refunded > 0)
                    {
                        <dt class="col-7 fw-normal">Refunded</dt><dd class="col-5">−@StoreMoney.Format(Invoice.Refunded)</dd>
                        <dt class="col-7">Balance</dt><dd class="col-5 fw-bold" data-testid="invoice-balance">@StoreMoney.Format(Invoice.Balance)</dd>
                    }
                </dl>
            </div>
        </div>

        <p class="small text-secondary mt-4 mb-0">
            Paid by card.
            @if (Invoice.Carrier is { } carrier) { <text>Shipped by @carrier@(Invoice.TrackingNumber is { } t ? $", tracking {t}" : null).</text> }
            Returns within @Invoice.ReturnsWindowDays days of delivery.
            @if (Invoice.SupportEmail is { } support) { <text>Questions: @support</text> }
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StoreInvoiceRecord Invoice { get; set; } = default!;

    private static RenderFragment Party(StoreInvoiceParty v) => __builder =>
    {
        var lines = new[] { v.Name, v.Company, v.Street1, v.Street2, $"{v.City}, {v.State} {v.Zip}".Trim(' ', ','), v.Email }
            .Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
        <address class="mb-0">
            @for (var i = 0; i < lines.Count; i++)
            {
                @if (i > 0) { <br /> }
                @lines[i]
            }
        </address>
    };
}
