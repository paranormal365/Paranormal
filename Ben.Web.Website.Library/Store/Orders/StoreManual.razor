@page "/store/orders/{OrderId:guid}/manuals/{FileId:guid}"
@page "/store/manuals/{FileId:guid}"
@using Ben.Web.Website.Library.Store.Shared
@inject IBenAdminClient Store
@inject IBenUserState User
@inject NavigationManager Nav

<PageTitle>@(_manual is { } m ? m.Title : "Manual") — Store</PageTitle>

@*
    A written manual, to read or print (store sellers, backlog 251, P11). Two ways in: from a paid
    order — by its buyer signed in, or with the order's private link — for a manual given to buyers;
    or directly, for the store's staff and the product's seller, private manuals included. Either
    way the API decides and answers 404 to anybody else. NOT behind the store switch. The HTML was
    sanitised when it was saved.
*@

<div class="container-fluid px-3 py-3" style="max-width:64rem;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 ben-invoice-toolbar">
        @if (OrderId is { } order)
        {
            <a class="ben-link-muted small d-inline-flex align-items-center gap-1" href="@OrderHref(order)"><BenIcon Name="arrow-left" /> Back to the order</a>
        }
        else { <span></span> }
        <div class="d-flex align-items-center gap-2">
            <HelpLink Slug="shopping-at-the-store" Anchor="downloads" />
            @if (_manual is not null)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" id="manual-print" onclick="window.print()"><BenIcon Name="printer" /> Print</button>
            }
        </div>
    </div>

    @if (_loaded is null)
    {
        <div class="text-center text-secondary py-5"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading the manual…</div>
    }
    else if (_manual is { } manual)
    {
        <article class="ben-manual" data-testid="store-manual">
            <p class="text-secondary small mb-1">@manual.ProductName</p>
            <h1 class="h3 mb-1">@manual.Title</h1>
            @if (manual.VersionLabel is { } v) { <p class="text-secondary small">Version @v</p> }
            <div class="mt-3">@((MarkupString)manual.Html)</div>
        </article>
    }
    else if (_refusal is not null)
    {
        <div class="alert alert-danger" role="alert" id="manual-refusal">@_refusal</div>
    }
    else
    {
        <StoreEmptyState Icon="file-text" Title="There's no manual here"
                         Lead="A manual opens for the people who bought the item, once their order is paid."
                         LinkText="Find my order" LinkHref="/store/orders/lookup" />
    }
</div>

@code {
    [Parameter] public Guid? OrderId { get; set; }
    [Parameter] public Guid FileId { get; set; }
    [SupplyParameterFromQuery(Name = "t")] public string? Token { get; set; }

    private StoreManualRecord? _manual;
    private bool? _loaded;
    private string? _refusal;

    private string OrderHref(Guid order) => string.IsNullOrEmpty(Token) ? $"/store/orders/{order}" : $"/store/orders/{order}?t={Uri.EscapeDataString(Token)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        await User.AuthReady;
        var read = OrderId is { } order
            ? await Store.GetStoreOrderManualAsync(order, FileId, Token)
            : await Store.GetStoreProductManualAsync(FileId);
        if (read.IsEmpty && string.IsNullOrEmpty(Token) && !User.IsAuthenticated)
        {
            Nav.NavigateTo(SignInLink.For(Nav));
            return;
        }
        _refusal = read.Failed ? read.Reason ?? "The manual couldn't be loaded just now." : null;
        _manual = read.Item;
        _loaded = true;
        StateHasChanged();
    }
}
