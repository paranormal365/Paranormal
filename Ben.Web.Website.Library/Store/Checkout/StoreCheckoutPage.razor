@page "/store/checkout"
@using Ben.Web.Website.Library.Store.Shared
@implements IAsyncDisposable
@inject StoreCartState CartState
@inject IBenAdminClient Store
@inject IBenUserState User
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Checkout — Store</PageTitle>

@*
    The checkout (storefront S4.11), after Smarty's checkout (shop-page-checkout.html): Delivery —
    who is ordering, where it goes, how it travels — then the items, the small print and the
    button, with the order summary beside them from the xl break (under them below it, as on the
    cart page) and a bar pinned to the bottom of a phone.

    Two steps on one page. "Continue to payment" sends the form: the server places the order —
    stock and the discount code held, tax worked out from the address — and answers with a
    PaymentIntent. The form then locks into a read-only summary (CheckoutForm), Stripe's Payment
    Element mounts, and the steps move to Payment. "Edit" throws that order away and unlocks;
    the next Continue prices again. So the card always pays for exactly what the page shows.

    The hold runs out (store settings, 15 minutes by default): a countdown says so, the order's
    status is re-read every 30 seconds, and when the hold is gone the page prepares again by
    itself — "we've checked stock again" — instead of letting Stripe refuse a stale payment.

    Test checkout (Development, no Stripe key): no card form; "Place order" pays through the
    dev route, as the webhook would.
*@

<FeatureGate Flag="@SiteFeatures.Store">
    <div class="container-fluid px-3 py-3" style="max-width:80rem;">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="/store">Store</a></li>
                <li class="breadcrumb-item"><a href="/store/cart">My cart</a></li>
                <li class="breadcrumb-item active" aria-current="page">Checkout</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h1 class="h3 mb-0">Checkout<HelpLink Slug="shopping-at-the-store" Anchor="placing-an-order" /></h1>
            <a class="ben-link-muted small text-nowrap d-inline-flex align-items-center gap-1" href="/store/cart" id="checkout-back-to-cart"><BenIcon Name="arrow-left" /> Back to cart</a>
        </div>

        <StoreCheckoutSteps Current="Step" Secure="true" />

        @if (_refusal is not null)
        {
            <div class="alert alert-danger" role="alert" id="checkout-refusal">@_refusal</div>
        }
        @if (_stillProcessing is { } processingId)
        {
            <p class="small" data-testid="checkout-still-processing">
                <a href="@($"/store/checkout/complete?order={processingId}")">See how that payment is going</a>
            </p>
        }
        @if (_notice is not null)
        {
            <div class="alert alert-info" role="status" data-testid="checkout-notice">@_notice</div>
        }

        <BenInteractiveOnly>
            @if (CartState.Cart is not { } cart)
            {
                <div class="text-center text-secondary py-5" data-testid="checkout-loading">
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Opening your cart…
                </div>
            }
            else if (cart.IsEmpty && _form.Prepared is null)
            {
                <StoreEmptyState Icon="shopping-cart" Title="Your cart is empty"
                                 Lead="There is nothing to check out yet."
                                 LinkText="Back to the cart" LinkHref="/store/cart" />
            }
            else
            {
                <div class="row g-4">
                    <div class="col-xl-7">
                        <div class="card mb-3">
                            <div class="card-header fs-5 fw-bold py-3">Delivery</div>
                            <div class="card-body p-md-4">
                                @if (!_form.IsLocked)
                                {
                                    <div class="mb-4" data-testid="checkout-account">
                                        @if (User.IsAuthenticated)
                                        {
                                            <p class="small text-secondary mb-2">You're signed in — this order will be kept with your account.</p>
                                        }
                                        else
                                        {
                                            <p class="small text-secondary mb-2">
                                                Ordering as a guest — we'll email you a link to your order.
                                                <a href="@SignInLink.For("store/checkout")">Sign in</a> or <a href="/signup">create an account</a>
                                                to keep your orders together.
                                            </p>
                                        }
                                        <div class="form-floating">
                                            <input type="email" class="form-control" id="checkout-email" placeholder="Email address" autocomplete="email"
                                                   @bind="_form.Email" @bind:event="oninput" />
                                            <label for="checkout-email">Email address</label>
                                        </div>
                                    </div>

                                    <h2 class="fs-6 fw-bold mb-3">Shipping address</h2>
                                    <StoreAddressFields Address="_form.Shipping" Prefix="shipping" />

                                    <div class="form-check mt-4 mb-2">
                                        <input class="form-check-input" type="checkbox" id="billing-different"
                                               checked="@(!_form.BillingSameAsShipping)" @onchange="@(e => _form.BillingSameAsShipping = !(bool)(e.Value ?? false))" />
                                        <label class="form-check-label fw-medium" for="billing-different">Billing address is different</label>
                                    </div>
                                    @if (!_form.BillingSameAsShipping)
                                    {
                                        <h2 class="fs-6 fw-bold mt-4 mb-3">Billing address</h2>
                                        <div class="form-floating mb-3">
                                            <input type="text" class="form-control" id="billing-company" placeholder="Company (optional)" autocomplete="section-billing billing organization"
                                                   @bind="_form.BillCompany" @bind:event="oninput" />
                                            <label for="billing-company">Company (optional)</label>
                                        </div>
                                        <StoreAddressFields Address="_form.Billing" Prefix="billing" />
                                    }

                                    <h2 class="fs-6 fw-bold mt-4 mb-3">Delivery method</h2>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="delivery" id="delivery-standard" checked readonly />
                                        <label class="form-check-label" for="delivery-standard">
                                            @cart.ShippingText &ndash; Standard shipping
                                            <small class="d-block text-secondary">Ships to addresses in the United States.</small>
                                        </label>
                                    </div>

                                    <div class="form-floating mt-4">
                                        <textarea class="form-control" id="checkout-notes" placeholder="Order notes" style="height:5rem" maxlength="500"
                                                  @bind="_form.BuyerNotes" @bind:event="oninput"></textarea>
                                        <label for="checkout-notes">Order notes (optional)</label>
                                    </div>
                                }
                                else
                                {
                                    <dl class="row small mb-0" data-testid="checkout-locked-summary">
                                        <dt class="col-sm-3">Email</dt>
                                        <dd class="col-sm-9">@_form.Email</dd>
                                        <dt class="col-sm-3">Ship to</dt>
                                        <dd class="col-sm-9">@foreach (var line in _form.Shipping.Lines()) { <div>@line</div> }</dd>
                                        @if (!_form.BillingSameAsShipping)
                                        {
                                            <dt class="col-sm-3">Bill to</dt>
                                            <dd class="col-sm-9">
                                                @if (!string.IsNullOrWhiteSpace(_form.BillCompany)) { <div>@_form.BillCompany</div> }
                                                @foreach (var line in _form.Billing.Lines()) { <div>@line</div> }
                                            </dd>
                                        }
                                        <dt class="col-sm-3">Delivery</dt>
                                        <dd class="col-sm-9">Standard shipping</dd>
                                    </dl>
                                    <button type="button" class="btn btn-link px-0" id="checkout-edit" @onclick="EditAsync" disabled="@_busy">
                                        <BenIcon Name="edit-2" /> Edit
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_form.Prepared is { } prepared)
                        {
                            <div class="card mb-3" data-testid="checkout-payment" data-order-id="@prepared.OrderId">
                                <div class="card-header py-3">
                                    <span class="fs-5 fw-bold">Payment</span>
                                    <small class="d-flex align-items-center gap-1 text-success fw-medium mt-1"><BenIcon Name="lock" /> All transactions are secured</small>
                                </div>
                                <div class="card-body p-md-4">
                                    <p class="small text-secondary mb-3" data-testid="checkout-countdown">
                                        Order no. @prepared.OrderNumber — we're holding your items for <strong>@Countdown</strong>.
                                    </p>
                                    @if (prepared.FakeCheckout)
                                    {
                                        <div class="alert alert-warning mb-0" data-testid="checkout-fake">
                                            <strong>Test checkout — no card needed.</strong> Stripe isn't connected on this site; placing the order pays it as a test.
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="ben-payment-element" @ref="_paymentSlot" class="ben-payment-element"></div>
                                        @if (!_mounted)
                                        {
                                            <div class="text-secondary small py-3"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading the payment form…</div>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        <div class="card mb-3">
                            <div class="card-header fs-6 fw-bold py-3">Your items</div>
                            <div class="card-body p-md-4">
                                @foreach (var line in cart.Lines)
                                {
                                    <StoreCartLine @key="line.VariantId" Line="line" Mode="StoreCartLineMode.ReadOnly" LowStockThreshold="cart.LowStockThreshold" />
                                }
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-body">
                                <h2 class="fs-6 fw-bold">How is your information used?</h2>
                                <p class="small text-secondary">
                                    Your name, address, email and phone are used to deliver this order, to send you its receipt and
                                    updates, and to work out sales tax. Card details go straight to Stripe, our payment processor —
                                    they never reach this site. See our <a href="/privacy">privacy policy</a>.
                                </p>
                                <hr />
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="checkout-terms" disabled="@_form.IsLocked"
                                           checked="@_form.AgreedToTerms" @onchange="@(e => _form.AgreedToTerms = (bool)(e.Value ?? false))" />
                                    <label class="form-check-label" for="checkout-terms">
                                        I agree to the <a href="/terms" target="_blank" rel="noopener">terms and conditions</a>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-none d-lg-block mb-4">
                            @if (!_form.IsLocked)
                            {
                                <button type="button" class="btn btn-lg btn-primary px-4" id="store-continue-payment" @onclick="ContinueAsync" disabled="@_busy">
                                    @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                                    Continue to payment
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-lg btn-primary px-4" id="store-place-order" @onclick="PlaceOrderAsync" disabled="@(_busy || !_mounted)">
                                    @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                                    Place order · @StoreMoney.Format(_form.Prepared!.Totals.Total)
                                </button>
                            }
                        </div>
                    </div>

                    <div class="col-xl-5">
                        <StoreOrderSummary Cart="cart" Totals="_form.Prepared?.Totals" AtCheckout="true" Sticky="true" />

                        @if (!_form.IsLocked)
                        {
                            <div class="mt-3" data-testid="checkout-discount">
                                @if (cart.CouponCode is { } applied)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis d-inline-flex align-items-center gap-2 py-2 px-3" data-testid="applied-code">
                                        @applied @(cart.Discount > 0 ? $"−{StoreMoney.Format(cart.Discount)}" : null)
                                        <button type="button" class="btn btn-sm btn-link p-0 text-success-emphasis" aria-label="@($"Remove the code {applied}")"
                                                @onclick="RemoveCouponAsync">
                                            <BenIcon Name="x" />
                                        </button>
                                    </span>
                                }
                                else
                                {
                                    <label class="form-label small" for="checkout-discount-code">Discount code</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="checkout-discount-code" autocomplete="off"
                                               @bind="_code" @bind:event="oninput" @onkeydown="@(e => e.Key == "Enter" ? ApplyCouponAsync() : Task.CompletedTask)" />
                                        <button type="button" class="btn btn-outline-secondary" id="checkout-discount-apply" @onclick="ApplyCouponAsync">Apply</button>
                                    </div>
                                }
                                @if (_codeError is not null)
                                {
                                    <p class="small text-warning-emphasis mt-1 mb-0" data-testid="checkout-code-error">@_codeError</p>
                                }
                                else if (cart.CouponProblem is { } problem)
                                {
                                    <p class="small text-warning-emphasis mt-1 mb-0" data-testid="coupon-problem">@problem</p>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* The phone's bar (below lg), Smarty's fixed bottom bar: the total and the step's one button. *@
                <div class="ben-checkout-bar-spacer" aria-hidden="true"></div>
                <div class="ben-checkout-bar" data-testid="checkout-bar">
                    <div class="lh-1">
                        <span class="small d-block">@(_form.Prepared is null ? "Total before tax" : "Total")</span>
                        <span class="h5 d-block mb-0">@StoreMoney.Format(_form.Prepared?.Totals.Total ?? cart.TotalBeforeTax)</span>
                    </div>
                    @if (!_form.IsLocked)
                    {
                        <button type="button" class="btn btn-primary" id="store-continue-payment-bar" @onclick="ContinueAsync" disabled="@_busy">Continue to payment</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" id="store-place-order-bar" @onclick="PlaceOrderAsync" disabled="@(_busy || !_mounted)">Place order</button>
                    }
                </div>
            }
        </BenInteractiveOnly>
    </div>
</FeatureGate>

@code {
    private static readonly TimeSpan StatusEvery = TimeSpan.FromSeconds(30);

    private readonly CheckoutForm _form = new();
    private ElementReference _paymentSlot;
    private IJSObjectReference? _module;
    private Timer? _timer;
    private DateTime _lastStatusRead;
    private bool _mountPending, _mounted, _busy, _reprepareing, _disposed;
    private string? _refusal, _notice, _codeError;
    private string _code = "";
    private Guid? _stillProcessing;

    /// <summary>Place order until the payment form is up; Payment from then on.</summary>
    private StoreCheckoutStep Step => _mounted ? StoreCheckoutStep.Payment : StoreCheckoutStep.PlaceOrder;

    private string Countdown
    {
        get
        {
            var left = (_form.Prepared?.ReservationExpiresUtc ?? DateTime.UtcNow) - DateTime.UtcNow;
            return left <= TimeSpan.Zero ? "0:00" : $"{(int)left.TotalMinutes}:{left.Seconds:00}";
        }
    }

    protected override void OnInitialized() => CartState.Changed += OnCartChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            await User.AuthReady;
            _form.Prefill(User.UserEmail, null);
            await CartState.EnsureFreshAsync(true);
            if (CartState.Cart is { IsEmpty: true }) Nav.NavigateTo("/store/cart");
            StateHasChanged();
            return;
        }

        if (_mountPending && _form.Prepared is { FakeCheckout: false, ClientSecret: { } secret, PublishableKey: { } key })
        {
            _mountPending = false;
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Ben.Web.Website.Library/Store/Checkout/StoreCheckoutPage.razor.js");
                var billing = new { name = _form.Shipping.FullName, email = _form.Email, phone = _form.Shipping.Phone };
                var error = await _module.InvokeAsync<string?>("mount", _paymentSlot, key, secret, billing);
                _refusal = error;
                _mounted = error is null;
            }
            catch (JSDisconnectedException) { return; }
            catch (Exception ex) when (ex is JSException or TaskCanceledException or InvalidOperationException)
            {
                var error = "The payment form couldn't be loaded. Reload the page and try again.";
                _refusal = error;
            }
            StateHasChanged();
        }
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);

    private async Task ContinueAsync()
    {
        if (_busy) return;
        _notice = null;
        if (_form.Problem() is { } typed)
        {
            var error = typed;
            _refusal = error;
            return;
        }
        _busy = true;
        _refusal = null;
        _stillProcessing = null;
        try
        {
            await PrepareAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Places the order and, with it accepted, starts the payment step.</summary>
    private async Task<bool> PrepareAsync()
    {
        var attempt = await Store.PrepareCheckoutAsync(_form.ToRequest());
        if (attempt.Prepared is not { } prepared)
        {
            var error = attempt.Error;
            _refusal = error;
            _stillProcessing = attempt.StillProcessingOrderId;
            await CartState.RefreshAsync();   // a line that changed says so on the page
            return false;
        }

        _form.Accept(prepared);
        if (prepared.PaidWithoutCharge)
        {
            Nav.NavigateTo(prepared.ReturnUrl);
            return true;
        }

        _mounted = prepared.FakeCheckout;
        _mountPending = !prepared.FakeCheckout;
        _lastStatusRead = DateTime.UtcNow;
        StartTimer();
        return true;
    }

    /// <summary>"Edit": the placed order is let go, the payment form taken down, and the fields unlocked.</summary>
    private async Task EditAsync()
    {
        await TakeDownPaymentAsync();
        _form.Unlock();
        _notice = null;
        _refusal = null;
    }

    private async Task PlaceOrderAsync()
    {
        if (_busy || _form.Prepared is not { } prepared) return;
        _busy = true;
        _refusal = null;
        try
        {
            if (prepared.FakeCheckout)
            {
                if (await Store.SimulateFakePaymentAsync(prepared.OrderId))
                {
                    Nav.NavigateTo(prepared.ReturnUrl);
                    return;
                }
                var error = "The test payment didn't go through. Try again.";
                _refusal = error;
                return;
            }

            if (_module is null || !_mounted) return;
            var result = await _module.InvokeAsync<ConfirmResult>("confirm", prepared.ReturnUrl);
            if (result.Ok)
            {
                Nav.NavigateTo(prepared.ReturnUrl);
                return;
            }
            if (result.Code == "payment_intent_unexpected_state")
            {
                // The order moved on under the form (it expired, or another tab changed it): price it again.
                await ReprepareAsync(StoreCheckoutSentences.ReservationExpired);
                return;
            }
            var said = result.Message ?? "The payment did not go through.";
            _refusal = said;
        }
        catch (JSDisconnectedException) { }
        finally
        {
            _busy = false;
        }
    }

    private sealed record ConfirmResult(bool Ok, string? Code, string? Message, string? Status);

    private async Task ApplyCouponAsync()
    {
        _codeError = null;
        if (string.IsNullOrWhiteSpace(_code))
        {
            _codeError = "Enter a code.";
            return;
        }
        var said = (await CartState.ApplyCouponAsync(_code.Trim())).Message;
        if (said is null) _code = "";
        _codeError = said;
    }

    private async Task RemoveCouponAsync()
    {
        _codeError = (await CartState.RemoveCouponAsync()).Message;
    }

    // ── The hold's countdown ────────────────────────────────────────────────

    private void StartTimer()
    {
        _timer ??= new Timer(_ => _ = InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task TickAsync()
    {
        if (_disposed || _form.Prepared is not { } prepared || _reprepareing) return;
        if (prepared.ReservationExpiresUtc <= DateTime.UtcNow)
        {
            await ReprepareAsync(StoreCheckoutSentences.ReservationExpired);
            return;
        }
        if (DateTime.UtcNow - _lastStatusRead >= StatusEvery)
        {
            _lastStatusRead = DateTime.UtcNow;
            var status = (await Store.GetStoreOrderStatusAsync(prepared.OrderId, null)).Item;
            if (status is { Status: StoreOrderStatus.Paid })
            {
                Nav.NavigateTo(prepared.ReturnUrl);
                return;
            }
            if (status is { Status: StoreOrderStatus.Cancelled } || status?.ReservationExpiresUtc <= DateTime.UtcNow)
            {
                await ReprepareAsync(StoreCheckoutSentences.ReservationExpired);
                return;
            }
        }
        StateHasChanged();
    }

    /// <summary>The hold ran out: check stock and price again, and put up a fresh payment form.</summary>
    private async Task ReprepareAsync(string notice)
    {
        if (_reprepareing) return;
        _reprepareing = true;
        try
        {
            await TakeDownPaymentAsync();
            _form.Unlock();
            if (await PrepareAsync()) _notice = notice;
            StateHasChanged();
        }
        finally
        {
            _reprepareing = false;
        }
    }

    private async Task TakeDownPaymentAsync()
    {
        _timer?.Dispose();
        _timer = null;
        _mounted = false;
        _mountPending = false;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose"); }
            catch (JSDisconnectedException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CartState.Changed -= OnCartChanged;
        _timer?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
