@inject IBenUserState UserState

@*
    An item's history (store sellers, backlog 251, P2): who changed what, newest first, in the
    sentences the server wrote at the time. Shared by the admin editor and the seller's; each
    loads its own list (the admin's has names and prices, the seller's has neither) and hands it
    here, so the two cannot drift in how a line reads.
*@

<BenListState TItem="StoreProductChangeRecord" Result="Result" Loading="Loading" EmptyText="No changes recorded yet" OnRetry="OnRetry">
    <ol class="list-unstyled mb-0" data-testid="product-history">
        @foreach (var line in Result.Items)
        {
            <li class="d-flex flex-wrap gap-2 py-2 border-bottom" data-testid="product-history-line" data-area="@line.Area">
                <div class="text-secondary small text-nowrap" style="min-width:10rem;">@line.OccurredUtc.ToViewerLocalTime(UserState).ToDisplayDateTime()</div>
                <div class="flex-grow-1" style="min-width:14rem;">
                    <span class="badge bg-body-secondary text-body-emphasis border me-1">@AreaLabel(line.Area)</span>
                    <span data-testid="product-history-summary">@line.Summary</span>
                </div>
                <div class="small text-nowrap" data-testid="product-history-actor">
                    @line.ActorName
                    @if (line.ActorRole == StoreChangeActor.Seller)
                    {
                        <span class="badge text-bg-info ms-1">Seller</span>
                    }
                </div>
            </li>
        }
    </ol>
</BenListState>

@code {
    [Parameter, EditorRequired] public LoadResult<StoreProductChangeRecord> Result { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    private static string AreaLabel(StoreProductChangeArea area) => area switch
    {
        StoreProductChangeArea.Created => "Made",
        StoreProductChangeArea.Sale => "On sale",
        StoreProductChangeArea.Seller => "Seller",
        StoreProductChangeArea.Options => "Options",
        StoreProductChangeArea.Variants => "Variants",
        StoreProductChangeArea.Price => "Price",
        StoreProductChangeArea.Stock => "Stock",
        StoreProductChangeArea.Pictures => "Pictures",
        StoreProductChangeArea.Parts => "Parts",
        StoreProductChangeArea.Files => "Files",
        StoreProductChangeArea.Faq => "FAQ",
        StoreProductChangeArea.Versions => "Versions",
        StoreProductChangeArea.Page => "Page",
        _ => "Details",
    };
}
