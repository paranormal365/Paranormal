@page "/store/p/{ProductSlug}"
@using Ben.Web.Website.Library.Store.Shared
@inject IBenAdminClient Store
@inject IBenUserState UserState
@inject IMediaUrlBuilder MediaUrls

<PageTitle>@(_product.Item?.Name ?? "Product") — Store</PageTitle>

@*
    One product (storefront S2.9). The page loads it, counts the look and sets the link preview;
    StoreProductView draws it — the same component the product editor's live preview uses, so
    the preview cannot drift from what shoppers get.

    ?preview=1 is for a SuperAdmin: a product not yet on sale, or on a hidden shelf, opens with a
    warning over it. It needs the admin's token, so it waits for the circuit and the sign-in; to
    anybody else it is the same "Page not found" as a product that does not exist.
*@

<FeatureGate Flag="@SiteFeatures.Store">
    @if (!_loading && StoreNotFound.Answers(_product))
    {
        <StoreNotFound />
    }
    else
    {
    <div class="container-fluid px-3 py-3" style="max-width:80rem;">
        <BenItemState TItem="StoreProductDetail" Result="_product" Loading="_loading" LoadingText="Loading the product…" OnRetry="LoadAsync">
            <ChildContent Context="p">
                <SocialCard Title="@p.Name" Description="@p.ShortDescription" RelativeUrl="@($"/store/p/{p.Slug}")"
                            ImageUrl="@(p.Images.FirstOrDefault() is { } first ? MediaUrls.StoreImage(first.UploadFileId) : null)" Type="product" />

                <StoreProductView Product="p" Info="_info.Item" />
            </ChildContent>
        </BenItemState>
    </div>
    }
</FeatureGate>

@code {
    [Parameter] public string ProductSlug { get; set; } = "";

    [SupplyParameterFromQuery(Name = "preview")] public int? Preview { get; set; }

    private ItemResult<StoreProductDetail> _product;
    private ItemResult<StorePublicInfo> _info;
    private bool _loading = true;
    private string? _loadedSlug;
    private bool _counted;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{ProductSlug}|{Preview}";
        if (key == _loadedSlug) return;

        // A preview needs the admin's token, which only the live circuit has.
        if (Preview == 1 && !await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        _loadedSlug = key;
        await LoadAsync();
    }

    /// <summary>What the server render fetched — see StoreHome.RenderedHome. Never a preview (that waits for the circuit).</summary>
    [PersistentState] public StoreProductDetail? RenderedProduct { get; set; }
    [PersistentState] public StorePublicInfo? RenderedInfo { get; set; }

    private async Task LoadAsync()
    {
        if (RenderedProduct is { IsPreview: false } rendered && rendered.Slug == ProductSlug && Preview != 1)
        {
            RenderedProduct = null;   // once
            _product = ItemResult<StoreProductDetail>.Ok(rendered);
            _info = ItemResult<StorePublicInfo>.Ok(RenderedInfo);
        }
        else
        {
            _loading = true;
            var product = Store.GetStoreProductPageAsync(ProductSlug, Preview == 1);
            var info = Store.GetStoreInfoAsync();
            _product = await product;
            _info = await info;
            if (!RendererInfo.IsInteractive)
            {
                RenderedProduct = StoreCarry.IfItFits(_product.Item);
                RenderedInfo = RenderedProduct is null ? null : _info.Item;
            }
        }
        _loading = false;

        // Counted once, from the live circuit — not the server render as well.
        if (!_counted && RendererInfo.IsInteractive && _product.Item is { IsPreview: false } seen)
        {
            _counted = true;
            _ = Store.RecordStoreProductViewAsync(seen.Id);
        }
    }
}
