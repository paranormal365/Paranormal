@page "/store/products"
@page "/store/c/{CategorySlug}"
@using Ben.Web.Website.Library.Store.Shared
@inject IBenAdminClient Store
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@PageTitleText</PageTitle>

@*
    Every product, one shelf, or a search (storefront S2.8), after Smarty's category page: the
    shelves and the filters down the side, a toolbar with the search, the count and the sort, a grid
    of sixteen, and the pages.

    The address is the whole state — every filter, the sort, the page — so the page re-reads it on
    every navigation, including one that only changes the query string. Below the lg break (phones
    and tablets held upright) the sidebar folds into two buttons that open full-screen dialogs.
*@

<FeatureGate Flag="@SiteFeatures.Store">
    @if (!_loading && StoreNotFound.Answers(_listing))
    {
        <StoreNotFound />
    }
    else
    {
    <div class="container-fluid px-3 py-3" style="max-width:80rem;">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="/store">Store</a></li>
                @if (_listing.Item?.Category is { } shelf)
                {
                    <li class="breadcrumb-item"><a href="/store/products">All products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@shelf.Name</li>
                }
                else
                {
                    <li class="breadcrumb-item active" aria-current="page">@(string.IsNullOrWhiteSpace(_query.Q) ? "All products" : "Search")</li>
                }
            </ol>
        </nav>

        <h1 class="h3 mb-3">@Heading<HelpLink Slug="shopping-at-the-store" Anchor="finding-something" /></h1>

        <BenItemState TItem="StoreListingResponse" Result="_listing" Loading="_loading" LoadingText="Finding products…" OnRetry="LoadAsync">
            <ChildContent Context="list">
                @if (list.Category?.Description is { Length: > 0 } about)
                {
                    <p class="text-secondary">@about</p>
                }
                <div class="row g-4">
                    <aside class="col-lg-3 d-none d-lg-block" aria-label="Categories and filters">
                        <h2 class="h6 text-uppercase text-secondary">Categories</h2>
                        <StoreCategoryTree Categories="list.Categories" ActiveSlug="@CategorySlug" />
                        <h2 class="h6 text-uppercase text-secondary mt-4">Filters</h2>
                        <StoreFilterForm Facets="list.Facets" Query="_query" BaseHref="@BaseHref" IdPrefix="side" />
                    </aside>

                    <div class="col-12 col-lg-9">
                        <div class="ben-store-toolbar mb-3">
                            <div class="flex-grow-1" style="min-width:14rem;max-width:26rem;">
                                <StoreSearchBox Id="listing-search" Initial="@_query.Q" />
                            </div>
                            <div class="d-flex gap-2 d-lg-none">
                                <button type="button" class="btn btn-outline-secondary" data-testid="open-categories" @onclick="@(() => _categoriesOpen = true)">
                                    <BenIcon Name="grid" /> Categories
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-testid="open-filters" @onclick="@(() => _filtersOpen = true)">
                                    <BenIcon Name="filter" /> Filters
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-secondary small text-nowrap" data-testid="listing-count">@list.Total @(list.Total == 1 ? "product" : "products")</span>
                                <label class="visually-hidden" for="listing-sort">Sort by</label>
                                <select id="listing-sort" class="form-select form-select-sm w-auto" value="@_query.Sort" @onchange="OnSortChanged">
                                    @foreach (var (key, label) in StoreCatalogConstants.Sorts.All)
                                    {
                                        <option value="@key">@label</option>
                                    }
                                </select>
                            </div>
                        </div>

                        @if (list.Products.Count == 0)
                        {
                            <StoreEmptyState Icon="search" Title="No products match"
                                             Lead="@(string.IsNullOrWhiteSpace(_query.Q) ? "Try fewer filters." : $"Nothing matches “{_query.Q}”.")"
                                             LinkText="Show everything" LinkHref="/store/products" />
                        }
                        else
                        {
                            <div class="row g-3" data-testid="listing-grid">
                                @foreach (var card in list.Products)
                                {
                                    <div class="col-6 col-md-4 col-xl-3"><StoreCard Card="card" /></div>
                                }
                            </div>
                            <div class="d-flex justify-content-center mt-4">
                                <BenPager Total="list.Total" PageSize="list.PageSize" Page="list.Page" PageChanged="GoToPage" AriaLabel="Pages of products" />
                            </div>
                        }
                    </div>
                </div>

                <BenModal @bind-Visible="_categoriesOpen" Title="Categories" Size="fullscreen">
                    <ChildContent><StoreCategoryTree Categories="list.Categories" ActiveSlug="@CategorySlug" /></ChildContent>
                </BenModal>
                <BenModal @bind-Visible="_filtersOpen" Title="Filters" Size="fullscreen">
                    <ChildContent>
                        <StoreFilterForm Facets="list.Facets" Query="_query" BaseHref="@BaseHref" IdPrefix="sheet" OnChosen="@(() => _filtersOpen = false)" />
                    </ChildContent>
                    <FooterContent>
                        <button type="button" class="btn btn-primary w-100" @onclick="@(() => _filtersOpen = false)">Show @list.Total @(list.Total == 1 ? "product" : "products")</button>
                    </FooterContent>
                </BenModal>
            </ChildContent>
        </BenItemState>
    </div>
    }
</FeatureGate>

@code {
    [Parameter] public string? CategorySlug { get; set; }

    private ItemResult<StoreListingResponse> _listing;
    private StoreListingQuery _query = new();
    private bool _loading = true, _categoriesOpen, _filtersOpen;
    private string? _loadedFor;

    private string BaseHref => CategorySlug is null ? "/store/products" : $"/store/c/{CategorySlug}";

    private string Heading => _listing.Item?.Category?.Name
        ?? (string.IsNullOrWhiteSpace(_query.Q) ? "All products" : $"Results for “{_query.Q}”");

    private string PageTitleText => $"{Heading} — Store";

    /// <summary>A new shelf (a route change) loads here.</summary>
    protected override async Task OnParametersSetAsync() => await LoadForAddressAsync();

    /// <summary>
    /// A change of ONLY the query string — a filter, the sort, a page — does not reach
    /// OnParametersSetAsync: Blazor skips setting a page's parameters when its route values are
    /// unchanged, so the listing kept showing the old filter under the new address (found by
    /// StoreBrowseTests). The address itself is watched instead.
    /// </summary>
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = new Uri(e.Location).AbsolutePath.TrimEnd('/');
        if (path != BaseHref) return;   // leaving the page; the next page loads itself
        _ = InvokeAsync(async () => { await LoadForAddressAsync(); StateHasChanged(); });
    }

    private async Task LoadForAddressAsync()
    {
        if (Nav.Uri == _loadedFor) return;
        _loadedFor = Nav.Uri;
        _query = StoreListingQueryString.Parse(new Uri(Nav.Uri).Query);
        _categoriesOpen = _filtersOpen = false;
        await LoadAsync();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>What the server render fetched, and for which address — see StoreHome.RenderedHome.</summary>
    [PersistentState] public StoreListingResponse? RenderedListing { get; set; }
    [PersistentState] public string? RenderedFor { get; set; }

    private async Task LoadAsync()
    {
        if (RenderedListing is { } rendered && RenderedFor == Nav.Uri)
        {
            RenderedListing = null;   // once: a later visit to this address is a fresh read
            _listing = ItemResult<StoreListingResponse>.Ok(rendered);
            _loading = false;
            return;
        }
        _loading = true;
        _listing = await Store.GetStoreListingAsync(CategorySlug, _query);
        _loading = false;
        if (!RendererInfo.IsInteractive)
        {
            RenderedListing = _listing.Item;
            RenderedFor = Nav.Uri;
        }
    }

    private void OnSortChanged(ChangeEventArgs e)
        => Nav.NavigateTo(BaseHref + StoreListingQueryString.From(_query with { Sort = e.Value?.ToString(), Page = 1 }));

    private void GoToPage(int page)
        => Nav.NavigateTo(BaseHref + StoreListingQueryString.From(_query with { Page = page }));
}
