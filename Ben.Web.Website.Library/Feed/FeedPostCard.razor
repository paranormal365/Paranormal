@using Ben.Service.Models.Feed
@using Ben.Web.Services

@inject IBenUserState UserState
@inject IBenAdminClient Feed

@*
    One post in the feed.

    The author's name links to their feed profile, the body is linkified by FeedText, and the
    footer carries the actions a reader has: reply, follow, report.

    Report is offered once. After that the control says so rather than disappearing — a control
    that vanishes leaves somebody wondering whether their report registered, and inviting a second
    one would only be refused.

    A visitor who is not signed in gets neither control (item 186). Both endpoints are
    [Authorize]d, so offering the button would be offering a 401 — and the join card at the top of
    the feed already explains what an account is for. Reading needs no account; acting does.

    CanAct arrives from the page rather than being read here. The pages await auth resolution
    before claiming anything about the reader; a card reading the state for itself would answer
    from whatever was true at prerender and never revise it — which is exactly what
    AuthReadyPrerenderGuardTests exists to stop, and what it caught when this did read it.
*@

<article class="card mb-2 bv-feed-post">
    <div class="card-body py-3">

        <div class="d-flex align-items-baseline gap-2 mb-1 flex-wrap">
            <a href="@($"/feed/people/{Post.AuthorAppUserId}")" class="fw-semibold text-decoration-none">
                @Post.AuthorDisplayName
            </a>
            <span class="text-secondary small">
                @Post.DateCreated.ToViewerLocalTime(UserState).ToDisplayDateTime()
            </span>

            @if (!Post.IsOwnPost && ShowFollow && CanAct)
            {
                <button type="button" class="btn btn-link btn-sm p-0 ms-auto"
                        @onclick="() => OnFollowToggled.InvokeAsync(Post)">
                    @(Post.AuthorIsFollowedByCurrentUser ? "Following" : "Follow")
                </button>
            }
        </div>

        <div class="bv-feed-post__body">
            <FeedText Body="@Post.Body" Mentions="@Post.Mentions" />
        </div>

        @* The photo or video (item 186 F4). Served from the post's own route, which refuses
           anything unscreened — so there is no file id here to try against the general file
           endpoints, and a held photo simply has no URL. *@
        @if (Post.HasMedia)
        {
            <div class="mt-2 bv-feed-post__media">
                @if (Post.MediaKind == FeedMediaKind.Video)
                {
                    <video src="@MediaUrl" controls preload="metadata" playsinline
                           class="w-100 rounded" style="max-height:32rem;background:#000;"></video>
                }
                else
                {
                    @* No lazy loading: this is a scrolling feed, and an image that starts loading
                       when it is already on screen is an image that arrives late. *@
                    <img src="@MediaUrl" alt="" class="w-100 rounded" style="max-height:32rem;object-fit:contain;" />
                }
            </div>
        }
        else if (Post.MediaAwaitingReview && Post.IsOwnPost)
        {
            @* Only to the author, and said as a wait rather than a failure: their upload worked,
               and "we are checking it" is the truth. Nobody else is told a post has media at all. *@
            <div class="mt-2 small text-secondary d-flex align-items-center gap-2"
                 id="feed-media-pending">
                <BenIcon Name="clock" />
                <span>Your photo is being checked before it appears.</span>
            </div>
        }

        <div class="d-flex align-items-center gap-3 mt-2 small">
            @* The like. A visitor sees the count and a link to join rather than a dead control:
               the number is the social proof, and the invitation is the point of showing it. *@
            @if (CanAct)
            {
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none bv-feed-like"
                        title="@(Post.LikedByCurrentUser ? "You liked this" : "Like this post")"
                        aria-pressed="@(Post.LikedByCurrentUser ? "true" : "false")"
                        @onclick="() => OnLikeToggled.InvokeAsync(Post)">
                    <span aria-hidden="true">@(Post.LikedByCurrentUser ? "♥" : "♡")</span>
                    <span class="visually-hidden">@(Post.LikedByCurrentUser ? "Unlike" : "Like")</span>
                    @if (Post.LikeCount > 0) { <span class="ms-1">@Post.LikeCount</span> }
                </button>
            }
            else if (Post.LikeCount > 0)
            {
                <a href="/signup" class="text-decoration-none text-secondary bv-feed-like"
                   title="Sign in to like posts">
                    <span aria-hidden="true">♡</span> <span class="ms-1">@Post.LikeCount</span>
                </a>
            }

            <a href="@($"/feed/{Post.Id}")" class="text-decoration-none text-secondary">
                @(Post.ReplyCount == 1 ? "1 reply" : $"{Post.ReplyCount} replies")
            </a>

            @if (!Post.IsOwnPost && CanAct)
            {
                @if (Post.ReportedByCurrentUser)
                {
                    <span class="text-secondary">Reported</span>
                }
                else
                {
                    <button type="button" class="btn btn-link btn-sm p-0 text-secondary"
                            @onclick="() => OnReportRequested.InvokeAsync(Post)">
                        Report
                    </button>
                }
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public FeedPostRecord Post { get; set; } = default!;

    /// <summary>Hidden on a profile page, where one follow button at the top says it better.</summary>
    [Parameter] public bool ShowFollow { get; set; } = true;

    [Parameter] public EventCallback<FeedPostRecord> OnLikeToggled { get; set; }
    [Parameter] public EventCallback<FeedPostRecord> OnFollowToggled { get; set; }
    [Parameter] public EventCallback<FeedPostRecord> OnReportRequested { get; set; }

    /// <summary>
    /// Whether this reader may act on a post — follow or report. False for a visitor, and false
    /// until the page knows, so a control never appears before the page can honour it.
    /// </summary>
    [Parameter] public bool CanAct { get; set; }

    /// <summary>Where the post's media is served from. Only ever asked for when HasMedia.</summary>
    private string MediaUrl => Feed.GetFeedMediaUrl(Post.Id);
}
