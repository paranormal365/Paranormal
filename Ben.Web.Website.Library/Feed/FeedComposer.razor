@using Ben.Data.Common.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using Ben.Service.Models.Feed
@using Ben.Web.Services

@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient Feed
@inject IJSRuntime JS
@inject IBenUserState UserState

@*
    Writing a post.

    A plain textarea, not a rich-text editor. Short-form is the whole point of the feed, and an
    editor with bold and lists invites the thing this is not for — a long piece belongs in a
    publication. It also keeps the body plain text, which is what makes it safe to render.

    The character count only appears once it is worth knowing about. A counter sitting at 0/1000
    from the moment the page loads reads as a demand rather than a limit.
*@

<div class="card mb-3">
    <div class="card-body">
        <label class="visually-hidden" for="feed-composer">@Placeholder</label>
        <textarea id="feed-composer" class="form-control border-0 px-0"
                  rows="@(_body.Length > 120 ? 4 : 2)"
                  maxlength="@MaxLength"
                  placeholder="@Placeholder"
                  value="@_body"
                  @oninput="OnBodyInput"></textarea>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 mt-2 mb-0">@_error</div>
        }

        @* The chosen photo or video, named rather than previewed: a preview would mean reading
           the whole file into the circuit, and a name is enough to answer "did it take the right
           one". Removing it is one click, because picking the wrong file is the common mistake. *@
        @if (_media is not null)
        {
            <div class="d-flex align-items-center gap-2 mt-2 small" id="feed-composer-media">
                <BenIcon Name="paperclip" />
                <span class="text-truncate">@_media.Name</span>
                <span class="text-secondary">(@FormatSize(_media.Size))</span>
                <button type="button" class="btn btn-link btn-sm p-0 ms-auto"
                        @onclick="ClearMedia" disabled="@_busy">Remove</button>
            </div>
        }

        @* What the post shows, from the platform's experience taxonomy (item 186 F6). Optional
           always; surfaced only once media is attached, because "what does this show" is a
           question about footage, not about chatter. Grouped by category the way the taxonomy
           is — a native select handles optgroups without a component in the way. *@
        @if (_media is not null && _taxonomy is { Count: > 0 })
        {
            <div class="mt-2" id="feed-composer-category">
                <select class="form-select form-select-sm" value="@(_experienceTypeId?.ToString() ?? string.Empty)"
                        @onchange="OnTypeChosen" disabled="@_busy"
                        aria-label="What does this show?">
                    <option value="">What does this show? (optional)</option>
                    @foreach (var group in _taxonomy)
                    {
                        <optgroup label="@group.Category.Name">
                            @foreach (var type in group.Types)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
        }
        else if (_media is not null && _taxonomyFailed)
        {
            @* The refusal, rendered rather than swallowed: the picker being optional does not
               make its absence self-explanatory. Posting still works — the category is extra. *@
            <div class="mt-2 small text-secondary" id="feed-composer-category-unavailable">
                Categories couldn't load — you can post without one.
            </div>
        }

        @if (_poll is not null)
        {
            <BenPollEditor Value="@_poll" Changed="@(p => _poll = p)" />
        }

        @if (_scheduledFor is { } when)
        {
            <div class="composer-note" id="feed-composer-scheduled">
                <BenIcon Name="clock" />
                <span>Goes up @when.ToString("MM/dd/yyyy") at @when.ToString("h:mm tt")</span>
            </div>
        }

        @if (_placeName is { } place)
        {
            <div class="composer-note" id="feed-composer-place">
                <BenIcon Name="map-pin" />
                <span>said at @place</span>
                <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick="ClearPlace">Remove</button>
            </div>
        }
        else if (_locationError is not null)
        {
            <div class="composer-note text-secondary" id="feed-composer-place-failed">@_locationError</div>
        }

        @* The tools, as one row of icons (Ben, 2026-09-11). Each says what it is in a tooltip
           rather than in a word inside the button — the marks are ones people know, and a row of
           labelled buttons is a toolbar that pushes the Post button off a phone. *@
        <div class="composer-tools mt-2">
            @* A label styled as a button: the file input itself is hidden because no browser
               lets its default rendering be styled, and every one of them renders it differently. *@
            <label class="composer-tool mb-0" title="Photo or video">
                <InputFile OnChange="OnMediaChosen" accept="image/*,video/*" class="d-none"
                           disabled="@_busy" />
                <BenIcon Name="image" />
                <span class="visually-hidden">Add a photo or video</span>
            </label>

            <div class="composer-tool__well">
                <button type="button" class="composer-tool" title="GIF" aria-label="Add a GIF"
                        aria-expanded="@_gifsOpen.ToString().ToLowerInvariant()"
                        @onclick="ToggleGifsAsync" disabled="@_busy">
                    <BenIcon Name="film" />
                </button>

                @if (_gifsOpen)
                {
                    <div class="composer-picker" role="dialog" aria-label="Choose a GIF">
                        <input class="form-control form-control-sm" placeholder="Search Giphy"
                               value="@_gifTerm"
                               @onchange="@(e => SearchGifsAsync(e.Value?.ToString()))" />

                        @if (_gifError is not null)
                        {
                            <p class="small text-secondary mb-0 mt-2">@_gifError</p>
                        }

                        <div class="composer-picker__grid mt-2">
                            @foreach (var gif in _gifs)
                            {
                                <button type="button" class="composer-picker__gif"
                                        title="@gif.Alt" @onclick="@(() => ChooseGif(gif))">
                                    <img src="@gif.PreviewUrl" alt="@gif.Alt" loading="lazy" />
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="composer-tool__well">
                <button type="button" class="composer-tool" title="Emoji" aria-label="Add an emoji"
                        aria-expanded="@_emojiOpen.ToString().ToLowerInvariant()"
                        @onclick="@(() => _emojiOpen = !_emojiOpen)" disabled="@_busy">
                    <BenIcon Name="smile" />
                </button>

                @if (_emojiOpen)
                {
                    @* A short list rather than every emoji there is. A full picker is a component
                       and a font-loading problem; these are the ones this site's posts actually
                       use, and anybody who wants another has their own keyboard. *@
                    <div class="composer-picker composer-picker--emoji" role="group" aria-label="Emoji">
                        @foreach (var emoji in Emoji)
                        {
                            <button type="button" class="composer-picker__emoji"
                                    @onclick="@(() => Insert(emoji))">@emoji</button>
                        }
                    </div>
                }
            </div>

            @* Poll. The editor below is where it is written; this only opens and closes it. *@
            <button type="button" class="composer-tool @(_poll is not null ? "composer-tool--on" : "")"
                    title="Poll" aria-label="Add a poll"
                    aria-pressed="@((_poll is not null).ToString().ToLowerInvariant())"
                    @onclick="TogglePoll" disabled="@_busy">
                <BenIcon Name="bar-chart-2" />
            </button>

            <div class="composer-tool__well">
                <button type="button" class="composer-tool @(_scheduledFor is not null ? "composer-tool--on" : "")"
                        title="Schedule" aria-label="Schedule this post"
                        aria-expanded="@_scheduleOpen.ToString().ToLowerInvariant()"
                        @onclick="@(() => { _scheduleOpen = !_scheduleOpen; _emojiOpen = false; _gifsOpen = false; })"
                        disabled="@_busy">
                    <BenIcon Name="clock" />
                </button>

                @if (_scheduleOpen)
                {
                    <div class="composer-picker composer-picker--schedule">
                        <label class="small text-secondary d-block mb-1" for="composer-when">
                            Show it from
                        </label>
                        @* The picker speaks the reader's own clock and the value is turned into
                           UTC on the way out — a scheduled time typed as 8pm means 8pm where the
                           person typing it is standing. *@
                        <input id="composer-when" type="datetime-local" class="form-control form-control-sm"
                               value="@(_scheduledFor?.ToString("yyyy-MM-ddTHH:mm"))"
                               @onchange="OnScheduleChosen" />
                        @if (_scheduledFor is not null)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 mt-1"
                                    @onclick="@(() => { _scheduledFor = null; _scheduleOpen = false; })">
                                Post it straight away
                            </button>
                        }
                    </div>
                }
            </div>

            @* Where it is being written. Asked for, never taken: a location attached without being
               asked is somebody's whereabouts published on their behalf. *@
            <button type="button" class="composer-tool @(_placeName is not null ? "composer-tool--on" : "")"
                    title="@(_placeName is null ? "Tag where you are" : $"Tagged: {_placeName}")"
                    aria-label="@(_placeName is null ? "Tag where you are" : $"Tagged at {_placeName}")"
                    @onclick="ToggleLocationAsync" disabled="@(_busy || _locating)">
                <BenIcon Name="map-pin" />
            </button>

            @if (Remaining <= WarnBelow)
            {
                <span class="small @(Remaining < 0 ? "text-danger" : "text-secondary")">@Remaining</span>
            }

            @* The hint drops away on a narrow screen: the row must not wrap, and the Post button
               matters more than a reminder about @@names. *@
            <span class="small text-secondary d-none d-lg-inline">
                Use <code>@@name</code> to mention somebody and <code>#tag</code> to tag a post.
            </span>

            <button type="button" class="btn btn-primary btn-sm ms-auto"
                    disabled="@(_busy || !CanPost)" @onclick="PostAsync">
                @(_busy ? "Posting…" : ButtonText)
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The emoji offered, in the order they are offered.
    /// </summary>
    /// <remarks>
    /// A short list on purpose. A complete picker is a component, a font-loading problem and a
    /// search box; these are the ones a site about night walks actually uses, and anybody who
    /// wants a different one has a keyboard that already offers every emoji there is.
    /// </remarks>
    private static readonly string[] Emoji =
        ["👻", "😀", "😂", "😍", "😮", "😢", "👏", "🔥", "💀", "🕯️", "🌙", "🏚️", "📸", "🎧", "❤️", "👍"];

    private bool _gifsOpen;
    private bool _emojiOpen;
    private bool _scheduleOpen;
    private bool _locating;
    private NewPollRequest? _poll;
    private DateTime? _scheduledFor;
    private decimal? _placeLatitude;
    private decimal? _placeLongitude;
    private string? _placeName;
    private string? _locationError;

    /// <summary>Opens a blank poll, or drops the one that is open.</summary>
    private void TogglePoll()
    {
        _poll = _poll is null ? new NewPollRequest("", ["", ""], false, 24) : null;
        _gifsOpen = false;
        _emojiOpen = false;
    }

    /// <summary>
    /// Takes the time from the picker as the READER's wall clock.
    /// </summary>
    /// <remarks>
    /// A datetime-local box has no zone in it, and the person typing 8pm means 8pm where they are
    /// standing. It is turned into an instant on the way out, once, in PostAsync.
    /// </remarks>
    private void OnScheduleChosen(ChangeEventArgs e)
    {
        _scheduledFor = DateTime.TryParse(e.Value?.ToString(), out var when) ? when : null;
        _scheduleOpen = false;
    }

    /// <summary>
    /// Tags where this is being written, or takes the tag off.
    /// </summary>
    /// <remarks>
    /// <para>Asked for every time, never remembered and never taken quietly: a location attached
    /// to a message without being asked for is somebody's whereabouts published on their
    /// behalf.</para>
    ///
    /// <para>The name comes from reverse geocoding, and the post keeps the coordinates as well —
    /// the name is what a reader sees, the coordinates are what the little map draws. A refusal,
    /// or a browser with no geolocation at all, leaves the post exactly as it was and says so
    /// rather than failing silently.</para>
    /// </remarks>
    private async Task ToggleLocationAsync()
    {
        if (_placeName is not null) { ClearPlace(); return; }

        _locating = true;
        _locationError = null;
        try
        {
            var position = await JS.InvokeAsync<GeoPosition>("benGetCurrentPosition");
            _placeLatitude = (decimal)position.Latitude;
            _placeLongitude = (decimal)position.Longitude;

            var place = await Feed.ReverseGeocodeAsync(position.Latitude, position.Longitude);
            _placeName = Describe(place)
                // Without a name the coordinates still work and still draw a map, so the tag is
                // kept rather than thrown away over a geocoder that did not answer.
                ?? $"{position.Latitude:F3}, {position.Longitude:F3}";
        }
        catch (JSException)
        {
            _locationError = "Your browser did not share a location.";
            ClearPlace();
        }
        finally { _locating = false; }
    }

    private void ClearPlace()
    {
        _placeLatitude = null;
        _placeLongitude = null;
        _placeName = null;
    }

    /// <summary>The place in as few words as say where it is.</summary>
    private static string? Describe(ReverseGeocodingResponse? place)
    {
        if (place is null) return null;

        var parts = new[] { place.City, place.State }.Where(p => !string.IsNullOrWhiteSpace(p));
        var text = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    /// <summary>What benGetCurrentPosition resolves with.</summary>
    private sealed record GeoPosition(double Latitude, double Longitude);
    private string _gifTerm = "";
    private string? _gifError;
    private IReadOnlyList<Ben.Service.Models.Feed.GiphyItem> _gifs = [];

    /// <summary>Opens the GIF picker, loading what is trending the first time.</summary>
    private async Task ToggleGifsAsync()
    {
        _gifsOpen = !_gifsOpen;
        _emojiOpen = false;
        if (_gifsOpen && _gifs.Count == 0) await SearchGifsAsync(null);
    }

    private async Task SearchGifsAsync(string? term)
    {
        _gifTerm = term ?? "";
        _gifError = null;

        var result = await Feed.SearchGifsAsync(term);

        // The refusal is kept rather than flattened into an empty grid: "nothing matched" and
        // "Giphy could not be reached" look identical as an empty grid, and only one of them is
        // worth trying again.
        if (result.Failed)
        {
            _gifs = [];
            _gifError = "GIFs aren't available just now.";
            return;
        }

        _gifs = result.Items;
        if (_gifs.Count == 0) _gifError = "Nothing matched.";
    }

    /// <summary>
    /// Puts the GIF's address in the box, which is what posts it.
    /// </summary>
    /// <remarks>
    /// A link rather than an upload: the image lives on Giphy, the body carries its address, and
    /// the link card under the post renders it — so a GIF costs no storage here and needs no new
    /// column to say a post has one.
    /// </remarks>
    private void ChooseGif(Ben.Service.Models.Feed.GiphyItem gif)
    {
        Insert(gif.Url);
        _gifsOpen = false;
    }

    /// <summary>Adds text to the end of what is written, with a space if one is wanted.</summary>
    private void Insert(string text)
    {
        var body = _body ?? "";
        var gap = body.Length == 0 || body.EndsWith(' ') || body.EndsWith('\n') ? "" : " ";
        _body = body + gap + text;
        _emojiOpen = false;
    }

    /// <summary>Matches the server's own limit, so the box refuses what the API would.</summary>
    private const int MaxLength = 1000;

    /// <summary>How close to the limit before the count is worth showing.</summary>
    private const int WarnBelow = 100;

    /// <summary>Set to reply to a post rather than start one.</summary>
    [Parameter] public Guid? ParentPostId { get; set; }

    [Parameter] public string Placeholder { get; set; } = "What did you find?";
    [Parameter] public string ButtonText { get; set; } = "Post";

    /// <summary>Raised with the new post, so the caller can put it straight on the page.</summary>
    [Parameter] public EventCallback<FeedPostRecord> OnPosted { get; set; }

    private string _body = string.Empty;
    private string? _error;
    private bool _busy;

    private int Remaining => MaxLength - _body.Length;

    /// <summary>
    /// A picture on its own is a post. The server still requires a body, so the caption written
    /// for a media-only post is the file's own name — better than refusing somebody who has said
    /// everything they wanted to with the photograph.
    /// </summary>
    private bool CanPost => (!string.IsNullOrWhiteSpace(_body) || _media is not null) && Remaining >= 0;

    // @oninput rather than @bind: the Post button is gated on this value, and binding on blur would
    // leave the button dead for anyone who types and clicks straight through.
    private void OnBodyInput(ChangeEventArgs e)
    {
        _body = e.Value?.ToString() ?? string.Empty;
        _error = null;
    }

    /// <summary>
    /// The largest file a post may carry.
    /// </summary>
    /// <remarks>
    /// A limit here rather than nowhere, despite the site's general no-caps rule (the upload-limits
    /// item): this is the one door open to everybody who belongs, and it is served back to every
    /// reader who scrolls past. The number is about what a feed can serve, not about what the
    /// storage can hold.
    /// </remarks>
    private const long MaxMediaBytes = 200L * 1024 * 1024;

    private IBrowserFile? _media;
    private Guid? _experienceTypeId;
    private IReadOnlyList<ExperienceCategoryWithTypesResponse>? _taxonomy;
    private bool _taxonomyFailed;

    private async Task OnMediaChosen(InputFileChangeEventArgs e)
    {
        _media = e.FileCount > 0 ? e.File : null;
        _error = null;

        // Fetched the first time media is attached, not on page load: the select isn't shown
        // until then, and most feed visits never open the composer at all.
        if (_media is not null && _taxonomy is null)
        {
            var taxonomy = await Feed.GetExperienceTaxonomyAsync();
            _taxonomyFailed = taxonomy.Failed;
            _taxonomy = taxonomy.Failed ? null : taxonomy.Items;
        }
    }

    private void OnTypeChosen(ChangeEventArgs e)
        => _experienceTypeId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void ClearMedia()
    {
        _media = null;
        _experienceTypeId = null;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024.0):0.#} MB",
        >= 1024        => $"{bytes / 1024.0:0.#} KB",
        _              => $"{bytes} bytes",
    };

    private async Task PostAsync()
    {
        if (!CanPost) return;

        _busy = true;
        _error = null;

        try
        {
            Stream? media = null;
            if (_media is not null)
            {
                // Opened only now, at post time: a stream held from the moment of choosing would
                // be a file handle kept open for as long as somebody takes to write their post.
                media = _media.OpenReadStream(MaxMediaBytes);
            }

            (FeedPostRecord? post, string? error) result;
            try
            {
                result = await Feed.CreatePostAsync(
                    string.IsNullOrWhiteSpace(_body) ? _media!.Name : _body.Trim(), ParentPostId,
                    media: media,
                    mediaFileName: _media?.Name,
                    mediaContentType: _media?.ContentType,
                    experienceTypeId: _experienceTypeId,
                    poll: _poll,
                    // The box the time was typed into has no zone in it, and somebody who types
                    // 8pm means 8pm where they are standing. It becomes an instant here, once,
                    // against the READER's zone — TimeZoneInfo.Local on a Blazor Server page is
                    // the zone of the machine in the rack, which is nobody's 8pm.
                    scheduledForUtc: _scheduledFor is { } when
                        ? TimeZoneInfo.ConvertTimeToUtc(
                            DateTime.SpecifyKind(when, DateTimeKind.Unspecified), UserState.BrowserTimeZone)
                        : null,
                    postedLatitude: _placeLatitude,
                    postedLongitude: _placeLongitude,
                    postedPlaceName: _placeName);
            }
            catch (IOException)
            {
                // OpenReadStream throws this when the file is over the cap.
                _error = $"That file is larger than {MaxMediaBytes / (1024 * 1024)} MB.";
                return;
            }
            finally
            {
                if (media is not null) await media.DisposeAsync();
            }

            var (post, error) = result;

            if (error is not null || post is null)
            {
                // The server's own words where it gave them — "a post can be at most 1000
                // characters" is something to act on, unlike "something went wrong".
                _error = error ?? "Couldn't post that. Try again in a moment.";
                return;
            }

            _body = string.Empty;
            _media = null;
            _experienceTypeId = null;
            _poll = null;
            _scheduledFor = null;
            _scheduleOpen = false;
            ClearPlace();
            await OnPosted.InvokeAsync(post);
        }
        finally
        {
            _busy = false;
        }
    }
}
