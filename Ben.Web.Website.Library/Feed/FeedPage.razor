@page "/feed"
@page "/feed/tags/{Tag}"
@page "/feed/types/{TypeId:guid}"
@namespace Ben.Web.Website.Library.Feed
@using Ben.Service.Models.Feed
@using Ben.Web.Services

@implements IAsyncDisposable

@inject IBenAdminClient Feed
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>@(Tag is not null ? $"#{Tag}" : _typeName ?? "Feed")</PageTitle>

@*
    The feed.

    Two modes — everybody, or the people you follow — and an optional tag. The tag arrives as a
    route rather than a query string so a tag page is a link somebody can share, which is most of
    what tags are for.

    Paging is infinite scroll WITH a "load more" button underneath (item 186). The scroll is the
    hook the feed exists to be; the button is what still works with no JavaScript, and it is the
    honest bottom of the page for somebody who wants to stop.

    Anyone may read this page, signed in or not. What a visitor does not get is the composer —
    that slot shows FeedJoinPrompt instead, which is the whole funnel: read freely, join to join in.
*@

<FeatureGate Flag="@SiteFeatures.PublicFeed">
    <div class="container py-3" style="max-width: 680px;">

        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="mb-0">
                @if (Tag is not null)
                {
                    <text>#@Tag</text>
                }
                else if (TypeId is not null)
                {
                    @* The type's name arrives with the first page's posts; the id is an ugly
                       heading for the beat before that. *@
                    <text>@(_typeName ?? "Category")</text>
                }
                else
                {
                    <text>Feed</text>
                }
                <HelpLink Slug="the-feed" />
            </h3>

            @if (Tag is not null || TypeId is not null)
            {
                <a class="btn btn-outline-secondary btn-sm" href="/feed">All posts</a>
            }
        </div>

        @if (Tag is null)
        {
            <ul class="nav nav-tabs mb-3">
                @foreach (var (mode, label) in Modes.Where(m => m.Mode != "following" || (_authKnown && IsSignedIn)))
                {
                    <li class="nav-item">
                        <button type="button" class="nav-link @(_mode == mode ? "active" : null)"
                                @onclick="() => SwitchModeAsync(mode)">
                            @label
                        </button>
                    </li>
                }
            </ul>
        }

        @* No composer on a tag page. A post written there would not carry the tag unless the
           author typed it, and a composer that silently does not do what its context implies is
           worse than no composer. *@
        @* Nothing is claimed about the reader until the SERVER has said whether they may post.
           Auth resolving is not enough: CanPost arrives with the first page, a beat later, and
           rendering on auth alone flashed "Join a group to post here" at members before their own
           composer appeared. Caught by the e2e walk, which saw the join card and gave up waiting. *@
        @if (Tag is null && _participationKnown)
        {
            @if (_canPost)
            {
                <FeedComposer OnPosted="OnPosted" />
            }
            else
            {
                @* Same card, two audiences: a visitor needs an account, a signed-in stranger
                   needs a group or a case. The server decided which — see FeedPageRecord.CanPost. *@
                <FeedJoinPrompt IsAuthenticated="@IsSignedIn" />
            }
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        @if (_loading)
        {
            <p class="text-secondary">Loading…</p>
        }
        else if (_posts.Count == 0)
        {
            <div class="text-center text-secondary py-5">
                @if (Tag is not null)
                {
                    <p class="mb-0">Nothing tagged <strong>#@Tag</strong> yet.</p>
                }
                else if (_mode == "following")
                {
                    <p class="mb-1">Nothing from the people you follow.</p>
                    <p class="mb-0 small">Follow somebody from their name on a post, or read
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                @onclick="@(() => SwitchModeAsync("all"))">the latest posts</button>.</p>
                }
                else if (IsSignedIn)
                {
                    <p class="mb-0">Nothing here yet. Be the first.</p>
                }
                else
                {
                    <p class="mb-0">Nothing here yet.</p>
                }
            </div>
        }
        else
        {
            @for (var i = 0; i < _posts.Count; i++)
            {
                var post = _posts[i];
                <FeedPostCard Post="@post"
                              CanAct="@(_participationKnown && _canPost)"
                              OnLikeToggled="ToggleLikeAsync"
                              OnFollowToggled="ToggleFollowAsync"
                              OnReportRequested="ReportAsync"
                              OnRecategorized="SwapPost" />

                @* ── The weave (item 186 F8): one promoted slot per eight posts, real cards and
                   house cards alternating, main feed only — a tag or type page stays clean.
                   Positions 8, 16, 24… so nobody meets an ad before they've met the feed. *@
                @if (Tag is null && TypeId is null && (i + 1) % AdEvery == 0)
                {
                    var slot = (i + 1) / AdEvery;
                    if (slot % 2 == 1 && NextPromoted(slot) is { } ad)
                    {
                        <div class="card mb-2 bv-feed-promoted">
                            <div class="card-body py-3">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <h6 class="mb-1">@ad.Headline</h6>
                                    <span class="badge bg-info" title="This group promotes itself here">Promoted</span>
                                </div>
                                <p class="small mb-2">@ad.Body</p>
                                <div class="d-flex align-items-center gap-2 flex-wrap small">
                                    @* /go so the click is counted; the route owns the closed set. *@
                                    <a href="@($"/go/{ad.AdId}")" class="fw-semibold text-decoration-none">
                                        @ad.OrganizationName →
                                    </a>
                                    @if (ad.DistanceMiles is { } miles)
                                    {
                                        <span class="text-secondary">@miles.ToString("0.#") miles from you</span>
                                    }
                                    else if (!_locationShared)
                                    {
                                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary"
                                                id="feed-share-location"
                                                @onclick="RequestLocationAsync">
                                            Show groups near you
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else if (slot % 2 == 0)
                    {
                        @* The house card — the site's own, and it says so. *@
                        <div class="card mb-2 bv-feed-house">
                            <div class="card-body py-3 d-flex align-items-center gap-3">
                                <BenIcon Name="users" Class="fs-4 text-info" />
                                <div class="flex-grow-1 small">
                                    <strong>Investigating something yourself?</strong>
                                    Find a group near you, or start your own.
                                </div>
                                <a class="btn btn-outline-primary btn-sm" href="/find">Find a group</a>
                            </div>
                        </div>
                    }
                }
            }

            @if (_nextCursor is not null)
            {
                @* The observer watches this; the button below is the fallback and the floor. *@
                <div @ref="_sentinel" id="feed-scroll-sentinel" style="height:1px;"></div>

                <div class="text-center my-3">
                    <button type="button" class="btn btn-outline-secondary" disabled="@_loadingMore"
                            @onclick="LoadMoreAsync">
                        @(_loadingMore ? "Loading…" : "Load more")
                    </button>
                </div>
            }
        }
    </div>
</FeatureGate>

@code {
    /// <summary>Set when the page is a tag page.</summary>
    [Parameter] public string? Tag { get; set; }

    /// <summary>One experience type's posts (item 186 F6) — the chip's landing page.</summary>
    [Parameter] public Guid? TypeId { get; set; }

    /// <summary>The type's display name, learned from the first post that carries it.</summary>
    private string? _typeName;

    // ── Promoted weave (item 186 F8) ─────────────────────────────────────────
    /// <summary>One promoted slot per this many posts.</summary>
    private const int AdEvery = 8;

    private List<Ben.Service.Models.Entities.PromotedGroupCard> _promoted = [];
    /// <summary>Session-only. Shared by an explicit click, sent as query values, never stored.</summary>
    private double? _viewerLat, _viewerLon;
    private bool _locationShared;
    private DotNetObjectReference<FeedPage>? _geoRef;

    /// <summary>The card for a promoted slot, round-robin over what the server sent.</summary>
    private Ben.Service.Models.Entities.PromotedGroupCard? NextPromoted(int slot)
        => _promoted.Count == 0 ? null : _promoted[(slot / 2) % _promoted.Count];

    private async Task LoadPromotedAsync()
    {
        // Failure renders nothing — promotion is garnish on the feed, same doctrine as the
        // placements card (on record in LoadResultRenderedGuardTests.Decorations).
        var cards = await Feed.GetPromotedGroupsAnonymousAsync(
            4, lat: _viewerLat, lon: _viewerLon);
        if (!cards.Failed) _promoted = cards.Items.ToList();
    }

    /// <summary>The consent affordance: an explicit click, the browser's own permission prompt,
    /// and the answer lives only in this circuit.</summary>
    private async Task RequestLocationAsync()
    {
        _geoRef ??= DotNetObjectReference.Create(this);
        await using var geo = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/_content/Ben.Web.Website.Library/Shared/NearbyDiscovery.razor.js");
        await geo.InvokeVoidAsync("tryGetUserLocation", _geoRef);
    }

    [JSInvokable]
    public async Task SetUserLocation(double? lat, double? lon)
    {
        _locationShared = true; // asked and answered, either way — don't re-offer
        if (lat is not null && lon is not null)
        {
            _viewerLat = lat;
            _viewerLon = lon;
            await LoadPromotedAsync(); // re-ordered nearest-first
        }
        StateHasChanged();
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private static readonly (string Mode, string Label)[] Modes =
    [
        ("foryou", "For You"),
        ("all", "Latest"),
        ("following", "Following"),
    ];

    private readonly List<FeedPostRecord> _posts = [];
    private string _mode = "foryou";
    private string? _nextCursor;
    private string? _error;
    private bool _loading = true;
    private bool _loadingMore;

    /// <summary>True once the auth state has actually resolved — see the markup comment.</summary>
    private bool _authKnown;

    /// <summary>
    /// True once the server has answered whether this reader may post. Strictly later than
    /// <see cref="_authKnown"/>, and the thing the composer slot waits for.
    /// </summary>
    private bool _participationKnown;

    /// <summary>
    /// Whether this reader may write here, as answered by the server (item 186 F2).
    /// </summary>
    /// <remarks>
    /// Not computed in the browser. Membership and client standing are the server's to know, and a
    /// UI that worked them out for itself would be a second implementation of the rule the create
    /// endpoint enforces — the two would drift, and the visible symptom would be a composer that
    /// takes a post and then refuses it.
    /// </remarks>
    private bool _canPost;

    /// <summary>
    /// Read at render time, never cached into a field.
    /// </summary>
    /// <remarks>
    /// The auth state restores asynchronously after the circuit starts, so a field assigned once
    /// in OnParametersSetAsync can be false for a signed-in member for the rest of the page's
    /// life — which showed a member the join card and hid their own composer. Caught live; the
    /// post cards next to it were right the whole time because they read the property.
    /// </remarks>
    private bool IsSignedIn => UserState.IsAuthenticated;

    private ElementReference _sentinel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<FeedPage>? _self;
    private bool _observing;

    protected override async Task OnParametersSetAsync()
    {
        // Runs again when the tag in the route changes — navigating from one tag page to another
        // keeps the component, so reloading here is what makes the second tag show its own posts.
        //
        // No sign-in gate any more (item 186): a visitor reads the same page, minus the composer.
        // The auth wait still matters — it decides which slot renders and whether Following shows,
        // and reading it before the circuit is ready would show a signed-in person the join card.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        _authKnown = true;

        // A visitor has no "Following" feed to land on if a stale link says so.
        if (!IsSignedIn && _mode == "following") _mode = "all";

        await LoadAsync();
    }

    private async Task SwitchModeAsync(string mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _posts.Clear();
        _nextCursor = null;
        StateHasChanged();

        try
        {
            var page = await Feed.GetFeedAsync(_mode, Tag, experienceType: TypeId);
            if (page is null)
            {
                _error = "Couldn't load the feed.";
                return;
            }

            _posts.AddRange(page.Posts);
            _nextCursor = page.NextCursor;
            _canPost = page.CanPost;
            _participationKnown = true;
            _typeName ??= page.Posts.FirstOrDefault(p => p.ExperienceTypeId == TypeId)?.ExperienceTypeName;

            // The weave's cards (item 186 F8) — main feed only, and only worth fetching when
            // there are enough posts for the first slot to exist.
            if (Tag is null && TypeId is null && _posts.Count >= AdEvery && _promoted.Count == 0)
                await LoadPromotedAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_nextCursor is null || _loadingMore) return;

        _loadingMore = true;
        try
        {
            var page = await Feed.GetFeedAsync(_mode, Tag, _nextCursor, experienceType: TypeId);
            if (page is null) return;

            _posts.AddRange(page.Posts);
            _nextCursor = page.NextCursor;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    /// <summary>The scroll sentinel's way in. Guarded by LoadMoreAsync's own re-entry check.</summary>
    /// <remarks>
    /// StateHasChanged is explicit because this arrives from JS rather than from a Blazor event,
    /// so nothing re-renders on its own — the posts would load and never appear.
    /// </remarks>
    [JSInvokable]
    public async Task LoadMoreFromScrollAsync()
    {
        if (_nextCursor is null || _loadingMore) return;
        await LoadMoreAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Attaches the scroll observer once the sentinel is on the page, and drops it when it is not.
    /// </summary>
    /// <remarks>
    /// Re-observed rather than observed-once because the sentinel is inside the @if that hides it
    /// at the end of the feed: it is a different element each time there is more to load, and an
    /// observer still watching a detached node fires nothing at all.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive) return;

        var wantsObserver = _nextCursor is not null;
        if (!wantsObserver)
        {
            if (_observing && _module is not null)
            {
                try { await _module.InvokeVoidAsync("disconnect"); } catch (JSDisconnectedException) { }
                _observing = false;
            }
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Ben.Web.Website.Library/Feed/FeedPage.razor.js");
            _self ??= DotNetObjectReference.Create(this);
            _observing = await _module.InvokeAsync<bool>("observeSentinel", _sentinel, _self);
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-render. The button still works for whoever comes back.
        }
        catch (JSException)
        {
            // No module, no observer, no problem: "Load more" is the fallback by design.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("disconnect");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }

        _self?.Dispose();
        _geoRef?.Dispose();
    }

    /// <summary>
    /// Puts a new post straight on the page.
    /// </summary>
    /// <remarks>
    /// Rather than reloading: the post is already in hand, a reload costs a round trip, and — the
    /// part that matters — a reload of the "following" feed would drop the post the person just
    /// wrote if they follow nobody, which reads as the post having failed.
    /// </remarks>
    private void OnPosted(FeedPostRecord post) => _posts.Insert(0, post);

    /// <summary>Swaps in a post the server re-read — a recategorize's fresh copy.</summary>
    private void SwapPost(FeedPostRecord post)
    {
        var index = _posts.FindIndex(p => p.Id == post.Id);
        if (index >= 0) _posts[index] = post;
    }

    /// <summary>
    /// Likes or unlikes, optimistically.
    /// </summary>
    /// <remarks>
    /// The count moves before the server answers because a heart that waits a round trip feels
    /// broken, and puts back exactly what it changed if the call fails — the post is found by id
    /// rather than by reference, since the list may have been rebuilt underneath.
    /// </remarks>
    private async Task ToggleLikeAsync(FeedPostRecord post)
    {
        var nowLiked = !post.LikedByCurrentUser;
        ApplyLike(post.Id, nowLiked);

        var ok = nowLiked
            ? await Feed.LikeAsync(post.Id)
            : await Feed.UnlikeAsync(post.Id);

        if (!ok)
        {
            ApplyLike(post.Id, !nowLiked);
            _error = "Couldn't record that. Try again in a moment.";
        }
    }

    private void ApplyLike(Guid postId, bool liked)
    {
        var index = _posts.FindIndex(p => p.Id == postId);
        if (index < 0) return;

        var post = _posts[index];
        if (post.LikedByCurrentUser == liked) return;

        _posts[index] = post with
        {
            LikedByCurrentUser = liked,
            LikeCount = Math.Max(0, post.LikeCount + (liked ? 1 : -1)),
        };
    }

    private async Task ToggleFollowAsync(FeedPostRecord post)
    {
        var nowFollowing = !post.AuthorIsFollowedByCurrentUser;

        var ok = nowFollowing
            ? await Feed.FollowAsync(post.AuthorAppUserId)
            : await Feed.UnfollowAsync(post.AuthorAppUserId);

        if (!ok) { _error = "Couldn't change that. Try again in a moment."; return; }

        // Every post by that author, not just the one clicked — otherwise the same person reads
        // "Follow" on one post and "Following" on the next, which looks broken.
        for (var i = 0; i < _posts.Count; i++)
        {
            if (_posts[i].AuthorAppUserId == post.AuthorAppUserId)
                _posts[i] = _posts[i] with { AuthorIsFollowedByCurrentUser = nowFollowing };
        }
    }

    private async Task ReportAsync(FeedPostRecord post)
    {
        // No reason prompt yet: the endpoint takes one, and a dialog asking for it is worth adding
        // once there is evidence administrators need more than "somebody objected". Reporting is
        // one press, and pressing it twice changes nothing.
        if (!await Feed.ReportPostAsync(post.Id, null))
        {
            _error = "Couldn't report that. Try again in a moment.";
            return;
        }

        var index = _posts.IndexOf(post);
        if (index >= 0) _posts[index] = post with { ReportedByCurrentUser = true };
    }
}
