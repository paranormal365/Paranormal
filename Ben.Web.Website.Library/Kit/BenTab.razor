@implements IDisposable

@* The pane, drawn here rather than by the strip — see BenTabs for why. *@
@if (Parent?.IsActive(this) == true)
{
    <div class="tab-pane fade show active" role="tabpanel">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private BenTabs? Parent { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Stable identifier, so a parent can select this tab by name rather than position.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Sprite icon name shown before the title.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Count shown as a badge on the tab; omit or 0 for none.</summary>
    [Parameter] public int? Badge { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (Parent is null)
            throw new InvalidOperationException($"<BenTab Title=\"{Title}\"> must be inside a <BenTabs>.");
        Parent.Register(this);
        _header = Header;
    }

    /// <summary>What the strip last drew for this tab's button.</summary>
    private (string, string?, int?, bool) _header;

    private (string, string?, int?, bool) Header => (Title, Icon, Badge, Disabled);

    /// <summary>
    /// The strip draws this tab's button before this tab receives its new parameters, so a new
    /// badge count (a picture added) would show one render late. Values, not delegates, so a
    /// redraw that changes nothing asks for nothing.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Header == _header) return;
        _header = Header;
        Parent?.HeaderChanged();
    }

    public void Dispose() => Parent?.Unregister(this);
}
