@*
    TelerikTabStrip replacement. Active tab is C# state and panels render from the component's
    own tree — no data-bs-toggle="tab", so Bootstrap's Tab plugin never takes ownership of this
    subtree and inputs inside a tab keep binding.
*@

<CascadingValue Value="this" IsFixed="true">
    @* Children register themselves during this first pass; the markup below renders from that list. *@
    <div class="d-none">@ChildContent</div>
</CascadingValue>

<ul class="nav @NavClass" role="tablist">
    @foreach (var tab in _tabs)
    {
        var index = _tabs.IndexOf(tab);
        <li class="nav-item" role="presentation">
            <button type="button"
                    class="nav-link @(index == ActiveIndex ? "active" : null) @(tab.Disabled ? "disabled" : null)"
                    role="tab"
                    aria-selected="@((index == ActiveIndex).ToString().ToLowerInvariant())"
                    disabled="@tab.Disabled"
                    @onclick="() => ActivateAsync(index)">
                @if (!string.IsNullOrWhiteSpace(tab.Icon))
                {
                    <BenIcon Name="@tab.Icon" Class="me-1" />
                }
                @tab.Title
                @if (tab.Badge is { } badge && badge > 0)
                {
                    <span class="badge bg-secondary ms-1">@badge</span>
                }
            </button>
        </li>
    }
</ul>

<div class="tab-content pt-3">
    @if (_tabs.Count > 0 && ActiveIndex >= 0 && ActiveIndex < _tabs.Count)
    {
        <div class="tab-pane fade show active" role="tabpanel">
            @_tabs[ActiveIndex].ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Index of the visible tab. Two-way bindable: <c>@bind-ActiveIndex</c>.</summary>
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>
    /// Id of the visible tab, for call sites that address tabs by name rather than position —
    /// which survives tabs being reordered or conditionally hidden, unlike an index.
    /// Set <see cref="BenTab.Id"/> on each tab to use this.
    /// </summary>
    [Parameter] public string? ActiveId { get; set; }
    [Parameter] public EventCallback<string> ActiveIdChanged { get; set; }

    /// <summary>"nav-tabs" (default) or "nav-pills".</summary>
    [Parameter] public string NavClass { get; set; } = "nav-tabs";

    private readonly List<BenTab> _tabs = new();

    internal void Register(BenTab tab)
    {
        if (_tabs.Contains(tab)) return;
        _tabs.Add(tab);
        StateHasChanged();
    }

    internal void Unregister(BenTab tab)
    {
        if (!_tabs.Remove(tab)) return;
        if (ActiveIndex >= _tabs.Count) ActiveIndex = Math.Max(0, _tabs.Count - 1);
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // An ActiveId from the caller wins over whatever index we were on, so the two stay
        // consistent when a page drives the strip by id.
        if (ActiveId is null) return;

        var i = _tabs.FindIndex(t => t.Id == ActiveId);
        if (i >= 0) ActiveIndex = i;
    }

    private async Task ActivateAsync(int index)
    {
        if (index == ActiveIndex) return;

        ActiveIndex = index;
        if (ActiveIndexChanged.HasDelegate) await ActiveIndexChanged.InvokeAsync(index);

        var id = _tabs.ElementAtOrDefault(index)?.Id;
        if (id is not null && ActiveIdChanged.HasDelegate) await ActiveIdChanged.InvokeAsync(id);
    }
}
