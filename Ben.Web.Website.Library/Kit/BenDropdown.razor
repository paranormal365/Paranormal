@*
    TelerikPopover replacement, on Bootstrap's dropdown markup with Blazor-owned open state.

    No data-bs-toggle: Bootstrap's Dropdown plugin would take ownership of this subtree, and
    anything interactive inside (a filter box, a form) would stop binding. Dismissal uses a
    transparent backdrop element rather than a document-level JS listener — it cannot outlive
    the component, and it costs no interop.

    Floating (UI test pass, 2026-09-14): a menu is positioned inside its parent, and a grid clips its cells — the
    Organizations grid's More actions opened as a four-pixel sliver with its nine choices cut off. A Floating dropdown
    places its open menu against the window instead (BenDropdown.razor.js), below the button or above it when there is no
    room, kept on screen, and following the button while the page scrolls.
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="dropdown @Class">
    <button type="button" @ref="_toggle" class="@ToggleClass @(NoArrow ? "no-arrow" : "dropdown-toggle") @(_open ? "show ben-dropdown-open" : null)"
            title="@Title" aria-label="@Title"
            aria-expanded="@_open.ToString().ToLowerInvariant()"
            disabled="@Disabled"
            @onclick="Toggle">
        @ToggleContent
    </button>

    <div @ref="_menu" class="dropdown-menu @(AlignEnd ? "dropdown-menu-end" : null) dropdown-menu-animated @(_open ? "show" : null)"
         style="@(MinWidth is not null ? $"min-width:{MinWidth};" : null)">
        @* Only while open: a closed menu that still renders its items leaves every one of them
           in the DOM as an invisible match for any text lookup. The wrapper stays so the
           template's open/close animation still has something to animate. *@
        @if (_open)
        {
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        }
    </div>
</div>

@if (_open)
{
    <div class="ben-dropdown-backdrop" @onclick="Close"></div>
}

@code {
    /// <summary>What the trigger button renders — an icon, an avatar, a label.</summary>
    [Parameter] public RenderFragment? ToggleContent { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string ToggleClass { get; set; } = "btn btn-system";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool AlignEnd { get; set; } = true;
    [Parameter] public bool NoArrow { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Places the open menu against the window, for a dropdown inside something that clips it — a grid cell.</summary>
    [Parameter] public bool Floating { get; set; }

    /// <summary>CSS length, e.g. "320px".</summary>
    [Parameter] public string? MinWidth { get; set; }

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private bool _open;
    private bool _placed;
    private ElementReference _toggle;
    private ElementReference _menu;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Floating || _open == _placed) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Ben.Web.Website.Library/Kit/BenDropdown.razor.js");
            if (_open) await _module.InvokeVoidAsync("place", _toggle, _menu, AlignEnd);
            else await _module.InvokeVoidAsync("unplace", _menu);
            _placed = _open;
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            if (_placed) await _module.InvokeVoidAsync("unplace", _menu);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    protected override void OnParametersSet()
    {
        // Only take the caller's value when Open is actually bound. Copying it unconditionally
        // meant an unbound (always-false) parameter slammed the menu shut on every re-render of
        // the parent — invisible in the header, but a grid re-renders constantly, so the menu
        // inside one could never stay open long enough to click.
        if (OpenChanged.HasDelegate) _open = Open;
    }

    private async Task Toggle()
    {
        _open = !_open;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(_open);
    }

    /// <summary>Closes the menu. Items call this so picking one dismisses the dropdown.</summary>
    public async Task Close()
    {
        if (!_open) return;
        _open = false;
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }
}
