@namespace Ben.Web.Website.Library.Kit.Maps
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject MapsOptions Maps

@*
    The one place the site knows how to draw a map (item 228).

    Every map page passes pins and listens for a click; this component decides what draws them.
    Today that is Apple MapKit JS when the website can sign a token for it, and Telerik's map over
    OpenStreetMap tiles when it cannot. The Telerik path is the one being retired, kept only so a
    deployment with no key still has a map, and it goes when the last page has crossed.

    Pins are Apple's own marker annotations rather than HTML: they cluster, select, and follow the
    theme without any of the template-by-name-string plumbing the Telerik path needed.
*@

<div id="@_containerId" class="ben-map" style="height:@Height; border-radius:.5rem; overflow:hidden; position:relative;">
    @if (Maps.Effective == MapProvider.Telerik && _telerikReady)
    {
        <TelerikMap @ref="_telerikMap" Center="@_telerikCenter" Zoom="@_telerikZoom" Height="@Height"
                    OnPanEnd="@OnTelerikPanEnd" OnZoomEnd="@OnTelerikZoomEnd" OnClick="@OnTelerikClick">
            <MapLayers>
                <MapLayer Type="@MapLayersType.Tile"
                          Attribution="© OpenStreetMap contributors"
                          Subdomains="@(new[] { "a", "b", "c" })"
                          UrlTemplate="benMapTileTemplate" />
                @if (Circle is { } circle)
                {
                    <MapLayer Type="@MapLayersType.Shape" Data="@_telerikCircle">
                        <MapLayerShapeSettings>
                            <MapLayerShapeSettingsStyle>
                                <MapLayerShapeSettingsStyleFill Color="@circle.FillColor" Opacity="@circle.FillOpacity" />
                                <MapLayerShapeSettingsStyleStroke Color="@circle.StrokeColor" Opacity="@circle.StrokeOpacity" Width="@circle.StrokeWidth" />
                            </MapLayerShapeSettingsStyle>
                        </MapLayerShapeSettings>
                    </MapLayer>
                }
                @if (_telerikMarkers.Count > 0)
                {
                    <MapLayer Type="@MapLayersType.Marker"
                              Data="@_telerikMarkers"
                              LocationField="@nameof(TelerikMarker.LatLng)"
                              TitleField="@nameof(TelerikMarker.Title)">
                        <MapLayerMarkerSettings Template="benMapMarkerTemplate" />
                    </MapLayer>
                }
            </MapLayers>
        </TelerikMap>
    }
</div>

@code {
    /// <summary>The pins to draw. Replace the list to change them; the map redraws only when it differs.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<BenMapPin> Pins { get; set; } = [];

    [Parameter] public string Height { get; set; } = "420px";

    /// <summary>Where to look when there are no pins, or when <see cref="FitToPins"/> is off.</summary>
    [Parameter] public double CenterLatitude { get; set; } = 39.8283;   // the geographic centre of the US
    [Parameter] public double CenterLongitude { get; set; } = -98.5795;
    [Parameter] public double Zoom { get; set; } = 4;

    /// <summary>Frame every pin on load and whenever the pins change. Off when the caller drives the view.</summary>
    [Parameter] public bool FitToPins { get; set; } = true;

    /// <summary>Raised with the pin's index in <see cref="Pins"/> when somebody selects it.</summary>
    [Parameter] public EventCallback<int> OnPinClicked { get; set; }

    /// <summary>Raised when a pan or zoom ends, with what is now in view. Not raised for the map's own framing.</summary>
    [Parameter] public EventCallback<BenMapViewport> OnViewportChanged { get; set; }

    /// <summary>A region drawn on the ground, or null for none. Replace the record to change it.</summary>
    [Parameter] public BenMapCircle? Circle { get; set; }

    /// <summary>Raised with the ground coordinate when somebody clicks the map itself, not a pin.</summary>
    [Parameter] public EventCallback<BenMapPoint> OnMapClicked { get; set; }

    private readonly string _containerId = $"ben-map-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<BenMap>? _self;
    private IReadOnlyList<BenMapPin>? _drawnPins;
    private BenMapCircle? _drawnCircle;
    private (double Lat, double Lon, double Zoom) _appliedView;
    private bool _ready;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The map can be torn down while its first render is still awaiting the module or the
        // map itself — the home page swaps it for a loader on every reload. Every await below is
        // followed by a check, and the JS calls tolerate a reference that was disposed under
        // them: a continuation that reaches a dead component must simply stop, not throw an
        // unhandled error into the circuit.
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                var module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Ben.Web.Website.Library/Kit/Maps/BenMap.razor.js");
                if (_disposed) { await module.DisposeAsync(); return; }
                _module = module;

                if (Maps.Effective == MapProvider.Apple)
                {
                    await _module.InvokeVoidAsync("create", _containerId, _self, new
                    {
                        tokenPath = MapsOptions.TokenPath,
                        centerLatitude = CenterLatitude, centerLongitude = CenterLongitude, zoom = Zoom,
                        fitToPins = FitToPins,
                        reportClicks = OnMapClicked.HasDelegate,
                    });
                }
                else
                {
                    // Telerik resolves template functions by name string at render time, so the map
                    // waits for the module that registers them. See the retired InvestigationsMap.
                    await _module.InvokeVoidAsync("initTelerik", _containerId, _self);
                    if (_disposed) return;
                    _telerikReady = true;
                    StateHasChanged();
                }
                if (_disposed) return;
            }

            await SyncAsync(firstRender);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException)
        {
            // Disposed or disconnected mid-flight: nothing to draw on, nothing to report.
        }
    }

    private async Task SyncAsync(bool firstRender)
    {

        if (firstRender)
        {
            _appliedView = (CenterLatitude, CenterLongitude, Zoom);
            _ready = true;
        }

        // Blazor runs OnAfterRenderAsync after EVERY render, including ones that land while the
        // first is still awaiting the module and the map. A pass that arrived in that window used
        // to mark the pins as drawn and then find no module to send them to — so a map recreated
        // with its pins already final (the home map after a sort) came up empty. Until the first
        // pass has finished, later passes do nothing; the first pass then syncs whatever the
        // parameters are by the time it gets here.
        if (!_ready || _disposed) return;

        if (!ReferenceEquals(_drawnPins, Pins))
        {
            _drawnPins = Pins;
            if (Maps.Effective == MapProvider.Apple)
            {
                if (_module is not null)
                    await _module.InvokeVoidAsync("setPins", _containerId, Pins);
                if (_disposed) return;
            }
            else
            {
                BuildTelerikMarkers();
                if (_telerikReady) { StateHasChanged(); _telerikMap?.Refresh(); }
            }
        }

        if (!ReferenceEquals(_drawnCircle, Circle))
        {
            _drawnCircle = Circle;
            if (Maps.Effective == MapProvider.Apple)
            {
                if (_module is not null)
                    await _module.InvokeVoidAsync("setCircle", _containerId, Circle);
                if (_disposed) return;
            }
            else
            {
                BuildTelerikCircle();
                if (_telerikReady) { StateHasChanged(); _telerikMap?.Refresh(); }
            }
        }

        // A caller that drives the view (FitToPins off) moves it by changing Center/Zoom — the
        // home map recentring on the person's own location, for one. Applied only when the
        // values actually changed, so an ordinary re-render never yanks the map from under a
        // gesture the person is in the middle of.
        if (!FitToPins && _appliedView != (CenterLatitude, CenterLongitude, Zoom))
        {
            _appliedView = (CenterLatitude, CenterLongitude, Zoom);
            if (Maps.Effective == MapProvider.Apple)
            {
                if (_module is not null)
                    await _module.InvokeVoidAsync("setCenter", _containerId, CenterLatitude, CenterLongitude, Zoom);
            }
            else
            {
                _telerikCenter = [CenterLatitude, CenterLongitude];
                _telerikZoom = Zoom;
                if (_telerikReady) { StateHasChanged(); _telerikMap?.Refresh(); }
            }
        }
    }

    [JSInvokable]
    public Task OnPinSelected(int index) =>
        index >= 0 && index < Pins.Count ? OnPinClicked.InvokeAsync(index) : Task.CompletedTask;

    [JSInvokable]
    public Task OnRegionChanged(double north, double south, double east, double west, double zoom) =>
        OnViewportChanged.HasDelegate
            ? OnViewportChanged.InvokeAsync(new BenMapViewport(north, south, east, west, zoom))
            : Task.CompletedTask;

    /// <summary>
    /// Asks the provider for a driving route, draws it on this map with A and B pins, and returns
    /// what to say about it. Never throws: a route that cannot be had comes back with
    /// <see cref="BenMapRoute.Error"/> set.
    /// </summary>
    /// <remarks>
    /// The origin may be an address in words: the provider looks it up itself, which is one
    /// metered geocoding call this site no longer has to make. Only Apple Maps can answer; the
    /// Telerik fallback says so rather than pretending.
    /// </remarks>
    public async Task<BenMapRoute> RouteAsync(BenMapRouteRequest request)
    {
        if (Maps.Effective != MapProvider.Apple || _module is null || !_ready)
            return new BenMapRoute(0, 0, [], "Directions need Apple Maps, which this site is not set up for yet.");
        try
        {
            return await _module.InvokeAsync<BenMapRoute>("route", _containerId, request)
                   ?? new BenMapRoute(0, 0, [], "No route came back.");
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException)
        {
            return new BenMapRoute(0, 0, [], "The map went away before the route arrived.");
        }
        catch (JSException ex)
        {
            return new BenMapRoute(0, 0, [], $"Directions could not be worked out: {ex.Message}");
        }
    }

    /// <summary>Takes a drawn route and its A and B pins off the map.</summary>
    public async Task ClearRouteAsync()
    {
        if (_module is null || !_ready || Maps.Effective != MapProvider.Apple) return;
        try { await _module.InvokeVoidAsync("clearRoute", _containerId); }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException) { }
    }

    [JSInvokable]
    public Task OnMapTapped(double latitude, double longitude) =>
        OnMapClicked.HasDelegate ? OnMapClicked.InvokeAsync(new BenMapPoint(latitude, longitude)) : Task.CompletedTask;

    /// <summary>Re-measures the map after its container changes size.</summary>
    [JSInvokable]
    public Task OnContainerResized()
    {
        _telerikMap?.Refresh();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _containerId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* the circuit is gone; nothing to tidy on the other side */ }
        }
        _self?.Dispose();
    }

    // ── The Telerik path, kept until the last page crosses ───────────────────

    private TelerikMap? _telerikMap;
    private bool _telerikReady;
    private double[] _telerikCenter = [39.8283, -98.5795];
    private double _telerikZoom = 4;
    private List<TelerikMarker> _telerikMarkers = [];
    private object? _telerikCircle;

    private void BuildTelerikCircle() =>
        _telerikCircle = Circle is { } c
            ? Manage.Maps.MapGeoJsonHelper.ComputeCircleGeoJson(c.Latitude, c.Longitude, c.RadiusMeters / 1609.344)
            : null;

    private Task OnTelerikClick(MapClickEventArgs a) =>
        OnMapClicked.HasDelegate
            ? OnMapClicked.InvokeAsync(new BenMapPoint(a.Location.Latitude, a.Location.Longitude))
            : Task.CompletedTask;

    private void BuildTelerikMarkers()
    {
        _telerikMarkers = Pins.Select((p, i) => new TelerikMarker
        {
            LatLng = [p.Latitude, p.Longitude],
            Title = p.Title, Glyph = p.Glyph, Color = p.Color, Dimmed = p.Dimmed, IconSvgPath = p.IconSvgPath,
            Index = i, ContainerId = _containerId,
        }).ToList();

        if (_telerikMarkers.Count == 0 || !FitToPins)
        {
            _telerikCenter = [CenterLatitude, CenterLongitude];
            _telerikZoom = Zoom;
            return;
        }
        _telerikCenter = [Pins.Average(p => p.Latitude), Pins.Average(p => p.Longitude)];
        _telerikZoom = Pins.Count == 1 ? 12 : 6;   // coarse, as the old map was; Apple fits exactly
    }

    private Task OnTelerikPanEnd(MapPanEndEventArgs a)  => RaiseTelerikViewport(a.Extent, _telerikZoom);
    private Task OnTelerikZoomEnd(MapZoomEndEventArgs a) { _telerikZoom = a.Zoom; return RaiseTelerikViewport(a.Extent, a.Zoom); }

    private Task RaiseTelerikViewport(double[]? extent, double zoom) =>
        OnViewportChanged.HasDelegate && extent is { Length: 4 }
            ? OnViewportChanged.InvokeAsync(new BenMapViewport(extent[0], extent[2], extent[3], extent[1], zoom))
            : Task.CompletedTask;

    private sealed class TelerikMarker
    {
        public double[]? LatLng { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? Glyph { get; set; }
        public string? Color { get; set; }
        public bool Dimmed { get; set; }
        public string? IconSvgPath { get; set; }
        public int Index { get; set; }
        public string ContainerId { get; set; } = string.Empty;
    }
}
