@namespace Ben.Web.Website.Library.Kit.Blocks
@using Ben.Data.Common.Blocks

@*
    A link, as its card. The card's words and picture are a copy kept in the block from when it was made, so a reader's
    page never waits on — or tells — the other site; "Refresh card" asks for it again.
*@

<div class="ben-link-block" data-testid="link-block">
    @if (!string.IsNullOrWhiteSpace(Block.Url))
    {
        <BenLinkPreview Url="@Block.Url" Title="@Block.PreviewTitle" Description="@Block.PreviewDescription"
                        ImageUrl="@Block.PreviewImageUrl" SiteName="@Block.PreviewSiteName" Domain="@Block.PreviewDomain" />
    }
    @if (!ReadOnly && Active && RefreshAsync is not null)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2 small">
            <span class="text-secondary text-truncate" style="max-width:100%;">@Block.Url</span>
            <button type="button" class="btn btn-link btn-sm p-0" disabled="@_refreshing" @onclick="RefreshCardAsync"
                    data-testid="link-block-refresh">
                <BenIcon Name="refresh-cw" Class="me-1" />@(_refreshing ? "Refreshing…" : "Refresh card")
            </button>
            @if (_refusal is not null) { <span class="text-danger">@_refusal</span> }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Block Block { get; set; } = null!;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Asks the host for the card again.</summary>
    [Parameter] public Func<string, bool, Task<BlockLinkResult>>? RefreshAsync { get; set; }

    private bool _refreshing;
    private string? _refusal;

    private async Task RefreshCardAsync()
    {
        if (RefreshAsync is null || string.IsNullOrWhiteSpace(Block.Url)) return;
        _refreshing = true;
        _refusal = null;
        try
        {
            var card = await RefreshAsync(Block.Url, true);
            if (card.Refusal is not null) { _refusal = card.Refusal; return; }
            Block.PreviewTitle = card.Title;
            Block.PreviewDescription = card.Description;
            Block.PreviewImageUrl = card.ImageUrl;
            Block.PreviewSiteName = card.SiteName;
            Block.PreviewDomain = card.Domain;
            Block.PreviewFetchedUtc = DateTime.UtcNow;
            await Changed.InvokeAsync();
        }
        finally { _refreshing = false; }
    }
}
