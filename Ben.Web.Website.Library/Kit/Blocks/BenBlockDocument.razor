@namespace Ben.Web.Website.Library.Kit.Blocks
@using Ben.Data.Common.Blocks
@using Ben.Data.Common.Text
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A page made of blocks, being edited: words, pictures, files, link cards and maps, in an order the author sets by
    dragging (or Move up and Move down, or Alt+arrow keys), with a side rail the host fills — a research page puts its
    files and links there (Ben, 2026-09-14).

    Paste works anywhere on the page, the way it does in OneNote: a picture or file becomes its own block, a web address
    becomes a link card, and text becomes a text block — or, inside a text block, goes where the cursor is. Dropping files
    on the page does the same.

    Knows nothing about cases or research. What an upload is stored as, what a stored file's address is, how a link gets
    its card and how a place is found all come from the host (BlockHostContracts), so another page can use it as it is.

    Responsive: one column on a phone with the rail folded above the page behind a button; the rail beside the page from
    992px. Handles and menu items are at least 44px square.
*@

<div class="row g-3 ben-blocks">
    <div class="col-12 col-lg-8 order-2 order-lg-1">
        <div class="ben-blocks__page" @ref="_root" tabindex="0" data-testid="block-page"
             aria-label="The page. Paste a picture, a file, a web address or text anywhere here.">

            @if (_notice is not null)
            {
                <div class="alert alert-warning py-2 small d-flex align-items-start gap-2" role="alert" data-testid="block-notice">
                    <span class="flex-grow-1">@_notice</span>
                    <button type="button" class="btn-close btn-sm" aria-label="Dismiss" @onclick="@(() => _notice = null)"></button>
                </div>
            }

            @if (Document.Blocks.Count == 0)
            {
                <div class="ben-blocks__empty text-secondary" data-testid="block-page-empty">
                    <BenIcon Name="clipboard" Class="me-2" />Start with a block below, or paste a picture, a file or a web address.
                </div>
            }

            @foreach (var block in Document.Blocks)
            {
                var b = block;
                var kind = BlockKindRegistry.Of(b.Kind);
                var active = b.Id == _activeId;
                <section @key="b.Id" class="ben-block @(active ? "is-active" : "")" data-block-id="@b.Id" data-kind="@b.Kind"
                         aria-label="@($"{kind.Label} block")">
                    @* One handle: drag it to move the block, click or tap it for the block's options (UI test pass, 2026-09-14).
                       It used to sit above a separate options button, which kept every block at least two 44px targets
                       tall — a one-line paragraph took a hundred pixels. The script tells a click from a drag. *@
                    <div class="ben-block__gutter">
                        <button type="button" class="ben-block__handle" data-block-handle data-testid="block-menu-toggle"
                                title="Drag to move · click for options" aria-haspopup="menu"
                                aria-expanded="@(_menuFor == b.Id ? "true" : "false")"
                                aria-label="@($"Options for this {kind.Label.ToLowerInvariant()} block. Drag to move it; Alt and the arrow keys move it up and down.")"
                                @onclick="@(() => _menuFor = _menuFor == b.Id ? null : b.Id)"
                                @onkeydown="@(e => OnHandleKeyAsync(e, b))">
                            <BenIcon Name="more-vertical" />
                        </button>
                    </div>

                    <div class="ben-block__body" @onclick="@(() => ActivateAsync(b.Id))" @onfocusin="@(() => ActivateAsync(b.Id))">
                        @switch (b.Kind)
                        {
                            case BlockKinds.Text:
                                @* The reference is held for the block being edited only: it is the one whose editor is open. *@
                                @if (active)
                                {
                                    <BenTextBlock @ref="_textRef" Block="@b" Active="true" Changed="@NotifyChangedAsync" />
                                }
                                else
                                {
                                    <BenTextBlock Block="@b" Changed="@NotifyChangedAsync" />
                                }
                                break;
                            case BlockKinds.Image:
                                <BenImageBlock Block="@b" Active="@active" FileUrl="@FileUrl" Changed="@NotifyChangedAsync" />
                                break;
                            case BlockKinds.File:
                                <BenFileBlock Block="@b" Active="@active" FileUrl="@FileUrl" Changed="@NotifyChangedAsync" />
                                break;
                            case BlockKinds.Link:
                                <BenLinkBlock Block="@b" Active="@active" RefreshAsync="@LinkAsync" Changed="@NotifyChangedAsync" />
                                break;
                            case BlockKinds.Map:
                                <BenMapBlock Block="@b" Active="@active" MapHost="@MapHost" Changed="@NotifyChangedAsync" />
                                break;
                        }
                    </div>

                    @if (_menuFor == b.Id)
                    {
                        <div class="ben-block__menu" role="menu" data-testid="block-menu">
                            <button type="button" role="menuitem" disabled="@(Index(b) == 0)" @onclick="@(() => MoveByAsync(b, -1))"><BenIcon Name="arrow-up" Class="me-2" />Move up</button>
                            <button type="button" role="menuitem" disabled="@(Index(b) == Document.Blocks.Count - 1)" @onclick="@(() => MoveByAsync(b, 1))"><BenIcon Name="arrow-down" Class="me-2" />Move down</button>
                            <button type="button" role="menuitem" @onclick="@(() => AddAfterAsync(b, NewBlock.Text()))"><BenIcon Name="type" Class="me-2" />Add text below</button>
                            <button type="button" role="menuitem" class="text-danger" @onclick="@(() => RemoveAsync(b))"><BenIcon Name="trash-2" Class="me-2" />Delete block</button>
                        </div>
                    }
                </section>
            }

            <div class="ben-blocks__add" data-testid="block-add-bar">
                <span class="ben-blocks__add-label">Add</span>
                @foreach (var kind in OfferedKinds)
                {
                    var k = kind;
                    @switch (k.Kind)
                    {
                        case BlockKinds.Image:
                            <label class="btn btn-sm btn-outline-secondary ben-touch mb-0" title="@k.Help" for="@($"{_id}-add-picture")">
                                <BenIcon Name="@k.Icon" Class="me-1" />@k.Label
                            </label>
                            <InputFile id="@($"{_id}-add-picture")" class="visually-hidden" accept="image/*" multiple OnChange="OnFilesChosenAsync" />
                            break;
                        case BlockKinds.File:
                            <label class="btn btn-sm btn-outline-secondary ben-touch mb-0" title="@k.Help" for="@($"{_id}-add-file")">
                                <BenIcon Name="@k.Icon" Class="me-1" />@k.Label
                            </label>
                            <InputFile id="@($"{_id}-add-file")" class="visually-hidden" multiple OnChange="OnFilesChosenAsync" />
                            break;
                        default:
                            <button type="button" class="btn btn-sm btn-outline-secondary ben-touch" title="@k.Help"
                                    data-testid="@($"block-add-{k.Kind}")" @onclick="@(() => AddKindAsync(k.Kind))">
                                <BenIcon Name="@k.Icon" Class="me-1" />@k.Label
                            </button>
                            break;
                    }
                }
            </div>

            @if (_linkOpen)
            {
                <div class="ben-blocks__link-entry d-flex flex-wrap gap-2 align-items-end mt-2">
                    <div class="flex-grow-1" style="min-width:14rem;">
                        <label class="form-label small mb-1" for="@($"{_id}-link-url")">Web address</label>
                        <input id="@($"{_id}-link-url")" class="form-control form-control-sm" type="url" placeholder="https://…"
                               @bind="_linkUrl" @bind:event="oninput" @onkeydown="OnLinkKeyAsync" />
                    </div>
                    <button type="button" class="btn btn-sm btn-primary ben-touch" disabled="@(_busy || string.IsNullOrWhiteSpace(_linkUrl))" @onclick="AddTypedLinkAsync">
                        @(_busy ? "Adding…" : "Add link")
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ben-touch" @onclick="@(() => { _linkOpen = false; _linkUrl = ""; })">Cancel</button>
                </div>
            }
            @if (_busy) { <div class="small text-secondary mt-2"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>@_busyText</div> }
        </div>
    </div>

    @if (SideRail is not null)
    {
        <aside class="col-12 col-lg-4 order-1 order-lg-2">
            <button type="button" class="btn btn-outline-secondary w-100 d-lg-none ben-touch" aria-expanded="@(_railOpen ? "true" : "false")"
                    @onclick="@(() => _railOpen = !_railOpen)" data-testid="rail-toggle">
                <BenIcon Name="@(_railOpen ? "chevron-up" : "paperclip")" Class="me-1" />@SideRailTitle (@SideRailCount)
            </button>
            <div class="ben-blocks__rail @(_railOpen ? "is-open" : "")" data-testid="block-rail">
                @SideRail
            </div>
        </aside>
    }
</div>

@code {
    /// <summary>The page being edited. Changed in place; <see cref="DocumentChanged"/> says when.</summary>
    [Parameter, EditorRequired] public BlockDocument Document { get; set; } = null!;

    [Parameter] public EventCallback DocumentChanged { get; set; }

    /// <summary>Stores a pasted, dropped or chosen file.</summary>
    [Parameter, EditorRequired] public Func<BlockUploadRequest, Task<BlockUploadResult>> UploadAsync { get; set; } = null!;

    /// <summary>The card for a link: (address, refresh) → card.</summary>
    [Parameter, EditorRequired] public Func<string, bool, Task<BlockLinkResult>> LinkAsync { get; set; } = null!;

    /// <summary>The address of a stored file, for this reader.</summary>
    [Parameter, EditorRequired] public Func<Guid, BlockFileUrlKind, string> FileUrl { get; set; } = null!;

    /// <summary>Finding places for map blocks. Without it the Map block is not offered.</summary>
    [Parameter] public BlockMapHost? MapHost { get; set; }

    [Parameter] public RenderFragment? SideRail { get; set; }
    [Parameter] public string SideRailTitle { get; set; } = "Attachments";
    [Parameter] public int SideRailCount { get; set; }

    /// <summary>The largest file the page accepts by paste, drop or choice.</summary>
    [Parameter] public long MaxFileBytes { get; set; } = 50L * 1024 * 1024;

    private readonly string _id = $"blocks-{Guid.NewGuid():N}";
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<BenBlockDocument>? _self;
    private string? _activeId;
    private string? _menuFor;
    private BenTextBlock? _textRef;
    private string? _notice;
    private bool _railOpen;
    private bool _linkOpen;
    private string _linkUrl = "";
    private bool _busy;
    private string _busyText = "";
    private string? _focusAfterRender;
    private (string Html, string Text)? _pasteAfterRender;

    /// <summary>The block being worked on, if any.</summary>
    public string? ActiveBlockId => _activeId;

    private IEnumerable<BlockKindDescriptor> OfferedKinds =>
        BlockKindRegistry.All.Where(k => k.Kind != BlockKinds.Map || MapHost is not null);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Ben.Web.Website.Library/Kit/Blocks/BenBlockDocument.razor.js");
            await _module.InvokeVoidAsync("attach", _root, _self, MaxFileBytes);
        }

        if (_focusAfterRender is { } id && _module is not null)
        {
            _focusAfterRender = null;
            if (_pasteAfterRender is { } paste)
            {
                _pasteAfterRender = null;
                await _module.InvokeVoidAsync("focusBlock", id, paste.Html, paste.Text);
                return;
            }
            await _module.InvokeVoidAsync("focusBlock", id);
        }
    }

    // ── What the host can ask ─────────────────────────────────────────────────────────────────────────────

    /// <summary>Reads the text block being edited into the page. Call before saving.</summary>
    public async Task CommitAsync()
    {
        if (_textRef is not null) await _textRef.CommitAsync();
    }

    /// <summary>Adds a block below the one being worked on, or at the end.</summary>
    public async Task InsertAsync(Block block)
    {
        var at = _activeId is { } active ? Document.Blocks.FindIndex(b => b.Id == active) + 1 : Document.Blocks.Count;
        Document.Blocks.Insert(Math.Clamp(at, 0, Document.Blocks.Count), block);
        await ActivateAsync(block.Id);
        _focusAfterRender = block.Id;
        await NotifyChangedAsync();
    }

    /// <summary>Puts HTML at the cursor of the text block being edited. False when none is.</summary>
    public async Task<bool> InsertIntoActiveTextAsync(string html)
    {
        if (_textRef is null || _activeId is null || Document.Blocks.FirstOrDefault(b => b.Id == _activeId)?.Kind != BlockKinds.Text) return false;
        return await _textRef.InsertAtCursorAsync(html);
    }

    // ── From the browser ──────────────────────────────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task ReceiveFileAsync(string name, string contentType, long size, IJSStreamReference stream)
    {
        await InvokeAsync(async () =>
        {
            _busy = true;
            _busyText = $"Adding {name}…";
            StateHasChanged();
            try
            {
                await using var content = await stream.OpenReadStreamAsync(MaxFileBytes);
                await AddUploadAsync(new BlockUploadRequest(name, contentType, size, content));
            }
            finally
            {
                _busy = false;
                StateHasChanged();
            }
        });
    }

    [JSInvokable]
    public Task FileTooLargeAsync(string name, long size) => InvokeAsync(() =>
    {
        _notice = $"\"{name}\" is {size / (1024.0 * 1024):0.#} MB. Files added to a page can be up to {MaxFileBytes / (1024 * 1024)} MB.";
        StateHasChanged();
    });

    [JSInvokable]
    public Task PastedLinkAsync(string url) => InvokeAsync(() => AddLinkAsync(url));

    [JSInvokable]
    public Task PastedTextAsync(string html, string text) => InvokeAsync(async () =>
    {
        // Formatted text becomes a new text block and is pasted into its editor, exactly as a paste inside a text block
        // would be — the editor's schema keeps structure and drops anything else, and nothing is ever drawn raw. Plain text
        // becomes paragraphs.
        //
        // UI test pass, 2026-09-14: the formatted words were handed to the new editor's "insert at the cursor" in the
        // render that created it, before the editor existed, and the block came out empty. The paste now waits for the
        // editor (focusBlock) and is given to it as the browser's own paste.
        var block = NewBlock.Text();
        if (string.IsNullOrWhiteSpace(html)) block.Html = PlainTextHtml.FromPlainText(text);
        else _pasteAfterRender = (html, text);
        await InsertAsync(block);
        StateHasChanged();
    });

    [JSInvokable]
    public Task MovedAsync(string id, string? beforeId) => InvokeAsync(async () =>
    {
        var moving = Document.Blocks.FirstOrDefault(b => b.Id == id);
        if (moving is null || id == beforeId) return;
        Document.Blocks.Remove(moving);
        var at = beforeId is null ? Document.Blocks.Count : Document.Blocks.FindIndex(b => b.Id == beforeId);
        Document.Blocks.Insert(at < 0 ? Document.Blocks.Count : at, moving);
        await NotifyChangedAsync();
        StateHasChanged();
    });

    // ── Adding, moving, removing ──────────────────────────────────────────────────────────────────────────

    private async Task AddKindAsync(string kind)
    {
        switch (kind)
        {
            case BlockKinds.Text: await InsertAsync(NewBlock.Text()); break;
            case BlockKinds.Map: await InsertAsync(NewBlock.Map()); break;
            case BlockKinds.Link: _linkOpen = true; break;
        }
    }

    private async Task AddAfterAsync(Block after, Block block)
    {
        _menuFor = null;
        _activeId = after.Id;
        await InsertAsync(block);
    }

    private async Task OnFilesChosenAsync(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(20))
        {
            if (file.Size > MaxFileBytes)
            {
                _notice = $"\"{file.Name}\" is {file.Size / (1024.0 * 1024):0.#} MB. Files added to a page can be up to {MaxFileBytes / (1024 * 1024)} MB.";
                continue;
            }
            _busy = true;
            _busyText = $"Adding {file.Name}…";
            StateHasChanged();
            try
            {
                await using var content = file.OpenReadStream(MaxFileBytes);
                await AddUploadAsync(new BlockUploadRequest(file.Name, file.ContentType, file.Size, content));
            }
            finally { _busy = false; }
        }
    }

    private async Task AddUploadAsync(BlockUploadRequest request)
    {
        var result = await UploadAsync(request);
        if (result.Refusal is not null || result.UploadFileId is null)
        {
            _notice = result.Refusal ?? $"\"{request.FileName}\" could not be added.";
            return;
        }
        await InsertAsync(NewBlock.FromUpload(result));
    }

    private async Task OnLinkKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTypedLinkAsync();
    }

    private async Task AddTypedLinkAsync()
    {
        var url = _linkUrl.Trim();
        await AddLinkAsync(url);
        if (_notice is null) { _linkOpen = false; _linkUrl = ""; }
    }

    private async Task AddLinkAsync(string url)
    {
        _busy = true;
        _busyText = "Making the link's card…";
        StateHasChanged();
        try
        {
            var card = await LinkAsync(url, false);
            if (card.Refusal is not null) { _notice = card.Refusal; return; }
            await InsertAsync(NewBlock.Link(card));
        }
        finally { _busy = false; }
    }

    private int Index(Block block) => Document.Blocks.IndexOf(block);

    private async Task MoveByAsync(Block block, int by)
    {
        _menuFor = null;
        var from = Index(block);
        var to = from + by;
        if (from < 0 || to < 0 || to >= Document.Blocks.Count) return;
        Document.Blocks.RemoveAt(from);
        Document.Blocks.Insert(to, block);
        _focusAfterRender = block.Id;
        await NotifyChangedAsync();
    }

    private async Task OnHandleKeyAsync(KeyboardEventArgs e, Block block)
    {
        if (!e.AltKey) return;
        if (e.Key == "ArrowUp") await MoveByAsync(block, -1);
        else if (e.Key == "ArrowDown") await MoveByAsync(block, 1);
    }

    private async Task RemoveAsync(Block block)
    {
        _menuFor = null;
        if (block.Id == _activeId) { _activeId = null; _textRef = null; }
        Document.Blocks.Remove(block);
        await NotifyChangedAsync();
    }

    private async Task ActivateAsync(string id)
    {
        if (_activeId == id) return;
        // What was being typed in the block being left goes into the page first: its editor is about to close.
        if (_textRef is not null) await _textRef.CommitAsync();
        _textRef = null;
        _activeId = id;
        _menuFor = null;
        // A text block becomes an editor: focus it, at the point clicked (see focusBlock), so typing goes somewhere.
        if (Document.Blocks.FirstOrDefault(b => b.Id == id)?.Kind == BlockKinds.Text) _focusAfterRender = id;
    }

    private Task NotifyChangedAsync() => DocumentChanged.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach", _root);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
