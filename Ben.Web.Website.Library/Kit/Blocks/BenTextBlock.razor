@namespace Ben.Web.Website.Library.Kit.Blocks
@using Ben.Data.Common.Blocks
@using Ben.Data.Common.Text

@*
    A block of words. Drawn as its HTML until it is the block being worked on; then it is an editor. One editor at a time
    on a page of many blocks keeps a long page quick, and reads like a page rather than a stack of boxes.
*@

@if (Active && !ReadOnly)
{
    <div class="ben-text-block ben-text-block--editing" data-testid="text-block-editor">
        <BenEditor @ref="_editor" Value="@Block.Html" ValueChanged="@OnValueChanged" Height="auto"
                   Tools="@BlockTextTools.Default" CleanPaste="true" />
    </div>
}
else if (PlainTextHtml.HasText(Block.Html))
{
    <div class="ben-text-block" data-testid="text-block">@((MarkupString)Block.Html!)</div>
}
else if (!ReadOnly)
{
    <div class="ben-text-block ben-text-block--empty text-secondary" data-testid="text-block">Write something…</div>
}

@code {
    [Parameter, EditorRequired] public Block Block { get; set; } = null!;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private BenEditor? _editor;

    private async Task OnValueChanged(string html)
    {
        if (Block.Html == html) return;
        Block.Html = html;
        await Changed.InvokeAsync();
    }

    /// <summary>Reads what the editor holds right now into the block. Before saving, and before another block becomes active.</summary>
    public async Task CommitAsync()
    {
        if (_editor is null || !Active) return;
        var html = await _editor.GetCurrentHtmlAsync();
        if (html is not null && html != Block.Html)
        {
            Block.Html = html;
            await Changed.InvokeAsync();
        }
    }

    /// <summary>Puts HTML at the cursor. False when this block is not being edited.</summary>
    public async Task<bool> InsertAtCursorAsync(string html)
    {
        if (_editor is null || !Active) return false;
        await _editor.InsertHtmlAsync(html, inline: true);
        return true;
    }
}
