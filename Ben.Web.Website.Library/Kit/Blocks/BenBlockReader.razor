@namespace Ben.Web.Website.Library.Kit.Blocks
@using Ben.Data.Common.Blocks

@*
    A page of blocks, to read — the same blocks the editor draws, with nothing to change. For everyone who is not editing:
    the rest of a group reading a published research page, or a page anywhere else that shows a block document.
*@

<div class="ben-blocks__page ben-blocks__page--reading" data-testid="block-reader">
    @if (Document.Blocks.Count == 0)
    {
        <p class="text-secondary mb-0">@EmptyText</p>
    }
    @foreach (var block in Document.Blocks)
    {
        var b = block;
        <section @key="b.Id" class="ben-block ben-block--reading" data-kind="@b.Kind">
            @switch (b.Kind)
            {
                case BlockKinds.Text:
                    <BenTextBlock Block="@b" ReadOnly="true" />
                    break;
                case BlockKinds.Image:
                    <BenImageBlock Block="@b" FileUrl="@FileUrl" ReadOnly="true" />
                    break;
                case BlockKinds.File:
                    <BenFileBlock Block="@b" FileUrl="@FileUrl" ReadOnly="true" />
                    break;
                case BlockKinds.Link:
                    <BenLinkBlock Block="@b" ReadOnly="true" />
                    break;
                case BlockKinds.Map:
                    <BenMapBlock Block="@b" ReadOnly="true" MapHost="@MapHost" />
                    break;
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public BlockDocument Document { get; set; } = null!;
    [Parameter, EditorRequired] public Func<Guid, BlockFileUrlKind, string> FileUrl { get; set; } = null!;
    [Parameter] public BlockMapHost? MapHost { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Nothing here yet.";
}
