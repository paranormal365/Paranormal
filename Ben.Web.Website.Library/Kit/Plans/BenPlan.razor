@namespace Ben.Web.Website.Library.Kit.Plans
@using Ben.Data.Common.Enums
@using Ben.Web.Website.Library.Kit
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    One plan, drawn three ways (item 235 phase 2).

    The venue arranges its rooms or seats on it, the booking board reads it with a night's
    occupancy laid over, and a guest picks on it. One component rather than three, because three
    would eventually disagree about which square is which — and the one that got it wrong would be
    the one somebody was standing in front of at a door.

    A GRID, NOT A CANVAS. A hotel floor is a corridor with rooms either side and a theatre is rows
    of seats; a row and a column say both in two integers. A freeform canvas would ask a venue to
    be an architect and would still not tell anybody anything a tidy grid does not.

    NO PER-SQUARE EVENT HANDLERS. Four hundred seats across three nights is twelve hundred
    callbacks for Blazor Server to register and diff. Instead one delegated pointer listener in the
    collocated module reports a whole gesture once, and one keydown handler on the grid serves the
    keyboard. The module only ever reads the DOM and toggles a class of its own while a drag is in
    flight; it never creates, moves or removes a node, which is the rule that keeps Blazor's diffing
    honest.
*@

<div class="plan @(Compact ? "plan--compact" : null) @Class"
     id="@_containerId"
     style="--plan-columns:@(Columns);--plan-rows:@(Rows)">

    @if (Rows == 0)
    {
        <p class="text-secondary small mb-0" data-testid="plan-empty">@EmptyText</p>
    }
    else
    {
        <div class="plan__scroll">
            <div class="plan__grid" role="grid"
                 aria-label="@AriaLabel"
                 aria-rowcount="@Rows" aria-colcount="@Columns"
                 tabindex="-1"
                 @onkeydown="OnKeyDownAsync" @onkeydown:preventDefault="_swallowKey">

                @* Column numbers along the top, so a person can say "seat 12" and find it. *@
                <div class="plan__corner" style="grid-row:1;grid-column:1" aria-hidden="true"></div>
                @for (var c = 0; c < Columns; c++)
                {
                    var column = c;
                    <div class="plan__heading plan__heading--column"
                         style="grid-row:1;grid-column:@(column + 2)" aria-hidden="true">@(column + 1)</div>
                }

                @for (var r = 0; r < Rows; r++)
                {
                    var row = r;

                    @* The row's letter, and its section when every unit in it shares one — which
                       gives a hotel its floor captions without a column of its own. *@
                    <div class="plan__heading plan__heading--row"
                         style="grid-row:@(row + 2);grid-column:1" aria-hidden="true">
                        <span class="plan__row-letter">@PlanLabels.RowName(row)</span>
                        @if (SectionOfRow(row) is { } caption)
                        {
                            <span class="plan__row-section">@caption</span>
                        }
                    </div>

                    @for (var c = 0; c < Columns; c++)
                    {
                        var column = c;
                        var unit = Model.At(row, column);

                        if (unit is null)
                        {
                            @* An empty square is a drop target while arranging and nothing at all
                               otherwise — an aisle should read as an aisle, not as a missing seat. *@
                            if (Mode == PlanMode.Edit)
                            {
                                <button type="button" class="plan__empty"
                                        style="grid-row:@(row + 2);grid-column:@(column + 2)"
                                        data-empty="@row,@column"
                                        tabindex="-1"
                                        aria-label="Empty square, row @PlanLabels.RowName(row), @(column + 1)"></button>
                            }
                            continue;
                        }

                        var state = StateOf(unit);
                        var selected = Selection.Contains(unit.Key);
                        var focused = row == _focusRow && column == _focusColumn;

                        <button type="button"
                                class="plan__unit"
                                style="grid-row:@(row + 2);grid-column:@(column + 2);@HueOf(unit)"
                                data-key="@unit.Key"
                                data-state="@state.ToString().ToLowerInvariant()"
                                data-selected="@(selected ? "true" : "false")"
                                disabled="@(!Answers(state))"
                                tabindex="@(focused ? 0 : -1)"
                                role="@(Mode == PlanMode.Read ? "gridcell" : "checkbox")"
                                aria-checked="@(Mode == PlanMode.Read ? null : selected.ToString().ToLowerInvariant())"
                                aria-label="@LabelOf(unit, state)">
                            <span class="plan__unit-name">@unit.Name</span>
                            @if (PlanCellStates.Glyph(state) is { Length: > 0 } glyph)
                            {
                                <BenIcon Name="@glyph" Class="plan__unit-glyph" />
                            }
                            @if (unit.Capacity is > 1)
                            {
                                <span class="plan__unit-holds">@unit.Capacity</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>

        @if (ShowLegend && Legend.Count > 0)
        {
            <ul class="plan__legend" data-testid="plan-legend">
                @foreach (var entry in Legend)
                {
                    <li class="plan__legend-item" style="@entry.Hue">
                        <span class="plan__legend-swatch" aria-hidden="true"></span>
                        <span>@entry.Text</span>
                    </li>
                }
            </ul>
        }
    }

    @* What the keyboard just did, for anybody who cannot see the squares change. *@
    <p class="visually-hidden" aria-live="polite" data-testid="plan-announcement">@_announcement</p>
</div>

@code {
    /// <summary>The plan being drawn. Owned by the caller, so an edit here is an edit there.</summary>
    [Parameter, EditorRequired] public PlanModel Model { get; set; } = new(HostedEventLayoutKind.Rooms);

    [Parameter] public PlanMode Mode { get; set; } = PlanMode.Read;

    /// <summary>What is chosen. Two-way bindable.</summary>
    [Parameter] public IReadOnlySet<Guid> Selection { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback<IReadOnlySet<Guid>> SelectionChanged { get; set; }

    /// <summary>
    /// What each unit is on the night being shown, when anything knows.
    /// </summary>
    /// <remarks>
    /// Null while arranging, where occupancy is not the question. A unit missing from the map
    /// reads as free, so a caller that only knows about the taken ones need only send those.
    /// </remarks>
    [Parameter] public IReadOnlyDictionary<Guid, PlanCellState>? Occupancy { get; set; }

    /// <summary>The most a guest may choose, so a party of three cannot hold four seats.</summary>
    [Parameter] public int? MaxSelectable { get; set; }

    /// <summary>Enter, or a second tap: the caller decides what opening a unit means.</summary>
    [Parameter] public EventCallback<Guid> OnUnitActivated { get; set; }

    /// <summary>An empty square was chosen while arranging — where a tray unit would land.</summary>
    [Parameter] public EventCallback<(int Row, int Column)> OnEmptyActivated { get; set; }

    /// <summary>Small squares, for a venue that wants the whole house on one screen.</summary>
    [Parameter] public bool Compact { get; set; }

    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? EmptyText { get; set; } = "Nothing on the plan yet.";
    [Parameter] public string? AriaLabel { get; set; } = "Seating plan";

    private readonly string _containerId = $"plan-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<BenPlan>? _self;
    private bool _disposed;

    private int _focusRow;
    private int _focusColumn;
    private bool _swallowKey;
    private string? _announcement;

    /// <summary>One spare row and column while arranging, so the plan can always grow.</summary>
    private int Rows => Model.LastRow + 1 + (Mode == PlanMode.Edit ? 1 : 0);
    private int Columns => Math.Max(Model.LastColumn + 1 + (Mode == PlanMode.Edit ? 1 : 0), 0);

    private sealed record LegendEntry(string Text, string Hue);

    /// <summary>
    /// One line per section: how many, and what it costs.
    /// </summary>
    /// <remarks>
    /// The price belongs here rather than in every square. Four hundred squares each printing
    /// "$18" is four hundred things to read; one line saying "Balcony · 120 seats · $18" is the
    /// same fact once, and it is where a venue checks it.
    /// </remarks>
    private IReadOnlyList<LegendEntry> Legend =>
        [.. Model.Units
            .Where(u => u.IsPlaced)
            .GroupBy(u => u.Section?.Trim() ?? "")
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                var name = g.Key.Length > 0 ? g.Key : "Unnamed";
                var prices = g.Select(u => u.Price).Distinct().ToList();
                var price = prices.Count == 1 && prices[0] is { } p ? $" · {p:C}" : "";
                var noun = Model.Kind == HostedEventLayoutKind.Seats ? "seat" : "room";
                return new LegendEntry(
                    $"{name} · {g.Count()} {noun}{(g.Count() == 1 ? "" : "s")}{price}",
                    TourPlate.HueStyle(name));
            })];

    private PlanCellState StateOf(PlanUnit unit)
        => Occupancy is not null && Occupancy.TryGetValue(unit.Key, out var s) ? s : PlanCellState.Free;

    /// <summary>Whether a square does anything when it is pressed, in this mode.</summary>
    private bool Answers(PlanCellState state) => Mode switch
    {
        PlanMode.Edit => true,
        PlanMode.Pick => PlanCellStates.IsPickable(state),
        _             => false,
    };

    private static string HueOf(PlanUnit unit)
        => unit.Section is { Length: > 0 } s ? TourPlate.HueStyle(s) : "";

    /// <summary>The section shared by every unit in a row, or null when they differ.</summary>
    private string? SectionOfRow(int row)
    {
        var sections = Model.Units
            .Where(u => u.Row == row && !string.IsNullOrWhiteSpace(u.Section))
            .Select(u => u.Section!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(2)
            .ToList();
        return sections.Count == 1 && Model.Units.Count(u => u.Row == row) > 0 ? sections[0] : null;
    }

    /// <summary>
    /// Everything a screen reader needs in one string, because a square is a square to it.
    /// </summary>
    private string LabelOf(PlanUnit unit, PlanCellState state)
    {
        var where = $"row {PlanLabels.RowName(unit.Row ?? 0)}, {(unit.Column ?? 0) + 1}";
        var section = unit.Section is { Length: > 0 } s ? $", {s}" : "";
        var price = unit.Price is { } p ? $", {p:C}" : "";
        var holds = unit.Capacity is > 1 ? $", holds {unit.Capacity}" : "";
        return $"{unit.Name}, {where}{section}{price}{holds}, {PlanCellStates.Word(state)}";
    }

    // ── the pointer, through the module ──────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Mode == PlanMode.Read) return;

        try
        {
            _self ??= DotNetObjectReference.Create(this);
            var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/_content/Ben.Web.Website.Library/Kit/Plans/BenPlan.razor.js");

            // Checked after every await: a component disposed mid-import would otherwise leave a
            // listener attached to a container that is on its way out.
            if (_disposed) { await module.DisposeAsync(); return; }

            _module = module;
            await _module.InvokeVoidAsync("attach", _containerId, _self);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* prerender: no interop yet */ }
    }

    /// <summary>
    /// One gesture, reported once when the pointer comes up.
    /// </summary>
    /// <param name="keys">Every unit the gesture crossed, in the order it crossed them.</param>
    /// <param name="deselect">
    /// True when the gesture began on something already chosen, which makes the whole sweep a
    /// deselection — the behaviour anybody who has used a spreadsheet expects.
    /// </param>
    [JSInvokable]
    public async Task GestureAsync(string[] keys, bool deselect)
    {
        var touched = keys.Select(Guid.Parse).Where(k => Model.ByKey(k) is not null).ToList();
        if (touched.Count == 0) return;

        var next = new HashSet<Guid>(Selection);
        foreach (var key in touched)
        {
            if (deselect) next.Remove(key);
            else if (CanAdd(next, key)) next.Add(key);
        }

        // Focus follows the gesture, so the keyboard carries on from where the mouse left off.
        if (Model.ByKey(touched[^1]) is { IsPlaced: true } last)
        {
            _focusRow = last.Row!.Value;
            _focusColumn = last.Column!.Value;
        }

        Announce(next);
        await SelectionChanged.InvokeAsync(next);
    }

    /// <summary>An empty square was pressed while arranging.</summary>
    [JSInvokable]
    public Task EmptyAsync(int row, int column)
    {
        _focusRow = row;
        _focusColumn = column;
        return OnEmptyActivated.InvokeAsync((row, column));
    }

    /// <summary>Whether one more may be chosen, given what a guest is allowed to hold.</summary>
    private bool CanAdd(HashSet<Guid> chosen, Guid key)
        => chosen.Contains(key)
        || MaxSelectable is not { } max
        || chosen.Count < max;

    // ── the keyboard, which never needs the module ───────────────────────────

    /// <summary>
    /// Arrows move, Space chooses, Shift and an arrow extends, Enter opens.
    /// </summary>
    /// <remarks>
    /// <para>Shift with an arrow IS the keyboard's drag, and without it a plan is a mouse-only
    /// feature — which a public booking page cannot be.</para>
    ///
    /// <para>One handler on the grid rather than one per square: four hundred key handlers is four
    /// hundred callbacks for Blazor Server to hold, and the focused square is state this component
    /// already keeps.</para>
    /// </remarks>
    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        _swallowKey = e.Key is "ArrowUp" or "ArrowDown" or "ArrowLeft" or "ArrowRight"
                            or "Home" or "End" or " " or "Enter";
        if (!_swallowKey) return;

        var (dr, dc) = e.Key switch
        {
            "ArrowUp"    => (-1, 0),
            "ArrowDown"  => (1, 0),
            "ArrowLeft"  => (0, -1),
            "ArrowRight" => (0, 1),
            _            => (0, 0),
        };

        if (dr != 0 || dc != 0)
        {
            var wasOn = Model.At(_focusRow, _focusColumn);
            _focusRow = Math.Clamp(_focusRow + dr, 0, Math.Max(Rows - 1, 0));
            _focusColumn = Math.Clamp(_focusColumn + dc, 0, Math.Max(Columns - 1, 0));

            // Shift extends: everything from where the extension began to here joins the choice.
            if (e.ShiftKey && Mode != PlanMode.Read && wasOn is not null)
                await ChooseAsync(Model.At(_focusRow, _focusColumn), add: true);
            else
                await FocusAsync();
            return;
        }

        if (e.Key is "Home" or "End")
        {
            _focusColumn = e.Key == "Home" ? 0 : Math.Max(Columns - 1, 0);
            await FocusAsync();
            return;
        }

        var here = Model.At(_focusRow, _focusColumn);
        if (e.Key == " ") await ChooseAsync(here, add: null);
        else if (e.Key == "Enter" && here is not null) await OnUnitActivated.InvokeAsync(here.Key);
    }

    /// <summary>Chooses, unchooses, or adds to a choice, and says what happened.</summary>
    private async Task ChooseAsync(PlanUnit? unit, bool? add)
    {
        if (unit is null || Mode == PlanMode.Read) return;
        if (!Answers(StateOf(unit))) return;

        var next = new HashSet<Guid>(Selection);
        var wanted = add ?? !next.Contains(unit.Key);

        if (wanted) { if (CanAdd(next, unit.Key)) next.Add(unit.Key); }
        else next.Remove(unit.Key);

        Announce(next);
        await SelectionChanged.InvokeAsync(next);
        await FocusAsync();
    }

    private void Announce(IReadOnlySet<Guid> chosen)
    {
        if (chosen.Count == 0) { _announcement = "Nothing chosen."; return; }

        var names = chosen.Select(k => Model.ByKey(k)?.Name).Where(n => n is not null).Take(6).ToList();
        var rest = chosen.Count - names.Count;
        _announcement = $"{chosen.Count} chosen: {string.Join(", ", names)}"
                      + (rest > 0 ? $" and {rest} more." : ".");
    }

    /// <summary>Moves the browser's own focus to the square this component thinks is focused.</summary>
    private async Task FocusAsync()
    {
        StateHasChanged();
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("focusCell", _containerId, _focusRow, _focusColumn); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach", _containerId);
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException) { }
        finally { _self?.Dispose(); }
    }
}
