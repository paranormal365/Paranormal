@namespace Ben.Web.Website.Library.Kit
@implements IAsyncDisposable
@using Telerik.Blazor.Components.Editor

@*
    The site's rich-text box. One wrapper so the font is decided once.

    W-R3 of the 2026-09-06 evaluation: what somebody typed into an investigation request came back
    in Times New Roman, on a site set in a sans-serif face, and the same happened on the case
    timeline. Nothing was misconfigured — TelerikEditor defaults to EditMode.Iframe, and an iframe
    starts from the browser's own defaults with none of the page's stylesheets. Every editor on the
    site looked like a different application from the page around it.

    EditMode.Div is Telerik's own answer: the editable region is a div in the page, so it inherits
    the page's typography the way every other input does. The trade is that page CSS now reaches
    the content — which is the point, and is also what makes the WYSIWYG claim true, since the
    published article is rendered by that same CSS.

    Parameters declared rather than splatted: TelerikEditor throws on an attribute it does
    not recognize, so this forwards exactly what call sites pass and nothing else.

    GetCurrentHtmlAsync (2026-09-14) is for forms: read it on submit, because ValueChanged arrives on
    a debounce and a quick click beats it.
*@

<div class="ben-editor" @ref="_host">
    @* One editor, not one per paste mode: the custom tools below have to be declared inside it, and two copies of
       them would drift. An empty EditorSettings leaves Telerik's own paste handling as it was. *@
    <TelerikEditor @ref="_editor"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   EditMode="@EditorEditMode.Div"
                   Height="@Height"
                   Tools="@ToolList">
        <EditorSettings>
            @if (CleanPaste)
            {
                @* Pasting from Word, a web page or a PDF brings its styling and its comments; a research page wants the
                   words and their structure (2026-09-14). Scripts and embeds never come in at all. *@
                <EditorPasteSettings ConvertMsLists="true"
                                     RemoveMsClasses="true"
                                     RemoveMsStyles="true"
                                     RemoveHtmlComments="true"
                                     StripTags="@StrippedOnPaste" />
            }
        </EditorSettings>
        <EditorCustomTools>
            @if (PictureLibrary is not null)
            {
                <EditorCustomTool Name="@LibraryPictureTool">
                    <TelerikButton Icon="@SvgIcon.Images" FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Title="Picture from your library" Class="ben-editor-library-picture"
                                   OnClick="@(() => _choosingPicture = true)" />
                </EditorCustomTool>
            }
            @if (PageLinks is not null)
            {
                <EditorCustomTool Name="@PageLinkTool">
                    <TelerikButton Icon="@SvgIcon.LinkAdd" FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Title="Link to one of your pages" Class="ben-editor-page-link"
                                   OnClick="@OpenPageLinksAsync" />
                </EditorCustomTool>
            }
        </EditorCustomTools>
    </TelerikEditor>
</div>

@if (PictureLibrary is not null)
{
    <BenContentPicker @bind-Visible="_choosingPicture"
                      Title="Add a picture from your library"
                      SelectText="Add this picture"
                      EmptyText="Your group has no public pictures yet. Upload one under Files and make it public, then come back."
                      Loader="@PictureLibrary"
                      OnSelected="@InsertPictureAsync" />
}

@if (PageLinks is not null)
{
    @* The editor's own link tool asks for an address; this one lists the group's pages, so linking to "About
       us" is a click rather than remembering how its address is spelled (Ben, 10/09/2026). *@
    <BenModal @bind-Visible="_choosingPage" Title="Link to one of your pages">
        <ChildContent>
            <p class="small text-secondary">
                @if (string.IsNullOrEmpty(_selectedText))
                {
                    <span>The page's title becomes the link text. To link some of your own words instead, select them before you click this button.</span>
                }
                else
                {
                    <span>This will link the words you selected: <strong>@_selectedText</strong></span>
                }
            </p>
            @if (PageLinks.Count == 0)
            {
                <div class="alert alert-light py-2 mb-0">Your group has no other pages yet.</div>
            }
            else
            {
                <div class="list-group" id="ben-editor-page-links">
                    @foreach (var link in PageLinks)
                    {
                        var chosen = link;
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2"
                                style="@($"padding-left:{1 + chosen.Depth * 1.25}rem")"
                                @onclick="@(() => InsertPageLinkAsync(chosen))">
                            <BenIcon Name="file-text" />
                            <span class="flex-grow-1">@chosen.Title</span>
                            <code class="small text-secondary">@chosen.Href</code>
                        </button>
                    }
                </div>
            }
            <div class="dialog-footer-actions">
                <span class="dialog-footer-spacer"></span>
                <button type="button" class="btn btn-secondary" @onclick="@(() => _choosingPage = false)">Cancel</button>
            </div>
        </ChildContent>
    </BenModal>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private ElementReference _host;
    private IJSObjectReference? _module;
    private TelerikEditor? _editor;

    // Tags unwrapped on paste. Not script, style or object: Telerik 14.1's StripTags removes only the tags themselves (a
    // regex on "<script>" and "</script>"), keeping what is between them — despite its documentation — so listing them put
    // a script's code, or the CSS in the <style> block Word puts on the clipboard, into the text as paragraphs (UI test pass
    // 5.13, 2026-09-14). Left alone, the editor's own parser drops those elements whole, contents and all.
    private static readonly List<string> StrippedOnPaste = ["iframe", "embed", "form", "link", "meta"];

    /// <summary>Cleans what is pasted: Office classes and styles, comments, and tags that have no place in a page.</summary>
    [Parameter] public bool CleanPaste { get; set; }

    /// <summary>
    /// Puts HTML where the cursor is — a link to a file or a web page from a research page's rail (2026-09-14).
    /// </summary>
    /// <param name="inline">True for something that belongs inside a line, like a link; false for a paragraph of its own.</param>
    public async Task InsertHtmlAsync(string html, bool inline = true)
    {
        if (_editor is null) return;
        await _editor.ExecuteAsync(new Telerik.Blazor.Components.Editor.HtmlCommandArgs("insertHtml", html, inline));
    }

    /// <summary>
    /// What the editor holds right now, read from the page rather than from the last debounced
    /// <see cref="ValueChanged"/>.
    /// </summary>
    /// <remarks>
    /// Call it when a form is submitted and use its answer: Telerik tells .NET about typing 100 ms after it stops,
    /// so a Send or Save pressed inside that window would otherwise act on the value from before the last
    /// keystrokes (e2e suite, 2026-09-14). Falls back to <see cref="Value"/> when the page cannot be asked — during
    /// prerender, or after the circuit has gone.
    /// </remarks>
    public async Task<string?> GetCurrentHtmlAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "/_content/Ben.Web.Website.Library/Kit/BenEditor.razor.js");
            return await _module.InvokeAsync<string?>("currentHtml", _host) ?? Value;
        }
        catch (JSDisconnectedException) { return Value; }
        catch (InvalidOperationException) { return Value; }   // prerendering: no browser to ask
    }

    /// <summary>The HTML being edited. Two-way bindable: <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Any CSS height — <c>"200px"</c>, <c>"60vh"</c>.</summary>
    [Parameter] public string Height { get; set; } = "200px";

    /// <summary>
    /// Pictures the toolbar's "Picture from your library" button offers. Set it and the button appears; leave it
    /// null and the toolbar is unchanged. Pair with <see cref="PictureUrl"/>.
    /// </summary>
    [Parameter] public Func<Task<IReadOnlyList<ContentPickerItem>>>? PictureLibrary { get; set; }

    /// <summary>The address a chosen picture is shown from. Required with <see cref="PictureLibrary"/>.</summary>
    [Parameter] public Func<Guid, string>? PictureUrl { get; set; }

    /// <summary>
    /// Pages the toolbar's "Link to one of your pages" button offers, in menu order. Null: no button.
    /// </summary>
    [Parameter] public IReadOnlyList<BenEditorPageLink>? PageLinks { get; set; }

    private const string LibraryPictureTool = "BenLibraryPicture";
    private const string PageLinkTool = "BenPageLink";

    private bool _choosingPicture, _choosingPage;
    private string? _selectedText;

    /// <summary>
    /// The caller's tools plus ours. A new list every time: the default is Telerik's shared static set, and adding
    /// to it would put the buttons on every editor on the site.
    /// </summary>
    private List<IEditorTool> ToolList
    {
        get
        {
            if (PictureLibrary is null && PageLinks is null) return Tools;
            var list = new List<IEditorTool>(Tools);
            if (PictureLibrary is not null) list.Add(new Telerik.Blazor.Components.Editor.CustomTool(LibraryPictureTool));
            if (PageLinks is not null) list.Add(new Telerik.Blazor.Components.Editor.CustomTool(PageLinkTool));
            return list;
        }
    }

    private async Task InsertPictureAsync(ContentPickerItem item)
    {
        if (PictureUrl is null) return;
        var alt = System.Net.WebUtility.HtmlEncode(Path.GetFileNameWithoutExtension(item.Name));
        await InsertHtmlAsync($"<img src=\"{PictureUrl(item.Id)}\" alt=\"{alt}\" />", inline: false);
    }

    /// <summary>
    /// Opens the page list, first noting the words selected in the editor: opening a window moves the browser's
    /// focus, and the words are what the link should go on.
    /// </summary>
    private async Task OpenPageLinksAsync()
    {
        _selectedText = null;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "/_content/Ben.Web.Website.Library/Kit/BenEditor.razor.js");
            _selectedText = (await _module.InvokeAsync<string?>("selectedText", _host))?.Trim();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        _choosingPage = true;
    }

    private async Task InsertPageLinkAsync(BenEditorPageLink link)
    {
        _choosingPage = false;
        if (_editor is null) return;
        if (!string.IsNullOrEmpty(_selectedText))
            await _editor.ExecuteAsync(new Telerik.Blazor.Components.Editor.LinkCommandArgs(link.Href, _selectedText, link.Title));
        else
            await InsertHtmlAsync($"<a href=\"{link.Href}\">{System.Net.WebUtility.HtmlEncode(link.Title)}</a>");
    }

    /// <summary>
    /// The toolbar. Defaults to Telerik's own full set, which is what most call sites want; the
    /// few that pass a shorter list are places where a heading or a table would be out of place
    /// (a note on an audio region, a message body).
    /// </summary>
    [Parameter] public List<IEditorTool> Tools { get; set; } = Telerik.Blazor.Components.Editor.EditorToolSets.Default;

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
