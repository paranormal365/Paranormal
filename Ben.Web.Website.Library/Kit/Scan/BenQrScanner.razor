@namespace Ben.Web.Website.Library.Kit.Scan

@implements IAsyncDisposable

@inject IJSRuntime JS

@using Ben.Web.Website.Library.Manage.Icon

@* Reading a pass off the camera (item 235 phase 7).

   THE CAMERA IS THE FAST PATH AND NEVER THE ONLY ONE. A flat battery, a cracked lens, a venue on
   http over its own network, an iPhone whose owner said no to the permission — every one of those
   is an ordinary evening, and the door has a code box and a name search underneath for exactly
   that reason. So this component's job is to work when it can and to say plainly what happened
   when it cannot.

   IT NEVER TOUCHES THE DOM. The video and the canvas below are Blazor's; the module sets
   .srcObject and reads pixels. Nothing is created, moved or removed from JavaScript. *@

<div class="scanner @Class">
    @if (_on)
    {
        <div class="scanner__frame">
            <video id="@_videoId" class="scanner__video" muted playsinline></video>
            @* Where a frame is copied to when the platform has no decoder of its own. Never seen. *@
            <canvas id="@_canvasId" class="scanner__canvas"></canvas>
        </div>
    }

    @if (_refusal is { Length: > 0 })
    {
        <div class="alert alert-warning py-2 mb-2" id="scanner-refusal" role="alert">@_refusal</div>
    }

    <button type="button" class="btn @(_on ? "btn-outline-secondary" : "btn-primary") w-100"
            id="scanner-toggle" disabled="@_busy" @onclick="ToggleAsync">
        <BenIcon Name="@(_on ? "video-off" : "camera")" Class="me-1" />
        @(_on ? "Stop the camera" : "Scan a pass")
    </button>
</div>

@code {
    /// <summary>Told what the camera read. The caller decides what it means.</summary>
    [Parameter] public EventCallback<string> OnScanned { get; set; }

    [Parameter] public string? Class { get; set; }

    private readonly string _videoId = $"scan-video-{Guid.NewGuid():N}";
    private readonly string _canvasId = $"scan-canvas-{Guid.NewGuid():N}";

    private IJSObjectReference? _module;
    private DotNetObjectReference<BenQrScanner>? _self;
    private bool _on;
    private bool _busy;
    private bool _disposed;
    private string? _refusal;

    private async Task ToggleAsync()
    {
        if (_on) { await StopAsync(); return; }

        _busy = true;
        _refusal = null;
        _on = true;

        // Rendered first: the module needs the <video> to exist before it can point a stream at
        // it, and Blazor has not drawn it yet at the moment the button is pressed.
        StateHasChanged();
        await Task.Yield();

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "/_content/Ben.Web.Website.Library/Kit/Scan/BenQrScanner.razor.js");
            if (_disposed) return;

            _self ??= DotNetObjectReference.Create(this);

            var started = await _module.InvokeAsync<StartResult>(
                "start", _videoId, _canvasId, _self);
            if (_disposed) return;

            if (!started.Ok)
            {
                _on = false;
                _refusal = Why(started.Reason);
            }
        }
        catch (JSException)
        {
            _on = false;
            _refusal = "The camera couldn't be started on this device. Type the code instead — "
                     + "it's on the guest's pass.";
        }
        catch (Exception e) when (e is TaskCanceledException or ObjectDisposedException)
        {
            // The circuit went away mid-import. Nothing to say to nobody.
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StopAsync()
    {
        _on = false;

        if (_module is null) return;

        try { await _module.InvokeVoidAsync("stop", _videoId); }
        catch (Exception e) when (e is JSException or TaskCanceledException or ObjectDisposedException)
        {
            // The page is going away; the browser stops the tracks with it.
        }
    }

    /// <summary>Called by the module when the camera reads a code.</summary>
    /// <remarks>
    /// Named for the module rather than for the parameter it feeds: a JSInvokable method and an
    /// EventCallback cannot share a name, and the module's side of the contract is the one written
    /// down in JavaScript.
    /// </remarks>
    [JSInvokable]
    public async Task CodeRead(string text)
    {
        if (_disposed || string.IsNullOrWhiteSpace(text)) return;
        await OnScanned.InvokeAsync(text.Trim());
    }

    private sealed record StartResult(bool Ok, string? Reason, string? Decoder);

    /// <summary>
    /// Why the camera did not start, in a sentence the person holding the phone can act on.
    /// </summary>
    /// <remarks>
    /// Every one of these ends with what to do instead, because the door does not stop while
    /// somebody works out whether the problem is theirs. The insecure-origin case is the one a
    /// venue meets testing over its own network, and "no camera" would send them looking for a
    /// hardware fault that is not there.
    /// </remarks>
    private static string Why(string? reason) => reason switch
    {
        "refused" =>
            "This browser is set to refuse the camera. Allow it in the address bar, or type the "
          + "code from the guest's pass below.",
        "no-camera" =>
            "No camera on this device. Type the code from the guest's pass below, or find them by "
          + "name.",
        "insecure" =>
            "Browsers only give the camera to a secure address. Open this page over https, or "
          + "type the code from the guest's pass below.",
        "no-decoder" =>
            "This browser can't read QR codes and the reader couldn't be fetched. Type the code "
          + "from the guest's pass below.",
        _ =>
            "The camera couldn't be started. Type the code from the guest's pass below, or find "
          + "them by name.",
    };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        await StopAsync();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (Exception e) when (e is JSException or TaskCanceledException or ObjectDisposedException)
            {
                // The circuit is already gone.
            }
        }

        _self?.Dispose();
    }
}
