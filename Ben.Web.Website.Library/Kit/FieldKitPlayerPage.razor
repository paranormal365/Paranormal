@namespace Ben.Web.Website.Library.Kit
@page "/field-sessions/{SessionId:guid}"

@*
    The player on its own route. Everything it does lives in FieldKitPlayer, so the same thing
    can be dropped into a case page or an investigation panel without moving any of it.
*@

@* The browser keeps time (10/14/2026). The previous player stays one setting away —
   FieldKit:Player = legacy — for a release, in case the new one has to be stepped back from. *@
@if (FieldKitPlayerChoice.UseLegacy(Configuration))
{
    <FieldKitPlayer SessionId="@SessionId" Standalone="true" />
}
else
{
    <FieldKitEnginePlayer SessionId="@SessionId" Standalone="true" />
}

@code {
    [Inject] private Microsoft.Extensions.Configuration.IConfiguration Configuration { get; set; } = default!;

    [Parameter] public Guid SessionId { get; set; }
}
