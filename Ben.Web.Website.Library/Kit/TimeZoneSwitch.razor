@*
    "Local time · My time" — which clock the times on this page read on (Ben, 2026-09-28: "You can
    see the event and tour time in the event or tour timezone or the user's timezone"). Remembered
    across the site by TimeView. When the reader's clock and the place's are the same, there is
    nothing to switch, and it says so instead of offering two buttons that do the same thing.
*@
@using Ben.Data.Common.Helpers
@inject IBenUserState UserState
@inject TimeView View
@implements IDisposable

@if (Same)
{
    @* inline-flex: the template draws an icon as a block, which put the clock on a line of its
       own above the words in the event page's hero (10/02/2026). *@
    <span class="small text-secondary d-inline-flex align-items-center" data-testid="time-zone-same">
        <BenIcon Name="clock" Class="me-1" />Times are @PlaceLetters, your time too
    </span>
}
else
{
    <div class="btn-group btn-group-sm ben-time-switch" role="group" aria-label="Show times in" data-testid="time-zone-switch">
        <button type="button" class="btn @(View.InMyTime ? "btn-outline-secondary" : "btn-secondary")"
                aria-pressed="@((!View.InMyTime).ToString().ToLowerInvariant())"
                title="@(ZoneId is null ? $"Each {Noun} in its own time" : $"The {Noun}'s own time, {Zones.IanaId(Place)}")"
                data-testid="time-zone-local" @onclick="() => View.SetAsync(false)">
            @(ZoneId is null ? "Local time" : $"Local time ({PlaceLetters})")
        </button>
        <button type="button" class="btn @(View.InMyTime ? "btn-secondary" : "btn-outline-secondary")"
                aria-pressed="@View.InMyTime.ToString().ToLowerInvariant()"
                title="@($"Your time, {Zones.IanaId(UserState.ViewerTimeZone)}")"
                data-testid="time-zone-mine" @onclick="() => View.SetAsync(true)">
            My time (@MyLetters)
        </button>
    </div>
}

@code {
    /// <summary>
    /// The item's own zone (IANA); null for a list whose rows keep different clocks — then the
    /// switch names no zone and each time carries its own letters.
    /// </summary>
    [Parameter] public string? ZoneId { get; set; }

    /// <summary>"event", "tour", "case", "investigation" — for the tooltip.</summary>
    [Parameter] public string Noun { get; set; } = "place";

    /// <summary>
    /// When the times on the page happen (UTC); now when omitted. The letters follow it.
    /// </summary>
    /// <remarks>
    /// The zone's letters depend on the date. A November event read on an October day said "Times
    /// are CDT" above a start time labelled CST (10/02/2026), because the letters were taken at the
    /// moment the page was read rather than the moment it is about.
    /// </remarks>
    [Parameter] public DateTime? At { get; set; }

    private DateTime When => At is { } at ? DateTime.SpecifyKind(at, DateTimeKind.Utc) : DateTime.UtcNow;
    private TimeZoneInfo Place => Zones.Find(ZoneId);
    private string PlaceLetters => Zones.Abbreviation(Place, When);
    private string MyLetters => Zones.Abbreviation(UserState.ViewerTimeZone, When);
    private bool Same => ZoneId is not null && Zones.IanaId(Place) == Zones.IanaId(UserState.ViewerTimeZone);

    protected override void OnInitialized() => View.Changed += Redraw;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await UserState.AuthReady;
        await View.EnsureLoadedAsync();
        StateHasChanged();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => View.Changed -= Redraw;
}
