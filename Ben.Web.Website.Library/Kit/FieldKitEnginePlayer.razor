@namespace Ben.Web.Website.Library.Kit
@using Microsoft.JSInterop
@using System.Text.Json
@using Ben.Web.Website.Library.Kit.Maps
@using Ben.Web.Services
@using Ben.Service.Models.FieldSessions
@using TimelineMarker = Ben.Service.Models.FieldSessions.TimelineMarker
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject IMediaUrlBuilder MediaUrls
@inject Microsoft.Extensions.Options.IOptions<Ben.Data.Common.SiteIdentity> SiteOptions
@inject IJSRuntime JS
@inject TimeView TimeView
@using Microsoft.Extensions.Logging
@inject ILogger<FieldKitEnginePlayer> Logger
@implements IAsyncDisposable

@*
    FieldKitEnginePlayer — playing back a session somebody recorded on their phone, with the
    browser keeping time (10/14/2026).

    The page is drawn ONCE, from the session's timeline (built on the server by the replay rules
    the phone's review also follows — ProjectNotes/specs/replay-semantics.md). Everything that moves
    with the playhead belongs to wwwroot/js/fieldKitPlayer.js: the transport, the scrubber, the
    readouts, the stage, the photo glow, the map, the chart's playhead. While somebody watches,
    this component does nothing at all, which is what lets a room full of people watch one night
    without each of them costing the server four renders a second.

    The elements the engine fills are rendered EMPTY here (data-fk="…"), so Blazor's next render
    has nothing of theirs to undo. The first player, which kept time on the server, was retired on
    10/28/2026, a release after this one replaced it.
*@

@if (Standalone)
{
    <PageTitle>@(_session?.LocationLabel ?? "Field session") — @SiteOptions.Value.Name</PageTitle>
}

<div class="@(Standalone ? "container-fluid px-3" : "")"
     style="@(Standalone ? "max-width:1200px;margin:0 auto;" : "")">

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Reading the session…" />
    }
    else if (_signedOut)
    {
        <div class="card border-warning mt-4">
            <div class="card-body">
                <h5 class="card-title">Sign in to see this session</h5>
                <p class="card-text">
                    Field sessions are private to the person who recorded them and the
                    investigation they were sent to. Sign in and this page will open.
                </p>
                <a class="btn btn-primary btn-sm" data-testid="sign-in-to-see"
                   href="@($"/login?returnUrl={Uri.EscapeDataString($"/field-sessions/{SessionId}")}")">Sign in</a>
            </div>
        </div>
    }
    else if (_refusal is not null)
    {
        <div class="card border-warning">
            <div class="card-body">
                <h5 class="card-title">This session couldn't be loaded</h5>
                <p class="card-text">@_refusal</p>
                <button class="btn btn-outline-secondary btn-sm" @onclick="Load">Try again</button>
            </div>
        </div>
    }
    else if (_session is null || _timeline is null)
    {
        <div class="alert alert-secondary">This session isn't here.</div>
    }
    else
    {
        <div class="mb-3 fk-heading" data-testid="session-heading">
            <div class="fk-kicker"><BenIcon Name="activity" />Field session</div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h3 class="mb-0 me-1 fk-title">@(_session.LocationLabel ?? "Field session")</h3>
                <span class="text-muted" data-testid="session-started">@Moment(_timeline.StartUtc)</span>
                @if (_timeline.TimeZoneId is { } recordedIn)
                {
                    <TimeZoneSwitch ZoneId="@recordedIn" Noun="session" At="@_timeline.StartUtc" />
                }
            </div>

            @* Where it belongs, said and linked (10/28/2026): a session sent to an event used to read
               the same as one kept to oneself. *@
            @if (BelongsSentence() is { } belongs)
            {
                <div class="small mt-1" data-testid="session-belongs">@belongs</div>
            }

            <div class="small text-secondary mt-1" data-testid="session-facts">
                @Facts()
                @if (!string.IsNullOrWhiteSpace(_session.RecordedByName))
                {
                    <text> · recorded by @_session.RecordedByName</text>
                }
                else if (!Anonymous)
                {
                    <text> · <span class="text-warning">nobody signed in when recorded</span></text>
                }
            </div>
            @if (!_timeline.HasEndTime)
            {
                <div class="small text-secondary mt-1" data-testid="session-interrupted">
                    <BenIcon Name="alert-circle" Class="me-1" />The phone never closed this session, so it runs to the last thing it recorded.
                </div>
            }
        </div>

        @if (Shared)
        {
            <div class="alert alert-secondary py-2 small" data-testid="share-banner">
                <BenIcon Name="link" Class="me-1" />
                You're viewing this through a shared link.
                @if (_shareExpires is { } expires)
                {
                    <text> It stops working on @expires.ToViewerLocalTime(UserState).ToDisplayDateTime().</text>
                }
                @if (_positionsWithheld)
                {
                    <text> The locations recorded with these readings were not shared, so no map is shown.</text>
                }
            </div>
        }

        @if (_public is { } published)
        {
            <div class="alert alert-secondary py-2 small" data-testid="archive-banner">
                <BenIcon Name="map-pin" Class="me-1" />
                @if (published.EventTitle is { } eventTitle)
                {
                    @* Shown with an event's results, which is where a visitor came from (10/28/2026). *@
                    <text>Shown with the results of </text>
                    @if (published.EventUrl is { } eventUrl)
                    {
                        <a href="@eventUrl" data-testid="archive-event">@eventTitle</a>
                    }
                    else
                    {
                        <span data-testid="archive-event">@eventTitle</span>
                    }
                    @(published.GroupName is { } group ? $", by {group}" : "")<text>, at </text><a href="@($"/places/{published.PlaceId}")">@published.PlaceName</a><text>.</text>
                }
                else
                {
                    <text>From the field archive for </text><a href="@($"/places/{published.PlaceId}")">@published.PlaceName</a><text>.</text>
                }
                Where somebody stood is shown at the place's public point, never where their phone was.
                @if (published.Files.Count == 0)
                {
                    <text> Its recordings and photos aren't shown at the moment.</text>
                }
            </div>
        }

        @if (_insights is { OthersWhoRecordedHere: > 0 } insights)
        {
            <FieldSessionInsightsCard Insights="@insights" />
        }

        @if (_timeline.Readings.T.Length == 0)
        {
            <div class="alert alert-secondary">This session's document holds no readings.</div>
        }
        else
        {
            <div class="fk-player" @ref="_root" tabindex="-1" data-testid="field-player">
                <div class="card mb-3 fk-deck">
                    <div class="card-body">
                        <div data-fk="transport"></div>

                        @if (_mediaNotice is not null)
                        {
                            <div class="alert alert-info py-1 px-2 small mb-2" role="status" data-testid="media-notice">@_mediaNotice</div>
                        }

                        @if (HasStage)
                        {
                            <div class="fk-stage" data-fk="stage" data-testid="media-stage">
                                @foreach (var file in _session.Files.Where(f => IsVideo(f.RelativePath) && !_undecodable.Contains(f.Id) && !_unreachable.Contains(f.Id)))
                                {
                                    <video @key="file.Id" class="fk-stage-video" preload="metadata" playsinline
                                           style="display:none" src="@FileUrl(file.Id)" data-testid="stage-video"
                                           data-fk-media="@file.Id"></video>
                                }
                                <div class="fk-stage-empty" data-fk="stage-note">
                                    <BenIcon Name="moon" Class="fk-stage-icon text-muted" />
                                    <span class="small text-muted font-monospace" data-fk="stage-note-text"></span>
                                </div>
                            </div>
                        }

                        @if (_timeline.Photos.Count > 0)
                        {
                            <div class="fk-photo-strip" data-fk="photos" data-testid="photo-strip"
                                 aria-label="Photos taken during the session">
                                @foreach (var photo in _timeline.Photos)
                                {
                                    <button type="button" @key="photo.FileId" class="fk-thumb"
                                            data-testid="photo-thumb" data-fk-photo="@photo.FileId" data-fk-t="@photo.T"
                                            title="@PhotoTitle(photo)">
                                        <img src="@FileUrl(photo.FileId)" alt="Photo at @Elapsed(photo.T)" loading="lazy" />
                                        <span class="fk-thumb-time">@Elapsed(photo.T)</span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="row g-3 mt-1" data-testid="session-readout">
                            <div class="col-6 col-md-3">
                                <div class="text-muted small" data-testid="field-label"
                                     title="@(NoBase ? "No base level was set during this session, so the field is shown as measured." : null)">
                                    Magnetic field@(_timeline.Trace.MagneticFromBase ? " (from base)" : NoBase ? " (no base set)" : "")
                                </div>
                                <div class="fs-5 font-monospace" data-fk="field"></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Sound</div>
                                <div class="fs-5 font-monospace" data-fk="sound"></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small" data-fk="facing-title"></div>
                                <div class="fs-5 font-monospace" data-fk="facing"></div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted small">Position</div>
                                <div class="fs-6 font-monospace" data-fk="position"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-lg-7">
                        <div class="card h-100">
                            <div class="card-header py-2">@ChartHeading</div>
                            <div class="card-body">
                                @if (_timeline.Trace.Magnetic.Count == 0 && _timeline.Trace.Sound.Count == 0)
                                {
                                    <div class="text-muted small p-3" data-testid="no-channels">
                                        This session recorded no magnetic or sound readings.
                                    </div>
                                }
                                @if (_timeline.Trace.Magnetic.Count > 0)
                                {
                                    <FieldTraceChart Points="@_timeline.Trace.Magnetic" DurationMs="@_timeline.DurationMs"
                                                     Away="@_timeline.Away" Markers="@_timeline.Markers"
                                                     Unit="@(_timeline.Trace.MagneticFromBase ? "mG from base" : "mG abs")"
                                                     TestId="trace-magnetic" AriaLabel="Magnetic field over the session"
                                                     Height="@(_timeline.Trace.Sound.Count > 0 ? 120 : 220)"
                                                     ClockAt="@ClockAt" />
                                }
                                @if (_timeline.Trace.Sound.Count > 0)
                                {
                                    <FieldTraceChart Points="@_timeline.Trace.Sound" DurationMs="@_timeline.DurationMs"
                                                     Away="@_timeline.Away" Markers="@_timeline.Markers"
                                                     Unit="dBFS" TestId="trace-sound" AriaLabel="Sound over the session"
                                                     Height="@(_timeline.Trace.Magnetic.Count > 0 ? 120 : 220)"
                                                     ClockAt="@ClockAt" />
                                }
                                @if (_timeline.Away.Count > 0)
                                {
                                    <div class="text-muted small pt-2" data-testid="away-stretch">
                                        <strong>Shaded:</strong> @AwaySentence()
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-5">
                        <div class="card h-100">
                            <div class="card-header py-2">Where they were</div>
                            <div class="card-body p-2">
                                <div class="mb-2" data-fk="room"></div>
                                @if (FirstFix is not { } first)
                                {
                                    <div class="text-muted small p-3" data-testid="no-position">
                                        @if (_positionsWithheld)
                                        {
                                            <text>The locations recorded during this session weren't shared through this link.</text>
                                        }
                                        else
                                        {
                                            <text>No position was recorded for this session.</text>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <BenMap Pins="@NoPins" FitToPins="false" Height="260px"
                                            CenterLatitude="@first.Lat" CenterLongitude="@first.Lon"
                                            Zoom="@(_timeline.Positions == TimelinePositionPolicy.Exact ? 18 : 15)" />
                                    @if (_timeline.Positions == TimelinePositionPolicy.PublicPoint)
                                    {
                                        <div class="text-muted small pt-2" data-testid="map-public-point">
                                            Shown at the place's public point, not where the phone was.
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (_session.Files.Count > 0 || Missing.Count > 0)
                {
                    <div class="card mt-3">
                        <div class="card-header py-2 d-flex flex-wrap align-items-center gap-2">
                            <span>Recordings</span>
                            @if (_timeline.Clips.Any(c => c.Kind == EnhancedKind))
                            {
                                @* An enhanced clip plays in the original's place, at its own moment (10/28/2026). *@
                                <div class="form-check form-switch mb-0 ms-auto small">
                                    <input class="form-check-input" type="checkbox" id="prefer-enhanced" data-fk-prefer-enhanced
                                           data-testid="prefer-enhanced" />
                                    <label class="form-check-label" for="prefer-enhanced">Play the enhanced clips in their place</label>
                                </div>
                            }
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var gone in Missing)
                            {
                                @* Named in the session but never sent — the phone's sound file lost in iOS 1.1.5
                                   (10/23/2026) is the case. Said, so a night with no sound doesn't look like a broken page. *@
                                <li class="list-group-item d-flex align-items-center gap-3 flex-wrap" data-testid="media-missing">
                                    <span class="font-monospace small text-secondary">@gone.Path</span>
                                    <span class="badge text-bg-secondary">not sent</span>
                                    <span class="small text-secondary">@MissingSentence(gone)</span>
                                </li>
                            }
                            @foreach (var file in _session.Files)
                            {
                                var clip = _timeline.Clips.FirstOrDefault(c => c.FileId == file.Id);
                                <li class="list-group-item d-flex align-items-center gap-3 flex-wrap" @key="file.Id">
                                    <span class="font-monospace small">@file.RelativePath</span>
                                    @if (clip?.StartMs is > 0 and var startMs)
                                    {
                                        <span class="text-muted small" data-testid="media-starts-at" data-fk-start="@file.Id">from @Elapsed(startMs)</span>
                                    }
                                    else if (clip is { StartMs: null })
                                    {
                                        @* Placed by the engine once the browser has read its length. *@
                                        <span class="text-muted small" data-fk-start="@file.Id"></span>
                                    }
                                    @if (!file.DigestMatched)
                                    {
                                        <span class="badge text-bg-warning">arrived damaged</span>
                                    }
                                    @if (_unreachable.Contains(file.Id))
                                    {
                                        <span class="badge text-bg-warning" data-testid="unreachable">couldn't be reached</span>
                                        <a class="btn btn-outline-secondary btn-sm ms-auto text-nowrap"
                                           href="@FileUrl(file.Id)" download>Download the file</a>
                                    }
                                    else if (_undecodable.Contains(file.Id))
                                    {
                                        <span class="badge text-bg-warning" data-testid="undecodable">won't play in this browser</span>
                                        <a class="btn btn-outline-secondary btn-sm ms-auto text-nowrap"
                                           href="@FileUrl(file.Id)" download>Download the file</a>
                                    }
                                    else if (IsAudio(file.RelativePath))
                                    {
                                        <audio controls preload="metadata" class="ms-auto"
                                               src="@FileUrl(file.Id)" data-fk-media="@file.Id"></audio>
                                    }
                                    else if (IsVideo(file.RelativePath))
                                    {
                                        <span class="ms-auto small text-muted">plays above, with the session</span>
                                    }
                                    else if (IsImage(file.RelativePath))
                                    {
                                        <a href="@FileUrl(file.Id)" target="_blank" rel="noopener"
                                           class="ms-auto" data-testid="session-photo">
                                            <img src="@FileUrl(file.Id)" alt="@file.RelativePath" loading="lazy"
                                                 style="max-height:120px;width:auto;border-radius:.25rem;" />
                                        </a>
                                    }
                                </li>
                                @foreach (var made in DerivedFrom(file.RelativePath))
                                {
                                    @* A clip made from this recording, outside the session: the .ben is never edited (10/28/2026). *@
                                    var placed = _timeline.Clips.FirstOrDefault(c => c.FileId == made.FileId && c.Kind == EnhancedKind);
                                    <li class="list-group-item d-flex align-items-center gap-3 flex-wrap ps-4 fk-derived" @key="made.FileId"
                                        data-testid="derived-row">
                                        <BenIcon Name="corner-down-right" Class="text-muted" />
                                        <span class="badge @(made.Enhanced ? "text-bg-info" : "text-bg-secondary")" data-testid="derived-kind">@(made.Enhanced ? "Enhanced" : "Altered")</span>
                                        <span class="small">@made.Summary</span>
                                        @if (placed?.StartMs is { } at)
                                        {
                                            <span class="text-muted small">at @Elapsed(at)</span>
                                        }
                                        <span class="text-muted small">by @made.MadeBy</span>
                                        @if (made.Certified)
                                        {
                                            <a class="small" data-testid="certificate-link" href="@CertificateHref(made.FileId)">
                                                <BenIcon Name="award" Class="me-1" />Certificate
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small" title="Made before certificates, or not from this session's recording on this site.">no certificate</span>
                                        }
                                        @if (placed is not null)
                                        {
                                            <audio controls preload="metadata" class="ms-auto" src="@DerivedUrl(made.FileId)"
                                                   data-fk-media="@made.FileId"></audio>
                                        }
                                        else
                                        {
                                            <audio controls preload="none" class="ms-auto" src="@DerivedUrl(made.FileId)"></audio>
                                        }
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                }

                @if (_timeline.Markers.Count > 0)
                {
                    <div class="card mt-3">
                        <div class="card-header py-2">Marked</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var marker in _timeline.Markers)
                            {
                                var asked = marker.Kind == "evp_question";
                                var evp = marker.Kind == EvpKind;
                                <li class="list-group-item d-flex align-items-center gap-3 fk-marker @(evp ? "fk-marker--evp" : "")" data-fk-marker="@marker.T"
                                    data-testid="@(asked ? "question-row" : evp ? "evp-row" : "marker-row")">
                                    <BenIcon Name="@(asked ? "help-circle" : evp ? "mic" : marker.Automatic ? "zap" : "flag")"
                                             Class="@(evp ? "fk-marker-icon text-success" : marker.Automatic ? "fk-marker-icon text-warning" : "fk-marker-icon text-info")" />
                                    <button class="btn btn-sm btn-outline-secondary text-nowrap" data-fk-jump="@marker.T"
                                            title="Go to a moment before this">
                                        @Elapsed(marker.T)
                                    </button>
                                    @if (asked)
                                    {
                                        @* A question asked in an EVP session, and how long the room was given to answer. *@
                                        <span>@(string.IsNullOrWhiteSpace(marker.Note) ? "A question asked" : $"Asked: “{marker.Note.Trim()}”")</span>
                                        @if (marker.ListenUntilMs is { } until)
                                        {
                                            <span class="text-muted small" data-testid="question-listened">listened @Listened(until - marker.T)</span>
                                        }
                                    }
                                    else if (evp && EvpAt(marker) is { } kept)
                                    {
                                        @* An EVP somebody kept on their copy of the recording, and what they heard (10/28/2026). *@
                                        <span><strong>EVP</strong> “@kept.Heard”</span>
                                        <span class="badge text-bg-secondary">@kept.Confidence</span>
                                        <span class="text-muted small">by @kept.MadeBy</span>
                                        @if (kept.ClipFileId is { } clipId && _findings!.Clips.Any(c => c.FileId == clipId && c.Certified))
                                        {
                                            <a class="small" href="@CertificateHref(clipId)" data-testid="evp-certificate"><BenIcon Name="award" Class="me-1" />Certificate</a>
                                        }
                                    }
                                    else
                                    {
                                        <span>@marker.Title</span>
                                    }
                                    @if (!evp && MarkerFieldText(marker) is { } reading)
                                    {
                                        <span class="font-monospace small" data-testid="marker-field">@reading</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(marker.Room))
                                    {
                                        <span class="badge text-bg-secondary" data-testid="marker-room">@marker.Room</span>
                                    }
                                    @if (!asked && !evp && !string.IsNullOrWhiteSpace(marker.Note))
                                    {
                                        <span class="text-muted small">@marker.Note</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(marker.Details))
                                    {
                                        @* Written by the investigator after the session, before sending it; read-only here. *@
                                        <div class="small w-100 mt-1" data-testid="marker-details">
                                            <span class="text-secondary">Added after the session@(marker.DetailsAddedAt is { } addedAt ? $" on {addedAt.ToViewerLocalTime(UserState).ToDisplayDate()}" : ""):</span> @marker.Details
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            @* Scanning for EVPs (phase 9 of the audio plan): never through a share link. On the
               public archive it shows only to somebody who may scan, which is the place's venue. *@
            @if (!Shared)
            {
                <SessionEvpScanPanel SessionId="@SessionId" QuietWhenRefused="@Public" />
            }

            @if (!Anonymous)
            {
                <FieldSessionSharePanel SessionId="@SessionId" Files="@_session.Files" />
                <FieldSessionActionsPanel Session="@_session" />
            }
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid SessionId { get; set; }

    /// <summary>True when this is the whole page rather than a panel inside something else.</summary>
    [Parameter] public bool Standalone { get; set; } = true;

    /// <summary>The share link this is played through, when it is one (item 207).</summary>
    [Parameter] public string? ShareToken { get; set; }

    /// <summary>
    /// A session from a place's public archive (10/14/2026): anonymous, positions at the place's
    /// public point, recordings only once approved, served by the archive's own media route.
    /// </summary>
    [Parameter] public bool Public { get; set; }

    private bool Shared => !string.IsNullOrWhiteSpace(ShareToken);

    /// <summary>Somebody without an account: a share link or the public archive.</summary>
    private bool Anonymous => Shared || Public;

    private PublicSessionSummary? _public;

    private static readonly IReadOnlyList<BenMapPin> NoPins = [];
    private static readonly JsonSerializerOptions TimelineJson = new(JsonSerializerDefaults.Web);

    private bool _loading = true;
    private bool _signedOut;
    private string? _refusal;
    private FieldSessionSummaryRecord? _session;
    private SessionTimeline? _timeline;

    /// <summary>What was found in the recordings: EVPs kept and clips made (10/28/2026). Never on a share link.</summary>
    private SessionFindings? _findings;
    private SessionInsightsRecord? _insights;
    private DateTime? _shareExpires;
    private bool _positionsWithheld;
    private string? _mediaNotice;
    private readonly HashSet<Guid> _undecodable = [];

    /// <summary>Recordings tried again and still not reached: said beside them, with the download.</summary>
    private readonly HashSet<Guid> _unreachable = [];

    /// <summary>How many fresh links each recording has been given since it last loaded.</summary>
    private readonly Dictionary<Guid, int> _attempts = [];

    /// <summary>Added to a recording's link after a retry, so the browser asks again rather than reusing a failure.</summary>
    private readonly Dictionary<Guid, int> _linkGeneration = [];

    private ElementReference _root;
    private IJSObjectReference? _engine;
    private DotNetObjectReference<FieldKitEnginePlayer>? _self;
    private bool _started;
    private readonly List<Guid> _justRenewed = [];

    /// <summary>
    /// Set before the engine's start awaits anything. Blazor runs OnAfterRenderAsync after EVERY
    /// render, including one that lands while the first is still awaiting the module; that pass
    /// used to start the engine a second time on the same element, leaving the buttons wired to
    /// the first engine and the recordings driven by both, so Pause stopped one and the other
    /// played straight on (10/28/2026). BenMap guards the same window the same way.
    /// </summary>
    private bool _starting;

    /// <summary>
    /// What was last ASKED for, set before the load starts. Checked against what had finished
    /// loading, a parent re-render arriving mid-load (the sign-in state settling does it) started
    /// a second load that tore down the player the first had just built.
    /// </summary>
    private Guid? _requestedFor;
    private string? _requestedToken;
    private bool? _requestedPublic;

    // The Local time / My time switch redraws the heading and the chart's times.
    protected override void OnInitialized() => TimeView.Changed += RedrawForClock;

    private void RedrawForClock() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        // Re-runs only when the router reuses this page for a different session.
        if (_requestedFor == SessionId && _requestedToken == ShareToken && _requestedPublic == Public) return;
        _requestedFor = SessionId;
        _requestedToken = ShareToken;
        _requestedPublic = Public;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _refusal = null;
        _signedOut = false;
        _session = null;
        _timeline = null;
        _findings = null;
        _mediaNotice = null;
        _undecodable.Clear();
        _unreachable.Clear();
        _attempts.Clear();
        _linkGeneration.Clear();
        _justRenewed.Clear();
        await StopEngineAsync();
        StateHasChanged();

        if (Public) await LoadPublicAsync();
        else if (Shared) await LoadSharedAsync();
        else await LoadSignedInAsync();
    }

    private async Task LoadSignedInAsync()
    {
        // The circuit is not signed in during the static prerender; loading now would be refused
        // and settle on a refusal that never retries.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        var summary = AdminClient.GetFieldSessionSummaryAsync(SessionId);
        var timeline = AdminClient.GetFieldSessionTimelineAsync(SessionId);
        var findings = AdminClient.GetSessionFindingsAsync(SessionId);
        var insights = AdminClient.GetSessionInsightsAsync(SessionId);
        var detail = await summary;
        _timeline = await timeline;
        _insights = await insights;
        _loading = false;

        if (detail is null)
        {
            if (!UserState.IsAuthenticated) { _signedOut = true; return; }
            _refusal = "The server didn't return this session. It may have been removed, or you "
                     + "may no longer have access to the investigation it belongs to.";
            return;
        }
        _session = detail.Session;
        if (_timeline is null) _refusal = "This session's document couldn't be read.";
        else _timeline = WithFindings(_timeline, _findings = await findings);
    }

    private async Task LoadSharedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        var summary = AdminClient.GetSharedFieldSessionSummaryAsync(ShareToken!);
        var timeline = AdminClient.GetSharedFieldSessionTimelineAsync(ShareToken!);
        var shared = await summary;
        _timeline = await timeline;
        _loading = false;

        if (shared is null)
        {
            _refusal = "This link isn't working. It may have expired, or the person who sent it "
                     + "may have withdrawn it. Ask them for a new one.";
            return;
        }

        _shareExpires = shared.ExpiresUtc;
        _positionsWithheld = shared.PositionsWithheld;
        _session = new FieldSessionSummaryRecord(
            Id: Guid.Empty, InvestigationId: null, DeviceSessionId: Guid.Empty,
            DeviceModel: shared.DeviceModel, LocationLabel: shared.LocationLabel,
            StartedAt: shared.StartedAt, EndedAt: shared.EndedAt,
            ReadingCount: shared.ReadingCount, MarkerCount: shared.MarkerCount,
            DocumentUploadFileId: Guid.Empty, RecordedByAppUserId: null, RecordedByName: null,
            DateCreated: shared.StartedAt,
            Files: shared.Files
                .Select(f => new FieldSessionFileSummary(f.Id, f.RelativePath, f.FileSize, Sha256: null,
                                                         DigestMatched: true, DateCreated: shared.StartedAt))
                .ToList());
        if (_timeline is null) _refusal = "This session's readings cannot be shown through a shared link.";
    }

    private async Task LoadPublicAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        var summary = AdminClient.GetPublicFieldSessionSummaryAsync(SessionId);
        var timeline = AdminClient.GetPublicFieldSessionTimelineAsync(SessionId);
        var findings = AdminClient.GetPublicSessionFindingsAsync(SessionId);
        _public = await summary;
        _timeline = await timeline;
        _loading = false;

        if (_public is null)
        {
            // One answer for "no such session" and "not published": the archive never says which.
            _refusal = "This session isn't in the archive.";
            return;
        }
        _session = new FieldSessionSummaryRecord(
            Id: _public.Id, InvestigationId: null, DeviceSessionId: Guid.Empty,
            DeviceModel: _public.DeviceModel, LocationLabel: _public.LocationLabel,
            StartedAt: _public.StartedAt, EndedAt: _public.EndedAt,
            ReadingCount: _timeline?.Readings.T.Length ?? 0, MarkerCount: _timeline?.Markers.Count ?? 0,
            DocumentUploadFileId: Guid.Empty, RecordedByAppUserId: null, RecordedByName: _public.RecordedBy,
            DateCreated: _public.StartedAt,
            Files: _public.Files
                .Select(f => new FieldSessionFileSummary(f.Id, f.RelativePath, 0, Sha256: null,
                                                         DigestMatched: true, DateCreated: _public.StartedAt))
                .ToList());
        if (_timeline is null) _refusal = "This session's readings couldn't be read.";
        else _timeline = WithFindings(_timeline, _findings = await findings);
    }

    // ── The engine ────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_timeline is null || _session is null || _root.Context is null) return;
        if (_starting) return;
        try
        {
            if (!_started)
            {
                _starting = true;
                var root = _root;
                var timeline = _timeline;
                _engine ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Ben.Web.Website.Library/js/fieldKitPlayer.js");
                _self ??= DotNetObjectReference.Create(this);
                var urls = _session.Files.ToDictionary(f => f.Id.ToString(), f => FileUrl(f.Id));
                await _engine.InvokeVoidAsync("init", root, _self,
                    JsonSerializer.Serialize(timeline, TimelineJson), new { urls });
                _starting = false;
                if (!ReferenceEquals(timeline, _timeline))
                {
                    // Another session was asked for while this one started: the element it started
                    // on is gone. Stop it; the next render starts the right one.
                    try { await _engine.InvokeVoidAsync("dispose", root); } catch (JSException) { }
                    StateHasChanged();
                    return;
                }
                _started = true;
                return;
            }

            // Rare: a recording that would not play, a renewed link. Elements may have changed.
            if (_justRenewed.Count > 0)
            {
                var renewed = _justRenewed.ToList();
                _justRenewed.Clear();
                foreach (var id in renewed)
                    await _engine!.InvokeVoidAsync("mediaRenewed", _root, id.ToString(), FileUrl(id));
            }
            else
            {
                await _engine!.InvokeVoidAsync("rebind", _root);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or TaskCanceledException)
        {
            // The page went away mid-call; there is nothing left to drive.
            _starting = false;
        }
        catch (JSException ex)
        {
            // A fault in the player's script is said on the page with a way to try again. Left to
            // escape, it ended the whole connection and the page stopped answering anything.
            _starting = false;
            _started = false;
            Logger.LogWarning(ex, "The session player's script failed for session {SessionId}", SessionId);
            _session = null;
            _timeline = null;
            _refusal = "The player couldn't start. Try again, or reload the page.";
            StateHasChanged();
        }
    }

    /// <summary>
    /// A recording failed in the browser (10/28/2026). One that had already loaded, or failed on the
    /// network, is given a fresh link and tried again — up to three times, a little longer apart
    /// each time, on a share link and the public archive too — and the engine plays on once it
    /// loads. One that never loaded and that the browser calls undecodable is tried once more, in
    /// case the link was stale, and then said to be a file this browser can't play.
    /// </summary>
    /// <remarks>
    /// Before, one renewal was all a recording got, only for a signed-in viewer, and a second
    /// hiccup on a long night — or the first on a shared link — marked a perfectly good file
    /// "won't play in this browser" until the page was reloaded.
    /// </remarks>
    [JSInvokable]
    public Task OnMediaFailed(string fileId, int errorCode, bool decodedBefore)
    {
        if (!Guid.TryParse(fileId, out var id)) return Task.CompletedTask;
        var attempt = _attempts.GetValueOrDefault(id) + 1;
        _attempts[id] = attempt;

        // MediaError: 1 aborted, 2 network, 3 decode, 4 not supported (a refused link reads as 4).
        var network = decodedBefore || errorCode is 1 or 2;
        if (attempt <= (network ? RetryDelays.Length : 1))
        {
            _mediaNotice = "A recording's connection dropped. Trying it again…";
            _ = RetryAsync(id, RetryDelays[Math.Min(attempt, RetryDelays.Length) - 1]);
        }
        else if (network)
        {
            _unreachable.Add(id);
            _mediaNotice = "A recording couldn't be reached. Reload the page to try again, or download it below.";
        }
        else
        {
            _undecodable.Add(id);
            _mediaNotice = null;
        }
        return InvokeAsync(StateHasChanged);
    }

    private static readonly TimeSpan[] RetryDelays =
        [TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(8)];

    private async Task RetryAsync(Guid id, TimeSpan after)
    {
        try { await Task.Delay(after); } catch (TaskCanceledException) { return; }
        if (!_started) return;
        if (!Anonymous) MediaUrls.RenewFieldSessionFile(SessionId, id);
        _linkGeneration[id] = _linkGeneration.GetValueOrDefault(id) + 1;
        _justRenewed.Add(id);
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>A recording given a fresh link has loaded again.</summary>
    [JSInvokable]
    public Task OnMediaRecovered(string fileId)
    {
        if (!Guid.TryParse(fileId, out var id)) return Task.CompletedTask;
        _attempts.Remove(id);
        _mediaNotice = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task StopEngineAsync()
    {
        if (!_started || _engine is null) return;
        _started = false;
        try { await _engine.InvokeVoidAsync("dispose", _root); }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        TimeView.Changed -= RedrawForClock;
        await StopEngineAsync();
        try { if (_engine is not null) await _engine.DisposeAsync(); }
        catch (Exception gone) when (gone is JSDisconnectedException or OperationCanceledException) { }
        _self?.Dispose();
    }

    // ── What the page says ────────────────────────────────────────────────────

    private string FileUrl(Guid fileId)
    {
        var url = Public
            ? AdminClient.GetArchiveMediaUrl(SessionId, fileId)
            : Shared
                ? MediaUrls.SharedFieldSessionFile(ShareToken!, fileId)
                : MediaUrls.FieldSessionFile(SessionId, fileId);
        return _linkGeneration.TryGetValue(fileId, out var generation)
            ? $"{url}{(url.Contains('?') ? '&' : '?')}r={generation}"
            : url;
    }

    private bool HasStage => _session?.Files.Any(f => IsAudio(f.RelativePath) || IsVideo(f.RelativePath) || IsImage(f.RelativePath)) == true;

    private (double Lat, double Lon)? FirstFix
    {
        get
        {
            var r = _timeline!.Readings;
            for (var i = 0; i < r.Lat.Length; i++)
                if (r.Lat[i] is { } lat && r.Lon[i] is { } lon) return (lat, lon);
            return null;
        }
    }

    private string ChartHeading => (_timeline!.Trace.Magnetic.Count > 0, _timeline.Trace.Sound.Count > 0) switch
    {
        (true, true) => "Magnetic field and sound over the session",
        (true, false) => "Magnetic field over the session",
        (false, true) => "Sound over the session",
        _ => "Readings over the session",
    };

    /// <summary>
    /// The zone the page's clock reads on: where the session was recorded, unless the reader has
    /// chosen their own time (the site's Local time / My time switch, 10/28/2026). A session whose
    /// document names no zone reads on the reader's.
    /// </summary>
    private TimeZoneInfo Clock => _timeline?.TimeZoneId is { } recordedIn && !TimeView.InMyTime
        ? Ben.Data.Common.Helpers.Zones.Find(recordedIn)
        : UserState.ViewerTimeZone;

    private string ClockAt(long ms)
        => Ben.Data.Common.Helpers.Zones.ToZone(_timeline!.StartUtc.AddMilliseconds(ms), Clock).ToDisplayTimeWithSeconds();

    /// <summary>A moment as a date and time, with the zone's letters: "10/23/2026 7:48 AM CDT".</summary>
    private string Moment(DateTime utc)
    {
        utc = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        return $"{Ben.Data.Common.Helpers.Zones.ToZone(utc, Clock).ToDisplayDateTime()} {Ben.Data.Common.Helpers.Zones.Abbreviation(Clock, utc)}";
    }

    private bool NoBase => _timeline is { FallbackEmfBase: null } t && t.Readings.Emf.Any(e => e is not null);

    private IReadOnlyList<TimelineMissing> Missing => _timeline?.Missing ?? [];

    private static string MissingSentence(TimelineMissing gone) => gone.Kind switch
    {
        "audio" => $"The phone was recording sound here from {Elapsed(gone.T)}, but the sound file wasn't in what it sent.",
        "video" => $"A video ending at {Elapsed(gone.T)} was noted, but the file wasn't in what was sent.",
        _ => $"A photo taken at {Elapsed(gone.T)} wasn't in what was sent.",
    };

    private const string EnhancedKind = "enhanced";
    private const string EvpKind = "evp";

    /// <summary>
    /// The timeline with what was found laid on it: each EVP as a mark at its moment, each enhanced
    /// clip as a recording of its own at its moment, so the engine can play it in the original's
    /// place. Only where the recording's own start is known; the rest are listed, not placed.
    /// </summary>
    private static SessionTimeline WithFindings(SessionTimeline timeline, SessionFindings? findings)
    {
        if (findings is null || (findings.Clips.Count == 0 && findings.Evps.Count == 0)) return timeline;
        long? StartOf(string path) => timeline.Clips
            .FirstOrDefault(c => c.Kind is "audio" or "video" && string.Equals(c.Path, path, StringComparison.OrdinalIgnoreCase))?.StartMs;

        var marks = findings.Evps
            .Where(e => StartOf(e.SourceClipPath) is not null)
            .Select(e => new TimelineMarker(StartOf(e.SourceClipPath)!.Value + e.RecordingOffsetMs, EvpKind, "EVP",
                Automatic: false, Note: e.Heard, Room: null, FieldMilligauss: null));
        var enhanced = findings.Clips
            .Where(c => c.Enhanced && c.RecordingOffsetMs is not null && c.DurationMs is > 0 && StartOf(c.SourceClipPath) is not null)
            .Select(c => new TimelineClip(c.FileId, $"Enhanced · {c.FileName}", EnhancedKind,
                StartOf(c.SourceClipPath)!.Value + c.RecordingOffsetMs!.Value, c.DurationMs, null));
        return timeline with
        {
            Markers = timeline.Markers.Concat(marks).OrderBy(m => m.T).ToList(),
            Clips = timeline.Clips.Concat(enhanced).ToList(),
        };
    }

    /// <summary>The kept EVP behind an EVP mark.</summary>
    private SessionFindingEvp? EvpAt(TimelineMarker marker)
        => _findings?.Evps.FirstOrDefault(e => e.Heard == marker.Note
            && _timeline!.Clips.FirstOrDefault(c => c.Kind is "audio" or "video"
                   && string.Equals(c.Path, e.SourceClipPath, StringComparison.OrdinalIgnoreCase))?.StartMs + e.RecordingOffsetMs == marker.T);

    private IEnumerable<SessionFindingClip> DerivedFrom(string recordingPath)
        => _findings?.Clips.Where(c => string.Equals(c.SourceClipPath, recordingPath, StringComparison.OrdinalIgnoreCase)) ?? [];

    /// <summary>A clip made from a recording: its own file, not the session's.</summary>
    private string DerivedUrl(Guid fileId)
    {
        var url = Public ? AdminClient.GetPublicFindingMediaUrl(SessionId, fileId) : MediaUrls.Download(fileId);
        return _linkGeneration.TryGetValue(fileId, out var generation)
            ? $"{url}{(url.Contains('?') ? '&' : '?')}r={generation}"
            : url;
    }

    private string CertificateHref(Guid fileId)
        => Public && _public is { } published
            ? $"/places/{published.PlaceId}/sessions/{SessionId}/certificates/{fileId}"
            : $"/files/{fileId}/certificate";

    private static string PhotoTitle(TimelinePhoto photo)
        => $"Photo at {Elapsed(photo.T)}{(photo.Room is { } room ? $" in the {room}" : "")} — goes to that moment and shows it full size";

    private static string Listened(long ms)
    {
        var span = TimeSpan.FromMilliseconds(Math.Max(0, ms));
        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes} min {span.Seconds} s" : $"{span.Seconds} s";
    }

    /// <summary>"Ran for 57 s · 31 readings · iPhone 15 Pro Max · battery 82% at the start".</summary>
    private string Facts()
    {
        var parts = new List<string>
        {
            $"Ran for {Ran(_timeline!.DurationMs)}",
            $"{_timeline.Readings.T.Length:N0} reading{(_timeline.Readings.T.Length == 1 ? "" : "s")}",
            Ben.Web.Website.Library.Kit.DeviceNames.Friendly(_session!.DeviceModel),
        };
        if (_timeline.BatteryAtStart is { } battery) parts.Add($"battery {battery:0}% at the start");
        return string.Join(" · ", parts);
    }

    /// <summary>"1 hr 5 min", "1 min", "57 s" — a zero part is left out ("1 min 0 s" read like a typo).</summary>
    private static string Ran(long ms)
    {
        var span = TimeSpan.FromMilliseconds(Math.Max(0, ms));
        if (span.TotalHours >= 1) return span.Minutes == 0 ? $"{(int)span.TotalHours} hr" : $"{(int)span.TotalHours} hr {span.Minutes} min";
        if (span.TotalMinutes >= 1) return span.Seconds == 0 ? $"{(int)span.TotalMinutes} min" : $"{(int)span.TotalMinutes} min {span.Seconds} s";
        return $"{span.Seconds} s";
    }

    /// <summary>Where the session belongs, as a line with links, or null when it is the person's own.</summary>
    private RenderFragment? BelongsSentence()
    {
        if (Anonymous || _session?.BelongsTo is not { } b) return null;
        return @<span>
            @if (b.InvestigationTitle is { } investigation)
            {
                <text>Sent to the investigation “@investigation”</text>
            }
            else if (b.EventTitle is { } eventTitle)
            {
                <text>Sent to @(b.IsHostedEvent ? "" : "the tour date ")</text>
                @if (b.EventUrl is { } url)
                {
                    <a href="@url" data-testid="session-event">@eventTitle</a>
                }
                else
                {
                    <span data-testid="session-event">@eventTitle</span>
                }
                @if (b.EventStartsUtc is { } starts)
                {
                    <text>, @starts.ToDisplayDate()</text>
                }
            }
            @if (b.GroupName is { } group)
            {
                <text> · </text>
                @if (b.GroupUrlName is { } groupUrl)
                {
                    <a href="@($"/o/{groupUrl}")" data-testid="session-group">@group</a>
                }
                else
                {
                    <span data-testid="session-group">@group</span>
                }
            }
            @if (_session.ShownWithEventResultsAtUtc is not null)
            {
                <text> · shown with the event's results</text>
            }
            @if (b.PlaceName is { } place && b.PlaceId is { } placeId)
            {
                <text> · @(_session.PublishedAtUtc is not null ? "in the field archive for " : "at ")</text>
                <a href="@($"/places/{placeId}")" data-testid="session-place">@place</a>
            }
            @if (b.StartedByLaunch)
            {
                <text> · started with the group's launch</text>
            }
        </span>;
    }

    private static string Elapsed(long ms)
    {
        var span = TimeSpan.FromMilliseconds(Math.Max(0, ms));
        return $"{(int)span.TotalHours:00}:{span.Minutes:00}:{span.Seconds:00}";
    }

    /// <summary>The field at a mark, said the way the readout says it: from base, or absolute and labelled.</summary>
    private string? MarkerFieldText(TimelineMarker marker)
        => marker.FieldMilligauss is not { } value ? null
         : _timeline!.Trace.MagneticFromBase ? value.ToString("+0;-0;0") + " mG"
         : value.ToString("0") + " mG abs";

    private string AwaySentence()
    {
        var away = _timeline!.Away;
        var total = TimeSpan.FromMilliseconds(away.Sum(s => s.ToMs - s.FromMs));
        var howLong = total.TotalHours >= 1 ? $"{(int)total.TotalHours} hr {total.Minutes} min"
                    : total.TotalMinutes >= 1 ? $"{(int)total.TotalMinutes} min {total.Seconds} sec"
                    : $"{total.Seconds} sec";
        var note = away.Select(s => s.Note).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n))
                   ?? "The app was put away here.";
        var times = away.Count == 1 ? "" : $" ({away.Count} times)";
        return $"{note} Away for {howLong}{times}.";
    }

    private static bool IsAudio(string path) =>
        path.EndsWith(".m4a", StringComparison.OrdinalIgnoreCase)
        || path.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase)
        || path.EndsWith(".wav", StringComparison.OrdinalIgnoreCase);

    private static bool IsVideo(string path) =>
        path.EndsWith(".mov", StringComparison.OrdinalIgnoreCase)
        || path.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase);

    private static bool IsImage(string path) =>
        path.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase)
        || path.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase)
        || path.EndsWith(".png", StringComparison.OrdinalIgnoreCase)
        || path.EndsWith(".heic", StringComparison.OrdinalIgnoreCase);
}
