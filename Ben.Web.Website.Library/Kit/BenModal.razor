@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Replacement for TelerikWindow (~90 call sites), on Bootstrap's modal markup.

    Blazor owns visibility: the `show`/`d-block` classes and the backdrop are rendered from a C#
    field, and there is no data-bs-toggle anywhere. That is deliberate, and it is the whole point
    of this component — this codebase has a test banning TelerikDialog because inputs inside it
    stopped binding, and handing a modal's subtree to Bootstrap's own JS would reintroduce exactly
    that class of bug. Bootstrap's Modal plugin moves and re-parents nodes; Blazor's diffing then
    patches a tree that no longer matches, and edits inside the dialog are silently lost.

    JS is used only for the two things the DOM genuinely owns: locking body scroll while a modal
    is open, and moving focus into the dialog so Escape and tabbing work.
*@

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog"
         aria-modal="true" aria-label="@Title"
         @ref="_dialog" @onkeydown="OnKeyDown">
        <div class="modal-dialog @SizeClass @(Centered ? "modal-dialog-centered" : null) @(Scrollable ? "modal-dialog-scrollable" : null)">
            <div class="modal-content">

                @if (!string.IsNullOrWhiteSpace(Title) || HeaderContent is not null || ShowCloseButton)
                {
                    <div class="modal-header">
                        @if (HeaderContent is not null)
                        {
                            @HeaderContent
                        }
                        else
                        {
                            <h5 class="modal-title">@Title</h5>
                        }
                        @if (ShowCloseButton)
                        {
                            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAsync"></button>
                        }
                    </div>
                }

                <div class="modal-body">
                    @ChildContent
                </div>

                @if (FooterContent is not null)
                {
                    @* Footer buttons render inside the dialog's own content, never in a separate
                       actions slot — the original host learned this the hard way when Telerik's
                       WindowActions rendered detached from its window and pushed buttons
                       off-screen. *@
                    <div class="modal-footer">
                        @FooterContent
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show" @onclick="OnBackdropClick"></div>
}

@code {
    /// <summary>Whether the dialog is shown. Two-way bindable: <c>@bind-Visible</c>.</summary>
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>"sm" | "lg" | "xl" | "fullscreen". Omit for Bootstrap's default width.</summary>
    [Parameter] public string? Size { get; set; }

    [Parameter] public bool Centered { get; set; } = true;

    /// <summary>Scrolls the body rather than the page when content is tall.</summary>
    [Parameter] public bool Scrollable { get; set; } = true;

    /// <summary>When true, clicking the backdrop or pressing Escape will not close the dialog —
    /// for destructive confirmations and anything mid-submit.</summary>
    [Parameter] public bool Static { get; set; }

    [Parameter] public bool ShowCloseButton { get; set; } = true;

    /// <summary>Raised after the dialog closes by any route (button, backdrop, Escape).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _wasVisible;

    private string? SizeClass => Size switch
    {
        "sm"         => "modal-sm",
        "lg"         => "modal-lg",
        "xl"         => "modal-xl",
        "fullscreen" => "modal-fullscreen",
        _            => null,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible == _wasVisible) return;
        _wasVisible = Visible;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Ben.Web.Website.Library/Kit/BenModal.razor.js");

            if (Visible) await _module.InvokeVoidAsync("open", _dialog);
            else         await _module.InvokeVoidAsync("close");
        }
        catch (JSDisconnectedException) { /* circuit gone — nothing to unlock */ }
        catch (InvalidOperationException) { /* prerender: no interop yet */ }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (Static || e.Key != "Escape") return;
        await CloseAsync();
    }

    private async Task OnBackdropClick()
    {
        if (Static) return;
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (VisibleChanged.HasDelegate) await VisibleChanged.InvokeAsync(false);
        else Visible = false;

        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                // A modal disposed while open leaves the body scroll-locked otherwise.
                await _module.InvokeVoidAsync("close");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }
}
