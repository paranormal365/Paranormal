@using Ben.Service.Models.Entities
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@if (_loading)
{
    <BenLoaderOverlay Visible="true" Text="Loading roles…" />
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else
{
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Named Roles</h5>
        <button type="button" class="btn btn-primary" @onclick="ShowCreateForm"><BenIcon Name="plus" Class="me-1" />
            Add Role
        </button>
    </div>

    @if (_showCreateForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h6 class="card-title">New Role</h6>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <label class="form-label" for="orgrolesmanager-name-32a3">Name <span class="text-danger">*</span></label>
                        <input id="orgrolesmanager-name-32a3" type="text" class="form-control" @bind="_createName" @bind:event="oninput" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="orgrolesmanager-description-a64a">Description</label>
                        <input id="orgrolesmanager-description-a64a" type="text" class="form-control" @bind="_createDescription" @bind:event="oninput" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label" for="orgrolesmanager-sort-order-940e">Sort Order</label>
                        <input id="orgrolesmanager-sort-order-940e" type="number" class="form-control" min="0" max="100" step="1" @bind="_createSortOrder" @bind:event="oninput" />
                    </div>
                    <div class="col-sm-3 d-flex align-items-end">
                        <label class="form-label me-2">Active</label>
                        <div class="form-check form-switch"><input type="checkbox" class="form-check-input" @bind="_createIsActive" /></div>
                    </div>
                </div>
                @if (_createError is not null)
                {
                    <div class="text-danger small mt-2">@_createError</div>
                }
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-primary" @onclick="CreateRoleAsync" disabled="@(!(!_isSaving))">
                        @(_isSaving ? "Saving…" : "Create")
                    </button>
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="CancelCreate">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }

    <TelerikGrid Data="@_roles" Pageable="false" Sortable="true" Class="mb-3">
        <GridColumns>
            <GridColumn Field="@nameof(OrganizationRoleRecord.Name)" Title="Name" />
            <GridColumn Field="@nameof(OrganizationRoleRecord.Description)" Title="Description" />
            <GridColumn Field="@nameof(OrganizationRoleRecord.IsActive)" Title="Active" Width="80px">
                <Template>
                    @{
                        var row = (OrganizationRoleRecord)context;
                        <span class="badge @(row.IsActive ? "bg-success" : "bg-secondary")">
                            @(row.IsActive ? "Yes" : "No")
                        </span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(OrganizationRoleRecord.SortOrder)" Title="Order" Width="80px" />
            <GridColumn Title="Actions" Width="160px">
                <Template>
                    @{
                        var row = (OrganizationRoleRecord)context;
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => EditRole(row))"><BenIcon Name="edit-2" Class="me-1" />
                            Edit
                        </button>
                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-danger" : "btn-outline-danger") btn-sm ms-1" @onclick="@(() => ConfirmDelete(row))"><BenIcon Name="trash-2" Class="me-1" />
                            Delete
                        </button>
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>

    @if (_editingRole is not null)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title">Edit Role: @_editingRole.Name</h6>
                <OrgRoleEditor OrgId="@OrgId" RoleId="@_editingRole.Id" OnSaved="OnRoleSaved" OnCancelled="CancelEdit" />
            </div>
        </div>
    }
}

<BenModal @bind-Visible="_showDeleteConfirm" Title="Delete Role">
    <ChildContent>
        <p>Delete role <strong>@(_roleToDelete?.Name)</strong>? This will remove all permissions and member assignments for this role.</p>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-danger" @onclick="DeleteRoleAsync" disabled="@(!(!_isSaving))">
                @(_isSaving ? "Deleting…" : "Delete")
            </button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showDeleteConfirm = false)">
                Cancel
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }

    private IReadOnlyList<OrganizationRoleRecord> _roles = [];
    private bool    _loading       = true;
    private bool    _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    // Create form state
    private bool    _showCreateForm;
    private string  _createName        = string.Empty;
    private string? _createDescription;
    private bool    _createIsActive    = true;
    private int     _createSortOrder;
    private string? _createError;

    // Edit state
    private OrganizationRoleRecord? _editingRole;

    // Delete confirm state
    private bool                    _showDeleteConfirm;
    private OrganizationRoleRecord? _roleToDelete;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            _roles = await AdminClient.GetOrgRolesAsync(OrgId);
        }
        catch
        {
            _errorMessage = "Failed to load roles.";
        }
        _loading = false;
        StateHasChanged();
    }

    private void ShowCreateForm()
    {
        _createName        = string.Empty;
        _createDescription = null;
        _createIsActive    = true;
        _createSortOrder   = 0;
        _createError       = null;
        _showCreateForm    = true;
        _editingRole       = null;
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
        _createError    = null;
    }

    private async Task CreateRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(_createName)) { _createError = "Name is required."; return; }

        _isSaving    = true;
        _createError = null;
        StateHasChanged();

        var result = await AdminClient.CreateOrgRoleAsync(OrgId,
            new CreateOrgRoleRequest(_createName.Trim(), _createDescription?.Trim(), _createIsActive, _createSortOrder));

        _isSaving = false;
        if (result is not null)
        {
            _showCreateForm  = false;
            _successMessage  = $"Role '{result.Name}' created.";
            await LoadAsync();
        }
        else
        {
            _createError = "Failed to create role.";
        }
    }

    private void EditRole(OrganizationRoleRecord role)
    {
        _showCreateForm = false;
        _editingRole    = role;
        _successMessage = null;
    }

    private void CancelEdit()
    {
        _editingRole = null;
    }

    private async Task OnRoleSaved()
    {
        _editingRole    = null;
        _successMessage = "Role saved.";
        await LoadAsync();
    }

    private void ConfirmDelete(OrganizationRoleRecord role)
    {
        _roleToDelete      = role;
        _showDeleteConfirm = true;
    }

    private async Task DeleteRoleAsync()
    {
        if (_roleToDelete is null) return;
        _isSaving = true;
        StateHasChanged();

        var ok = await AdminClient.DeleteOrgRoleAsync(OrgId, _roleToDelete.Id);
        _isSaving          = false;
        _showDeleteConfirm = false;

        if (ok)
        {
            _successMessage = $"Role '{_roleToDelete.Name}' deleted.";
            _roleToDelete   = null;
            await LoadAsync();
        }
        else
        {
            _errorMessage = "Failed to delete role.";
        }
    }
}
