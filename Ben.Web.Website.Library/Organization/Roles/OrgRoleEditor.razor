@using Ben.Service.Models.Entities
@using Ben.Data.Common.Enums
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@if (_loading)
{
    <BenLoaderOverlay Visible="true" Text="Loading role…" />
}
else if (_errorMessage is not null && _role is null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_role is not null)
{
    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    @* ── Section 1: Role Details ──────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Role Details</h6>
            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" for="orgroleeditor-name-07d6">Name <span class="text-danger">*</span></label>
                    <input id="orgroleeditor-name-07d6" type="text" class="form-control" @bind="_editName" @bind:event="oninput" />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" for="orgroleeditor-description-d462">Description</label>
                    <textarea id="orgroleeditor-description-d462" class="form-control" rows="2" @bind="_editDescription"></textarea>
                </div>
                <div class="col-sm-3">
                    <label class="form-label fw-semibold" for="orgroleeditor-sort-order-c8fb">Sort Order</label>
                    <input id="orgroleeditor-sort-order-c8fb" type="number" class="form-control" min="0" max="100" step="1" @bind="_editSortOrder" @bind:event="oninput" />
                </div>
                <div class="col-sm-3 d-flex flex-column">
                    <label class="form-label fw-semibold">Active</label>
                    <div class="form-check form-switch"><input type="checkbox" class="form-check-input" @bind="_editIsActive" /></div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="btn btn-primary" @onclick="SaveDetailsAsync" disabled="@(!(!_isSaving))"><BenIcon Name="save" Class="me-1" />
                    @(_isSaving ? "Saving…" : "Save Details")
                </button>
                @if (OnCancelled.HasDelegate)
                {
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => OnCancelled.InvokeAsync())">
                        Cancel
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── Section 2: Permissions ───────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Permissions</h6>
            <p class="text-secondary small">Toggle Create (C), Read (R), Update (U), Delete (D) for each resource.</p>

            @* Item 156 Phase E: sections whose AREA the group's plan does not include render
               grayed-but-remembered (decision D4) — the stored values stay visible, the toggles
               refuse, and this banner says why and what changes it. The server refuses changes
               to these sections regardless, so the graying is honesty, not the lock itself. *@
            @if (_excludedAreas.Count > 0)
            {
                <div class="alert alert-info py-2 small" id="role-areas-note">
                    <strong>@ExcludedAreaNames</strong> permissions come with a higher plan@(_tierName is null ? "" : $" than {_tierName}"),
                    so they are shown grayed out. Your settings are kept and apply again the
                    moment the plan includes them. <a href="/pricing">See what each plan includes.</a>
                    @if (_inactiveGrantCount > 0)
                    {
                        <span class="badge bg-secondary ms-1">@_inactiveGrantCount granted permission@(_inactiveGrantCount == 1 ? "" : "s") currently inactive</span>
                    }
                </div>
            }
            <table class="table table-sm table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>What it covers</th>
                        <th class="text-center" style="width:64px">Add</th>
                        <th class="text-center" style="width:64px">See</th>
                        <th class="text-center" style="width:64px">Change</th>
                        <th class="text-center" style="width:64px">Remove</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var section in Sections)
                    {
                        var sectionExcluded = IsExcluded(section.Table);
                        <tr class="@(sectionExcluded ? "opacity-50" : "")">
                            <td class="@(section.ParentTable is not null ? "ps-4" : "")">
                                @section.DisplayName
                                <div class="text-secondary small">@section.Description</div>
                            </td>
                            @foreach (var action in new[] { OrganizationSecurityAction.Create, OrganizationSecurityAction.Read, OrganizationSecurityAction.Update, OrganizationSecurityAction.Delete })
                            {
                                var tbl = section.Table;
                                var act = action;
                                var isSet = (_permissionMap.TryGetValue(tbl, out var current) && (current & act) != OrganizationSecurityAction.None);
                                <td class="text-center">
                                    @* aria-pressed carries the on/off state for anyone not seeing the fill. *@
                                    <button type="button"
                                            class="btn btn-sm @(isSet ? "btn-primary" : "btn-outline-secondary")"
                                            aria-pressed="@isSet.ToString().ToLowerInvariant()"
                                            disabled="@sectionExcluded"
                                            title="@(sectionExcluded ? "Included with a higher plan — see Pricing" : null)"
                                            @onclick="@(() => TogglePermission(tbl, act, !isSet))">
                                        @(action == OrganizationSecurityAction.Create ? "C" :
                                          action == OrganizationSecurityAction.Read   ? "R" :
                                          action == OrganizationSecurityAction.Update ? "U" : "D")
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-primary" @onclick="SavePermissionsAsync" disabled="@(!(!_isSavingPerms))"><BenIcon Name="save" Class="me-1" />
                @(_isSavingPerms ? "Saving…" : "Save Permissions")
            </button>
        </div>
    </div>

    @* ── Section 3: Members ───────────────────────────────────────────── *@
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-title">Members</h6>

            <TelerikGrid Data="@_members" Pageable="false" Class="mb-3">
                <GridColumns>
                    <GridColumn Title="Member">
                        <Template>
                            @{
                                var row = (OrganizationRoleMembershipRecord)context;
                                var info = _allOrgMembers.FirstOrDefault(m => m.MembershipId == row.OrganizationUserMembershipId);
                                <span>@(info?.Label() ?? row.OrganizationUserMembershipId.ToString())</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Title="Added" Width="160px">
                        <Template>
                            @{
                                var row = (OrganizationRoleMembershipRecord)context;
                                <span>@row.DateCreated.ToDisplayDate()</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Title="" Width="90px">
                        <Template>
                            @{
                                var row = (OrganizationRoleMembershipRecord)context;
                                <BenGridAction Icon="user-x" Label="Remove" Tone="GridActionTone.Danger" OnClick="@(() => RemoveMemberAsync(row))" />
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>

            @* Add member ─────────────────── *@
            @if (_availableMembers.Count > 0)
            {
                <div class="d-flex gap-2 align-items-end">
                    <div>
                        <label class="form-label">Add Member</label>
                        <TelerikDropDownList Data="@_availableMembers" @bind-Value="_selectedMembershipId" TextField="@nameof(OrgMembershipItem.MembershipId)" ValueField="@nameof(OrgMembershipItem.MembershipId)" Width="260px">
                            <ItemTemplate>
                                @{
                                    var item = (OrgMembershipItem)context;
                                    @item.Label()
                                }
                            </ItemTemplate>
                            <ValueTemplate>
                                @{
                                    var item = (OrgMembershipItem)context;
                                    @item.Label()
                                }
                            </ValueTemplate>
                        </TelerikDropDownList>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="AddMemberAsync" disabled="@(!(_selectedMembershipId != Guid.Empty && !_isSavingMember))">
                        @(_isSavingMember ? "Adding…" : "Add")
                    </button>
                </div>
            }
            else if (_membersResult.Failed)
            {
                @* "Nobody holds this role" is what an administrator grants access on. *@
                <BenListState TItem="OrganizationRoleMembershipRecord" Result="@_membersResult" />
            }
            else if (_members.Count == 0)
            {
                <div class="text-secondary small">All org members are already assigned to this role.</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid OrgId    { get; set; }

    private IReadOnlySet<Ben.Data.Common.Enums.OrganizationPermissionArea> _includedAreas =
        Enum.GetValues<Ben.Data.Common.Enums.OrganizationPermissionArea>().ToHashSet();
    private List<Ben.Data.Common.Enums.OrganizationPermissionArea> _excludedAreas = [];
    private string? _tierName;
    private int _inactiveGrantCount;

    private bool IsExcluded(OrganizationSecurityTable table)
        => Ben.Data.Common.Constants.PermissionAreas.AreaFor(table) is { } area
        && !_includedAreas.Contains(area);

    private string ExcludedAreaNames => string.Join(", ", _excludedAreas);

    private void RecomputeAreaState()
    {
        _excludedAreas = Enum.GetValues<Ben.Data.Common.Enums.OrganizationPermissionArea>()
            .Where(a => !_includedAreas.Contains(a)).ToList();
        _inactiveGrantCount = _permissionMap.Count(kv =>
            IsExcluded(kv.Key) && kv.Value != OrganizationSecurityAction.None);
    }
    [Parameter] public Guid RoleId   { get; set; }
    [Parameter] public EventCallback OnSaved    { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    // Item 170: this list offers ONLY tables an org-reachable write path actually consults.
    // Ten rows were removed 2026-08-23 — the five *Type lookup tables (site-wide labels, no
    // OrganizationId column, written only by SuperAdmin admin screens) and five org tables
    // whose CRUD is admin-only today (Emails, Phones, Links, Notes, Address Search). A toggle
    // that grants nothing tells a role-builder something untrue. RolePermissionCoverageTests
    // pins both directions; restore a row only together with the write path that reads it.
    private static readonly IReadOnlyList<PermissionSection> Sections =
    [
        new("Group details",           OrganizationSecurityTable.Organization,            null,
            "The group's name, description and general details."),
        new("Map and directions",      OrganizationSecurityTable.OrganizationSettings,    OrganizationSecurityTable.Organization,
            "Whether the group's address map and directions link are shown."),
        new("Addresses",               OrganizationSecurityTable.OrganizationAddress,     null,
            "The group's street addresses."),
        new("Who sees an address",     OrganizationSecurityTable.OrganizationAddressMemberAccess, OrganizationSecurityTable.OrganizationAddress,
            "Which members can see an address that is shown to chosen members only."),
        new("Website pages",           OrganizationSecurityTable.OrganizationPage,        null,
            "The pages of the group's public website."),
        new("Page sections",           OrganizationSecurityTable.CmsSection,              OrganizationSecurityTable.OrganizationPage,
            "The sections on each website page."),
        new("Member groups",           OrganizationSecurityTable.OrgMemberGroup,          null,
            "Smaller groups of members inside the group."),
        new("Membership applications", OrganizationSecurityTable.MembershipRequests,      null,
            "Applications to join the group."),
        new("Files",                   OrganizationSecurityTable.OrganizationFiles,       null,
            "The group's files."),
        new("Investigations",          OrganizationSecurityTable.Investigation,           null,
            "The group's investigations. Case managers, visit leads, owners and administrators can change their own whatever this says."),
        new("Cases",                   OrganizationSecurityTable.Case,                    null,
            "The group's cases: the case record, its notes, files and timeline."),
        new("Client requests",         OrganizationSecurityTable.ClientRequest,           null,
            "Requests from people asking for an investigation: reviewing, accepting, declining and replying."),
        new("Calendar",                OrganizationSecurityTable.OrgCalendar,             null,
            "The group calendar: its events and event types."),
        new("Equipment",               OrganizationSecurityTable.Equipment,               null,
            "The group's own equipment, its photos and service history. Every member can already see it."),
        new("Equipment checkouts",     OrganizationSecurityTable.EquipmentCheckout,       OrganizationSecurityTable.Equipment,
            "Checkout requests, and handing equipment out and back in."),
        new("Hosted events",           OrganizationSecurityTable.HostedEvent,             null,
            "The group's hosted events: dates, description, venue and whether each is published."),
        new("Event bookings",          OrganizationSecurityTable.EventBooking,            OrganizationSecurityTable.HostedEvent,
            "Bookings: confirming a party into a room, turning one down, changing what they booked."),
        new("Event program",         OrganizationSecurityTable.EventSession,            OrganizationSecurityTable.HostedEvent,
            "The sessions inside an event: their times, rooms, leaders and how many people each can take."),
        new("Event files",             OrganizationSecurityTable.EventFile,               OrganizationSecurityTable.HostedEvent,
            "An event's files, and whether each is for the staff, the guests or anybody."),
        new("Event door",              OrganizationSecurityTable.EventCheckIn,            OrganizationSecurityTable.HostedEvent,
            "Checking guests in and out at the door."),
        new("Event checklists",        OrganizationSecurityTable.EventChecklist,          OrganizationSecurityTable.HostedEvent,
            "The event's to-do lists."),
    ];

    private sealed record PermissionSection(
        string DisplayName,
        OrganizationSecurityTable Table,
        OrganizationSecurityTable? ParentTable,
        string Description);

    private OrganizationRoleRecord? _role;
    private IReadOnlyList<OrganizationRoleMembershipRecord> _members = [];
    private IReadOnlyList<OrgMembershipItem> _allOrgMembers          = [];
    private List<OrgMembershipItem>          _availableMembers       = [];

    private Dictionary<OrganizationSecurityTable, OrganizationSecurityAction> _permissionMap = new();

    private bool    _loading        = true;
    private LoadResult<OrganizationRoleMembershipRecord> _membersResult;
    private bool    _isSaving;
    private bool    _isSavingPerms;
    private bool    _isSavingMember;
    private string? _errorMessage;
    private string? _successMessage;

    // Edit fields
    private string  _editName        = string.Empty;
    private string? _editDescription;
    private bool    _editIsActive    = true;
    private int     _editSortOrder;

    // Add member
    private Guid _selectedMembershipId = Guid.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            var roleTask   = AdminClient.GetOrgRoleAsync(OrgId, RoleId);
            var permsTask  = AdminClient.GetOrgRolePermissionsAsync(OrgId, RoleId);
            var membersTask = AdminClient.GetOrgRoleMembersAsync(OrgId, RoleId);
            var orgMembersTask = AdminClient.GetOrganizationMembersAsync(OrgId);
            var areasTask = AdminClient.GetOrgIncludedAreasAsync(OrgId);

            await Task.WhenAll(roleTask, permsTask, membersTask, orgMembersTask, areasTask);

            _role         = roleTask.Result;
            _membersResult = membersTask.Result;
            _members       = _membersResult.Items;
            _allOrgMembers = orgMembersTask.Result.Items;

            if (_role is not null)
            {
                _editName        = _role.Name;
                _editDescription = _role.Description;
                _editIsActive    = _role.IsActive;
                _editSortOrder   = _role.SortOrder;
            }

            _permissionMap = permsTask.Result.Items
                .ToDictionary(p => p.TableName, p => p.Actions);

            // Null (fetch failed) degrades to everything-included: graying is a courtesy, and
            // the server refuses excluded-area changes regardless.
            if (areasTask.Result is { } areas)
            {
                _includedAreas = areas.Areas.ToHashSet();
                _tierName = areas.TierName;
            }
            RecomputeAreaState();

            RefreshAvailableMembers();
        }
        catch
        {
            _errorMessage = "Failed to load role data.";
        }
        _loading = false;
        StateHasChanged();
    }

    private void RefreshAvailableMembers()
    {
        var assignedIds = _members.Select(m => m.OrganizationUserMembershipId).ToHashSet();
        _availableMembers = _allOrgMembers
            .Where(m => !assignedIds.Contains(m.MembershipId))
            .ToList();
        _selectedMembershipId = _availableMembers.FirstOrDefault()?.MembershipId ?? Guid.Empty;
    }

    private void TogglePermission(OrganizationSecurityTable table, OrganizationSecurityAction action, bool value)
    {
        var current = _permissionMap.TryGetValue(table, out var existing) ? existing : OrganizationSecurityAction.None;
        if (value)
            _permissionMap[table] = current | action;
        else
        {
            var updated = current & ~action;
            if (updated == OrganizationSecurityAction.None)
                _permissionMap.Remove(table);
            else
                _permissionMap[table] = updated;
        }
    }

    private async Task SaveDetailsAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName)) { _errorMessage = "Name is required."; return; }

        _isSaving      = true;
        _errorMessage  = null;
        _successMessage = null;
        StateHasChanged();

        var (result, saveError) = await AdminClient.UpdateOrgRoleExpectingReasonAsync(OrgId, RoleId,
            new UpdateOrgRoleRequest(_editName.Trim(), _editDescription?.Trim(), _editIsActive, _editSortOrder));

        _isSaving = false;
        if (result is not null)
        {
            _role           = result;
            _successMessage = "Role details saved.";
            await OnSaved.InvokeAsync();
        }
        else
        {
            // The server's own sentence when it gave one. It refuses in words worth reading —
            // "That role does not belong to this group." — and a blanket "Failed to save role."
            // told the person none of it (2026-09-04 finding 4).
            _errorMessage = saveError ?? "Failed to save role.";
        }
    }

    private async Task SavePermissionsAsync()
    {
        _isSavingPerms = true;
        _errorMessage  = null;
        _successMessage = null;
        StateHasChanged();

        var requests = _permissionMap
            .Where(kv => kv.Value != OrganizationSecurityAction.None)
            .Select(kv => new SetRolePermissionRequest(kv.Key, kv.Value))
            .ToList();

        var ok = await AdminClient.SetOrgRolePermissionsAsync(OrgId, RoleId, requests);
        _isSavingPerms = false;
        _successMessage = ok ? "Permissions saved." : null;
        _errorMessage   = ok ? null : "Failed to save permissions.";
    }

    private async Task AddMemberAsync()
    {
        if (_selectedMembershipId == Guid.Empty) return;

        _isSavingMember = true;
        _errorMessage   = null;
        StateHasChanged();

        var (result, addError) = await AdminClient.AddOrgRoleMemberExpectingReasonAsync(OrgId, RoleId, _selectedMembershipId);
        _isSavingMember = false;

        if (result is not null)
        {
            _membersResult = await AdminClient.GetOrgRoleMembersAsync(OrgId, RoleId);
            _members       = _membersResult.Items;
            RefreshAvailableMembers();
        }
        else
        {
            _errorMessage = addError ?? "Failed to add member.";
        }
    }

    private async Task RemoveMemberAsync(OrganizationRoleMembershipRecord rm)
    {
        _errorMessage = null;
        StateHasChanged();

        var (ok, removeError) = await AdminClient.RemoveOrgRoleMemberExpectingReasonAsync(OrgId, RoleId, rm.Id);
        if (ok)
        {
            _members = (await AdminClient.GetOrgRoleMembersAsync(OrgId, RoleId)).Items;
            RefreshAvailableMembers();
        }
        else
        {
            _errorMessage = removeError ?? "Failed to remove member.";
        }
    }
}
