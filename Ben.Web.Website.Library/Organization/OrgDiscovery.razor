@page "/find"
@namespace Ben.Web.Website.Library.Organization
@using Ben.Data.Common.Enums

@inject IBenAdminClient AdminClient

<PageTitle>Find a Group — IsHaunted</PageTitle>

<div class="container-fluid px-3 py-4" style="max-width:860px; margin:auto;">

    <h1 class="mb-1">Find a Paranormal Investigation Group</h1>
    <p class="text-secondary mb-4">
        Enter your location to find groups accepting cases near you, or browse every group below.
    </p>

    @* Item 166 W3: the Featured groups slot — approved, rotating, marked Promoted. *@
    <Ben.Web.Website.Library.Shared.PromotedGroupsCard />

    @* ── Search form ──────────────────────────────────────────────────────── *@
    <div class="row g-2 mb-4 align-items-end">
        <div class="col-12 col-md-7">
            <label class="form-label" for="orgdiscovery-your-location-3e6b">Your Location</label>
            <input id="orgdiscovery-your-location-3e6b" type="text" class="form-control" placeholder="Enter city, address, or zip code" @bind="_query" @bind:event="oninput" />
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-primary" @onclick="SearchAsync" disabled="@(!(!_searching && !string.IsNullOrWhiteSpace(_query)))">
                @(_searching ? "Searching…" : "Search")
            </button>
        </div>
        @if (_searched)
        {
            <div class="col-auto">
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="ClearSearchAsync" disabled="@(!(!_searching))">Show all groups</button>
            </div>
        }
    </div>

    @if (_geocodeError is not null)
    {
        <div class="alert alert-warning mb-3">@_geocodeError</div>
    }

    @* ── Proximity results ────────────────────────────────────────────────── *@
    @if (_searched && _results.Count == 0)
    {
        <div class="alert alert-light text-muted text-center py-4">
            No organizations accepting cases were found near <strong>@_searchedQuery</strong>.
            <br /><span class="small">Try a nearby city, or browse the full list below.</span>
        </div>
    }

    @if (_withinRange.Count > 0)
    {
        <div class="d-flex align-items-baseline gap-2 mb-3">
            <span class="text-secondary">Results near <strong>@_searchedQuery</strong></span>
            <span class="badge bg-secondary">@_results.Count found</span>
        </div>
        <h5 class="text-success mb-2">Within Operating Range</h5>
        <div class="row g-3 mb-4">
            @foreach (var org in _withinRange)
            {
                <div class="col-12 col-md-6">
                    <OrgCard Name="@org.Name" UrlName="@org.UrlName"
                             AreaLabel="@org.DisplayLabel" LogoFileId="@org.ActiveLogoFileId">
                        <MetaLine>
                            <span class="text-success">✓ Within range</span>
                            <span> · @(org.DistanceFromSearchMiles.ToString("F1")) mi away</span>
                            @if (org.TakesPrivateResidenceCases)
                            {
                                <span class="badge rounded-pill bg-primary ms-1">Takes private homes</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-body-secondary text-body-emphasis ms-1">Public investigations only</span>
                            }
                        </MetaLine>
                    </OrgCard>
                </div>
            }
        </div>
    }

    @if (_outsideRange.Count > 0)
    {
        @if (_withinRange.Count == 0 && _searched)
        {
            <div class="d-flex align-items-baseline gap-2 mb-3">
                <span class="text-secondary">Results near <strong>@_searchedQuery</strong></span>
                <span class="badge bg-secondary">@_results.Count found</span>
            </div>
        }
        <h5 class="text-secondary mb-2">Outside Normal Range (still accepting)</h5>
        <div class="row g-3 mb-4">
            @foreach (var org in _outsideRange)
            {
                <div class="col-12 col-md-6">
                    <OrgCard Name="@org.Name" UrlName="@org.UrlName"
                             AreaLabel="@org.DisplayLabel" LogoFileId="@org.ActiveLogoFileId">
                        <MetaLine>
                            <span>@(org.DistanceFromSearchMiles.ToString("F1")) mi away</span>
                            <span class="text-secondary"> (range: @(org.RadiusMiles.ToString("F0")) mi)</span>
                            @if (org.TakesPrivateResidenceCases)
                            {
                                <span class="badge rounded-pill bg-primary ms-1">Takes private homes</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-body-secondary text-body-emphasis ms-1">Public investigations only</span>
                            }
                        </MetaLine>
                    </OrgCard>
                </div>
            }
        </div>
    }

    @*
        ── Browse ────────────────────────────────────────────────────────────
        Shown until a location search replaces it. This page used to render nothing at all until
        you typed a location, which made the site's own "Browse All Groups" button a dead end.
    *@
    @if (!_searched)
    {
        <hr class="my-4" />

        @if (_browsing && _browse is null)
        {
            <BenLoaderOverlay Visible="true" Text="Loading groups…" />
        }
        else if (_browse is null)
        {
            <div class="alert alert-warning">Could not load the list of groups. Please try again.</div>
        }
        else if (_browse.TotalCount == 0)
        {
            @* An empty FILTER is not an empty site. "No groups have registered yet" is a lie
               when 21 have and none of them run tours, and it sends the reader away thinking
               there is nothing here at all. *@
            <div class="alert alert-light text-muted text-center py-4">
                @if (_toursOnly)
                {
                    <text>No groups are listed as running walking tours yet.</text>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                @onclick="@(() => SetToursOnlyAsync(false))">See every group</button>
                    </div>
                }
                else
                {
                    <text>No groups have registered yet.</text>
                }
            </div>
        }
        else
        {
            <div class="d-flex align-items-baseline gap-2 mb-3 flex-wrap">
                <h5 class="mb-0">@(_toursOnly ? "Walking Tours" : "All Groups")</h5>
                <span class="badge bg-secondary">@_browse.TotalCount total</span>
                @* Somebody visiting a strange city wants tours, not a list to sift
                   (2026-08-24). Matches the CAPABILITY, so an investigation group that also
                   runs tours is in here too. *@
                <div class="ms-auto btn-group btn-group-sm" role="group" aria-label="Filter groups">
                    <button type="button" class="btn @(_toursOnly ? "btn-outline-secondary" : "btn-secondary")"
                            @onclick="@(() => SetToursOnlyAsync(false))" disabled="@_browsing">
                        Everyone
                    </button>
                    <button type="button" class="btn @(_toursOnly ? "btn-secondary" : "btn-outline-secondary")"
                            id="find-tours-only"
                            @onclick="@(() => SetToursOnlyAsync(true))" disabled="@_browsing">
                        Walking tours
                    </button>
                </div>
            </div>

            <div class="row g-3">
                @foreach (var org in _browse.Items)
                {
                    <div class="col-12 col-md-6">
                        <OrgCard Name="@org.Name" UrlName="@org.UrlName"
                                 AreaLabel="@org.AreaLabel" LogoFileId="@org.ActiveLogoFileId">
                            <MetaLine>
                                @* Child content has to open with markup — a RenderFragment that
                                   starts with @if confuses the Razor parser into losing the tag. *@
                                <span class="badge rounded-pill bg-body-secondary text-body-emphasis me-1">
                                    @Ben.Data.Common.Enums.OrganizationKindDefaults.DisplayName(org.Kind)
                                </span>
                                @if (org.RunsPublicTours && org.Kind != Ben.Data.Common.Enums.OrganizationKind.GhostWalkingTour)
                                {
                                    <span class="badge rounded-pill bg-body-secondary text-body-emphasis me-1">Runs tours</span>
                                }
                                @* Item 194, Ben's direction: colour for groups that can take
                                   private work, plain for the rest — and the plain one says what
                                   it CAN do. "Public investigations only" is a fact; greyed-and-
                                   diminished reads as a punishment, and free-tier groups are the
                                   early adopters. *@
                                @if (org.TakesPrivateResidenceCases)
                                {
                                    <span class="badge rounded-pill bg-primary me-1" title="This group's plan covers investigations at private homes.">Takes private homes</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-body-secondary text-body-emphasis me-1" title="This group investigates public places — landmarks, businesses, events.">Public investigations only</span>
                                }
                                <span class="@(org.IsAcceptingClients ? "text-success" : "text-secondary")">
                                    @(org.IsAcceptingClients ? "✓ Accepting new cases" : "Not currently accepting new cases")
                                </span>
                                @if (org.RadiusMiles.HasValue)
                                {
                                    <span class="text-secondary"> · @(org.RadiusMiles.Value.ToString("F0")) mi range</span>
                                }
                            </MetaLine>
                        </OrgCard>
                    </div>
                }
            </div>

            @if (TotalPages > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => LoadBrowseAsync(_browse.Page - 1))" disabled="@(!(!_browsing && _browse.Page > 1))">← Previous</button>
                    <span class="text-secondary small">Page @_browse.Page of @TotalPages</span>
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => LoadBrowseAsync(_browse.Page + 1))" disabled="@(!(!_browsing && _browse.Page < TotalPages))">Next →</button>
                </div>
            }
        }
    }
</div>

@code {
    private const int BrowsePageSize = 24;

    private string _query         = "";
    private string _searchedQuery = "";
    private bool   _searching     = false;
    private bool   _searched      = false;
    private string? _geocodeError;
    private IReadOnlyList<OrgSearchResult> _results      = [];
    private List<OrgSearchResult>          _withinRange  = [];
    private List<OrgSearchResult>          _outsideRange = [];

    private OrgBrowsePage? _browse;
    private bool _browsing;

    private int TotalPages => _browse is null || _browse.PageSize == 0
        ? 1
        : (int)Math.Ceiling(_browse.TotalCount / (double)_browse.PageSize);

    protected override async Task OnInitializedAsync() => await LoadBrowseAsync(1);

    /// <summary>Narrowed to groups running public walking tours.</summary>
    private bool _toursOnly;

    private async Task SetToursOnlyAsync(bool toursOnly)
    {
        if (_toursOnly == toursOnly) return;
        _toursOnly = toursOnly;
        await LoadBrowseAsync(1);   // a different filter is a different list, from the top
    }

    private async Task LoadBrowseAsync(int page)
    {
        _browsing = true;
        StateHasChanged();
        // Anonymous endpoint — no AuthReady wait needed, and this page is reachable signed out.
        _browse = await AdminClient.BrowseOrganizationsAsync(page, BrowsePageSize, toursOnly: _toursOnly);
        _browsing = false;
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;

        _searching    = true;
        _geocodeError = null;
        StateHasChanged();

        var geo = await AdminClient.SearchGeocodingAsync(_query.Trim());

        if (geo?.Latitude is null || geo.Longitude is null)
        {
            _geocodeError = $"Could not locate \"{_query}\". Try a more specific address or city name.";
            _searching    = false;
            return;
        }

        var search = await AdminClient.SearchOrganizationsAsync((double)geo.Latitude, (double)geo.Longitude);

        // "No groups near you" and "the search could not run" are different answers, and only one
        // of them should stop somebody looking. Item 120.
        if (search.Failed)
        {
            _geocodeError = search.Reason ?? "The search could not be run just now. Please try again.";
            _searching    = false;
            return;
        }

        _results       = search.Items;
        _withinRange   = _results.Where(r => r.IsWithinRange).ToList();
        _outsideRange  = _results.Where(r => !r.IsWithinRange).ToList();
        _searchedQuery = _query.Trim();
        _searched      = true;
        _searching     = false;
    }

    private async Task ClearSearchAsync()
    {
        _query         = "";
        _searchedQuery = "";
        _searched      = false;
        _results       = [];
        _withinRange   = [];
        _outsideRange  = [];
        _geocodeError  = null;

        // The list may have changed while the visitor was searching, and reloading costs one
        // anonymous call — cheaper than reasoning about how stale the cached page might be.
        await LoadBrowseAsync(1);
    }
}
