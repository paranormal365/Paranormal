@page "/organizations/{OrgId:guid}/client-settings"
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Manage.Maps
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@if (!EmbeddedMode)
{
    <PageTitle>Client Settings — @(_orgName ?? "Organization")</PageTitle>
}

@* Embedded, this is the group page's Clients tab and the page already carries the group's name
   and its own width. Standalone, it is a page and supplies both itself. *@
<div class="@(EmbeddedMode ? "" : "container-fluid py-3")" style="@(EmbeddedMode ? "" : "max-width:860px;")">
    @if (!EmbeddedMode)
    {
        <h3 class="mb-4">Client Settings — @(_orgName ?? OrgId.ToString())</h3>
    }

    <p class="text-secondary">
        A client looking for help finds you by these two answers: whether you are taking cases, and
        where you work. Until both are set, no client search will return this
        group.<HelpLink Slug="organization-administration" Anchor="being-found-by-clients" />
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_savedMessage is not null)
    {
        <div class="alert alert-success">@_savedMessage</div>
    }

    @if (!_loaded)
    {
        <BenLoaderOverlay Visible="true" Text="Loading settings…" />
    }
    else
    {
        @* ── Case Acceptance ────────────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header fw-semibold">Case Acceptance</div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    @* The switch had only its grey consequence beside it, so nothing named what it switched (UI test pass,
                       2026-09-14). A label, as the checkbox below has, with the consequence under it. *@
                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" role="switch" id="accepting-clients" @bind="@_isAcceptingClients" />
                        <label for="accepting-clients" class="form-check-label">
                            Taking new cases
                            <span class="text-secondary small d-block">
                                @(_isAcceptingClients
                                    ? "Your organization will appear in client search results."
                                    : "Your organization is hidden from client search results.")
                            </span>
                        </label>
                    </div>
                    @if (_isAcceptingClients)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" class="form-check-input" id="outside-range" @bind="@_acceptsOutsideRange" />
                            <label for="outside-range" class="form-label mb-0">
                                Accept clients outside our operating area
                                <span class="text-secondary small d-block">
                                    Your org will appear in results for clients beyond your radius, sorted below in-range orgs.
                                </span>
                            </label>
                        </div>
                    }
                    <div>
                        <button type="button" class="btn btn-primary" @onclick="SaveAcceptance" disabled="@(!(!_isBusy))">
                            @(_isBusy ? "Saving…" : "Save Acceptance Settings")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Area of Operation ───────────────────────────────────────────────── *@
        <div class="card mb-4">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="fw-semibold">Area of Operation</span>
                @if (_area is not null)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenEditArea"><BenIcon Name="edit-2" Class="me-1" />Edit</button>
                }
            </div>
            <div class="card-body">
                @if (_area is null)
                {
                    <p class="text-secondary mb-3">
                        No operating area configured. Set a center location and radius so clients can find you.
                    </p>
                    <button type="button" class="btn btn-primary" @onclick="OpenEditArea"><BenIcon Name="plus" Class="me-1" />
                        Set Operating Area
                    </button>
                }
                else
                {
                    <div class="d-flex align-items-start gap-4">
                        <div>
                            <div class="mb-1">
                                <strong>@_area.DisplayLabel</strong>
                            </div>
                            <div class="text-secondary small">
                                Radius: @_area.RadiusMiles mi
                            </div>
                        </div>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDeleteArea"><BenIcon Name="trash-2" Class="me-1" />Remove</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ── Edit Area dialog ────────────────────────────────────────────────────── *@
<AreaOfOperationDialog @bind-Visible="@_showAreaDialog"
                       OrgId="@OrgId"
                       ExistingArea="@_area"
                       IsAcceptingClients="@_isAcceptingClients"
                       AcceptsClientsOutsideRange="@_acceptsOutsideRange"
                       OnSaved="@OnAreaSaved" />

@* ── Delete confirm ───────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDeleteConfirm" Title="Remove Operating Area">
    <ChildContent>
        <p>Remove the operating area configuration? Your organization will no longer appear in client proximity searches.</p>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showDeleteConfirm = false)">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="DeleteArea" disabled="@(!(!_isBusy))">
                @(_isBusy ? "Removing…" : "Remove")
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }

    /// <summary>Rendered inside the group page's Clients tab rather than as its own page.</summary>
    [Parameter] public bool EmbeddedMode { get; set; }

    /// <summary>Raised after acceptance or the operating area changes, so a host page can drop the
    /// "clients cannot find you" notice without a reload.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _orgName;
    private bool _loaded;
    private string? _error;
    private string? _savedMessage;
    private bool _isBusy;

    // Acceptance state
    private bool _isAcceptingClients;
    private bool _acceptsOutsideRange;

    // Area of operation
    private OrganizationAreaOfOperationRecord? _area;
    private bool _showAreaDialog;
    private bool _showDeleteConfirm;

    // Area dialog form state is managed by AreaOfOperationDialog component

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            var org = await AdminClient.GetOrganizationAsync(OrgId);
            _orgName             = org?.Name;
            _isAcceptingClients  = org?.IsAcceptingClients ?? false;
            _acceptsOutsideRange = org?.AcceptsClientsOutsideRange ?? false;

            try { _area = await AdminClient.GetOrgAreaOfOperationAsync(OrgId); }
            catch { _area = null; }

            _loaded = true;
        }
        catch { _error = "Failed to load settings."; _loaded = true; }
    }

    // ── Acceptance ────────────────────────────────────────────────────────────
    private async Task SaveAcceptance()
    {
        _isBusy = true;
        _error = null;
        _savedMessage = null;
        try
        {
            // A green "Saved." on a discarded bool (2026-09-17 audit). The transport returns false
            // on a refusal rather than throwing, so the catch below never fired on the 403 this
            // endpoint actually returns — and a refusal here is a DESIGNED-FOR event, not a
            // hypothetical: StartGroupPage documents that a brand-new group is on the free lane
            // where the paid gate turns away any attempt to open membership applications.
            if (!await AdminClient.UpdateClientAcceptanceAsync(
                    OrgId, _isAcceptingClients, _acceptsOutsideRange))
            {
                _error = "That setting could not be saved, so nothing has changed. "
                       + "If your group is on the free plan, taking on clients is part of a paid one.";
                return;
            }

            _savedMessage = _isAcceptingClients
                ? "Saved. Clients can find this group once an operating area is set."
                : "Saved. This group is hidden from client searches.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isBusy = false; }
    }

    // ── Area of Operation ─────────────────────────────────────────────────────
    private void OpenEditArea() => _showAreaDialog = true;

    private async Task OnAreaSaved(OrganizationAreaOfOperationRecord result)
    {
        _area = result;
        // The dialog saves the acceptance flags this component handed it, so local state already
        // matches the server; only the host page's notice needs telling.
        await OnChanged.InvokeAsync();
    }

    private void ConfirmDeleteArea() => _showDeleteConfirm = true;

    private async Task DeleteArea()
    {
        _isBusy = true;
        try
        {
            // Checked for the same reason as the acceptance save above: a discarded false left
            // the area looking deleted while it was still serving client searches.
            if (!await AdminClient.DeleteOrgAreaOfOperationAsync(OrgId))
            {
                _error = "That operating area could not be removed, so it is still in place.";
                return;
            }
            _area = null;
            _showDeleteConfirm = false;
            await OnChanged.InvokeAsync();
        }
        catch { _error = "Failed to remove operating area."; }
        finally { _isBusy = false; }
    }
}
