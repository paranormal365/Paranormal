@page "/o/{UrlName}/{PageSlug}"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Web.Services
@using Ben.Data.Common.Enums

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

@* Item 154: the address must die with the feature switch, not just the links to it. *@
<FeatureGate Flag="@SiteFeatures.CmsPages">
<PageTitle>@(_page?.Page.PageTitle ?? PageSlug) — @(_page?.OrgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else if (_page is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Page not found</h2>
        <p class="text-secondary">
            This page does not exist or is not publicly available.
            <a href="/o/@UrlName">← Back to @UrlName</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:960px; margin:0 auto;">

        @* The same band and the same pills as the group's home page (OrgPublicBanner,
           OrgPublicNav): a group whose front door and whose "About us" look like two different
           sites has no front door. Here the group's name is the eyebrow and this page's title is
           the heading, so a reader knows whose site they are on and which page they reached. *@
        <OrgPublicBanner Name="@_page.OrgName" UrlName="@_page.OrgUrlName"
                         PageTitle="@_page.Page.PageTitle"
                         LogoUrl="@(_page.Logos.Any() ? AdminClient.GetFileThumbnailUrl(_page.Logos.First().UploadFileId) : null)"
                         LogoAlt="@(_page.Logos.FirstOrDefault()?.AltText)"
                         Class="mb-3" />

        <OrgPublicNav OrgUrlName="@_page.OrgUrlName" NavPages="@_page.NavPages"
                      Active="@PageSlug" Class="mb-4" />

        @* ── Page sections ────────────────────────────────────────────────── *@
        @if (_page.Page.Sections.Count == 0)
        {
            @* A page can be published with nothing on it, and the visitor then got a heading over
               an empty screen — which reads as a page that failed to load rather than one nobody
               has written yet. Say which it is. *@
            <p class="text-secondary">
                There is nothing on this page yet.
                <a href="@($"/o/{_page.OrgUrlName}")">Back to @_page.OrgName</a>
            </p>
        }
        @foreach (var section in _page.Page.Sections.OrderBy(s => s.SortOrder))
        {
            <OrgPublicSection Section="section" FileBaseUrl="@AdminClient.GetFileDownloadUrl(Guid.Empty).Replace(Guid.Empty.ToString(), "")" PublicMediaBaseUrl="@AdminClient.GetPublicCaseMediaBaseUrl()" />
        }
    </div>
}

</FeatureGate>

@code {
    [Parameter] public string UrlName   { get; set; } = "";
    [Parameter] public string PageSlug  { get; set; } = "";

    private OrgPublicPageResponse? _page;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        StateHasChanged();
        _page    = await AdminClient.GetPublicOrgPageAsync(UrlName, PageSlug);
        _loading = false;
    }
}
