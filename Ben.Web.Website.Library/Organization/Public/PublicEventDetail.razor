@page "/o/{UrlName}/events/{EventSlug}"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Web.Services
@using Ben.Web.Website.Library.Kit
@using Ben.Web.Website.Library.Kit.Maps
@using Ben.Web.Website.Library.Manage.Maps
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IMediaUrlBuilder MediaUrls

@* Item 154: the address must die with the feature switch, not just the links to it. *@
<FeatureGate Flag="@SiteFeatures.Events">
<PageTitle>@(_event?.Title ?? "Event") — @(_event?.OrganizationName ?? UrlName)</PageTitle>

@* The whole point of a public event is that somebody shares the link. This is what that link looks
   like in a group chat — and it carries the site's name alongside the group's. *@
@if (_event is not null)
{
    <Ben.Web.Website.Library.Shared.SocialCard Title="@($"{_event.Title} — {_event.OrganizationName}")"
                                       Description="@SocialSummary"
                                       RelativeUrl="@($"/o/{UrlName}/events/{EventSlug}")"
                                       Type="article" />
}

@* One public event, for somebody who may never have heard of this group. The organization is named
   prominently on purpose: an introduction is what the listing is for. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else if (_event is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Event not found</h2>
        <p class="text-secondary">
            This event has finished, or it is not open to the public.
            <a href="/o/@UrlName">← Back to @UrlName</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:960px; margin:0 auto;">
        <div class="mb-3">
            <a href="@($"/o/{_event.OrganizationUrlName}")" class="text-decoration-none small">
                &larr; @_event.OrganizationName
            </a>
        </div>

        @* A banner, not a heading. This page is one date, and the date is the fact somebody is
           looking for — so it is drawn as a plate the eye finds before it reads anything, the same
           plate the tour's own list of dates uses.

           The wash behind it takes its colour from the tour when this date runs one, and from the
           host otherwise (TourPlate), so every event page has a character of its own without
           needing a photograph nobody uploaded. *@
        <div class="event-head mb-4" style="@TourPlate.HueStyle(_event.TourName ?? _event.OrganizationName)">
            <div class="event-head__plate">
                <span class="event-head__dow">@Local(_event.StartDateTime).ToString("ddd")</span>
                <span class="event-head__day">@Local(_event.StartDateTime).Day</span>
                <span class="event-head__mon">@Local(_event.StartDateTime).ToString("MMM")</span>
            </div>
            <div class="event-head__text">
                @if (_event.TourName is { } tourName)
                {
                    <div class="event-head__tour">
                        @if (_event.TourUrlName is { } tourSlug)
                        {
                            <a href="@($"/o/{_event.OrganizationUrlName}/tours/{tourSlug}")">@tourName</a>
                        }
                        else
                        {
                            @tourName
                        }
                        @if (_event.TourRating is { } rating)
                        {
                            <text> · @rating.ToString("0.0") ★ (@_event.TourRatingCount)</text>
                        }
                    </div>
                }
                <h1 class="event-head__title">@_event.Title</h1>
                <div class="event-head__by">
                    Hosted by
                    <a href="@($"/o/{_event.OrganizationUrlName}")">@_event.OrganizationName</a>
                </div>
            </div>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        @* The facts of the night, stated the way the tour's own page states them. *@
        <BenFactRail Facts="@Facts" Class="mb-4" />

        @* The point of the page, put where the eye lands rather than under a paragraph of
           description. Every state of it is one card: coming, may come, cannot come and why, or
           has never been here before.

           A stranger giving an address is not yet coming — the link we send is what confirms
           anything, because an address typed into a box proves nothing, and an event that hides
           its street until you are coming would be protecting nothing if it did. *@
        <div class="event-act card mb-4">
            <div class="card-body">
                @if (_event.Flags.HasRsvpd)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge text-bg-success">You're coming</span>
                        <span class="text-secondary small flex-grow-1">
                            We'll send you a reminder before the night.
                        </span>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="CancelAsync" disabled="@_busy">I can't make it</button>
                    </div>
                }
                else if (_event.Flags.CanRsvp)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="event-act__ask flex-grow-1">Coming along?</span>
                        <button type="button" class="btn btn-primary"
                                @onclick="RsvpAsync" disabled="@_busy">I'm coming</button>
                    </div>
                }
                else if (!_isAuthenticated && !_event.Flags.RsvpHasClosed && !_event.Flags.IsFull)
                {
                    @if (_emailSent)
                    {
                        <div class="event-act__ask mb-1">Check your email</div>
                        <p class="text-secondary small mb-0">
                            If that address can come along, there's a link on its way. Click it to
                            confirm — it works once, and it's good for two weeks.
                        </p>
                    }
                    else
                    {
                        <div class="event-act__ask mb-1">Coming along?</div>
                        <p class="text-secondary small">
                            You don't need an account. Give us an email address and we'll send you a
                            link to confirm — no password to invent.
                        </p>

                        @if (_attendError is not null)
                        {
                            <div class="alert alert-danger py-2">@_attendError</div>
                        }

                        <div class="row g-2">
                            <div class="col-md-5">
                                <input class="form-control" type="email" maxlength="320"
                                       placeholder="you@example.com" value="@_attendEmail"
                                       @oninput="@(e => _attendEmail = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-4">
                                <input class="form-control" maxlength="200"
                                       placeholder="Your name (optional)" value="@_attendName"
                                       @oninput="@(e => _attendName = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary w-100"
                                        @onclick="RequestAttendanceAsync"
                                        disabled="@(_busy || !_attendEmail.Contains('@'))">Send me the link</button>
                            </div>
                        </div>

                        <p class="text-secondary mt-2 mb-0" style="font-size:.75rem;">
                            Already have an account? <a href="/login">Sign in</a> and say you're
                            coming in one click.
                        </p>
                    }
                }
                else if (_event.Flags.RsvpBlockedReason is string reason)
                {
                    <span class="text-secondary">@reason</span>
                }
                else
                {
                    @* Signed out, and the door is shut. Saying nothing here left the page looking
                       as though the sign-up had failed to load. *@
                    <span class="text-secondary">
                        @(_event.Flags.IsFull
                            ? "This one is full."
                            : "Sign-ups for this one have closed.")
                    </span>
                }
            </div>
        </div>

        @* Where to stand, given the room it needs. The map is drawn ONLY for a tour date: those
           coordinates are the tour's own meeting point, exact by construction, while every other
           event's are deliberately rounded before they leave the server. A rounded point under a
           precise-looking pin would be a lie the reader has no way to spot. *@
        <div class="event-meet card mb-4 overflow-hidden">
            <div class="event-meet__grid @(HasMap ? "event-meet__grid--map" : "")">
                <div class="event-meet__body">
                    @* "Where you meet" is a promise about a street corner, and a tour date can
                       make it. An ordinary event often carries only a town, so it says "Where"
                       and does not pretend the line under it is a meeting point. *@
                    <span class="event-label">@(_event.TourName is null ? "Where" : "Where you meet")</span>
                    @if (_event.Location.ExactAddress is string address)
                    {
                        <p class="event-meet__address">@address</p>
                        @if (HasMap)
                        {
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-primary btn-sm" id="event-directions"
                                        @onclick="ShowDirections">
                                    <BenIcon Name="map" Class="me-1" />Directions
                                </button>
                                <a class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener"
                                   href="@AppleMapsUrl">Open in Maps</a>
                            </div>
                        }
                    }
                    else if (_event.Location.IsExactAddressHidden)
                    {
                        @* Said plainly, before anyone commits, so nobody feels tricked into
                           identifying themselves to find out where they are going. *@
                        <p class="event-meet__address">
                            @(_event.Location.City ?? "Location") @(_event.Location.State)
                        </p>
                        <p class="text-secondary small mb-0">
                            The exact address is shared with people who are coming.
                        </p>
                    }
                    else
                    {
                        <p class="event-meet__address text-secondary">
                            @(_event.Location.City ?? "To be announced")
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(_event.MeetingUrl) && _event.Flags.HasRsvpd)
                    {
                        <span class="event-label">Online</span>
                        <p class="mb-0">
                            <a href="@_event.MeetingUrl" target="_blank" rel="noopener noreferrer">Join online</a>
                        </p>
                    }
                </div>

                @if (HasMap)
                {
                    @* A pixel height, not a percentage: the map sizes itself once at start-up and
                       a percentage against a stretched grid cell is not a number it can use. *@
                    <div class="event-meet__map">
                        <BenMap Pins="@_mapPins" Height="280px" FitToPins="false"
                                CenterLatitude="@((double)_event.Location.ApproximateLatitude!.Value)"
                                CenterLongitude="@((double)_event.Location.ApproximateLongitude!.Value)"
                                Zoom="15" />
                    </div>
                }
            </div>
        </div>

        <DirectionsMapModal @ref="_directions" />

        @if (_event.Guides is { Count: > 0 } guides)
        {
            @* Ben asked for the guide's name and face to reach a guest "for safety" — so it is on
               the page as well as in the email, for anybody who never opens the email. *@
            <BenSectionHeading Text="Who you'll be walking with" />
            <BenGuideStrip Guides="@guides" Role="Your guide" Class="mb-4" />
        }

        @if (!string.IsNullOrWhiteSpace(_event.Description))
        {
            @* The description is authored in a rich-text editor, so it IS markup and was being
               shown as its own source — a visitor read a literal "<p>". Rendered as HTML here and
               sanitized twice on the way: once when saved, and again by the public endpoint that
               serves it, which is what makes the rows written before that rule safe. *@
            <BenSectionHeading Text="About the night" />
            <div class="event-description mb-4">@((MarkupString)(_event.Description ?? ""))</div>
        }


        @* ── Evidence from the night (item 111) ────────────────────────────── *@
        @if (_acceptedEvidence.Items.Count > 0)
        {
            <BenSectionHeading Text="What people caught" />
            <div class="card mb-4">
                <div class="card-body">
                    @foreach (var ev in _acceptedEvidence.Items)
                    {
                        <div class="py-2 border-bottom">
                            @* Absolute against the API origin: on the split deployment a raw
                               /api href resolves to the SITE and 404s — the img-sends-no-token
                               trap's anonymous sibling. *@
                            <a href="@AdminClient.GetEventEvidenceFileUrl(ev.OrgCalendarEventId, ev.Id)"
                               target="_blank" rel="noopener">@ev.FileName</a>
                            <span class="text-secondary small">— @ev.SubmitterDisplayName, @ev.DateCreated.ToString("MM/dd/yyyy")</span>
                            @if (!string.IsNullOrWhiteSpace(ev.Note))
                            {
                                <div class="small">@ev.Note</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (_isAuthenticated && _event is not null)
        {
            <BenSectionHeading Text="Were you there?" />
            <div class="card mb-4">
                <div class="card-body">
                    @* The bargain, stated BEFORE the button — item 87's rule is that evidence at
                       an open investigation is public, and nobody should learn that after
                       submitting. *@
                    <p class="text-secondary small">
                        A group member reviews every submission. If yours is accepted it becomes
                        part of this event's <strong>public</strong> record, credited to you.
                    </p>

                    <InputFile OnChange="OnEvidenceFileChosen" class="form-control mb-2" id="evidence-file" />
                    <textarea class="form-control mb-2" rows="2" maxlength="2000" id="evidence-note"
                              placeholder="What is this? Where in the building, what time, what did you hear or see?"
                              @bind="_evidenceNote"></textarea>

                    @if (_evidenceError is not null)
                    {
                        <div class="alert alert-danger py-2">@_evidenceError</div>
                    }
                    <button type="button" class="btn btn-primary" id="evidence-submit"
                            disabled="@(_evidenceFile is null || _evidenceBusy)" @onclick="SubmitEvidenceAsync">
                        @(_evidenceBusy ? "Sending…" : "Offer it to the group")
                    </button>

                    @if (_myEvidence.Items.Count > 0)
                    {
                        <h6 class="mt-3">Your submissions</h6>
                        @foreach (var mine in _myEvidence.Items)
                        {
                            <div class="small py-1">
                                @mine.FileName —
                                @switch (mine.Status)
                                {
                                    case Ben.Data.Common.Enums.EvidenceSubmissionStatus.Pending:
                                        <span class="badge bg-secondary">Waiting for review</span>
                                        break;
                                    case Ben.Data.Common.Enums.EvidenceSubmissionStatus.Accepted:
                                        <span class="badge bg-success">Accepted — public</span>
                                        break;
                                    case Ben.Data.Common.Enums.EvidenceSubmissionStatus.Rejected:
                                        <span class="badge bg-danger">Declined</span>
                                        @if (mine.RejectionReason is not null)
                                        {
                                            <span class="text-secondary"> — @mine.RejectionReason</span>
                                        }
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

</FeatureGate>

@code {
    [Parameter] public string UrlName { get; set; } = "";
    [Parameter] public string EventSlug { get; set; } = "";

    /// <summary>
    /// What the link preview says. When and where come first because that is what somebody deciding
    /// whether to go actually needs — the description is often a paragraph that reads badly truncated.
    /// </summary>
    private string SocialSummary
    {
        get
        {
            if (_event is null) return "";

            var when  = _event.StartDateTime.ToLocalTime().ToDisplayDateTime();
            var where = _event.Location.City is string city
                ? $" in {city}{(_event.Location.State is string st ? $", {st}" : "")}"
                : "";

            return $"{when}{where}. Hosted by {_event.OrganizationName}. Anyone can come along.";
        }
    }

    private PublicEventRecord? _event;
    private bool _loading = true, _busy, _isAuthenticated;
    private string? _error;

    private DirectionsMapModal? _directions;
    private IReadOnlyList<BenMapPin> _mapPins = [];

    /// <summary>
    /// Whether a map may be drawn for this event.
    /// </summary>
    /// <remarks>
    /// Only for a tour date. Those coordinates are the tour's own start address, exact by
    /// construction and already printed in full a line above; every other event's are rounded
    /// before they leave the server, on purpose. A rounded point under a precise-looking pin would
    /// claim an accuracy the reader has no way to check.
    /// </remarks>
    private bool HasMap => _event is
    {
        TourName: not null,
        Location: { ApproximateLatitude: not null, ApproximateLongitude: not null, ExactAddress: not null },
    };

    /// <summary>The meeting point handed to whatever the reader navigates with.</summary>
    private string AppleMapsUrl => _event?.Location is
        { ApproximateLatitude: { } lat, ApproximateLongitude: { } lon }
        ? $"https://maps.apple.com/?ll={lat.ToString(System.Globalization.CultureInfo.InvariantCulture)},"
          + $"{lon.ToString(System.Globalization.CultureInfo.InvariantCulture)}"
          + $"&q={Uri.EscapeDataString(_event.TourName ?? _event.Title)}"
        : "#";

    private void ShowDirections()
    {
        if (_event?.Location is not { ApproximateLatitude: { } lat, ApproximateLongitude: { } lon }) return;
        if (_event.Location.ExactAddress is not { } address) return;
        _directions?.Show(address, (double)lat, (double)lon);
    }

    /// <summary>This event's times in the reader's own clock, in one place.</summary>
    private static DateTime Local(DateTime utc) => utc.ToLocalTime();

    /// <summary>
    /// The rail under the banner: when it starts, how long it runs, and how full it is. Built here
    /// so the order is one list to read, and shared with the tour's page through BenFactRail.
    /// </summary>
    private IReadOnlyList<BenFactItem> Facts
    {
        get
        {
            if (_event is null) return [];

            var facts = new List<BenFactItem>();
            var start = Local(_event.StartDateTime);

            facts.Add(_event.IsAllDay
                ? new BenFactItem("When", start.ToString("ddd MM/dd"), "all day", Emphasis: true)
                : new BenFactItem("Starts", start.ToString("ddd MM/dd"),
                      start.ToString("h:mm tt"), Emphasis: true));

            if (!_event.IsAllDay)
            {
                var minutes = (int)(_event.EndDateTime - _event.StartDateTime).TotalMinutes;
                if (minutes > 0)
                    facts.Add(new BenFactItem("How long", Duration(minutes), "on your feet"));
            }

            facts.Add(_event.AttendeeCapacity is { } cap
                ? new BenFactItem("Coming", $"{_event.AttendingCount} of {cap}",
                      _event.Flags.IsFull ? "no spaces left" : $"{Math.Max(0, cap - _event.AttendingCount)} still open")
                : new BenFactItem("Coming", _event.AttendingCount.ToString(),
                      _event.AttendingCount == 1 ? "person" : "people"));

            if (_event.RsvpClosesAt is { } closes)
                facts.Add(new BenFactItem("Sign-ups close", Local(closes).ToString("ddd MM/dd"),
                    Local(closes).ToString("h:mm tt")));

            return facts;
        }
    }

    /// <summary>A length short enough to be a figure in the rail.</summary>
    private static string Duration(int minutes)
    {
        var hours = minutes / 60;
        var rest = minutes % 60;
        return hours switch
        {
            0 => $"{rest} min",
            _ when rest == 0 => $"{hours} hr",
            _ => $"{hours} hr {rest} min",
        };
    }

    private string _attendEmail = "", _attendName = "";
    private bool _emailSent;
    private string? _attendError;

    private async Task RequestAttendanceAsync()
    {
        if (_event is null) return;
        _busy = true; _attendError = null;

        // The server answers the same way whether or not that address is known here, so there is
        // nothing to report back beyond "we tried".
        if (await AdminClient.RequestEventAttendanceAsync(
                _event.Id, _attendEmail.Trim(),
                string.IsNullOrWhiteSpace(_attendName) ? null : _attendName.Trim()))
            _emailSent = true;
        else
            _attendError = "That couldn't be sent. The event may have filled up or closed.";

        _busy = false;
    }

    /// <summary>
    /// Loads during <b>prerender</b>, which is the whole reason it is here rather than in
    /// <c>OnAfterRenderAsync</c> with everything else on this page.
    /// </summary>
    /// <remarks>
    /// The link-preview crawlers do not run JavaScript and never connect the circuit: they read the
    /// server-rendered HTML and leave. Loading the event after first render meant the social card
    /// had nothing to describe at the only moment anybody was looking, so every shared link would
    /// have rendered as a bare URL — invisible to a human testing the page, because by the time
    /// they look it has loaded.
    ///
    /// <para>Safe to do here precisely because this page is public: fetching the event needs no
    /// authentication, so there is no auth state to wait for. Whether to offer the RSVP button does
    /// need it, and that stays in the after-render pass below.</para>
    /// </remarks>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Public page: not being signed in is the ordinary case, not a reason to bail.
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive))
        {
            _isAuthenticated = UserState.IsAuthenticated;
            // Reload once auth is known: the RSVP flags depend on who is asking, and the prerender
            // pass necessarily computed them for nobody.
            await LoadAsync();
        }
    }

    private Ben.Web.Services.WebApi.LoadResult<EventEvidenceRecord> _acceptedEvidence;
    private Ben.Web.Services.WebApi.LoadResult<EventEvidenceRecord> _myEvidence;
    private IBrowserFile? _evidenceFile;
    private string _evidenceNote = "";
    private bool _evidenceBusy;
    private string? _evidenceError;

    private void OnEvidenceFileChosen(InputFileChangeEventArgs e) => _evidenceFile = e.File;

    private async Task SubmitEvidenceAsync()
    {
        if (_evidenceFile is null || _event is null) return;

        _evidenceBusy = true;
        _evidenceError = null;
        try
        {
            // Buffered BEFORE the HTTP call. A RemoteBrowserFileStream pulls its bytes over
            // SignalR on demand, and handing it straight to StreamContent makes HttpClient and
            // the circuit fight over who pumps — the submit "completed" up to twenty seconds
            // after the click, against a page that showed nothing, and a reconnecting circuit
            // could then REPLAY the click and submit twice. Copying first finishes the SignalR
            // half while the circuit is idle, and only then starts the HTTP half.
            await using var buffered = new MemoryStream();
            await using (var browserStream = _evidenceFile.OpenReadStream(maxAllowedSize: long.MaxValue))
                await browserStream.CopyToAsync(buffered);
            buffered.Position = 0;

            var (result, error) = await AdminClient.SubmitEventEvidenceAsync(
                _event.Id, buffered, _evidenceFile.Name, _evidenceFile.ContentType,
                string.IsNullOrWhiteSpace(_evidenceNote) ? null : _evidenceNote.Trim());

            if (result is null)
            {
                // The server's sentence names the actual bar — "people who attended" — which a
                // generic failure would bury.
                _evidenceError = error ?? "That couldn't be sent just now.";
                return;
            }

            _evidenceFile = null;
            _evidenceNote = "";
            _myEvidence = await AdminClient.GetMyEventEvidenceAsync(_event.Id);
        }
        finally { _evidenceBusy = false; }
    }

    private async Task LoadAsync()
    {
        _event   = await AdminClient.GetPublicEventAsync(UrlName, EventSlug);

        if (_event is not null)
        {
            // Only a tour date earns a pin — see HasMap for why.
            _mapPins = HasMap
                ? [new BenMapPin(
                       (double)_event.Location.ApproximateLatitude!.Value,
                       (double)_event.Location.ApproximateLongitude!.Value,
                       Title: _event.TourName ?? _event.Title,
                       Subtitle: "Where you meet",
                       Glyph: "🚶")]
                : [];

            _acceptedEvidence = await AdminClient.GetAcceptedEventEvidenceAsync(_event.Id);
            if (_isAuthenticated)
                _myEvidence = await AdminClient.GetMyEventEvidenceAsync(_event.Id);
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task RsvpAsync()
    {
        if (_event is null) return;
        _busy = true; _error = null;

        var updated = await AdminClient.RsvpToEventAsync(_event.Id);
        if (updated is null) _error = "That couldn't be saved — the event may be full or closed.";
        else _event = updated;

        _busy = false;
        if (_error is not null) await LoadAsync();
    }

    private async Task CancelAsync()
    {
        if (_event is null) return;
        _busy = true; _error = null;

        if (!await AdminClient.CancelEventRsvpAsync(_event.Id))
            _error = "That couldn't be changed.";

        _busy = false;
        await LoadAsync();
    }
}
