@page "/o/{UrlName}/events/{EventSlug}"
@namespace Ben.Web.Website.Library.Organization.Public
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>@(_event?.Title ?? "Event") — @(_event?.OrganizationName ?? UrlName)</PageTitle>

@* The whole point of a public event is that somebody shares the link. This is what that link looks
   like in a group chat — and it carries the site's name alongside the group's. *@
@if (_event is not null)
{
    <Ben.Web.Website.Library.Shared.SocialCard Title="@($"{_event.Title} — {_event.OrganizationName}")"
                                       Description="@SocialSummary"
                                       RelativeUrl="@($"/o/{UrlName}/events/{EventSlug}")"
                                       Type="article" />
}

@* One public event, for somebody who may never have heard of this group. The organization is named
   prominently on purpose: an introduction is what the listing is for. *@

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else if (_event is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Event not found</h2>
        <p class="text-secondary">
            This event has finished, or it is not open to the public.
            <a href="/o/@UrlName">← Back to @UrlName</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:800px; margin:auto;">
        <div class="mb-3">
            <a href="@($"/o/{_event.OrganizationUrlName}")" class="text-decoration-none small">
                &larr; @_event.OrganizationName
            </a>
        </div>

        <h1 class="mb-1">@_event.Title</h1>
        <p class="text-secondary mb-4">
            Hosted by <a href="@($"/o/{_event.OrganizationUrlName}")">@_event.OrganizationName</a>
        </p>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">When</dt>
                    <dd class="col-sm-9">
                        @_event.StartDateTime.ToLocalTime().ToDisplayDate()
                        @if (!_event.IsAllDay)
                        {
                            <span>, @_event.StartDateTime.ToLocalTime().ToDisplayTime()</span>
                            <span>&ndash; @_event.EndDateTime.ToLocalTime().ToDisplayTime()</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Where</dt>
                    <dd class="col-sm-9">
                        @if (_event.Location.ExactAddress is string address)
                        {
                            <span>@address</span>
                        }
                        else if (_event.Location.IsExactAddressHidden)
                        {
                            @* Said plainly, before anyone commits, so nobody feels tricked into
                               identifying themselves to find out where they are going. *@
                            <span>
                                @(_event.Location.City ?? "Location") @(_event.Location.State)
                                <span class="d-block text-secondary small">
                                    The exact address is shared with people who are coming.
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="text-secondary">@(_event.Location.City ?? "To be announced")</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(_event.MeetingUrl) && _event.Flags.HasRsvpd)
                        {
                            <span class="d-block mt-1">
                                <a href="@_event.MeetingUrl" target="_blank" rel="noopener noreferrer">Join online</a>
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-3">Coming</dt>
                    <dd class="col-sm-9">
                        @_event.AttendingCount
                        @if (_event.AttendeeCapacity is int cap)
                        {
                            <span class="text-secondary"> of @cap places</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_event.Description))
        {
            <p style="white-space:pre-line;">@_event.Description</p>
        }

        @* Rendered from the server's verdict, never worked out here. *@
        <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
            @if (_event.Flags.HasRsvpd)
            {
                <span class="badge bg-success">You're coming</span>
                <button type="button" class="btn btn-secondary" @onclick="CancelAsync" disabled="@(!(!_busy))">I can't make it</button>
            }
            else if (_event.Flags.CanRsvp)
            {
                <button type="button" class="btn btn-primary" @onclick="RsvpAsync" disabled="@(!(!_busy))">I'm coming</button>
            }
            else if (_event.Flags.RsvpBlockedReason is string reason)
            {
                <span class="text-secondary">@reason</span>
            }
        </div>

        @* Somebody who has never been here can still come. They give an address, we send a link,
           and clicking it is what actually confirms anything — an email typed into a box proves
           nothing, and events that hide their address until you are coming would be protecting
           nothing if it did. *@
        @if (!_isAuthenticated && !_event.Flags.RsvpHasClosed && !_event.Flags.IsFull)
        {
            <div class="card mt-3">
                <div class="card-body">
                    @if (_emailSent)
                    {
                        <h6 class="mb-1">Check your email</h6>
                        <p class="text-secondary small mb-0">
                            If that address can come along, there's a link on its way. Click it to
                            confirm — it works once, and it's good for two weeks.
                        </p>
                    }
                    else
                    {
                        <h6 class="mb-1">Coming along?</h6>
                        <p class="text-secondary small">
                            You don't need an account. Give us an email address and we'll send you a
                            link to confirm — no password to invent.
                        </p>

                        @if (_attendError is not null)
                        {
                            <div class="alert alert-danger py-2">@_attendError</div>
                        }

                        <div class="row g-2">
                            <div class="col-md-5">
                                <input class="form-control" type="email" maxlength="320"
                                       placeholder="you@example.com" value="@_attendEmail"
                                       @oninput="@(e => _attendEmail = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-4">
                                <input class="form-control" maxlength="200"
                                       placeholder="Your name (optional)" value="@_attendName"
                                       @oninput="@(e => _attendName = e.Value?.ToString() ?? "")" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary" @onclick="RequestAttendanceAsync" disabled="@(!(!_busy && _attendEmail.Contains('@')))">Send me the link</button>
                            </div>
                        </div>

                        <p class="text-secondary mt-2 mb-0" style="font-size:.75rem;">
                            Already have an account? <a href="/login">Sign in</a> and say you're
                            coming in one click.
                        </p>
                    }
                </div>
            </div>
        }

        @* ── Evidence from the night (item 111) ────────────────────────────── *@
        @if (_acceptedEvidence.Items.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-header"><strong>Evidence from attendees</strong></div>
                <div class="card-body">
                    @foreach (var ev in _acceptedEvidence.Items)
                    {
                        <div class="py-2 border-bottom">
                            @* Absolute against the API origin: on the split deployment a raw
                               /api href resolves to the SITE and 404s — the img-sends-no-token
                               trap's anonymous sibling. *@
                            <a href="@AdminClient.GetEventEvidenceFileUrl(ev.OrgCalendarEventId, ev.Id)"
                               target="_blank" rel="noopener">@ev.FileName</a>
                            <span class="text-secondary small">— @ev.SubmitterDisplayName, @ev.DateCreated.ToString("MM/dd/yyyy")</span>
                            @if (!string.IsNullOrWhiteSpace(ev.Note))
                            {
                                <div class="small">@ev.Note</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (_isAuthenticated && _event is not null)
        {
            <div class="card mt-3">
                <div class="card-header"><strong>Were you there? Share what you captured</strong></div>
                <div class="card-body">
                    @* The bargain, stated BEFORE the button — item 87's rule is that evidence at
                       an open investigation is public, and nobody should learn that after
                       submitting. *@
                    <p class="text-secondary small">
                        A group member reviews every submission. If yours is accepted it becomes
                        part of this event's <strong>public</strong> record, credited to you.
                    </p>

                    <InputFile OnChange="OnEvidenceFileChosen" class="form-control mb-2" id="evidence-file" />
                    <textarea class="form-control mb-2" rows="2" maxlength="2000" id="evidence-note"
                              placeholder="What is this? Where in the building, what time, what did you hear or see?"
                              @bind="_evidenceNote"></textarea>

                    @if (_evidenceError is not null)
                    {
                        <div class="alert alert-danger py-2">@_evidenceError</div>
                    }
                    <button type="button" class="btn btn-primary" id="evidence-submit"
                            disabled="@(_evidenceFile is null || _evidenceBusy)" @onclick="SubmitEvidenceAsync">
                        @(_evidenceBusy ? "Sending…" : "Offer it to the group")
                    </button>

                    @if (_myEvidence.Items.Count > 0)
                    {
                        <h6 class="mt-3">Your submissions</h6>
                        @foreach (var mine in _myEvidence.Items)
                        {
                            <div class="small py-1">
                                @mine.FileName —
                                @switch (mine.Status)
                                {
                                    case Ben.Data.Common.Enums.EvidenceSubmissionStatus.Pending:
                                        <span class="badge bg-secondary">Waiting for review</span>
                                        break;
                                    case Ben.Data.Common.Enums.EvidenceSubmissionStatus.Accepted:
                                        <span class="badge bg-success">Accepted — public</span>
                                        break;
                                    case Ben.Data.Common.Enums.EvidenceSubmissionStatus.Rejected:
                                        <span class="badge bg-danger">Declined</span>
                                        @if (mine.RejectionReason is not null)
                                        {
                                            <span class="text-secondary"> — @mine.RejectionReason</span>
                                        }
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string UrlName { get; set; } = "";
    [Parameter] public string EventSlug { get; set; } = "";

    /// <summary>
    /// What the link preview says. When and where come first because that is what somebody deciding
    /// whether to go actually needs — the description is often a paragraph that reads badly truncated.
    /// </summary>
    private string SocialSummary
    {
        get
        {
            if (_event is null) return "";

            var when  = _event.StartDateTime.ToLocalTime().ToDisplayDateTime();
            var where = _event.Location.City is string city
                ? $" in {city}{(_event.Location.State is string st ? $", {st}" : "")}"
                : "";

            return $"{when}{where}. Hosted by {_event.OrganizationName}. Anyone can come along.";
        }
    }

    private PublicEventRecord? _event;
    private bool _loading = true, _busy, _isAuthenticated;
    private string? _error;

    private string _attendEmail = "", _attendName = "";
    private bool _emailSent;
    private string? _attendError;

    private async Task RequestAttendanceAsync()
    {
        if (_event is null) return;
        _busy = true; _attendError = null;

        // The server answers the same way whether or not that address is known here, so there is
        // nothing to report back beyond "we tried".
        if (await AdminClient.RequestEventAttendanceAsync(
                _event.Id, _attendEmail.Trim(),
                string.IsNullOrWhiteSpace(_attendName) ? null : _attendName.Trim()))
            _emailSent = true;
        else
            _attendError = "That couldn't be sent. The event may have filled up or closed.";

        _busy = false;
    }

    /// <summary>
    /// Loads during <b>prerender</b>, which is the whole reason it is here rather than in
    /// <c>OnAfterRenderAsync</c> with everything else on this page.
    /// </summary>
    /// <remarks>
    /// The link-preview crawlers do not run JavaScript and never connect the circuit: they read the
    /// server-rendered HTML and leave. Loading the event after first render meant the social card
    /// had nothing to describe at the only moment anybody was looking, so every shared link would
    /// have rendered as a bare URL — invisible to a human testing the page, because by the time
    /// they look it has loaded.
    ///
    /// <para>Safe to do here precisely because this page is public: fetching the event needs no
    /// authentication, so there is no auth state to wait for. Whether to offer the RSVP button does
    /// need it, and that stays in the after-render pass below.</para>
    /// </remarks>
    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Public page: not being signed in is the ordinary case, not a reason to bail.
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive))
        {
            _isAuthenticated = UserState.IsAuthenticated;
            // Reload once auth is known: the RSVP flags depend on who is asking, and the prerender
            // pass necessarily computed them for nobody.
            await LoadAsync();
        }
    }

    private Ben.Web.Services.WebApi.LoadResult<EventEvidenceRecord> _acceptedEvidence;
    private Ben.Web.Services.WebApi.LoadResult<EventEvidenceRecord> _myEvidence;
    private IBrowserFile? _evidenceFile;
    private string _evidenceNote = "";
    private bool _evidenceBusy;
    private string? _evidenceError;

    private void OnEvidenceFileChosen(InputFileChangeEventArgs e) => _evidenceFile = e.File;

    private async Task SubmitEvidenceAsync()
    {
        if (_evidenceFile is null || _event is null) return;

        _evidenceBusy = true;
        _evidenceError = null;
        try
        {
            // Buffered BEFORE the HTTP call. A RemoteBrowserFileStream pulls its bytes over
            // SignalR on demand, and handing it straight to StreamContent makes HttpClient and
            // the circuit fight over who pumps — the submit "completed" up to twenty seconds
            // after the click, against a page that showed nothing, and a reconnecting circuit
            // could then REPLAY the click and submit twice. Copying first finishes the SignalR
            // half while the circuit is idle, and only then starts the HTTP half.
            await using var buffered = new MemoryStream();
            await using (var browserStream = _evidenceFile.OpenReadStream(maxAllowedSize: long.MaxValue))
                await browserStream.CopyToAsync(buffered);
            buffered.Position = 0;

            var (result, error) = await AdminClient.SubmitEventEvidenceAsync(
                _event.Id, buffered, _evidenceFile.Name, _evidenceFile.ContentType,
                string.IsNullOrWhiteSpace(_evidenceNote) ? null : _evidenceNote.Trim());

            if (result is null)
            {
                // The server's sentence names the actual bar — "people who attended" — which a
                // generic failure would bury.
                _evidenceError = error ?? "That couldn't be sent just now.";
                return;
            }

            _evidenceFile = null;
            _evidenceNote = "";
            _myEvidence = await AdminClient.GetMyEventEvidenceAsync(_event.Id);
        }
        finally { _evidenceBusy = false; }
    }

    private async Task LoadAsync()
    {
        _event   = await AdminClient.GetPublicEventAsync(UrlName, EventSlug);

        if (_event is not null)
        {
            _acceptedEvidence = await AdminClient.GetAcceptedEventEvidenceAsync(_event.Id);
            if (_isAuthenticated)
                _myEvidence = await AdminClient.GetMyEventEvidenceAsync(_event.Id);
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task RsvpAsync()
    {
        if (_event is null) return;
        _busy = true; _error = null;

        var updated = await AdminClient.RsvpToEventAsync(_event.Id);
        if (updated is null) _error = "That couldn't be saved — the event may be full or closed.";
        else _event = updated;

        _busy = false;
        if (_error is not null) await LoadAsync();
    }

    private async Task CancelAsync()
    {
        if (_event is null) return;
        _busy = true; _error = null;

        if (!await AdminClient.CancelEventRsvpAsync(_event.Id))
            _error = "That couldn't be changed.";

        _busy = false;
        await LoadAsync();
    }
}
