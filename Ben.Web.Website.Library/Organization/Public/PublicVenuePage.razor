@page "/o/{UrlName}/venues/{PlaceId:guid}"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject IMediaUrlBuilder MediaUrls

@* A venue's own page (item 235 phase 9): the building's story, its rooms, and what is on there.

   ONLY FOR A CONFIRMED VENUE THAT CHOSE TO SHOW IT. A page headed "the venue" is itself a claim to
   be the building; the API answers nothing until that claim has been proved and the venue has
   switched the page on, and this page says "not found" rather than guessing why.

   WHAT IS ON IS EVERYBODY'S EVENTS, not only the venue's own. A visitor to a hotel's page is asking
   what they could come to there, and the society holding a weekend in the ballroom is the answer
   as much as the hotel's own dinner is. *@

<PageTitle>@(_venue.Item?.PlaceName ?? "Venue") — IsHaunted</PageTitle>

@if (_venue.Item is { } card)
{
    @* A shared venue link shows the building and its first kept photo (audit finding A6). *@
    <Ben.Web.Website.Library.Shared.SocialCard Title="@($"{card.PlaceName} — {card.OrganizationName}")"
                                               Description="@VenueSummary(card)"
                                               RelativeUrl="@($"/o/{UrlName}/venues/{PlaceId}")"
                                               ImageUrl="@(card.Photos is { Count: > 0 } cardPhotos ? MediaUrls.VenuePhoto(cardPhotos[0].UploadFileId) : null)" />
}

<div class="home-band" id="venue-page">
    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <BenLoaderOverlay Visible="true" Text="Loading…" />
        </div>
    }
    else if (_venue.Item is not { } v)
    {
        <div class="text-center py-5" id="venue-not-found">
            <h2 class="text-muted">Venue not found</h2>
            <p class="text-secondary">This venue's page isn't open to the public, or the link is incomplete.</p>
        </div>
    }
    else
    {
        <div id="venue-summary">
        @* Signal phase 2: the venue's own first kept photograph, or a plate in its color. *@
        <PageHero TestId="venue-hero" TitleId="venue-title" Title="@v.PlaceName" Kicker="A venue"
                  PhotoUrl="@(v.Photos is { Count: > 0 } heroPhotos ? MediaUrls.VenuePhoto(heroPhotos[0].UploadFileId) : null)"
                  Hue="@TourPlate.Hue(v.PlaceName)"
                  Lede="@(string.Join(", ", new[] { v.City, v.State }.Where(p => !string.IsNullOrWhiteSpace(p))) is { Length: > 0 } where ? where : null)">
            <div class="venue-hero__by">
                Run by <a href="@($"/o/{v.OrganizationUrlName}")">@v.OrganizationName</a>
                · <a href="@($"/places/{v.PlaceId}")">The place's history on IsHaunted</a>
            </div>
        </PageHero>

        @* Ben, 10/09/2026: laid out like a public place — the venue's own words first under its cover photo,
           the map right below them, then the photos as a carousel, then everything else. *@
        @if (v.History is { Length: > 0 } history)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">About @v.PlaceName</div>
                <div class="card-body" id="venue-history" style="white-space:pre-line;">@history</div>
            </div>
        }

        @if (v.Latitude is not null && v.Longitude is not null)
        {
            <div class="mb-3" id="venue-map">
                <Ben.Web.Website.Library.Shared.InvestigationsMap
                    Pins="@([new Ben.Web.Website.Library.Shared.InvestigationMapPin(v.PlaceId, v.PlaceName, v.Latitude, v.Longitude, IsPast: true, IsPublicPlace: true)])"
                    Height="300px" />
            </div>
        }

        @if (v.Photos is { Count: > 0 } photos)
        {
            @* The pictures the venue chose to keep (item 235 phase 12), in the place page's carousel. *@
            <div id="venue-photos">
                <Ben.Web.Website.Library.Shared.PlaceMediaGallery
                    Items="@([.. photos.Select(p => new Ben.Web.Website.Library.Shared.PlaceMediaItem(
                        p.UploadFileId, MediaUrls.VenuePhoto(p.UploadFileId), "image/jpeg", v.PlaceName, p.Caption,
                        "The venue", null, null))])" />
            </div>
        }

        @* The venue's own sections, in its order (2026-10-05). *@
        @if (v.Sections is { Count: > 0 } sections)
        {
            <div id="venue-sections" class="mt-4">
                @foreach (var section in sections)
                {
                    <div class="card mb-3 venue-section">
                        <div class="card-header fw-semibold">@section.Title</div>
                        @if (section.Body is { Length: > 0 })
                        {
                            <div class="card-body" style="white-space:pre-line;">@section.Body</div>
                        }
                    </div>
                }
            </div>
        }

        <div class="card mb-3">
            <div class="card-header fw-semibold">What's on here</div>
            @if (v.Events.Count == 0)
            {
                <div class="card-body text-secondary" id="venue-events-empty">Nothing is on the calendar here yet.</div>
            }
            else
            {
                <div class="list-group list-group-flush" id="venue-events">
                    @foreach (var ev in v.Events)
                    {
                        <a class="list-group-item list-group-item-action" href="@ev.Url">
                            <div class="fw-semibold">@ev.Name</div>
                            <div class="small text-secondary">
                                @ev.StartsOn.ToShortDaySpan(ev.EndsOn)
                                · @ev.OrganizerName
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        </div>

        @if (v.Rooms.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Rooms</div>
                <div class="table-responsive">
                    <table class="table mb-0" id="venue-rooms">
                        <thead><tr><th>Room</th><th>Floor</th><th>Sleeps</th></tr></thead>
                        <tbody>
                            @foreach (var room in v.Rooms)
                            {
                                <tr>
                                    <td>
                                        @room.Name
                                        @if (room.Description is { Length: > 0 } d)
                                        {
                                            <div class="small text-secondary">@d</div>
                                        }
                                    </td>
                                    <td>@room.Floor</td>
                                    <td>@(room.Capacity?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (v.HouseRules is { Length: > 0 } rules)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">House rules</div>
                <div class="card-body" id="venue-rules" style="white-space:pre-line;">@rules</div>
            </div>
        }
    }
</div>

@code {
    /// <summary>One line for a shared link: where it is, and how many can stay.</summary>
    private static string VenueSummary(Ben.Service.Models.Entities.PublicVenueRecord v)
    {
        var where = string.Join(", ", new[] { v.City, v.State }.Where(x => !string.IsNullOrWhiteSpace(x)));
        var stay = v.MaxOvernightGuests is { } n ? $" Sleeps up to {n}." : "";
        return $"{v.PlaceName}{(where.Length > 0 ? $" in {where}" : "")} — hosted events and overnight investigations.{stay}";
    }

    [Parameter] public string UrlName { get; set; } = "";
    [Parameter] public Guid PlaceId { get; set; }

    private ItemResult<PublicVenueRecord> _venue;
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive);

        _venue = await AdminClient.GetPublicVenueAsync(UrlName, PlaceId);
        _loading = false;
        StateHasChanged();
    }
}
