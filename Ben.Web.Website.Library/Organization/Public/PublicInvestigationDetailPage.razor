@page "/o/{UrlName}/investigations/{InvestigationSlug}"
@namespace Ben.Web.Website.Library.Organization.Public
@inject IBenAdminClient AdminClient

<PageTitle>@(_inv?.Title ?? "Investigation") — @(_inv?.OrganizationName ?? UrlName)</PageTitle>

@* A group's write-up of a night's work, at an address they can put in a post. *@
@if (_inv is not null)
{
    <Ben.Web.Website.Library.Shared.SocialCard Title="@($"{_inv.Title} — {_inv.OrganizationName}")"
                                       Description="@SocialSummary"
                                       RelativeUrl="@($"/o/{UrlName}/investigations/{InvestigationSlug}")"
                                       Type="article" />
}

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else if (_inv is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Not found</h2>
        <p class="text-secondary">
            This investigation has not been published, or the address is wrong.
            <a href="/o/@UrlName">← Back to @UrlName</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:800px; margin:auto;">
        <div class="mb-3">
            <a href="@($"/o/{_inv.OrganizationUrlName}")" class="text-decoration-none small">
                &larr; @_inv.OrganizationName
            </a>
        </div>

        <h1 class="mb-1">@_inv.Title</h1>
        <p class="text-secondary mb-4">
            @_inv.ScheduledDateTime.ToLocalTime().ToDisplayDate()
            · investigated by <a href="@($"/o/{_inv.OrganizationUrlName}")">@_inv.OrganizationName</a>
        </p>

        @if (_inv.PlaceName is not null || _inv.City is not null)
        {
            <div class="card mb-3">
                <div class="card-body py-3">
                    <div class="fw-semibold">@(_inv.PlaceName ?? "Location")</div>
                    @if (_inv.City is not null)
                    {
                        <div class="text-secondary small">
                            @_inv.City@(_inv.State is null ? "" : $", {_inv.State}")
                        </div>
                    }
                    @* Said out loud, because a published account naming a town could otherwise be
                       read as naming an address. *@
                    <div class="text-secondary mt-1" style="font-size:.75rem;">
                        Locations are published to within a few miles, never as an address.
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_inv.Notes))
        {
            <div style="white-space:pre-line;">@_inv.Notes</div>
        }
        else
        {
            <p class="text-secondary">This investigation has been published, but no write-up has been added yet.</p>
        }

        @if (_inv.PlaceId is Guid placeId)
        {
            <p class="mt-4">
                <a href="@($"/places/{placeId}")">Everything investigated at this place</a>
            </p>
        }
    </div>
}

@code {
    [Parameter] public string UrlName { get; set; } = "";
    [Parameter] public string InvestigationSlug { get; set; } = "";

    private PublicInvestigationDetail? _inv;
    private bool _loading = true;

    private string SocialSummary
    {
        get
        {
            if (_inv is null) return "";

            var when  = _inv.ScheduledDateTime.ToLocalTime().ToDisplayDate();
            var where = _inv.City is string city
                ? $" in {city}{(_inv.State is string st ? $", {st}" : "")}"
                : "";

            return $"An investigation{where} on {when}, by {_inv.OrganizationName}.";
        }
    }

    // Loaded during prerender so the link preview has something to describe: the crawlers that build
    // those cards never connect the circuit, and a card assembled after first render is one nobody
    // sees. Safe here because the page is public and needs no auth to fetch.
    protected override async Task OnInitializedAsync()
    {
        _inv     = await AdminClient.GetPublishedInvestigationAsync(UrlName, InvestigationSlug);
        _loading = false;
    }
}
