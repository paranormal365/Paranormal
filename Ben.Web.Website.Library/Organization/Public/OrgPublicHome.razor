@page "/o/{UrlName}"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Web.Services
@using Ben.Data.Common.Enums
@using System.Text.Json
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager
@inject IBenUserState UserState
@inject IMediaUrlBuilder MediaUrls
@inject Microsoft.Extensions.Options.IOptions<Ben.Data.Common.SiteIdentity> SiteOptions

@* Item 154: the address must die with the feature switch, not just the links to it. *@
<FeatureGate Flag="@SiteFeatures.CmsPages">
<PageTitle>@(_org?.OrgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else if (_org is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Organization not found</h2>
        <p class="text-secondary">The organization <strong>@UrlName</strong> does not exist or has no public page.</p>
    </div>
}
else
{
    @* ── Org header ──────────────────────────────────────────────────────── *@
    <div class="container-fluid px-3 py-3" style="max-width:960px; margin:0 auto;">

        <OrgPublicBanner Name="@_org.OrgName" UrlName="@_org.OrgUrlName"
                         LogoUrl="@(_org.Logos.Any() ? AdminClient.GetFileThumbnailUrl(_org.Logos.First().UploadFileId) : null)"
                         LogoAlt="@(_org.Logos.FirstOrDefault()?.AltText)"
                         Class="mb-3">
            @* What this group is, said plainly (2026-08-24). A visitor who wants a tour and a
               visitor who wants an investigation are looking for different things, and the name
               alone rarely tells them apart. *@
            <div class="org-banner__kinds">
                <span class="org-banner__badge">
                    @Ben.Data.Common.Enums.OrganizationKindDefaults.DisplayName(_org.Kind)
                </span>
                @if (_org.RunsPublicTours && _org.Kind != Ben.Data.Common.Enums.OrganizationKind.GhostWalkingTour)
                {
                    @* An investigation group that also runs tours — worth saying, since it is why
                       they turn up in a tour search. *@
                    <span class="org-banner__badge">Runs public tours</span>
                }
            </div>
            @if (_org.PublicPhone is not null || _org.PublicEmail is not null || _org.PublicWebsite is not null)
            {
                <div class="org-banner__contact">
                    @if (_org.PublicPhone is not null)
                    {
                        <span>📞 <a href="tel:@_org.PublicPhone">@_org.PublicPhone</a></span>
                    }
                    @if (_org.PublicEmail is not null)
                    {
                        <span>✉️ <a href="mailto:@_org.PublicEmail">@_org.PublicEmail</a></span>
                    }
                    @if (_org.PublicWebsite is not null)
                    {
                        <span>🌐 <a href="@_org.PublicWebsite" target="_blank" rel="noopener noreferrer">@_org.PublicWebsite</a></span>
                    }
                </div>
            }
        </OrgPublicBanner>

        @* ── Sub-page navigation ──────────────────────────────────────────── *@
        <OrgPublicNav OrgUrlName="@_org.OrgUrlName" NavPages="@_org.NavPages"
                      ShowTours="@(_tours.Count > 0)" Class="mb-4" />

        @* ── Home page content ────────────────────────────────────────────── *@
        @if (_org.HomePage is not null)
        {
            @foreach (var section in _org.HomePage.Sections.OrderBy(s => s.SortOrder))
            {
                <OrgPublicSection Section="section" FileBaseUrl="@AdminClient.GetFileDownloadUrl(Guid.Empty).Replace(Guid.Empty.ToString(), "")" PublicMediaBaseUrl="@AdminClient.GetPublicCaseMediaBaseUrl()" />
            }
        }
        else if (_org.Facts is { } facts)
        {
            @* A default page built from what the group already keeps (item 205). Every line here
               is a record the group can check; nothing is written on their behalf. The moment
               they publish a page of their own, this one steps aside. *@
            <div class="mt-4" data-testid="default-group-page">
                <p class="lead mb-3">
                    @Ben.Data.Common.Enums.OrganizationKindDefaults.DisplayName(_org.Kind)
                    @if (facts.AreaServed is not null) { <text> serving <strong data-testid="default-area">@facts.AreaServed</strong></text> }
                    @if (facts.OnSinceYear > 0) { <text>, on @SiteOptions.Value.Name since @facts.OnSinceYear</text> }.
                </p>

                <BenFactRail Facts="@GroupFacts(facts)" Class="mb-2" />

                <div class="d-flex flex-wrap gap-2 mb-4">
                    @if (facts.IsAcceptingClients)
                    {
                        <span class="badge text-bg-success" data-testid="default-accepting">Taking new cases</span>
                    }
                    else
                    {
                        <span class="badge bg-body-secondary text-body-emphasis" data-testid="default-not-accepting">Not taking new cases right now</span>
                    }
                    @if (facts.IsAcceptingApplications)
                    {
                        <span class="badge text-bg-info">Open to new members</span>
                    }
                </div>

                @if (facts.NextPublicEvent is { } ev)
                {
                    @* The next night somebody could turn up to, given the shape it has everywhere
                       else on the site: a plate the eye finds, then the time and how full it is. *@
                    <BenSectionHeading Text="Next public event" />
                    <a class="org-next" data-testid="default-next-event"
                       href="@(string.IsNullOrWhiteSpace(ev.UrlName) ? $"/o/{_org.OrgUrlName}/events" : $"/o/{_org.OrgUrlName}/events/{ev.UrlName}")">
                        @* The night's own clock, not the reader's — Ben's rule, 2026-09-10. *@
                        @{ var (when, zone) = EventClock.InPlaceTime(ev.StartDateTime, ev.TimeZoneId); }
                        <span class="org-next__plate">
                            <span class="org-next__dow">@when.ToString("ddd")</span>
                            <span class="org-next__day">@when.Day</span>
                            <span class="org-next__mon">@when.ToString("MMM")</span>
                        </span>
                        <span class="org-next__body">
                            <span class="org-next__title">@ev.Title</span>
                            <span class="org-next__meta">
                                @(ev.IsAllDay ? "All day" : $"{when.ToDisplayTime()} {zone}")
                                @if (!string.IsNullOrWhiteSpace(ev.City)) { <text> · @ev.City</text> }
                                @if (ev.AttendeeCapacity is { } cap) { <text> · @Math.Max(0, cap - ev.AttendingCount) of @cap spaces left</text> }
                            </span>
                        </span>
                        <span class="org-next__go">See the night</span>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center text-muted mt-4">
                This organization has not published a home page yet.
            </div>
        }

        @* Item 233: Ben, "Tours are public so, they show up on the map and are searchable."
           A business's own page is the first place somebody looks for them. *@
        @if (_tours.Count > 0)
        {
            <div class="mt-4" id="org-tours">
                <BenSectionHeading Text="Tours" />
                <div class="row g-3">
                    @foreach (var tour in _tours)
                    {
                        <div class="col-md-6 col-lg-4">
                            @* ShowOrganization off: the reader is already on this business's page,
                               and "Run by Printers Alley Walks" under every card is noise there. *@
                            <BenTourCard Tour="@tour" ShowOrganization="false" />
                        </div>
                    }
                </div>
            </div>
        }

        <OrgApplyPanel OrgId="@_org.OrgId" OrgName="@_org.OrgName" />
    </div>
}

</FeatureGate>

@code {
    [Parameter] public string UrlName { get; set; } = "";

    private OrgPublicHomeResponse? _org;
    private IReadOnlyList<Ben.Service.Models.Entities.PublicTourListItem> _tours = [];

    /// <summary>
    /// The two counts a visitor takes in before reading anything, as the rail every other public
    /// page states its figures in. They were a pair of display-6 numbers with grey words under
    /// them, which is a lot of page for "1 member".
    /// </summary>
    private static IReadOnlyList<BenFactItem> GroupFacts(
        Ben.Web.Services.OrgPublicFacts facts)
    {
        var items = new List<BenFactItem>
        {
            new("Members", facts.MemberCount.ToString(),
                facts.MemberCount == 1 ? "person" : "people"),
        };

        // Shown even at zero. A lone tile reads as a page that could not find its other figures,
        // and "no public cases yet" is a fact about a group worth knowing.
        items.Add(new BenFactItem("Public cases", facts.PublicCaseCount.ToString(),
            facts.PublicCaseCount == 0 ? "none yet" : "you can read"));

        return items;
    }
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        StateHasChanged();
        _org     = await AdminClient.GetPublicOrgAsync(UrlName);
        // A group that runs none simply gets an empty list, so nothing needs to know in advance
        // which kind of business this is.
        _tours   = (await AdminClient.GetPublicToursAsync(UrlName)).Items;
        _loading = false;

        // Arrived on an address the group has since changed. The page loads either way — an old
        // link must never simply die — but the browser is moved to the current address so that what
        // gets copied, bookmarked and shared onward is the one that will still be right tomorrow.
        // Replace, not push, so Back goes where the visitor came from rather than round in a loop.
        if (_org is not null
            && !string.Equals(_org.OrgUrlName, UrlName, StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo($"/o/{_org.OrgUrlName}", replace: true);
        }
    }
}
