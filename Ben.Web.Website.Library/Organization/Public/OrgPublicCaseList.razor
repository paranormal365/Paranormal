@page "/o/{UrlName}/cases"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Data.Common.Enums
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

<PageTitle>Cases — @(_orgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:900px; margin:auto;">

        @* ── Breadcrumb nav ───────────────────────────────────────────────── *@
        <nav class="mb-4 d-flex flex-wrap gap-2">
            <a href="/o/@UrlName" class="btn btn-sm btn-outline-secondary">← @(_orgName ?? UrlName)</a>
            <span class="btn btn-sm btn-outline-primary disabled" aria-current="page">Cases</span>
        </nav>

        <h2 class="mb-3">Investigations</h2>

        @* A visitor has no account, no logs and no second opinion: if this page says the group
           has published nothing, that is the only thing they will ever know. *@
        <BenListState TItem="PublicCaseListItem" Result="@_casesResult"
                      EmptyText="No public cases have been published yet"
                      OnRetry="@LoadAsync">
        <ChildContent>
            <div class="row g-3">
                @foreach (var c in _cases)
                {
                    <div class="col-12 col-md-6">
                        <div class="card h-100 @(c.IsHaunted ? "border-warning" : "")">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="text-muted small font-monospace">@c.CaseReference</span>
                                    <span class="badge @c.Status.BadgeClass()">@c.Status.Label()</span>
                                </div>
                                <h5 class="card-title mb-1">@c.Title</h5>
                                <p class="card-text text-secondary small mb-2">@c.City, @c.State</p>
                                <p class="card-text text-muted" style="font-size:.8rem;">
                                    Opened @c.DateCaseOpened.ToDisplayDate()
                                    @if (c.DateCaseClosed.HasValue)
                                    {
                                        <span> · Closed @c.DateCaseClosed.Value.ToDisplayDate()</span>
                                    }
                                </p>
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0">
                                <a href="/o/@UrlName/cases/@c.UrlName"
                                   class="btn btn-sm btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
        </BenListState>
    </div>
}

@code {
    [Parameter] public string UrlName { get; set; } = "";

    private IReadOnlyList<PublicCaseListItem> _cases = [];
    private LoadResult<PublicCaseListItem> _casesResult;
    private string? _orgName;
    private bool _loading = true;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var org = await AdminClient.GetPublicOrgAsync(UrlName);
        _orgName = org?.OrgName;
        _casesResult = await AdminClient.GetPublicCasesAsync(UrlName);
        _cases       = _casesResult.Items;

        _loading = false;
    }

}
