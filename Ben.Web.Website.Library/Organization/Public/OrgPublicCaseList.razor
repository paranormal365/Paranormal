@page "/o/{UrlName}/cases"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Data.Common.Enums
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

<PageTitle>Cases — @(_orgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else
{
    <div class="container-fluid px-3 py-3" style="max-width:960px; margin:0 auto;">

        @* The group's own band and pills, as on its home page and its CMS pages. This page used
           to carry a pair of outline buttons of its own, so a visitor who clicked Cases arrived
           somewhere that did not look like the site they had been reading. *@
        <OrgPublicBanner Name="@(_orgName ?? UrlName)" UrlName="@UrlName"
                         PageTitle="Investigations"
                         LogoUrl="@_logoUrl" Class="mb-3" />

        <OrgPublicNav OrgUrlName="@UrlName" NavPages="@_navPages" Active="cases" Class="mb-4" />

        @* What has been published, before the cards. A group with two cases and a group with
           forty look identical until somebody counts. *@
        <BenFactRail Facts="@Summary" Class="mb-4" />

        @* A visitor has no account, no logs and no second opinion: if this page says the group
           has published nothing, that is the only thing they will ever know. *@
        <BenListState TItem="PublicCaseListItem" Result="@_casesResult"
                      EmptyText="No public cases have been published yet"
                      OnRetry="@LoadAsync">
        <ChildContent>
            <div class="row g-3">
                @foreach (var c in _cases)
                {
                    <div class="col-12 col-md-6">
                        @* The whole card is the link. It used to be a card with a View Details
                           button in its footer, which makes a reader aim at a small target for
                           the only thing the card does. *@
                        <a class="case-card @(c.IsHaunted ? "case-card--haunted" : "")"
                           href="@($"/o/{UrlName}/cases/{c.UrlName}")">
                            <span class="case-card__top">
                                <span class="case-card__ref">@c.CaseReference</span>
                                <span class="case-card__status @c.Status.BadgeClass()">@c.Status.Label()</span>
                            </span>
                            <span class="case-card__title">@c.Title</span>
                            <span class="case-card__where">@c.City, @c.State</span>
                            <span class="case-card__when">
                                Opened @c.DateCaseOpened.ToDisplayDate()
                                @if (c.DateCaseClosed is { } closed)
                                {
                                    <text> · closed @closed.ToDisplayDate()</text>
                                }
                            </span>
                        </a>
                    </div>
                }
            </div>
        </ChildContent>
        </BenListState>
    </div>
}

@code {
    [Parameter] public string UrlName { get; set; } = "";

    private IReadOnlyList<PublicCaseListItem> _cases = [];
    private LoadResult<PublicCaseListItem> _casesResult;
    private string? _orgName;
    private string? _logoUrl;
    private IReadOnlyList<OrgPublicNavItem> _navPages = [];
    private bool _loading = true;

    /// <summary>
    /// What this group has published, as the rail every other public page states a figure in.
    /// Drawn from what was loaded, so it cannot disagree with the cards below it.
    /// </summary>
    private IReadOnlyList<BenFactItem> Summary
    {
        get
        {
            if (_cases.Count == 0) return [];

            var haunted = _cases.Count(c => c.IsHaunted);

            // "Open" is status, not an empty closing date: a case published as Public or Haunted
            // has no closing date and is nonetheless finished — it is the group's conclusion, not
            // work in progress. The codebase already reads open as at-or-before Summarized, and
            // the first version of this tile said "2 still open" about two published results.
            var open = _cases.Count(c => c.Status <= CaseStatus.Summarized);

            var facts = new List<BenFactItem>
            {
                new("Published", _cases.Count.ToString(),
                    _cases.Count == 1 ? "investigation" : "investigations", Emphasis: true),
            };

            if (open > 0)
                facts.Add(new BenFactItem("Still open", open.ToString(), "being worked"));

            // Only when there are any. "Haunted 0" is a claim about a group's record that the
            // absence of the tile does not make.
            if (haunted > 0)
                facts.Add(new BenFactItem("Called haunted", haunted.ToString(),
                    haunted == 1 ? "case" : "cases"));

            return facts;
        }
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var org = await AdminClient.GetPublicOrgAsync(UrlName);
        _orgName = org?.OrgName;
        _logoUrl = org?.Logos.FirstOrDefault() is { } logo
            ? AdminClient.GetFileThumbnailUrl(logo.UploadFileId)
            : null;
        _navPages = org?.NavPages ?? [];
        _casesResult = await AdminClient.GetPublicCasesAsync(UrlName);
        _cases       = _casesResult.Items;

        _loading = false;
    }

}
