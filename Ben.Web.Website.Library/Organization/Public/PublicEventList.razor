@page "/events"
@page "/o/{UrlName}/events"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Web.Services
@using Ben.Web.Website.Library.Kit
@using Ben.Data.Common.Enums
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@* Item 154: the address must die with the feature switch, not just the links to it. *@
<FeatureGate Flag="@SiteFeatures.Events">
<PageTitle>@(UrlName is null ? "What's on" : "Events")</PageTitle>

@* Two routes, one page. Under an organization it is their events; at the top level it is
   everybody's, which is the surface that brings in somebody who has never heard of any of them. *@

@* Signal phase 2: the photograph, the title, the clock switch and the figures in one frame, where
   there used to be the section band and then a second, plain heading saying the same thing. *@
<PageHero Photo="v6-ballroom" TestId="events-hero"
          Kicker="@(UrlName is null ? "Open to anyone" : GroupName)"
          Title="@(UrlName is null ? "What's on" : "Events")"
          Lede="@(UrlName is null
                  ? "Ghost walks, public investigations, meetings and haunted weekends — opened to anyone by the groups that run them."
                  : "Events this group has opened to anyone.")"
          Facts="@Summary" Lead="@(UrlName is null ? null : BackLink)">
    @* Each walk on its own clock, or all on the reader's (2026-09-28). *@
    <div><TimeZoneSwitch Noun="event" /></div>
</PageHero>

<div class="home-band">

    @* Looking for one (event-scenario-gaps: Ben's scenario has people "search for it"). *@
    <form class="d-flex flex-wrap gap-2 mb-3" role="search" @onsubmit="SearchAsync" id="events-search">
        <label class="visually-hidden" for="events-search-words">Search events</label>
        <input id="events-search-words" class="form-control" style="max-width:28rem;flex:1 1 12rem;min-height:44px;"
               type="search" maxlength="100" placeholder="An event, a group, a tour or a town"
               @bind="_query" @bind:event="oninput" />
        <button type="submit" class="btn btn-primary" style="min-height:44px;" id="events-search-go">Search</button>
        @if (_searched is { Length: > 0 })
        {
            <button type="button" class="btn btn-outline-secondary" style="min-height:44px;" id="events-search-clear" @onclick="ClearSearchAsync">Show everything</button>
        }
    </form>

    @* This page is served to signed-out visitors, which is why the failure state matters more here
       than anywhere else: somebody who is refused sees "Nothing coming up", has no account, no
       error and no reason to try again. The empty state is kept verbatim — it says the right thing
       when it is true. Item 120. *@
    <BenListState TItem="PublicEventListItem" Result="@_events" Loading="@_loading"
                  OnRetry="@ReloadAsync">
        <Empty>
            <div>
                <div>
                    <h6 class="ben-empty__title mb-2">@(_searched is { Length: > 0 } ? "Nothing matches" : "Nothing coming up")</h6>
                    <p class="ben-empty__text mb-0" id="events-empty-text">
                        @(_searched is { Length: > 0 } words
                            ? $"No upcoming event matches “{words}”. Try fewer words, or the name of a town."
                            : UrlName is null
                            ? "No groups have public events scheduled at the moment. Worth checking back."
                            : "This group has no public events scheduled at the moment.")
                    </p>
                </div>
            </div>
        </Empty>
        <ChildContent>
        @* Grouped by the day it happens, not poured out as one run of identical cards. Eight
           nights in a row all saying "Saturday walk · Printers Alley Walks" is a list nobody
           finishes reading; the day carries the date once, and each night under it only has to
           say what is different about it.

           Times are the PLACE's, not the server's and not the reader's (Ben, 2026-09-10). A walk
           starts at eight where it starts, whoever is reading about it; the reader's own clock
           would move one night onto a different day depending on where they happen to be sitting,
           and would disagree with the guest mail and the calendar file, which both use the walk's
           time. The zone is named beside it, and the reader can switch to their own clock (2026-09-28).
           An event with no zone recorded reads on the house clock — see EventClock. *@
        @foreach (var day in _events.Items
                     .OrderBy(e => e.StartDateTime)
                     .GroupBy(e => EventClock.At(e.StartDateTime, e.TimeZoneId).Date))
        {
            <div class="ev-day">
                <span class="ev-day__plate">
                    <span class="ev-day__dow">@day.Key.ToString("ddd")</span>
                    <span class="ev-day__num">@day.Key.Day</span>
                    <span class="ev-day__mon">@day.Key.ToString("MMM")</span>
                </span>
                <span class="ev-day__label">@day.Key.ToString("dddd, MM/dd/yyyy")</span>
                <span class="ev-day__count">
                    @day.Count() @(day.Count() == 1 ? "night" : "nights")
                </span>
            </div>

            <div class="ev-list">
                @foreach (var item in day)
                {
                    var full = item.AttendeeCapacity is { } c && item.AttendingCount >= c;

                    <div class="ev-row @(full ? "ev-row--full" : "")" style="@TourPlate.HueStyle(item.TourName ?? item.OrganizationName)">
                        <span class="ev-row__time">
                            @if (item.IsAllDay)
                            {
                                <text>All day</text>
                            }
                            else
                            {
                                @* The walk's time, or the reader's if they chose (2026-09-28). *@
                                <BenTime Utc="@item.StartDateTime" ZoneId="@item.TimeZoneId" Format="BenTime.Shape.Time"
                                         LettersClass="ev-row__zone" TestId="event-time" />
                            }
                        </span>

                        <span class="ev-row__main">
                            <span class="ev-row__title">
                                @if (item.ReaderTie == EventReaderTie.YourGroup)
                                {
                                    @* Not public, so no public page: members read it on the group's calendar. *@
                                    <a href="@($"/organizations/{item.OrganizationId}/calendar")">@item.Title</a>
                                }
                                else if (item.UrlName is string slug)
                                {
                                    <a href="@($"/o/{item.OrganizationUrlName}/events/{slug}?from=events")">@item.Title</a>
                                }
                                else
                                {
                                    @item.Title
                                }
                                <EventTieBadge Tie="@item.ReaderTie" />
                            </span>

                            @* The group is named on every row. Somebody scanning this list is
                               meeting these organizations for the first time. *@
                            <span class="ev-row__by">
                                <a href="@($"/o/{item.OrganizationUrlName}")">@item.OrganizationName</a>
                                @* And which tour it is, when it is one (item 233): a business's
                                   three walks look like three unrelated evenings otherwise. *@
                                @if (item.TourName is { } tourName)
                                {
                                    <text> · </text>
                                    @if (item.TourUrlName is { } tourSlug)
                                    {
                                        <a href="@($"/o/{item.OrganizationUrlName}/tours/{tourSlug}")">@tourName</a>
                                    }
                                    else
                                    {
                                        @tourName
                                    }
                                }
                            </span>

                            <span class="ev-row__where">
                                @if (item.IsOnline)
                                {
                                    <span class="ev-row__online">Online</span>
                                }
                                @if (item.City is not null)
                                {
                                    <text>@item.City@(item.State is null ? "" : $", {item.State}")</text>
                                }
                            </span>

                            @* How long until it starts, and a thin bar filling toward it (10/16/2026). *@
                            <EventCountdown StartUtc="@item.StartDateTime" EndUtc="@item.EndDateTime"
                                            ZoneId="@item.TimeZoneId" ListedUtc="@item.ListedUtc"
                                            Name="@item.Title" Class="ev-row__countdown" />
                        </span>

                        <span class="ev-row__seats">
                            <span class="ev-row__count">
                                @if (item.AttendeeCapacity is { } cap)
                                {
                                    @(full ? "Full" : $"{Math.Max(0, cap - item.AttendingCount)} left")
                                }
                                else
                                {
                                    @($"{item.AttendingCount} coming")
                                }
                            </span>
                            @if (item.AttendeeCapacity is { } barCap && barCap > 0)
                            {
                                var taken = Math.Clamp(item.AttendingCount * 100 / barCap, 0, 100);
                                <span class="ev-row__bar" role="presentation">
                                    <span class="ev-row__fill" style="width:@(taken)%"></span>
                                </span>
                            }
                        </span>
                    </div>
                }
            </div>
        }
        </ChildContent>
    </BenListState>
</div>

</FeatureGate>

@code {
    private RenderFragment BackLink => @<a href="@($"/o/{UrlName}")">&larr; Back to @GroupName</a>;

    // The group's own name, which comes with its events; the web address ("paranormal365") was shown before.
    private string GroupName => _events.Items?.FirstOrDefault()?.OrganizationName ?? "the group";

    /// <summary>Null on the site-wide route, set when showing one group's events.</summary>
    [Parameter] public string? UrlName { get; set; }

    /// <summary>
    /// The figures over the list. Empty until something has loaded, so the rail draws nothing
    /// while the page is still fetching and nothing at all when there is nothing coming up.
    /// </summary>
    private IReadOnlyList<BenFactItem> Summary
    {
        get
        {
            var items = _events.Items;
            if (items is not { Count: > 0 }) return [];

            var soonest = items.MinBy(e => e.StartDateTime)!;
            var latest = items.MaxBy(e => e.StartDateTime)!;
            var first = EventClock.At(soonest.StartDateTime, soonest.TimeZoneId);
            var last = EventClock.At(latest.StartDateTime, latest.TimeZoneId);
            var groups = items.Select(e => e.OrganizationUrlName).Distinct().Count();

            var facts = new List<BenFactItem>
            {
                new("Coming up", items.Count.ToString(), items.Count == 1 ? "night" : "nights",
                    Emphasis: true),
                new("First", first.ToString("ddd MM/dd"), first.ToDisplayTime()),
            };

            // Only when it says something the first one did not.
            if (last.Date != first.Date)
                facts.Add(new BenFactItem("Last", last.ToString("ddd MM/dd"), last.ToDisplayTime()));

            // On a group's own page every night is theirs, so counting groups says nothing.
            if (UrlName is null)
                facts.Add(new BenFactItem("Groups", groups.ToString(),
                    groups == 1 ? "is hosting" : "are hosting"));

            return facts;
        }
    }

    private LoadResult<PublicEventListItem> _events;
    private bool _loading = true;
    private string? _loadedFor;

    /// <summary>
    /// Whether this reader is signed in and so also sees their own groups' events (10/16/2026).
    /// </summary>
    /// <remarks>
    /// Known only once sign-in has resolved, which is after the page is first drawn: the server
    /// draws the public list (what a visitor sees, unchanged), and a signed-in reader's list then
    /// replaces it once, with their groups' nights added and marked.
    /// </remarks>
    private bool _forMe;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) return;

        _forMe = true;
        var mine = await ForMeOrPublicAsync();
        // A list that could not be had for them leaves the public one standing: it is still true.
        if (!mine.Failed)
        {
            _events = mine;
            StateHasChanged();
        }
    }

    /// <summary>The signed-in reader's list; the public one if theirs cannot be had.</summary>
    private async Task<LoadResult<PublicEventListItem>> ForMeOrPublicAsync()
    {
        var mine = await AdminClient.GetPublicEventsForMeAsync(UrlName, query: _searched);
        return mine.Failed ? await AdminClient.GetPublicEventsAsync(UrlName, query: _searched) : mine;
    }

    /// <summary>What is typed in the search box, and what the list was last searched for.</summary>
    private string _query = "";
    private string? _searched;

    private async Task SearchAsync()
    {
        _searched = string.IsNullOrWhiteSpace(_query) ? null : _query.Trim();
        RenderedEvents = null;
        await ReloadAsync();
    }

    private async Task ClearSearchAsync()
    {
        _query = "";
        _searched = null;
        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var key = UrlName ?? "*";
        if (_loadedFor == key) return;
        _loadedFor = key;

        await ReloadAsync();
    }

    // ── Carried from the server render (PagesDoNotBlinkTests) ────────────────
    // The server draws this page, then the live connection builds it again as a new component with
    // none of the first one's data — so it showed its content, its spinner, and its content again.
    // What the server fetched rides into the page ([PersistentState]) and is used once, for the
    // address it was fetched for; every later load (Retry, a new address) asks the API.
    [PersistentState] public List<PublicEventListItem>? RenderedEvents { get; set; }
    [PersistentState] public string? RenderedFor { get; set; }

    private async Task ReloadAsync()
    {
        var key = UrlName ?? "*";
        if (RenderedEvents is { } carried && RenderedFor == key)
        {
            RenderedEvents = null;
            _events = LoadResult<PublicEventListItem>.Ok(carried);
            _loading = false;
            return;
        }

        _loading = true;
        StateHasChanged();
        _events  = _forMe
            ? await ForMeOrPublicAsync()
            : await AdminClient.GetPublicEventsAsync(UrlName, query: _searched);
        _loading = false;
        if (!RendererInfo.IsInteractive && !_events.Failed && PrerenderCarry.Fits(_events.Items))
        {
            RenderedEvents = [.. _events.Items];
            RenderedFor = key;
        }
        StateHasChanged();
    }
}
