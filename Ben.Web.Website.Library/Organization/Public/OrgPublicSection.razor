@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Data.Common.Enums
@using System.Text.Json

@* Renders a single CmsSection on a public org page. *@

@if (Section is null || string.IsNullOrWhiteSpace(Section.ContentJson)) { return; }

<div class="cms-section mb-4">
    @if (!string.IsNullOrWhiteSpace(Section.Title))
    {
        <h3 class="cms-section-title mb-3">@Section.Title</h3>
    }

    @switch (Section.SectionType)
    {
        case CmsSectionType.RichText:
        case CmsSectionType.CustomHtml:
            @RenderHtml()
            break;

        case CmsSectionType.ImageBanner:
            @RenderImageBanner()
            break;

        case CmsSectionType.ContactInfo:
            <div class="alert alert-light">
                <em>Contact information section — configure in org settings.</em>
            </div>
            break;

        case CmsSectionType.FileGallery:
            <div class="alert alert-light">
                <em>File gallery section.</em>
            </div>
            break;

        case CmsSectionType.MemberRoster:
            <div class="alert alert-light">
                <em>Member roster section.</em>
            </div>
            break;

        case CmsSectionType.EmbeddedInvestigations:
            @RenderEmbeddedInvestigations()
            break;

        case CmsSectionType.EmbeddedCases:
            @RenderEmbeddedCases()
            break;

        case CmsSectionType.CaseMedia:
            @RenderCaseMedia()
            break;

        default:
            <div class="text-muted small">Unknown section type.</div>
            break;
    }
</div>

@code {
    [Parameter] public OrgPublicSectionItem? Section { get; set; }
    /// <summary>Base URL prefix for file downloads, e.g. "http://localhost:5252/api/upload-files/"</summary>
    [Parameter] public string FileBaseUrl { get; set; } = "";

    /// <summary>
    /// Base URL prefix for published case media, e.g. "http://localhost:5252/api/public/cases/".
    /// </summary>
    /// <remarks>
    /// Separate from <see cref="FileBaseUrl"/> because it is a different endpoint answering a
    /// different question — that one asks whether the caller may see a file, this one asks whether
    /// a case has published it. Reusing the download URL here would have shown an authenticated
    /// author a working gallery and every visitor a row of broken images.
    /// </remarks>
    [Parameter] public string PublicMediaBaseUrl { get; set; } = "";

    /// <summary>
    /// The group's own investigations, as the server chose to publish them.
    /// </summary>
    /// <remarks>
    /// <para>Reads only what it is given. The exact coordinates and the client's real name are not
    /// withheld here — they never arrive, because the projection has no field for them. That is the
    /// point of doing the redaction in the WebApi: this component could be rewritten carelessly and
    /// still could not leak an address it never received.</para>
    ///
    /// <para>The "approximate" wording is not decoration. A visitor shown a point without being told
    /// it is a rough area will read it as the place, and a map pin is a confident thing.</para>
    /// </remarks>
    private RenderFragment RenderEmbeddedInvestigations() => @<text>
        @{
            var rows = ParseArray();
        }
        @if (rows.Count == 0)
        {
            <div class="text-muted small">Nothing to show here yet.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var row in rows)
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title mb-1">@Text(row, "title")</h5>
                                @if (Text(row, "scheduledDateTime") is { Length: > 0 } when)
                                {
                                    <div class="text-secondary small mb-2">@FormatDate(when)</div>
                                }
                                @if (Text(row, "summary") is { Length: > 0 } summary)
                                {
                                    <p class="card-text small">@summary</p>
                                }
                                @RenderPlace(row)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </text>;

    /// <summary>The group's own cases, named only as the client chose to be named.</summary>
    private RenderFragment RenderEmbeddedCases() => @<text>
        @{
            var rows = ParseArray();
        }
        @if (rows.Count == 0)
        {
            <div class="text-muted small">Nothing to show here yet.</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var row in rows)
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title mb-1">@Text(row, "title")</h5>
                                @if (Text(row, "clientName") is { Length: > 0 } client)
                                {
                                    <div class="text-secondary small mb-2">For @client</div>
                                }
                                @if (Text(row, "summary") is { Length: > 0 } summary)
                                {
                                    <p class="card-text small">@summary</p>
                                }
                                @RenderPlace(row)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </text>;

    /// <summary>
    /// Photos chosen from one of the group's cases.
    /// </summary>
    /// <remarks>
    /// <para>Draws whatever the server sent and asks no questions. Every file here has already been
    /// re-checked against the publication rule this request; ones that no longer qualify are simply
    /// not in the array. So an empty section is a real and expected state — a case unpublished last
    /// week leaves the heading and nothing under it, rather than a row of broken frames.</para>
    ///
    /// <para>Images point at the public case-media endpoint, not the ordinary download URL. That is
    /// what a visitor with no account can actually fetch, and it re-asks the same rule per byte
    /// served — so a link copied out of this page stops working when the entry goes private.</para>
    /// </remarks>
    private RenderFragment RenderCaseMedia() => @<text>
        @{
            var files = ParseArray();
        }
        @if (files.Count > 0)
        {
            <div class="row g-3">
                @foreach (var file in files)
                {
                    var caseId = Text(file, "caseId");
                    var fileId = Text(file, "uploadFileId");
                    var caption = Text(file, "caption");

                    if (caseId is null || fileId is null) { continue; }

                    <div class="col-6 col-md-4">
                        <figure class="m-0">
                            <img src="@($"{PublicMediaBaseUrl}{caseId}/media/{fileId}")"
                                 alt="@(caption ?? "Photo from this case")"
                                 class="img-fluid rounded" />
                            @if (caption is { Length: > 0 })
                            {
                                <figcaption class="text-secondary small mt-1">
                                    @caption
                                    @if (Text(file, "when") is { Length: > 0 } when)
                                    {
                                        <span> — @FormatDate(when)</span>
                                    }
                                </figcaption>
                            }
                        </figure>
                    </div>
                }
            </div>
        }
    </text>;

    private RenderFragment RenderPlace(JsonElement row) => @<text>
        @{
            var where = string.Join(", ", new[] { Text(row, "placeName"), Text(row, "city"), Text(row, "state") }
                .Where(v => !string.IsNullOrWhiteSpace(v)));
        }
        @if (where.Length > 0)
        {
            <div class="text-secondary small">
                📍 @where
                <span class="fst-italic">(approximate area — the exact location is not published)</span>
            </div>
        }
    </text>;

    /// <summary>The resolved rows, or none. Malformed content shows nothing rather than guessing.</summary>
    private List<JsonElement> ParseArray()
    {
        try
        {
            using var doc = JsonDocument.Parse(Section!.ContentJson);
            return doc.RootElement.ValueKind == JsonValueKind.Array
                ? [.. doc.RootElement.EnumerateArray().Select(e => e.Clone())]
                : [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static string? Text(JsonElement row, string property)
        => row.TryGetProperty(property, out var v) && v.ValueKind == JsonValueKind.String
            ? v.GetString()
            : null;

    private static string FormatDate(string raw)
        => DateTime.TryParse(raw, out var parsed) ? parsed.ToDisplayDate() : raw;

    private RenderFragment RenderHtml()
    {
        try
        {
            using var doc = JsonDocument.Parse(Section!.ContentJson);
            var html = doc.RootElement.TryGetProperty("html", out var h) ? h.GetString() : null;
            return @<div class="cms-richtext">@((MarkupString)(html ?? ""))</div>;
        }
        catch
        {
            return @<span />;
        }
    }

    private RenderFragment RenderImageBanner()
    {
        try
        {
            using var doc = JsonDocument.Parse(Section!.ContentJson);
            var root    = doc.RootElement;
            var fileId  = root.TryGetProperty("uploadFileId", out var f) ? f.GetString() : null;
            var altText = root.TryGetProperty("altText",      out var a) ? a.GetString() : "";
            var linkUrl = root.TryGetProperty("linkUrl",      out var l) ? l.GetString() : null;

            var imgSrc = fileId is not null ? $"{FileBaseUrl}{fileId}/download" : null;
            if (imgSrc is null) return @<span />;

            if (!string.IsNullOrWhiteSpace(linkUrl))
                return @<a href="@linkUrl" target="_blank" rel="noopener">
                           <img src="@imgSrc" alt="@altText" class="img-fluid rounded" />
                       </a>;

            return @<img src="@imgSrc" alt="@altText" class="img-fluid rounded" />;
        }
        catch
        {
            return @<span />;
        }
    }
}
