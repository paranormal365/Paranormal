@page "/o/{UrlName}/cases/{CaseRef}"
@namespace Ben.Web.Website.Library.Organization.Public
@using Ben.Data.Common.Enums
@using Ben.Web.Website.Library.Shared
@using Ben.Web.Website.Library.Organization.Cases
@using Ben.Web.Website.Library.Kit

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

<PageTitle>@(_case?.Title ?? CaseRef) — @(_case?.OrgName ?? UrlName)</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    </div>
}
else if (_case is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Case not found</h2>
        <p class="text-secondary">
            Case <strong>@CaseRef</strong> does not exist or is not publicly available.
            <a href="/o/@UrlName/cases">← Back to cases</a>
        </p>
    </div>
}
else
{
    <div class="container-fluid px-3 py-4" style="max-width:960px; margin:0 auto;">

        @* The group's own band and pills, as everywhere else under /o/. The case's reference is
           the eyebrow above its title, so a reader knows which case they are on without a third
           breadcrumb button that goes nowhere. *@
        <OrgPublicBanner Name="@_case.OrgName" UrlName="@UrlName"
                         PageTitle="@_case.Title"
                         LogoUrl="@_logoUrl" Class="mb-3" />

        <OrgPublicNav OrgUrlName="@UrlName" NavPages="@_navPages" Active="cases" Class="mb-4" />

        @* The facts of the case, in the rail every other public page states a figure in. *@
        <BenFactRail Facts="@Summary" Class="mb-4" />

        @* ── Description ──────────────────────────────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(_case.Description))
        {
            <div class="mb-4">
                <BenSectionHeading Text="Summary" />
                <div>@((MarkupString)_case.Description)</div>
            </div>
        }

        @* ── The group's finding (site evaluation 2026-09-06, W-P3) ───────────
           Directly under the client's account of what happened, which is what it answers. Shown
           only when the group switched this report on; the server decides, and sends nothing at
           all otherwise. *@
        @if (_case.Report is { } report)
        {
            <div class="mb-4" id="public-case-report">
                <BenSectionHeading Text="What we found">
                    <Note>
                        @report.Title
                        @if (report.PublishedAt is { } published)
                        {
                            <text> · @published.ToDisplayDate()</text>
                        }
                    </Note>
                </BenSectionHeading>
                @if (!string.IsNullOrWhiteSpace(report.Summary))
                {
                    <div class="mb-2">@((MarkupString)report.Summary)</div>
                }
                @if (!string.IsNullOrWhiteSpace(report.Conclusion))
                {
                    <div class="border-start border-3 ps-3 py-1">
                        <div class="text-secondary small fw-semibold mb-1">Conclusion</div>
                        <div>@((MarkupString)report.Conclusion)</div>
                    </div>
                }
            </div>
        }

        @* ── Community vote ───────────────────────────────────────────────── *@
        @* The id is what tests hold on to. The heading is prose and has already been reworded
           once; a test pinned to the words breaks on an edit that changed nothing it cares about. *@
        <div class="mb-4" id="public-case-rating">
            <BenSectionHeading Text="What people think" />
            <CaseVoteWidget CaseId="@_case.CaseId" CommentCount="@_commentCount" />
        </div>

        @* ── Timeline ─────────────────────────────────────────────────────── *@
        @if (_case.Timeline.Count > 0)
        {
            <div class="mb-4" id="public-case-timeline">
                <BenSectionHeading Text="What happened, and when" />
                <div class="timeline-list">
                    @foreach (var entry in _case.Timeline)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="flex-shrink-0 text-center" style="width:2rem;">
                                <span class="@EntryIcon(entry.EntryType)" style="font-size:1.1rem;"></span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex gap-2 align-items-baseline mb-1">
                                    @if (entry.EventDateTime.HasValue)
                                    {
                                        <span class="text-muted small">@entry.EventDateTime.Value.ToDisplayDateTime()</span>
                                    }
                                    <span class="badge @EntryBadgeClass(entry.EntryType) small">@EntryTypeLabel(entry.EntryType)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Title))
                                {
                                    <p class="mb-1 fw-semibold">@entry.Title</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.Body))
                                {
                                    <div class="text-body-secondary" style="font-size:.9rem;">
                                        @((MarkupString)entry.Body)
                                    </div>
                                }
                                @if (entry.EntryType == CaseTimelineEntryType.Evidence && entry.EvidenceFileIds.Count > 0)
                                {
                                    <div class="mt-2 d-flex flex-wrap gap-2">
                                        @foreach (var fileId in entry.EvidenceFileIds)
                                        {
                                            <EvidenceVoteWidget UploadFileId="@fileId" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light text-muted text-center">No public timeline entries yet.</div>
        }
        @* What people said. On the case's own page rather than anywhere else, which is why the
           comments button in the strip above is an anchor: it scrolls, because they are here. *@
        <CaseComments CaseId="@_case.CaseId" CountChanged="@(n => _commentCount = n)" />
    </div>
}

@code {
    [Parameter] public string UrlName  { get; set; } = "";
    [Parameter] public string CaseRef  { get; set; } = "";

    private PublicCaseDetail? _case;
    private int _commentCount;
    private string? _logoUrl;
    private IReadOnlyList<OrgPublicNavItem> _navPages = [];
    private bool _loading = true;

    /// <summary>
    /// The facts a reader takes in before any prose: which case, where, when, and whether the
    /// group concluded anything. Everything here was already on the page as grey text under the
    /// title; the rail is where every other public page puts a figure.
    /// </summary>
    private IReadOnlyList<BenFactItem> Summary
    {
        get
        {
            if (_case is null) return [];

            var facts = new List<BenFactItem>
            {
                // A case can be marked haunted without its status saying so, and the old header
                // carried a separate badge for exactly that. Kept here rather than dropped: it is
                // the group's conclusion, and the rarest thing on the page.
                new("Case", _case.CaseReference,
                    _case.IsHaunted && _case.Status != CaseStatus.Haunted
                        ? $"{_case.Status.Label()} · called haunted"
                        : _case.Status.Label(),
                    Emphasis: _case.IsHaunted),
                new("Where", _case.City, $"{_case.State}, {_case.Country}"),
                // A published or haunted case usually carries no closing date and is nonetheless
                // finished — "still being worked" under a conclusion would contradict the page it
                // sits on. Status decides which sentence, the same rule the list's tiles use.
                new("Opened", _case.DateCaseOpened.ToString("MM/dd/yyyy"),
                    _case.DateCaseClosed is { } closed ? $"closed {closed:MM/dd/yyyy}"
                    : _case.Status <= CaseStatus.Summarized ? "still being worked"
                    : "no closing date"),
            };

            // Only when the group gave one: a pseudonym is the client's own choice, and an absent
            // tile says nothing about them either way.
            if (_case.ClientName is { } client)
                facts.Add(new BenFactItem("Client", client, "as they asked to be known"));

            return facts;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        StateHasChanged();
        _case    = await AdminClient.GetPublicCaseAsync(UrlName, CaseRef);

        // The group's band and pills need its logo and its own pages, which the case payload does
        // not carry. One extra call on a page a visitor reaches by choice.
        var org = await AdminClient.GetPublicOrgAsync(UrlName);
        _logoUrl = org?.Logos.FirstOrDefault() is { } logo
            ? AdminClient.GetFileThumbnailUrl(logo.UploadFileId)
            : null;
        _navPages = org?.NavPages ?? [];

        _loading = false;
    }

    // W-A11: from the one helper. This is the PUBLIC page, so its fallback to the enum's own
    // name would have printed an internal identifier to visitors.
    private static string EntryTypeLabel(CaseTimelineEntryType t)
        => CaseTimelineEntryTypes.ShortName(t);

    private static string EntryBadgeClass(CaseTimelineEntryType t) => t switch
    {
        CaseTimelineEntryType.ClientReport     => "bg-secondary",
        CaseTimelineEntryType.InvestigatorNote => "bg-primary",
        CaseTimelineEntryType.Evidence         => "bg-success",
        CaseTimelineEntryType.ResearchNote     => "bg-info text-dark",
        _                                      => "bg-secondary",
    };

    private static string EntryIcon(CaseTimelineEntryType t) => t switch
    {
        CaseTimelineEntryType.Evidence         => "bi bi-camera",
        CaseTimelineEntryType.InvestigatorNote => "bi bi-person-badge",
        CaseTimelineEntryType.ResearchNote     => "bi bi-book",
        _                                      => "bi bi-chat-left-text",
    };
}
