@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient

<BenModal Visible="@Visible" Title="@(ExistingArea is null ? "Set Operating Area" : "Edit Operating Area")" Size="lg" Static="true">
    <ChildContent>
        <div class="p-2">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold" for="areaofoperationdialog-center-location-use-a-af4a">
                        Center Location
                        <span class="text-secondary fw-normal small ms-1">— use a city or town center, not a personal address</span>
                    </label>
                    <div class="input-group">
                        <input id="areaofoperationdialog-center-location-use-a-af4a" type="text" class="form-control" placeholder="e.g. Nashville, TN"
                               value="@_locationQuery"
                               @oninput="@(e => OnLocationQueryChanged(e.Value?.ToString() ?? string.Empty))" />
                        <button type="button" class="btn btn-secondary" @onclick="GeocodeLookup" disabled="@(!(!_isBusy && !string.IsNullOrWhiteSpace(_locationQuery)))">
                            Look Up
                        </button>
                    </div>
                    @if (_geocodeError is not null)
                    {
                        <div class="text-danger small mt-1">@_geocodeError</div>
                    }
                    @if (_geocodedLat.HasValue)
                    {
                        <div class="text-success small mt-1">
                            ✓ Location found — coordinates saved privately.
                        </div>
                    }
                </div>
                <div class="col-8">
                    <label class="form-label fw-semibold" for="areaofoperationdialog-radius-miles-1288">Radius (miles)</label>
                    <input id="areaofoperationdialog-radius-miles-1288" type="range" class="form-range" min="5m" max="200m" step="5m" @bind="@_radiusMiles" @bind:event="oninput" />
                    <div class="text-secondary small mt-1">@_radiusMiles miles</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" for="areaofoperationdialog-public-display-label-a05f">Public Display Label</label>
                    <input id="areaofoperationdialog-public-display-label-a05f" type="text" class="form-control" placeholder="e.g. Within 30 miles of Nashville, TN" @bind="@_displayLabel" @bind:event="oninput" />
                    <div class="form-text">This is what clients see — do not include your exact address.</div>
                </div>
            </div>
            @if (_dialogError is not null)
            {
                <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
            }
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveArea" disabled="@(!(!_isBusy && _geocodedLat.HasValue))"><BenIcon Name="save" Class="me-1" />
                    @(_isBusy ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid OrgId { get; set; }
    [Parameter] public OrganizationAreaOfOperationRecord? ExistingArea { get; set; }
    [Parameter] public bool IsAcceptingClients { get; set; }
    [Parameter] public bool AcceptsClientsOutsideRange { get; set; }
    [Parameter] public EventCallback<OrganizationAreaOfOperationRecord> OnSaved { get; set; }

    private string _locationQuery = "";
    private decimal? _geocodedLat;
    private decimal? _geocodedLon;
    private decimal _radiusMiles = 30;
    private string _displayLabel = "";
    private string? _geocodeError;
    private string? _dialogError;
    private bool _isBusy;

    protected override void OnParametersSet()
    {
        if (Visible)
        {
            if (ExistingArea is not null)
            {
                _geocodedLat   = ExistingArea.CenterLatitude;
                _geocodedLon   = ExistingArea.CenterLongitude;
                _radiusMiles   = ExistingArea.RadiusMiles;
                _displayLabel  = ExistingArea.DisplayLabel ?? "";
                _locationQuery = "";
            }
            else
            {
                _geocodedLat   = null;
                _geocodedLon   = null;
                _radiusMiles   = 30;
                _displayLabel  = "";
                _locationQuery = "";
            }
            _geocodeError = null;
            _dialogError  = null;
        }
    }

    private async Task OnDialogVisibleChanged(bool value)
    {
        if (!value) await Cancel();
    }

    private void OnLocationQueryChanged(string value)
    {
        _locationQuery = value;
        StateHasChanged();
    }

    private async Task GeocodeLookup()
    {
        if (string.IsNullOrWhiteSpace(_locationQuery)) return;
        _isBusy = true; _geocodeError = null; _geocodedLat = null; _geocodedLon = null;
        StateHasChanged();
        try
        {
            var result = await AdminClient.SearchGeocodingAsync(_locationQuery);
            if (result is null)
            {
                _geocodeError = "Location not found. Try a city and state (e.g. Nashville, TN).";
            }
            else
            {
                _geocodedLat = (decimal)result.Latitude!.Value;
                _geocodedLon = (decimal)result.Longitude!.Value;
                if (string.IsNullOrWhiteSpace(_displayLabel))
                    _displayLabel = $"Within {_radiusMiles} miles of {_locationQuery.Trim()}";
            }
        }
        catch { _geocodeError = "Geocoding failed. Please try again."; }
        finally { _isBusy = false; StateHasChanged(); }
    }

    private async Task SaveArea()
    {
        if (!_geocodedLat.HasValue || !_geocodedLon.HasValue)
        {
            _dialogError = "Please look up a location first.";
            return;
        }
        if (_radiusMiles < 1) { _dialogError = "Radius must be at least 1 mile."; return; }

        _isBusy = true; _dialogError = null;
        StateHasChanged();
        try
        {
            var req = new UpsertAreaOfOperationRequest(
                RadiusMiles:               _radiusMiles,
                CenterLatitude:            _geocodedLat!.Value,
                CenterLongitude:           _geocodedLon!.Value,
                DisplayLabel:              string.IsNullOrWhiteSpace(_displayLabel) ? null : _displayLabel.Trim(),
                IsAcceptingClients:        IsAcceptingClients,
                AcceptsClientsOutsideRange: AcceptsClientsOutsideRange);

            var result = await AdminClient.UpsertOrgAreaOfOperationAsync(OrgId, req);
            if (result is null)
            {
                _dialogError = "Save failed.";
            }
            else
            {
                await OnSaved.InvokeAsync(result);
                await VisibleChanged.InvokeAsync(false);
            }
        }
        catch (Exception ex) { _dialogError = ex.Message; }
        finally { _isBusy = false; StateHasChanged(); }
    }

    private async Task Cancel()
    {
        await VisibleChanged.InvokeAsync(false);
    }
}
