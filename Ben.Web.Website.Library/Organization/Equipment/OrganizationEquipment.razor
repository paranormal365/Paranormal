@namespace Ben.Web.Website.Library.Organization.Equipment
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager

@* Equipment as this group sees it. Phase 2 is members' shared personal gear; phase 3 adds the
   group's own equipment alongside it. EmbeddedMode so the same component works as an org tab and,
   later, standalone — the convention OrgPendingRequests and friends already use. *@

<div class="@(EmbeddedMode ? "" : "container-fluid py-3")">
    @if (!EmbeddedMode)
    {
        <h3 class="mb-1">Equipment<HelpLink Slug="your-equipment" Anchor="sharing-with-your-groups" /></h3>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    <BenTabs @bind-ActiveId="@_activeTab">

        <BenTab Title="The group's gear" Id="owned">
            @RenderOwned
        </BenTab>

        <BenTab Title="Members' shared gear" Id="shared">
            @RenderShared
        </BenTab>

        @* Rendered on the server's verdict, not on whether any loans exist yet — otherwise an
           approver sees no tab until somebody happens to ask for something. *@
        @if (_canReviewLoans)
        {
            <BenTab Title="Loans" Id="loans">
                @RenderLoans
            </BenTab>
        }

    </BenTabs>

    @* A link rather than a tab: moderation is a whole task somebody sits down to do, and its page
       is the only surface that names both sides of a piece of feedback. The page itself is what
       checks the caller's standing — this link is a signpost, not a gate. *@
    <div class="mt-3">
        <a href="@($"/organizations/{OrgId}/equipment-feedback")" class="small text-decoration-none">
            Equipment feedback (Administrators)
        </a>
    </div>
</div>

<OrgEquipmentEditor Visible="@_editorVisible"
                    VisibleChanged="@(v => _editorVisible = v)"
                    OrgId="@OrgId"
                    Item="@_editing"
                    OnSaved="LoadOwnedAsync" />

<Ben.Web.Website.Library.Equipment.EquipmentCheckoutRequestDialog
    Visible="@_borrowVisible"
    VisibleChanged="@(v => _borrowVisible = v)"
    ItemId="@_borrowItemId"
    ItemDisplayName="@_borrowItemName" />

<BenConfirmDialog Visible="@(_pendingDelete is not null)"
               Title="Delete this equipment?"
               Message="@($"\"{_pendingDelete?.DisplayName}\" will be removed. If it has service history you'll be asked to retire it instead.")"
               ConfirmText="Delete"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="@(() => _pendingDelete = null)" />

@code {
    private RenderFragment RenderOwned => @<text>
    <p class="text-secondary small mt-2">
        Equipment the group itself owns. Any member can see the list; adding, editing and serial
        numbers need the <strong>Equipment</strong> permission.
    </p>

    @if (_canManage)
    {
        <div class="mb-2">
            <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => OpenEditor(null))"><BenIcon Name="plus" Class="me-1" />Add equipment</button>
        </div>
    }

    @if (_ownedLoading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading the group's equipment…" />
    }
    else if (_owned.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h6 class="mb-2">This group doesn't own any equipment yet</h6>
                <p class="text-secondary small mb-0">
                    @(_canManage
                        ? "Add the group's own gear to track who has it and when it was last serviced."
                        : "Someone with the Equipment permission can add the group's gear here.")
                </p>
            </div>
        </div>
    }
    else
    {
        <TelerikGrid Data="@_owned" TItem="EquipmentItemRecord" Sortable="true" Pageable="true" PageSize="20">
            <GridColumns>
                <GridColumn Field="@nameof(EquipmentItemRecord.DisplayName)" Title="Name">
                    <Template>
                        @{ var row = (EquipmentItemRecord)context; }
                        <a href="@($"/equipment/{row.Id}")">@row.DisplayName</a>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(EquipmentItemRecord.BrandName)" Title="Make" Width="140px" />
                <GridColumn Field="@nameof(EquipmentItemRecord.ModelName)" Title="Model" Width="140px" />
                <GridColumn Title="Serial" Width="150px">
                    <Template>
                        @{ var row = (EquipmentItemRecord)context; }
                        @if (row.SerialNumber is not null)
                        {
                            <code class="small">@row.SerialNumber</code>
                        }
                        else
                        {
                            <span class="text-secondary small">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Title="Held by" Width="160px">
                    <Template>
                        @{ var row = (EquipmentItemRecord)context; }
                        @(row.CurrentHolderDisplayName ?? "In storage")
                    </Template>
                </GridColumn>

                @* Only administrators are sent counters at all, so the columns appear when the
                   payload has them rather than on a permission this page works out for itself. *@
                @if (_owned.Any(i => i.Counters is not null))
                {
                    <GridColumn Title="Views" Width="90px">
                        <Template>
                            @{ var row = (EquipmentItemRecord)context; }
                            @(row.Counters?.ViewCount.ToString() ?? "—")
                        </Template>
                    </GridColumn>
                    <GridColumn Title="Link clicks" Width="110px">
                        <Template>
                            @{ var row = (EquipmentItemRecord)context; }
                            @(row.Counters?.LinkClickCount.ToString() ?? "—")
                        </Template>
                    </GridColumn>
                }
                <GridColumn Title="Condition" Width="150px">
                    <Template>
                        @{ var row = (EquipmentItemRecord)context; }
                        @if (row.IsRetired)
                        {
                            <span class="badge bg-secondary">Retired</span>
                        }
                        else if (row.DefectNotes is not null)
                        {
                            <span class="badge bg-warning text-dark" title="@row.DefectNotes">Faulty</span>
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }
                    </Template>
                </GridColumn>
                <GridCommandColumn Width="300px">
                    <Template>
                        @{ var row = (EquipmentItemRecord)context; }
                        <div class="d-flex gap-1">
                            @if (!row.IsRetired)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenBorrow(row.Id, row.DisplayName))">Borrow</button>
                            }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/equipment/{row.Id}"))">History</button>
                            @* Buttons render from the server's verdict, never from a guess. *@
                            @if (row.Flags.CanEdit)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenEditor(row))"><BenIcon Name="edit-2" Class="me-1" />Edit</button>
                            }
                            @if (row.Flags.CanDelete)
                            {
                                <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => _pendingDelete = row)"><BenIcon Name="trash-2" Class="me-1" />Delete</button>
                            }
                        </div>
                    </Template>
                </GridCommandColumn>
            </GridColumns>
        </TelerikGrid>
    }
    </text>;

    private RenderFragment RenderShared => @<text>
    <p class="text-secondary small mt-2">
        Gear members have chosen to share with this group. Serial numbers stay with their owners and
        are never shown here.
    </p>

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading shared equipment…" />
    }
    else if (_items.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h6 class="mb-2">Nobody has shared equipment with this group yet</h6>
                <p class="text-secondary small mb-0">
                    Members share their own gear from <strong>My Equipment</strong>, piece by piece.
                </p>
            </div>
        </div>
    }
    else
    {
        <TelerikGrid Data="@_items" TItem="SharedEquipmentItemRecord"
                     Sortable="true" Pageable="true" PageSize="20">
            <GridColumns>
                <GridColumn Field="@nameof(SharedEquipmentItemRecord.OwnerDisplayName)" Title="Owner" Width="180px" />
                <GridColumn Field="@nameof(SharedEquipmentItemRecord.DisplayName)" Title="What they call it">
                    <Template>
                        @{ var row = (SharedEquipmentItemRecord)context; }
                        <a href="@($"/equipment/{row.Id}")">@row.DisplayName</a>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(SharedEquipmentItemRecord.BrandName)" Title="Make" Width="150px" />
                <GridColumn Field="@nameof(SharedEquipmentItemRecord.ModelName)" Title="Model" Width="150px" />
                <GridColumn Field="@nameof(SharedEquipmentItemRecord.CategoryName)" Title="Category" Width="170px" />
                <GridColumn Title="Borrowing" Width="230px">
                    <Template>
                        @{ var row = (SharedEquipmentItemRecord)context; }
                        @if (row.LoanAudience == EquipmentLoanAudience.NotLoanable)
                        {
                            <span class="text-secondary small">Not lent out</span>
                        }
                        else
                        {
                            @* The server decides whether this caller may actually ask; the dialog
                               shows its answer, including the reason when it is no. *@
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenBorrow(row.Id, row.DisplayName))">Ask to borrow</button>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>

        <p class="text-secondary small mt-2 mb-0">
            @_items.Count shared @(_items.Count == 1 ? "piece" : "pieces").
        </p>
    }
    </text>;

    private RenderFragment RenderLoans => @<text>
    <p class="text-secondary small mt-2">
        Every loan of this group's equipment. Approving and receiving gear back is done from
        <a href="/my-checkouts">My Checkouts</a>, which is where your own decisions queue up.
    </p>

    <TelerikGrid Data="@_loans" TItem="EquipmentCheckoutRecord" Sortable="true" Pageable="true" PageSize="20">
        <GridColumns>
            <GridColumn Field="@nameof(EquipmentCheckoutRecord.ItemDisplayName)" Title="Equipment" />
            <GridColumn Field="@nameof(EquipmentCheckoutRecord.BorrowerDisplayName)" Title="Borrower" Width="170px" />
            <GridColumn Title="For" Width="170px">
                <Template>
                    @{ var row = (EquipmentCheckoutRecord)context; }
                    @(row.BorrowedForOrganizationName ?? "Personal loan")
                </Template>
            </GridColumn>
            <GridColumn Title="Status" Width="130px">
                <Template>
                    @{ var row = (EquipmentCheckoutRecord)context; }
                    <span class="badge @StatusClass(row)">@StatusLabel(row)</span>
                </Template>
            </GridColumn>
            <GridColumn Title="Needed from" Width="130px">
                <Template>
                    @{ var row = (EquipmentCheckoutRecord)context; }
                    @(row.DateNeededFrom?.ToDisplayDate() ?? "—")
                </Template>
            </GridColumn>
            <GridColumn Title="Due" Width="140px">
                <Template>
                    @{ var row = (EquipmentCheckoutRecord)context; }
                    @if (row.DateDue is null)
                    {
                        <span class="text-secondary small">—</span>
                    }
                    else
                    {
                        <span class="@(row.IsOverdue ? "text-danger fw-semibold" : "")">
                            @row.DateDue.Value.ToDisplayDate()
                        </span>
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>
    </text>;

    private static string StatusLabel(EquipmentCheckoutRecord loan) => loan.Status switch
    {
        EquipmentCheckoutStatus.Requested  => "Waiting",
        EquipmentCheckoutStatus.Approved   => "Approved",
        EquipmentCheckoutStatus.Denied     => "Declined",
        EquipmentCheckoutStatus.Cancelled  => "Cancelled",
        EquipmentCheckoutStatus.CheckedOut => loan.IsOverdue ? "Overdue" : "Out",
        EquipmentCheckoutStatus.Returned   => "Returned",
        _                                  => loan.Status.ToString(),
    };

    private static string StatusClass(EquipmentCheckoutRecord loan) => loan.Status switch
    {
        EquipmentCheckoutStatus.Requested  => "bg-warning text-dark",
        EquipmentCheckoutStatus.Approved   => "bg-info text-dark",
        EquipmentCheckoutStatus.CheckedOut => loan.IsOverdue ? "bg-danger" : "bg-success",
        EquipmentCheckoutStatus.Returned   => "bg-body-secondary text-body-secondary border",
        _                                  => "bg-secondary",
    };

    [Parameter, EditorRequired] public Guid OrgId { get; set; }
    [Parameter] public bool EmbeddedMode { get; set; }

    private List<SharedEquipmentItemRecord> _items = [];
    private List<EquipmentItemRecord> _owned = [];
    private List<EquipmentCheckoutRecord> _loans = [];
    private bool _canReviewLoans;
    private string _activeTab = "owned";
    private bool _loading = true;
    private bool _ownedLoading = true;
    private string? _error;
    private Guid _loadedForOrg;

    private EquipmentItemRecord? _editing;
    private EquipmentItemRecord? _pendingDelete;
    private bool _editorVisible;
    private bool _borrowVisible;
    private Guid _borrowItemId;
    private string? _borrowItemName;

    private void OpenBorrow(Guid itemId, string displayName)
    {
        _borrowItemId = itemId;
        _borrowItemName = displayName;
        _borrowVisible = true;
    }

    /// <summary>
    /// The server's verdict on whether this caller may add equipment — rendered, never re-derived.
    /// It arrives alongside the list rather than inside it, because an empty list still has to be
    /// able to say "you may add the first piece."
    /// </summary>
    private bool _canManage;

    protected override async Task OnParametersSetAsync()
    {
        if (OrgId == Guid.Empty || _loadedForOrg == OrgId) return;
        _loadedForOrg = OrgId;
        await LoadOwnedAsync();
        await LoadAsync();
        // Empty for anyone without the checkout permission — the endpoint 404s and the client
        // turns that into an empty list, which is exactly the right default here.
        var loans = await AdminClient.GetOrgEquipmentCheckoutsAsync(OrgId);
        _canReviewLoans = loans.CanReviewLoans;
        _loans = [.. loans.Items];
    }

    /// <summary>Re-reads the loan queue — approving elsewhere should not leave this stale.</summary>
    private async Task LoadLoansAsync()
    {
        var loans = await AdminClient.GetOrgEquipmentCheckoutsAsync(OrgId);
        _canReviewLoans = loans.CanReviewLoans;
        _loans = [.. loans.Items];
        StateHasChanged();
    }

    private async Task LoadOwnedAsync()
    {
        _ownedLoading = true;
        try
        {
            var result = await AdminClient.GetOrgEquipmentAsync(OrgId);
            _owned = [.. result.Items];
            _canManage = result.CanManage;
        }
        catch (Exception ex)
        {
            _error = $"The group's equipment could not be loaded: {ex.Message}";
        }
        _ownedLoading = false;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = [.. await AdminClient.GetOrgSharedEquipmentAsync(OrgId)];
        }
        catch (Exception ex)
        {
            _error = $"Shared equipment could not be loaded: {ex.Message}";
        }
        _loading = false;
        StateHasChanged();
    }

    private void OpenEditor(EquipmentItemRecord? item)
    {
        _editing = item;
        _editorVisible = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_pendingDelete is null) return;
        var target = _pendingDelete;
        _pendingDelete = null;

        // A refusal here is the expected answer for gear with history, not a failure.
        if (!await AdminClient.DeleteOrgEquipmentAsync(OrgId, target.Id))
            _error = $"\"{target.DisplayName}\" has service history, so it can't be deleted. Retire it instead.";

        await LoadOwnedAsync();
    }
}
