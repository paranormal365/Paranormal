@page "/organizations/{OrgId:guid}/equipment-feedback"
@namespace Ben.Web.Website.Library.Organization.Equipment
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

<PageTitle>Equipment Feedback</PageTitle>

@* Moderation. A page, per the standing rule — this is a whole task somebody sits down to do, and
   it is the one surface in the feature that names both sides of a piece of feedback, because acting
   on a complaint means knowing who wrote what about whom. *@

<div class="container-fluid py-3" style="max-width:1100px;">
    <div class="mb-3">
        <a href="@($"/organizations/{OrgId}")" class="text-decoration-none small">&larr; Back to the group</a>
    </div>

    <h3 class="mb-1">Equipment feedback<HelpLink Slug="your-equipment" Anchor="feedback-and-moderation" /></h3>
    <p class="text-secondary small mb-4">
        Everything left about this group's gear and its members' loans. Nobody's own feedback is shown
        to them anywhere else in the app — this page exists so a complaint can be acted on, not
        browsed.
    </p>

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading…" />
    }
    else if (_denied)
    {
        <div class="card"><div class="card-body text-center py-5">
            <h6 class="mb-2">Not available</h6>
            <p class="text-secondary small mb-0">Only this group's Administrators and Owner can moderate feedback.</p>
        </div></div>
    }
    else if (_rows.Count == 0)
    {
        <p class="text-secondary small mb-0">No feedback has been left yet.</p>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <TelerikGrid Data="@_rows" TItem="ModeratedFeedbackRecord" Sortable="true" Pageable="true" PageSize="20">
            <GridColumns>
                <GridColumn Field="@nameof(ModeratedFeedbackRecord.ItemDisplayName)" Title="Equipment" Width="180px" />
                <GridColumn Title="Direction" Width="150px">
                    <Template>
                        @{ var row = (ModeratedFeedbackRecord)context; }
                        @(row.Role == EquipmentFeedbackRole.Lender ? "Lender → borrower" : "Borrower → lender")
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ModeratedFeedbackRecord.AuthorDisplayName)" Title="Written by" Width="150px" />
                <GridColumn Field="@nameof(ModeratedFeedbackRecord.SubjectDisplayName)" Title="About" Width="150px" />
                <GridColumn Title="What was said">
                    <Template>
                        @{ var row = (ModeratedFeedbackRecord)context; }
                        @if (row.Rating is int rating)
                        {
                            <span class="badge bg-secondary me-2">@rating/5</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.CounterpartyComment))
                        {
                            <div class="small" style="white-space:pre-line;">@row.CounterpartyComment</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.ProductComment))
                        {
                            <div class="small text-secondary" style="white-space:pre-line;">
                                <em>About the gear (public):</em> @row.ProductComment
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Title="" Width="110px">
                    <Template>
                        @{ var row = (ModeratedFeedbackRecord)context; }
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => AskRemoveAsync(row))" disabled="@(!(!_busy))">Remove</button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </TelerikGrid>
    }
</div>

<BenModal Visible="@(_pendingRemoval is not null)" Title="Remove this feedback?">
    <ChildContent>
        @if (_pendingRemoval is not null)
        {
            <p>
                Remove what <strong>@_pendingRemoval.AuthorDisplayName</strong> wrote about
                <strong>@(_pendingRemoval.SubjectDisplayName ?? "the other party")</strong>? This cannot be undone.
            </p>
        }
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-secondary" @onclick="@(() => _pendingRemoval = null)" disabled="@(!(!_busy))">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="RemoveAsync" disabled="@(!(!_busy))">Remove</button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }

    private IReadOnlyList<ModeratedFeedbackRecord> _rows = [];
    private ModeratedFeedbackRecord? _pendingRemoval;
    private bool _loading = true, _busy, _denied;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Null means refused, empty means none yet — two different things to tell somebody.
        var rows = await AdminClient.GetEquipmentFeedbackForModerationAsync(OrgId);
        _denied = rows is null;
        _rows   = rows ?? [];
        _loading = false;
        StateHasChanged();
    }

    private Task AskRemoveAsync(ModeratedFeedbackRecord row)
    {
        _pendingRemoval = row;
        _error = null;
        return Task.CompletedTask;
    }

    private async Task RemoveAsync()
    {
        if (_pendingRemoval is null) return;
        _busy = true; _error = null;

        if (!await AdminClient.DeleteEquipmentFeedbackAsync(OrgId, _pendingRemoval.Id))
            _error = "That couldn't be removed.";

        _pendingRemoval = null;
        _busy = false;
        await LoadAsync();
    }
}
