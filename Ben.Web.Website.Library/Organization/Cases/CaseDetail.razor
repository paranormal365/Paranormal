@page "/organizations/{OrgId:guid}/cases/{CaseId:guid}"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject SiteFeaturesProvider Features
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>@(_case?.DisplayLabel ?? "Case")</PageTitle>

@if (_case is null && !_loaded)
{
    <BenLoaderOverlay Visible="true" Text="Loading case…" />
    return;
}

@if (_error is not null)
{
    <div class="container py-3"><div class="alert alert-danger">@_error</div></div>
    return;
}

@* A 403 or 404 comes back as null, and a null used to render nothing at all — a member whose
   role does not include reading cases got a blank page under a "Case" title, from a desk that
   had listed the case as a link (2026-09-06 evaluation, W-M1). Say what happened instead. *@
@if (_loaded && _case is null)
{
    <div class="container py-3">
        <div class="alert alert-warning" id="case-not-available">
            <strong>This case isn't available to you.</strong>
            It may belong to a group you're not in, or your role in the group may not include reading
            cases — an administrator can give you a role that does.
        </div>
    </div>
    return;
}

@if (_case is not null)
{
    <div class="container-fluid py-3" style="max-width:1000px;">

        @* Item 184 Phase D: a lapse took this case off the public site; renewal makes this
           banner's one click put it back. The click runs through the normal Update gate, so a
           group still on a plan without private-residence work sees the refusal sentence here. *@
        @if (_case.WasPublicBeforeLapse == true && !_case.IsPublic)
        {
            <div class="alert alert-warning d-flex align-items-center gap-3 flex-wrap" id="case-republish-banner">
                <div class="flex-grow-1">
                    <strong>This case came off the public site when the subscription lapsed.</strong>
                    Its public page returns the moment it is republished.
                </div>
                <button type="button" class="btn btn-warning btn-sm text-nowrap" id="case-republish"
                        disabled="@_isBusy" @onclick="RepublishAsync">Republish</button>
            </div>
            @if (_republishError is not null)
            {
                <div class="alert alert-danger py-2" id="case-republish-error">@_republishError</div>
            }
        }

        @* ── Header ────────────────────────────────────────────────────────── *@
        <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="/organizations/@OrgId/cases" class="text-secondary small">← Cases</a>
                </div>
                <h3 class="mb-0">@_case.DisplayLabel<HelpLink Slug="working-a-case" Anchor="the-case-tabs" /></h3>
                <div class="text-secondary small mt-1">
                    @_case.City, @_case.State ·
                    Opened @_case.DateCaseOpened.ToViewerLocalTime(UserState).ToDisplayDate()
                    @if (_case.IsPublic && _case.Status != CaseStatus.Public) { <span class="badge bg-info text-dark ms-2">Public</span> }
                    @if (!string.IsNullOrEmpty(_case.PublicPseudonym))
                    {
                        <span class="ms-2 text-secondary">Public name: <em>@_case.PublicPseudonym</em></span>
                    }
                </div>
                <div class="text-secondary small mt-1">
                    Case Manager:
                    @if (!string.IsNullOrEmpty(_case.CaseManagerDisplayName))
                    {
                        <strong>@_case.CaseManagerDisplayName</strong>
                    }
                    else
                    {
                        <em class="text-warning">Unassigned</em>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <span class="badge fs-6 @_case.Status.BadgeClass()">
                    @_case.Status.Label()
                </span>
                @* The mixer's only outcome is attaching a rendered file to this case, and the
                   export endpoint requires Cases.Create. The button was shown to everyone, so a
                   read-only member could arrange a whole mix and meet a 403 at the end of it
                   (2026-09-06 audio walk, finding K-perm). Same grant, same door. *@
                @if (_perms?.May(Ben.Data.Common.Enums.OrganizationPermissionArea.Cases,
                                 Ben.Data.Common.Enums.OrganizationSecurityAction.Create) == true)
                {
                    <button type="button" id="case-audio-mixer" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/{CaseId}/audio-mix"))">
                        🎚 Audio Mixer
                    </button>
                }
                <button type="button" id="case-tour-launch" class="btn btn-outline-secondary btn-sm"
                        title="How cases go public" @onclick="StartTourAsync">
                    <BenIcon Name="help-circle" />
                    <span class="visually-hidden">How cases go public</span>
                </button>
                @* IH-03 step 2: the same Cases.Update grant CaseController checks on PUT. A
                   member who cannot edit is no longer shown the door to a refusal. *@
                @if (_perms?.May(Ben.Data.Common.Enums.OrganizationPermissionArea.Cases,
                                 Ben.Data.Common.Enums.OrganizationSecurityAction.Update) == true)
                {
                    <button type="button" id="case-edit" class="btn btn-secondary btn-sm" @onclick="OpenEditDialog"><BenIcon Name="edit-2" Class="me-1" />Edit Case</button>
                }
            </div>
        </div>

        @* ── Tab strip ─────────────────────────────────────────────────────── *@
        <BenTabs @bind-ActiveId="_activeTabId">

            @* ── Overview ────────────────────────────────────────────────── *@
            <BenTab Title="Overview" Id="overview">
                <div class="row g-4 mt-1">
                    <div class="col-md-8">
                        @if (!string.IsNullOrWhiteSpace(_case.Description))
                        {
                            <div class="card">
                                <div class="card-header fw-semibold">Case Summary</div>
                                <div class="card-body">@((MarkupString)_case.Description)</div>
                            </div>
                        }

                        @* ── What the client actually submitted ───────────────
                           Kept visually distinct from the Case Summary above: that one starts as a
                           copy of this and is then edited freely, so the two disagree within days.
                           This is the client's own words, read-only. *@
                        @if (_clientRequest is { } req)
                        {
                            <div class="card mb-3 border-info">
                                <div class="card-header fw-semibold d-flex align-items-center gap-2">
                                    <BenIcon Name="user" />
                                    Original Request
                                    <span class="ms-auto text-secondary small fw-normal">
                                        as submitted by the client on
                                        @req.SubmittedUtc.ToViewerLocalTime(UserState).ToDisplayDate()
                                    </span>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrWhiteSpace(req.Description))
                                    {
                                        <div class="mb-3">@((MarkupString)req.Description)</div>
                                    }
                                    else
                                    {
                                        <div class="text-secondary fst-italic mb-3">
                                            The client didn't write a description.
                                        </div>
                                    }

                                    <dl class="row mb-0 small">
                                        <dt class="col-sm-3">Address given</dt>
                                        <dd class="col-sm-9">
                                            @req.StreetAddress1@(string.IsNullOrWhiteSpace(req.StreetAddress2) ? "" : $", {req.StreetAddress2}")<br />
                                            @req.City, @req.State @req.ZipCode @req.Country
                                        </dd>
                                        @if (req.Gender != ClientGender.NotProvided || req.BirthYear.HasValue)
                                        {
                                            <dt class="col-sm-3">Client</dt>
                                            <dd class="col-sm-9">
                                                @if (req.Gender != ClientGender.NotProvided) { <text>@req.Gender</text> }
                                                @if (req.BirthYear is { } year)
                                                {
                                                    <text>@(req.Gender != ClientGender.NotProvided ? ", " : "")born @year</text>
                                                }
                                            </dd>
                                        }
                                    </dl>

                                    @if (req.Files.Count > 0)
                                    {
                                        <div class="mt-3 pt-3 border-top">
                                            <div class="fw-semibold small mb-2">
                                                Attached by the client (@req.Files.Count)
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var f in req.Files)
                                                {
                                                    @* A plain link, matching how every other file in
                                                       the library is offered — the download endpoint
                                                       applies its own access checks. *@
                                                    <div class="d-flex align-items-center gap-2 small">
                                                        <BenIcon Name="paperclip" />
                                                        <a href="@AdminClient.GetFileDownloadUrl(f.UploadFileId)"
                                                           target="_blank" rel="noopener"
                                                           class="text-truncate" style="max-width:280px;"
                                                           title="@f.FileName">@f.FileName</a>
                                                        <span class="text-secondary">@FormatBytes(f.FileSize)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header fw-semibold">Details</div>
                            <div class="card-body">
                                <dl class="row mb-0 small">
                                    <dt class="col-5">Reference</dt>
                                    <dd class="col-7">@_case.CaseReference</dd>
                                    <dt class="col-5">Address</dt>
                                    <dd class="col-7">
                                        @_case.StreetAddress1<br />
                                        @_case.City, @_case.State @_case.ZipCode
                                    </dd>
                                    @if (_case.ClientRequestId.HasValue)
                                    {
                                        <dt class="col-5">Source</dt>
                                        <dd class="col-7">
                                            Client Request
                                            @* Used to be these two words and nothing else. Points at
                                               the card that now renders the request itself. *@
                                            @if (_clientRequest is not null)
                                            {
                                                <div class="text-secondary small">see Original Request</div>
                                            }
                                        </dd>
                                    }
                                    else
                                    {
                                        <dt class="col-5">Source</dt>
                                        <dd class="col-7">Internally Proposed</dd>
                                    }
                                    @if (_case.DateCaseClosed.HasValue)
                                    {
                                        <dt class="col-5">Closed</dt>
                                        <dd class="col-7">@_case.DateCaseClosed.Value.ToViewerLocalTime(UserState).ToDisplayDate()</dd>
                                    }
                                </dl>
                            </div>
                        </div>

                        <CaseContactsPanel OrgId="@OrgId" CaseId="@CaseId" />
                    </div>
                </div>
            </BenTab>

            @* ── Timeline ─────────────────────────────────────────────────── *@
            <BenTab Title="Timeline" Id="timeline">
                <div class="mt-2">
                    <CaseTimeline OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Investigations ───────────────────────────────────────────── *@
            <BenTab Title="Investigations" Id="investigations">
                <div class="mt-2">
                    <InvestigationPanel OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Files ─────────────────────────────────────────────────────── *@
            <BenTab Title="Files" Id="files">
                <div class="mt-2">
                    <CaseFiles OrgId="@OrgId" CaseId="@CaseId" Permissions="@_perms" />
                </div>
            </BenTab>

            @* ── Transfers ────────────────────────────────────────────────── *@
            <BenTab Title="Transfers" Id="transfers">
                <div class="mt-2">
                    <CaseTransferPanel OrgId="@OrgId" CaseId="@CaseId" IsPrivateEngagement="@(_case?.IsPrivateEngagement == true)" />
                </div>
            </BenTab>

            @* ── Client Messages ─────────────────────────────────────────────── *@
            <BenTab Id="messages" Title="@MessagesTabTitle">
                <div class="mt-2" style="max-width:680px;">
                    <CaseMessageThread CurrentSide="@Ben.Data.Common.Enums.CaseMessageSide.Organization"
                                       LoadMessages="@LoadOrgMessages"
                                       PostMessage="@PostOrgMessage" />
                </div>
            </BenTab>

            @* ── Report Builder ──────────────────────────────────────────────── *@
            <BenTab Title="Reports" Id="reports">
                <div class="mt-2">
                    <ReportBuilder OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Research ─────────────────────────────────────────────────────── *@
            <BenTab Title="Research" Id="research">
                <div class="mt-2">
                    <CaseResearch OrgId="@OrgId" CaseId="@CaseId" Permissions="@_perms" />
                </div>
            </BenTab>
            @* ── Notes ───────────────────────────────────────────────────────────── *@
            <BenTab Title="Notes" Id="notes">
                <div class="mt-2">
                    <CaseNotes OrgId="@OrgId" CaseId="@CaseId" Permissions="@_perms" />
                </div>
            </BenTab>

            @* ── Video Editor ────────────────────────────────────────────────────── *@
            @* Shown only when the editor is on. The page behind this link is gated, so with the
               feature switched off the tab was still there and its one button led to "Page not
               found" — a link that always shows and sometimes works is worse than no link
               (2026-09-05 audit, site-10). The tab and the page read the same provider, so they
               cannot disagree. *@
            @if (Features.IsOn(SiteFeatures.VideoEditor))
            {
                <BenTab Title="Video" Id="video">
                    <div class="mt-3">
                        <p class="text-muted small mb-2">Create and manage video projects for this case. The video editor opens full-screen.</p>
                        <a href="/organizations/@OrgId/cases/@CaseId/video-editor"
                           class="btn btn-sm btn-outline-primary">
                            Open Case Video Editor →
                        </a>
                    </div>
                </BenTab>
            }
        </BenTabs>
    </div>
}

@* ── Item 182: apply privacy protections after an upgrade ─────────────────── *@
<BenModal @bind-Visible="@_showPrivacyResult" Title="Privacy protections applied">
    <ChildContent>
        @if (_privacyResult is { } r)
        {
            <ul class="mb-3">
                <li>@(r.MadePrivate ? "The case is now private." : "The case was already private.")</li>
                <li>@(r.LocationGeneralized ? "The exact coordinates were removed." : "There were no exact coordinates stored.")</li>
                <li>
                    @r.FilesStripped file(s) had their location data removed just now;
                    @r.FilesAlreadyClean already had.
                    @if (r.FilesUnstrippable > 0)
                    {
                        <text>@r.FilesUnstrippable could not be cleaned on this site — audio and video need the media tool, and your plan must include it.</text>
                    }
                </li>
            </ul>

            @if (r.WasEverPublic)
            {
                @* The half that cannot be fixed by software, said plainly rather than buried. *@
                <div class="alert alert-warning py-2">
                    <strong>This case was public before now.</strong> Anything a visitor already saw,
                    a search engine already indexed, or somebody already saved cannot be recalled.
                    Making it private stops it going further; it does not undo what has been.
                </div>
            }

            @if (r.NameOccurrences.Count > 0)
            {
                <p class="fw-semibold mb-1">Your client's name still appears in text somebody wrote:</p>
                <p class="text-secondary small">
                    These are left exactly as written — an account of a night is the investigator's,
                    and a find-and-replace through it can change what it says. Edit the ones that
                    should use the pseudonym instead.
                </p>
                <ul class="mb-0">
                    @foreach (var o in _privacyResult.NameOccurrences)
                    {
                        <li>@o.Where — @o.Field (<code>@o.Matched</code>)</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-success mb-0">No prose on this case names the client.</p>
            }
        }
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-primary" @onclick="@(() => _showPrivacyResult = false)">Close</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Edit dialog ──────────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showEdit" Title="Edit Case">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="casedetail-case-label-surname-city-0146">Case Label <span class="text-secondary fw-normal small">(surname, city state)</span></label>
                <input id="casedetail-case-label-surname-city-0146" type="text" class="form-control" @bind="@_editTitle" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Status</label>
                <BenSelect Data="@_statusOptions" @bind-Value="@_editStatus" TextField="@nameof(StatusOption.Label)" ValueField="@nameof(StatusOption.Value)" Width="100%" />
                @* Item 183. There is no Delete on this dialog and there never was; until now
                   nothing said so, which reads as an oversight rather than a rule. A case is a
                   record of real work, usually for a client, so it is closed and kept. The one
                   route out for a genuine mistake is named, because a rule with no path is
                   worse than no rule. *@
                <p class="text-secondary small mt-2 mb-0" data-testid="cases-are-closed-not-deleted">
                    A case is never deleted — set it to <strong>Closed</strong> and it stays as a
                    record of the work. Opened one by mistake, or twice?
                    <a href="/contact">Ask us to remove it</a>.
                </p>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Description (optional HTML summary)</label>
                <TelerikEditor @bind-Value="@_editDescription" Height="200px" />
            </div>
            <div class="col-md-8">
                <label class="form-label fw-semibold" for="casedetail-public-pseudonym-88c6">Public Pseudonym</label>
                <input id="casedetail-public-pseudonym-88c6" type="text" class="form-control" placeholder="e.g. The Henderson Family" @bind="@_editPseudonym" @bind:event="oninput" />
                <div class="form-text">Shown on public pages instead of real client name.</div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-2 pt-4">
                <input type="checkbox" class="form-check-input" id="case-public" @bind="@_editIsPublic" />
                <label for="case-public" class="form-label mb-0">Make Public</label>
            </div>
            @* Item 193: this rendered for every group, so a free-tier group could tick it, save,
               and collect a 400 from PrivateCaseGate. The plan is knowable before the click — say
               so beside the control rather than after the attempt. Already-private cases keep the
               box readable (and clearable): the plan governs new commitments, not work in hand. *@
            @{ var mayGoPrivate = _planIncludesPrivate || _editIsPrivate; }
            <div class="col-12 d-flex align-items-start gap-2">
                <input type="checkbox" class="form-check-input mt-1" id="case-private-engagement"
                       @bind="@_editIsPrivate" disabled="@(!mayGoPrivate)" />
                <div>
                    <label for="case-private-engagement" class="form-label mb-0">Private engagement<HelpLink Slug="working-a-case" Anchor="private-engagements" /></label>
                    <div class="form-text">
                        A client's home rather than a public place. Real names are replaced on every
                        public page, and publishing the case requires a plan that includes
                        private-residence work.
                    </div>
                    @if (!mayGoPrivate)
                    {
                        <div class="form-text text-warning" data-testid="private-needs-plan">
                            Your group's plan covers public investigations only.
                            <a href="/pricing">See what each plan includes.</a>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Case Manager</label>
                <BenSelect Data="@_memberOptions" @bind-Value="@_editCaseManagerId" TextField="@nameof(MemberOption.Label)" ValueField="@nameof(MemberOption.Id)" DefaultText="— Unassigned —" Width="100%" />
            </div>
        </div>
        @if (_leakWarnings.Count > 0)
        {
            <div class="alert alert-warning mt-3 mb-0" id="case-title-leak-warning">
                <strong>Before this goes public:</strong>
                <ul class="mb-1">
                    @foreach (var w in _leakWarnings) { <li>@w</li> }
                </ul>
                <span class="small">This is a warning, not a refusal — click Save again to publish with this title.</span>
            </div>
        }
        @if (_editError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_editError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-outline-secondary me-auto" id="case-apply-privacy"
                    @onclick="ApplyPrivacyAsync" disabled="@_isBusy"
                    title="Make this case private, remove exact coordinates, clean the files, and list any prose naming the client.">
                Apply privacy protections
            </button>
            <button type="button" class="btn btn-secondary" @onclick="@(() => _showEdit = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveEdit" disabled="@(!(!_isBusy))"><BenIcon Name="save" Class="me-1" />
                @(_isBusy ? "Saving…" : "Save")
            </button>
        </div>
    </ChildContent>
</BenModal>

<BenTour @ref="_tourRef" Model="@_tour" OnEnded="@OnTourEndedAsync" />

@code {
    // ── Item 166 W4(b): how a case goes public — and what stays hidden when it does. ──
    // NOT auto-launched: case pages are visited constantly, and a tour ambushing the first
    // case someone opens would teach at the worst moment. The ? beside Edit Case launches it.
    private const string PublishTourName = "public-case-pages";
    private BenTour? _tourRef;
    private readonly TourModel _tour = new(
    [
        new TourModel.TourStep("#case-edit",
            "Publishing starts in Edit",
            "A case reaches the public in two moves, both in Edit Case: set the status, and tick Make Public. Until then, nothing about it exists outside your group."),
        new TourModel.TourStep("#casedetail-public-pseudonym-88c6",
            "Nobody's real name",
            "The Public Pseudonym replaces the client's name on every public surface — pick something like \"The Henderson Family\". Addresses are generalized the same way: public pages show the area, never the street. (This field lives in the Edit Case dialog.)"),
        new TourModel.TourStep("#tab-files",
            "What media may go public",
            "Publishing the case publishes its story, not its files. A photo appears publicly only when it's placed in a case slot on one of your CMS pages and approved for publication — the general Files tab is never publishable."),
        new TourModel.TourStep("#tab-overview",
            "Where visitors see it",
            "Published cases appear on your group's public site — the pages you build under CMS. Check the result signed out: the public sees less than you do, and that's the point."),
    ]);

    private async Task StartTourAsync()
    {
        if (_tourRef is not null) await _tourRef.StartAsync();
    }

    private async Task OnTourEndedAsync(bool completed)
    {
        try { await AdminClient.DismissTourAsync(PublishTourName, completed); } catch { }
    }

    /// <summary>Tab label with its unread count. A property, not an inline expression: an
    /// interpolated string nested in an attribute's own quotes does not parse.</summary>
    private string MessagesTabTitle => _unreadCount > 0 ? $"Messages ({_unreadCount})" : "Messages";

    [Parameter] public Guid OrgId { get; set; }
    [Parameter] public Guid CaseId { get; set; }

    /// <summary>Selects the initial tab, e.g. "?tab=investigations" — used by My Investigations' clickable cards.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }

    private CaseRecord? _case;

    /// <summary>
    /// The client request this case came from, when there is one and the caller may read it.
    /// Null is the normal state for an internally-raised case, so it is not treated as an error.
    /// </summary>
    private CaseClientRequestRecord? _clientRequest;
    private bool _loaded;
    private string? _error;
    private bool _isBusy;
    private int _unreadCount;
    private string _activeTabId = "overview";

    private static string TabIdFor(string? tab) => tab?.ToLowerInvariant() switch
    {
        "timeline"       => "timeline",
        "investigations" => "investigations",
        "files"          => "files",
        "transfers"      => "transfers",
        "messages"       => "messages",
        "reports"        => "reports",
        "research"       => "research",
        "notes"          => "notes",
        "video"          => "video",
        _                => "overview",
    };

    // Edit dialog
    private bool _showEdit;
    private string _editTitle        = "";
    private CaseStatus _editStatus   = CaseStatus.Accepted;
    private string _editDescription  = "";
    private string _editPseudonym    = "";
    private bool _editIsPublic;
    private bool _editIsPrivate;

    /// <summary>What this viewer may do with cases in this group (IH-03 step 2).</summary>
    /// <remarks>Fails closed: an unknown verdict hides the control rather than offering it.</remarks>
    private MyOrgPermissionsItem? _perms;

    /// <summary>Whether the group's plan covers private-residence work (item 193).</summary>
    /// <remarks>
    /// Starts TRUE and is narrowed by what the server says, matching the server's own fail-open
    /// rule: only a plan that explicitly excludes the capability refuses. A lookup that fails must
    /// not disable a control the group is entitled to.
    /// </remarks>
    private bool _planIncludesPrivate = true;
    private Guid? _editCaseManagerId;
    private string? _editError;
    private List<MemberOption> _memberOptions = [];

    private static readonly List<StatusOption> _statusOptions = Enum
        .GetValues<CaseStatus>()
        .Select(s => new StatusOption(s, s.Label()))
        .ToList();

    private Guid _loadedCaseId;

    protected override void OnInitialized()
    {
        _activeTabId = TabIdFor(InitialTab);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Guards against a same-route navigation (e.g. a "next case" link) reusing this component
        // instance for a different CaseId — OnInitialized/OnAfterRenderAsync(firstRender) only fire
        // once per instance, so without this the page would silently keep showing the previous case.
        if (!_loaded || CaseId == _loadedCaseId) return;
        await LoadCaseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadCaseAsync();
    }

    private async Task LoadCaseAsync()
    {
        _loadedCaseId = CaseId;
        _loaded = false;
        _case   = null;
        _error  = null;
        _activeTabId = TabIdFor(InitialTab);
        StateHasChanged();

        _clientRequest = null;

        // Item 193: what the PLAN allows, fetched beside the case so the private-engagement
        // toggle can say what it will do before somebody uses it. A failure here leaves the
        // control enabled — the same fail-open rule the server applies to capabilities.
        // One fetch answers both questions this screen asks: what the PERSON may do, and what the
        // group's PLAN allows. They fail in opposite directions on purpose — see PlanIncludes.
        try
        {
            _perms = await AdminClient.GetMyOrgPermissionsAsync(OrgId);
            _planIncludesPrivate = _perms?.PlanIncludes(
                Ben.Data.Common.Enums.TierCapability.PrivateResidenceCases) ?? true;
        }
        catch { _perms = null; _planIncludesPrivate = true; }

        try { _case = await AdminClient.GetOrgCaseAsync(OrgId, CaseId); }
        catch { _error = "Failed to load case."; }
        _loaded = true;
        StateHasChanged();

        // Fetched separately and allowed to fail quietly: most cases have one, some don't, and a
        // missing original request should never stop the case page rendering.
        if (_case?.ClientRequestId is not null)
        {
            try { _clientRequest = await AdminClient.GetOrgCaseClientRequestAsync(OrgId, CaseId); }
            catch { /* the card just doesn't appear */ }
            StateHasChanged();
        }

        // Load unread count separately so it doesn't block the page render
        try { _unreadCount = await AdminClient.GetCaseMessageUnreadCountAsync(OrgId, CaseId); }
        catch { /* non-critical; badge stays at 0 */ }
        StateHasChanged();
    }

    /// <summary>Human-readable file size for the attachment list.</summary>
    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.#} GB",
    };

    private void OpenEditDialog()
    {
        if (_case is null) return;
        _editTitle          = _case.Title;
        _editStatus         = _case.Status;
        _editDescription    = _case.Description ?? "";
        _editPseudonym      = _case.PublicPseudonym ?? "";
        _editIsPublic       = _case.IsPublic;
        _editIsPrivate      = _case.IsPrivateEngagement;
        _editCaseManagerId  = _case.CaseManagerAppUserId;
        _editError          = null;
        _leakWarnings       = [];
        _leakWarnedTitle    = null;
        // Load org members lazily for the dropdown
        if (_memberOptions.Count == 0)
            _ = LoadMembersAsync();
        _showEdit = true;
    }

    private async Task LoadMembersAsync()
    {
        try
        {
            var members = (await AdminClient.GetOrganizationMembersAsync(OrgId)).Items;
            _memberOptions = members
                .Where(m => m.IsActive)
                .OrderBy(m => m.DisplayName)
                .Select(m => new MemberOption(m.AppUserId, m.DisplayName ?? m.AppUserId.ToString()))
                .ToList();
            StateHasChanged();
        }
        catch { /* non-critical — dropdown just stays empty */ }
    }

    // Item 176: warn — never block — when a title or pseudonym about to go public carries the
    // client's name or the street address past the pseudonym. The warnings are remembered per
    // exact input pair, so the second Save on the same text publishes as-is, and any edit re-checks.
    private IReadOnlyList<string> _leakWarnings = [];
    private string? _leakWarnedTitle;

    // Item 182: the retrofit for a group that upgraded after taking the case on.
    private bool _showPrivacyResult;
    private CasePrivacyRetrofitResult? _privacyResult;

    private async Task ApplyPrivacyAsync()
    {
        _isBusy = true;
        try
        {
            var (result, error) = await AdminClient.ApplyCasePrivacyAsync(OrgId, CaseId);
            if (result is null) { _editError = error ?? "Applying privacy failed."; return; }
            _privacyResult     = result;
            _showPrivacyResult = true;
            _showEdit          = false;
            if (await AdminClient.GetOrgCaseAsync(OrgId, CaseId) is { } refreshed) _case = refreshed;
        }
        finally { _isBusy = false; }
    }

    private string? _republishError;

    /// <summary>The banner's one click: the same Update the edit dialog performs, flipping only
    /// IsPublic. A refusal (the plan gate, a slug problem) renders under the banner.</summary>
    private async Task RepublishAsync()
    {
        if (_case is null) return;
        _isBusy = true; _republishError = null;
        try
        {
            var (result, error) = await AdminClient.UpdateOrgCaseAsync(OrgId, CaseId, new UpdateCaseRequest(
                Title:                _case.Title,
                Description:          _case.Description,
                Status:               _case.Status,
                PublicPseudonym:      _case.PublicPseudonym,
                IsPublic:             true,
                CaseManagerAppUserId: _case.CaseManagerAppUserId));
            if (result is null) { _republishError = error ?? "Republish failed."; }
            else { _case = result; }
        }
        catch (Exception ex) { _republishError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editTitle)) { _editError = "Label is required."; return; }
        _isBusy = true; _editError = null;
        try
        {
            var leakInputs = $"{_editTitle.Trim()}\n{_editPseudonym.Trim()}";
            if (_editIsPublic && _leakWarnedTitle != leakInputs)
            {
                var check = await AdminClient.GetPublishLeakWarningsAsync(
                    OrgId, CaseId, _editTitle.Trim(), _editPseudonym.Trim());
                // A check that couldn't run (check.Failed) is silence, not a warning — an
                // advisory that fails must never stand between the org and publishing.
                if (!check.Failed && check.Items.Count > 0)
                {
                    _leakWarnings = check.Items;
                    _leakWarnedTitle = leakInputs;
                    return;
                }
            }
            _leakWarnings = [];
            var req = new UpdateCaseRequest(
                Title:                _editTitle.Trim(),
                Description:          string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription.Trim(),
                Status:               _editStatus,
                PublicPseudonym:      string.IsNullOrWhiteSpace(_editPseudonym) ? null : _editPseudonym.Trim(),
                IsPublic:             _editIsPublic,
                CaseManagerAppUserId: _editCaseManagerId,
                IsPrivateEngagement:  _editIsPrivate);

            var (result, error) = await AdminClient.UpdateOrgCaseAsync(OrgId, CaseId, req);
            if (result is null) { _editError = error ?? "Save failed."; }
            else { _case = result; _showEdit = false; }
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _isBusy = false; }
    }

    private record StatusOption(CaseStatus Value, string Label);
    private record MemberOption(Guid Id, string Label);

    private async Task<LoadResult<CaseMessageRecord>> LoadOrgMessages()
    {
        var msgs = await AdminClient.GetCaseMessagesAsync(OrgId, CaseId);
        // Only clear the badge if the thread actually came back; a refused fetch leaves the unread
        // count alone rather than reporting that everything has been read.
        if (!msgs.Failed) _unreadCount = 0;
        return msgs;
    }

    private async Task<CaseMessageRecord?> PostOrgMessage(string body)
    {
        var (result, _) = await AdminClient.PostCaseMessageAsync(OrgId, CaseId, body);
        return result;
    }
}
