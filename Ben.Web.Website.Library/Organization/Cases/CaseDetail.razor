@page "/organizations/{OrgId:guid}/cases/{CaseId:guid}"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>@(_case?.DisplayLabel ?? "Case")</PageTitle>

@if (_case is null && !_loaded)
{
    <BenLoaderOverlay Visible="true" Text="Loading case…" />
    return;
}

@if (_error is not null)
{
    <div class="container py-3"><div class="alert alert-danger">@_error</div></div>
    return;
}

@if (_case is not null)
{
    <div class="container-fluid py-3" style="max-width:1000px;">

        @* ── Header ────────────────────────────────────────────────────────── *@
        <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <a href="/organizations/@OrgId/cases" class="text-secondary small">← Cases</a>
                </div>
                <h3 class="mb-0">@_case.DisplayLabel<HelpLink Slug="working-a-case" Anchor="the-case-tabs" /></h3>
                <div class="text-secondary small mt-1">
                    @_case.City, @_case.State ·
                    Opened @_case.DateCaseOpened.ToViewerLocalTime(UserState).ToDisplayDate()
                    @if (_case.IsPublic && _case.Status != CaseStatus.Public) { <span class="badge bg-info text-dark ms-2">Public</span> }
                    @if (!string.IsNullOrEmpty(_case.PublicPseudonym))
                    {
                        <span class="ms-2 text-secondary">Public name: <em>@_case.PublicPseudonym</em></span>
                    }
                </div>
                <div class="text-secondary small mt-1">
                    Case Manager:
                    @if (!string.IsNullOrEmpty(_case.CaseManagerDisplayName))
                    {
                        <strong>@_case.CaseManagerDisplayName</strong>
                    }
                    else
                    {
                        <em class="text-warning">Unassigned</em>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <span class="badge fs-6 @_case.Status.BadgeClass()">
                    @_case.Status.Label()
                </span>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/{CaseId}/audio-mix"))">
                    🎚 Audio Mixer
                </button>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenEditDialog"><BenIcon Name="edit-2" Class="me-1" />Edit Case</button>
            </div>
        </div>

        @* ── Tab strip ─────────────────────────────────────────────────────── *@
        <BenTabs @bind-ActiveId="_activeTabId">

            @* ── Overview ────────────────────────────────────────────────── *@
            <BenTab Title="Overview" Id="overview">
                <div class="row g-4 mt-1">
                    <div class="col-md-8">
                        @if (!string.IsNullOrWhiteSpace(_case.Description))
                        {
                            <div class="card">
                                <div class="card-header fw-semibold">Case Summary</div>
                                <div class="card-body">@((MarkupString)_case.Description)</div>
                            </div>
                        }

                        @* ── What the client actually submitted ───────────────
                           Kept visually distinct from the Case Summary above: that one starts as a
                           copy of this and is then edited freely, so the two disagree within days.
                           This is the client's own words, read-only. *@
                        @if (_clientRequest is { } req)
                        {
                            <div class="card mb-3 border-info">
                                <div class="card-header fw-semibold d-flex align-items-center gap-2">
                                    <BenIcon Name="user" />
                                    Original Request
                                    <span class="ms-auto text-secondary small fw-normal">
                                        as submitted by the client on
                                        @req.SubmittedUtc.ToViewerLocalTime(UserState).ToDisplayDate()
                                    </span>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrWhiteSpace(req.Description))
                                    {
                                        <div class="mb-3">@((MarkupString)req.Description)</div>
                                    }
                                    else
                                    {
                                        <div class="text-secondary fst-italic mb-3">
                                            The client didn't write a description.
                                        </div>
                                    }

                                    <dl class="row mb-0 small">
                                        <dt class="col-sm-3">Address given</dt>
                                        <dd class="col-sm-9">
                                            @req.StreetAddress1@(string.IsNullOrWhiteSpace(req.StreetAddress2) ? "" : $", {req.StreetAddress2}")<br />
                                            @req.City, @req.State @req.ZipCode @req.Country
                                        </dd>
                                        @if (req.Gender != ClientGender.NotProvided || req.BirthYear.HasValue)
                                        {
                                            <dt class="col-sm-3">Client</dt>
                                            <dd class="col-sm-9">
                                                @if (req.Gender != ClientGender.NotProvided) { <text>@req.Gender</text> }
                                                @if (req.BirthYear is { } year)
                                                {
                                                    <text>@(req.Gender != ClientGender.NotProvided ? ", " : "")born @year</text>
                                                }
                                            </dd>
                                        }
                                    </dl>

                                    @if (req.Files.Count > 0)
                                    {
                                        <div class="mt-3 pt-3 border-top">
                                            <div class="fw-semibold small mb-2">
                                                Attached by the client (@req.Files.Count)
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var f in req.Files)
                                                {
                                                    @* A plain link, matching how every other file in
                                                       the library is offered — the download endpoint
                                                       applies its own access checks. *@
                                                    <div class="d-flex align-items-center gap-2 small">
                                                        <BenIcon Name="paperclip" />
                                                        <a href="@AdminClient.GetFileDownloadUrl(f.UploadFileId)"
                                                           target="_blank" rel="noopener"
                                                           class="text-truncate" style="max-width:280px;"
                                                           title="@f.FileName">@f.FileName</a>
                                                        <span class="text-secondary">@FormatBytes(f.FileSize)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header fw-semibold">Details</div>
                            <div class="card-body">
                                <dl class="row mb-0 small">
                                    <dt class="col-5">Reference</dt>
                                    <dd class="col-7">@_case.CaseReference</dd>
                                    <dt class="col-5">Address</dt>
                                    <dd class="col-7">
                                        @_case.StreetAddress1<br />
                                        @_case.City, @_case.State @_case.ZipCode
                                    </dd>
                                    @if (_case.ClientRequestId.HasValue)
                                    {
                                        <dt class="col-5">Source</dt>
                                        <dd class="col-7">
                                            Client Request
                                            @* Used to be these two words and nothing else. Points at
                                               the card that now renders the request itself. *@
                                            @if (_clientRequest is not null)
                                            {
                                                <div class="text-secondary small">see Original Request</div>
                                            }
                                        </dd>
                                    }
                                    else
                                    {
                                        <dt class="col-5">Source</dt>
                                        <dd class="col-7">Internally Proposed</dd>
                                    }
                                    @if (_case.DateCaseClosed.HasValue)
                                    {
                                        <dt class="col-5">Closed</dt>
                                        <dd class="col-7">@_case.DateCaseClosed.Value.ToViewerLocalTime(UserState).ToDisplayDate()</dd>
                                    }
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </BenTab>

            @* ── Timeline ─────────────────────────────────────────────────── *@
            <BenTab Title="Timeline" Id="timeline">
                <div class="mt-2">
                    <CaseTimeline OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Investigations ───────────────────────────────────────────── *@
            <BenTab Title="Investigations" Id="investigations">
                <div class="mt-2">
                    <InvestigationPanel OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Files ─────────────────────────────────────────────────────── *@
            <BenTab Title="Files" Id="files">
                <div class="mt-2">
                    <CaseFiles OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Transfers ────────────────────────────────────────────────── *@
            <BenTab Title="Transfers" Id="transfers">
                <div class="mt-2">
                    <CaseTransferPanel OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Client Messages ─────────────────────────────────────────────── *@
            <BenTab Id="messages" Title="@MessagesTabTitle">
                <div class="mt-2" style="max-width:680px;">
                    <CaseMessageThread CurrentSide="@Ben.Data.Common.Enums.CaseMessageSide.Organization"
                                       LoadMessages="@LoadOrgMessages"
                                       PostMessage="@PostOrgMessage" />
                </div>
            </BenTab>

            @* ── Report Builder ──────────────────────────────────────────────── *@
            <BenTab Title="Reports" Id="reports">
                <div class="mt-2">
                    <ReportBuilder OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Research ─────────────────────────────────────────────────────── *@
            <BenTab Title="Research" Id="research">
                <div class="mt-2">
                    <CaseResearch OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>
            @* ── Notes ───────────────────────────────────────────────────────────── *@
            <BenTab Title="Notes" Id="notes">
                <div class="mt-2">
                    <CaseNotes OrgId="@OrgId" CaseId="@CaseId" />
                </div>
            </BenTab>

            @* ── Video Editor ────────────────────────────────────────────────────── *@
            <BenTab Title="Video" Id="video">
                <div class="mt-3">
                    <p class="text-muted small mb-2">Create and manage video projects for this case. The video editor opens full-screen.</p>
                    <a href="/organizations/@OrgId/cases/@CaseId/video-editor"
                       class="btn btn-sm btn-outline-primary">
                        Open Case Video Editor →
                    </a>
                </div>
            </BenTab>
        </BenTabs>
    </div>
}

@* ── Edit dialog ──────────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showEdit" Title="Edit Case">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="casedetail-case-label-surname-city-0146">Case Label <span class="text-secondary fw-normal small">(surname, city state)</span></label>
                <input id="casedetail-case-label-surname-city-0146" type="text" class="form-control" @bind="@_editTitle" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Status</label>
                <BenSelect Data="@_statusOptions" @bind-Value="@_editStatus" TextField="@nameof(StatusOption.Label)" ValueField="@nameof(StatusOption.Value)" Width="100%" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Description (optional HTML summary)</label>
                <TelerikEditor @bind-Value="@_editDescription" Height="200px" />
            </div>
            <div class="col-md-8">
                <label class="form-label fw-semibold" for="casedetail-public-pseudonym-88c6">Public Pseudonym</label>
                <input id="casedetail-public-pseudonym-88c6" type="text" class="form-control" placeholder="e.g. The Henderson Family" @bind="@_editPseudonym" @bind:event="oninput" />
                <div class="form-text">Shown on public pages instead of real client name.</div>
            </div>
            <div class="col-md-4 d-flex align-items-center gap-2 pt-4">
                <input type="checkbox" class="form-check-input" id="case-public" @bind="@_editIsPublic" />
                <label for="case-public" class="form-label mb-0">Make Public</label>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Case Manager</label>
                <BenSelect Data="@_memberOptions" @bind-Value="@_editCaseManagerId" TextField="@nameof(MemberOption.Label)" ValueField="@nameof(MemberOption.Id)" DefaultText="— Unassigned —" Width="100%" />
            </div>
        </div>
        @if (_editError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_editError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showEdit = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveEdit" disabled="@(!(!_isBusy))"><BenIcon Name="save" Class="me-1" />
                @(_isBusy ? "Saving…" : "Save")
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    /// <summary>Tab label with its unread count. A property, not an inline expression: an
    /// interpolated string nested in an attribute's own quotes does not parse.</summary>
    private string MessagesTabTitle => _unreadCount > 0 ? $"Messages ({_unreadCount})" : "Messages";

    [Parameter] public Guid OrgId { get; set; }
    [Parameter] public Guid CaseId { get; set; }

    /// <summary>Selects the initial tab, e.g. "?tab=investigations" — used by My Investigations' clickable cards.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? InitialTab { get; set; }

    private CaseRecord? _case;

    /// <summary>
    /// The client request this case came from, when there is one and the caller may read it.
    /// Null is the normal state for an internally-raised case, so it is not treated as an error.
    /// </summary>
    private CaseClientRequestRecord? _clientRequest;
    private bool _loaded;
    private string? _error;
    private bool _isBusy;
    private int _unreadCount;
    private string _activeTabId = "overview";

    private static string TabIdFor(string? tab) => tab?.ToLowerInvariant() switch
    {
        "timeline"       => "timeline",
        "investigations" => "investigations",
        "files"          => "files",
        "transfers"      => "transfers",
        "messages"       => "messages",
        "reports"        => "reports",
        "research"       => "research",
        "notes"          => "notes",
        "video"          => "video",
        _                => "overview",
    };

    // Edit dialog
    private bool _showEdit;
    private string _editTitle        = "";
    private CaseStatus _editStatus   = CaseStatus.Accepted;
    private string _editDescription  = "";
    private string _editPseudonym    = "";
    private bool _editIsPublic;
    private Guid? _editCaseManagerId;
    private string? _editError;
    private List<MemberOption> _memberOptions = [];

    private static readonly List<StatusOption> _statusOptions = Enum
        .GetValues<CaseStatus>()
        .Select(s => new StatusOption(s, s.Label()))
        .ToList();

    private Guid _loadedCaseId;

    protected override void OnInitialized()
    {
        _activeTabId = TabIdFor(InitialTab);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Guards against a same-route navigation (e.g. a "next case" link) reusing this component
        // instance for a different CaseId — OnInitialized/OnAfterRenderAsync(firstRender) only fire
        // once per instance, so without this the page would silently keep showing the previous case.
        if (!_loaded || CaseId == _loadedCaseId) return;
        await LoadCaseAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadCaseAsync();
    }

    private async Task LoadCaseAsync()
    {
        _loadedCaseId = CaseId;
        _loaded = false;
        _case   = null;
        _error  = null;
        _activeTabId = TabIdFor(InitialTab);
        StateHasChanged();

        _clientRequest = null;

        try { _case = await AdminClient.GetOrgCaseAsync(OrgId, CaseId); }
        catch { _error = "Failed to load case."; }
        _loaded = true;
        StateHasChanged();

        // Fetched separately and allowed to fail quietly: most cases have one, some don't, and a
        // missing original request should never stop the case page rendering.
        if (_case?.ClientRequestId is not null)
        {
            try { _clientRequest = await AdminClient.GetOrgCaseClientRequestAsync(OrgId, CaseId); }
            catch { /* the card just doesn't appear */ }
            StateHasChanged();
        }

        // Load unread count separately so it doesn't block the page render
        try { _unreadCount = await AdminClient.GetCaseMessageUnreadCountAsync(OrgId, CaseId); }
        catch { /* non-critical; badge stays at 0 */ }
        StateHasChanged();
    }

    /// <summary>Human-readable file size for the attachment list.</summary>
    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.#} GB",
    };

    private void OpenEditDialog()
    {
        if (_case is null) return;
        _editTitle          = _case.Title;
        _editStatus         = _case.Status;
        _editDescription    = _case.Description ?? "";
        _editPseudonym      = _case.PublicPseudonym ?? "";
        _editIsPublic       = _case.IsPublic;
        _editCaseManagerId  = _case.CaseManagerAppUserId;
        _editError          = null;
        // Load org members lazily for the dropdown
        if (_memberOptions.Count == 0)
            _ = LoadMembersAsync();
        _showEdit = true;
    }

    private async Task LoadMembersAsync()
    {
        try
        {
            var members = await AdminClient.GetOrganizationMembersAsync(OrgId);
            _memberOptions = members
                .Where(m => m.IsActive)
                .OrderBy(m => m.DisplayName)
                .Select(m => new MemberOption(m.AppUserId, m.DisplayName ?? m.AppUserId.ToString()))
                .ToList();
            StateHasChanged();
        }
        catch { /* non-critical — dropdown just stays empty */ }
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editTitle)) { _editError = "Label is required."; return; }
        _isBusy = true; _editError = null;
        try
        {
            var req = new UpdateCaseRequest(
                Title:                _editTitle.Trim(),
                Description:          string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription.Trim(),
                Status:               _editStatus,
                PublicPseudonym:      string.IsNullOrWhiteSpace(_editPseudonym) ? null : _editPseudonym.Trim(),
                IsPublic:             _editIsPublic,
                CaseManagerAppUserId: _editCaseManagerId);

            var result = await AdminClient.UpdateOrgCaseAsync(OrgId, CaseId, req);
            if (result is null) { _editError = "Save failed."; }
            else { _case = result; _showEdit = false; }
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _isBusy = false; }
    }

    private record StatusOption(CaseStatus Value, string Label);
    private record MemberOption(Guid Id, string Label);

    private async Task<IReadOnlyList<CaseMessageRecord>> LoadOrgMessages()
    {
        var msgs = await AdminClient.GetCaseMessagesAsync(OrgId, CaseId);
        _unreadCount = 0; // tab opened — all now marked read by the server
        return msgs;
    }

    private async Task<CaseMessageRecord?> PostOrgMessage(string body)
        => await AdminClient.PostCaseMessageAsync(OrgId, CaseId, body);
}
