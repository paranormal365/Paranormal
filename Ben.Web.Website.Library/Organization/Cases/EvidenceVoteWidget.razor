@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject SiteFeaturesProvider Features

@*
  Reusable evidence voting widget. Shows vote counts and allows authenticated users to vote.
  Admins/case managers see the full vote list; public sees counts only.
  Place anywhere an UploadFile is displayed as evidence.
*@

@* Item 154: the voting switch — off means this renders nothing at all. *@
@if (Features.IsOn(SiteFeatures.Voting))
{
    <div class="evidence-vote-widget border rounded p-2 d-flex flex-column gap-2" style="min-width:200px;">
        @if (_summary is null && _loading)
        {
            <span class="text-secondary small">Loading votes…</span>
        }
        else if (_summary is null && _error is not null)
        {
            <span class="text-danger small">@_error</span>
        }
        else if (_summary is not null)
        {
            @* ── Vote counts ─────────────────────────────────────────────────── *@
            <div class="d-flex gap-3 align-items-center">
                <span class="text-success fw-semibold" title="Confirms">
                    ✓ @_summary.ConfirmsCount
                </span>
                <span class="text-danger fw-semibold" title="Disputes">
                    ✗ @_summary.DisputesCount
                </span>
                <span class="text-secondary fw-semibold" title="Inconclusive">
                    ? @_summary.InconclusiveCount
                </span>
                <span class="text-secondary small">(@_summary.TotalVotes total)</span>
                <Ben.Web.Website.Library.Shared.VoteScoreBadge Score="@_summary.Score" Total="@_summary.TotalVotes" />
            </div>

            @* ── Vote buttons (authenticated users) ───────────────────────────── *@
            @if (UserState.IsAuthenticated)
            {
                @* Ben's rule (2026-08-24): the vote bar fills its line and NEVER wraps — icon
                   always, word when it fits, tooltip + aria-label say it in full at any width. *@
                <div class="d-flex w-100 gap-1">
                    @foreach (var vt in Enum.GetValues<EvidenceVoteType>())
                    {
                        var v = vt;
                        var isActive = _summary.CurrentUserVote == v;
                        <button type="button"
                                class="btn btn-sm flex-fill text-nowrap overflow-hidden @(isActive ? "btn-secondary" : "btn-outline-secondary")"
                                aria-pressed="@isActive.ToString().ToLowerInvariant()"
                                aria-label="@VoteTitle(v)" title="@VoteTitle(v)"
                                @onclick="@(() => CastVote(v))" disabled="@(!(!_isBusy))">
                            @VoteIcon(v)<span class="d-none d-md-inline ms-1">@VoteWord(v)</span>
                        </button>
                    }
                    @if (_summary.CurrentUserVote.HasValue)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap flex-shrink-0"
                                title="Remove my vote" aria-label="Remove my vote"
                                @onclick="RemoveVote" disabled="@(!(!_isBusy))">
                            &#x21ba;<span class="d-none d-lg-inline ms-1">Remove</span>
                        </button>
                    }
                </div>
                @if (_actionError is not null)
                {
                    <span class="text-danger small">@_actionError</span>
                }
            }
            else
            {
                <span class="text-secondary" style="font-size:0.75rem;">Sign in to vote</span>
            }
        }
    </div>

}

@code {
    [Parameter, EditorRequired] public Guid UploadFileId { get; set; }

    private EvidenceVoteSummary? _summary;
    private bool _loading = true;
    private bool _isBusy;
    private string? _error;
    private string? _actionError;

    // Item #103 — same reasoning as CaseVoteWidget: the summary is viewer-specific, and auth
    // can resolve after the first load on a hard navigation. Reload when it lands late.
    protected override async Task OnInitializedAsync()
    {
        var before = UserState.IsAuthenticated;
        if (await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)
            && UserState.IsAuthenticated != before)
        {
            await LoadSummaryAsync();
            StateHasChanged();
        }
    }

    protected override Task OnParametersSetAsync() => LoadSummaryAsync();

    private async Task LoadSummaryAsync()
    {
        _loading = true;
        try { _summary = await AdminClient.GetEvidenceVoteSummaryAsync(UploadFileId); }
        catch { _error = "Failed to load votes."; }
        _loading = false;
    }

    private async Task CastVote(EvidenceVoteType voteType)
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            var updated = await AdminClient.CastEvidenceVoteAsync(UploadFileId, voteType, null);
            if (updated is not null) _summary = updated;
            else _actionError = "Failed to cast your vote. Please try again.";
        }
        catch { _actionError = "Failed to cast your vote. Please try again."; }
        finally { _isBusy = false; }
    }

    private async Task RemoveVote()
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            await AdminClient.RemoveEvidenceVoteAsync(UploadFileId);
            _summary = await AdminClient.GetEvidenceVoteSummaryAsync(UploadFileId);
        }
        catch { _actionError = "Failed to remove your vote. Please try again."; }
        finally { _isBusy = false; }
    }

    private static string VoteIcon(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "✓",
        EvidenceVoteType.Disputes     => "✗",
        EvidenceVoteType.Inconclusive => "?",
        _                             => "•",
    };

    private static string VoteWord(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "Confirms",
        EvidenceVoteType.Disputes     => "Disputes",
        EvidenceVoteType.Inconclusive => "Inconclusive",
        _                             => v.ToString(),
    };

    /// <summary>The full sentence, for the tooltip and screen readers at every width.</summary>
    private static string VoteTitle(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => "Confirms this evidence",
        EvidenceVoteType.Disputes     => "Disputes this evidence",
        EvidenceVoteType.Inconclusive => "Inconclusive — can't say either way",
        _                             => v.ToString(),
    };

    private static string VoteThemeColor(EvidenceVoteType v) => v switch
    {
        EvidenceVoteType.Confirms     => ThemeConstants.Button.ThemeColor.Success,
        EvidenceVoteType.Disputes     => ThemeConstants.Button.ThemeColor.Error,
        EvidenceVoteType.Inconclusive => ThemeConstants.Button.ThemeColor.Base,
        _                             => ThemeConstants.Button.ThemeColor.Base,
    };
}
