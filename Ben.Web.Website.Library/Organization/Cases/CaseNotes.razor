@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState

@if (_loading)
{
    <BenLoaderOverlay Visible="true" Text="Loading notes…" />
}
else
{
    @* ── Toolbar ─────────────────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-semibold">Case Notes <span class="text-secondary small fw-normal">(internal — not visible to clients)</span></span>
        <button type="button" class="btn btn-primary btn-sm" @onclick="OpenNew"><BenIcon Name="plus" Class="me-1" />New Note</button>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_notes.Count == 0)
    {
        <p class="text-secondary">No notes yet. Add the first note to keep track of internal case details.</p>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var note in _notes)
            {
                var n = note;
                <div class="card @(n.IsPinned ? "border-warning" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="flex-grow-1">
                                @if (n.IsPinned)
                                {
                                    <span class="badge bg-warning text-dark me-1">📌 Pinned</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(n.Title))
                                {
                                    <strong class="d-block mb-1">@n.Title</strong>
                                }
                                <div class="small" style="white-space:pre-wrap;">@n.Body</div>
                                <div class="text-secondary mt-2" style="font-size:.75rem;">
                                    @(n.AuthorDisplayName ?? "Unknown") · @n.DateCreated.ToViewerLocalTime(UserState).ToString("MMM d, yyyy h:mm tt")
                                    @if (n.DateUpdated.HasValue)
                                    {
                                        <span> · edited @n.DateUpdated.Value.ToViewerLocalTime(UserState).ToString("MMM d")</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex gap-1 flex-shrink-0">
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => OpenEdit(n))"><BenIcon Name="edit-2" /></button>
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-danger" : "btn-outline-danger") btn-sm" @onclick="@(() => ConfirmDelete(n))"><BenIcon Name="trash-2" /></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* ── Add / Edit dialog ────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDialog" Title="@(_editNote is null ? "New Note" : "Edit Note")">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Title <span class="text-secondary fw-normal small">(optional)</span></label>
                <input type="text" class="form-control" placeholder="e.g. Client background check" @bind="@_formTitle" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Body <span class="text-danger">*</span></label>
                <textarea class="form-control" rows="6" placeholder="Internal note details…" @bind="@_formBody"></textarea>
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="note-pin" @bind="@_formPinned" />
                <label for="note-pin" class="form-label mb-0">📌 Pin this note</label>
            </div>
        </div>
        @if (_dialogError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
        }
    </ChildContent>
</BenModal>

@* ── Delete confirmation ──────────────────────────────────────────────────── *@
@if (_deleteNote is not null)
{
    <BenModal @bind-Visible="@_showDeleteConfirm" Title="Delete Note" Size="sm">
    <ChildContent>
            <p>Delete this note permanently?</p>
            @if (!string.IsNullOrWhiteSpace(_deleteNote.Title))
            {
                <p class="fw-semibold mb-0">@_deleteNote.Title</p>
            }
                <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

                <button type="button" class="btn btn-secondary" @onclick="@(() => { _showDeleteConfirm = false; _deleteNote = null; })">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteNote" disabled="@(!(!_isBusy))">Delete</button>
        </div>
    </ChildContent>
</BenModal>
}

@code {
    [Parameter, EditorRequired] public Guid OrgId { get; set; }
    [Parameter, EditorRequired] public Guid CaseId { get; set; }

    private List<CaseNoteDto> _notes = [];
    private bool _loading = true;
    private string? _error;

    private bool _showDialog;
    private bool _isBusy;
    private string? _dialogError;
    private CaseNoteDto? _editNote;
    private string? _formTitle;
    private string  _formBody  = "";
    private bool    _formPinned;

    private bool     _showDeleteConfirm;
    private CaseNoteDto? _deleteNote;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        try { _notes = (await AdminClient.GetCaseNotesAsync(OrgId, CaseId)).ToList(); }
        catch { _error = "Failed to load notes."; }
        finally { _loading = false; }
        StateHasChanged();
    }

    private void OpenNew()
    {
        _editNote    = null;
        _formTitle   = null;
        _formBody    = "";
        _formPinned  = false;
        _dialogError = null;
        _showDialog  = true;
    }

    private void OpenEdit(CaseNoteDto note)
    {
        _editNote    = note;
        _formTitle   = note.Title;
        _formBody    = note.Body;
        _formPinned  = note.IsPinned;
        _dialogError = null;
        _showDialog  = true;
    }

    private void ConfirmDelete(CaseNoteDto note)
    {
        _deleteNote         = note;
        _showDeleteConfirm  = true;
    }

    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(_formBody)) { _dialogError = "Body is required."; return; }
        _isBusy = true; _dialogError = null;
        try
        {
            var req = new UpsertCaseNoteDto(_formTitle?.Trim(), _formBody.Trim(), _formPinned);
            CaseNoteDto? result;
            if (_editNote is null)
                result = await AdminClient.CreateCaseNoteAsync(OrgId, CaseId, req);
            else
                result = await AdminClient.UpdateCaseNoteAsync(OrgId, CaseId, _editNote.Id, req);

            if (result is null) { _dialogError = "Save failed."; }
            else
            {
                _showDialog = false;
                _notes = (await AdminClient.GetCaseNotesAsync(OrgId, CaseId)).ToList();
            }
        }
        catch (Exception ex) { _dialogError = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task DeleteNote()
    {
        if (_deleteNote is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.DeleteCaseNoteAsync(OrgId, CaseId, _deleteNote.Id);
            _showDeleteConfirm = false;
            _deleteNote        = null;
            _notes = (await AdminClient.GetCaseNotesAsync(OrgId, CaseId)).ToList();
        }
        catch { _error = "Delete failed."; }
        finally { _isBusy = false; }
    }
}
