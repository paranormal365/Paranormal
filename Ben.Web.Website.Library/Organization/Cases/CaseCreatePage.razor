@page "/organizations/{OrgId:guid}/cases/new"
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>New Case</PageTitle>

<div class="container-fluid py-3" style="max-width:720px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases"))"><BenIcon Name="chevron-left" Class="me-1" />
            Cases
        </button>
        <h4 class="mb-0">Open New Case</h4>
    </div>

    @if (_error is not null) { <div class="alert alert-danger mb-3">@_error</div> }

    <div class="card">
        <div class="card-header fw-semibold">Case Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Case Title <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="e.g. Smith, Nashville TN" @bind="@_form.Title" @bind:event="oninput" />
                    <div class="form-text">A brief label identifying this case.</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea class="form-control" rows="4" placeholder="Summarise the reported activity or reason for opening the case…" @bind="@_form.Description"></textarea>
                </div>

                <div class="col-12">
                    <hr class="my-1" />
                    <div class="fw-semibold small text-secondary mb-2">Investigation Address</div>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Street Address <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="123 Main St" @bind="@_form.StreetAddress1" @bind:event="oninput" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Unit / Apt (optional)</label>
                    <input type="text" class="form-control" placeholder="Apt 4B" @bind="@_form.StreetAddress2" @bind:event="oninput" />
                </div>
                <div class="col-md-5">
                    <label class="form-label fw-semibold">City <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="@_form.City" @bind:event="oninput" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">State <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="TN" @bind="@_form.State" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">ZIP Code <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="@_form.ZipCode" @bind:event="oninput" />
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases"))">
                Cancel
            </button>
            <button type="button" class="btn btn-primary" @onclick="Submit" disabled="@(!(!_saving && IsValid))">
                @(_saving ? "Creating…" : "Open Case")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid OrgId { get; set; }

    private readonly CaseForm _form = new();
    private bool _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_form.Title)   &&
        !string.IsNullOrWhiteSpace(_form.StreetAddress1) &&
        !string.IsNullOrWhiteSpace(_form.City)    &&
        !string.IsNullOrWhiteSpace(_form.State)   &&
        !string.IsNullOrWhiteSpace(_form.ZipCode);

    private async Task Submit()
    {
        _saving = true;
        _error  = null;
        try
        {
            var request = new CreateCaseRequest(
                _form.Title.Trim(),
                string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
                _form.StreetAddress1.Trim(),
                string.IsNullOrWhiteSpace(_form.StreetAddress2) ? null : _form.StreetAddress2.Trim(),
                _form.City.Trim(),
                _form.State.Trim().ToUpperInvariant(),
                _form.ZipCode.Trim(),
                "US",
                null, null);

            var result = await AdminClient.CreateOrgCaseAsync(OrgId, request);
            if (result is not null)
                NavManager.NavigateTo($"/organizations/{OrgId}/cases/{result.Id}");
            else
                _error = "Case creation failed. Please try again.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _saving = false; }
    }

    private class CaseForm
    {
        public string  Title          { get; set; } = "";
        public string? Description    { get; set; }
        public string  StreetAddress1 { get; set; } = "";
        public string? StreetAddress2 { get; set; }
        public string  City           { get; set; } = "";
        public string  State          { get; set; } = "";
        public string  ZipCode        { get; set; } = "";
    }
}
