@page "/organizations/{OrgId:guid}/cases"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<div class="container-fluid py-3" style="max-width:1000px;">
    @if (!EmbeddedMode)
    {
        <PageTitle>Cases — @(_orgName ?? "Organization")</PageTitle>
    }
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="mb-0">Cases</h3>
        <div class="d-flex gap-2">
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/pending-requests"))"><BenIcon Name="inbox" Class="me-1" />
                Pending Requests @(_pendingCount > 0 ? $"({_pendingCount})" : "")
            </button>
            <button type="button" class="btn btn-primary" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/new"))"><BenIcon Name="plus" Class="me-1" />
                New Case
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_incoming.Count > 0)
    {
        @* Cases other groups — or their clients — have asked this one to take (item 84). Above
           the list because it needs an answer, and until recently there was NO surface at all
           for the receiving side of a transfer: the request sat in a table only the sender
           could see. *@
        <div class="card border-primary mb-4">
            <div class="card-header"><strong>Incoming cases</strong> — waiting on your answer</div>
            <div class="card-body">
                @foreach (var t in _incoming)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 py-2 border-bottom">
                        <div class="me-auto">
                            <strong>@t.CaseTitle</strong>
                            <span class="text-secondary">— @t.City, @t.State</span>
                            <div class="small text-secondary">
                                @(t.ProposedByClient
                                    ? $"The client is moving this case from {t.FromOrganizationName}."
                                    : $"Proposed by {t.FromOrganizationName}.")
                                @if (t.ProposedByClient)
                                {
                                    <span>
                                        You'd see: @(t.ShareHistory ? "their history" : "no prior history"),
                                        @(t.ShareInvestigations ? "past investigations" : "no past investigations").
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(t.Reason))
                            {
                                <div class="small">"@t.Reason"</div>
                            }
                        </div>
                        <button type="button" class="btn btn-success btn-sm" disabled="@_incomingBusy"
                                @onclick="() => AnswerIncomingAsync(t, accept: true)">Accept</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_incomingBusy"
                                @onclick="() => AnswerIncomingAsync(t, accept: false)">Decline</button>
                    </div>
                }
                @if (_incomingError is not null)
                {
                    <div class="alert alert-danger py-2 mt-2 mb-0">@_incomingError</div>
                }
            </div>
        </div>
    }

    @if (_cases is null)
    {
        <BenLoaderOverlay Visible="true" Text="Loading cases…" />
    }
    else if (_casesResult.Failed)
    {
        <BenListState TItem="CaseRecord" Result="@_casesResult" OnRetry="@LoadAsync" />
    }
    else if (_cases.Count == 0)
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <p class="lead text-secondary mb-3">No cases yet.</p>
                <p class="text-secondary small">Cases are created when a client request is accepted, or proposed internally by a member.</p>
            </div>
        </div>
    }
    else
    {
        @* ── Filters ─────────────────────────────────────────────────────── *@
        <div class="d-flex gap-2 flex-wrap mb-3">
            @foreach (var status in _filterOptions)
            {
                var s = status;
                <button type="button" class="btn @((_activeFilter == s ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _activeFilter = s)">
                    @(s is null ? "All" : s.Value.Label())
                    <span class="badge bg-body-secondary text-body-emphasis border ms-1">
                        @(s is null ? _cases.Count : _cases.Count(c => c.Status == s))
                    </span>
                </button>
            }
        </div>

        <div class="d-flex flex-column gap-2">
            @foreach (var c in FilteredCases)
            {
                var caseId = c.Id;
                <div class="card">
                    <div class="card-body d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @c.Status.BadgeClass()">@c.Status.Label()</span>
                                @if (c.IsPublic && c.Status != CaseStatus.Public) { <span class="badge bg-info text-dark">Public</span> }
                                <strong>@c.DisplayLabel</strong>
                            </div>
                            <div class="text-secondary small">
                                @c.City, @c.State ·
                                Opened @c.DateCaseOpened.ToViewerLocalTime(UserState).ToDisplayDate()
                                @if (c.DateCaseClosed.HasValue)
                                {
                                    <span> · Closed @c.DateCaseClosed.Value.ToViewerLocalTime(UserState).ToDisplayDate()</span>
                                }
                            </div>
                            <div class="text-secondary small mt-1">
                                Manager:
                                @if (!string.IsNullOrEmpty(c.CaseManagerDisplayName))
                                {
                                    <strong>@c.CaseManagerDisplayName</strong>
                                }
                                else
                                {
                                    <em class="text-warning">Unassigned</em>
                                }
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/{caseId}"))"><BenIcon Name="arrow-right" Class="me-1" />
                            Open
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid OrgId        { get; set; }
    [Parameter] public bool EmbeddedMode  { get; set; }

    private List<CaseRecord>? _cases;
    private LoadResult<CaseRecord> _casesResult;
    private string? _orgName;
    private string? _error;
    private CaseStatus? _activeFilter;
    private int _pendingCount;

    private static readonly CaseStatus?[] _filterOptions =
        [null, CaseStatus.Proposed, CaseStatus.Accepted, CaseStatus.Active,
         CaseStatus.Summarized, CaseStatus.Paused, CaseStatus.Public, CaseStatus.Haunted, CaseStatus.Closed];

    private IEnumerable<CaseRecord> FilteredCases =>
        _activeFilter is null ? _cases! : _cases!.Where(c => c.Status == _activeFilter);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private List<IncomingTransferRecord> _incoming = [];
    private bool _incomingBusy;
    private string? _incomingError;

    private async Task AnswerIncomingAsync(IncomingTransferRecord t, bool accept)
    {
        _incomingBusy = true;
        _incomingError = null;

        // Declining without a word helps nobody — the platform relays the reason to whoever
        // asked, so a bare decline gets a serviceable default sentence.
        var result = await AdminClient.RespondCaseTransferAsync(
            OrgId, t.CaseId, t.LogId, accept,
            accept ? null : "The group is unable to take this case on at the moment.");

        _incomingBusy = false;

        if (result is null) { _incomingError = "That couldn't be recorded — it may already have been answered."; return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _casesResult = await AdminClient.GetOrgCasesAsync(OrgId);
            _cases       = _casesResult.Items.ToList();
            _incoming    = [.. (await AdminClient.GetIncomingTransfersAsync(OrgId)).Items];
            var org = await AdminClient.GetOrganizationAsync(OrgId);
            _orgName = org?.Name;
            // Deliberately quiet: this is the count on a "pending requests" badge. If it can't
            // be fetched the badge simply doesn't appear, which is the same thing the user sees
            // when there is nothing pending — and failing the whole case list over a decoration
            // would be worse than omitting it.
            try { _pendingCount = (await AdminClient.GetOrgPendingRequestsAsync(OrgId)).Items.Count; } catch { }
        }
        catch
        {
            _error       = "Failed to load cases.";
            _casesResult = LoadResult<CaseRecord>.Failure();
            _cases     ??= [];
        }
        StateHasChanged();
    }

}
