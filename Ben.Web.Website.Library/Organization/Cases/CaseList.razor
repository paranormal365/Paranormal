@page "/organizations/{OrgId:guid}/cases"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<div class="container-fluid py-3" style="max-width:1000px;">
    @if (!EmbeddedMode)
    {
        <PageTitle>Cases — @(_orgName ?? "Organization")</PageTitle>
    }
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="mb-0">Cases</h3>
        <div class="d-flex gap-2">
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/pending-requests"))"><BenIcon Name="inbox" Class="me-1" />
                Pending Requests @(_pendingCount > 0 ? $"({_pendingCount})" : "")
            </button>
            <button type="button" class="btn btn-primary" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/new"))"><BenIcon Name="plus" Class="me-1" />
                New Case
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_cases is null)
    {
        <BenLoaderOverlay Visible="true" Text="Loading cases…" />
    }
    else if (_casesResult.Failed)
    {
        <BenListState TItem="CaseRecord" Result="@_casesResult" OnRetry="@LoadAsync" />
    }
    else if (_cases.Count == 0)
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <p class="lead text-secondary mb-3">No cases yet.</p>
                <p class="text-secondary small">Cases are created when a client request is accepted, or proposed internally by a member.</p>
            </div>
        </div>
    }
    else
    {
        @* ── Filters ─────────────────────────────────────────────────────── *@
        <div class="d-flex gap-2 flex-wrap mb-3">
            @foreach (var status in _filterOptions)
            {
                var s = status;
                <button type="button" class="btn @((_activeFilter == s ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _activeFilter = s)">
                    @(s is null ? "All" : s.Value.Label())
                    <span class="badge bg-body-secondary text-body-emphasis border ms-1">
                        @(s is null ? _cases.Count : _cases.Count(c => c.Status == s))
                    </span>
                </button>
            }
        </div>

        <div class="d-flex flex-column gap-2">
            @foreach (var c in FilteredCases)
            {
                var caseId = c.Id;
                <div class="card">
                    <div class="card-body d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @c.Status.BadgeClass()">@c.Status.Label()</span>
                                @if (c.IsPublic && c.Status != CaseStatus.Public) { <span class="badge bg-info text-dark">Public</span> }
                                <strong>@c.DisplayLabel</strong>
                            </div>
                            <div class="text-secondary small">
                                @c.City, @c.State ·
                                Opened @c.DateCaseOpened.ToViewerLocalTime(UserState).ToDisplayDate()
                                @if (c.DateCaseClosed.HasValue)
                                {
                                    <span> · Closed @c.DateCaseClosed.Value.ToViewerLocalTime(UserState).ToDisplayDate()</span>
                                }
                            </div>
                            <div class="text-secondary small mt-1">
                                Manager:
                                @if (!string.IsNullOrEmpty(c.CaseManagerDisplayName))
                                {
                                    <strong>@c.CaseManagerDisplayName</strong>
                                }
                                else
                                {
                                    <em class="text-warning">Unassigned</em>
                                }
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cases/{caseId}"))"><BenIcon Name="arrow-right" Class="me-1" />
                            Open
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid OrgId        { get; set; }
    [Parameter] public bool EmbeddedMode  { get; set; }

    private List<CaseRecord>? _cases;
    private LoadResult<CaseRecord> _casesResult;
    private string? _orgName;
    private string? _error;
    private CaseStatus? _activeFilter;
    private int _pendingCount;

    private static readonly CaseStatus?[] _filterOptions =
        [null, CaseStatus.Proposed, CaseStatus.Accepted, CaseStatus.Active,
         CaseStatus.Summarized, CaseStatus.Public, CaseStatus.Haunted, CaseStatus.Closed];

    private IEnumerable<CaseRecord> FilteredCases =>
        _activeFilter is null ? _cases! : _cases!.Where(c => c.Status == _activeFilter);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _casesResult = await AdminClient.GetOrgCasesAsync(OrgId);
            _cases       = _casesResult.Items.ToList();
            var org = await AdminClient.GetOrganizationAsync(OrgId);
            _orgName = org?.Name;
            // Deliberately quiet: this is the count on a "pending requests" badge. If it can't
            // be fetched the badge simply doesn't appear, which is the same thing the user sees
            // when there is nothing pending — and failing the whole case list over a decoration
            // would be worse than omitting it.
            try { _pendingCount = (await AdminClient.GetOrgPendingRequestsAsync(OrgId)).Items.Count; } catch { }
        }
        catch
        {
            _error       = "Failed to load cases.";
            _casesResult = LoadResult<CaseRecord>.Failure();
            _cases     ??= [];
        }
        StateHasChanged();
    }

}
