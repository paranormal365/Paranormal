@using Ben.Data.Common.Enums
@using Ben.Web.Services
@using Ben.Web.Website.Library.Kit.Blocks
@using Microsoft.AspNetCore.Components.Forms

@*
    A research page's rail: the files and links kept beside it (beta feedback, 2026-09-14). Anything here can be put on the
    page with Insert — a link at the cursor, a picture or file as a block — and stays here if it is taken off the page
    again. "Add picture" offers the camera on a phone.
*@

<div class="research-rail" data-testid="research-rail">
    @if (!ReadOnly)
    {
        <div class="d-flex flex-wrap gap-2 mb-2">
            <label class="btn btn-sm btn-outline-secondary research-rail__touch mb-0" for="research-rail-add-picture">
                <BenIcon Name="camera" Class="me-1" />Add picture
            </label>
            <InputFile id="research-rail-add-picture" class="visually-hidden" accept="image/*" multiple OnChange="OnFilesAsync" />
            <label class="btn btn-sm btn-outline-secondary research-rail__touch mb-0" for="research-rail-add-file">
                <BenIcon Name="paperclip" Class="me-1" />Add file
            </label>
            <InputFile id="research-rail-add-file" class="visually-hidden" multiple OnChange="OnFilesAsync" />
        </div>
        <div class="d-flex gap-2 mb-2">
            <label class="visually-hidden" for="research-rail-link">Web address</label>
            <input id="research-rail-link" class="form-control form-control-sm" type="url" placeholder="Add a link: https://…"
                   @bind="_link" @bind:event="oninput" @onkeydown="OnLinkKeyAsync" />
            <button type="button" class="btn btn-sm btn-outline-secondary research-rail__touch" disabled="@(_busy || string.IsNullOrWhiteSpace(_link))"
                    @onclick="AddTypedLinkAsync" data-testid="research-rail-add-link">Add</button>
        </div>
        @if (_busy) { <div class="small text-secondary mb-2"><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Adding…</div> }
        @if (_error is not null) { <div class="alert alert-warning py-1 px-2 small">@_error</div> }
    }

    @if (Attachments.Count == 0)
    {
        <p class="small text-secondary mb-0">No files or links yet.@(ReadOnly ? "" : " Paste or drop them onto the page, or add them here.")</p>
    }
    else
    {
        <ul class="list-unstyled mb-0">
            @foreach (var attachment in Attachments.OrderBy(a => a.SortOrder))
            {
                var a = attachment;
                <li class="research-rail__item" data-testid="research-rail-item">
                    @if (a.Kind == CaseResearchAttachmentKind.Link && a.Url is { } url)
                    {
                        <BenLinkPreview Url="@url" Title="@(a.Preview?.Title)" Description="@(a.Preview?.Description)"
                                        ImageUrl="@(a.Preview?.ImageUrl)" SiteName="@(a.Preview?.SiteName)" Domain="@(a.Preview?.Domain)" />
                    }
                    else if (a.FileId is { } fileId)
                    {
                        <a class="research-rail__file" href="@FileUrl(fileId, BlockFileUrlKind.Download)" target="_blank" rel="noopener">
                            @if (a.ContentType?.StartsWith("image/") == true)
                            {
                                <img src="@FileUrl(fileId, BlockFileUrlKind.Picture)" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="research-rail__file-icon" aria-hidden="true"><BenIcon Name="file-text" /></span>
                            }
                            <span class="research-rail__file-name">@(a.FileName ?? a.Title)</span>
                        </a>
                    }
                    @if (!ReadOnly)
                    {
                        <div class="d-flex gap-2 mt-1">
                            <button type="button" class="btn btn-sm btn-outline-primary research-rail__touch" @onclick="@(() => InsertAsync!(a))"
                                    aria-label="@($"Put {a.Title} on the page")">
                                <BenIcon Name="corner-down-left" Class="me-1" />Insert
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger research-rail__touch" @onclick="@(() => DeleteItemAsync(a))"
                                    aria-label="@($"Remove {a.Title}")">
                                <BenIcon Name="trash-2" />
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CaseResearchAttachmentDto> Attachments { get; set; } = [];
    [Parameter, EditorRequired] public Func<Guid, BlockFileUrlKind, string> FileUrl { get; set; } = null!;
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Stores a file; the refusal sentence, or null.</summary>
    [Parameter] public Func<BlockUploadRequest, Task<string?>>? UploadAsync { get; set; }

    /// <summary>Adds a link; the refusal sentence, or null.</summary>
    [Parameter] public Func<string, Task<string?>>? AddLinkAsync { get; set; }

    /// <summary>Removes an item; the refusal sentence, or null.</summary>
    [Parameter] public Func<CaseResearchAttachmentDto, Task<string?>>? DeleteAsync { get; set; }

    [Parameter] public Func<CaseResearchAttachmentDto, Task>? InsertAsync { get; set; }

    private const long MaxBytes = 50L * 1024 * 1024;
    private string _link = "";
    private bool _busy;
    private string? _error;

    private async Task OnFilesAsync(InputFileChangeEventArgs e)
    {
        if (UploadAsync is null) return;
        _error = null;
        _busy = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(20))
            {
                if (file.Size > MaxBytes) { _error = $"\"{file.Name}\" is larger than 50 MB."; continue; }
                await using var stream = file.OpenReadStream(MaxBytes);
                _error = await UploadAsync(new BlockUploadRequest(file.Name, file.ContentType, file.Size, stream)) ?? _error;
            }
        }
        finally { _busy = false; }
    }

    private async Task OnLinkKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTypedLinkAsync();
    }

    private async Task AddTypedLinkAsync()
    {
        if (AddLinkAsync is null || string.IsNullOrWhiteSpace(_link)) return;
        _busy = true;
        _error = null;
        try
        {
            _error = await AddLinkAsync(_link.Trim());
            if (_error is null) _link = "";
        }
        finally { _busy = false; }
    }

    private async Task DeleteItemAsync(CaseResearchAttachmentDto attachment)
    {
        if (DeleteAsync is null) return;
        _error = await DeleteAsync(attachment);
    }
}
