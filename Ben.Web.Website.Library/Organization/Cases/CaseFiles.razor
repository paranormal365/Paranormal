@using Ben.Service.Models.Entities
@using Ben.Web.Website.Library.Media
@using Ben.Web.Services
@using Ben.Web.Website.Library.User
@using Microsoft.AspNetCore.Components.Forms
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

@if (_loading) { <BenLoaderOverlay Visible="true" Text="Loading files…" /> }
else
{
    @* ── Toolbar ─────────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        <InputFile OnChange="OnFileSelected" accept="*" style="display:none;" id="case-file-upload" />
        <label for="case-file-upload" class="k-button k-button-sm k-button-outline k-button-outline-base" style="cursor:pointer;">
            <BenIcon Name="upload" /> Upload File
        </label>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => _showLibraryPicker = true)"><BenIcon Name="image" Class="me-1" />
            Attach from Library
        </button>
        @if (_uploading) { <span class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></span> }
    </div>

    @if (_error is not null) { <div class="alert alert-danger py-2 small mb-3">@_error</div> }

    @if (_files.Count == 0)
    {
        <div class="text-secondary text-center py-4 small">
            No files yet. Upload evidence photos, audio, video, or documents for this case.
        </div>
    }

    @* ── File list ───────────────────────────────────────────────────────────── *@
    <div class="d-flex flex-column gap-2">
        @foreach (var file in _files)
        {
            var f = file;
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div class="flex-grow-1">
                            <div class="fw-semibold small mb-1">@f.FileName</div>
                            <UserMediaPreview FileId="@f.UploadFileId" FileName="@f.FileName" ContentType="@f.ContentType" FileSize="@f.FileSize" />
                            @if (!string.IsNullOrWhiteSpace(f.Description))
                            {
                                <div class="small text-secondary mt-1">@f.Description</div>
                            }
                            <div class="text-muted mt-1" style="font-size:.7rem;">
                                @FormatSize(f.FileSize) · Added @f.DateCreated.ToViewerLocalTime(UserState).ToString("MMM d, yyyy h:mm tt")
                            </div>
                            <div @onclick:stopPropagation="true">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ToggleComments(f.Id))"><BenIcon Name="message-square" Class="me-1" />
                                    @(_expandedCommentsId == f.Id ? "Hide comments" : "Comments")
                                </button>
                            </div>
                            @if (_expandedCommentsId == f.Id)
                            {
                                <div class="mt-2 border-top pt-2">
                                    @if (f.CreatedByAppUserId == UserState.UserId)
                                    {
                                        <div class="mb-2">
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _showCommentSettingsId = _showCommentSettingsId == f.Id ? null : f.Id)">
                                                @(_showCommentSettingsId == f.Id ? "▾" : "▸") Comment settings
                                            </button>
                                            @if (_showCommentSettingsId == f.Id)
                                            {
                                                <div class="mt-2">
                                                    <FileCommentSettings @key="@f.UploadFileId" FileId="@f.UploadFileId" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    <FileCommentThread @key="@f.UploadFileId" FileId="@f.UploadFileId"
                                                        CanModerate="@(f.CreatedByAppUserId == UserState.UserId)" />
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => DeleteFile(f.Id))"><BenIcon Name="trash-2" /></button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Attach from Library picker ───────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showLibraryPicker" Title="Attach from Library" Size="sm">
    <ChildContent>
        <MediaLibraryGrid PickerMode="true" MultiSelect="true" OnFilesSelected="OnLibraryFilesSelected" />
    </ChildContent>
</BenModal>

@code {
    [Parameter, EditorRequired] public Guid OrgId  { get; set; }
    [Parameter, EditorRequired] public Guid CaseId { get; set; }

    private List<CaseFileRecord> _files = [];
    private bool _loading = true;
    private bool _uploading;
    private string? _error;
    private bool _showLibraryPicker;
    private Guid? _expandedCommentsId;
    private Guid? _showCommentSettingsId;

    protected override async Task OnInitializedAsync()
    {
        try { _files = (await AdminClient.GetCaseFilesAsync(OrgId, CaseId)).ToList(); }
        catch { _error = "Failed to load files."; }
        _loading = false;
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploading = true; _error = null;
        StateHasChanged();
        try
        {
            foreach (var f in e.GetMultipleFiles(5))
            {
                // No practical upload size limit for now — a future limit belongs at app-settings /
                // per-person / per-org / per-case / per-investigation scope, not a blanket cap here.
                using var stream = f.OpenReadStream(maxAllowedSize: long.MaxValue);
                var result = await AdminClient.UploadCaseFileAsync(OrgId, CaseId, null, stream, f.Name, f.ContentType);
                if (result is not null) _files.Insert(0, result);
            }
        }
        catch { _error = "Failed to upload file."; }
        finally { _uploading = false; StateHasChanged(); }
    }

    private async Task OnLibraryFilesSelected(IReadOnlyList<UploadFileRecord> selected)
    {
        _showLibraryPicker = false;
        foreach (var file in selected)
        {
            try
            {
                var result = await AdminClient.LinkCaseFileAsync(OrgId, CaseId, file.Id);
                if (result is not null) _files.Insert(0, result);
            }
            catch { _error = $"Failed to attach '{file.FileName}'."; }
        }
        StateHasChanged();
    }

    private void ToggleComments(Guid caseFileId)
    {
        _expandedCommentsId = _expandedCommentsId == caseFileId ? null : caseFileId;
        _showCommentSettingsId = null;
    }

    private async Task DeleteFile(Guid caseFileId)
    {
        await AdminClient.DeleteCaseFileAsync(OrgId, CaseId, caseFileId);
        _files.RemoveAll(f => f.Id == caseFileId);
        StateHasChanged();
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024             => $"{bytes} B",
        < 1024 * 1024      => $"{bytes / 1024.0:0.#} KB",
        _                  => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
