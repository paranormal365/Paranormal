@using Ben.Service.Models.Entities
@using Ben.Web.Website.Library.Media
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@using Ben.Web.Website.Library.User
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject ICaseFileUploads Uploads

@if (_loading) { <BenLoaderOverlay Visible="true" Text="Loading files…" /> }
else
{
    @* ── Toolbar ─────────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
        @if (May(Ben.Data.Common.Enums.OrganizationSecurityAction.Create))
        {
            @* The browser posts each file straight to the site's own relay, so it can say how far
               it has got and be stopped half way. Reading it through the circuit instead gave no
               progress at all, and a big recording was a silence that read as a failure — which is
               how an 8 MB video that had uploaded perfectly well looked like a broken feature
               (Ben, 2026-09-17). SaveField is "file" because that is what the API's own parameter
               is called; the default, "files", would bind to nothing and be refused. *@
            @if (_saveUrl is not null)
            {
                <div class="case-files__upload" data-testid="case-file-upload-zone">
                    <TelerikUpload Id="case-file-upload"
                                   SaveUrl="@_saveUrl"
                                   SaveField="file"
                                   WithCredentials="true"
                                   Multiple="true"
                                   OnSuccess="OnUploadSucceeded"
                                   OnError="OnUploadFailed">
                        @* The component's own wording is "Select files…"; this tab has said
                           "Upload File" since it was written, and the button is the same button. *@
                        <SelectFilesButtonTemplate>
                            <BenIcon Name="upload" Class="me-1" /> Upload File
                        </SelectFilesButtonTemplate>
                    </TelerikUpload>
                </div>
            }
            else
            {
                <span class="text-secondary small" data-testid="case-file-upload-signed-out">
                    Sign in again to add a file.
                </span>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => _showLibraryPicker = true)"><BenIcon Name="image" Class="me-1" />
                Attach from Library
            </button>
        }
    </div>

    @if (_error is not null) { <div class="alert alert-danger py-2 small mb-3">@_error</div> }

    @* The list is mutated in place by upload and delete, so only the failure state is branched
       on here — a wrapping BenListState would hold the load's stale emptiness after the first
       upload. This is the tab from item 119: a 403 read as "this case has no evidence". *@
    @if (_filesResult.Failed)
    {
        <BenListState TItem="CaseFileRecord" Result="@_filesResult" OnRetry="@(() => LoadAsync())" />
    }
    else if (_files.Count == 0)
    {
        <div class="text-secondary text-center py-4 small">
            No files yet. Upload evidence photos, audio, video, or documents for this case.
        </div>
    }

    @* ── File list ───────────────────────────────────────────────────────────── *@
    <div class="d-flex flex-column gap-2">
        @foreach (var file in _files)
        {
            var f = file;
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div class="flex-grow-1">
                            <div class="fw-semibold small mb-1">
                                @f.FileName
                                @* Which files a research board is built from, so the ones a camera named
                                   can be found and renamed (Ben, 2026-09-17). Ordinary case evidence is
                                   the common case and wears no badge — a label on everything labels nothing. *@
                                @if (ShowsType(f.TypeName))
                                {
                                    <span class="badge text-bg-secondary ms-1 fw-normal" data-testid="case-file-type">@f.TypeName</span>
                                }
                            </div>
                            <UserMediaPreview FileId="@f.UploadFileId" FileName="@f.FileName" ContentType="@f.ContentType" FileSize="@f.FileSize" />
                            @if (!string.IsNullOrWhiteSpace(f.Description))
                            {
                                <div class="small text-secondary mt-1">@f.Description</div>
                            }
                            <div class="text-muted mt-1" style="font-size:.7rem;">
                                @FormatSize(f.FileSize) · Added @f.DateCreated.ToViewerLocalTime(UserState).ToDisplayDateTime()
                            </div>
                            <div @onclick:stopPropagation="true">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ToggleComments(f.Id))"><BenIcon Name="message-square" Class="me-1" />
                                    @(_expandedCommentsId == f.Id ? "Hide comments" : "Comments")
                                </button>
                            </div>
                            @if (_expandedCommentsId == f.Id)
                            {
                                <div class="mt-2 border-top pt-2">
                                    @if (f.CreatedByAppUserId == UserState.UserId)
                                    {
                                        <div class="mb-2">
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _showCommentSettingsId = _showCommentSettingsId == f.Id ? null : f.Id)">
                                                @(_showCommentSettingsId == f.Id ? "▾" : "▸") Comment settings
                                            </button>
                                            @if (_showCommentSettingsId == f.Id)
                                            {
                                                <div class="mt-2">
                                                    <FileCommentSettings @key="@f.UploadFileId" FileId="@f.UploadFileId" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    <FileCommentThread @key="@f.UploadFileId" FileId="@f.UploadFileId"
                                                        CanModerate="@(f.CreatedByAppUserId == UserState.UserId)" />
                                </div>
                            }
                        </div>
                        @if (May(Ben.Data.Common.Enums.OrganizationSecurityAction.Delete))
                        {
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => DeleteFile(f.Id))"><BenIcon Name="trash-2" /></button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── Attach from Library picker ───────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showLibraryPicker" Title="Attach from Library" Size="sm">
    <ChildContent>
        <MediaLibraryGrid PickerMode="true" MultiSelect="true" OnFilesSelected="OnLibraryFilesSelected" />
    </ChildContent>
</BenModal>

@code {
    /// <summary>
    /// Whether a file's kind is worth saying. Everything uploaded here is case evidence unless it came
    /// from somewhere else — a research board, a published board's picture — and saying "Case Evidence"
    /// on every row would bury the two that are not.
    /// </summary>
    private static bool ShowsType(string? typeName) =>
        !string.IsNullOrWhiteSpace(typeName)
        && !string.Equals(typeName, "Case Evidence", StringComparison.OrdinalIgnoreCase);

    [Parameter, EditorRequired] public Guid OrgId  { get; set; }
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    /// <summary>
    /// What the viewer may do in this organization's <c>Cases</c> area, handed down by
    /// <c>CaseDetail</c> so the tabs and their parent agree without three more round trips.
    /// </summary>
    /// <remarks>
    /// <para>IH-03 step 2. The controller behind this tab used to gate create, update AND delete
    /// on the <c>Case.Read</c> grant, so anyone who could open the case could empty it. The server
    /// now checks the matching action for each verb; these buttons exist so a member who cannot
    /// do the thing is not shown the door to a refusal.</para>
    ///
    /// <para><b>Null means no.</b> The parameter is null while the parent is still loading and if
    /// the permissions call fails, and both of those mean the buttons stay hidden. Hiding a button
    /// from someone entitled to it is a visible annoyance they can report; showing one to someone
    /// who is not is the bug this arc exists to close.</para>
    /// </remarks>
    [Parameter] public MyOrgPermissionsItem? Permissions { get; set; }

    /// <summary>The server-side gate, asked client-side.</summary>
    private bool May(Ben.Data.Common.Enums.OrganizationSecurityAction action)
        => Permissions?.May(Ben.Data.Common.Enums.OrganizationPermissionArea.Cases, action) == true;


    private List<CaseFileRecord> _files = [];
    private LoadResult<CaseFileRecord> _filesResult;
    private bool _loading = true;
    private string? _error;
    private string? _saveUrl;
    private bool _showLibraryPicker;
    private Guid? _expandedCommentsId;
    private Guid? _showCommentSettingsId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    /// <summary>
    /// The upload URL is minted after the first render, not in OnInitialized: the token store is
    /// still resolving auth during prerender, and a URL minted then would be null for somebody who
    /// is perfectly well signed in (see IBenUserState.AuthReady).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await UserState.AuthReady;
        _saveUrl = Uploads.SaveUrlFor(OrgId, CaseId);
        StateHasChanged();
    }

    /// <summary>The API's answer to one finished upload: the file, as the list shows it.</summary>
    private async Task OnUploadSucceeded(UploadSuccessEventArgs e)
    {
        // The component reports each file as it lands, so the list is rebuilt rather than guessed
        // at from the response — which also picks up anything somebody else added meanwhile.
        _error = null;
        await LoadAsync(quiet: true);
        StateHasChanged();
    }

    private void OnUploadFailed(UploadErrorEventArgs e)
    {
        // The server's own sentence when it sent one; its status otherwise. Never a bare "failed":
        // the refusals here are things a person can act on — too large, wrong kind, out of room.
        var said = e.Request?.ResponseText;
        _error = string.IsNullOrWhiteSpace(said)
            ? "That file could not be added to the case."
            : said!.Trim('"');
        StateHasChanged();
    }

    private async Task LoadAsync(bool quiet = false)
    {
        // Quiet, after an upload: the loader replaces the whole list, so every audio and video
        // preview already on the tab is torn down and rebuilt — a player half way through decoding
        // a recording loses it, and the person watching sees the tab blink. The first load has
        // nothing to lose and shows the loader.
        if (!quiet) _loading = true;
        try
        {
            _filesResult = await AdminClient.GetCaseFilesAsync(OrgId, CaseId);
            _files       = _filesResult.Items.ToList();
        }
        catch { _filesResult = LoadResult<CaseFileRecord>.Failure(); }
        _loading = false;
    }

    private async Task OnLibraryFilesSelected(IReadOnlyList<UploadFileRecord> selected)
    {
        _showLibraryPicker = false;
        foreach (var file in selected)
        {
            try
            {
                var result = await AdminClient.LinkCaseFileAsync(OrgId, CaseId, file.Id);
                if (result is not null) _files.Insert(0, result);
            }
            catch { _error = $"Failed to attach '{file.FileName}'."; }
        }
        StateHasChanged();
    }

    private void ToggleComments(Guid caseFileId)
    {
        _expandedCommentsId = _expandedCommentsId == caseFileId ? null : caseFileId;
        _showCommentSettingsId = null;
    }

    private async Task DeleteFile(Guid caseFileId)
    {
        await AdminClient.DeleteCaseFileAsync(OrgId, CaseId, caseFileId);
        _files.RemoveAll(f => f.Id == caseFileId);
        StateHasChanged();
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024             => $"{bytes} B",
        < 1024 * 1024      => $"{bytes / 1024.0:0.#} KB",
        _                  => $"{bytes / (1024.0 * 1024):0.#} MB",
    };
}
