@page "/organizations/{OrgId:guid}/cases/{CaseId:guid}/video-editor"
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject ProjectService Projects
@inject ProjectStore ProjectStore
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject VideoExportPublisher ExportPublisher
@inject BenToastService Toasts

<PageTitle>Case Video Editor</PageTitle>

@if (_case is null && !_loaded)
{
    <BenLoaderOverlay Visible="true" Text="Loading…" />
    return;
}

@if (_error is not null)
{
    <div class="container py-3"><div class="alert alert-danger">@_error</div></div>
    return;
}

@* 100vh alone ignores the site's TelerikAppBar (58px) sitting above <main>, which has no
   explicit height of its own for a height:100% chain to resolve against — the 58px
   overshoot pushed the video editor's transport controls below the visible viewport. *@
<div class="d-flex flex-column" style="height:calc(100vh - 58px); overflow:hidden;">

    @* ── Header bar ──────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-3 px-3 py-2 border-bottom bg-body" style="flex:0 0 auto;">
        <a href="/organizations/@OrgId/cases/@CaseId" class="text-secondary small">← @(_case?.DisplayLabel ?? "Case")</a>
        <span class="vr"></span>
        <h6 class="mb-0 me-auto text-truncate" style="max-width:300px;">Case Video Editor</h6>

        @if (_caseProjects.Count > 0)
        {
            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _showProjectList = true)"><BenIcon Name="folder" Class="me-1" />
                Case Projects (@_caseProjects.Count)
            </button>
        }

        @if (_saving)
        {
            <span class="text-muted small">Saving…</span>
        }
        else
        {
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveProjectAsync"><BenIcon Name="save" Class="me-1" />Save to Case</button>
        }
    </div>

    @* ── Editor (full remaining height) ─────────────────────────────────── *@
    <div style="flex:1 1 auto; min-height:0; overflow:hidden;">
        <VideoEditor OnPublishExport="OnPublishExportAsync"
                     ShowDiagnostics="@(UserState.IsSuperAdmin || UserState.IsAdmin)" />
    </div>
</div>

@* ── Case Projects dialog ────────────────────────────────────────────────── *@
<BenModal @bind-Visible="_showProjectList" Title="Case Projects" Size="lg">
    <ChildContent>
        @if (_loadingList)
        {
            <BenLoaderOverlay Visible="true" Text="Loading…" />
        }
        else if (_caseProjects.Count == 0)
        {
            <p class="text-muted">No projects saved to this case yet.</p>
        }
        else
        {
            <TelerikGrid Data="@_caseProjects" Pageable="false" Sortable="false" Height="380px">
                <GridColumns>
                    <GridColumn Field="@nameof(VideoProjectRecord.Name)" Title="Name" />
                    <GridColumn Title="By" Width="130px">
                        <Template>
                            @* GetMyVideoProjectsAsync only ever returns the viewer's own projects. *@
                            <span class="text-muted small">You</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Title="Saved" Width="110px">
                        <Template>
                            @{ var proj = (VideoProjectRecord)context; }
                            @proj.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                        </Template>
                    </GridColumn>
                    <GridColumn Width="160px">
                        <Template>
                            @{ var row2 = (VideoProjectRecord)context; }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenProjectAsync(row2))">Open</button>
                            <button type="button" class="btn btn-success btn-sm" @onclick="@(() => TriggerPublishAsync(row2))" disabled="@(!(!_publishing))" title="Publish rendered video to case"><BenIcon Name="upload" /></button>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => ConfirmDelete(row2))"><BenIcon Name="trash-2" /></button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        }
    </ChildContent>
</BenModal>

@* ── Delete confirm ──────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="_showDeleteConfirm" Title="Delete Project" Size="sm">
    <ChildContent>
        <p>Delete <strong>@_deleteTarget?.Name</strong>? This cannot be undone.</p>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showDeleteConfirm = false)">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
        </div>
    </ChildContent>
</BenModal>

@* Hidden file input triggered by TriggerPublishAsync — accepts the rendered export from the user's Downloads *@
<InputFile id="publish-input-case" OnChange="OnPublishFileSelectedAsync" accept="video/*" style="display:none" />

@code {
    [Parameter] public Guid OrgId { get; set; }
    [Parameter] public Guid CaseId { get; set; }

    private CaseRecord? _case;
    private bool _loaded;
    private string? _error;
    private List<VideoProjectRecord> _caseProjects = [];
    private bool _loadingList;
    private bool _showProjectList;
    private bool _saving;
    private bool _publishing;
    private bool _showDeleteConfirm;
    private VideoProjectRecord? _deleteTarget;
    private VideoProjectRecord? _publishTarget;
    /// <summary>Server project id established by an earlier publish this session, so a second
    /// export updates the same project instead of creating a new row per render.</summary>
    private Guid? _publishedProjectId;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { _error = "You must be signed in."; _loaded = true; return; }

        try
        {
            _case = await AdminClient.GetOrgCaseAsync(OrgId, CaseId);
            if (_case is null) { _error = "Case not found."; _loaded = true; return; }

            // Set the default project name from the case title
            ProjectStore.CurrentProjectName = _case.Title ?? "Case Project";

            _caseProjects = (await AdminClient.GetMyVideoProjectsAsync(CaseId)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task LoadCaseProjectsAsync()
    {
        _loadingList = true;
        _caseProjects = (await AdminClient.GetMyVideoProjectsAsync(CaseId)).ToList();
        _loadingList = false;
    }

    private async Task SaveProjectAsync()
    {
        _saving = true;
        StateHasChanged();
        try
        {
            var file   = Projects.BuildCurrentProjectFile(ProjectStore.CurrentProjectName);
            var record = await AdminClient.SaveMyVideoProjectAsync(file, CaseId);
            if (record is not null)
            {
                _caseProjects.Insert(0, record);
                Toasts.Success("Project saved to case.");
            }
            else
            {
                Toasts.Error("Save failed.");
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenProjectAsync(VideoProjectRecord record)
    {
        _showProjectList = false;
        try
        {
            var file = System.Text.Json.JsonSerializer.Deserialize<Ben.Video.Editor.Models.ProjectFile>(
                record.ProjectJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (file is not null)
                await ProjectStore.LoadFromFileAsync(file, record.Name, record.Id);
        }
        catch
        {
            Toasts.Error("Could not load project.");
        }
    }

    private void ConfirmDelete(VideoProjectRecord record)
    {
        _deleteTarget = record;
        _showDeleteConfirm = true;
    }

    private async Task DeleteConfirmedAsync()
    {
        _showDeleteConfirm = false;
        if (_deleteTarget is null) return;
        var ok = await AdminClient.DeleteMyVideoProjectAsync(_deleteTarget.Id);
        if (ok)
        {
            _caseProjects.Remove(_deleteTarget);
            Toasts.Success("Project deleted.");
        }
        else
        {
            Toasts.Error("Failed to delete the project. Please try again.");
        }
        _deleteTarget = null;
    }

    /// <summary>
    /// The editor's own "Upload to server" destination — the render goes straight from the export
    /// to the case, with no trip through the user's Downloads folder and no re-selecting the file.
    /// The <see cref="TriggerPublishAsync"/> flow below stays for publishing a file the user already
    /// has on disk (an older export, or one made before this existed).
    /// </summary>
    private async Task OnPublishExportAsync(ExportedVideo exported)
    {
        // No try/catch on purpose: VideoEditor's destination prompt needs the exception to know
        // the upload failed, so it can stay open and keep "Save to my machine" offered rather than
        // discarding the user's only copy. Notifications here are for the SUCCESS path only.
        var result = await ExportPublisher.PublishAsync(exported, CaseId, _publishedProjectId);
        _publishedProjectId = result.ProjectId;

        var idx = _caseProjects.FindIndex(p => p.Id == result.Record.Id);
        if (idx >= 0) _caseProjects[idx] = result.Record;
        else          _caseProjects.Add(result.Record);

        Toasts.Success("Video published to case.");
        StateHasChanged();
    }

    /// <summary>
    /// Opens the hidden file input's native picker. Goes through a typed interop module rather
    /// than <c>eval</c>: the id is a constant, so this was never an injection risk, but the eval
    /// form required <c>unsafe-eval</c> in the CSP and threw an unhandled TypeError — fatal to the
    /// whole circuit under Interactive Server — if the input ever wasn't on the page.
    /// </summary>
    private async Task TriggerPublishAsync(VideoProjectRecord record)
    {
        _publishTarget = record;
        await using var dom = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "/_content/Ben.Web.Website.Library/js/domInterop.js");
        await dom.InvokeVoidAsync("clickElementById", "publish-input-case");
    }

    private async Task OnPublishFileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_publishTarget is null || e.FileCount == 0) return;
        _publishing = true;
        StateHasChanged();
        try
        {
            // No practical upload size limit for now — a future limit belongs at app-settings /
            // per-person / per-org / per-case / per-investigation scope, not a blanket cap here.
            const long maxBytes = long.MaxValue;
            using var ms = new System.IO.MemoryStream();
            await e.File.OpenReadStream(maxBytes).CopyToAsync(ms);
            var bytes  = ms.ToArray();
            var record = await AdminClient.PublishVideoProjectAsync(
                _publishTarget.Id, bytes, e.File.Name, e.File.ContentType);
            if (record is not null)
            {
                var idx = _caseProjects.FindIndex(p => p.Id == record.Id);
                if (idx >= 0) _caseProjects[idx] = record;
                Toasts.Success("Video published to case.");
            }
            else
            {
                Toasts.Error("Publish failed.");
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Publish error: {ex.Message}");
        }
        finally
        {
            _publishing = false;
            _publishTarget = null;
        }
    }
}
