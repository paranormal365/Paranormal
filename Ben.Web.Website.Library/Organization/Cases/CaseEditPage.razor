@page "/organizations/{OrgId:guid}/cases/{CaseId:guid}/edit"
@using Ben.Data.Common.Enums
@using Ben.Data.Common.Text
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

@*
    Editing a case, on a page of its own.

    It was a dialog. Ben, 2026-09-14: "When editing a case, I don't think it makes sense to just use a
    modal because the case definition can be different lengths." The description is the client's first
    account of what is happening — a line for some cases, several paragraphs for others — and a dialog
    gives it whatever room is left after the fields around it. On a page the description takes the wide
    column and the publishing decisions sit beside it, together, which is how they are made.

    Everything the dialog did happens here unchanged: the publish leak check while the choice is being
    made (W-P4, item 176), the second Save that publishes past a warning, the privacy retrofit (item 182),
    the plan's word on private engagements (item 193). New Case is a page too; the two now look alike.
*@

<PageTitle>Edit @(_case?.DisplayLabel ?? "case")</PageTitle>

<div class="container-fluid py-3 case-edit" id="case-edit-page" style="max-width:1200px;">
    @* Save and Cancel sit in the header, where they are on screen the moment the page opens at any width, and again
       after the form. Not a sticky bar: the site's .content-wrapper sets overflow-x:hidden, which makes it the
       scrolling box a sticky child pins to — the bottom of the whole page, not the window (the seat picker's
       stylesheet records the same finding). *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <a class="btn btn-outline-secondary" href="@CaseHref"><BenIcon Name="chevron-left" Class="me-1" />Back to the case</a>
        <h4 class="mb-0 me-auto">Edit case@(_case is null ? "" : $" — {_case.DisplayLabel}")</h4>
        @if (_loaded && _mayEdit && _case is not null)
        {
            @Actions("case-edit")
        }
    </div>

    @if (!_loaded)
    {
        <BenLoaderOverlay Visible="true" Text="Loading case…" />
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger">@_loadError <a href="@CaseHref">Back to the case</a></div>
    }
    else if (!_mayEdit)
    {
        <div class="alert alert-secondary" data-testid="case-edit-not-allowed">
            Your role in this group can read this case but not change it. <a href="@CaseHref">Back to the case</a>
        </div>
    }
    else if (_case is not null)
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="casedetail-case-label-surname-city-0146">Case Label <span class="text-secondary fw-normal small">(surname, city state)</span></label>
                            @* W-P4: the check re-runs when the label is left, not only at Save. Bound on change with
                               bind:after, not on input plus a separate onblur: the blur handler used to run before the
                               last keystrokes had reached the server, and checked the old label. The change event
                               carries the final value and the check runs after it is applied. *@
                            <input id="casedetail-case-label-surname-city-0146" type="text" class="form-control" @bind="@_editTitle" @bind:after="CheckLeaksAsync" />
                        </div>
                        <div id="case-edit-description">
                            <div class="form-label fw-semibold">Description <span class="text-secondary fw-normal small">(shown on the case as its summary)</span></div>
                            @* min(): tall on a desk, never taller than most of a phone's screen. *@
                            <BenEditor @ref="_descriptionEditor" @bind-Value="@_editDescription" Height="min(60vh, 560px)" Tools="@CaseEditorTools.Prose" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card">
                    <div class="card-header fw-semibold">Status and publishing</div>
                    <div class="card-body d-flex flex-column gap-3">
                        <div>
                            <label class="form-label fw-semibold" for="case-edit-status">Status</label>
                            <select id="case-edit-status" class="form-select" @bind="@_editStatus">
                                @foreach (var s in Enum.GetValues<CaseStatus>())
                                {
                                    <option value="@s">@s.Label()</option>
                                }
                            </select>
                            @* Item 183. There is no Delete here and there never was; a case is a record of real
                               work, usually for a client, so it is closed and kept. The one route out for a
                               genuine mistake is named, because a rule with no path is worse than no rule. *@
                            <p class="text-secondary small mt-2 mb-0" data-testid="cases-are-closed-not-deleted">
                                A case is never deleted — set it to <strong>Closed</strong> and it stays as a
                                record of the work. Opened one by mistake, or twice?
                                <a href="/contact">Ask us to remove it</a>.
                            </p>
                        </div>

                        <div>
                            <label class="form-label fw-semibold" for="casedetail-public-pseudonym-88c6">Public Pseudonym</label>
                            <input id="casedetail-public-pseudonym-88c6" type="text" class="form-control" placeholder="e.g. The Henderson Family" @bind="@_editPseudonym" @bind:after="CheckLeaksAsync" />
                            <div class="form-text">Shown on public pages instead of the client's real name.</div>
                        </div>

                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="case-public"
                                   @bind="@_editIsPublic" @bind:after="CheckLeaksAsync" />
                            <label for="case-public" class="form-check-label">Make Public</label>
                        </div>

                        @* W-P4: the warning sits with the decision it is about, while it is being made. *@
                        @if (_leakWarnings.Count > 0)
                        {
                            <div class="alert alert-warning mb-0" id="case-title-leak-warning">
                                <strong>Before this goes public:</strong>
                                <ul class="mb-1">
                                    @foreach (var w in _leakWarnings) { <li>@w</li> }
                                </ul>
                                <span class="small">This is a warning, not a refusal — Save again to publish with this label.</span>
                            </div>
                        }

                        @* Item 193: the plan is knowable before the click — say so beside the control rather
                           than after the attempt. Already-private cases keep the box readable (and clearable):
                           the plan governs new commitments, not work in hand. *@
                        @{ var mayGoPrivate = _planIncludesPrivate || _editIsPrivate; }
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="case-private-engagement"
                                   @bind="@_editIsPrivate" disabled="@(!mayGoPrivate)" />
                            <label for="case-private-engagement" class="form-check-label">Private engagement<HelpLink Slug="working-a-case" Anchor="private-engagements" /></label>
                            <div class="form-text">
                                A client's home rather than a public place. Real names are replaced on every
                                public page, and publishing the case requires a plan that includes
                                private-residence work.
                            </div>
                            @if (!mayGoPrivate)
                            {
                                <div class="form-text text-warning" data-testid="private-needs-plan">
                                    Your group's plan covers public investigations only.
                                    <a href="/pricing">See what each plan includes.</a>
                                </div>
                            }
                        </div>

                        <div>
                            <label class="form-label fw-semibold" for="case-edit-manager">Case Manager</label>
                            <select id="case-edit-manager" class="form-select" @bind="@_editCaseManagerKey">
                                <option value="">— Unassigned —</option>
                                @foreach (var m in _members)
                                {
                                    <option value="@m.Id">@m.Label</option>
                                }
                            </select>
                        </div>

                        <div>
                            <button type="button" class="btn btn-outline-secondary w-100" id="case-apply-privacy"
                                    @onclick="ApplyPrivacyAsync" disabled="@_busy">
                                Apply privacy protections
                            </button>
                            <div class="form-text">
                                Makes the case private, removes exact coordinates, cleans location data from its
                                files, and lists any writing that names the client.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
            <span class="me-auto"></span>
            @Actions("case-edit-bottom")
        </div>
    }
</div>

<BenLeaveGuard @ref="_leaveGuard" Dirty="@IsDirty" />

@* ── Item 182: what applying privacy protections did ─────────────────────── *@
<BenModal @bind-Visible="@_showPrivacyResult" Title="Privacy protections applied">
    <ChildContent>
        @if (_privacyResult is { } r)
        {
            <ul class="mb-3">
                <li>@(r.MadePrivate ? "The case is now private." : "The case was already private.")</li>
                <li>@(r.LocationGeneralized ? "The exact coordinates were removed." : "There were no exact coordinates stored.")</li>
                <li>
                    @r.FilesStripped file(s) had their location data removed just now;
                    @r.FilesAlreadyClean already had.
                    @if (r.FilesUnstrippable > 0)
                    {
                        <text>@r.FilesUnstrippable could not be cleaned on this site — audio and video need the media tool, and your plan must include it.</text>
                    }
                </li>
            </ul>

            @if (r.WasEverPublic)
            {
                @* The half that cannot be fixed by software, said plainly rather than buried. *@
                <div class="alert alert-warning py-2">
                    <strong>This case was public before now.</strong> Anything a visitor already saw,
                    a search engine already indexed, or somebody already saved cannot be recalled.
                    Making it private stops it going further; it does not undo what has been.
                </div>
            }

            @if (r.NameOccurrences.Count > 0)
            {
                <p class="fw-semibold mb-1">Your client's name still appears in text somebody wrote:</p>
                <p class="text-secondary small">
                    These are left exactly as written — an account of a night is the investigator's,
                    and a find-and-replace through it can change what it says. Edit the ones that
                    should use the pseudonym instead.
                </p>
                <ul class="mb-0">
                    @foreach (var o in r.NameOccurrences)
                    {
                        <li>@o.Where — @o.Field (<code>@o.Matched</code>)</li>
                    }
                </ul>
            }
            else
            {
                <p class="text-success mb-0">No prose on this case names the client.</p>
            }
        }
        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>
            <button type="button" class="btn btn-primary" @onclick="@(() => _showPrivacyResult = false)">Close</button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }
    [Parameter] public Guid CaseId { get; set; }

    private string CaseHref => $"/organizations/{OrgId}/cases/{CaseId}";

    /// <summary>The unsaved-changes line, any error, Cancel and Save — drawn in the header and again after the form.</summary>
    private RenderFragment Actions(string idPrefix) => __builder =>
    {
        <div class="d-flex flex-wrap align-items-center gap-2" data-testid="@($"{idPrefix}-actions")">
            @if (_editError is not null)
            {
                <div class="alert alert-danger py-1 px-2 mb-0 small" id="@($"{idPrefix}-error")">@_editError</div>
            }
            else if (IsDirty)
            {
                <span class="text-secondary small">Unsaved changes</span>
            }
            <button type="button" class="btn btn-secondary" id="@($"{idPrefix}-cancel")" @onclick="Cancel">Cancel</button>
            <button type="button" class="btn btn-primary" id="@($"{idPrefix}-save")" @onclick="SaveAsync" disabled="@_busy">
                <BenIcon Name="save" Class="me-1" />@(_busy ? "Saving…" : "Save")
            </button>
        </div>
    };

    private CaseRecord? _case;
    private bool _loaded;
    private string? _loadError;
    private bool _mayEdit;
    private bool _busy;
    private string? _editError;
    private BenLeaveGuard? _leaveGuard;

    private string _editTitle = "";
    private CaseStatus _editStatus;
    private string _editDescription = "";
    private BenEditor? _descriptionEditor;
    private string _editPseudonym = "";
    private bool _editIsPublic;
    private bool _editIsPrivate;
    private string _editCaseManagerKey = "";

    /// <summary>Whether the group's plan covers private-residence work (item 193). Fails open, as the server does.</summary>
    private bool _planIncludesPrivate = true;

    private List<(Guid Id, string Label)> _members = [];

    /// <summary>What the form held when it was loaded or last saved — the baseline for "unsaved changes".</summary>
    private string _baseline = "";

    // Item 176: warnings are remembered per exact input pair, so the second Save on the same text publishes
    // as-is and any edit re-checks.
    private IReadOnlyList<string> _leakWarnings = [];
    private string? _leakWarnedInputs;

    private bool _showPrivacyResult;
    private CasePrivacyRetrofitResult? _privacyResult;

    private Guid? EditCaseManagerId => Guid.TryParse(_editCaseManagerKey, out var id) ? id : null;

    private string Snapshot() =>
        string.Join("\u001f", _editTitle, _editStatus, DescriptionKey(_editDescription), _editPseudonym, _editIsPublic, _editIsPrivate, _editCaseManagerKey);

    private bool IsDirty => _case is not null && _mayEdit && Snapshot() != _baseline;

    /// <summary>
    /// The description as compared for "unsaved changes". The editor wraps a description stored as plain text in a
    /// paragraph the moment it loads; that is not a change anybody made, and must not make leaving the page ask.
    /// </summary>
    private static string DescriptionKey(string? html) =>
        PlainTextHtml.LooksLikeHtml(html) ? html!.Trim() : PlainTextHtml.FromPlainText(html);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            var perms = await AdminClient.GetMyOrgPermissionsAsync(OrgId);
            _mayEdit = perms?.May(OrganizationPermissionArea.Cases, OrganizationSecurityAction.Update) == true;
            _planIncludesPrivate = perms?.PlanIncludes(TierCapability.PrivateResidenceCases) ?? true;
        }
        catch { _mayEdit = false; }

        try { _case = await AdminClient.GetOrgCaseAsync(OrgId, CaseId); }
        catch { _case = null; }
        if (_case is null) _loadError = "This case could not be loaded.";
        else Fill(_case);

        _loaded = true;

        if (_mayEdit && _case is not null)
        {
            try
            {
                var members = (await AdminClient.GetOrganizationMembersAsync(OrgId)).Items;
                _members = members
                    .Where(m => m.IsActive)
                    .OrderBy(m => m.DisplayName)
                    .Select(m => (m.AppUserId, m.DisplayName ?? m.AppUserId.ToString()))
                    .ToList();
            }
            catch { /* the list just offers Unassigned and the current manager is kept */ }
        }
    }

    private void Fill(CaseRecord c)
    {
        _editTitle          = c.Title;
        _editStatus         = c.Status;
        _editDescription    = c.Description ?? "";
        _editPseudonym      = c.PublicPseudonym ?? "";
        _editIsPublic       = c.IsPublic;
        _editIsPrivate      = c.IsPrivateEngagement;
        _editCaseManagerKey = c.CaseManagerAppUserId?.ToString() ?? "";
        _baseline = Snapshot();
    }

    /// <summary>
    /// Runs the publish leak check now, while the choice is being made (W-P4).
    /// </summary>
    /// <remarks>
    /// Silent when the case is not going public and silent when the check itself fails: an advisory that cannot
    /// run must never look like an all-clear or like a problem. This shows the warning; it does not spend it —
    /// the first Save still stops once and asks for a second.
    /// </remarks>
    private async Task CheckLeaksAsync()
    {
        if (!_editIsPublic || string.IsNullOrWhiteSpace(_editTitle))
        {
            _leakWarnings = [];
            return;
        }

        var title = _editTitle.Trim();
        var pseudonym = _editPseudonym.Trim();
        var check = await AdminClient.GetPublishLeakWarningsAsync(OrgId, CaseId, title, pseudonym);
        if (check.Failed) return;

        // Two checks can be in flight at once — ticking Make Public and leaving the label each start one — and
        // their answers can arrive in either order. An answer about words that are no longer in the form must not
        // replace the answer about the words that are (e2e suite, 2026-09-14).
        if (!_editIsPublic || title != _editTitle.Trim() || pseudonym != _editPseudonym.Trim()) return;
        _leakWarnings = check.Items;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editTitle)) { _editError = "The case needs a label."; return; }
        // What the editor holds now, not its last debounced report — see BenEditor.GetCurrentHtmlAsync.
        if (_descriptionEditor is not null) _editDescription = await _descriptionEditor.GetCurrentHtmlAsync() ?? _editDescription;
        _busy = true; _editError = null;
        try
        {
            var leakInputs = $"{_editTitle.Trim()}\n{_editPseudonym.Trim()}";
            if (_editIsPublic && _leakWarnedInputs != leakInputs)
            {
                var check = await AdminClient.GetPublishLeakWarningsAsync(OrgId, CaseId, _editTitle.Trim(), _editPseudonym.Trim());
                // A check that couldn't run is silence, not a warning.
                if (!check.Failed && check.Items.Count > 0)
                {
                    _leakWarnings = check.Items;
                    _leakWarnedInputs = leakInputs;
                    return;
                }
            }
            _leakWarnings = [];

            var request = new UpdateCaseRequest(
                Title:                _editTitle.Trim(),
                Description:          PlainTextHtml.HasText(_editDescription) ? _editDescription.Trim() : null,
                Status:               _editStatus,
                PublicPseudonym:      string.IsNullOrWhiteSpace(_editPseudonym) ? null : _editPseudonym.Trim(),
                IsPublic:             _editIsPublic,
                CaseManagerAppUserId: EditCaseManagerId,
                IsPrivateEngagement:  _editIsPrivate);

            var (result, error) = await AdminClient.UpdateOrgCaseAsync(OrgId, CaseId, request);
            if (result is null)
            {
                _editError = error ?? "The case could not be saved.";
                return;
            }

            _case = result;
            Fill(result);
            _leaveGuard?.Release();
            NavManager.NavigateTo(CaseHref);
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private void Cancel()
    {
        // Cancel is a decision to discard, so it does not ask.
        _leaveGuard?.Release();
        NavManager.NavigateTo(CaseHref);
    }

    private async Task ApplyPrivacyAsync()
    {
        _busy = true; _editError = null;
        try
        {
            var (result, error) = await AdminClient.ApplyCasePrivacyAsync(OrgId, CaseId);
            if (result is null) { _editError = error ?? "Privacy protections could not be applied."; return; }
            _privacyResult = result;
            _showPrivacyResult = true;

            // The retrofit changed the case on the server (private, coordinates). Reload the form from it, keeping
            // anything typed that the retrofit does not own.
            if (await AdminClient.GetOrgCaseAsync(OrgId, CaseId) is { } refreshed)
            {
                _case = refreshed;
                _editIsPrivate = refreshed.IsPrivateEngagement;
                _editIsPublic = refreshed.IsPublic;
            }
        }
        finally { _busy = false; }
    }
}
