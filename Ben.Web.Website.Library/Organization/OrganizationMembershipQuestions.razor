@page "/organizations/{OrgId:guid}/membership-questions"
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

<PageTitle>Membership Questions</PageTitle>

<div class="container-fluid py-3" style="max-width:760px;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Membership Questions</h4>
        <button type="button" class="btn btn-primary" @onclick="OpenAdd"><BenIcon Name="plus" Class="me-1" />Add Question</button>
    </div>
    <p class="text-secondary small mb-3">
        Applicants will be asked to answer these questions when submitting a membership request.
        Required questions must be answered before the request can be submitted.
    </p>

    @if (_error is not null) { <div class="alert alert-danger">@_error</div> }

    @if (_questions is null)
    {
        <BenLoaderOverlay Visible="true" Text="Loading questions…" />
    }
    else if (_questions.Count == 0)
    {
        <div class="text-secondary p-3 border rounded">
            No custom questions yet. Applicants will only provide their profile and a message.
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var q in _questions.OrderBy(x => x.SortOrder))
            {
                var question = q;
                <div class="card">
                    <div class="card-body d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="d-flex gap-2 align-items-center mb-1">
                                <span class="badge @(q.IsRequired ? "bg-danger" : "bg-secondary")">
                                    @(q.IsRequired ? "Required" : "Optional")
                                </span>
                                @if (!q.IsActive) { <span class="badge bg-body-secondary text-body-emphasis border">Inactive</span> }
                                <small class="text-secondary">#@q.SortOrder</small>
                            </div>
                            <span>@q.QuestionText</span>
                        </div>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => OpenEdit(question))"><BenIcon Name="edit-2" /></button>
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ConfirmDelete(question))"><BenIcon Name="trash-2" /></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Add / Edit dialog ────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDialog" Title="@(_editQ is null ? "Add Question" : "Edit Question")">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="organizationmembershipquestions-question-text-856d">Question Text <span class="text-danger">*</span></label>
                <textarea id="organizationmembershipquestions-question-text-856d" class="form-control" rows="3" placeholder="e.g. Why do you want to join our organization?" @bind="@_form.QuestionText"></textarea>
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold" for="organizationmembershipquestions-sort-order-3f8f">Sort Order</label>
                <input id="organizationmembershipquestions-sort-order-3f8f" type="number" class="form-control" min="1" max="100" step="1" @bind="@_form.SortOrder" @bind:event="oninput" />
            </div>
            <div class="col-6 d-flex flex-column gap-2 pt-4">
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" id="q-required" @bind="@_form.IsRequired" />
                    <label for="q-required" class="form-label mb-0">Required</label>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" id="q-active" @bind="@_form.IsActive" />
                    <label for="q-active" class="form-label mb-0">Active</label>
                </div>
            </div>
        </div>
        @if (_dialogError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showDialog = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(!(!_isBusy))"><BenIcon Name="save" Class="me-1" />
                @(_isBusy ? "Saving…" : "Save")
            </button>
        </div>
    </ChildContent>
</BenModal>

@* ── Delete confirm ───────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDelete" Title="Delete Question" Size="sm">
    <ChildContent><p>Delete this question? Existing answers will also be removed.</p>        <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showDelete = false)">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="ExecuteDelete" disabled="@(!(!_isBusy))">
                @(_isBusy ? "Deleting…" : "Delete")
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }

    private List<OrganizationMembershipQuestionRecord>? _questions;
    private string? _error;
    private bool _isBusy;
    private bool _showDialog;
    private bool _showDelete;
    private OrganizationMembershipQuestionRecord? _editQ;
    private OrganizationMembershipQuestionRecord? _pendingDelete;
    private string? _dialogError;
    private QuestionForm _form = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try { _questions = (await AdminClient.GetMembershipQuestionsAsync(OrgId)).ToList(); }
        catch { _error = "Failed to load questions."; }
    }

    private void OpenAdd()
    {
        _editQ = null;
        _form  = new QuestionForm
        {
            SortOrder = (_questions?.Count ?? 0) + 1,
            IsRequired = true, IsActive = true,
        };
        _dialogError = null;
        _showDialog  = true;
    }

    private void OpenEdit(OrganizationMembershipQuestionRecord q)
    {
        _editQ = q;
        _form  = new QuestionForm
        {
            QuestionText = q.QuestionText,
            IsRequired   = q.IsRequired,
            SortOrder    = q.SortOrder,
            IsActive     = q.IsActive,
        };
        _dialogError = null;
        _showDialog  = true;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.QuestionText))
        {
            _dialogError = "Question text is required.";
            return;
        }
        _isBusy = true; _dialogError = null;
        try
        {
            var req = new UpsertMembershipQuestionRequest(
                _form.QuestionText.Trim(), _form.IsRequired, _form.SortOrder, _form.IsActive);

            var result = _editQ is null
                ? await AdminClient.CreateMembershipQuestionAsync(OrgId, req)
                : await AdminClient.UpdateMembershipQuestionAsync(OrgId, _editQ.Id, req);

            if (result is null) { _dialogError = "Save failed."; }
            else { _showDialog = false; await LoadAsync(); }
        }
        catch (Exception ex) { _dialogError = ex.Message; }
        finally { _isBusy = false; }
    }

    private void ConfirmDelete(OrganizationMembershipQuestionRecord q)
    {
        _pendingDelete = q;
        _showDelete    = true;
    }

    private async Task ExecuteDelete()
    {
        if (_pendingDelete is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.DeleteMembershipQuestionAsync(OrgId, _pendingDelete.Id);
            _showDelete = false;
            await LoadAsync();
        }
        catch { _error = "Delete failed."; }
        finally { _isBusy = false; }
    }

    private class QuestionForm
    {
        public string QuestionText { get; set; } = "";
        public bool   IsRequired   { get; set; } = true;
        public int    SortOrder    { get; set; } = 1;
        public bool   IsActive     { get; set; } = true;
    }
}
