@namespace Ben.Web.Website.Library.Organization
@using Ben.Data.Common.Enums
@using System.Timers
@using Ben.Data.Common.Helpers

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@implements IDisposable

@*
   Scheduling a visit that belongs to no client case — a landmark, a public building, a group's own
   outing. The case-bound path already exists on the case's Investigations tab; this is the only way
   to reach the case-less one.

   The part worth reading: as somebody types a place, the server is asked whether it already knows
   it. Duplicated places are how a location's history quietly splits in two, and the cheapest moment
   to stop that is before the second row exists.
*@

<BenModal Visible="true" Title="@(IsEditing ? "Change this investigation" : "Schedule an investigation")" Size="lg">
    <ChildContent>
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small" role="alert" id="newinvestigationwindow-error">@_error</div>
        }

        @if (IsEditing && !_loaded)
        {
            <p class="text-secondary small" role="status">@(_loadFailed ? "" : "Loading this visit…")</p>
        }

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="newinvestigationwindow-title-48f3">Title</label>
                @* Plain input: this gates the Save button, and Telerik's binds on blur — a person
                   who types and clicks Save without leaving the field would be told the title is
                   missing while looking straight at it. *@
                <BenTextBox id="newinvestigationwindow-title-48f3" class="form-control" Value="@_title" OnInput="@(e => _title = e.Value?.ToString() ?? "")"
                            placeholder="e.g. Night investigation" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold" for="newinvestigationwindow-when-60b5">Starts</label>
                <BenDateField Mode="DateEntryMode.DateTime" Id="newinvestigationwindow-when-60b5" @bind-Value="_when" />
                @* The letters at the typed start, not today's (10/16/2026): a November visit typed
                   in October is CST, and the line said CDT. *@
                <div class="form-text" data-testid="newinvestigationwindow-zone">Times are in your time zone (@MyLetters).</div>
            </div>

            @* One arrival and one departure, allowed to cross midnight — 3pm until 8am the next
               morning is one visit. A weekend or a week ticks the box. *@
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="newinvestigationwindow-ends-7c31">Ends (optional)</label>
                @if (_multiDay)
                {
                    <BenDateField Mode="DateEntryMode.DateTime" Id="newinvestigationwindow-ends-7c31" @bind-Value="_end" />
                }
                else
                {
                    <BenTextBox id="newinvestigationwindow-ends-7c31" type="time" class="form-control" Value="@_endTimeText"
                                OnInput="@(e => _endTimeText = e.Value?.ToString() ?? "")" />
                    <div class="form-text">A time at or before the start is the next morning.</div>
                }
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="newinvestigationwindow-multi-day"
                           checked="@_multiDay" @onchange="OnMultiDayChanged" />
                    <label class="form-check-label" for="newinvestigationwindow-multi-day">
                        Runs over more than one day
                    </label>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold" for="newinvestigationwindow-kind-of-place-a45d">Kind of place</label>
                <select id="newinvestigationwindow-kind-of-place-a45d" class="form-select" value="@_kind"
                        @onchange="@(e => OnKindChanged(e.Value?.ToString()))">
                    <option value="@PlaceKind.PublicLocation" selected="@(_kind == PlaceKind.PublicLocation)">
                        Public location
                    </option>
                    <option value="@PlaceKind.PrivateResidence" selected="@(_kind == PlaceKind.PrivateResidence)">
                        Private residence
                    </option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold" for="newinvestigationwindow-description-e4f1">Description</label>
                <BenTextArea id="newinvestigationwindow-description-e4f1" class="form-control" rows="2" Value="@_description"
                             OnInput="@(e => _description = e.Value?.ToString() ?? "")"
                             placeholder="What is being investigated, and with what equipment?" />
            </div>
        </div>

        <hr class="my-3" />

        @* ── Where ────────────────────────────────────────────────────────────── *@
        <h6 class="fw-semibold">Where</h6>

        @if (_chosenPlace is { } chosen)
        {
            <div class="alert alert-success py-2 d-flex justify-content-between align-items-center mb-0">
                <div>
                    <div class="fw-semibold">@DescribeCandidate(chosen)</div>
                    <div class="small">
                        @if (chosen.InvestigationCount > 0)
                        {
                            @($"{chosen.InvestigationCount} investigation{(chosen.InvestigationCount == 1 ? "" : "s")} already recorded here.")
                        }
                        else
                        {
                            @("No investigations recorded here yet.")
                        }
                    </div>
                </div>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@ClearChosenPlace">Change</button>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="newinvestigationwindow-name-a-landmark-or-27ff">Name <span class="text-secondary small">(a landmark or building)</span></label>
                    <BenTextBox id="newinvestigationwindow-name-a-landmark-or-27ff" class="form-control" Value="@_name"
                                OnInput="@(e => OnPlaceFieldChanged(() => _name = e.Value?.ToString() ?? ""))"
                                placeholder="Bell Witch Cave" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="newinvestigationwindow-street-address-8dce">Street address</label>
                    <BenTextBox id="newinvestigationwindow-street-address-8dce" class="form-control" Value="@_street"
                                OnInput="@(e => OnPlaceFieldChanged(() => _street = e.Value?.ToString() ?? ""))"
                                placeholder="4512 Belmont Blvd" />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="newinvestigationwindow-city-94c7">City</label>
                    <BenTextBox id="newinvestigationwindow-city-94c7" class="form-control" Value="@_city"
                                OnInput="@(e => OnPlaceFieldChanged(() => _city = e.Value?.ToString() ?? ""))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="newinvestigationwindow-state-871f">State</label>
                    <BenTextBox id="newinvestigationwindow-state-871f" class="form-control" Value="@_state"
                                OnInput="@(e => OnPlaceFieldChanged(() => _state = e.Value?.ToString() ?? ""))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="newinvestigationwindow-postcode-9c56">ZIP code</label>
                    <BenTextBox id="newinvestigationwindow-postcode-9c56" class="form-control" Value="@_zip"
                                OnInput="@(e => OnPlaceFieldChanged(() => _zip = e.Value?.ToString() ?? ""))" />
                </div>
            </div>

            @* ── Places we already have (10/16/2026) ─────────────────────────────
               The duplicate check below wants the whole name, so "Bell Witch" suggested nothing and
               the visit saved a second Bell Witch place. For a public location the name is also
               searched as part of a name or a town, the same search the event forms use. Never
               for a private residence: nobody's home is listed to anybody. *@
            @if (_kind == PlaceKind.PublicLocation && !string.IsNullOrWhiteSpace(_name))
            {
                @if (_publicFinder.IsSearching)
                {
                    <div class="form-text mt-2" role="status">Looking for places we already have…</div>
                }
                else if (_publicFinder.Error is { } publicError)
                {
                    <div class="form-text text-danger mt-2" role="alert">@publicError</div>
                }
                else if (PublicMatches.Count > 0)
                {
                    <div class="border rounded p-2 mt-3 small" id="newinvestigationwindow-public-matches">
                        <div class="fw-semibold mb-1">Places we already have that match “@_name.Trim()”</div>
                        @foreach (var match in PublicMatches)
                        {
                            var pick = match;
                            <div class="d-flex justify-content-between align-items-center gap-2 border-top pt-2 mt-2 flex-wrap">
                                <div>
                                    <div class="fw-semibold">@DescribeCandidate(pick)</div>
                                    <div class="text-secondary">@string.Join(", ", new[] { pick.StreetAddress1, pick.City, pick.State }.Where(p => !string.IsNullOrWhiteSpace(p)))</div>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChoosePlace(pick))">Use this place</button>
                            </div>
                        }
                        <div class="text-secondary mt-2">None of these? Carry on, and a new place is made when you save.</div>
                    </div>
                }
            }

            @* ── "Did you mean" ───────────────────────────────────────────────── *@
            @if (_candidateError is not null)
            {
                <div class="alert alert-warning py-2 small mb-2">@_candidateError</div>
            }
            @if (_candidates.Count > 0)
            {
                <div class="alert alert-info py-2 small mt-3 mb-0">
                    <div class="fw-semibold mb-2">
                        @(_candidates.Count == 1
                            ? "This place may already be on file."
                            : $"{_candidates.Count} places on file look like this one.")
                    </div>

                    @* Offered, never applied. Two flats at one address are two places, and the only
                       person who knows which this is, is the one typing it. *@
                    @foreach (var candidate in _candidates)
                    {
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                            <div>
                                <div class="fw-semibold">@DescribeCandidate(candidate)</div>
                                <div class="text-secondary">
                                    @if (candidate.InvestigationCount > 0)
                                    {
                                        @($"{candidate.InvestigationCount} investigation{(candidate.InvestigationCount == 1 ? "" : "s")} recorded")
                                    }
                                    else
                                    {
                                        @("Nothing recorded there yet")
                                    }
                                    @if (candidate.DistanceMiles is { } miles && miles >= 0.005)
                                    {
                                        @($" · about {miles:0.00} miles away")
                                    }
                                </div>
                            </div>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChoosePlace(candidate))">Use this place</button>
                        </div>
                    }

                    <div class="text-secondary mt-2">
                        None of these? Carry on typing — a new place will be created.
                    </div>
                </div>
            }
        }

        <hr class="my-3" />

        @* ── Sharing ──────────────────────────────────────────────────────────── *@
        <label class="form-label fw-semibold" for="newinvestigationwindow-who-can-see-the-fea9">
            Who can see the findings<HelpLink Slug="working-a-case" Anchor="who-can-see-the-findings" />
        </label>
        @* Plain select for the same reason as the case-bound form: a dropdown that dropped its
           selection here would silently leave a wider scope in place. *@
        @* Two rules narrow this list, and neither is offered-then-refused. The place decides
           whether Public may be chosen; the plan decides whether anything narrower may be. This
           window knows the kind of place because the person picks it, so it can be exact. *@
        @{ var mustBePublic = _publicByDefault && _kind == PlaceKind.PublicLocation; }
        <select id="newinvestigationwindow-who-can-see-the-fea9" class="form-select" style="max-width:420px;" value="@_visibility"
                @onchange="@(e => _visibility = Enum.TryParse<InvestigationVisibility>(e.Value?.ToString(), out var v) ? v : _visibility)">
            @if (!mustBePublic)
            {
                <option value="@InvestigationVisibility.GroupOnly"
                        selected="@(_visibility == InvestigationVisibility.GroupOnly)">
                    Just this group
                </option>
                <option value="@InvestigationVisibility.PlaceInvestigators"
                        selected="@(_visibility == InvestigationVisibility.PlaceInvestigators)">
                    Groups who have also investigated this place
                </option>
            }
            @* Public is not offered at a private home at all. The server refuses it either way;
               leaving it selectable would mean offering a choice that comes back as an error. *@
            @if (_kind != PlaceKind.PrivateResidence)
            {
                <option value="@InvestigationVisibility.Public"
                        selected="@(_visibility == InvestigationVisibility.Public)">
                    Anyone
                </option>
            }
        </select>

        @if (mustBePublic)
        {
            <div class="form-text" data-testid="investigation-scope-locked">
                On this account a visit to a public location is shared with everyone. What you find
                there joins the place's own page.
                <a href="/pricing">See what each plan includes.</a>
            </div>
        }

        @if (_visibility == InvestigationVisibility.PlaceInvestigators)
        {
            <div class="alert alert-warning py-2 small mt-2 mb-0">
                This includes groups who investigate this place <strong>in future</strong>, not only
                the ones who already have.
            </div>
        }
        @if (_visibility == InvestigationVisibility.Public)
        {
            <div class="alert alert-warning py-2 small mt-2 mb-0">
                Anyone can read this, including visitors who are not signed in.
            </div>
        }

        @* ── Cancel or delete (10/16/2026) ─────────────────────────────────────
           Asked inline, never in a dialog (TelerikDialog breaks binding). The server's refusal,
           such as "it has recordings, cancel it instead", shows in the error line above. *@
        @if (IsEditing && _confirming != Confirming.Nothing)
        {
            <div class="alert alert-warning py-2 small mt-3 mb-0 d-flex flex-wrap align-items-center gap-2"
                 role="alert" id="newinvestigationwindow-confirm">
                <span class="flex-grow-1">
                    @(_confirming == Confirming.Cancel
                        ? "Cancel this visit? It stays on record as canceled, and its calendar entry says so."
                        : "Delete this visit? It's removed for good, with its team and its calendar entry.")
                </span>
                <button type="button" class="btn btn-danger btn-sm newinv-touch" id="newinvestigationwindow-confirm-yes"
                        disabled="@_saving" @onclick="@(() => _confirming == Confirming.Cancel ? CancelVisitAsync() : DeleteVisitAsync())">
                    @(_saving ? "Saving…" : _confirming == Confirming.Cancel ? "Yes, cancel it" : "Yes, delete it")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm newinv-touch" id="newinvestigationwindow-confirm-no"
                        disabled="@_saving" @onclick="@(() => _confirming = Confirming.Nothing)">Keep it</button>
            </div>
        }

        <div class="dialog-footer-actions mt-4 d-flex flex-wrap justify-content-end gap-2">
            @if (IsEditing && _loaded)
            {
                <div class="d-flex flex-wrap gap-2 me-auto">
                    <button type="button" class="btn btn-outline-danger" id="newinvestigationwindow-delete"
                            disabled="@_saving" @onclick="@(() => Ask(Confirming.Delete))">Delete</button>
                    @if (_status == InvestigationStatus.Scheduled)
                    {
                        <button type="button" class="btn btn-outline-secondary" id="newinvestigationwindow-cancel-visit"
                                disabled="@_saving" @onclick="@(() => Ask(Confirming.Cancel))">Cancel this visit</button>
                    }
                </div>
            }
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => OnClosed.InvokeAsync())" disabled="@(!(!_saving))">@(IsEditing ? "Close" : "Cancel")</button>
            <button type="button" class="btn btn-primary" id="newinvestigationwindow-save" @onclick="@SaveAsync" disabled="@(!(CanSave && !_saving))">
                @(IsEditing ? (_saving ? "Saving…" : "Save changes") : (_saving ? "Scheduling…" : "Schedule"))
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }

    /// <summary>
    /// A place chosen before the window opened — arriving from that place's own page.
    /// </summary>
    /// <remarks>
    /// Fills the chosen-place banner and settles the kind, so somebody who pressed "Investigate
    /// here" is not asked for an address they are already looking at.
    /// </remarks>
    [Parameter] public Guid? PrechosenPlaceId { get; set; }

    /// <summary>
    /// A visit with no case to change instead of scheduling a new one (10/16/2026).
    /// </summary>
    /// <remarks>
    /// The same window, so changing a visit asks the same questions in the same order as booking
    /// it, with the same place checks. It also offers Cancel this visit and Delete.
    /// </remarks>
    [Parameter] public Guid? EditInvestigationId { get; set; }

    /// <summary>Raised after a successful create, change, cancel or delete, so the caller can refresh.</summary>
    [Parameter] public EventCallback OnCreated { get; set; }

    /// <summary>Raised on cancel, and after <see cref="OnCreated"/>.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private string _title = "";
    private string _description = "";
    private DateTime? _when;
    private DateTime? _end;
    private string _endTimeText = "";
    private bool   _multiDay;
    private PlaceKind _kind = PlaceKind.PublicLocation;
    private InvestigationVisibility _visibility = InvestigationVisibility.PlaceInvestigators;
    private bool _publicByDefault;

    private string _name = "";
    private string _street = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";

    private List<PlaceCandidate> _candidates = [];
    private string? _candidateError;
    private PlaceCandidate? _chosenPlace;

    private Timer? _lookupTimer;
    private bool _saving;
    private string? _error;

    /// <summary>Public places whose name or town matches what is typed (10/16/2026).</summary>
    private readonly Ben.Web.Services.PlaceSearch _publicFinder = new();

    /// <summary>The public matches the duplicate check has not already offered.</summary>
    private List<PlaceCandidate> PublicMatches => _publicFinder.Results
        .Where(p => p.Kind == PlaceKind.PublicLocation && _candidates.All(c => c.Id != p.Id))
        .ToList();

    private bool IsEditing => EditInvestigationId is not null;
    private bool _loaded;
    private bool _loadFailed;
    private InvestigationStatus _status = InvestigationStatus.Scheduled;

    private enum Confirming { Nothing, Cancel, Delete }
    private Confirming _confirming;

    private void Ask(Confirming what)
    {
        _error = null;
        _confirming = what;
    }

    /// <summary>What an &lt;input type="time"&gt; holds: 24-hour, as the browser reads it.</summary>
    private static string TimeBoxValue(DateTime t) => t.ToString("HH:mm");

    /// <summary>
    /// The end a single-day visit gets from a clock time: at or before the start is the next
    /// morning. Null whenever nothing usable has been typed — the field is optional.
    /// </summary>
    private DateTime? EffectiveEnd()
    {
        if (_when is not { } start) return null;

        if (_multiDay)
            return _end is { } end && end > start ? end : null;

        return TimeSpan.TryParse(_endTimeText, out var timeOfDay)
            ? Ben.Web.Services.InvestigationWindow.SingleDayEnd(start, timeOfDay)
            : null;
    }

    /// <summary>Carries the end across the toggle rather than clearing it.</summary>
    private void OnMultiDayChanged(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (on == _multiDay) return;

        var carried = EffectiveEnd();
        _multiDay = on;

        if (on)
        {
            _end = carried ?? _when?.AddDays(1);
            _endTimeText = "";
        }
        else
        {
            _endTimeText = carried is { } carriedEnd ? TimeBoxValue(carriedEnd) : "";
            _end = null;
        }
    }

    /// <summary>
    /// The letters of the clock the times are typed on, as it will be at the typed start: "CST"
    /// for a November visit typed in October. Follows the start as it changes.
    /// </summary>
    private string MyLetters => Ben.Web.Services.InvestigationWindow.ViewerLetters(_when, UserState, DateTime.UtcNow);

    private bool CanSave =>
        (!IsEditing || _loaded)
        && !string.IsNullOrWhiteSpace(_title)
        && _when is not null
        && (_chosenPlace is not null
            || !string.IsNullOrWhiteSpace(_name)
            || !string.IsNullOrWhiteSpace(_street));

    // ── The "did you mean" lookup ─────────────────────────────────────────────

    /// <summary>
    /// Applies a field edit and restarts the debounce.
    /// </summary>
    /// <remarks>
    /// Debounced rather than run per keystroke: a partial address matches nothing useful, and
    /// asking on every character would mean a request per letter for an answer nobody can act on
    /// until the line is finished.
    /// </remarks>
    private void OnPlaceFieldChanged(Action apply)
    {
        apply();

        _lookupTimer?.Stop();
        _lookupTimer ??= BuildTimer();
        _lookupTimer.Start();
    }

    private Timer BuildTimer()
    {
        var timer = new Timer(600) { AutoReset = false };
        timer.Elapsed += async (_, _) => await InvokeAsync(LookupAsync);
        return timer;
    }

    private async Task LookupAsync()
    {
        if (string.IsNullOrWhiteSpace(_street) && string.IsNullOrWhiteSpace(_name))
        {
            _candidates = [];
            _publicFinder.Clear();
            StateHasChanged();
            return;
        }

        try
        {
            // No coordinates yet — nothing has geocoded what is being typed. The server treats
            // unknown distance as "no opinion" and matches on the text, which is the whole reason
            // the rule tolerates a missing position.
            // This list is what stops a second copy of a place being created. Read as "no match
            // exists" when the search was refused, it invites exactly the duplicate it prevents,
            // so a refusal says so instead of returning nothing.
            var found = await AdminClient.FindPlaceCandidatesAsync(
                _street, _city, _state, _zip, _name, latitude: null, longitude: null);

            _candidateError = found.Failed
                ? (found.SessionExpired
                    ? "You've been signed out, so existing places could not be checked."
                    : "Existing places could not be checked just now — saving may create a duplicate.")
                : null;

            _candidates = found.Items.ToList();
        }
        catch
        {
            // A suggestion that cannot be fetched is not an error worth interrupting anybody for.
            // They are creating a place either way; the worst case is a duplicate, which is what
            // the position was before this existed.
            _candidates = [];
        }

        // Part of a name finds the place too, for a public location only (10/16/2026).
        if (_kind == PlaceKind.PublicLocation && !string.IsNullOrWhiteSpace(_name))
            await _publicFinder.SearchAsync(_name, text => AdminClient.SearchPublicPlacesAsync(text));
        else
            _publicFinder.Clear();

        StateHasChanged();
    }

    /// <summary>
    /// Reads the group's plan, because the sharing list depends on it.
    /// </summary>
    /// <remarks>
    /// The window is rendered when it opens, so this runs then. A failure leaves the flag false,
    /// which offers every scope — the server still refuses what it must, and its sentence reaches
    /// the error line, so the worst case is a refusal rather than a hidden option.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        // The reader's zone arrives with sign-in; the suggested start is on their clock.
        await UserState.AuthReady;

        try
        {
            var perms = await AdminClient.GetMyOrgPermissionsAsync(OrgId);
            _publicByDefault = perms?.PublicByDefault ?? false;
        }
        catch { _publicByDefault = false; }

        if (EditInvestigationId is { } editId)
        {
            await LoadForEditAsync(editId);
            return;
        }

        // 7:00 PM tomorrow on the person's own clock (10/16/2026; it was this minute tomorrow).
        _when ??= Ben.Web.Services.InvestigationWindow.DefaultStart(UserState.NowInViewerTimeZone());

        // Arrived from a place's own page, so the place is settled and its kind decides the rest.
        // Read through the anonymous place endpoint: somebody may investigate a place their group
        // has never touched, which is the whole reason the button is on that page.
        if (PrechosenPlaceId is { } prechosen)
        {
            try
            {
                if (await AdminClient.GetPlaceAsync(prechosen) is { } place)
                {
                    _chosenPlace = new PlaceCandidate(
                        place.Id, place.Name, place.StreetAddress1, place.City, place.State,
                        place.Kind, DistanceMiles: null, InvestigationCount: 0);
                    _kind = place.Kind;
                }
            }
            catch { /* the shortcut is a convenience; the form still works by hand */ }
        }

        KeepScopeLegal();
    }

    /// <summary>
    /// Fills the window from a saved visit, its times on the reader's own clock.
    /// </summary>
    /// <remarks>
    /// A failed read says so and leaves Save off: saving a half-filled form over a real visit would
    /// replace what was there with blanks.
    /// </remarks>
    private async Task LoadForEditAsync(Guid id)
    {
        ItemResult<Ben.Service.Models.Entities.InvestigationRecord> found;
        try { found = await AdminClient.GetOrgInvestigationAsync(OrgId, id); }
        catch { found = ItemResult<Ben.Service.Models.Entities.InvestigationRecord>.Failure(); }

        if (found.Failed || found.Item is not { } visit)
        {
            _loadFailed = true;
            _error = found.SessionExpired
                ? "You've been signed out, so this visit couldn't be opened. Sign in again."
                : "This visit couldn't be opened just now, so nothing can be changed yet. Close this and try again.";
            return;
        }

        if (visit.CaseId is not null)
        {
            _loadFailed = true;
            _error = "This visit belongs to a case, so it's changed from the case's Investigations tab.";
            return;
        }

        _title = visit.Title;
        _description = visit.Description ?? "";
        _status = visit.Status;
        _visibility = visit.Visibility;

        var start = visit.ScheduledDateTime.ToViewerLocalTime(UserState);
        _when = start;
        if (visit.EndDateTime is { } endUtc)
        {
            var end = endUtc.ToViewerLocalTime(UserState);
            _multiDay = Ben.Web.Services.InvestigationWindow.NeedsMultiDay(start, end);
            if (_multiDay) _end = end;
            else _endTimeText = TimeBoxValue(end);
        }

        if (visit.PlaceId is { } placeId)
        {
            try
            {
                if (await AdminClient.GetPlaceAsync(placeId) is { } place)
                {
                    _chosenPlace = new PlaceCandidate(
                        place.Id, place.Name, place.StreetAddress1, place.City, place.State,
                        place.Kind, DistanceMiles: null, InvestigationCount: 0);
                    _kind = place.Kind;
                }
            }
            catch { /* the place fields are still there to fill in */ }
        }

        KeepScopeLegal();
        _loaded = true;
    }

    private async Task CancelVisitAsync()
    {
        if (EditInvestigationId is not { } id || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            var (canceled, error) = await AdminClient.CancelOrgInvestigationAsync(OrgId, id);
            if (!canceled)
            {
                _error = error ?? "This visit couldn't be canceled just now, so it's still scheduled.";
                _confirming = Confirming.Nothing;
                return;
            }

            await OnCreated.InvokeAsync();
            await OnClosed.InvokeAsync();
        }
        catch { _error = "This visit couldn't be canceled just now, so it's still scheduled."; }
        finally { _saving = false; }
    }

    private async Task DeleteVisitAsync()
    {
        if (EditInvestigationId is not { } id || _saving) return;
        _saving = true;
        _error = null;
        try
        {
            // The refusal is the server's sentence: what would be lost, and to cancel instead.
            var (deleted, error) = await AdminClient.DeleteOrgInvestigationAsync(OrgId, id);
            if (!deleted)
            {
                _error = error ?? "This visit couldn't be deleted just now.";
                _confirming = Confirming.Nothing;
                return;
            }

            await OnCreated.InvokeAsync();
            await OnClosed.InvokeAsync();
        }
        catch { _error = "This visit couldn't be deleted just now."; }
        finally { _saving = false; }
    }

    private void ChoosePlace(PlaceCandidate candidate)
    {
        _chosenPlace = candidate;
        _candidates = [];
        _publicFinder.Clear();
        _lookupTimer?.Stop();

        // The place decides what kind of location this is, so the sharing options follow it rather
        // than whatever was picked before the place was known.
        _kind = candidate.Kind;
        KeepScopeLegal();
    }

    private void ClearChosenPlace() => _chosenPlace = null;

    private void OnKindChanged(string? value)
    {
        if (!Enum.TryParse<PlaceKind>(value, out var kind)) return;
        _kind = kind;
        // A home is never searched for among listed places; anything already found goes.
        if (kind == PlaceKind.PrivateResidence) _publicFinder.Clear();
        else if (!string.IsNullOrWhiteSpace(_name)) OnPlaceFieldChanged(() => { });
        KeepScopeLegal();
    }

    /// <summary>
    /// Moves the chosen scope to one the server will accept for this kind of place and this plan.
    /// </summary>
    /// <remarks>
    /// Called whenever the kind changes, from either chooser. A scope left behind by a change of
    /// place is the one field where quietly keeping the old value could publish something, or be
    /// refused for a value nobody typed — so it is corrected in one place rather than in two
    /// half-copies. Both directions matter now: moving to a home takes Public off an unpaid
    /// account's visit, and moving to a landmark puts it back.
    /// </remarks>
    private void KeepScopeLegal()
    {
        if (_kind == PlaceKind.PrivateResidence)
        {
            if (_visibility == InvestigationVisibility.Public)
                _visibility = InvestigationVisibility.GroupOnly;
            return;
        }

        if (_publicByDefault) _visibility = InvestigationVisibility.Public;
    }

    private static string DescribeCandidate(PlaceCandidate candidate)
    {
        if (!string.IsNullOrWhiteSpace(candidate.Name)) return candidate.Name!;

        var parts = new[] { candidate.StreetAddress1, candidate.City, candidate.State }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var joined = string.Join(", ", parts);

        return string.IsNullOrWhiteSpace(joined) ? "An unnamed place" : joined;
    }

    // ── Save ──────────────────────────────────────────────────────────────────

    private async Task SaveAsync()
    {
        if (!CanSave || _saving) return;

        _saving = true;
        _error = null;

        try
        {
            // Typed on the person's own clock, stored as UTC (10/16/2026: this went through the
            // server's zone and every visit saved an hour out).
            var (startUtc, endUtc) = Ben.Web.Services.InvestigationWindow.ToUtc(_when!.Value, EffectiveEnd(), UserState);

            if (EditInvestigationId is { } editId)
            {
                var change = new UpdateOrgInvestigationRequest(
                    Title: _title.Trim(),
                    ScheduledDateTime: startUtc,
                    EndDateTime: endUtc,
                    Description: string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    PlaceId: _chosenPlace?.Id,
                    NewPlace: _chosenPlace is not null ? null : NewPlaceFromFields(),
                    Visibility: _visibility);

                var (saved, saveError) = await AdminClient.UpdateOrgInvestigationAsync(OrgId, editId, change);
                if (!saved)
                {
                    _error = saveError ?? "Your changes couldn't be saved just now.";
                    _saving = false;
                    return;
                }

                await OnCreated.InvokeAsync();
                await OnClosed.InvokeAsync();
                _saving = false;
                return;
            }

            var request = new CreateOrgInvestigationRequest(
                Title: _title.Trim(),
                ScheduledDateTime: startUtc,
                EndDateTime: endUtc,
                Description: string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                PlaceId: _chosenPlace?.Id,
                // Only sent when no existing place was picked — otherwise the server would be
                // asked to both use a place and create one.
                NewPlace: _chosenPlace is not null ? null : NewPlaceFromFields(),
                Visibility: _visibility);

            var (created, error) = await AdminClient.CreateOrgInvestigationAsync(OrgId, request);
            if (created is null)
            {
                _error = error ?? "That could not be scheduled just now.";
                _saving = false;
                return;
            }

            await OnCreated.InvokeAsync();
            await OnClosed.InvokeAsync();
        }
        catch
        {
            _error = "That could not be scheduled just now.";
        }

        _saving = false;
    }

    private NewPlaceRequest NewPlaceFromFields() => new(
        Name: Trimmed(_name),
        StreetAddress1: Trimmed(_street),
        StreetAddress2: null,
        City: Trimmed(_city),
        State: Trimmed(_state),
        ZipCode: Trimmed(_zip),
        Country: null,
        Kind: _kind);

    private static string? Trimmed(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        // The timer outlives the component otherwise, and its callback would touch a disposed
        // renderer.
        if (_lookupTimer is null) return;
        _lookupTimer.Stop();
        _lookupTimer.Dispose();
    }
}
