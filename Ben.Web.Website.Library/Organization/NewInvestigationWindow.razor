@namespace Ben.Web.Website.Library.Organization
@using Ben.Data.Common.Enums
@using System.Timers

@inject IBenAdminClient AdminClient
@implements IDisposable

@*
   Scheduling a visit that belongs to no client case — a landmark, a public building, a group's own
   outing. The case-bound path already exists on the case's Investigations tab; this is the only way
   to reach the case-less one.

   The part worth reading: as somebody types a place, the server is asked whether it already knows
   it. Duplicated places are how a location's history quietly splits in two, and the cheapest moment
   to stop that is before the second row exists.
*@

<BenModal Visible="true" Title="Schedule an investigation" Size="lg">
    <ChildContent>
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small">@_error</div>
        }

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="newinvestigationwindow-title-48f3">Title</label>
                @* Plain input: this gates the Save button, and Telerik's binds on blur — a person
                   who types and clicks Save without leaving the field would be told the title is
                   missing while looking straight at it. *@
                <input id="newinvestigationwindow-title-48f3" class="form-control" value="@_title" @oninput="@(e => _title = e.Value?.ToString() ?? "")"
                       placeholder="Night investigation" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold" for="newinvestigationwindow-when-60b5">When</label>
                <input id="newinvestigationwindow-when-60b5" type="datetime-local" class="form-control" value="@_whenText"
                       @oninput="@(e => _whenText = e.Value?.ToString() ?? "")" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold" for="newinvestigationwindow-kind-of-place-a45d">Kind of place</label>
                <select id="newinvestigationwindow-kind-of-place-a45d" class="form-select" value="@_kind"
                        @onchange="@(e => OnKindChanged(e.Value?.ToString()))">
                    <option value="@PlaceKind.PublicLocation" selected="@(_kind == PlaceKind.PublicLocation)">
                        Public location
                    </option>
                    <option value="@PlaceKind.PrivateResidence" selected="@(_kind == PlaceKind.PrivateResidence)">
                        Private residence
                    </option>
                </select>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold" for="newinvestigationwindow-description-e4f1">Description</label>
                <textarea id="newinvestigationwindow-description-e4f1" class="form-control" rows="2" value="@_description"
                          @oninput="@(e => _description = e.Value?.ToString() ?? "")"
                          placeholder="What is being investigated, and with what equipment?"></textarea>
            </div>
        </div>

        <hr class="my-3" />

        @* ── Where ────────────────────────────────────────────────────────────── *@
        <h6 class="fw-semibold">Where</h6>

        @if (_chosenPlace is { } chosen)
        {
            <div class="alert alert-success py-2 d-flex justify-content-between align-items-center mb-0">
                <div>
                    <div class="fw-semibold">@DescribeCandidate(chosen)</div>
                    <div class="small">
                        @if (chosen.InvestigationCount > 0)
                        {
                            @($"{chosen.InvestigationCount} investigation{(chosen.InvestigationCount == 1 ? "" : "s")} already recorded here.")
                        }
                        else
                        {
                            @("No investigations recorded here yet.")
                        }
                    </div>
                </div>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@ClearChosenPlace">Change</button>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="newinvestigationwindow-name-a-landmark-or-27ff">Name <span class="text-secondary small">(a landmark or building)</span></label>
                    <input id="newinvestigationwindow-name-a-landmark-or-27ff" class="form-control" value="@_name"
                           @oninput="@(e => OnPlaceFieldChanged(() => _name = e.Value?.ToString() ?? ""))"
                           placeholder="Bell Witch Cave" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="newinvestigationwindow-street-address-8dce">Street address</label>
                    <input id="newinvestigationwindow-street-address-8dce" class="form-control" value="@_street"
                           @oninput="@(e => OnPlaceFieldChanged(() => _street = e.Value?.ToString() ?? ""))"
                           placeholder="4512 Belmont Blvd" />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="newinvestigationwindow-city-94c7">City</label>
                    <input id="newinvestigationwindow-city-94c7" class="form-control" value="@_city"
                           @oninput="@(e => OnPlaceFieldChanged(() => _city = e.Value?.ToString() ?? ""))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="newinvestigationwindow-state-871f">State</label>
                    <input id="newinvestigationwindow-state-871f" class="form-control" value="@_state"
                           @oninput="@(e => OnPlaceFieldChanged(() => _state = e.Value?.ToString() ?? ""))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="newinvestigationwindow-postcode-9c56">Postcode</label>
                    <input id="newinvestigationwindow-postcode-9c56" class="form-control" value="@_zip"
                           @oninput="@(e => OnPlaceFieldChanged(() => _zip = e.Value?.ToString() ?? ""))" />
                </div>
            </div>

            @* ── "Did you mean" ───────────────────────────────────────────────── *@
            @if (_candidates.Count > 0)
            {
                <div class="alert alert-info py-2 small mt-3 mb-0">
                    <div class="fw-semibold mb-2">
                        @(_candidates.Count == 1
                            ? "This place may already be on file."
                            : $"{_candidates.Count} places on file look like this one.")
                    </div>

                    @* Offered, never applied. Two flats at one address are two places, and the only
                       person who knows which this is, is the one typing it. *@
                    @foreach (var candidate in _candidates)
                    {
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                            <div>
                                <div class="fw-semibold">@DescribeCandidate(candidate)</div>
                                <div class="text-secondary">
                                    @if (candidate.InvestigationCount > 0)
                                    {
                                        @($"{candidate.InvestigationCount} investigation{(candidate.InvestigationCount == 1 ? "" : "s")} recorded")
                                    }
                                    else
                                    {
                                        @("Nothing recorded there yet")
                                    }
                                    @if (candidate.DistanceMiles is { } miles && miles >= 0.005)
                                    {
                                        @($" · about {miles:0.00} miles away")
                                    }
                                </div>
                            </div>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChoosePlace(candidate))">Use this place</button>
                        </div>
                    }

                    <div class="text-secondary mt-2">
                        None of these? Carry on typing — a new place will be created.
                    </div>
                </div>
            }
        }

        <hr class="my-3" />

        @* ── Sharing ──────────────────────────────────────────────────────────── *@
        <label class="form-label fw-semibold" for="newinvestigationwindow-who-can-see-the-fea9">
            Who can see the findings<HelpLink Slug="working-a-case" Anchor="who-can-see-the-findings" />
        </label>
        @* Plain select for the same reason as the case-bound form: a dropdown that dropped its
           selection here would silently leave a wider scope in place. *@
        <select id="newinvestigationwindow-who-can-see-the-fea9" class="form-select" style="max-width:420px;" value="@_visibility"
                @onchange="@(e => _visibility = Enum.TryParse<InvestigationVisibility>(e.Value?.ToString(), out var v) ? v : _visibility)">
            <option value="@InvestigationVisibility.GroupOnly"
                    selected="@(_visibility == InvestigationVisibility.GroupOnly)">
                Just this group
            </option>
            <option value="@InvestigationVisibility.PlaceInvestigators"
                    selected="@(_visibility == InvestigationVisibility.PlaceInvestigators)">
                Groups who have also investigated this place
            </option>
            @* Public is not offered at a private home at all. The server refuses it either way;
               leaving it selectable would mean offering a choice that comes back as an error. *@
            @if (_kind != PlaceKind.PrivateResidence)
            {
                <option value="@InvestigationVisibility.Public"
                        selected="@(_visibility == InvestigationVisibility.Public)">
                    Anyone
                </option>
            }
        </select>

        @if (_visibility == InvestigationVisibility.PlaceInvestigators)
        {
            <div class="alert alert-warning py-2 small mt-2 mb-0">
                This includes groups who investigate this place <strong>in future</strong>, not only
                the ones who already have.
            </div>
        }
        @if (_visibility == InvestigationVisibility.Public)
        {
            <div class="alert alert-warning py-2 small mt-2 mb-0">
                Anyone can read this, including visitors who are not signed in.
            </div>
        }

        <div class="dialog-footer-actions mt-4 d-flex justify-content-end gap-2">
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => OnClosed.InvokeAsync())" disabled="@(!(!_saving))">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="@SaveAsync" disabled="@(!(CanSave && !_saving))">
                @(_saving ? "Scheduling…" : "Schedule")
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter] public Guid OrgId { get; set; }

    /// <summary>Raised after a successful create, so the caller can refresh its list.</summary>
    [Parameter] public EventCallback OnCreated { get; set; }

    /// <summary>Raised on cancel, and after <see cref="OnCreated"/>.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private string _title = "";
    private string _description = "";
    private string _whenText = DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm");
    private PlaceKind _kind = PlaceKind.PublicLocation;
    private InvestigationVisibility _visibility = InvestigationVisibility.PlaceInvestigators;

    private string _name = "";
    private string _street = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";

    private List<PlaceCandidate> _candidates = [];
    private PlaceCandidate? _chosenPlace;

    private Timer? _lookupTimer;
    private bool _saving;
    private string? _error;

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_title)
        && DateTime.TryParse(_whenText, out _)
        && (_chosenPlace is not null
            || !string.IsNullOrWhiteSpace(_name)
            || !string.IsNullOrWhiteSpace(_street));

    // ── The "did you mean" lookup ─────────────────────────────────────────────

    /// <summary>
    /// Applies a field edit and restarts the debounce.
    /// </summary>
    /// <remarks>
    /// Debounced rather than run per keystroke: a partial address matches nothing useful, and
    /// asking on every character would mean a request per letter for an answer nobody can act on
    /// until the line is finished.
    /// </remarks>
    private void OnPlaceFieldChanged(Action apply)
    {
        apply();

        _lookupTimer?.Stop();
        _lookupTimer ??= BuildTimer();
        _lookupTimer.Start();
    }

    private Timer BuildTimer()
    {
        var timer = new Timer(600) { AutoReset = false };
        timer.Elapsed += async (_, _) => await InvokeAsync(LookupAsync);
        return timer;
    }

    private async Task LookupAsync()
    {
        if (string.IsNullOrWhiteSpace(_street) && string.IsNullOrWhiteSpace(_name))
        {
            _candidates = [];
            StateHasChanged();
            return;
        }

        try
        {
            // No coordinates yet — nothing has geocoded what is being typed. The server treats
            // unknown distance as "no opinion" and matches on the text, which is the whole reason
            // the rule tolerates a missing position.
            var found = (await AdminClient.FindPlaceCandidatesAsync(
                _street, _city, _state, _zip, _name, latitude: null, longitude: null)).Items;
            _candidates = found.ToList();
        }
        catch
        {
            // A suggestion that cannot be fetched is not an error worth interrupting anybody for.
            // They are creating a place either way; the worst case is a duplicate, which is what
            // the position was before this existed.
            _candidates = [];
        }

        StateHasChanged();
    }

    private void ChoosePlace(PlaceCandidate candidate)
    {
        _chosenPlace = candidate;
        _candidates = [];
        _lookupTimer?.Stop();

        // The place decides what kind of location this is, so the sharing options follow it rather
        // than whatever was picked before the place was known.
        _kind = candidate.Kind;
        if (_kind == PlaceKind.PrivateResidence && _visibility == InvestigationVisibility.Public)
            _visibility = InvestigationVisibility.GroupOnly;
    }

    private void ClearChosenPlace() => _chosenPlace = null;

    private void OnKindChanged(string? value)
    {
        if (!Enum.TryParse<PlaceKind>(value, out var kind)) return;
        _kind = kind;

        // Public is not offered at a private home; silently leaving it selected would send a
        // request the server refuses.
        if (_kind == PlaceKind.PrivateResidence && _visibility == InvestigationVisibility.Public)
            _visibility = InvestigationVisibility.GroupOnly;
    }

    private static string DescribeCandidate(PlaceCandidate candidate)
    {
        if (!string.IsNullOrWhiteSpace(candidate.Name)) return candidate.Name!;

        var parts = new[] { candidate.StreetAddress1, candidate.City, candidate.State }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var joined = string.Join(", ", parts);

        return string.IsNullOrWhiteSpace(joined) ? "An unnamed place" : joined;
    }

    // ── Save ──────────────────────────────────────────────────────────────────

    private async Task SaveAsync()
    {
        if (!CanSave || _saving) return;

        _saving = true;
        _error = null;

        try
        {
            var request = new CreateOrgInvestigationRequest(
                Title: _title.Trim(),
                ScheduledDateTime: DateTime.Parse(_whenText).ToUniversalTime(),
                Description: string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                PlaceId: _chosenPlace?.Id,
                // Only sent when no existing place was picked — otherwise the server would be
                // asked to both use a place and create one.
                NewPlace: _chosenPlace is not null ? null : new NewPlaceRequest(
                    Name: Trimmed(_name),
                    StreetAddress1: Trimmed(_street),
                    StreetAddress2: null,
                    City: Trimmed(_city),
                    State: Trimmed(_state),
                    ZipCode: Trimmed(_zip),
                    Country: null,
                    Kind: _kind),
                Visibility: _visibility);

            var created = await AdminClient.CreateOrgInvestigationAsync(OrgId, request);
            if (created is null)
            {
                _error = "That could not be scheduled just now.";
                _saving = false;
                return;
            }

            await OnCreated.InvokeAsync();
            await OnClosed.InvokeAsync();
        }
        catch
        {
            _error = "That could not be scheduled just now.";
        }

        _saving = false;
    }

    private static string? Trimmed(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public void Dispose()
    {
        // The timer outlives the component otherwise, and its callback would touch a disposed
        // renderer.
        if (_lookupTimer is null) return;
        _lookupTimer.Stop();
        _lookupTimer.Dispose();
    }
}
