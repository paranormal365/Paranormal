    private bool _showMembersDialog;
    private OrgMemberGroupRecord? _membersGroup;
    private List<GroupMemberRow> _groupMembers = [];
    private IReadOnlyList<OrgMemberOption> _availableOrgMembers = [];
    private Guid _addMemberMembershipId;
    private string? _membersDialogError;
    private IReadOnlyList<OrgMembershipItem>? _orgMemberships;
