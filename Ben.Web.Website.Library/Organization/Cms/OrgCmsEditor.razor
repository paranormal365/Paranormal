    /// <summary>
    /// The group's page-scoped templates, offered when starting a new page.
    /// </summary>
    /// <remarks>
    /// Loaded when the dialog opens rather than with the screen: most visits to this editor are not
    /// about creating a page, and the list is only ever read by that one dropdown.
    /// </remarks>
    private List<CmsTemplateRecord> _pageTemplates = [];

    // ── Page dialog ───────────────────────────────────────────────────────────

    private async Task OpenNewPageDialogAsync()
    {
        _editingPage  = null;
        _dialogError  = null;
        _pageForm     = new PageFormModel { SortOrder = (_pages?.Count ?? 0) + 1 };
        _showPageDialog = true;

        _pageTemplates = [.. await AdminClient.GetCmsTemplatesAsync(OrgId, CmsTemplateScope.Page)];
    }

    private void OpenEditPageDialog(CmsPageListItem pg)
    {
        _editingPage = pg;
        _dialogError = null;
        _pageForm = new PageFormModel
        {
            PageTitle   = pg.PageTitle,
            UrlName     = pg.UrlName,
            IsPublished = pg.IsPublished,
            IsPublic    = pg.IsPublic,
            ParentPageId = pg.ParentPageId,
            SortOrder   = pg.SortOrder
        };
        _showPageDialog = true;
    }

    private void ClosePageDialog()
    {
        _showPageDialog = false;
        _editingPage    = null;
        _dialogError    = null;
    }

    private async Task SavePage()
    {
        if (string.IsNullOrWhiteSpace(_pageForm.PageTitle) || string.IsNullOrWhiteSpace(_pageForm.UrlName))
        {
            _dialogError = "Title and URL Slug are required.";
            return;
        }

        _isBusy = true;
        _dialogError = null;

        if (_editingPage is null)
        {
            var result = await AdminClient.CreateCmsPageAsync(OrgId, new CmsCreatePageRequest(
                _pageForm.PageTitle.Trim(),
                _pageForm.UrlName.Trim().ToLowerInvariant(),
                _pageForm.PageHtml,
                _pageForm.IsPublic,
                _pageForm.ParentPageId,
                _pageForm.SortOrder,
                _pageForm.FromTemplateId));

            if (result is null) _dialogError = "Failed to create page. The URL slug may already be in use.";
            else
            {
                _showPageDialog = false;
                _successMessage = result.Sections.Count > 0
                    ? $"Page '{result.PageTitle}' created with {result.Sections.Count} sections to fill in."
                    : $"Page '{result.PageTitle}' created.";
            }
        }
        else
        {
            var result = await AdminClient.UpdateCmsPageAsync(OrgId, _editingPage.Id, new CmsUpdatePageRequest(
                _pageForm.PageTitle.Trim(),
                _pageForm.UrlName.Trim().ToLowerInvariant(),
                _pageForm.PageHtml,
                _pageForm.IsPublished,
                _pageForm.IsPublic,
                _pageForm.ParentPageId,
                _pageForm.SortOrder));

            if (result is null) _dialogError = "Failed to update page.";
            else { _showPageDialog = false; _successMessage = $"Page '{result.PageTitle}' updated."; }
        }

        _isBusy = false;
        if (!_showPageDialog) await LoadAsync();
    }

    private void RequestDeletePage(CmsPageListItem pg)
    {
        _errorMessage = _successMessage = null;
        _pendingDeletePage = pg;
        _showDeletePageDialog = true;
    }

    private async Task ConfirmDeletePage()
    {
        if (_pendingDeletePage is null) return;
        _isBusy = true;
        var ok = await AdminClient.DeleteCmsPageAsync(OrgId, _pendingDeletePage.Id);
        _isBusy = false;
        _showDeletePageDialog = false;

        if (ok) { _successMessage = $"Page '{_pendingDeletePage.PageTitle}' deleted."; }
        else    { _errorMessage   = $"Could not delete '{_pendingDeletePage.PageTitle}'."; }

        _pendingDeletePage = null;
        await LoadAsync();
    }

