    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            // Get org name from the pages list (or first page's org)
            _pages = await AdminClient.GetCmsPagesAsync(OrgId);
            _logos = (await AdminClient.GetOrgLogosAsync(OrgId)).Items;
            _groups = (await AdminClient.GetGroupsAsync(OrgId)).Items;

            // Pre-load org membership + user list for member management
            _orgMemberships = (await AdminClient.GetOrganizationMembersAsync(OrgId)).Items;
            _orgUsers = await AdminClient.GetOrgUserDirectoryAsync(OrgId);

            // Try to get org name
            var org = await AdminClient.GetOrganizationAsync(OrgId);
            _orgName = org?.Name;
        }
        catch
        {
            // Partial load failures are non-fatal — UI renders with whatever data arrived
        }
    }

    // ── Parent page dropdown ──────────────────────────────────────────────────

    private IEnumerable<PageOption> _parentPageOptions =>
        (_pages ?? [])
            .Where(p => _editingPage is null || p.Id != _editingPage.Id)
            .Select(p => new PageOption(p.Id, p.PageTitle));

