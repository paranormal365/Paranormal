@page "/organizations/{OrgId:guid}/cms"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

@using System.Text.Json
@using Ben.Data.Common.Enums

@if (!EmbeddedMode)
{
    <PageTitle>CMS — @(_orgName ?? OrgId.ToString())</PageTitle>
}

<div class="container-fluid px-3">

    @if (!EmbeddedMode)
    {
        <div class="row mb-3 align-items-center">
            <div class="col">
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => NavManager.NavigateTo("/organizations"))"><BenIcon Name="arrow-left" Class="me-1" />
                    Back to Organizations
                </button>
                <h3 class="d-inline-block ms-3 mb-0">CMS — @(_orgName ?? OrgId.ToString())</h3>
            </div>
        </div>
    }

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    <BenTabs>

        @* ── Pages tab ─────────────────────────────────────────────────────── *@
        <BenTab Title="Pages">

            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-primary" @onclick="OpenNewPageDialogAsync"><BenIcon Name="plus" Class="me-1" />
                    New Page
                </button>
            </div>

            @if (_pages is null)
            {
                <BenLoaderOverlay Visible="true" Text="Loading pages…" />
            }
            else
            {
                <TelerikGrid Data="@_pages"
                             TItem="CmsPageListItem"
                             Pageable="true"
                             PageSize="25"
                             Sortable="true">
                    <GridColumns>
                        <GridColumn Field="@nameof(CmsPageListItem.PageTitle)" Title="Title" />
                        <GridColumn Field="@nameof(CmsPageListItem.UrlName)" Title="URL Slug" Width="220px">
                            <Template>
                                @{ var slugRow = (CmsPageListItem)context; }
                                <code class="small">@slugRow.UrlName</code>
                                @* Only possible on a page saved before the reserved-word check. It
                                   looks perfectly fine here, and the only symptom is that its link
                                   lands somewhere else — so the list has to say so. *@
                                @if (slugRow.IsUnreachable)
                                {
                                    <span class="badge bg-danger ms-2"
                                          title="The site routes this word, so this page can never open. Rename it.">
                                        Unreachable
                                    </span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Title="Status" Width="110px">
                            <Template>
                                @{ var p = (CmsPageListItem)context; }
                                @if (p.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Draft</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Title="Visibility" Width="130px">
                            <Template>
                                @{ var p2 = (CmsPageListItem)context; }
                                <span>@(p2.IsPublic ? "Public" : "Members only")</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(CmsPageListItem.SectionCount)" Title="Sections" Width="90px" />
                        <GridColumn Title="Actions" Width="260px">
                            <Template>
                                @{ var pg = (CmsPageListItem)context; }
                                @if (pg.CanEdit)
                                {
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => OpenEditPageDialog(pg))"><BenIcon Name="edit-2" Class="me-1" />
                                        Edit
                                    </button>
                                }
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => NavManager.NavigateTo($"/organizations/{OrgId}/cms/pages/{pg.Id}"))"><BenIcon Name="layout" Class="me-1" />
                                    Sections
                                </button>
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => OpenPreview(pg))"><BenIcon Name="eye" Class="me-1" />
                                    Preview
                                </button>
                                @if (pg.CanDelete)
                                {
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-danger" : "btn-outline-danger") btn-sm" @onclick="@(() => RequestDeletePage(pg))"><BenIcon Name="trash-2" Class="me-1" />
                                        Delete
                                    </button>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </BenTab>

        @* ── Logos tab ─────────────────────────────────────────────────────── *@
        <BenTab Title="Logos">

            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-primary" @onclick="OpenLogoDialog"><BenIcon Name="plus" Class="me-1" />
                    Add Logo
                </button>
            </div>

            @if (_logos is null)
            {
                <BenLoaderOverlay Visible="true" Text="Loading logos…" />
            }
            else if (_logos.Count == 0)
            {
                <p class="text-secondary">No logos yet. Add one using the button above.</p>
            }
            else
            {
                <TelerikGrid Data="@_logos"
                             TItem="OrganizationLogoRecord"
                             Pageable="false"
                             Sortable="false">
                    <GridColumns>
                        <GridColumn Title="Preview" Width="120px">
                            <Template>
                                @{ var lp = (OrganizationLogoRecord)context; }
                                <CmsFileThumbnail FileId="@lp.UploadFileId" Width="100px" Height="65px" />
                            </Template>
                        </GridColumn>
                        <GridColumn Title="Active" Width="80px">
                            <Template>
                                @{ var l = (OrganizationLogoRecord)context; }
                                @if (l.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(OrganizationLogoRecord.AltText)" Title="Alt Text" />
                        <GridColumn Title="Actions" Width="160px">
                            <Template>
                                @{ var logo = (OrganizationLogoRecord)context; }
                                @if (!logo.IsActive)
                                {
                                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => SetLogoActive(logo))">
                                        Set Active
                                    </button>
                                }
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-danger" : "btn-outline-danger") btn-sm" @onclick="@(() => DeleteLogo(logo))"><BenIcon Name="trash-2" Class="me-1" />
                                    Remove
                                </button>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </BenTab>

        @* ── Member Groups tab ─────────────────────────────────────────── *@
        <BenTab Title="Member Groups">

            <div class="d-flex justify-content-end mb-2">
                <button type="button" class="btn btn-primary" @onclick="OpenNewGroupDialog"><BenIcon Name="plus" Class="me-1" />New Group</button>
            </div>

            @if (_groups is null)
            {
                <BenLoaderOverlay Visible="true" Text="Loading groups…" />
            }
            else if (_groups.Count == 0)
            {
                <p class="text-secondary">No member groups yet.</p>
            }
            else
            {
                <TelerikGrid Data="@_groups"
                             TItem="OrgMemberGroupRecord"
                             Sortable="true"
                             Pageable="false">
                    <GridColumns>
                        <GridColumn Field="@nameof(OrgMemberGroupRecord.Name)" Title="Name" />
                        <GridColumn Field="@nameof(OrgMemberGroupRecord.Description)" Title="Description" />
                        <GridColumn Field="@nameof(OrgMemberGroupRecord.SortOrder)" Title="Sort" Width="70px" />
                        <GridColumn Field="@nameof(OrgMemberGroupRecord.IsActive)" Title="Active" Width="80px">
                            <Template>
                                @if (((OrgMemberGroupRecord)context).IsActive)
                                { <BenIcon Name="check" /> }
                            </Template>
                        </GridColumn>
                        <GridCommandColumn Width="210px">
                            <GridCommandButton Command="Edit"
                                               Icon="@SvgIcon.Pencil"
                                               OnClick="@((GridCommandEventArgs e) => OpenEditGroupDialog((OrgMemberGroupRecord)e.Items.First()))">
                                Edit
                            </GridCommandButton>
                            <GridCommandButton Command="Members"
                                               Icon="@SvgIcon.User"
                                               OnClick="@((GridCommandEventArgs e) => OpenMembersDialog((OrgMemberGroupRecord)e.Items.First()))">
                                Members
                            </GridCommandButton>
                            <GridCommandButton Command="Delete"
                                               Icon="@SvgIcon.Trash"
                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                               OnClick="@((GridCommandEventArgs e) => ConfirmDeleteGroup((OrgMemberGroupRecord)e.Items.First()))">
                            </GridCommandButton>
                        </GridCommandColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </BenTab>

    </BenTabs>
</div>

@* ── New/Edit Page dialog ─────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showPageDialog" Title="@(_editingPage is null ? "New Page" : "Edit Page")" Size="lg">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="orgcmseditor-title-5a77">Title <span class="text-danger">*</span></label>
                <input id="orgcmseditor-title-5a77" type="text" class="form-control" @bind="@_pageForm.PageTitle" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="orgcmseditor-url-slug-d5ae">URL Slug <span class="text-danger">*</span></label>
                <input id="orgcmseditor-url-slug-d5ae" type="text" class="form-control" @bind="@_pageForm.UrlName" @bind:event="oninput" />
                <div class="form-text">Lowercase, hyphens only (e.g. <code>about-us</code>).</div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="orgcmseditor-summary-intro-html-a301">Summary / Intro HTML</label>
                <input id="orgcmseditor-summary-intro-html-a301" type="text" class="form-control" @bind="@_pageForm.PageHtml" @bind:event="oninput" />
                <div class="form-text">Short intro shown above sections. Full editing available in Sections.</div>
            </div>
            @if (_editingPage is null && _pageTemplates.Count > 0)
            {
                @* Only when creating. Applying a layout to a page that already has sections would
                   either duplicate them or silently replace what somebody wrote. *@
                <div class="col-12">
                    <label class="form-label fw-semibold">Start from one of our layouts</label>
                    <BenSelect Data="@_pageTemplates" @bind-Value="@_pageForm.FromTemplateId" ValueField="@nameof(CmsTemplateRecord.Id)" TextField="@nameof(CmsTemplateRecord.Name)" DefaultText="— Start with a blank page —" Width="100%" />
                    <div class="form-text">
                        Copies that layout's sections onto the new page, ready to fill in. The copy is
                        yours — editing the layout later leaves this page alone.
                    </div>
                </div>
            }
            <div class="col-6">
                <label class="form-label fw-semibold" for="orgcmseditor-sort-order-c4e7">Sort Order</label>
                <input id="orgcmseditor-sort-order-c4e7" type="number" class="form-control" min="0" max="100" step="1" @bind="@_pageForm.SortOrder" @bind:event="oninput" />
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold">Parent Page</label>
                <BenSelect Data="@_parentPageOptions" @bind-Value="@_pageForm.ParentPageId" ValueField="@nameof(PageOption.Id)" TextField="@nameof(PageOption.Title)" DefaultText="— None (top level) —" Width="100%" />
            </div>
            <div class="col-6 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="pg-public" @bind="@_pageForm.IsPublic" />
                <label for="pg-public" class="form-label mb-0">Visible to public</label>
            </div>
            @if (_editingPage is not null)
            {
                <div class="col-6 d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" id="pg-published" @bind="@_pageForm.IsPublished" />
                    <label for="pg-published" class="form-label mb-0">Published</label>
                </div>
            }
        </div>
        @if (_dialogError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_dialogError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="ClosePageDialog">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SavePage" disabled="@(!(!_isBusy))"><BenIcon Name="save" Class="me-1" />
                @(_isBusy ? "Saving…" : "Save")
            </button>
        </div>
    </ChildContent>
</BenModal>

@* ── Delete page confirmation ─────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDeletePageDialog" Title="Delete Page">
    <ChildContent>
        @if (_pendingDeletePage is not null)
        {
            <p>Permanently delete <strong>@_pendingDeletePage.PageTitle</strong>?</p>
            <p class="text-secondary small mb-0">All sections and permissions for this page will also be removed. Child pages will be re-parented.</p>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => { _showDeletePageDialog = false; _pendingDeletePage = null; })">Cancel</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmDeletePage" disabled="@(!(!_isBusy))">
                @(_isBusy ? "Deleting…" : "Delete")
            </button>
        </div>
    </ChildContent>
</BenModal>

@* ── Add Logo dialog ──────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showLogoDialog" Title="Add Logo" Size="lg">
    <ChildContent>
        @if (_orgImageFiles is null)
        {
            <div class="p-3 text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
        }
        else
        {
            <BenTabs>
                <BenTab Title="From Library">
                    @if (_orgImageFiles.Count == 0)
                    {
                        <p class="text-secondary p-3 mb-0">No image files are shared with this organization yet. Use the Upload tab to add one.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 p-2" style="max-height:260px;overflow-y:auto;">
                            @foreach (var f in _orgImageFiles)
                            {
                                var fId = f.Id;
                                var selected = _selectedLogoFileId == fId;
                                <div style="cursor:pointer;width:120px;text-align:center;" @onclick="@(() => _selectedLogoFileId = fId)">
                                    <div class="@(selected ? "border border-primary border-2 rounded" : "border rounded")" style="padding:3px;">
                                        <CmsFileThumbnail FileId="@fId" Width="110px" Height="75px" Alt="@f.FileName" />
                                    </div>
                                    <small class="text-truncate d-block mt-1" style="max-width:120px;" title="@f.FileName">@f.FileName</small>
                                </div>
                            }
                        </div>
                    }
                </BenTab>
                <BenTab Title="Upload New">
                    <div class="row g-3 p-2">
                        <div class="col-12">
                            <label class="form-label fw-semibold">File Type</label>
                            <p class="form-control-plaintext">
                                @(_fileTypes?.FirstOrDefault(t => t.Id == _uploadFileTypeId)?.Name ?? "Logo")
                            </p>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Image File</label>
                            <InputFile OnChange="@OnLogoFileSelected" accept="image/*" class="form-control" />
                            <div class="form-text">Accepted: JPEG, PNG, GIF, WebP, SVG, etc.</div>
                        </div>
                        @if (_uploadedLogoName is not null)
                        {
                            <div class="col-12">
                                <div class="alert alert-success mb-0">✓ <strong>@_uploadedLogoName</strong> uploaded and selected.</div>
                            </div>
                        }
                    </div>
                </BenTab>
            </BenTabs>
        }

        <hr class="my-3" />
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="orgcmseditor-alt-text-1e06">Alt Text</label>
                <input id="orgcmseditor-alt-text-1e06" type="text" class="form-control" placeholder="Logo alt text (for accessibility)" @bind="@_logoAltText" @bind:event="oninput" />
            </div>
            <div class="col-6 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="logo-active" @bind="@_logoIsActive" />
                <label for="logo-active" class="form-label mb-0">Set as active logo</label>
            </div>
        </div>
        @if (_logoError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0">@_logoError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="CloseLogoDialog">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveLogo" disabled="@(!(!_isBusy))"><BenIcon Name="save" Class="me-1" />
                @(_isBusy ? "Saving…" : "Add Logo")
            </button>
        </div>
    </ChildContent>
</BenModal>

@* ── Page preview window ──────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showPreview" Title="@PreviewTitle" Size="xl">
    <ChildContent>
        @if (_previewDetail is null)
        {
            <BenLoaderOverlay Visible="true" Text="Loading preview…" />
        }
        else
        {
            <div class="cms-preview p-3" style="overflow-y:auto;height:100%;">
                <h2>@_previewDetail.PageTitle</h2>
                @if (!string.IsNullOrWhiteSpace(_previewDetail.PageHtml))
                {
                    <div class="cms-summary mb-4">@((MarkupString)_previewDetail.PageHtml)</div>
                }
                @foreach (var section in _previewDetail.Sections.Where(s => s.IsActive).OrderBy(s => s.SortOrder))
                {
                    <div class="cms-section mb-4">
                        @if (!string.IsNullOrWhiteSpace(section.Title))
                        {
                            <h4>@section.Title</h4>
                        }
                        @RenderSectionPreview(section)
                    </div>
                }
            </div>
        }
    </ChildContent>
</BenModal>

@* ── New/Edit Group dialog ────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showGroupDialog" Title="@(_editingGroup is null ? "New Member Group" : "Edit Member Group")">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="orgcmseditor-name-73e2">Name <span class="text-danger">*</span></label>
                <input id="orgcmseditor-name-73e2" type="text" class="form-control" @bind="@_groupForm.Name" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label" for="orgcmseditor-description-4fc8">Description</label>
                <input id="orgcmseditor-description-4fc8" type="text" class="form-control" @bind="@_groupForm.Description" @bind:event="oninput" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="orgcmseditor-sort-order-a4c1">Sort Order</label>
                <input id="orgcmseditor-sort-order-a4c1" type="number" class="form-control" min="0" max="100" step="1" @bind="@_groupForm.SortOrder" @bind:event="oninput" />
            </div>
            <div class="col-md-8 d-flex align-items-end gap-2">
                <input type="checkbox" class="form-check-input" id="grp-active" @bind="@_groupForm.IsActive" />
                <label for="grp-active">Active</label>
            </div>
            @if (_groupDialogError is not null)
            { <div class="col-12"><div class="alert alert-danger py-2">@_groupDialogError</div></div> }
        </div>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-primary" @onclick="SaveGroupAsync" disabled="@(!(!string.IsNullOrWhiteSpace(_groupForm.Name)))">Save</button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showGroupDialog = false)">Cancel</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Delete Group confirmation ────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDeleteGroupDialog" Title="Delete Group">
    <ChildContent>
        <p>Delete group <strong>@_deletingGroup?.Name</strong>? All member assignments will also be removed.</p>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-danger" @onclick="ExecuteDeleteGroupAsync">Delete</button>
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => _showDeleteGroupDialog = false)">Cancel</button>
        </div>
    </ChildContent>
</BenModal>

@* ── Group Members dialog ─────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showMembersDialog" Title="@($"Members — {_membersGroup?.Name}")" Size="lg">
    <ChildContent>
        @if (_membersGroup is not null)
        {
            @* Current members *@
            @if (_groupMembers.Count == 0)
            {
                <p class="text-secondary small">No members yet.</p>
            }
            else
            {
                <TelerikGrid Data="@_groupMembers" TItem="GroupMemberRow" Pageable="false">
                    <GridColumns>
                        <GridColumn Title="Member" Field="@nameof(GroupMemberRow.DisplayName)" />
                        <GridColumn Title="Role" Field="@nameof(GroupMemberRow.Role)" Width="110px" />
                        <GridCommandColumn Width="90px">
                            <GridCommandButton Command="Remove"
                                               Icon="@SvgIcon.Trash"
                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                               OnClick="@((GridCommandEventArgs e) => RemoveMemberAsync((GroupMemberRow)e.Items.First()))">
                            </GridCommandButton>
                        </GridCommandColumn>
                    </GridColumns>
                </TelerikGrid>
            }

            @* Add member *@
            <div class="mt-3 d-flex gap-2 align-items-end">
                <div class="flex-grow-1">
                    <label class="form-label fw-semibold mb-1">Add member</label>
                    <BenSelect Data="@_availableOrgMembers" @bind-Value="@_addMemberMembershipId" TextField="@nameof(OrgMemberOption.DisplayName)" ValueField="@nameof(OrgMemberOption.MembershipId)" DefaultText="— Select org member —" Width="100%" />
                </div>
                <button type="button" class="btn btn-primary" @onclick="AddMemberAsync" disabled="@(!(_addMemberMembershipId != Guid.Empty))"><BenIcon Name="plus" Class="me-1" />
                    Add
                </button>
            </div>
            @if (_membersDialogError is not null)
            { <div class="alert alert-danger py-2 mt-2">@_membersDialogError</div> }
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showMembersDialog = false)">Close</button>
        </div>
    </ChildContent>
</BenModal>

@code {
    /// <summary>Dialog heading. A property because literal text plus a C# expression is mixed
    /// content in a component attribute.</summary>
    private string PreviewTitle => $"Preview — {_previewPage?.PageTitle}";

    [Parameter] public Guid OrgId        { get; set; }
    [Parameter] public bool EmbeddedMode  { get; set; }

    private string? _orgName;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _dialogError;
    private string? _logoError;
    private bool _isBusy;

    // Pages
    private IReadOnlyList<CmsPageListItem>? _pages;
    private bool _showPageDialog;
    private CmsPageListItem? _editingPage;
    private PageFormModel _pageForm = new();
    private bool _showDeletePageDialog;
    private CmsPageListItem? _pendingDeletePage;

    // Logos
    private IReadOnlyList<OrganizationLogoRecord>? _logos;
    private bool _showLogoDialog;
    private Guid? _selectedLogoFileId;
    private string? _uploadedLogoName;
    private string? _logoAltText;
    private bool _logoIsActive = true;
    private IList<UploadFileRecord>? _orgImageFiles;
    private IReadOnlyList<UploadFileTypeRecord>? _fileTypes;
    private Guid _uploadFileTypeId;

    // Member Groups
    private IReadOnlyList<OrgMemberGroupRecord>? _groups;
    private bool _showGroupDialog;
    private OrgMemberGroupRecord? _editingGroup;
