    private void OpenNewSectionDialog()
    {
        _editingSection  = null;
        _sectionError    = null;
        _sectionForm     = new SectionFormModel { SortOrder = _sections.Count + 1 };
        _showSectionEditor = true;
    }

    private void OpenEditSectionDialog(CmsSectionRecord s)
    {
        _editingSection = s;
        _sectionError   = null;
        _sectionForm    = new SectionFormModel
        {
            SectionType = s.SectionType,
            Title       = s.Title,
            ContentJson = s.ContentJson,
            IsActive    = s.IsActive,
            SortOrder   = s.SortOrder
        };
        _showSectionEditor = true;
    }

    private void CloseSectionDialog()
    {
        _showSectionEditor = false;
        _editingSection    = null;
        _sectionError      = null;
    }

    private async Task SaveSection()
    {
        _isBusy = true;
        _sectionError = null;

        if (_editingSection is null)
        {
            var result = await AdminClient.CreateCmsSectionAsync(OrgId, PageId, new CmsCreateSectionRequest(
                _sectionForm.SectionType, _sectionForm.Title?.Trim(),
                _sectionForm.ContentJson, _sections.Count + 1, _sectionForm.IsActive));

            if (result is null) _sectionError = "Failed to create section.";
            else
            {
                _sections.Add(result);
                _showSectionEditor = false;
                _successMessage = "Section added.";
            }
        }
        else
        {
            var result = await AdminClient.UpdateCmsSectionAsync(OrgId, PageId, _editingSection.Id,
                new CmsUpdateSectionRequest(_sectionForm.Title?.Trim(), _sectionForm.ContentJson, _sectionForm.IsActive));

            if (result is null) _sectionError = "Failed to update section.";
            else
            {
                var idx = _sections.FindIndex(s => s.Id == _editingSection.Id);
                if (idx >= 0) _sections[idx] = result;
                _showSectionEditor = false;
                _successMessage = "Section updated.";
            }
        }

        _isBusy = false;
    }

    private async Task MoveSection(int idx, int direction)
    {
        var newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= _sections.Count) return;

        (_sections[idx], _sections[newIdx]) = (_sections[newIdx], _sections[idx]);

        var orderedIds = _sections.Select(s => s.Id).ToList();
        await AdminClient.ReorderCmsSectionsAsync(OrgId, PageId, orderedIds);

        // Update local sort order numbers
        for (int i = 0; i < _sections.Count; i++)
        {
            var s = _sections[i];
            _sections[i] = s with { SortOrder = i + 1 };
        }
    }

    private void RequestDeleteSection(CmsSectionRecord s)
    {
        _pendingDeleteSection  = s;
        _showDeleteSectionDialog = true;
    }

    private async Task ConfirmDeleteSection()
    {
        if (_pendingDeleteSection is null) return;
        _isBusy = true;
        var ok = await AdminClient.DeleteCmsSectionAsync(OrgId, PageId, _pendingDeleteSection.Id);
        _isBusy = false;
        _showDeleteSectionDialog = false;

        if (ok) { _sections.RemoveAll(s => s.Id == _pendingDeleteSection.Id); _successMessage = "Section removed."; }
        else _errorMessage = "Failed to remove section.";
        _pendingDeleteSection = null;
    }

