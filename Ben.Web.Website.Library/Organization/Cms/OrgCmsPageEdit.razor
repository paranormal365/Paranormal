    // ── Drafts (item #80, part 3) ───────────────────────────────────────────

    private CmsDraftStateResponse? _draft;
    private bool _draftBusy;
    private bool _confirmDiscard;

    private async Task LoadDraftStateAsync()
        => _draft = await AdminClient.GetCmsDraftStateAsync(OrgId, PageId);

    private async Task StartDraftAsync()
    {
        _draftBusy = true;
        _errorMessage = null;

        var state = await AdminClient.StartCmsDraftAsync(OrgId, PageId);
        _draftBusy = false;

        if (state?.DraftPageId is not Guid draftId)
        {
            _errorMessage = "That draft couldn't be started.";
            return;
        }

        // Route to the draft: from here the editor edits an ordinary page row, so nothing else in
        // this screen needs to know drafts exist.
        NavManager.NavigateTo($"/organizations/{OrgId}/cms/pages/{draftId}");
    }

    private async Task PublishDraftAsync()
    {
        if (_draft is null) return;
        _draftBusy = true;
        _errorMessage = null;

        var published = await AdminClient.PublishCmsDraftAsync(OrgId, _draft.LivePageId);
        _draftBusy = false;

        if (!published)
        {
            _errorMessage = "Those changes couldn't be published.";
            return;
        }

        // The draft row is gone now, so staying on its id would be a dead page.
        NavManager.NavigateTo($"/organizations/{OrgId}/cms/pages/{_draft.LivePageId}");
    }

    private async Task DiscardDraftAsync()
    {
        if (_draft is null) return;
        _confirmDiscard = false;
        _draftBusy = true;

        var discarded = await AdminClient.DiscardCmsDraftAsync(OrgId, _draft.LivePageId);
        _draftBusy = false;

        if (!discarded) { _errorMessage = "That draft couldn't be discarded."; return; }
        NavManager.NavigateTo($"/organizations/{OrgId}/cms/pages/{_draft.LivePageId}");
    }
}
