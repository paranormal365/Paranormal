@* A file as a small picture.

   The browser fetches it, from a URL. This used to pull the WHOLE file into the server and hand
   the page a base64 copy — under the name "thumbnail", which is exactly what it was not. In a
   picker showing a dozen files that is a dozen full-size images in this process's memory, the
   shape that took the media library to sixteen gigabytes. *@

@using Ben.Web.Services
@inject IMediaUrlBuilder MediaUrls

@if (FileId == Guid.Empty)
{
    <div style="width:@Width;height:@Height;display:flex;align-items:center;justify-content:center;background:rgba(128,128,128,.12);border-radius:4px;">
        <span class="text-secondary" style="font-size:0.7rem;">No preview</span>
    </div>
}
else if (_failed)
{
    @* A refusal or a missing file, said out loud rather than shown as an empty box. *@
    <div style="width:@Width;height:@Height;display:flex;align-items:center;justify-content:center;background:rgba(128,128,128,.12);border-radius:4px;"
         title="@Alt — this file could not be loaded">
        <span class="text-danger" style="font-size:0.7rem;">Couldn't load</span>
    </div>
}
else
{
    <img src="@MediaUrls.Thumbnail(FileId)"
         style="width:@Width;height:@Height;object-fit:cover;border-radius:4px;"
         alt="@Alt" title="@Alt"
         loading="lazy" decoding="async"
         @onerror="@(() => { _failed = true; })" />
}

@code {
    [Parameter] public Guid FileId { get; set; }
    [Parameter] public string Width { get; set; } = "100px";
    [Parameter] public string Height { get; set; } = "75px";
    [Parameter] public string? Alt { get; set; }

    private bool _failed;

    protected override void OnParametersSet() => _failed = false;
}
