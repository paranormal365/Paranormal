@namespace Ben.Web.Website.Library.Organization
@using Ben.Web.Website.Library.Shared

@inject IBenAdminClient AdminClient
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@*
   Every investigation the group has run, mapped and listed. The point of the screen is the two
   things a case-by-case view cannot show: where the work has actually happened, and the visits
   that belong to no client case at all.
*@

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h6 class="mb-1 fw-semibold">Investigations<HelpLink Slug="working-a-case" Anchor="the-investigations-map" /></h6>
        <p class="text-secondary small mb-0">
            Everywhere this group has worked, including visits with no client case.
        </p>
    </div>
    <div class="d-flex align-items-center gap-1">
        <button type="button" class="btn btn-primary" @onclick="@(() => _creating = true)"><BenIcon Name="plus" Class="me-1" />Schedule an investigation</button>
        <HelpLink Slug="working-a-case" Anchor="scheduling-a-visit-with-no-case" />
    </div>
</div>

@if (_creating)
{
    <NewInvestigationWindow OrgId="@OrgId"
                            OnCreated="@LoadAsync"
                            OnClosed="@(() => _creating = false)" />
}

@if (_error is not null)
{
    <div class="alert alert-danger py-2 small">@_error</div>
}

@if (_loading)
{
    <BenLoaderOverlay Visible="true" Text="Loading investigations…" />
}
else if (_rowsResult.Failed)
{
    @* "No investigations" to a group that has some is the answer they will plan around. *@
    <BenListState TItem="OrgInvestigationRow" Result="@_rowsResult" OnRetry="@LoadAsync" />
}
else if (_rows.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="text-secondary mb-0">
                No investigations yet. Schedule one above, or start it from a case.
            </p>
        </div>
    </div>
}
else
{
    @* ── Map ──────────────────────────────────────────────────────────────── *@
    @if (_pins.Any(p => p.Latitude.HasValue))
    {
        <InvestigationsMap Pins="@_pins" Height="380px" OnPinClicked="@GoToInvestigation" />
    }

    @* An investigation the map could not place is easy to lose: the pin simply is not drawn, and
       nothing about the picture says one is missing. Listing them under the map is the whole
       reason GeocodeNote travels on the row. *@
    @if (_unplaceable.Count > 0)
    {
        <div class="alert alert-warning py-2 small mt-3 mb-0">
            <strong>@_unplaceable.Count not shown on the map.</strong>
            <ul class="mb-0 mt-1">
                @foreach (var row in _unplaceable)
                {
                    <li>
                        <a href="#" @onclick:preventDefault @onclick="@(() => GoToInvestigation(row.Id))">@row.Title</a>
                        — @(row.GeocodeNote ?? "No location recorded.")
                    </li>
                }
            </ul>
        </div>
    }

    @* ── Grids ────────────────────────────────────────────────────────────── *@
    <div class="mt-4">
        <h6 class="fw-semibold">Upcoming</h6>
        @if (_upcoming.Count == 0)
        {
            <p class="text-secondary small fst-italic">Nothing scheduled.</p>
        }
        else
        {
            @Grid(_upcoming)
        }
    </div>

    <div class="mt-4">
        <h6 class="fw-semibold">Past</h6>
        @if (_past.Count == 0)
        {
            <p class="text-secondary small fst-italic">Nothing yet.</p>
        }
        else
        {
            @Grid(_past)
        }
    </div>
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    private List<OrgInvestigationRow> _rows = [];
    private List<InvestigationMapPin> _pins = [];
    private List<OrgInvestigationRow> _upcoming = [];
    private List<OrgInvestigationRow> _past = [];
    private List<OrgInvestigationRow> _unplaceable = [];

    private bool _loading = true;
    private LoadResult<OrgInvestigationRow> _rowsResult;
    private bool _creating;

    /// <summary>Which row has its team open, if any. One at a time — each roster polls.</summary>
    private Guid? _openTeam;
    private string? _error;
    private Guid _loadedForOrg;

    protected override async Task OnParametersSetAsync()
    {
        if (OrgId == Guid.Empty || OrgId == _loadedForOrg) return;
        _loadedForOrg = OrgId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _rowsResult = await AdminClient.GetOrgInvestigationsAsync(OrgId);
            _rows       = _rowsResult.Items.ToList();
        }
        catch
        {
            _error = "Those could not be loaded just now.";
            _rows = [];
        }

        var now = DateTime.UtcNow;
        _upcoming = _rows.Where(r => r.ScheduledDateTime >= now)
                         .OrderBy(r => r.ScheduledDateTime).ToList();
        _past = _rows.Where(r => r.ScheduledDateTime < now)
                     .OrderByDescending(r => r.ScheduledDateTime).ToList();

        _unplaceable = _rows.Where(r => r.Latitude is null || r.Longitude is null).ToList();

        _pins = _rows.Select(r => new InvestigationMapPin(
            r.Id, r.Title, r.Latitude, r.Longitude, IsPast: r.ScheduledDateTime < now)).ToList();

        _loading = false;
    }

    /// <summary>
    /// Opens one row's team, closing any other.
    /// </summary>
    /// <remarks>
    /// One at a time on purpose: every open roster runs its own timer, and a page with a dozen
    /// expanded would poll a dozen times over.
    /// </remarks>
    private void ToggleTeam(Guid id) => _openTeam = _openTeam == id ? null : id;

    private void GoToInvestigation(Guid id)
    {
        var row = _rows.FirstOrDefault(r => r.Id == id);
        if (row is null) return;

        // A case-bound visit belongs on its case's Investigations tab, which is where the binder
        // and the editing dialog live. A case-less one still has no detail page of its own — its
        // team is reachable here, via Team, rather than through a link that would 404.
        if (row.CaseId is { } caseId)
            NavManager.NavigateTo($"/organizations/{OrgId}/cases/{caseId}?tab=investigations");
    }

    private static string WhereText(OrgInvestigationRow row)
    {
        if (!string.IsNullOrWhiteSpace(row.PlaceName)) return row.PlaceName!;

        var cityState = string.Join(", ",
            new[] { row.PlaceCity, row.PlaceState }.Where(v => !string.IsNullOrWhiteSpace(v)));
        if (!string.IsNullOrWhiteSpace(cityState)) return cityState;

        return string.IsNullOrWhiteSpace(row.Location) ? "—" : row.Location!;
    }

    private static string StatusBadge(Ben.Data.Common.Enums.InvestigationStatus status) => status switch
    {
        Ben.Data.Common.Enums.InvestigationStatus.Completed => "bg-success",
        Ben.Data.Common.Enums.InvestigationStatus.Cancelled => "bg-secondary",
        Ben.Data.Common.Enums.InvestigationStatus.InProgress => "bg-primary",
        _ => "bg-info text-dark",
    };

    private RenderFragment Grid(List<OrgInvestigationRow> rows) =>@<div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Investigation</th>
                    <th>Where</th>
                    <th>Case</th>
                    @* "People" rather than "Team", so the count is not confused with the Team
                       button beside it, which opens the roster. *@
                    <th class="text-center">People</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="text-nowrap">
                            @row.ScheduledDateTime.ToLocalTime().ToDisplayDateTime()
                        </td>
                        <td>
                            @row.Title
                            <span class="badge @StatusBadge(row.Status) ms-1">@row.Status</span>
                        </td>
                        <td>
                            @if (row.PlaceId is { } placeId)
                            {
                                @* The place page is where this visit sits alongside everyone
                                   else's at the same location — the whole point of Place. *@
                                <a href="/places/@placeId">@WhereText(row)</a>
                            }
                            else
                            {
                                @WhereText(row)
                            }
                        </td>
                        <td>
                            @if (row.CaseReference is not null)
                            {
                                <a href="/organizations/@OrgId/cases/@row.CaseId">@row.CaseReference</a>
                            }
                            else
                            {
                                @* No case is a fact about the visit, not a gap in the data. *@
                                <span class="text-secondary small fst-italic">No case</span>
                            }
                        </td>
                        <td class="text-center">@row.AttendeeCount</td>
                        <td class="text-end text-nowrap">
                            @* The team is here rather than only on a case's tab, because a visit
                               with no case had nowhere at all to check in from — the endpoints were
                               always case-agnostic, the screen simply never existed. *@
                            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ToggleTeam(row.Id))"><BenIcon Name="@(_openTeam == row.Id ? "chevron-up" : "user")" Class="me-1" />Team</button>

                            @* The nudge CanCompleteMyFindings was computed for: you were on this
                               visit and have not written up what you saw. Server-decided, like
                               every other verdict on this row. *@
                            @if (row.CanCompleteMyFindings && row.ScheduledDateTime < DateTime.UtcNow
                                 && _openTeam != row.Id)
                            {
                                <span class="badge bg-info text-dark ms-1"
                                      title="You were on this visit — write up what you saw under Team.">
                                    Your write-up
                                </span>
                            }

                            @* Shown on the server's verdict alone. Working it out here would mean
                               two answers to one question, and the button would eventually offer
                               something the endpoint then refuses. *@
                            @if (row.CanEditRecord && row.CaseId is not null)
                            {
                                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => GoToInvestigation(row.Id))"><BenIcon Name="edit-2" Class="me-1" />Edit</button>
                            }
                        </td>
                    </tr>

                    @if (_openTeam == row.Id)
                    {
                        <tr>
                            <td colspan="6" class="bg-body-tertiary">
                                @* CanEditRecord, not true: the same verdict the Edit button uses,
                                   so the attendance and lead controls appear for exactly the
                                   people the endpoints will accept. *@
                                <InvestigationRoster OrgId="@OrgId" InvestigationId="@row.Id"
                                                     CanManage="@row.CanEditRecord" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>;
}
