@*
  OrganizationMembers.razor
  ─────────────────────────
  Displays the member roster for an organization with role display and removal.
  Route: /organizations/{OrgId:guid}/members
*@

@page "/organizations/{OrgId:guid}/members"
@namespace Ben.Web.Website.Library.Organization
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState

<div class="container-fluid py-3">

    @if (_loading)
    {
        <div class="d-flex justify-content-center py-5">
            <span class="spinner-border text-primary" role="status"></span>
        </div>
    }
    else
    {
        @if (!EmbeddedMode)
        {
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <h4 class="mb-0">Members — @_orgName</h4>
                <a href="/organizations" class="btn btn-sm btn-outline-secondary">← Organizations</a>
            </div>
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        @* ── Active Members ────────────────────────────────────────────────── *@
        @* A refused roster used to render as "No records available", which told a member their
           group had nobody in it while the Details tab beside it counted three. *@
        <BenListState TItem="OrgMembershipItem" Result="@_result" Loading="@_loading"
                      LoadingText="Loading the roster…"
                      EmptyText="Nobody is in this group yet">
        <TelerikGrid Data="@_members"
                     Pageable="true"
                     PageSize="25"
                     Sortable="true"
                     Class="mb-4">
            <GridColumns>
                <GridColumn Field="@nameof(OrgMembershipItem.Role)" Title="Role" Width="120px">
                    <Template>
                        @{ var m = (OrgMembershipItem)context; }
                        <span class="badge @RoleBadge(m.Role)">@m.Role</span>
                    </Template>
                </GridColumn>
                <GridColumn Title="Member">
                    <Template>
                        @{ var m2 = (OrgMembershipItem)context; }
                        <UserNameLink AppUserId="@m2.AppUserId" DisplayName="@m2.DisplayName" ShowAvatar="true" />
                    </Template>
                </GridColumn>
                @* The member's title on the group's ladder (item 157). Seniority, never
                   permission. Admins assign from a plain-Blazor select (Telerik inputs set by
                   script never bind — and a dropdown per row is exactly the kind of place that
                   trap bites); everyone else reads a badge. *@
                <GridColumn Title="Title" Width="190px">
                    <Template>
                        @{ var m3 = (OrgMembershipItem)context; }
                        @if (_canManage && _levels.Count > 0)
                        {
                            <select class="form-select form-select-sm" style="max-width:170px;"
                                    id="member-level-@m3.MembershipId"
                                    value="@(m3.MemberLevelId?.ToString() ?? "")"
                                    @onchange="@(e => AssignLevelAsync(m3, e.Value?.ToString()))">
                                <option value="">— none —</option>
                                @foreach (var level in _levels.Where(l => l.IsActive || l.Id == m3.MemberLevelId))
                                {
                                    <option value="@level.Id" selected="@(level.Id == m3.MemberLevelId)">@level.Name</option>
                                }
                            </select>
                        }
                        else if (m3.MemberLevelName is not null)
                        {
                            <span class="badge bg-info text-dark">@m3.MemberLevelName</span>
                        }

                        @* Step 5. The title is already saved; this OFFERS the roles it usually
                           carries. Never automatic: a promotion that silently granted access
                           would be a permission change made from a screen labelled "titles". *@
                        @if (_offer is { } offer && offer.MembershipId == m3.MembershipId)
                        {
                            <div class="alert alert-info p-2 mt-2 small">
                                <div class="mb-2">
                                    <strong>@offer.LevelName</strong> usually carries:
                                    @foreach (var name in offer.RoleNames)
                                    {
                                        <span class="badge text-bg-secondary ms-1">@name</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-primary btn-sm text-nowrap"
                                            disabled="@_offerBusy"
                                            @onclick="AcceptOfferAsync">Also grant @(offer.RoleNames.Count == 1 ? "this role" : "these roles")</button>
                                    <button type="button" class="btn btn-secondary btn-sm text-nowrap"
                                            disabled="@_offerBusy"
                                            @onclick="@(() => _offer = null)">Title only</button>
                                </div>
                            </div>
                        }
                    </Template>
                </GridColumn>
                @* IH-09/IH-07, Ben's 2026-08-26 sweep: role membership was managed one role at a
                   time under Roles → Edit → Members, and appeared on no per-person screen — so
                   answering "what does this person hold?" meant opening all nine roles in turn.
                   Five of TGH's nine members held Investigator Role and nothing here said so. *@
                <GridColumn Title="Functional roles" Width="200px">
                    <Template>
                        @{ var rm = (OrgMembershipItem)context; }
                        @if (_rolesByMembership.TryGetValue(rm.MembershipId, out var held) && held.Count > 0)
                        {
                            @foreach (var roleName in held)
                            {
                                <span class="badge text-bg-secondary me-1">@roleName</span>
                            }
                        }
                        else if (_rolesLoaded)
                        {
                            <span class="text-secondary small">—</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(OrgMembershipItem.IsActive)" Title="Active" Width="80px" />
            </GridColumns>
        </TelerikGrid>
        </BenListState>

        @* ── Membership Requests section (if accepting applications) ─────── *@
        @* Managers only. This used to render for every member, and since the requests fetch is
           admin-gated, an ordinary member saw a broken "Couldn't load this — 403" card on their
           own group's roster. A surface that is not theirs should be absent, not broken —
           the same shape as the admin-only hub tabs. Caught by the item-109 member walk on its
           first run. *@
        @if (_canManage)
        {
            <OrganizationMembershipRequests OrgId="@OrgId" />
        }
    }
</div>

@code {
    [Parameter] public Guid OrgId        { get; set; }
    [Parameter] public bool EmbeddedMode  { get; set; }

    private bool _loading = true;
    private bool _canManage;
    private string? _error;
    private string _orgName = string.Empty;
    private IReadOnlyList<OrgMembershipItem> _members = [];
    private LoadResult<OrgMembershipItem>   _result;
    private IReadOnlyList<OrgMemberLevelItem> _levels = [];

    /// <summary>Which functional roles each membership holds — see the IH-07 note in the markup.</summary>
    private Dictionary<Guid, List<string>> _rolesByMembership = [];

    /// <summary>Role id → name, so a title's suggestions can be named rather than shown as GUIDs.</summary>
    private Dictionary<Guid, string> _roleNamesById = [];
    private bool _rolesLoaded;

    /// <summary>
    /// Fills the roles column, after the roster is already on screen.
    /// </summary>
    /// <remarks>
    /// One request per role, because role membership is only queryable per role. That is a
    /// handful of small calls, and they run AFTER the grid renders so nobody waits on them — the
    /// column fills in a moment later rather than delaying the page. If a server-side
    /// "roles per membership" projection ever lands, this becomes one call.
    /// </remarks>
    private async Task LoadRolesAsync()
    {
        try
        {
            var roles = (await AdminClient.GetOrgRolesAsync(OrgId)).Items;
            // Step 5 needs id → name so a title's suggested role IDs can be shown as names.
            _roleNamesById = roles.ToDictionary(r => r.Id, r => r.Name);
            var map = new Dictionary<Guid, List<string>>();
            foreach (var role in roles)
            {
                var holders = (await AdminClient.GetOrgRoleMembersAsync(OrgId, role.Id)).Items;
                foreach (var holder in holders)
                {
                    if (!map.TryGetValue(holder.OrganizationUserMembershipId, out var list))
                        map[holder.OrganizationUserMembershipId] = list = [];
                    list.Add(role.Name);
                }
            }
            _rolesByMembership = map;
        }
        catch
        {
            // A column that cannot be filled must not cost anybody the roster.
            _rolesByMembership = [];
        }
        finally
        {
            _rolesLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>A pending "this title usually carries…" offer for one row.</summary>
    private sealed record RoleOffer(Guid MembershipId, Guid LevelId, string LevelName, List<string> RoleNames);

    private RoleOffer? _offer;
    private bool _offerBusy;

    private async Task AssignLevelAsync(OrgMembershipItem m, string? raw)
    {
        Guid? levelId = Guid.TryParse(raw, out var id) ? id : null;
        _offer = null;

        if (!await AdminClient.AssignMemberLevelAsync(OrgId, m.MembershipId, levelId))
        {
            _error = "The title couldn't be saved. Please try again.";
            return;
        }

        // Update in place rather than refetching the roster: the change is this one cell.
        var level = levelId is null ? null : _levels.FirstOrDefault(l => l.Id == levelId);
        _members = _members
            .Select(x => x.MembershipId == m.MembershipId
                ? x with { MemberLevelId = levelId, MemberLevelName = level?.Name } : x)
            .ToList();

        // The title is saved either way. What follows is only an offer.
        if (level?.SuggestedRoleIds is not { Count: > 0 } suggestedIds) return;

        List<string> held = _rolesByMembership.TryGetValue(m.MembershipId, out var names) ? names : [];
        var toOffer = _roleNamesById
            .Where(kv => suggestedIds.Contains(kv.Key) && !held.Contains(kv.Value))
            .Select(kv => kv.Value)
            .ToList();

        if (toOffer.Count > 0)
            _offer = new RoleOffer(m.MembershipId, level.Id, level.Name, toOffer);
    }

    /// <summary>
    /// Grants the offered roles — the copy in "copy-on-assign".
    /// </summary>
    /// <remarks>
    /// Re-sends the same title with <c>applySuggestedRoles</c>, so the server decides what to
    /// grant from its own data rather than trusting a list assembled in the browser. The server
    /// only ever adds, and skips what is already held, so a double click costs nothing.
    /// </remarks>
    private async Task AcceptOfferAsync()
    {
        if (_offer is not { } offer) return;
        _offerBusy = true;
        try
        {
            if (!await AdminClient.AssignMemberLevelAsync(
                    OrgId, offer.MembershipId, offer.LevelId, applySuggestedRoles: true))
            {
                _error = "The roles couldn't be granted. Please try again.";
                return;
            }
            _offer = null;
            await LoadRolesAsync();      // the roles column is now out of date
        }
        finally { _offerBusy = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Both calls need a bearer token, and this page is reachable directly at
        // /organizations/{id}/members — so on a hard navigation it renders before the circuit is
        // live and both come back unauthorised. The client turns that into empty results, so the
        // page told a SuperAdmin the group had no members and fell back to printing the raw GUID
        // as its heading, because the org lookup came back empty too.
        //
        // Embedded in the hub it never showed, since OrganizationView awaits AuthReady before it
        // renders any tab — which is exactly why nobody saw this until a help screenshot captured
        // the standalone page and published the empty grid.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        _loading = true;
        try
        {
            _result   = await AdminClient.GetOrganizationMembersAsync(OrgId);
            _members  = _result.Items;
            _levels   = (await AdminClient.GetMemberLevelsAsync(OrgId)).Items;
            var orgs  = (await AdminClient.GetOrganizationsAsync()).Items;

            // Still falls back to the id when the name genuinely cannot be resolved — a member of
            // one group opening another group's address gets no org record, and a bare GUID is at
            // least honest about that. It should no longer be the ordinary case.
            var mine  = orgs.FirstOrDefault(o => o.Id == OrgId);
            _orgName  = mine?.Name ?? OrgId.ToString();
            _canManage = mine?.CanEdit ?? false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }

        // Deliberately not awaited above: the roster is what somebody came for.
        _ = LoadRolesAsync();
    }

    private static string RoleBadge(OrganizationMemberRole role) => role switch
    {
        OrganizationMemberRole.Owner         => "bg-danger",
        OrganizationMemberRole.Administrator => "bg-warning text-dark",
        OrganizationMemberRole.Manager       => "bg-primary",
        OrganizationMemberRole.Member        => "bg-success",
        _                                    => "bg-secondary",
    };
}
