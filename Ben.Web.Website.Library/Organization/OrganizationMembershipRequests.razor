@*
  OrganizationMembershipRequests.razor
  ─────────────────────────────────────
  Embedded component showing pending and resolved membership applications.
  Used as a sub-panel on the OrganizationMembers page.
  Org members with MembershipRequests-Update permission can Accept or Deny.
  Applicants can withdraw their own pending request.
*@

@namespace Ben.Web.Website.Library.Organization
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject BenToastService Toasts
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<div class="mt-4">
    <h5 class="mb-3 fw-semibold">Membership Applications</h5>

    @if (_loading)
    {
        <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
    }
    else if (_requestsResult.Failed)
    {
        @* People waiting to join, shown as nobody waiting, is an application that never gets answered. *@
        <BenListState TItem="OrganizationMembershipRequestRecord" Result="@_requestsResult" OnRetry="@ReloadAsync" />
    }
    else if (_requests.Count == 0)
    {
        <p class="text-secondary small">No membership applications for this organization.</p>
    }
    else
    {
        @* ── Pending ─────────────────────────────────────────────────────── *@
        var pending = _requests.Where(r => r.Status == OrganizationMembershipRequestStatus.Pending).ToList();
        @if (pending.Any())
        {
            <h6 class="text-warning small text-uppercase fw-semibold mb-2">Pending (@pending.Count)</h6>
            <TelerikGrid Data="@pending" Pageable="true" PageSize="10" Class="mb-4">
                <GridColumns>
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.ApplicantDisplayName)" Title="Applicant" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.ApplicantEmail)" Title="Email" />
                    <GridColumn Field="@nameof(OrganizationMembershipRequestRecord.RequestMessage)" Title="Message" />
                    <GridColumn Title="Applied" Width="110px">
                        <Template>
                            @{ var applied = (OrganizationMembershipRequestRecord)context; }
                            @applied.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                        </Template>
                    </GridColumn>
                    <GridCommandColumn Width="260px">
                        <GridCommandButton OnClick="@(e => AcceptAsync((OrganizationMembershipRequestRecord)e.Items.First()))"
                                          ThemeColor="@ThemeConstants.Button.ThemeColor.Success"
                                          Size="@ThemeConstants.Button.Size.Small">Accept</GridCommandButton>
                        <GridCommandButton OnClick="@(e => DenyAsync((OrganizationMembershipRequestRecord)e.Items.First()))"
                                          ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                          Size="@ThemeConstants.Button.Size.Small"
                                          Class="ms-1">Deny</GridCommandButton>
                        <GridCommandButton OnClick="@(e => OpenVoteDialog((OrganizationMembershipRequestRecord)e.Items.First()))"
                                          ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                          Size="@ThemeConstants.Button.Size.Small"
                                          Class="ms-1">Vote</GridCommandButton>
                    </GridCommandColumn>
                </GridColumns>
            </TelerikGrid>
        }

        @* ── Resolved ─────────────────────────────────────────────────────── *@
        var resolved = _requests.Where(r => r.Status != OrganizationMembershipRequestStatus.Pending).ToList();
        @* IH-09, Ben's 2026-08-26 sweep: this listed 23 withdrawn applications from the SAME
           person across three pages, every row identical but for the date — so a genuinely new
           application would be hard to spot among them. One row per person per outcome, with a
           count and the most recent date. The individual rows are still reachable; they are just
           no longer the first thing an owner has to read past. *@
        var grouped = ResolvedGroups(resolved);
        @if (grouped.Count > 0)
        {
            <h6 class="text-secondary small text-uppercase fw-semibold mb-2">Resolved (@resolved.Count)</h6>
            <TelerikGrid Data="@grouped" Pageable="@(grouped.Count > 10)" PageSize="10">
                <GridColumns>
                    <GridColumn Field="@nameof(ResolvedGroup.ApplicantDisplayName)" Title="Applicant" />
                    <GridColumn Title="Status" Width="150px">
                        <Template>
                            @{ var g = (ResolvedGroup)context; }
                            <span class="badge @StatusBadge(g.Status)">@g.Status</span>
                            @if (g.Count > 1)
                            {
                                <span class="text-secondary small ms-1" title="@g.Count applications with this outcome">×@g.Count</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(ResolvedGroup.RespondedByDisplayName)" Title="Responded By" />
                    <GridColumn Title="Most recent" Width="130px">
                        <Template>
                            @{ var g2 = (ResolvedGroup)context; }
                            @g2.MostRecent?.ToViewerLocalTime(UserState).ToDisplayDate()
                        </Template>
                    </GridColumn>
                </GridColumns>
            </TelerikGrid>
        }
    }
</div>

@* ── Deny dialog — Phase 3: CanReapply + DenialReason ────────────────────── *@
<BenModal @bind-Visible="@_showDenyDialog" Title="Deny Membership Application">
    <ChildContent>
        <p class="small text-secondary mb-3">
            Applicant: <strong>@_pendingDeny?.ApplicantDisplayName</strong>
        </p>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="organizationmembershiprequests-denial-reason-optional-a58f">Denial Reason <span class="text-secondary small">(optional)</span></label>
                <textarea id="organizationmembershiprequests-denial-reason-optional-a58f" class="form-control" rows="3" @bind="@_denyNote"></textarea>
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="can-reapply" @bind="@_canReapply" />
                <label for="can-reapply" class="form-label mb-0">
                    Allow this applicant to reapply in the future
                </label>
            </div>
        </div>
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => { _showDenyDialog = false; _pendingDeny = null; _denyNote = string.Empty; _canReapply = false; })">
                Cancel
            </button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmDenyAsync">
                Deny Application
            </button>
        </div>
    </ChildContent>
</BenModal>

@* ── Open vote dialog ─────────────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showVoteDialog" Title="Open Committee Vote">
    <ChildContent>
        <p class="small text-secondary mb-3">
            Set a deadline for committee members to vote on <strong>@_pendingVote?.ApplicantDisplayName</strong>'s application.
            When the deadline passes, votes are tallied: majority Approve → Accepted, otherwise → Denied.
        </p>
        <label class="form-label fw-semibold">Vote Deadline <span class="text-danger">*</span></label>
        <TelerikDateTimePicker Format="@DateTimeViewerExtensions.DateTimeNoSecondsPattern" @bind-Value="@_voteDeadline" Width="100%" Min="@UserState.NowInViewerTimeZone().AddHours(1)" />
        @if (_voteDialogError is not null)
        {
            <div class="text-danger small mt-2">@_voteDialogError</div>
        }
            <div class="dialog-footer-actions">
            <span class="dialog-footer-spacer"></span>

            <button type="button" class="btn btn-secondary" @onclick="@(() => _showVoteDialog = false)">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="ConfirmOpenVoteAsync" disabled="@(!(!_isBusy))">
                @(_isBusy ? "Opening…" : "Open Vote")
            </button>
        </div>
    </ChildContent>
</BenModal>

@code {
    [Parameter, EditorRequired] public Guid OrgId { get; set; }

    private bool _loading = true;
    /// <summary>One row per applicant per outcome — see the IH-09 note in the markup.</summary>
    private sealed record ResolvedGroup(
        string ApplicantDisplayName,
        OrganizationMembershipRequestStatus Status,
        string? RespondedByDisplayName,
        int Count,
        DateTime? MostRecent);

    private static List<ResolvedGroup> ResolvedGroups(List<OrganizationMembershipRequestRecord> resolved)
        => resolved
            .GroupBy(r => (r.ApplicantDisplayName, r.Status))
            .Select(g => new ResolvedGroup(
                g.Key.ApplicantDisplayName,
                g.Key.Status,
                // The responder on the most recent one; older rows may name somebody else.
                g.OrderByDescending(r => r.DateResponded ?? r.DateCreated).First().RespondedByDisplayName,
                g.Count(),
                g.Max(r => r.DateResponded ?? r.DateCreated)))
            .OrderByDescending(g => g.MostRecent)
            .ToList();

    private List<OrganizationMembershipRequestRecord> _requests = [];
    private LoadResult<OrganizationMembershipRequestRecord> _requestsResult;

    private bool _showDenyDialog;
    private OrganizationMembershipRequestRecord? _pendingDeny;
    private string _denyNote = string.Empty;
    private bool _canReapply;

    // Phase 3: committee vote
    private bool _showVoteDialog;
    private OrganizationMembershipRequestRecord? _pendingVote;
    private DateTime? _voteDeadline;
    private string? _voteDialogError;
    private bool _isBusy;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _requestsResult = await AdminClient.GetMembershipRequestsAsync(OrgId);
            _requests = _requestsResult.Items.ToList(); }
        catch { _requests = []; }
        finally { _loading = false; }
    }

    private async Task AcceptAsync(OrganizationMembershipRequestRecord r)
    {
        var updated = await AdminClient.RespondToMembershipRequestAsync(
            OrgId, r.Id, OrganizationMembershipRequestStatus.Accepted, null);
        if (updated is not null)
        {
            Toasts.Success($"Accepted {r.ApplicantDisplayName}");
            await ReloadAsync();
        }
        else
        {
            Toasts.Error($"Failed to accept {r.ApplicantDisplayName}. Please try again.");
        }
    }

    private void DenyAsync(OrganizationMembershipRequestRecord r)
    {
        _pendingDeny = r;
        _denyNote    = string.Empty;
        _canReapply  = false;
        _showDenyDialog = true;
    }

    private async Task ConfirmDenyAsync()
    {
        if (_pendingDeny is null) return;
        var updated = await AdminClient.RespondToMembershipRequestAsync(
            OrgId, _pendingDeny.Id, OrganizationMembershipRequestStatus.Denied,
            _denyNote, canReapply: _canReapply,
            denialReason: string.IsNullOrWhiteSpace(_denyNote) ? null : _denyNote);
        _showDenyDialog = false;
        if (updated is not null)
        {
            Toasts.Error($"Denied {_pendingDeny.ApplicantDisplayName}");
            _pendingDeny = null;
            await ReloadAsync();
        }
        else
        {
            Toasts.Error("Failed to deny the request. Please try again.");
        }
    }

    private void OpenVoteDialog(OrganizationMembershipRequestRecord r)
    {
        _pendingVote     = r;
        _voteDeadline    = UserState.NowInViewerTimeZone().AddDays(7);
        _voteDialogError = null;
        _showVoteDialog  = true;
    }

    private async Task ConfirmOpenVoteAsync()
    {
        if (_pendingVote is null) return;
        if (!_voteDeadline.HasValue || _voteDeadline.Value <= UserState.NowInViewerTimeZone())
        {
            _voteDialogError = "Please select a future deadline.";
            return;
        }
        _isBusy = true; _voteDialogError = null;
        try
        {
            var result = await AdminClient.OpenMembershipVoteAsync(OrgId, _pendingVote.Id, _voteDeadline.Value.ToUtcFromViewerLocal(UserState));
            if (result is null) { _voteDialogError = "Failed to open vote. Please try again."; }
            else
            {
                _showVoteDialog = false;
                Toasts.Info($"Vote opened for {_pendingVote.ApplicantDisplayName}");
                await ReloadAsync();
            }
        }
        catch (Exception ex) { _voteDialogError = ex.Message; }
        finally { _isBusy = false; }
    }

    private static string StatusBadge(OrganizationMembershipRequestStatus s) => s switch
    {
        OrganizationMembershipRequestStatus.Accepted  => "bg-success",
        OrganizationMembershipRequestStatus.Denied    => "bg-danger",
        OrganizationMembershipRequestStatus.Withdrawn => "bg-secondary",
        _                                             => "bg-warning text-dark",
    };
}
