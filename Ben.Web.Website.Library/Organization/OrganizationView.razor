@page "/organizations/{OrgId:guid}"

@using Ben.Web.Website.Library.Organization.Cases
@using Ben.Web.Website.Library.Organization.Cms
@using Ben.Web.Website.Library.Organization.Roles
@using Ben.Web.Website.Library.Manage.Calendar
@using Ben.Web.Website.Library.Messaging
@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager

<PageTitle>@(_org?.Name ?? "Organization")</PageTitle>

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => NavManager.NavigateTo(ReturnUrl ?? "/organizations"))"><BenIcon Name="arrow-left" Class="me-1" />
                Back
            </button>
            <h3 class="d-inline-block ms-3 mb-0">Organization</h3>
        </div>
        @if (_canEdit && !_editMode)
        {
            <div class="col-auto">
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="BeginEdit"><BenIcon Name="edit-2" Class="me-1" />
                    Edit
                </button>
            </div>
        }
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading organization…" />
    }
    else if (_org is null)
    {
        <div class="alert alert-warning">Organization not found or you do not have access.</div>
    }
    else if (_editMode && _canEdit)
    {
        @* ── Edit form ────────────────────────────────────────────────────── *@
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" @bind="@_editName" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">URL Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" @bind="@_editUrlName" @bind:event="oninput" />
                <div class="form-text">URL-safe slug (lowercase, letters, numbers, hyphens). Must be unique.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Public Phone</label>
                <input type="text" class="form-control" placeholder="e.g. (615) 555-0100" @bind="@_editPublicPhone" @bind:event="oninput" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Public Email</label>
                <input type="text" class="form-control" placeholder="contact@example.com" @bind="@_editPublicEmail" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Website</label>
                <input type="text" class="form-control" placeholder="https://example.com" @bind="@_editPublicWebsite" @bind:event="oninput" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="edit-accepting-apps" @bind="@_editIsAcceptingApplications" />
                <label for="edit-accepting-apps" class="form-label mb-0">Accepting Membership Applications</label>
            </div>
            @* Half of a two-key rule — the member must opt in as well, so this switch alone
               shares nothing. The label says so, because an admin who thinks flipping this
               exposes their team's photos would reasonably leave it off forever. *@
            <div class="col-12 d-flex align-items-start gap-2">
                <input type="checkbox" class="form-check-input mt-1" id="edit-member-photos"
                       checked="@_editAllowMemberPrivatePhotos"
                       @onchange="@(e => _editAllowMemberPrivatePhotos = (bool)(e.Value ?? false))" />
                <label for="edit-member-photos" class="form-label mb-0">
                    Let clients see members' private photos<HelpLink Slug="organization-administration" Anchor="group-settings" />
                    <span class="d-block text-secondary small">
                        Only for members who have also turned this on for themselves. Nothing is
                        shared unless both the group and the member agree.
                    </span>
                </label>
            </div>
            @if (_isOwnerOrSuperAdmin)
            {
                <div class="col-12">
                    <label class="form-label text-secondary small">ID</label>
                    <div class="text-secondary small font-monospace">@_org.Id</div>
                </div>
            }
            <div class="col-12">
                <label class="form-label text-secondary small">Created</label>
                <div class="text-secondary small">@FormatServerTime(_org.DateCreated)</div>
            </div>
            <div class="col-12 d-flex gap-2 mt-1">
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(!(!_isSaving))"><BenIcon Name="save" Class="me-1" />
                    @(_isSaving ? "Saving…" : "Save")
                </button>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="CancelEdit">
                    Cancel
                </button>
            </div>
        </div>
    }
    else
    {
        @* ── Read-only tabbed view ─────────────────────────────────────────── *@
        <BenTabs>

            <BenTab Title="Details">
                <div style="max-width:620px;">
                    <dl class="row g-2">
                        <dt class="col-sm-3 text-secondary small">Name</dt>
                        <dd class="col-sm-9 fw-semibold mb-0">@_org.Name</dd>

                        <dt class="col-sm-3 text-secondary small">URL Name</dt>
                        <dd class="col-sm-9 mb-0">
                            <a href="/o/@_org.UrlName" target="_blank">
                                <code>@_org.UrlName</code>
                            </a>
                        </dd>

                        <dt class="col-sm-3 text-secondary small">Accepting Applications</dt>
                        <dd class="col-sm-9 mb-0">
                            <span class="badge @(_org.IsAcceptingApplications ? "bg-success" : "bg-secondary")">
                                @(_org.IsAcceptingApplications ? "Yes" : "No")
                            </span>
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(_org.PublicPhone) || !string.IsNullOrWhiteSpace(_org.PublicEmail) || !string.IsNullOrWhiteSpace(_org.PublicWebsite))
                        {
                            @if (!string.IsNullOrWhiteSpace(_org.PublicPhone))
                            {
                                <dt class="col-sm-3 text-secondary small">Phone</dt>
                                <dd class="col-sm-9 mb-0">@_org.PublicPhone</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(_org.PublicEmail))
                            {
                                <dt class="col-sm-3 text-secondary small">Email</dt>
                                <dd class="col-sm-9 mb-0"><a href="mailto:@_org.PublicEmail">@_org.PublicEmail</a></dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(_org.PublicWebsite))
                            {
                                <dt class="col-sm-3 text-secondary small">Website</dt>
                                <dd class="col-sm-9 mb-0"><a href="@_org.PublicWebsite" target="_blank" rel="noopener">@_org.PublicWebsite</a></dd>
                            }
                        }

                        @if (_isOwnerOrSuperAdmin)
                        {
                            <dt class="col-sm-3 text-secondary small">ID</dt>
                            <dd class="col-sm-9 mb-0 font-monospace small text-secondary">@_org.Id</dd>
                        }

                        <dt class="col-sm-3 text-secondary small">Created</dt>
                        <dd class="col-sm-9 mb-0 small">@FormatServerTime(_org.DateCreated)</dd>

                        @if (_org.DateUpdated.HasValue)
                        {
                            <dt class="col-sm-3 text-secondary small">Updated</dt>
                            <dd class="col-sm-9 mb-0 small">@FormatServerTime(_org.DateUpdated.Value)</dd>
                        }
                    </dl>
                </div>
            </BenTab>

            @if (_isMember)
            {
                <BenTab Title="Members">
                    <OrganizationMembers OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember)
            {
                <BenTab Title="Cases">
                    <CaseList OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember)
            {
                @* Member-visible, not admin-only: seeing where the group has worked is ordinary
                   membership. Who may *edit* a given investigation is decided per row by the
                   server and rendered from its verdict. *@
                <BenTab Title="Investigations">
                    <OrgInvestigations OrgId="@OrgId" />
                </BenTab>
            }

            @if (_isMember)
            {
                <BenTab Title="Calendar">
                    <OrgScheduler OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember)
            {
                <BenTab Title="Messages">
                    <OrgMessages OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember)
            {
                <BenTab Title="Files">
                    <OrganizationFiles OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="Requests">
                    <OrgPendingRequests OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="CMS">
                    <OrgCmsEditor OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @* Equipment shared with the group is readable by any member — sharing is the owner's
               consent, so it needs no permission gate. The group's own equipment arrives here in
               phase 3, behind the new Equipment permission. *@
            <BenTab Title="Equipment">
                <Ben.Web.Website.Library.Organization.Equipment.OrganizationEquipment OrgId="@OrgId" EmbeddedMode="true" />
            </BenTab>

            @if (_canManageRoles)
            {
                <BenTab Title="Roles">
                    <OrgRolesManager OrgId="@OrgId" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="Addresses">
                    <OrgAddressManager OrgId="@OrgId" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="Settings">
                    <OrgSettingsManager OrgId="@OrgId" />
                </BenTab>
            }

        </BenTabs>
    }
</div>

@code {
    [Parameter] public Guid   OrgId     { get; set; }

    /// <summary>Optional return URL injected by callers (e.g. admin user-detail page).
    /// When null falls back to /organizations.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private OrganizationAdminRecord? _org;
    private bool   _canEdit;
    private bool   _canManageRoles;
    private bool   _isMember;
    private bool   _isOwnerOrSuperAdmin;
    private bool   _loading   = true;
    private bool   _editMode;
    private bool   _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    // Edit form state
    private string  _editName                  = string.Empty;
    private string  _editUrlName               = string.Empty;
    private string? _editPublicPhone;
    private string? _editPublicEmail;
    private string? _editPublicWebsite;
    private bool    _editIsAcceptingApplications;
    private bool    _editAllowMemberPrivatePhotos;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            // Load org details and the org list (for CanEdit flag) in parallel
            var orgTask  = AdminClient.GetOrganizationAsync(OrgId);
            var listTask = AdminClient.GetOrganizationsAsync();

            await Task.WhenAll(orgTask, listTask);

            _org = orgTask.Result;

            var listItem    = listTask.Result.FirstOrDefault(o => o.Id == OrgId);
            _isMember       = UserState.IsSuperAdmin || listItem is not null;
            _canEdit        = UserState.IsSuperAdmin || (listItem?.CanEdit ?? false);
            _canManageRoles = _canEdit;

            // The org's raw ID is only shown to the Owner and SuperAdmin — not every admin-tier
            // member, so a real membership-role lookup is needed here rather than reusing _canEdit.
            if (UserState.IsSuperAdmin)
            {
                _isOwnerOrSuperAdmin = true;
            }
            else if (UserState.UserId.HasValue)
            {
                var members = await AdminClient.GetOrganizationMembersAsync(OrgId);
                _isOwnerOrSuperAdmin = members.Any(m =>
                    m.AppUserId == UserState.UserId.Value && m.Role == OrganizationMemberRole.Owner);
            }
        }
        catch
        {
            _errorMessage = "Failed to load organization.";
        }

        _loading = false;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        _editMode = false;
        _errorMessage = null;
        _successMessage = null;
    }

    private static readonly TimeZoneInfo _centralTimeZone = TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");

    /// <summary>Formats a stored UTC timestamp as the server's own Central time, explicitly labeled
    /// "(server)" so it's never confused with the viewer's own local time.</summary>
    private static string FormatServerTime(DateTime utc)
    {
        var central = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), _centralTimeZone);
        return $"{central:MM/dd/yyyy HH:mm:ss} (server)";
    }

    private void BeginEdit()
    {
        if (_org is null) return;
        _editName                   = _org.Name;
        _editUrlName                = _org.UrlName;
        _editPublicPhone            = _org.PublicPhone;
        _editPublicEmail            = _org.PublicEmail;
        _editPublicWebsite          = _org.PublicWebsite;
        _editIsAcceptingApplications = _org.IsAcceptingApplications;
        _editAllowMemberPrivatePhotos = _org.AllowMemberPrivatePhotosToClients;
        _editMode = true;
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_editName))    { _errorMessage = "Name is required.";     return; }
        if (string.IsNullOrWhiteSpace(_editUrlName)) { _errorMessage = "URL Name is required."; return; }

        _isSaving = true;
        StateHasChanged();

        var updated = await AdminClient.UpdateOrganizationAsync(OrgId,
            new AdminUpdateOrganizationRequest(
                _editName.Trim(),
                _editUrlName.Trim().ToLowerInvariant(),
                IsAcceptingApplications: _editIsAcceptingApplications,
                PublicPhone:    _editPublicPhone?.Trim(),
                PublicEmail:    _editPublicEmail?.Trim(),
                PublicWebsite:  _editPublicWebsite?.Trim(),
                AllowMemberPrivatePhotosToClients: _editAllowMemberPrivatePhotos));

        _isSaving = false;

        if (updated is not null)
        {
            _org          = updated;
            _editMode     = false;
            _successMessage = "Organization saved.";
        }
        else
        {
            _errorMessage = "Save failed. The URL name may already be in use, or you may not have permission.";
        }
    }
}
