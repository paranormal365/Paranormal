@page "/organizations/{OrgId:guid}"

@using Ben.Web.Website.Library.Organization.Cases
@using Ben.Web.Website.Library.Organization.Cms
@using Ben.Web.Website.Library.Organization.Roles
@using Ben.Web.Website.Library.Manage.Calendar
@using Ben.Web.Website.Library.Messaging
@inject IBenAdminClient AdminClient
@inject IBenUserState   UserState
@inject NavigationManager NavManager
@inject SiteFeaturesProvider Features

<PageTitle>@(_org?.Name ?? "Organization")</PageTitle>

<div class="container-fluid px-3">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => NavManager.NavigateTo(ReturnUrl ?? "/organizations"))"><BenIcon Name="arrow-left" Class="me-1" />
                Back
            </button>
            <h3 class="d-inline-block ms-3 mb-0">Organization</h3>
        </div>
        @if (_canEdit && !_editMode)
        {
            <div class="col-auto d-flex gap-2">
                <button type="button" id="org-tour-launch" class="btn btn-outline-secondary"
                        title="Show me around" @onclick="StartTourAsync">
                    <BenIcon Name="help-circle" />
                    <span class="visually-hidden">Show me around</span>
                </button>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="BeginEdit"><BenIcon Name="edit-2" Class="me-1" />
                    Edit
                </button>
            </div>
        }
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mb-3">@_errorMessage</div>
    }
    @if (_successMessage is not null)
    {
        <div class="alert alert-success mb-3">@_successMessage</div>
    }

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading organization…" />
    }
    else if (_org is null)
    {
        <div class="alert alert-warning">Organization not found or you do not have access.</div>
    }
    else if (_editMode && _canEdit)
    {
        @* ── Edit form ────────────────────────────────────────────────────── *@
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label fw-semibold" for="organizationview-name-854f">Name <span class="text-danger">*</span></label>
                <input id="organizationview-name-854f" type="text" class="form-control" @bind="@_editName" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="organizationview-url-name-f048">URL Name <span class="text-danger">*</span></label>
                <input id="organizationview-url-name-f048" type="text" class="form-control" @bind="@_editUrlName" @bind:event="oninput" />
                <div class="form-text">URL-safe slug (lowercase, letters, numbers, hyphens). Must be unique.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="organizationview-public-phone-99c6">Public Phone</label>
                <input id="organizationview-public-phone-99c6" type="text" class="form-control" placeholder="e.g. (615) 555-0100" @bind="@_editPublicPhone" @bind:event="oninput" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold" for="organizationview-public-email-9d01">Public Email</label>
                <input id="organizationview-public-email-9d01" type="text" class="form-control" placeholder="contact@example.com" @bind="@_editPublicEmail" @bind:event="oninput" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold" for="organizationview-website-fb04">Website</label>
                <input id="organizationview-website-fb04" type="text" class="form-control" placeholder="https://example.com" @bind="@_editPublicWebsite" @bind:event="oninput" />
            </div>
            <div class="col-12 d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="edit-accepting-apps" @bind="@_editIsAcceptingApplications" />
                <label for="edit-accepting-apps" class="form-label mb-0">Accepting Membership Applications</label>
            </div>
            @* Unlisted is about being FOUND, not about being private: the group's own page still
               works for anybody given the link, and everything inside it is unchanged. Said on the
               label, because "hidden" would suggest a privacy guarantee this does not make. *@
            <div class="col-12 d-flex align-items-start gap-2">
                <input type="checkbox" class="form-check-input mt-1" id="edit-unlisted"
                       checked="@_editIsUnlisted"
                       @onchange="@(e => _editIsUnlisted = (bool)(e.Value ?? false))" />
                <label for="edit-unlisted" class="form-label mb-0">
                    Unlisted — keep this group out of search, browse and nearby results.
                    <span class="d-block text-secondary small">
                        Its page still works for anyone with the link, and nothing inside changes.
                    </span>
                </label>
            </div>
            @* Half of a two-key rule — the member must opt in as well, so this switch alone
               shares nothing. The label says so, because an admin who thinks flipping this
               exposes their team's photos would reasonably leave it off forever. *@
            <div class="col-12 d-flex align-items-start gap-2">
                <input type="checkbox" class="form-check-input mt-1" id="edit-member-photos"
                       checked="@_editAllowMemberPrivatePhotos"
                       @onchange="@(e => _editAllowMemberPrivatePhotos = (bool)(e.Value ?? false))" />
                <label for="edit-member-photos" class="form-label mb-0">
                    Let clients see members' private photos<HelpLink Slug="organization-administration" Anchor="group-settings" />
                    <span class="d-block text-secondary small">
                        Only for members who have also turned this on for themselves. Nothing is
                        shared unless both the group and the member agree.
                    </span>
                </label>
            </div>
            @if (_rosterUnavailable)
            {
                @* Owner-ness is read off the roster. When that could not be fetched the page hides
                   this person's own controls, which looks like their permissions changed. *@
                <div class="col-12">
                    <div class="alert alert-warning py-2 small mb-0">
                        Your role here couldn't be confirmed, so owner-only controls are hidden.
                        This is a problem reaching the server, not a change to your access.
                    </div>
                </div>
            }
            @if (_isOwnerOrSuperAdmin)
            {
                <div class="col-12">
                    <label class="form-label text-secondary small">ID</label>
                    <div class="text-secondary small font-monospace">@_org.Id</div>
                </div>
            }
            <div class="col-12">
                <label class="form-label text-secondary small">Created</label>
                <div class="text-secondary small">@FormatServerTime(_org.DateCreated)</div>
            </div>
            <div class="col-12 d-flex gap-2 mt-1">
                <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(!(!_isSaving))"><BenIcon Name="save" Class="me-1" />
                    @(_isSaving ? "Saving…" : "Save")
                </button>
                <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="CancelEdit">
                    Cancel
                </button>
            </div>
        </div>
    }
    else
    {
        @* ── Read-only tabbed view ─────────────────────────────────────────── *@
        <BenTabs @bind-ActiveId="_activeTabId">

            <BenTab Title="Details" Id="details">
                @* The numbers first: someone opening a group wants to know how busy it is before
                   they want to know its URL slug. Full width, above the detail list. *@
                <OrgStatsPanel OrgId="@OrgId" />

                <div style="max-width:620px;">
                    <dl class="row g-2">
                        <dt class="col-sm-3 text-secondary small">Name</dt>
                        <dd class="col-sm-9 fw-semibold mb-0">@_org.Name</dd>

                        <dt class="col-sm-3 text-secondary small">URL Name</dt>
                        <dd class="col-sm-9 mb-0">
                            <a href="/o/@_org.UrlName" target="_blank">
                                <code>@_org.UrlName</code>
                            </a>
                        </dd>

                        <dt class="col-sm-3 text-secondary small">Accepting Applications</dt>
                        <dd class="col-sm-9 mb-0">
                            <span class="badge @(_org.IsAcceptingApplications ? "bg-success" : "bg-secondary")">
                                @(_org.IsAcceptingApplications ? "Yes" : "No")
                            </span>
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(_org.PublicPhone) || !string.IsNullOrWhiteSpace(_org.PublicEmail) || !string.IsNullOrWhiteSpace(_org.PublicWebsite))
                        {
                            @if (!string.IsNullOrWhiteSpace(_org.PublicPhone))
                            {
                                <dt class="col-sm-3 text-secondary small">Phone</dt>
                                <dd class="col-sm-9 mb-0">@_org.PublicPhone</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(_org.PublicEmail))
                            {
                                <dt class="col-sm-3 text-secondary small">Email</dt>
                                <dd class="col-sm-9 mb-0"><a href="mailto:@_org.PublicEmail">@_org.PublicEmail</a></dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(_org.PublicWebsite))
                            {
                                <dt class="col-sm-3 text-secondary small">Website</dt>
                                <dd class="col-sm-9 mb-0"><a href="@_org.PublicWebsite" target="_blank" rel="noopener">@_org.PublicWebsite</a></dd>
                            }
                        }

                        @if (_isOwnerOrSuperAdmin)
                        {
                            <dt class="col-sm-3 text-secondary small">ID</dt>
                            <dd class="col-sm-9 mb-0 font-monospace small text-secondary">@_org.Id</dd>
                        }

                        <dt class="col-sm-3 text-secondary small">Created</dt>
                        <dd class="col-sm-9 mb-0 small">@FormatServerTime(_org.DateCreated)</dd>

                        @if (_org.DateUpdated.HasValue)
                        {
                            <dt class="col-sm-3 text-secondary small">Updated</dt>
                            <dd class="col-sm-9 mb-0 small">@FormatServerTime(_org.DateUpdated.Value)</dd>
                        }
                    </dl>
                </div>
            </BenTab>

            @if (_isMember)
            {
                <BenTab Title="Members" Id="members">
                    <OrganizationMembers OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @* Phase D (item 156): the tab renders from the same verdict the server enforces —
               a member without case read must not be handed a tab whose every fetch refuses.
               Owners, admins and role-holders (the grandfather bridge included) all pass. *@
            @if (_isMember && _myPerms?.CanReadCases == true)
            {
                <BenTab Title="Cases" Id="cases">
                    <CaseList OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember && _myPerms?.CanReadInvestigations == true)
            {
                @* Reading where the group has worked now answers to the Investigation grant
                   (Phase D) — the grandfather bridge keeps existing members seeing it. Who may
                   *edit* a given investigation is still decided per row by the server. *@
                <BenTab Title="Investigations" Id="investigations">
                    <OrgInvestigations OrgId="@OrgId" FocusInvestigationId="@FocusInvestigationId" />
                </BenTab>
            }

            @* Item 154: same shape as the Publications tab below — a gated tab must not exist,
               because FeatureGate's not-found body inside a tab strip is a tab that opens onto
               an error. The calendar PAGES carry their own gate so the URLs die too. *@
            @if (_isMember && Features.IsOn(SiteFeatures.Events))
            {
                <BenTab Title="Calendar" Id="calendar">
                    @* The review queue lives with the events that produce it. Renders nothing
                       when empty. *@
                    <EventEvidenceQueue OrgId="@OrgId" />
                    <OrgScheduler OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember)
            {
                <BenTab Title="Messages" Id="messages">
                    <OrgMessages OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_isMember)
            {
                <BenTab Title="Files" Id="files">
                    <OrganizationFiles OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="Requests" Id="requests">
                    <OrgPendingRequests OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @if (_canManageRoles && Features.IsOn(SiteFeatures.CmsPages))
            {
                <BenTab Title="CMS" Id="cms">
                    <OrgCmsEditor OrgId="@OrgId" EmbeddedMode="true" />
                </BenTab>
            }

            @* Publications is off by default sitewide. A FeatureGate cannot help here — it renders
               a "page not found" body, which inside a tab strip would be a tab that opens onto an
               error. The tab has to not exist, so the flag is read directly. The pages the tab
               links to keep their own gate, because an address must die with the feature. *@
            @if (_canManageRoles && Features.IsOn(SiteFeatures.Publications))
            {
                <BenTab Title="Publications" Id="publications">
                    <Ben.Web.Website.Library.Publications.OrgPublications OrgId="@OrgId" />
                </BenTab>
            }

            @* Equipment shared with the group is readable by any member — sharing is the owner's
               consent, so it needs no permission gate. The group's own equipment arrives here in
               phase 3, behind the new Equipment permission. *@
            <BenTab Title="Equipment" Id="equipment">
                <Ben.Web.Website.Library.Organization.Equipment.OrganizationEquipment OrgId="@OrgId" EmbeddedMode="true" />
            </BenTab>

            @if (_canManageRoles)
            {
                <BenTab Title="Roles" Id="roles">
                    <OrgRolesManager OrgId="@OrgId" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="Addresses" Id="addresses">
                    <OrgAddressManager OrgId="@OrgId" />
                </BenTab>
            }

            @if (_canManageRoles)
            {
                <BenTab Title="Settings" Id="settings">
                    <OrgSettingsManager OrgId="@OrgId" />
                </BenTab>
            }

        </BenTabs>

        @* Item 166 W1: the owner's first-steps tour. Auto-launches once after founding
           (?welcome=1 from the wizard) unless already dismissed; the ? relaunches it. *@
        @if (_canManageRoles)
        {
            <BenTour @ref="_tourRef" Model="@_tour" OnEnded="@OnTourEndedAsync" />
        }
    }
</div>

@code {
    [Parameter] public Guid   OrgId     { get; set; }

    /// <summary>Optional return URL injected by callers (e.g. admin user-detail page).
    /// When null falls back to /organizations.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>Tab to open on arrival, by <see cref="BenTab.Id"/> ("investigations", "cases", …).
    /// Unknown or inaccessible ids fall back to the first tab — same contract as CaseDetail's.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? InitialTab { get; set; }

    /// <summary>Investigation to highlight and scroll to on the Investigations tab. Set by the
    /// surfaces that list case-less investigations (MyInvestigations, MyProfile), whose click has
    /// no case page to open — this page is what that click shows instead.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "inv")]
    public Guid? FocusInvestigationId { get; set; }

    private string _activeTabId = "details";

    private OrganizationAdminRecord? _org;
    private bool   _canEdit;
    private bool   _canManageRoles;
    private bool   _isMember;
    private MyOrgPermissionsItem? _myPerms;
    private bool   _isOwnerOrSuperAdmin;
    private bool   _rosterUnavailable;
    private bool   _loading   = true;
    private bool   _editMode;
    private bool   _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    // Edit form state
    private string  _editName                  = string.Empty;
    private string  _editUrlName               = string.Empty;
    private string? _editPublicPhone;
    private string? _editPublicEmail;
    private string? _editPublicWebsite;
    private bool    _editIsAcceptingApplications;
    private bool    _editIsUnlisted;
    private bool    _editAllowMemberPrivatePhotos;

    protected override async Task OnInitializedAsync()
    {
        _activeTabId = (InitialTab ?? "details").Trim().ToLowerInvariant();
        _appliedInitialTab = InitialTab;   // primed, so a mere re-render never re-applies it

        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    // ── The owner's first-steps tour (item 166 W1) ────────────────────────────

    private const string TourName = "owner-first-steps";
    private Kit.BenTour? _tourRef;
    private readonly Kit.TourModel _tour = new(
    [
        new Kit.TourModel.TourStep("#tab-members",
            "Invite your people",
            "The Members tab is your roster: invite people, review applications, and give each member a title from your group's own ladder."),
        new Kit.TourModel.TourStep("#tab-cases",
            "Cases live here",
            "When a client's request is accepted it becomes a case. The Cases tab is the case record and everything that hangs off it — investigations, files, reports."),
        new Kit.TourModel.TourStep("#tab-roles",
            "Roles open doors",
            "A role is a named set of permissions. Members start with the baseline; hand them roles — like the ready-made Case Manager Role — as they earn them. Titles are seniority; roles are access."),
        new Kit.TourModel.TourStep("#tab-settings",
            "Make it yours",
            "Settings holds your member-title ladder, investigation duties, calendar event types, and the group's own details. Everything the wizard skipped lives here."),
    ]);

    private async Task StartTourAsync()
    {
        if (_tourRef is not null) await _tourRef.StartAsync();
    }

    private async Task OnTourEndedAsync(bool completed)
    {
        try { await AdminClient.DismissTourAsync(TourName, completed); }
        catch { /* Losing a dismissal replays a tour once; it never breaks the page. */ }
    }

    /// <summary>Auto-launch: only from the wizard's ?welcome=1 landing, only for someone who can
    /// manage the group, and only if this person has never dismissed it.</summary>
    private async Task MaybeAutoLaunchTourAsync()
    {
        if (!_canManageRoles || _tourRef is null) return;

        var uri = new Uri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["welcome"] != "1") return;

        try
        {
            var dismissed = (await AdminClient.GetMyDismissedToursAsync()).Items;
            if (dismissed.Contains(TourName)) return;
        }
        catch { return; }   // cannot know the state: stay quiet rather than nag

        await _tourRef.StartAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
        _loadedOrgId = OrgId;
        await MaybeAutoLaunchTourAsync();
    }

    // ── Item 172 (Ben, 2026-08-23): the same component instance serves EVERY /organizations/{id}
    // route, so clicking another group in the sidebar changes only the parameter — no fresh
    // render, no reload, and the page keeps showing the old group, which reads as "clicking
    // does nothing". Reload whenever the parameter points somewhere the loaded data is not. ──
    private Guid _loadedOrgId;
    private string? _appliedInitialTab;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedOrgId != Guid.Empty && _loadedOrgId != OrgId)
        {
            _loadedOrgId  = OrgId;
            _editMode     = false;
            _activeTabId  = (InitialTab ?? "details").Trim().ToLowerInvariant();
            _appliedInitialTab = InitialTab;
            await LoadAsync();
            return;
        }

        // Same group, different ?tab= (a banner or bell deep link while already on the page):
        // honor it once per distinct value, without clobbering tabs the person clicked since.
        if (_loadedOrgId != Guid.Empty && InitialTab is not null && InitialTab != _appliedInitialTab)
        {
            _appliedInitialTab = InitialTab;
            _activeTabId = InitialTab.Trim().ToLowerInvariant();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();

        try
        {
            // Load org details and the org list (for CanEdit flag) in parallel
            var orgTask  = AdminClient.GetOrganizationAsync(OrgId);
            var listTask = AdminClient.GetOrganizationsAsync();

            await Task.WhenAll(orgTask, listTask);

            _org = orgTask.Result;

            var listItem    = listTask.Result.Items.FirstOrDefault(o => o.Id == OrgId);
            _isMember       = UserState.IsSuperAdmin || listItem is not null;

            // The per-area verdicts the Cases/Investigations tabs render from (Phase D). Fetched
            // only for members — a non-member sees neither tab regardless.
            if (_isMember)
                _myPerms = await AdminClient.GetMyOrgPermissionsAsync(OrgId);
            _canEdit        = UserState.IsSuperAdmin || (listItem?.CanEdit ?? false);
            _canManageRoles = _canEdit;

            // The org's raw ID is only shown to the Owner and SuperAdmin — not every admin-tier
            // member, so a real membership-role lookup is needed here rather than reusing _canEdit.
            if (UserState.IsSuperAdmin)
            {
                _isOwnerOrSuperAdmin = true;
            }
            else if (UserState.UserId.HasValue)
            {
                // Owner-ness is derived from the roster, so a refused roster reads as "not an
                // owner" and quietly removes this person's own controls. It fails closed, which is
                // the safe direction, but silently — so say which it was.
                var members = await AdminClient.GetOrganizationMembersAsync(OrgId);
                _rosterUnavailable = members.Failed;
                _isOwnerOrSuperAdmin = members.Items.Any(m =>
                    m.AppUserId == UserState.UserId.Value && m.Role == OrganizationMemberRole.Owner);
            }
        }
        catch
        {
            _errorMessage = "Failed to load organization.";
        }

        _loading = false;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        _editMode = false;
        _errorMessage = null;
        _successMessage = null;
    }

    private static readonly TimeZoneInfo _centralTimeZone = TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");

    /// <summary>Formats a stored UTC timestamp as the server's own Central time, explicitly labeled
    /// "(server)" so it's never confused with the viewer's own local time.</summary>
    private static string FormatServerTime(DateTime utc)
    {
        var central = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), _centralTimeZone);
        return $"{central:MM/dd/yyyy HH:mm:ss} (server)";
    }

    private void BeginEdit()
    {
        if (_org is null) return;
        _editName                   = _org.Name;
        _editUrlName                = _org.UrlName;
        _editPublicPhone            = _org.PublicPhone;
        _editPublicEmail            = _org.PublicEmail;
        _editPublicWebsite          = _org.PublicWebsite;
        _editIsAcceptingApplications = _org.IsAcceptingApplications;
        _editIsUnlisted             = _org.IsUnlisted;
        _editAllowMemberPrivatePhotos = _org.AllowMemberPrivatePhotosToClients;
        _editMode = true;
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_editName))    { _errorMessage = "Name is required.";     return; }
        if (string.IsNullOrWhiteSpace(_editUrlName)) { _errorMessage = "URL Name is required."; return; }

        _isSaving = true;
        StateHasChanged();

        var updated = await AdminClient.UpdateOrganizationAsync(OrgId,
            new AdminUpdateOrganizationRequest(
                _editName.Trim(),
                _editUrlName.Trim().ToLowerInvariant(),
                IsAcceptingApplications: _editIsAcceptingApplications,
                PublicPhone:    _editPublicPhone?.Trim(),
                PublicEmail:    _editPublicEmail?.Trim(),
                PublicWebsite:  _editPublicWebsite?.Trim(),
                AllowMemberPrivatePhotosToClients: _editAllowMemberPrivatePhotos,
                IsUnlisted: _editIsUnlisted));

        _isSaving = false;

        if (updated is not null)
        {
            _org          = updated;
            _editMode     = false;
            _successMessage = "Organization saved.";
        }
        else
        {
            _errorMessage = "Save failed. The URL name may already be in use, or you may not have permission.";
        }
    }
}
