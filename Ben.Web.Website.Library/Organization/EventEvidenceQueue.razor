@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services.WebApi
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Website.Library.Help

@*
    Evidence offered by public-event attendees, waiting on the group (item 111). Renders nothing
    at all when the queue is empty — a permanently-empty review card would train everyone to stop
    looking at the one that matters.
*@

@if (_queue.Items.Count > 0)
{
    <div class="card border-primary mb-3">
        <div class="card-header"><strong>Evidence from your public events</strong> — waiting on a member's review<HelpLink Slug="working-a-case" Anchor="evidence-from-people-who-attended-a-public-event" /></div>
        <div class="card-body">
            <p class="text-secondary small mb-2">
                Accepting puts a submission into the event's <strong>public</strong> record,
                credited to the attendee. Declining tells them why.
            </p>
            @foreach (var ev in _queue.Items)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 py-2 border-bottom">
                    <div class="me-auto">
                        <strong>@ev.FileName</strong>
                        <span class="text-secondary small">— @ev.SubmitterDisplayName at "@ev.EventTitle", @ev.DateCreated.ToString("MM/dd/yyyy")</span>
                        @if (!string.IsNullOrWhiteSpace(ev.Note))
                        {
                            <div class="small">"@ev.Note"</div>
                        }
                        @* Item 233. Retention is only honest if the person deciding can see the
                           clock — and until this, the date existed nowhere but an email. *@
                        @if (ev.IsKept)
                        {
                            <div class="small text-success">Kept — this one stays.</div>
                        }
                        else if (ev.ExpiresAtUtc is { } goes)
                        {
                            <div class="small @(goes < DateTime.UtcNow.AddDays(2) ? "text-warning" : "text-secondary")">
                                Comes off the site on @goes.ToViewerLocalTime(UserState).ToString("MM/dd/yyyy")
                                unless you keep it.
                            </div>
                        }
                    </div>
                    <input type="text" class="form-control form-control-sm" style="max-width:16rem"
                           placeholder="Reason if declining" @bind="_reasons[ev.Id]" @bind:event="oninput"
                           aria-label="@($"Reason for declining {ev.FileName}")" />
                    <button type="button" class="btn btn-success btn-sm" disabled="@_busy"
                            @onclick="() => ReviewAsync(ev, true)">Accept</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy"
                            @onclick="() => ReviewAsync(ev, false)">Decline</button>
                    @* Keeping is a separate decision from publishing: a recording worth holding on
                       to is often one you would not put on the page, and a photograph you publish
                       is kept by being published. Both buttons, because both happen. *@
                    @if (!ev.IsKept && ev.ExpiresAtUtc is not null)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                                disabled="@_busy" @onclick="() => SetKeptAsync(ev, true)">Keep it</button>
                    }
                    else if (ev.IsKept)
                    {
                        <button type="button" class="btn btn-link btn-sm text-secondary text-nowrap p-0"
                                disabled="@_busy" @onclick="() => SetKeptAsync(ev, false)">Let it go</button>
                    }
                    @if (_tours.Count > 0 && ev.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                    {
                        <select class="form-select form-select-sm" style="max-width:13rem"
                                aria-label="@($"Put {ev.FileName} on a tour's page")"
                                @onchange="@(e => KeepOnTourAsync(ev, e.Value?.ToString()))">
                            <option value="" selected>Put it on a tour…</option>
                            @foreach (var tour in _tours)
                            {
                                <option value="@tour.Id">@tour.Name</option>
                            }
                        </select>
                    }
                </div>
            }
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 mt-2 mb-0">@_error</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    private LoadResult<EventEvidenceRecord> _queue;
    private readonly Dictionary<Guid, string> _reasons = [];
    private bool _busy;
    private string? _error;

    /// <summary>The business's tours, so a photograph can be put straight onto one's page.</summary>
    private IReadOnlyList<Ben.Service.Models.Entities.TourRecord> _tours = [];

    protected override async Task OnParametersSetAsync()
    {
        // The standing AuthReady rule: this fetch needs a bearer token, and a component can run
        // before the circuit's auth state exists. A raced fetch here fails SILENTLY — the card
        // renders nothing on an empty queue by design, so an unauthenticated 401 is
        // indistinguishable from "nothing to review" on screen.
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _queue = await AdminClient.GetEvidenceQueueAsync(OrgId);
        foreach (var ev in _queue.Items)
            _reasons.TryAdd(ev.Id, "");

        // Empty for a group that runs no tours, which is most of them, and the control is hidden.
        _tours = [.. (await AdminClient.GetToursAsync(OrgId)).Items.Where(t => t.IsActive)];
    }

    private async Task SetKeptAsync(EventEvidenceRecord ev, bool kept)
    {
        _busy = true; _error = null;
        var ok = await AdminClient.SetMediaKeptAsync(OrgId, ev.UploadFileId, kept);
        _busy = false;

        if (!ok) { _error = "That could not be changed."; return; }
        await LoadAsync();
    }

    /// <summary>
    /// Puts a guest's photograph on a tour's page, which is also how it is kept.
    /// </summary>
    /// <remarks>
    /// The business gets its own copy, fitted and stripped of the camera data; the guest's
    /// original is untouched and keeps its own clock, because publishing somebody's photograph is
    /// not the same as taking it.
    /// </remarks>
    private async Task KeepOnTourAsync(EventEvidenceRecord ev, string? tourId)
    {
        if (!Guid.TryParse(tourId, out var id)) return;

        _busy = true; _error = null;
        var (kept, error) = await AdminClient.KeepSubmissionOnTourAsync(OrgId, id, ev.Id, ev.Note);
        _busy = false;

        if (kept is null) { _error = error ?? "That picture could not be put on the tour."; return; }
        await LoadAsync();
    }

    private async Task ReviewAsync(EventEvidenceRecord ev, bool accept)
    {
        _busy = true;
        _error = null;

        var reason = _reasons.GetValueOrDefault(ev.Id, "");
        var (result, error) = await AdminClient.ReviewEventEvidenceAsync(
            OrgId, ev.Id, accept, string.IsNullOrWhiteSpace(reason) ? null : reason.Trim());

        _busy = false;

        if (result is null)
        {
            // "Give the submitter a reason" arrives here verbatim — the server's sentence is the
            // instruction, not an error code.
            _error = error ?? "That couldn't be recorded.";
            return;
        }

        await LoadAsync();
    }
}
