@namespace Ben.Web.Website.Library.Organization

@inject IBenAdminClient AdminClient

@if (_loading)
{
    <BenLoaderOverlay Visible="true" Text="Loading settings…" />
}
else
{
    @if (_errorMessage is not null) { <div class="alert alert-danger mb-3">@_errorMessage</div> }
    @if (_successMessage is not null) { <div class="alert alert-success mb-3">@_successMessage</div> }

    <div class="card">
        <div class="card-body">
            <h6 class="card-title mb-3">Address Display Features</h6>
            <div class="row g-3">
                <div class="col-12 d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" id="set-map" @bind="@_showAddressMap" />
                    <label for="set-map" class="form-label mb-0">
                        Enable map display for org addresses
                        <div class="text-secondary small">Shows map pins and region circles on the public org page and in address lists.</div>
                    </label>
                </div>
                <div class="col-12 d-flex align-items-center gap-2">
                    <input type="checkbox" class="form-check-input" id="set-dir" @bind="@_showAddressDirections" />
                    <label for="set-dir" class="form-label mb-0">
                        Enable directions for org addresses
                        <div class="text-secondary small">Shows the Directions button on address lists for org members and admins.</div>
                    </label>
                </div>
                <div class="col-12 mt-2">
                    <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(!(!_saving))"><BenIcon Name="save" Class="me-1" />
                        @(_saving ? "Saving…" : "Save Settings")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* Loads and saves independently of the settings above — its own permission failure has no
       business blocking the address toggles. *@
    <OrgCalendarEventTypesManager OrgId="@OrgId" />
}

@code {
    [Parameter] public Guid OrgId { get; set; }

    private bool    _loading  = true;
    private bool    _saving;
    private bool    _showAddressMap;
    private bool    _showAddressDirections;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var s = await AdminClient.GetOrgSettingsAsync(OrgId);
        if (s is not null)
        {
            _showAddressMap        = s.ShowAddressMap;
            _showAddressDirections = s.ShowAddressDirections;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving         = true;
        _errorMessage   = null;
        _successMessage = null;
        StateHasChanged();

        var result = await AdminClient.UpdateOrgSettingsAsync(OrgId, new OrgSettingsRequest(_showAddressMap, _showAddressDirections));
        _saving = false;

        if (result is not null) _successMessage = "Settings saved.";
        else _errorMessage = "Save failed. You may not have permission to update org settings.";
    }
}
