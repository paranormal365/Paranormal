@namespace Ben.Web.Website.Library.Organization
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient

@*
    One organization tile. The four listings — within range, outside range, the location-free
    browse, and the Groups tab of "What's near you" — differ only in the line of metadata under the
    name, so that is the one thing the caller supplies.

    The whole card is the link. It used to be a card with a "View Group" button in its footer,
    which makes a reader aim at a small target for the only thing the card does — the same shape the
    case cards had, and fixed for the same reason.
*@

<a class="org-card @Class" href="@($"/o/{UrlName}")">
    <span class="org-card__mark" style="@TourPlate.HueStyle(Name)">
        @if (LogoFileId is { } logo)
        {
            @* IH-06: a logo whose bytes are gone hides rather than showing a broken glyph and
               spilling its alt text across the card. *@
            <BenImage Src="@AdminClient.GetFileThumbnailUrl(logo)" Alt="@Name"
                      Style="max-height:34px; max-width:48px; object-fit:contain;" />
        }
        else
        {
            @* Their initials in their own colour rather than an empty square. A list of groups
               with no logos was a list of names in boxes; this gives each one something the eye
               can come back to, and it is the colour that group carries everywhere else. *@
            <span class="org-card__initials" aria-hidden="true">@TourPlate.Monogram(Name)</span>
        }
    </span>

    <span class="org-card__body">
        <span class="org-card__name">@Name</span>
        @if (!string.IsNullOrWhiteSpace(AreaLabel))
        {
            <span class="org-card__area">@AreaLabel</span>
        }
        @if (MetaLine is not null)
        {
            <span class="org-card__meta">@MetaLine</span>
        }
    </span>
</a>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string UrlName { get; set; } = string.Empty;

    /// <summary>Area of operation label, e.g. "Nashville, TN". Omitted when the group has none.</summary>
    [Parameter] public string? AreaLabel { get; set; }

    [Parameter] public Guid? LogoFileId { get; set; }

    /// <summary>
    /// The one line that differs per listing — distance, range, or accepting status.
    /// </summary>
    /// <remarks>
    /// Not named <c>Meta</c>: Razor matches child-content tags against HTML elements
    /// case-insensitively, and <c>&lt;meta&gt;</c> is a void element, so <c>&lt;Meta&gt;</c> would
    /// be parsed as self-closing and leave its closing tag orphaned.
    /// </remarks>
    [Parameter] public RenderFragment? MetaLine { get; set; }

    [Parameter] public string? Class { get; set; }
}
