@namespace Ben.Web.Website.Library.Organization
@inject IBenAdminClient AdminClient

@*
    One organization tile on the discovery page. The three listings — within range, outside range,
    and the location-free browse — differ only in the line of metadata under the name, so that is
    the one thing the caller supplies.
*@

<div class="card h-100">
    <div class="card-body">
        @if (LogoFileId.HasValue)
        {
            <div class="mb-2">
                @* IH-06: a logo whose bytes are gone hides rather than showing a broken glyph
                   and spilling its alt text across the card. *@
                <Ben.Web.Website.Library.Kit.BenImage
                    Src="@AdminClient.GetFileThumbnailUrl(LogoFileId.Value)"
                    Alt="@Name"
                    Style="max-height:40px; max-width:80px; object-fit:contain;" />
            </div>
        }
        <h5 class="mb-1">@Name</h5>
        @if (!string.IsNullOrWhiteSpace(AreaLabel))
        {
            <p class="text-secondary small mb-1">@AreaLabel</p>
        }
        <p class="text-muted mb-0" style="font-size:.85rem;">@MetaLine</p>
    </div>
    <div class="card-footer bg-transparent border-0 pt-0">
        <a href="/o/@UrlName" class="btn btn-sm btn-outline-primary">View Group</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string UrlName { get; set; } = string.Empty;

    /// <summary>Area of operation label, e.g. "Nashville, TN". Omitted when the group has none.</summary>
    [Parameter] public string? AreaLabel { get; set; }

    [Parameter] public Guid? LogoFileId { get; set; }

    /// <summary>
    /// The one line that differs per listing — distance, range, or accepting status.
    /// </summary>
    /// <remarks>
    /// Not named <c>Meta</c>: Razor matches child-content tags against HTML elements
    /// case-insensitively, and <c>&lt;meta&gt;</c> is a void element, so <c>&lt;Meta&gt;</c> would
    /// be parsed as self-closing and leave its closing tag orphaned.
    /// </remarks>
    [Parameter] public RenderFragment? MetaLine { get; set; }
}
