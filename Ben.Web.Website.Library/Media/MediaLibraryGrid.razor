@namespace Ben.Web.Website.Library.Media
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.User
@using Ben.Web.Website.Library.Organization.Cases
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@*
  Reusable cross-scope media grid/list. Standalone browse mode (PickerMode="false") or an
  embeddable asset picker (PickerMode="true", handle OnFilesSelected). Fetches everything the
  current user can see via GetMediaLibraryFilesAsync (owned + shared + org + public + case-linked)
  and paginates client-side.
*@

<div class="d-flex flex-column gap-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex gap-1">
            <button type="button" class="btn @((ViewMode == MediaLibraryViewMode.Grid ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ViewMode = MediaLibraryViewMode.Grid)">
                Grid
            </button>
            <button type="button" class="btn @((ViewMode == MediaLibraryViewMode.List ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ViewMode = MediaLibraryViewMode.List)">
                List
            </button>
            @if (!PickerMode)
            {
                <span class="vr mx-1"></span>
                @foreach (var chip in _scopeChips)
                {
                    var scope = chip;
                    <button type="button" class="btn @((_scopeFilter == scope ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => { _scopeFilter = scope; _page = 1; })">
                        @scope
                    </button>
                }
            }
        </div>
        @if (PickerMode && _selectedIds.Count > 0)
        {
            <button type="button" class="btn btn-primary btn-sm" @onclick="ConfirmSelectionAsync">
                Add @_selectedIds.Count selected
            </button>
        }
    </div>

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading media…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_allFilesResult.Failed)
    {
        @* An empty media library sends somebody off to re-upload files they already have. *@
        <BenListState TItem="UploadFileRecord" Result="@_allFilesResult" OnRetry="@LoadAsync" />
    }
    else if (!_filteredFiles.Any())
    {
        <div class="text-secondary small py-4 text-center">No media files found.</div>
    }
    else if (ViewMode == MediaLibraryViewMode.Grid)
    {
        <div class="row g-3">
            @foreach (var f in _pageItems)
            {
                var file = f;
                var isSelected = _selectedIds.Contains(file.Id);
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 @(isSelected ? "border-primary" : "")"
                         style="@(PickerMode ? "cursor:pointer;" : "")"
                         @onclick="@(() => ToggleSelect(file))">
                        <div class="card-body d-flex flex-column gap-2">
                            @if (PickerMode)
                            {
                                <input type="checkbox" class="form-check-input" checked="@isSelected" disabled />
                            }
                            <div class="d-flex align-items-center justify-content-center" style="min-height:96px;">
                                @RenderThumbnail(file)
                            </div>
                            <div class="small text-truncate fw-semibold" title="@file.FileName">@file.FileName</div>
                            <div class="text-secondary" style="font-size:.72rem;">
                                @FormatSize(file.FileSize) · @file.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                            </div>
                            @if (ShowVoting)
                            {
                                <div @onclick:stopPropagation="true">
                                    <EvidenceVoteWidget UploadFileId="@file.Id" />
                                </div>
                            }
                            @if (!PickerMode)
                            {
                                <div @onclick:stopPropagation="true">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenDetail(file))"><BenIcon Name="message-square" Class="me-1" />
                                        Comments
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <TelerikGrid Data="@_pageItems" Pageable="false" Sortable="false">
            <GridColumns>
                @if (PickerMode)
                {
                    <GridColumn Width="50px" Title="">
                        <Template>
                            @{ var row = (UploadFileRecord)context; }
                            <input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(row.Id)" disabled />
                        </Template>
                    </GridColumn>
                }
                <GridColumn Field="@nameof(UploadFileRecord.FileName)" Title="File Name" />
                <GridColumn Field="@nameof(UploadFileRecord.ContentType)" Title="Type" Width="140px" />
                <GridColumn Title="Size" Width="100px">
                    <Template>
                        @{ var row2 = (UploadFileRecord)context; }
                        @FormatSize(row2.FileSize)
                    </Template>
                </GridColumn>
                <GridColumn Title="Uploaded" Width="140px">
                    <Template>
                        @{ var row4 = (UploadFileRecord)context; }
                        @row4.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                    </Template>
                </GridColumn>
                @if (ShowVoting)
                {
                    <GridColumn Title="Voting" Width="260px">
                        <Template>
                            @{ var row3 = (UploadFileRecord)context; }
                            <EvidenceVoteWidget UploadFileId="@row3.Id" />
                        </Template>
                    </GridColumn>
                }
                @if (!PickerMode)
                {
                    <GridColumn Title="" Width="140px">
                        <Template>
                            @{ var row4 = (UploadFileRecord)context; }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenDetail(row4))"><BenIcon Name="message-square" Class="me-1" />
                                Comments
                            </button>
                        </Template>
                    </GridColumn>
                }
            </GridColumns>
        </TelerikGrid>
    }

    @* ── File detail dialog: preview + comment thread + owner-only settings ────── *@
    <BenModal @bind-Visible="@_showDetail" Title="@(_detailFile?.FileName ?? "File")" Size="lg">
    <ChildContent>
            @if (_detailFile is not null)
            {
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center justify-content-center">
                        <UserMediaPreview FileId="@_detailFile.Id" FileName="@_detailFile.FileName"
                                          ContentType="@_detailFile.ContentType" FileSize="@_detailFile.FileSize" />
                    </div>
                    @if (_detailFile.AppUserId == UserState.UserId)
                    {
                        <div>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _showCommentSettings = !_showCommentSettings)">
                                @(_showCommentSettings ? "▾" : "▸") Comment settings
                            </button>
                            @if (_showCommentSettings)
                            {
                                <div class="mt-2">
                                    <FileCommentSettings @key="@_detailFile.Id" FileId="@_detailFile.Id" />
                                </div>
                            }
                        </div>
                    }
                    <hr class="my-0" />
                    <FileCommentThread @key="@_detailFile.Id" FileId="@_detailFile.Id" CanModerate="@(_detailFile.AppUserId == UserState.UserId)" />
                </div>
            }
        </ChildContent>
</BenModal>

    @if (_totalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-center gap-2">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChangePage(_page - 1))" disabled="@(!(_page > 1))">← Prev</button>
            <span class="small text-secondary">Page @_page of @_totalPages</span>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChangePage(_page + 1))" disabled="@(!(_page < _totalPages))">Next →</button>
        </div>
    }
</div>

@code {
    [Parameter] public MediaLibraryViewMode ViewMode { get; set; } = MediaLibraryViewMode.Grid;
    [Parameter] public bool PickerMode { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<UploadFileRecord>> OnFilesSelected { get; set; }
    [Parameter] public bool ShowVoting { get; set; }
    [Parameter] public string[]? ContentTypePrefixes { get; set; }
    [Parameter] public int PageSize { get; set; } = 24;

    private List<UploadFileRecord> _allFiles = [];
    private LoadResult<UploadFileRecord> _allFilesResult;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private readonly HashSet<Guid> _selectedIds = [];
    private readonly HashSet<Guid> _previewLoaded = [];
    private bool _showDetail;
    private UploadFileRecord? _detailFile;
    private bool _showCommentSettings;

    // "Shared"/"Org" aren't offered here — the response deliberately doesn't carry per-file scope
    // tags (see MediaLibraryController's doc comment), so only what's derivable from UploadFileRecord
    // itself (owner, IsPublic) can be filtered client-side without an extra per-file lookup.
    private static readonly string[] _scopeChips = ["All", "Mine", "Public"];
    private string _scopeFilter = "All";

    private IEnumerable<UploadFileRecord> _filteredFiles => _scopeFilter switch
    {
        "Mine" => _allFiles.Where(f => f.AppUserId == UserState.UserId),
        "Public" => _allFiles.Where(f => f.IsPublic),
        _ => _allFiles,
    };

    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_filteredFiles.Count() / (double)PageSize));
    private IEnumerable<UploadFileRecord> _pageItems => _filteredFiles.Skip((_page - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _allFilesResult = await AdminClient.GetMediaLibraryFilesAsync(ContentTypePrefixes); _allFiles = _allFilesResult.Items.ToList(); }
        catch { _error = "Failed to load media files."; }
        _loading = false;
    }

    private void ChangePage(int page)
    {
        _page = Math.Clamp(page, 1, _totalPages);
    }

    private void ToggleSelect(UploadFileRecord file)
    {
        if (!PickerMode) return;
        if (_selectedIds.Contains(file.Id))
        {
            _selectedIds.Remove(file.Id);
        }
        else
        {
            if (!MultiSelect) _selectedIds.Clear();
            _selectedIds.Add(file.Id);
        }
    }

    private void OpenDetail(UploadFileRecord file)
    {
        _detailFile = file;
        _showDetail = true;
        _showCommentSettings = false;
    }

    private async Task ConfirmSelectionAsync()
    {
        var selected = _allFiles.Where(f => _selectedIds.Contains(f.Id)).ToList();
        await OnFilesSelected.InvokeAsync(selected);
    }

    private bool _isImage(UploadFileRecord f) => f.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    private bool _isVideo(UploadFileRecord f) => f.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    private bool _isAudio(UploadFileRecord f) => f.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase);

    // Images render eagerly (small payloads); video/audio load on click to avoid a fetch-storm
    // across a whole grid page — UserMediaPreview has no thumbnail mode, it fetches full bytes.
    private RenderFragment RenderThumbnail(UploadFileRecord file) => __builder =>
    {
        if (_isImage(file))
        {
            <UserMediaPreview FileId="@file.Id" FileName="@file.FileName" ContentType="@file.ContentType" FileSize="@file.FileSize" />
        }
        else if (_previewLoaded.Contains(file.Id))
        {
            <UserMediaPreview FileId="@file.Id" FileName="@file.FileName" ContentType="@file.ContentType" FileSize="@file.FileSize" />
        }
        else
        {
            <div class="d-flex flex-column align-items-center gap-1" @onclick:stopPropagation="true">
                <TelerikSvgIcon Icon="@(_isVideo(file) ? SvgIcon.FileVideo : _isAudio(file) ? SvgIcon.FileAudio : SvgIcon.File)" />
                @if (_isVideo(file) || _isAudio(file))
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => { _previewLoaded.Add(file.Id); })">Preview</button>
                }
            </div>
        }
    };

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024):F1} MB",
    };
}
