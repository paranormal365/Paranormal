@namespace Ben.Web.Website.Library.Media
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@using Ben.Web.Website.Library.User
@using Ben.Web.Website.Library.Organization.Cases
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject IMediaUrlBuilder MediaUrls
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

@*
  Reusable cross-scope media grid/list. Standalone browse mode (PickerMode="false") or an
  embeddable asset picker (PickerMode="true", handle OnFilesSelected). Fetches everything the
  current user can see via GetMediaLibraryFilesAsync (owned + shared + org + public + case-linked)
  and paginates client-side.
*@

<div class="d-flex flex-column gap-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex gap-1">
            <button type="button" class="btn @((ViewMode == MediaLibraryViewMode.Grid ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ViewMode = MediaLibraryViewMode.Grid)">
                Grid
            </button>
            <button type="button" class="btn @((ViewMode == MediaLibraryViewMode.List ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => ViewMode = MediaLibraryViewMode.List)">
                List
            </button>
            @if (!PickerMode)
            {
                <span class="vr mx-1"></span>
                @foreach (var chip in _scopeChips)
                {
                    var scope = chip;
                    <button type="button" class="btn @((_scopeFilter == scope ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Outline) == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => { _scopeFilter = scope; _page = 1; })">
                        @scope
                    </button>
                }
            }
        </div>
        @if (PickerMode && _selectedIds.Count > 0)
        {
            <button type="button" class="btn btn-primary btn-sm" @onclick="ConfirmSelectionAsync">
                Add @_selectedIds.Count selected
            </button>
        }
    </div>

    @if (_loading)
    {
        <BenLoaderOverlay Visible="true" Text="Loading media…" />
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (_allFilesResult.Failed)
    {
        @* An empty media library sends somebody off to re-upload files they already have. *@
        <BenListState TItem="UploadFileRecord" Result="@_allFilesResult" OnRetry="@LoadAsync" />
    }
    else if (!_filteredFiles.Any())
    {
        <div class="text-secondary small py-4 text-center">No media files found.</div>
    }
    else if (ViewMode == MediaLibraryViewMode.Grid)
    {
        <div class="row g-3">
            @foreach (var f in _pageItems)
            {
                var file = f;
                var isSelected = _selectedIds.Contains(file.Id);
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card h-100 @(isSelected ? "border-primary" : "")"
                         style="@(PickerMode ? "cursor:pointer;" : "")"
                         @onclick="@(() => ToggleSelect(file))">
                        <div class="card-body d-flex flex-column gap-2">
                            @if (PickerMode)
                            {
                                <input type="checkbox" class="form-check-input" checked="@isSelected" disabled />
                            }
                            @* A TILE, not a gap. Every card gets the same frame whatever it
                               holds, so "this file has no preview" and "this page is broken" stop
                               looking identical — which is exactly what a row of one-pixel test
                               images made them look like. *@
                            <div class="d-flex align-items-center justify-content-center rounded overflow-hidden"
                                 style="height:96px;background:rgba(128,128,128,.10);">
                                @RenderThumbnail(file)
                            </div>
                            @{ var outcome = OutcomeFor(file); }
                            @* A missing file is marked ON THE NAME, which is the part somebody
                               reads and the part they would quote when reporting it. *@
                            <div class="small text-truncate fw-semibold @(outcome == MediaPreviewOutcome.Unavailable ? "border border-danger rounded px-1 text-danger" : "")"
                                 data-testid="@(outcome == MediaPreviewOutcome.Unavailable ? "file-name-missing" : "file-name")"
                                 title="@(outcome == MediaPreviewOutcome.Unavailable ? $"{file.FileName} — this file could not be loaded from storage" : file.FileName)">
                                @file.FileName
                            </div>
                            @if (outcome is MediaPreviewOutcome.Unavailable or MediaPreviewOutcome.NotPreviewable)
                            {
                                <div class="@(outcome == MediaPreviewOutcome.Unavailable ? "text-danger" : "text-secondary")"
                                     style="font-size:.68rem;line-height:1.2;" data-testid="preview-note">
                                    @(outcome == MediaPreviewOutcome.Unavailable
                                        ? "The file is recorded here but its contents couldn't be loaded."
                                        : "This kind of file can't be shown in the page — download it to open it.")
                                </div>
                            }
                            <div class="text-secondary" style="font-size:.72rem;">
                                @FormatSize(file.FileSize) · @file.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                            </div>
                            @if (ShowVoting)
                            {
                                <div @onclick:stopPropagation="true">
                                    <EvidenceVoteWidget UploadFileId="@file.Id" Compact="true" />
                                </div>
                            }
                            @if (!PickerMode)
                            {
                                <div @onclick:stopPropagation="true">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenDetail(file))"><BenIcon Name="message-square" Class="me-1" />
                                        Comments
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <TelerikGrid Data="@_pageItems" Pageable="false" Sortable="false">
            <GridColumns>
                @if (PickerMode)
                {
                    <GridColumn Width="50px" Title="">
                        <Template>
                            @{ var row = (UploadFileRecord)context; }
                            <input type="checkbox" class="form-check-input" checked="@_selectedIds.Contains(row.Id)" disabled />
                        </Template>
                    </GridColumn>
                }
                <GridColumn Field="@nameof(UploadFileRecord.FileName)" Title="File Name" />
                <GridColumn Field="@nameof(UploadFileRecord.ContentType)" Title="Type" Width="140px" />
                <GridColumn Title="Size" Width="100px">
                    <Template>
                        @{ var row2 = (UploadFileRecord)context; }
                        @FormatSize(row2.FileSize)
                    </Template>
                </GridColumn>
                <GridColumn Title="Uploaded" Width="140px">
                    <Template>
                        @{ var row4 = (UploadFileRecord)context; }
                        @row4.DateCreated.ToViewerLocalTime(UserState).ToDisplayDate()
                    </Template>
                </GridColumn>
                @if (ShowVoting)
                {
                    <GridColumn Title="Voting" Width="260px">
                        <Template>
                            @{ var row3 = (UploadFileRecord)context; }
                            <EvidenceVoteWidget UploadFileId="@row3.Id" Compact="true" />
                        </Template>
                    </GridColumn>
                }
                @if (!PickerMode)
                {
                    <GridColumn Title="" Width="140px">
                        <Template>
                            @{ var row4 = (UploadFileRecord)context; }
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenDetail(row4))"><BenIcon Name="message-square" Class="me-1" />
                                Comments
                            </button>
                        </Template>
                    </GridColumn>
                }
            </GridColumns>
        </TelerikGrid>
    }

    @* ── File detail dialog: preview + comment thread + owner-only settings ────── *@
    <BenModal @bind-Visible="@_showDetail" Title="@(_detailFile?.FileName ?? "File")" Size="lg">
    <ChildContent>
            @if (_detailFile is not null)
            {
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center justify-content-center">
                        <UserMediaPreview FileId="@_detailFile.Id" FileName="@_detailFile.FileName"
                                          ContentType="@_detailFile.ContentType" FileSize="@_detailFile.FileSize" />
                    </div>
                    @if (_detailFile.AppUserId == UserState.UserId)
                    {
                        <div>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _showCommentSettings = !_showCommentSettings)">
                                @(_showCommentSettings ? "▾" : "▸") Comment settings
                            </button>
                            @if (_showCommentSettings)
                            {
                                <div class="mt-2">
                                    <FileCommentSettings @key="@_detailFile.Id" FileId="@_detailFile.Id" />
                                </div>
                            }
                        </div>
                    }
                    <hr class="my-0" />
                    <FileCommentThread @key="@_detailFile.Id" FileId="@_detailFile.Id" CanModerate="@(_detailFile.AppUserId == UserState.UserId)" />
                </div>
            }
        </ChildContent>
</BenModal>

    @if (_totalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-center gap-2">
            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChangePage(_page - 1))" disabled="@(!(_page > 1))">← Prev</button>
            <span class="small text-secondary">Page @_page of @_totalPages</span>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => ChangePage(_page + 1))" disabled="@(!(_page < _totalPages))">Next →</button>
        </div>
    }
</div>

@code {
    [Parameter] public MediaLibraryViewMode ViewMode { get; set; } = MediaLibraryViewMode.Grid;
    [Parameter] public bool PickerMode { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<UploadFileRecord>> OnFilesSelected { get; set; }
    [Parameter] public bool ShowVoting { get; set; }
    [Parameter] public string[]? ContentTypePrefixes { get; set; }
    [Parameter] public int PageSize { get; set; } = 24;

    private List<UploadFileRecord> _allFiles = [];
    private LoadResult<UploadFileRecord> _allFilesResult;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private readonly HashSet<Guid> _selectedIds = [];
    private readonly HashSet<Guid> _previewLoaded = [];
    private bool _showDetail;
    private UploadFileRecord? _detailFile;
    private bool _showCommentSettings;

    // "Shared"/"Org" aren't offered here — the response deliberately doesn't carry per-file scope
    // tags (see MediaLibraryController's doc comment), so only what's derivable from UploadFileRecord
    // itself (owner, IsPublic) can be filtered client-side without an extra per-file lookup.
    private static readonly string[] _scopeChips = ["All", "Mine", "Public"];
    private string _scopeFilter = "All";

    private IEnumerable<UploadFileRecord> _filteredFiles => _scopeFilter switch
    {
        "Mine" => _allFiles.Where(f => f.AppUserId == UserState.UserId),
        "Public" => _allFiles.Where(f => f.IsPublic),
        _ => _allFiles,
    };

    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_filteredFiles.Count() / (double)PageSize));
    private IEnumerable<UploadFileRecord> _pageItems => _filteredFiles.Skip((_page - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _allFilesResult = await AdminClient.GetMediaLibraryFilesAsync(ContentTypePrefixes); _allFiles = _allFilesResult.Items.ToList(); }
        catch { _error = "Failed to load media files."; }
        _loading = false;
    }

    private void ChangePage(int page)
    {
        _page = Math.Clamp(page, 1, _totalPages);
    }

    private void ToggleSelect(UploadFileRecord file)
    {
        if (!PickerMode) return;
        if (_selectedIds.Contains(file.Id))
        {
            _selectedIds.Remove(file.Id);
        }
        else
        {
            if (!MultiSelect) _selectedIds.Clear();
            _selectedIds.Add(file.Id);
        }
    }

    private void OpenDetail(UploadFileRecord file)
    {
        _detailFile = file;
        _showDetail = true;
        _showCommentSettings = false;
    }

    private async Task ConfirmSelectionAsync()
    {
        var selected = _allFiles.Where(f => _selectedIds.Contains(f.Id)).ToList();
        await OnFilesSelected.InvokeAsync(selected);
    }

    private bool _isImage(UploadFileRecord f) => f.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    private bool _isVideo(UploadFileRecord f) => f.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    private bool _isAudio(UploadFileRecord f) => f.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase);

    // Images render eagerly (small payloads); video/audio load on click to avoid a fetch-storm
    // across a whole grid page — UserMediaPreview has no thumbnail mode, it fetches full bytes.
    private RenderFragment RenderThumbnail(UploadFileRecord file) => __builder =>
    {
        if (_isImage(file))
        {
            @* The BROWSER fetches a shrunken copy, straight from the API.
               
               This used to pull the whole file through the circuit and hand it over as a base64
               data URL — for every card, on every render. A page holding an 11 MB photograph and
               a couple of 32 MB videos put the website process into gigabytes and eventually
               out of memory, which is why the library "wasn't displaying": it was drowning, not
               broken. The thumbnail endpoint exists for exactly this and says so in its own
               remarks; this grid simply never used it. The browser also caches these, which the
               data URLs could never do.

               Through /media/… rather than straight at the API: the browser holds no bearer
               token, so a direct link 401s on anything that is not public — and the card would
               then call a perfectly good file broken. *@
            <img src="@MediaUrls.Thumbnail(file.Id)"
                 alt="@file.FileName" title="@file.FileName"
                 loading="lazy" decoding="async"
                 style="width:100%;height:100%;object-fit:contain;border-radius:4px;image-rendering:pixelated;"
                 @onload="@(() => RecordOutcome(file.Id, MediaPreviewOutcome.Shown))"
                 @onerror="@(() => RecordOutcome(file.Id, MediaPreviewOutcome.Unavailable))" />
        }
        else if (_isAudio(file) && _previewLoaded.Contains(file.Id))
        {
            @* A waveform, drawn from a URL the BROWSER fetches.
               
               WaveSurfer streams the audio itself, so the file never passes through the server's
               memory. The previous shape — fetch the bytes server-side, base64 them into the
               page — cost the website a copy of every recording on the page, and a library of
               them took the process to sixteen gigabytes and killed it. A grid must never hold
               its files in memory to draw them. *@
            <div class="w-100" @onclick:stopPropagation="true">
                <AudioFilePreview FileId="@file.Id" FileName="@file.FileName"
                                  ContentType="@file.ContentType" FileSize="@file.FileSize"
                                  SourceUrl="@MediaUrls.Download(file.Id)"
                                  OnOutcome="@(o => RecordOutcome(file.Id, o))" />
            </div>
        }
        else if (_isAudio(file))
        {
            @* On demand, not on sight.
            
               A page holds two dozen cards, and drawing every waveform at once fires two dozen
               fetches in the same instant — enough to trip the API's own rate limit (600/min,
               shared by everything this site asks for) and return 429s that the card would then
               report as broken recordings. One tap is cheaper than a page that lies. *@
            <div class="d-flex flex-column align-items-center gap-1" @onclick:stopPropagation="true">
                <TelerikSvgIcon Icon="@SvgIcon.FileAudio" />
                <button type="button" class="btn btn-secondary btn-sm" data-testid="show-waveform"
                        @onclick="@(() => { _previewLoaded.Add(file.Id); RecordOutcome(file.Id, MediaPreviewOutcome.Shown); })">Waveform</button>
            </div>
        }
        else if (_isVideo(file) && _previewLoaded.Contains(file.Id))
        {
            @* Same rule: the browser streams it, the server never holds it. `preload="metadata"`
               fetches a few kilobytes of header rather than the whole film. *@
            <video controls preload="metadata" class="w-100" style="max-height:96px;"
                   src="@MediaUrls.Download(file.Id)"
                   @onclick:stopPropagation="true"></video>
        }
        else if (_isVideo(file))
        {
            <div class="d-flex flex-column align-items-center gap-1" @onclick:stopPropagation="true">
                <TelerikSvgIcon Icon="@SvgIcon.FileVideo" />
                <button type="button" class="btn btn-secondary btn-sm"
                        @onclick="@(() => { _previewLoaded.Add(file.Id); RecordOutcome(file.Id, MediaPreviewOutcome.Shown); })">Preview</button>
            </div>
        }
        else
        {
            @* Everything else — a .json, a .zip. Said in words rather than shown as an anonymous
               icon that reads as a failure. Nothing is fetched: there is nothing to draw. *@
            <div class="d-flex flex-column align-items-center justify-content-center text-center gap-1 p-1"
                 data-testid="preview-none" title="@file.FileName">
                <span class="text-secondary" style="font-size:1.1rem;line-height:1;">&#128196;</span>
                <span class="text-secondary" style="font-size:.68rem;line-height:1.1;">No preview for this type</span>
            </div>
            @RecordOutcomeInline(file.Id, MediaPreviewOutcome.NotPreviewable)
        }
    };

    private readonly Dictionary<Guid, MediaPreviewOutcome> _outcomes = [];

    private MediaPreviewOutcome OutcomeFor(UploadFileRecord file)
        => _outcomes.TryGetValue(file.Id, out var o) ? o : MediaPreviewOutcome.Loading;

    /// <summary>Records an outcome that is known at render time, without re-rendering.</summary>
    /// <remarks>
    /// Calling <see cref="RecordOutcome"/> during a render would ask for another render from
    /// inside one. Nothing needs to change on screen here — the tile has already drawn what it is
    /// going to draw — so the value is simply stored for the note underneath.
    /// </remarks>
    private RenderFragment RecordOutcomeInline(Guid fileId, MediaPreviewOutcome outcome) => __builder =>
    {
        _outcomes[fileId] = outcome;
    };

    private void RecordOutcome(Guid fileId, MediaPreviewOutcome outcome)
    {
        if (_outcomes.TryGetValue(fileId, out var existing) && existing == outcome) return;
        _outcomes[fileId] = outcome;
        StateHasChanged();
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024):F1} MB",
    };
}
