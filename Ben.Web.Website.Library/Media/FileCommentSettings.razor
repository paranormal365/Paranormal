@namespace Ben.Web.Website.Library.Media
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient

@*
  Owner-only per-audience commenting toggles for an UploadFile (item #6 phase 2). The server
  independently enforces owner-only on the PUT, so this component doesn't re-check ownership —
  callers should only render it when they already know the viewer owns the file (e.g. via
  UploadFileRecord.AppUserId == UserState.UserId), same convention as CanModerate on FileCommentThread.
*@

<div class="d-flex flex-column gap-2">
    @if (_settings is null)
    {
        <BenLoaderOverlay Visible="true" Text="Loading settings…" />
    }
    else
    {
        <div class="small text-secondary mb-1">Who can comment on this file:</div>
        <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="cs-team" @bind="@_allowInvestigationTeam" />
                <label for="cs-team" class="form-label mb-0">Investigation team</label>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="cs-client" @bind="@_allowClient" />
                <label for="cs-client" class="form-label mb-0">Client</label>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="cs-org" @bind="@_allowOrganization" />
                <label for="cs-org" class="form-label mb-0">Organization</label>
            </div>
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox" class="form-check-input" id="cs-public" @bind="@_allowPublic" />
                <label for="cs-public" class="form-label mb-0">Public</label>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 mt-1">
            <button type="button" class="btn btn-primary btn-sm" @onclick="Save" disabled="@(!(!_saving))">Save</button>
            @if (_saved)
            {
                <span class="text-success small">Saved.</span>
            }
        </div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-danger mt-1 mb-0 py-2 small">@_error</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid FileId { get; set; }

    private FileCommentSettingsRecord? _settings;
    private bool _allowInvestigationTeam;
    private bool _allowClient;
    private bool _allowOrganization;
    private bool _allowPublic;
    private bool _saving;
    private bool _saved;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (_settings is not null) return;
        try
        {
            _settings = await AdminClient.GetFileCommentSettingsAsync(FileId)
                ?? new FileCommentSettingsRecord(false, false, false, false);
            _allowInvestigationTeam = _settings.AllowInvestigationTeamComments;
            _allowClient = _settings.AllowClientComments;
            _allowOrganization = _settings.AllowOrganizationComments;
            _allowPublic = _settings.AllowPublicComments;
        }
        catch { _error = "Failed to load comment settings."; }
    }

    private async Task Save()
    {
        if (_saving) return;
        _saving = true;
        _saved = false;
        _error = null;
        try
        {
            var request = new FileCommentSettingsRecord(_allowInvestigationTeam, _allowClient, _allowOrganization, _allowPublic);
            var result = await AdminClient.UpdateFileCommentSettingsAsync(FileId, request);
            if (result is null) _error = "Failed to save comment settings.";
            else _saved = true;
        }
        catch { _error = "Failed to save comment settings. Please try again."; }
        finally { _saving = false; }
    }
}
