@namespace Ben.Web.Website.Library.Promotions

@*
    The founding groups' attention-getter (Ben, 11/02/2026: "some cool gif animations or something to draw attention
    to it"): one ghost-lantern per spot, lit while the spot is open and dark once a group has it. The lit ones glow
    and flicker, each a little out of step with the next, and the count beside them ticks when it changes.

    CSS and SVG rather than a GIF: sharp at any size, a few hundred bytes, the site's own colors in dark mode, and
    still when the visitor's device asks for less motion (see the .css).
*@

<div class="lanterns @(Compact ? "lanterns--compact" : "")" role="img"
     aria-label="@($"{Lit} of {Total} spots still open")" data-testid="founding-lanterns">
    @for (var i = 0; i < Total; i++)
    {
        var lit = i < Lit;
        <svg class="lantern @(lit ? "lantern--lit" : "lantern--dark")" style="--i:@i" viewBox="0 0 32 48" aria-hidden="true">
            <path class="lantern__handle" d="M11 6 Q16 0 21 6" />
            <rect class="lantern__cap" x="9" y="6" width="14" height="5" rx="1.5" />
            <path class="lantern__glass" d="M8 11 H24 L26 36 H6 Z" />
            <ellipse class="lantern__flame" cx="16" cy="26" rx="4" ry="6.5" />
            <rect class="lantern__base" x="5" y="36" width="22" height="5" rx="1.5" />
        </svg>
    }
</div>

@code {
    /// <summary>How many spots there are in all.</summary>
    [Parameter] public int Total { get; set; } = 10;

    /// <summary>How many are still open.</summary>
    [Parameter] public int Lit { get; set; }

    /// <summary>Smaller, for the pricing page's notice.</summary>
    [Parameter] public bool Compact { get; set; }
}
