@namespace Ben.Web.Website.Library.User
@using Ben.Web.Website.Library.Shared
@inject IBenAdminClient AdminClient
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h6 class="card-title">Addresses<HelpLink Slug="your-profile" Anchor="your-contact-information" /></h6>
                <p class="text-secondary small mb-0">
                    Looked up on a map as you type. An address that cannot be found still saves —
                    it simply has no pin.
                </p>
            </div>
            @if (!_showForm)
            {
                <button type="button" class="btn btn-primary" @onclick="BeginCreate"><BenIcon Name="plus" Class="me-1" />Add</button>
            }
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mt-3 mb-0">@_error</div>
        }

        @if (_loading)
        {
            <div class="text-secondary small mt-3">Loading…</div>
        }
        else
        {
            @if (_rowsResult.Failed)
            {
                @* Somebody shown an empty list adds a duplicate of what is already there. *@
                <BenListState TItem="MyAddressRecord" Result="@_rowsResult" OnRetry="@LoadAsync" />
            }
            else if (_rows.Count == 0 && !_showForm)
            {
                <p class="text-secondary small fst-italic mt-3 mb-0">No addresses yet.</p>
            }

            @foreach (var row in _rows)
            {
                <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div>
                            <span class="fw-semibold">@row.StreetAddress1</span>
                            <span class="badge bg-secondary ms-2">@TypeName(row.UserAddressTypeId)</span>
                            @if (row.IsPublic)
                            {
                                <span class="badge bg-info text-dark ms-1">Public</span>
                            }
                            @if (row.Latitude is null || row.Longitude is null)
                            {
                                <span class="badge bg-body-secondary text-body-emphasis border ms-1" title="No coordinates — the lookup did not find this address">No pin</span>
                            }
                        </div>
                        <div class="text-secondary small">
                            @if (!string.IsNullOrWhiteSpace(row.StreetAddress2))
                            {
                                <span>@row.StreetAddress2, </span>
                            }
                            @row.City, @row.State @row.ZipCode @row.Country
                        </div>
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm" @onclick="@(() => BeginEdit(row))" title="Edit"><BenIcon Name="edit-2" /></button>
                        <button type="button" class="btn btn-link text-decoration-none btn-sm" @onclick="@(() => _deleteTarget = row)" title="Delete"><BenIcon Name="trash-2" /></button>
                    </div>
                </div>
            }

            @* An inline form rather than a modal, matching OrgAddressManager: the map preview
               inside AddressFieldsWithMap needs real width, and a window that has to be sized
               around a map is fussier than simply expanding the card. *@
            @if (_showForm)
            {
                <div class="border-top pt-3 mt-3">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small mb-1" for="myaddressescard-type-b089">Type</label>
                            <select id="myaddressescard-type-b089" class="form-select" style="max-width:280px;" value="@_formTypeId"
                                    @onchange="@(e => _formTypeId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty)">
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id" selected="@(t.Id == _formTypeId)">@t.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <AddressFieldsWithMap @ref="_addrFields" State="@_addrState" />
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="address-public"
                                       checked="@_formIsPublic"
                                       @onchange="@(e => _formIsPublic = (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="address-public">Public</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(!(!_saving))">
                            @(_saving ? "Saving…" : "Save")
                        </button>
                        <button type="button" class="btn btn-link text-decoration-none" @onclick="@(() => { _showForm = false; _error = null; })">Cancel</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (_deleteTarget is not null)
{
    <BenModal Visible="true" Title="Delete address" Size="sm">
    <ChildContent>
            <p>Remove <strong>@_deleteTarget.StreetAddress1</strong> from your profile?</p>
            <div class="dialog-footer-actions d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-link text-decoration-none" @onclick="@(() => _deleteTarget = null)">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
            </div>
        </ChildContent>
</BenModal>
}

@code {
    private List<MyAddressRecord> _rows = new();
    private LoadResult<MyAddressRecord> _rowsResult;
    private IReadOnlyList<UserAddressTypeRecord> _types = Array.Empty<UserAddressTypeRecord>();
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool  _showForm;
    private Guid? _editId;
    private Guid  _formTypeId;
    private bool  _formIsPublic;

    private AddressFieldsWithMap? _addrFields;
    private AddressFieldsState    _addrState = new();

    private MyAddressRecord? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        _types = (await AdminClient.GetUserAddressTypesAsync()).Items;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rowsResult = await AdminClient.GetMyAddressesAsync();
        _rows       = [.. _rowsResult.Items];
        _loading = false;
    }

    private string TypeName(Guid id) => _types.FirstOrDefault(t => t.Id == id)?.Name ?? "Other";

    private void BeginCreate()
    {
        if (_types.Count == 0)
        {
            _error = "No address types have been set up yet. Ask an administrator to add some before adding an address.";
            return;
        }

        _editId = null;
        _addrState = new AddressFieldsState();
        _formTypeId = _types.FirstOrDefault()?.Id ?? Guid.Empty;
        _formIsPublic = false;
        _error = null;
        _showForm = true;
        _addrFields?.ResetPreview();   // clear the previous entry's pin
    }

    private void BeginEdit(MyAddressRecord row)
    {
        _editId = row.Id;
        _addrState = new AddressFieldsState
        {
            StreetAddress1 = row.StreetAddress1,
            StreetAddress2 = row.StreetAddress2,
            City           = row.City,
            State          = row.State,
            ZipCode        = row.ZipCode,
            Country        = row.Country,
            Latitude       = row.Latitude,
            Longitude      = row.Longitude
        };
        _formTypeId = row.UserAddressTypeId;
        _formIsPublic = row.IsPublic;
        _error = null;
        _showForm = true;

        if (_addrFields is not null && row.Latitude.HasValue && row.Longitude.HasValue)
            _addrFields.InitPreview((double)row.Latitude.Value, (double)row.Longitude.Value);
    }

    private async Task SaveAsync()
    {
        if (_addrFields is not null && !_addrFields.IsValid)
        {
            _error = _addrFields.ValidationMessage;
            return;
        }

        _saving = true;
        _error = null;

        var request = new UpsertMyAddressRequest(
            _formTypeId,
            _addrState.StreetAddress1,
            _addrState.StreetAddress2,
            _addrState.City,
            _addrState.State,
            _addrState.ZipCode,
            _addrState.Country,
            _formIsPublic,
            SortOrder: 0,
            Latitude: _addrState.Latitude,
            Longitude: _addrState.Longitude);

        var result = _editId is null
            ? await AdminClient.CreateMyAddressAsync(request)
            : await AdminClient.UpdateMyAddressAsync(_editId.Value, request);

        _saving = false;

        if (result is null)
        {
            _error = "That could not be saved.";
            return;
        }

        _showForm = false;
        await LoadAsync();
    }

    private async Task DeleteConfirmedAsync()
    {
        var target = _deleteTarget;
        _deleteTarget = null;
        if (target is null) return;

        if (!await AdminClient.DeleteMyAddressAsync(target.Id))
        {
            _error = "That could not be deleted.";
            return;
        }

        await LoadAsync();
    }
}
