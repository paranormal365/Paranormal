@* Renders an image thumbnail, video player, or audio player for an UploadFile.
   Fetches file bytes server-side and renders as a base64 data URL.
   Audio files are delegated to AudioFilePreview (WaveSurfer waveform).
   For non-media types renders a plain file-type badge. *@

@inject IBenAdminClient AdminClient

@if (FileId == Guid.Empty || string.IsNullOrEmpty(ContentType))
{
    <span class="badge bg-secondary">@(FileName ?? "file")</span>
}
else if (_isAudio)
{
    <AudioFilePreview FileId="@FileId"
                      FileName="@(FileName ?? string.Empty)"
                      ContentType="@ContentType"
                      FileSize="@FileSize" />
}
else if (_loading)
{
    <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
}
else if (_dataUrl is not null)
{
    @if (_isImage)
    {
        <img src="@_dataUrl"
             style="max-width:120px;max-height:90px;object-fit:contain;border-radius:4px;cursor:pointer;"
             alt="@FileName"
             title="@FileName"
             @onclick="ToggleFullSize" />

        @if (_showFull)
        {
            <div style="position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;"
                 @onclick="ToggleFullSize">
                <img src="@_dataUrl" style="max-width:90vw;max-height:90vh;object-fit:contain;border-radius:8px;" alt="@FileName" />
            </div>
        }
    }
    else if (_isVideo)
    {
        <video controls preload="metadata"
               style="max-width:320px;max-height:240px;border-radius:4px;">
            <source src="@_dataUrl" type="@ContentType" />
            <em class="text-secondary small">Browser does not support video.</em>
        </video>
    }
}
else
{
    <span class="badge bg-secondary text-truncate" style="max-width:120px;" title="@FileName">@FileName</span>
}

@code {
    [Parameter] public Guid    FileId      { get; set; }
    [Parameter] public string? ContentType { get; set; }
    [Parameter] public string? FileName    { get; set; }
    [Parameter] public long    FileSize    { get; set; }

    private string? _dataUrl;
    private bool _loading;
    private bool _showFull;

    private bool _isImage => ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;
    private bool _isVideo => ContentType?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true;
    private bool _isAudio => ContentType?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) == true;
    // No audio here: audio is delegated to AudioFilePreview above, which fetches its own bytes.
    private bool _hasPreview => _isImage || _isVideo;

    protected override async Task OnParametersSetAsync()
    {
        if (FileId == Guid.Empty || !_hasPreview) return;

        _loading = true;
        _dataUrl = null;
        StateHasChanged();

        try
        {
            var result = await AdminClient.GetFileDataAsync(FileId);
            if (result is not null)
                _dataUrl = $"data:{ContentType};base64,{Convert.ToBase64String(result.Value.Data)}";
        }
        catch { /* silently fail — component shows file-type badge as fallback */ }

        _loading = false;
    }

    private void ToggleFullSize() => _showFull = !_showFull;
}
