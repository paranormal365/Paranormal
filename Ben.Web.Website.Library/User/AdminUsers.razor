@page "/admin/users"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>SuperAdmin — Users</PageTitle>

<div class="container-fluid px-3">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">All Users</h3>
        </div>
        <div class="col-auto">
            <a href="/admin/users/create" class="btn btn-primary"><BenIcon Name="plus" Class="me-1" />
                New User
            </a>
        </div>
    </div>

    @* d-flex, because .form-control is display:block — the max-width kept it narrow but it still
       claimed the whole line, pushing Search onto a row of its own. *@
    <div class="mb-3 d-flex align-items-center gap-2">
        <input type="text" class="form-control" placeholder="Search by name or email…" style="max-width:320px;" @bind="@_search" @bind:event="oninput" />
        <button type="button" class="btn btn-primary flex-shrink-0" @onclick="ApplySearch"><BenIcon Name="search" Class="me-1" />Search</button>
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <button type="button" class="btn btn-link text-decoration-none flex-shrink-0" @onclick="ClearSearch">Clear</button>
        }
    </div>

    @* An empty user grid to a SuperAdmin reads as "this deployment has no accounts", which is
       never true and sends them looking at the database. *@
    <BenListState TItem="AppUserRecord" Result="@_usersResult" EmptyText="No user accounts yet" OnRetry="@OnInitializedAsync">
    <ChildContent>
    <TelerikGrid Data="@_filtered"
                 TItem="AppUserRecord"
                 Pageable="true"
                 PageSize="25"
                 Sortable="true"
                 Class="admin-users-grid">
        <GridColumns>
            <GridColumn Field="@nameof(AppUserRecord.DisplayName)" Title="Display Name" Width="180px" />
            @* Real name replaces the email column, at Ben's request. Email is still searchable —
               see ApplySearch — so nothing became unfindable, it just stopped taking a column.
               Accounts created before these fields existed have no name; an em dash says so
               rather than leaving a cell that looks like a rendering fault. *@
            <GridColumn Field="@nameof(AppUserRecord.FullName)" Title="Name" Width="200px">
                <Template>
                    @{ var u = (AppUserRecord)context; }
                    @if (u.FullName is { } name)
                    {
                        @name
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AppUserRecord.DateCreated)" Title="Created" Width="110px">
                <Template>
                    @(((AppUserRecord)context).DateCreated.ToViewerLocalTime(UserState).ToDisplayDate())
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AppUserRecord.IsEmailConfirmed)" Title="Verified" Width="80px">
                <Template>
                    @if (((AppUserRecord)context).IsEmailConfirmed)
                    {
                        <BenIcon Name="check" Class="text-success" />
                    }
                </Template>
            </GridColumn>
            <GridCommandColumn Width="130px">
                <GridCommandButton Command="View"
                                   Icon="@SvgIcon.Eye"
                                   OnClick="@((GridCommandEventArgs e) => ViewUser((AppUserRecord)e.Items.First()))">
                    View
                </GridCommandButton>
                @* Icon only, with Title for the tooltip and the accessible name.
                   NO aria-label here: Telerik components do not splat unmatched attributes, they
                   throw during render and take the circuit with them — that is item 112, which
                   cost a debugging session when TelerikMaskedTextBox was given one. Title is a
                   real GridCommandButton parameter; aria-label is not. *@
                <GridCommandButton Command="Impersonate"
                                   Icon="@SvgIcon.User"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                   Title="Impersonate this user"
                                   OnClick="@((GridCommandEventArgs e) => Impersonate((AppUserRecord)e.Items.First()))" />
            </GridCommandColumn>
        </GridColumns>
    </TelerikGrid>
    </ChildContent>
    </BenListState>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@_errorMessage</div>
    }
</div>

@code {
    private IReadOnlyList<AppUserRecord> _users  = [];
    private IReadOnlyList<AppUserRecord> _filtered = [];
    private LoadResult<AppUserRecord> _usersResult;
    private string _search = string.Empty;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating)
            NavManager.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
            _usersResult = await AdminClient.GetAllUsersAsync();
            _users       = _usersResult.Items;
            _filtered = _users;
            StateHasChanged();
        }
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _filtered = _users;
            return;
        }

        var q = _search.Trim().ToLowerInvariant();
        _filtered = _users
            .Where(u => (u.DisplayName?.ToLowerInvariant().Contains(q) ?? false)
                     || (u.Email?.ToLowerInvariant().Contains(q) ?? false)
                     || (u.UserName?.ToLowerInvariant().Contains(q) ?? false))
            .ToList();
    }

    private void ClearSearch()
    {
        _search   = string.Empty;
        _filtered = _users;
    }

    private void ViewUser(AppUserRecord user)
        => NavManager.NavigateTo($"/admin/users/{user.Id}");

    private async Task Impersonate(AppUserRecord user)
    {
        if (user.Id == UserState.UserId)
        {
            _errorMessage = "You cannot impersonate yourself.";
            return;
        }
        _errorMessage = null;

        var ok = await AdminClient.ImpersonateUserAsync(user.Id, user.Email ?? string.Empty);
        if (ok)
            NavManager.NavigateTo("/");
        else
            _errorMessage = $"Failed to impersonate {user.Email}.";
    }
}
