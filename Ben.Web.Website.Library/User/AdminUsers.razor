@page "/admin/users"

@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>SuperAdmin — Users</PageTitle>

<div class="container-fluid px-3">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">All Users</h3>
        </div>
        <div class="col-auto">
            <a href="/admin/users/create" class="btn btn-primary"><BenIcon Name="plus" Class="me-1" />
                New User
            </a>
        </div>
    </div>

    @* d-flex, because .form-control is display:block — the max-width kept it narrow but it still
       claimed the whole line, pushing Search onto a row of its own. *@
    <div class="mb-3 d-flex align-items-center gap-2">
        <input type="text" class="form-control" placeholder="Search by name or email…" style="max-width:320px;" @bind="@_search" @bind:event="oninput" />
        <button type="button" class="btn btn-primary flex-shrink-0" @onclick="ApplySearch"><BenIcon Name="search" Class="me-1" />Search</button>
        @if (!string.IsNullOrWhiteSpace(_search))
        {
            <button type="button" class="btn btn-link text-decoration-none flex-shrink-0" @onclick="ClearSearch">Clear</button>
        }

        @* Closing an account anonymises it rather than removing the row, so every former member
           stays in this table for ever, named "A former member". They are almost never what
           somebody is here to look at, so they are out by default — and the count beside the box
           is there so that a search which finds nothing says why, instead of reading as "that
           person was never here". *@
        <div class="form-check flex-shrink-0 ms-auto mb-0">
            <input class="form-check-input" type="checkbox" id="users-include-former"
                   checked="@_includeFormer"
                   @onchange="@(e => OnIncludeFormerChanged((bool?)e.Value ?? false))" />
            <label class="form-check-label text-nowrap" for="users-include-former">
                Include former members
                @if (!_includeFormer && _formerCount > 0)
                {
                    <span class="badge bg-body-secondary text-body-emphasis border ms-1"
                          data-testid="former-hidden-count">@_formerCount hidden</span>
                }
            </label>
        </div>
    </div>

    @* An empty user grid to a SuperAdmin reads as "this deployment has no accounts", which is
       never true and sends them looking at the database. *@
    <BenListState TItem="AppUserRecord" Result="@_usersResult" Loading="@_loading" EmptyText="No user accounts yet" OnRetry="@LoadAsync">
    <ChildContent>
    <TelerikGrid Data="@_rows"
                 TItem="AdminUserRow"
                 Pageable="true"
                 PageSize="25"
                 Sortable="true"
                 Class="admin-users-grid">
        <GridColumns>
            <GridColumn Field="@nameof(AdminUserRow.DisplayName)" Title="Display Name" Width="180px" />
            @* Real name replaces the email column, at Ben's request. Email is still searchable —
               see ApplySearch — so nothing became unfindable, it just stopped taking a column.
               Accounts created before these fields existed have no name; an em dash says so
               rather than leaving a cell that looks like a rendering fault. *@
            <GridColumn Field="@nameof(AdminUserRow.FullName)" Title="Name" Width="200px">
                <Template>
                    @{ var u = ((AdminUserRow)context).User; }
                    @if (u.FullName is { } name)
                    {
                        @name
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AdminUserRow.DateCreated)" Title="Created" Width="110px">
                <Template>
                    @(((AdminUserRow)context).DateCreated.ToViewerLocalTime(UserState).ToDisplayDate())
                </Template>
            </GridColumn>
            @* A tick alone could not tell "has not got round to it" from "was never told how" —
               the two states that matter when somebody says they never received the email. The
               sent time is what separates them. *@
            <GridColumn Field="@nameof(AdminUserRow.IsEmailConfirmed)" Title="Verified" Width="180px">
                <Template>
                    @{ var u = ((AdminUserRow)context).User; }
                    @if (u.IsEmailConfirmed)
                    {
                        @* The same mark the person sees on their own profile, so an administrator
                           and the account holder are never looking at two different vocabularies. *@
                        <BenProven Label="Confirmed" ShowLabel="false"
                                   Proved="true"
                                   On="@u.DateEmailConfirmed" />
                        @if (u.DateEmailConfirmed is { } confirmed)
                        {
                            <span class="text-secondary small ms-1">
                                @confirmed.ToViewerLocalTime(UserState).ToDisplayDate()
                            </span>
                        }
                    }
                    else if (u.DateConfirmationSent is { } sent)
                    {
                        <span class="text-warning small text-nowrap">
                            Sent @sent.ToViewerLocalTime(UserState).ToDisplayDate()
                        </span>
                    }
                    else
                    {
                        @* The state Ben hit: an account nobody can complete, because no message
                           ever left. Named rather than left blank — a blank cell is what hid it. *@
                        <span class="text-danger small text-nowrap">No email sent</span>
                    }
                </Template>
            </GridColumn>
            @* Who is signing in, and how often (Ben, 2026-09-19). Sortable, because the question
               is "who" and "how often" — both of which are orderings, not lookups.

               Counting every method the site records: password, Sign in with Apple, the editor
               handoff, and one row per twelve-hour Microsoft visit. Nothing reaches further back
               than 2026-08-20, when the sign-in table was made, so an older account's count
               starts there rather than at the day it was created. *@
            <GridColumn Field="@nameof(AdminUserRow.LastSignInUtc)" Title="Last sign-in" Width="150px">
                <Template>
                    @{ var row = (AdminUserRow)context; }
                    @if (row.LastSignInUtc is { } seen)
                    {
                        <span class="text-nowrap">@seen.ToViewerLocalTime(UserState).ToDisplayDateTime()</span>
                    }
                    else
                    {
                        @* Said, not left blank. An empty cell reads as a rendering fault, and
                           "never signed in" is the one fact on this row worth noticing. *@
                        <span class="text-secondary">Never</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(AdminUserRow.SignInCount)" Title="Sign-ins" Width="100px">
                <Template>
                    @{ var row = (AdminUserRow)context; }
                    @if (row.SignInCount > 0)
                    {
                        @row.SignInCount.ToString("N0")
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </Template>
            </GridColumn>
            @* One actions column, three icon buttons, on one line. View used to be a Telerik
               GridCommandColumn of its own, which read as two separate action columns and left
               a text button beside two icon ones. Impersonate and delete stayed out of the
               command column so they can answer to the row they are on; View joined them rather
               than the other way round. Both refuse on your own account, and a control that is
               offered and then refuses is the dead-end click items 149 and 150 ruled out: three
               Playwright tests clicked the first row's delete button and got the refusal, because
               on a fresh database the SuperAdmin sorts first. Shown disabled rather than hidden,
               so the row keeps its shape and the tooltip says why. Viewing yourself is allowed,
               so View is never disabled. *@
            <GridColumn Title="Actions" Width="150px" Sortable="false" Filterable="false" Context="row">
                <Template>
                    @{ var person = ((AdminUserRow)row).User; }
                    <div class="text-nowrap">
                        <BenGridAction Icon="eye" Label="View this user" Tone="GridActionTone.Primary" OnClick="@(() => ViewUser(person))" />
                        @if (person.Id == UserState.UserId)
                        {
                            <BenGridAction Icon="user-check" Label="You are signed in as this account" Tone="GridActionTone.Warning" Disabled="true" />
                            <BenGridAction Icon="trash-2" Label="Delete your own account from your profile" Tone="GridActionTone.Danger" Disabled="true" />
                        }
                        else
                        {
                            <BenGridAction Icon="user-check" Label="Impersonate this user" Tone="GridActionTone.Warning" OnClick="@(() => Impersonate(person))" />
                            <BenGridAction Icon="trash-2" Label="Delete this user" Tone="GridActionTone.Danger" OnClick="@(() => DeleteUser(person))" />
                        }
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </TelerikGrid>
    </ChildContent>
    </BenListState>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@_errorMessage</div>
    }
</div>

@code {
    private IReadOnlyList<AppUserRecord> _users  = [];
    private IReadOnlyList<AppUserRecord> _filtered = [];
    private LoadResult<AppUserRecord> _usersResult;

    /// <summary>
    /// True until the list has come back. A result nobody has fetched yet is empty, and without this the page said
    /// "No user accounts yet" to the SuperAdmin for as long as sign-in and the fetch took.
    /// </summary>
    private bool _loading = true;
    private string _search = string.Empty;

    /// <summary>Off by default: a former member is almost never what somebody came here for.</summary>
    private bool _includeFormer;

    /// <summary>How many the box is hiding, so an empty search can say why.</summary>
    private int _formerCount;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsSuperAdmin || UserState.IsImpersonating)
            NavManager.NavigateTo(Ben.Web.Website.Library.Kit.SignInLink.ForRefusal(NavManager, UserState));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
            await LoadAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// One row of the grid: the account, and what the sign-in table knows about it.
    /// </summary>
    /// <remarks>
    /// <para>A row type rather than two more fields on <see cref="AppUserRecord"/>. That record is
    /// read across the site and by the phone; carrying a last-sign-in and a count on it would put
    /// a subquery on every one of those reads to answer a question this one screen asks.</para>
    ///
    /// <para>The pass-through properties exist so the columns that were here before keep sorting
    /// on a plain field name. Sorting a Telerik column needs a field on the bound item, and
    /// <c>Field="User.DisplayName"</c> would have moved every existing column onto a nested path
    /// to add two new ones.</para>
    /// </remarks>
    private sealed record AdminUserRow(AppUserRecord User, DateTime? LastSignInUtc, int SignInCount)
    {
        public Guid      Id               => User.Id;
        public string?   DisplayName      => User.DisplayName;
        public string?   FullName         => User.FullName;
        public DateTime  DateCreated      => User.DateCreated;
        public bool      IsEmailConfirmed => User.IsEmailConfirmed;
    }

    private IReadOnlyList<AdminUserRow> _rows = [];

    private async Task LoadAsync()
    {
        _loading     = true;
        _usersResult = await AdminClient.GetAllUsersAsync();
        _users       = _usersResult.Items;
        _formerCount = _users.Count(u => u.DateClosed is not null);
        ApplyFilters();

        // A refusal here is NOT a refusal of the page. The grid's job is the accounts; the
        // sign-in figures are an addition to it, and losing them should cost two columns rather
        // than the screen — the same rule the dashboard follows for its sign-in panels. Every row
        // then reads "Never", which is honest about what this page can currently see.
        var signIns = await AdminClient.GetUserSignInSummaryAsync();
        _signIns = signIns.Items.ToDictionary(s => s.AppUserId);

        BuildRows();
        _loading     = false;
    }

    private Dictionary<Guid, Ben.Service.Models.Admin.UserSignInSummary> _signIns = [];

    /// <summary>Re-pairs the visible accounts with their sign-in figures.</summary>
    private void BuildRows()
        => _rows =
        [
            .. _filtered.Select(u => _signIns.TryGetValue(u.Id, out var s)
                ? new AdminUserRow(u, s.LastUtc, s.Count)
                // Absent from the summary means no successful sign-in has ever been recorded for
                // this account — the endpoint returns rows only for accounts that have one.
                : new AdminUserRow(u, null, 0))
        ];

    /// <summary>
    /// The one place the list is narrowed. Both rules, every time.
    /// </summary>
    /// <remarks>
    /// There used to be three assignments to <c>_filtered</c> — search, clear, and load — which is
    /// three chances for a second rule to be applied to two of them. Adding the former-member rule
    /// to that shape would have meant closed accounts reappearing whenever somebody pressed Clear.
    /// </remarks>
    private void ApplyFilters()
    {
        IEnumerable<AppUserRecord> rows = _users;

        if (!_includeFormer) rows = rows.Where(u => u.DateClosed is null);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim().ToLowerInvariant();
            rows = rows.Where(u => (u.DisplayName?.ToLowerInvariant().Contains(q) ?? false)
                                || (u.Email?.ToLowerInvariant().Contains(q) ?? false)
                                || (u.UserName?.ToLowerInvariant().Contains(q) ?? false));
        }

        _filtered = rows.ToList();
        BuildRows();
    }

    private void ApplySearch() => ApplyFilters();

    private void ClearSearch()
    {
        _search = string.Empty;
        ApplyFilters();
    }

    private void OnIncludeFormerChanged(bool include)
    {
        _includeFormer = include;
        ApplyFilters();
    }

    private void ViewUser(AppUserRecord user)
        => NavManager.NavigateTo($"/admin/users/{user.Id}");

    /// <summary>
    /// Opens the delete screen with this account already chosen.
    /// </summary>
    /// <remarks>
    /// Deliberately a navigation rather than a confirm dialog. What deleting somebody destroys and
    /// what it leaves behind is several paragraphs and a dozen counts, and none of it fits in a
    /// box people click through. Deleting your own account from here is refused by the server too;
    /// saying so at the click saves the trip.
    /// </remarks>
    private void DeleteUser(AppUserRecord user)
    {
        if (user.Id == UserState.UserId)
        {
            _errorMessage = "Delete your own account from your profile, not from here.";
            return;
        }
        _errorMessage = null;
        NavManager.NavigateTo($"/admin/delete-user/{user.Id}");
    }

    private async Task Impersonate(AppUserRecord user)
    {
        if (user.Id == UserState.UserId)
        {
            _errorMessage = "You cannot impersonate yourself.";
            return;
        }
        _errorMessage = null;

        var ok = await AdminClient.ImpersonateUserAsync(user.Id, user.Email ?? string.Empty);
        if (ok)
            NavManager.NavigateTo("/");
        else
            _errorMessage = $"Failed to impersonate {user.Email}.";
    }
}
