@namespace Ben.Web.Website.Library.User
@inject IBenAdminClient AdminClient
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h6 class="card-title">Web links<HelpLink Slug="your-profile" Anchor="what-public-means" /></h6>
                <p class="text-secondary small mb-0">
                    Your own site, a channel, a social profile. Private unless you mark one public.
                </p>
            </div>
            @if (!_showForm)
            {
                <button type="button" class="btn btn-primary" @onclick="BeginCreate"><BenIcon Name="plus" Class="me-1" />Add</button>
            }
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mt-3 mb-0">@_error</div>
        }

        @if (_loading)
        {
            <div class="text-secondary small mt-3">Loading…</div>
        }
        else
        {
            @if (_rowsResult.Failed)
            {
                @* Somebody shown an empty list adds a duplicate of what is already there. *@
                <BenListState TItem="MyLinkRecord" Result="@_rowsResult" OnRetry="@LoadAsync" />
            }
            else if (_rows.Count == 0 && !_showForm)
            {
                <p class="text-secondary small fst-italic mt-3 mb-0">No links yet.</p>
            }

            @foreach (var row in _rows)
            {
                <div class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center gap-2">
                    <div class="text-truncate">
                        <span class="fw-semibold">@(string.IsNullOrWhiteSpace(row.DisplayText) ? row.LinkUrl : row.DisplayText)</span>
                        <span class="badge bg-secondary ms-2">@TypeName(row.UserLinkTypeId)</span>
                        @if (row.IsPublic)
                        {
                            <span class="badge bg-info text-dark ms-1">Public</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.DisplayText))
                        {
                            <span class="d-block text-secondary small text-truncate">@row.LinkUrl</span>
                        }
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                        <button type="button" class="btn btn-link text-decoration-none btn-sm" @onclick="@(() => BeginEdit(row))" title="Edit"><BenIcon Name="edit-2" /></button>
                        <button type="button" class="btn btn-link text-decoration-none btn-sm" @onclick="@(() => _deleteTarget = row)" title="Delete"><BenIcon Name="trash-2" /></button>
                    </div>
                </div>
            }

            @if (_showForm)
            {
                <div class="border-top pt-3 mt-3">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small mb-1" for="mylinkscard-address-8fc8">Address</label>
                            <input id="mylinkscard-address-8fc8" class="form-control" maxlength="500" placeholder="https://example.com"
                                   value="@_formUrl"
                                   @oninput="@(e => _formUrl = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="col-sm-7">
                            <label class="form-label small mb-1" for="mylinkscard-label-optional-2c98">Label (optional)</label>
                            <input id="mylinkscard-label-optional-2c98" class="form-control" maxlength="200" placeholder="My site"
                                   value="@_formText"
                                   @oninput="@(e => _formText = e.Value?.ToString() ?? string.Empty)" />
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small mb-1" for="mylinkscard-type-291e">Type</label>
                            <select id="mylinkscard-type-291e" class="form-select" value="@_formTypeId"
                                    @onchange="@(e => _formTypeId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty)">
                                @foreach (var t in _types)
                                {
                                    <option value="@t.Id" selected="@(t.Id == _formTypeId)">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="link-public"
                                       checked="@_formIsPublic"
                                       @onchange="@(e => _formIsPublic = (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="link-public">Public</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(!(!_saving))">
                            @(_saving ? "Saving…" : "Save")
                        </button>
                        <button type="button" class="btn btn-link text-decoration-none" @onclick="@(() => { _showForm = false; _error = null; })">Cancel</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (_deleteTarget is not null)
{
    <BenModal Visible="true" Title="Delete link" Size="sm">
    <ChildContent>
            <p>Remove <strong>@_deleteTarget.LinkUrl</strong> from your profile?</p>
            <div class="dialog-footer-actions d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-link text-decoration-none" @onclick="@(() => _deleteTarget = null)">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
            </div>
        </ChildContent>
</BenModal>
}

@code {
    private List<MyLinkRecord> _rows = new();
    private LoadResult<MyLinkRecord> _rowsResult;
    private IReadOnlyList<UserLinkTypeRecord> _types = Array.Empty<UserLinkTypeRecord>();
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private bool  _showForm;
    private Guid? _editId;
    private string _formUrl  = string.Empty;
    private string _formText = string.Empty;
    private Guid  _formTypeId;
    private bool  _formIsPublic;

    private MyLinkRecord? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        _types = (await AdminClient.GetUserLinkTypesAsync()).Items;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rowsResult = await AdminClient.GetMyLinksAsync();
        _rows       = [.. _rowsResult.Items];
        _loading = false;
    }

    private string TypeName(Guid id) => _types.FirstOrDefault(t => t.Id == id)?.Name ?? "Other";

    private void BeginCreate()
    {
        if (_types.Count == 0)
        {
            _error = "No link types have been set up yet. Ask an administrator to add some before adding a link.";
            return;
        }

        _editId = null;
        _formUrl = string.Empty;
        _formText = string.Empty;
        _formTypeId = _types.FirstOrDefault()?.Id ?? Guid.Empty;
        _formIsPublic = false;
        _error = null;
        _showForm = true;
    }

    private void BeginEdit(MyLinkRecord row)
    {
        _editId = row.Id;
        _formUrl = row.LinkUrl;
        _formText = row.DisplayText ?? string.Empty;
        _formTypeId = row.UserLinkTypeId;
        _formIsPublic = row.IsPublic;
        _error = null;
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formUrl))
        {
            _error = "Enter a web address.";
            return;
        }

        _saving = true;
        _error = null;

        var request = new UpsertMyLinkRequest(
            _formTypeId, _formUrl.Trim(),
            string.IsNullOrWhiteSpace(_formText) ? null : _formText.Trim(),
            _formIsPublic);

        var result = _editId is null
            ? await AdminClient.CreateMyLinkAsync(request)
            : await AdminClient.UpdateMyLinkAsync(_editId.Value, request);

        _saving = false;

        if (result is null)
        {
            // The server rejects anything that isn't an absolute http/https address, which is by
            // far the likeliest reason to land here — say so rather than "something went wrong".
            _error = "That could not be saved. Web addresses need to start with http:// or https://.";
            return;
        }

        _showForm = false;
        await LoadAsync();
    }

    private async Task DeleteConfirmedAsync()
    {
        var target = _deleteTarget;
        _deleteTarget = null;
        if (target is null) return;

        if (!await AdminClient.DeleteMyLinkAsync(target.Id))
        {
            _error = "That could not be deleted.";
            return;
        }

        await LoadAsync();
    }
}
