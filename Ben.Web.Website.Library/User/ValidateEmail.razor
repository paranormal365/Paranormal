@page "/validate-email/{Token}"
@namespace Ben.Web.Website.Library.User

@inject IBenAdminClient AdminClient

@* Deliberately not auth-gated — no WaitUntilAuthReadyAsync, no AuthorizeView. The person
   confirming an address is often reading mail on a different device from the one they signed in
   on, and holding the token is the whole credential. *@

<PageTitle>Confirm your email address</PageTitle>

<div class="container-fluid px-3 py-5" style="max-width:520px; margin:auto;">
    <div class="card">
        <div class="card-body">

            @if (_loading)
            {
                <BenLoaderOverlay Visible="true" Text="Checking the link…" />
            }
            else if (_confirmed)
            {
                <h5 class="mb-2">Address confirmed</h5>
                <p class="text-secondary mb-0">
                    <strong>@_info?.MaskedEmail</strong> is confirmed. You can now mark it public
                    on your profile if you want people to be able to reach you at it.
                </p>
            }
            else if (_info is null)
            {
                <h5 class="mb-2">We can't find that link</h5>
                <p class="text-secondary mb-0">
                    It may be incomplete, mistyped, or already used. Sign in, open <em>My Profile</em>
                    and send yourself a fresh confirmation link.
                </p>
            }
            else if (_info.IsExpired)
            {
                <h5 class="mb-2">This link has expired</h5>
                <p class="text-secondary mb-0">
                    Confirmation links last seven days. Sign in, open <em>My Profile</em> and send
                    yourself a new one.
                </p>
            }
            else
            {
                <h5 class="mb-2">Confirm your email address</h5>
                <p class="text-secondary">
                    Press the button to confirm that <strong>@_info.MaskedEmail</strong> is yours.
                </p>

                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2 small">@_error</div>
                }

                <button type="button" class="btn btn-primary" @onclick="ConfirmAsync" disabled="@(!(!_confirming))">
                    @(_confirming ? "Confirming…" : "Confirm")
                </button>
            }

        </div>
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private EmailValidationInfoRecord? _info;
    private bool _loading = true;
    private bool _confirming;
    private bool _confirmed;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _info = await AdminClient.GetEmailValidationInfoAsync(Token);
        _loading = false;
    }

    private async Task ConfirmAsync()
    {
        _confirming = true;
        _error = null;

        var ok = await AdminClient.ConfirmEmailValidationAsync(Token);

        _confirming = false;

        if (!ok)
        {
            _error = "That didn't work. The link may have expired or already been used — send yourself a new one from your profile.";
            return;
        }

        _confirmed = true;
    }
}
