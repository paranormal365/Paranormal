@using Ben.Web.Services
@inject IBenAdminClient AccountClient

@*
    Password, on the profile's Security tab, beside two-step sign-in.

    The panel's whole reason to exist is the account that has NO password: one created by signing
    in with Microsoft (item 142 — Ben's own production account). For that account the form asks
    for no "current password", because there is none to ask for — the signed-in session is the
    proof. For an account that has one, this is an ordinary change-password form.
*@

<div class="card">
    <div class="card-body">

        <div class="mb-2">
            <h5 class="mb-1">Password</h5>
            @if (_hasPassword is null)
            {
                <p class="text-secondary small mb-0">Checking…</p>
            }
            else if (_hasPassword == false)
            {
                <p class="text-secondary small mb-0">
                    Your account signs in with Microsoft and has no password. Adding one lets you
                    also sign in directly with your email — Microsoft sign-in keeps working either way.
                </p>
            }
            else
            {
                <p class="text-secondary small mb-0">Change the password you sign in with.</p>
            }
        </div>

        @if (_hasPassword is not null)
        {
            @if (_saved)
            {
                <div class="alert alert-success py-2">
                    @(_hasPassword == false ? "Password set — you can sign in with it now." : "Password changed.")
                </div>
            }

            @if (_hasPassword == true)
            {
                <div class="mb-2">
                    <label class="form-label" for="pw-current">Current password</label>
                    <input id="pw-current" type="password" class="form-control" style="max-width:22rem"
                           autocomplete="current-password" @bind="_currentPassword" />
                </div>
            }
            <div class="mb-2">
                <label class="form-label" for="pw-new">New password</label>
                <input id="pw-new" type="password" class="form-control" style="max-width:22rem"
                       autocomplete="new-password" @bind="_newPassword" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="pw-confirm">Confirm new password</label>
                <input id="pw-confirm" type="password" class="form-control" style="max-width:22rem"
                       autocomplete="new-password" @bind="_confirmPassword" />
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2">@_error</div>
            }

            <button type="button" class="btn btn-primary" disabled="@_working" @onclick="SaveAsync">
                @(_working ? "Saving…" : _hasPassword == false ? "Add password" : "Change password")
            </button>
        }
    </div>
</div>

@code {
    private bool? _hasPassword;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _working;
    private bool _saved;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _hasPassword = await AccountClient.GetHasPasswordAsync();
    }

    private async Task SaveAsync()
    {
        if (_newPassword.Length == 0) { _error = "Enter a new password."; return; }
        if (_newPassword != _confirmPassword) { _error = "The two passwords don't match."; return; }

        _working = true;
        _error = null;
        _saved = false;

        var failure = await AccountClient.SetPasswordAsync(
            _hasPassword == true ? _currentPassword : null, _newPassword);

        _working = false;

        if (failure is not null)
        {
            _error = failure;
            return;
        }

        _saved = true;
        _hasPassword = true;
        _currentPassword = _newPassword = _confirmPassword = string.Empty;
    }
}
