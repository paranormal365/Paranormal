@page "/profile"
@using Ben.Service.Models.Entities
@using Ben.Service.Models.People
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>My Profile</PageTitle>

@*
    The template's profile idiom: a hero band carrying identity, then tabs.

    The demo this borrows from holds far less than we do — a bio and a few cards — so this is a
    layout adoption rather than a page swap. Ours carries two photos with their two-key consent,
    four kinds of contact detail with their own visibility rules, and an investigation history.
    Dropping those into a layout built for fewer of them would have produced one very long column,
    which is what this page already was.

    Tabs, because most visits here are to change ONE thing. The map in particular earns its own
    tab rather than a place in the scroll: it loads a JS module and geocoded pins, and nobody
    coming to fix a typo in their name should pay for that.
*@

<div class="container-fluid py-3" style="max-width:1100px;">

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert alert-success py-2">Saved.</div>
    }

    @if (_profile is null)
    {
        <p class="text-secondary">Loading…</p>
    }
    else
    {
        @* ── Hero band ──────────────────────────────────────────────────────
           Identity at a glance: the photo, the name, the sign-in address. The photo shown here is
           whichever one exists, preferring the public: it is the picture other people see, so the
           hero should show what they show. *@
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap align-items-center gap-3">
                <img src="@(HeroPhotoSrc ?? BlankAvatar)" alt=""
                     class="rounded-circle border flex-shrink-0"
                     style="width:96px;height:96px;object-fit:cover;" />

                <div class="min-w-0">
                    <h3 class="mb-1">@(string.IsNullOrWhiteSpace(_displayName) ? "Your profile" : _displayName)</h3>
                    <div class="text-secondary small">@_profile.Email</div>

                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @* Chips, as the template's hero has — but each says something true about
                           this account rather than decorating it. *@
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                            @(_profile.PublicPhoto is null ? "No public photo" : "Public photo set")
                        </span>
                        @if (_profile.PrivatePhoto is not null)
                        {
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis">
                                @(_shareWithClients ? "Private photo shared with clients" : "Private photo, not shared")
                            </span>
                        }
                    </div>
                </div>

                <div class="ms-auto d-flex gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="/my-investigations">My investigations</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/my-cases">My cases</a>
                </div>
            </div>
        </div>

        <BenTabs>
            <BenTab Title="About">
                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Name</h6>
                                <p class="text-secondary small">
                                    Shown wherever your account appears — case notes, messages, member lists.
                                    Your sign-in address (@_profile.Email) isn't changed by this.
                                </p>
                                <div class="d-flex gap-2 align-items-start">
                                    @* Plain input rather than TelerikTextBox: Telerik inputs bind on blur here,
                                       which loses the last edit when the user clicks Save directly. *@
                                    <input class="form-control" style="max-width:340px;" maxlength="100"
                                           placeholder="Your name" value="@_displayName"
                                           @oninput="@(e => _displayName = e.Value?.ToString() ?? string.Empty)" />
                                </div>

                                @* Legal name. Required, and separate from the display name above:
                                   a person may go by a nickname here and still be Margaret on a
                                   case report. Accounts created before these fields existed had
                                   theirs guessed by splitting the display name, so this is also
                                   where somebody corrects a guess that got it wrong. *@
                                <hr class="my-3" />
                                <h6 class="card-title mb-1">Your real name</h6>
                                <p class="text-secondary small">
                                    Used on case paperwork and reports. Not shown to other members in place of
                                    your display name.
                                </p>
                                <div class="row g-2" style="max-width:520px;">
                                    <div class="col-sm-6">
                                        <label class="form-label small" for="profile-first">First name</label>
                                        <input id="profile-first" class="form-control" maxlength="100"
                                               placeholder="First name" value="@_firstName"
                                               @oninput="@(e => _firstName = e.Value?.ToString() ?? string.Empty)" />
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label small" for="profile-last">Last name</label>
                                        <input id="profile-last" class="form-control" maxlength="100"
                                               placeholder="Last name" value="@_lastName"
                                               @oninput="@(e => _lastName = e.Value?.ToString() ?? string.Empty)" />
                                    </div>
                                </div>

                                @if (_nameError is not null)
                                {
                                    <div class="alert alert-danger py-2 mt-2 mb-0">@_nameError</div>
                                }

                                <button type="button" class="btn btn-primary mt-3" @onclick="SaveNameAsync" disabled="@_saving">
                                    @(_saving ? "Saving…" : "Save")
                                </button>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Public photo</h6>
                                <p class="text-secondary small">
                                    Anyone can see this one, including visitors to public case pages.
                                </p>
                                @PhotoSlot(_profile.PublicPhoto, isPublic: true)
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">Private photo<HelpLink Slug="your-profile" Anchor="who-sees-your-private-photo" /></h6>
                                <p class="text-secondary small">
                                    Shown only to people you actually work with — never on public pages.
                                </p>
                                @PhotoSlot(_profile.PrivatePhoto, isPublic: false)

                                <hr />

                                <div class="d-flex align-items-start gap-2">
                                    <input type="checkbox" class="form-check-input mt-1" id="share-private"
                                           checked="@_shareWithClients"
                                           @onchange="@(e => ToggleShareAsync((bool)(e.Value ?? false)))" />
                                    <label for="share-private" class="mb-0">
                                        Show my private photo to clients of the groups I work with
                                        <span class="d-block text-secondary small">
                                            Clients see a face rather than a name alone. Your group has to allow
                                            this too — both of you decide, not just one.
                                        </span>
                                    </label>
                                </div>

                                @* An opt-in that silently does nothing is worse than no opt-in: say so plainly
                                   rather than letting the user believe they've shared something they haven't. *@
                                @if (_shareWithClients && !_profile.AnyOrgAllowsPrivatePhotoSharing)
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0 small">
                                        You've turned this on, but none of your groups currently allow member
                                        photos to be shown to clients — so nothing is being shared yet. It will
                                        take effect if a group turns it on.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </BenTab>

            <BenTab Title="Contact">
                @* Each card loads and saves on its own — one slow lookup or one failed save has no
                   business blocking the rest of the page. *@
                <div class="row g-3">
                    <div class="col-lg-6">
                        <MyEmailsCard />
                        <MyAddressesCard />
                    </div>
                    <div class="col-lg-6">
                        <MyPhonesCard />
                        <MyLinksCard />
                    </div>
                </div>
            </BenTab>

            <BenTab Title="Where you've been">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">Where you've been<HelpLink Slug="your-profile" Anchor="your-investigation-map" /></h6>
                        <p class="text-secondary small">
                            The investigations you have actually attended. Click a pin to open one.
                        </p>

                        @if (_mapLoading)
                        {
                            <p class="text-secondary small mb-0">Loading your investigations…</p>
                        }
                        else if (_attendedPins.Any(p => p.Latitude.HasValue))
                        {
                            <InvestigationsMap Pins="@_attendedPins" Height="420px" OnPinClicked="@OpenInvestigation" />
                        }
                        else
                        {
                            @* Says which of the two reasons applies. "No map" reads as broken when
                               the real answer is "you have not been on one yet". *@
                            <p class="text-secondary small mb-2">
                                @(_attendedPins.Count == 0
                                    ? "You haven't attended an investigation yet — once you do, it appears here."
                                    : "The investigations you've attended don't have map locations recorded.")
                            </p>
                            <a class="btn btn-outline-primary btn-sm" href="/my-investigations">My investigations</a>
                        }
                    </div>
                </div>
            </BenTab>

            @* Security is its own tab rather than a card under About: it is where somebody goes
               deliberately, and mixing "your photo" with "how you sign in" makes both harder to
               find. *@
            <BenTab Title="Security">
                <div class="row g-3">
                    <div class="col-lg-8">
                        <TwoFactorPanel />
                    </div>
                </div>
            </BenTab>
        </BenTabs>
    }
</div>

@code {
    private MyProfileRecord? _profile;
    private string _displayName = string.Empty;
    private string _firstName   = string.Empty;
    private string _lastName    = string.Empty;
    private string? _nameError;
    private bool   _shareWithClients;
    private bool   _saving;
    private bool   _saved;
    private string? _error;

    // Slot currently uploading, so only that card shows a spinner.
    private bool? _uploadingSlot;

    /// <summary>
    /// Rendered image sources, keyed by upload-file id.
    /// </summary>
    /// <remarks>
    /// These are data URIs fetched through the authenticated client rather than
    /// <c>GetFileDownloadUrl</c>. A browser loading &lt;img src="…/api/upload-files/{id}/download"&gt;
    /// sends no bearer token, so the download endpoint sees an anonymous caller: the *public*
    /// photo happens to load anyway, and the private one 401s and renders as a broken image. That
    /// asymmetry is worse than an outright failure — the page looks correct until someone sets a
    /// private photo. Fetching the bytes server-side sidesteps it and is cheap for two small
    /// avatars on one page. U3's avatar endpoint replaces this with something cacheable that other
    /// pages can use too.
    /// </remarks>
    private readonly Dictionary<Guid, string> _previews = [];

    // ── Hero band ─────────────────────────────────────────────────────────────

    /// <summary>
    /// A 1×1 transparent PNG, so the hero's circle keeps its shape before a photo exists.
    /// </summary>
    /// <remarks>
    /// Inline rather than a file: an &lt;img&gt; with no src draws a broken-image glyph in most
    /// browsers, and a placeholder served from wwwroot is a request to make the page look
    /// unfinished slightly faster.
    /// </remarks>
    private const string BlankAvatar =
        "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=";

    /// <summary>
    /// The photo for the hero: public first, then private.
    /// </summary>
    /// <remarks>
    /// The hero shows what other people see, and the public photo is the one most of them get. The
    /// private one is the fallback only because a face is more useful than an empty circle to the
    /// person looking at their own profile — it is never shown to anyone else from here.
    /// </remarks>
    private string? HeroPhotoSrc
    {
        get
        {
            var photo = _profile?.PublicPhoto ?? _profile?.PrivatePhoto;
            return photo is not null && _previews.TryGetValue(photo.UploadFileId, out var src)
                ? src
                : null;
        }
    }

    // ── Investigation map ─────────────────────────────────────────────────────

    private List<AttendedInvestigationItem> _attended = [];
    private List<InvestigationMapPin> _attendedPins = [];
    private bool _mapLoading = true;

    /// <summary>
    /// Loads the attended investigations behind the map tab.
    /// </summary>
    /// <remarks>
    /// Failures are swallowed and leave an empty list. The rest of this page is a person's own
    /// account settings; a history map that cannot be drawn must not stop them changing their
    /// name. Same reasoning as the identical call on MyInvestigations.
    /// </remarks>
    private async Task LoadMapAsync()
    {
        try
        {
            _attended = (await AdminClient.GetAttendedInvestigationsAsync()).Items.ToList();
            _attendedPins = _attended
                .Select(a => new InvestigationMapPin(
                    a.InvestigationId, a.Title, a.Latitude, a.Longitude, IsPast: true))
                .ToList();
        }
        catch
        {
            _attended = [];
            _attendedPins = [];
        }
        finally
        {
            _mapLoading = false;
        }
    }

    /// <summary>
    /// Opens the case an investigation belongs to — the same destination MyInvestigations uses
    /// for the same click, so a pin means the same thing on both pages.
    /// </summary>
    /// <remarks>
    /// The rows are kept alongside the pins because the pin itself carries only an id and a title;
    /// the organization and case ids needed to build the URL live on the attendance record.
    /// </remarks>
    private void OpenInvestigation(Guid investigationId)
    {
        var row = _attended.FirstOrDefault(a => a.InvestigationId == investigationId);
        if (row?.CaseId is not { } caseId) return;
        NavManager.NavigateTo($"/organizations/{row.OrganizationId}/cases/{caseId}?tab=investigations");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _profile is not null) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) return;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            _profile = await AdminClient.GetMyProfileAsync();
            if (_profile is not null)
            {
                _displayName      = _profile.DisplayName ?? string.Empty;
                _firstName        = _profile.FirstName ?? string.Empty;
                _lastName         = _profile.LastName ?? string.Empty;
                _shareWithClients = _profile.SharePrivatePhotoWithClients;
                await LoadPreviewsAsync();
                await LoadMapAsync();
            }
        }
        catch { _error = "Couldn't load your profile. Please refresh."; }
    }

    private async Task LoadPreviewsAsync()
    {
        foreach (var photo in new[] { _profile?.PublicPhoto, _profile?.PrivatePhoto })
        {
            if (photo is null || _previews.ContainsKey(photo.UploadFileId)) continue;
            try
            {
                var file = await AdminClient.GetFileDataAsync(photo.UploadFileId);
                if (file is { } f)
                    _previews[photo.UploadFileId] =
                        $"data:{f.ContentType};base64,{Convert.ToBase64String(f.Data)}";
            }
            catch { /* a photo that won't load isn't worth failing the whole page over */ }
        }
    }

    private async Task SaveNameAsync()
    {
        _saving = true; _error = null; _saved = false; _nameError = null;

        // Checked here as well as on the server so the person gets the answer without a round
        // trip. The server refuses an empty value too — this is the courtesy, that is the rule.
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            _nameError = "First and last name are both required.";
            _saving = false;
            return;
        }

        try
        {
            // Only the names are sent. The consent field stays null so saving a name can never
            // change what you've agreed to share.
            var updated = await AdminClient.UpdateMyProfileAsync(
                new UpdateMyProfileRequest(_displayName, SharePrivatePhotoWithClients: null,
                                           FirstName: _firstName, LastName: _lastName));
            if (updated is null) { _error = "Couldn't save your name."; return; }
            _profile = updated;
            _saved = true;
        }
        catch { _error = "Couldn't save your name."; }
        finally { _saving = false; }
    }

    private async Task ToggleShareAsync(bool value)
    {
        _shareWithClients = value;          // optimistic, so the checkbox doesn't lag the click
        _error = null; _saved = false;
        try
        {
            var updated = await AdminClient.UpdateMyProfileAsync(
                new UpdateMyProfileRequest(null, SharePrivatePhotoWithClients: value));
            if (updated is null)
            {
                _shareWithClients = !value;
                _error = "Couldn't save that setting.";
                return;
            }
            _profile = updated;
            _shareWithClients = updated.SharePrivatePhotoWithClients;
        }
        catch
        {
            // Consent must never appear granted when the server didn't record it.
            _shareWithClients = !value;
            _error = "Couldn't save that setting.";
        }
    }

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e, bool isPublic)
    {
        _uploadingSlot = isPublic; _error = null; _saved = false;
        try
        {
            var file = e.File;
            var typeId = await AdminClient.GetProfilePhotoFileTypeIdAsync();
            if (typeId is null) { _error = "Photo uploads aren't configured."; return; }

            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxPhotoBytes).CopyToAsync(ms);

            var uploaded = await AdminClient.UploadUserFileAsync(
                typeId.Value, UserState.UserId ?? Guid.Empty,
                file.Name, file.ContentType, ms.ToArray(),
                description: null, isPublic: isPublic);
            if (uploaded is null)
            {
                _error = "Upload failed — photos must be JPEG, PNG, GIF or WebP.";
                return;
            }

            // Attaching to the slot is what makes it the active photo; the upload alone doesn't.
            var photo = await AdminClient.SetMyPhotoAsync(
                new SetMyPhotoRequest(uploaded.Id, isPublic, AltText: _displayName));
            if (photo is null) { _error = "Couldn't set that photo."; return; }

            _profile = await AdminClient.GetMyProfileAsync();
            await LoadPreviewsAsync();
            _saved = true;
        }
        catch (IOException)
        {
            _error = $"That image is too large — the limit is {MaxPhotoBytes / (1024 * 1024)} MB.";
        }
        catch { _error = "Upload failed. Please try again."; }
        finally { _uploadingSlot = null; }
    }

    private async Task RemovePhotoAsync(Guid photoId)
    {
        _error = null; _saved = false;
        try
        {
            if (!await AdminClient.DeleteMyPhotoAsync(photoId))
            {
                _error = "Couldn't remove that photo.";
                return;
            }
            _profile = await AdminClient.GetMyProfileAsync();
            await LoadPreviewsAsync();
        }
        catch { _error = "Couldn't remove that photo."; }
    }

    /// <summary>
    /// Deliberately generous — this is a profile picture, not evidence, and the site has no
    /// upload caps by design. It exists only so a mis-selected video gives a clear message
    /// instead of a stalled request.
    /// </summary>
    private const long MaxPhotoBytes = 25L * 1024 * 1024;

    private RenderFragment PhotoSlot(AppUserPhotoRecord? photo, bool isPublic) => __builder =>
    {
        <div class="d-flex align-items-center gap-3 flex-wrap">
            @if (photo is not null && _previews.TryGetValue(photo.UploadFileId, out var src))
            {
                <img src="@src"
                     alt="@(photo.AltText ?? "Profile photo")"
                     class="rounded-circle border"
                     style="width:88px;height:88px;object-fit:cover;" />
            }
            else if (photo is not null)
            {
                <div class="rounded-circle border d-flex align-items-center justify-content-center text-secondary"
                     style="width:88px;height:88px;">
                    <span class="small">…</span>
                </div>
            }
            else
            {
                <div class="rounded-circle border d-flex align-items-center justify-content-center text-secondary"
                     style="width:88px;height:88px;">
                    <span class="small">None</span>
                </div>
            }

            <div class="d-flex flex-column gap-2">
                <InputFile OnChange="@(e => OnPhotoSelectedAsync(e, isPublic))"
                           class="form-control form-control-sm" style="max-width:280px;"
                           accept="image/jpeg,image/png,image/gif,image/webp" />
                @if (_uploadingSlot == isPublic)
                {
                    <span class="text-secondary small">Uploading…</span>
                }
                else if (photo is not null)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => RemovePhotoAsync(photo.Id))">Remove</button>
                }
            </div>
        </div>
    };
}
