@page "/my-requests/new"
@page "/my-requests/{Id:guid}/edit"
@using Ben.Data.Common.Enums
@using Ben.Service.Models.Entities
@using Ben.Web.Services
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit

<PageTitle>Submit an Investigation Request</PageTitle>

@*
    The request runs signed out (site evaluation 2026-09-06, phase 1). It used to open with a
    sign-in wall: a stranger with something happening in their house had to make an account, wait
    for a confirmation email, sign in and finish onboarding before reaching step 1. Nothing in the
    request needs an account until a group wants to talk back, so the account is made at Submit,
    from what they typed. A signed-out draft lives in the browser only — see CaptureDraft.
*@
<div class="container py-4" style="max-width:820px;">
    <h2 class="mb-1">Request an Investigation</h2>
    <p class="text-secondary mb-4">
        Tell us about the activity you've experienced. Your request will be reviewed by
        paranormal investigation organizations in your area.
    </p>

    @* ── Step progress bar ────────────────────────────────────────────────── *@
    <div class="d-flex align-items-center gap-2 mb-4">
        @for (int i = 1; i <= 4; i++)
        {
            var step = i;
            var isCurrent = step == _step;
            var isDone    = step < _step;
            <div class="d-flex align-items-center @(i < 4 ? "flex-grow-1" : "")">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width:32px;height:32px;flex-shrink:0;font-size:0.85rem;
                            background:@(isCurrent ? "var(--kendo-color-primary)" : isDone ? "#198754" : "#dee2e6");
                            color:@(isCurrent || isDone ? "#fff" : "#6c757d");">
                    @if (isDone) { <span>✓</span> } else { <span>@step</span> }
                </div>
                @if (i < 4)
                {
                    <div class="flex-grow-1 mx-1" style="height:3px;background:@(isDone ? "#198754" : "#dee2e6");"></div>
                }
            </div>
        }
    </div>
    <div class="d-flex justify-content-between mb-4">
        <small class="@(_step == 1 ? "fw-semibold" : "text-secondary")">Location</small>
        <small class="@(_step == 2 ? "fw-semibold" : "text-secondary")">About You</small>
        <small class="@(_step == 3 ? "fw-semibold" : "text-secondary")">Your Experiences</small>
        <small class="@(_step == 4 ? "fw-semibold" : "text-secondary")">Find Organizations</small>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @* ── Step 1: Location ─────────────────────────────────────────────────── *@
    @if (_step == 1)
    {
        <div class="card">
            <div class="card-header fw-semibold">Step 1 — Your Location</div>
            <div class="card-body">
                <p class="text-secondary small mb-3">
                    Provide the address of the property you'd like investigated.
                    This will be used to find organizations near you.
                </p>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="req-street1">Street Address <span class="text-danger">*</span></label>
                        <input type="text" id="req-street1" class="form-control" placeholder="123 Main St" @bind="@_streetAddress1" @bind:event="oninput" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="req-street2">Apt / Unit (optional)</label>
                        <input type="text" id="req-street2" class="form-control" placeholder="Apt 4B" @bind="@_streetAddress2" @bind:event="oninput" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label fw-semibold" for="req-city">City <span class="text-danger">*</span></label>
                        <input type="text" id="req-city" class="form-control" @bind="@_city" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" for="req-state">State <span class="text-danger">*</span></label>
                        <input type="text" id="req-state" class="form-control" placeholder="TN" @bind="@_state" @bind:event="oninput" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="req-zip">ZIP Code <span class="text-danger">*</span></label>
                        <input type="text" id="req-zip" class="form-control" placeholder="37201" @bind="@_zipCode" @bind:event="oninput" />
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-secondary" @onclick="GeocodeAddress" disabled="@(!(!_verifying && CanGeocode))"><BenIcon Name="map-pin" Class="me-1" />
                            @(_verifying ? "Looking up…" : "Verify Address")
                        </button>
                        @* W-R1: the button used to give no sign it was working, and Next was
                           allowed without it — the failure surfaced three screens later as
                           "Address not verified", by which point the person had typed everything.
                           It says what it is for, and reports while it runs. *@
                        @if (_verifying)
                        {
                            <span class="ms-3 small text-secondary">
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                Finding this address on the map…
                            </span>
                        }
                        else if (_lat.HasValue)
                        {
                            <span class="ms-3 text-success small">✓ Address verified</span>
                        }
                        @if (_geocodeError is not null)
                        {
                            <div class="text-danger small mt-1">@_geocodeError</div>
                        }
                        <div class="form-text">
                            We look the address up on the map so we can find the groups that work
                            near you. It is never shown on a public page.
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end align-items-center gap-3">
                @if (!_lat.HasValue)
                {
                    <span class="small text-secondary">Verify the address to continue.</span>
                }
                <button type="button" class="btn btn-primary" @onclick="Step1Next" disabled="@(!(!_isBusy && _lat.HasValue))">
                    Next: About You →
                </button>
            </div>
        </div>
    }

    @* ── Step 2: About You ────────────────────────────────────────────────── *@
    @if (_step == 2)
    {
        <div class="card">
            <div class="card-header fw-semibold">Step 2 — About You</div>
            <div class="card-body">
                <p class="text-secondary small mb-3">
                    This information helps organizations understand who is involved.
                    It is kept private and shared only with the organization that accepts your case.
                </p>
                <div class="row g-3">
                    <div class="col-md-6">
                        @* W-S4: onboarding asks "Sex" and this asked "Gender", so a signed-in
                           person answered the same question twice under two names. One question,
                           one word, and prefilled from the profile when there is one. *@
                        <label class="form-label fw-semibold" id="req-gender-label">Gender</label>
                        <BenSelect AriaLabel="Gender" Data="@_genderOptions" @bind-Value="@_gender" TextField="@nameof(GenderOption.Label)" ValueField="@nameof(GenderOption.Value)" Width="100%" />
                        <div class="form-text">Optional. Groups use it only to know who is in the home.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold" for="clientrequestwizard-birth-year-optional-fa78">Birth Year (optional)</label>
                        <input id="clientrequestwizard-birth-year-optional-fa78" type="number" class="form-control" min="1900" max="@(UserState.NowInViewerTimeZone().Year)" step="1" @bind="@_birthYear" @bind:event="oninput" />
                        <div class="form-text">Leave blank if you prefer not to share.</div>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" @onclick="@(() => _step = 1)">← Back</button>
                <button type="button" class="btn btn-primary" @onclick="Step2Next" disabled="@(!(!_isBusy))">
                    Next: Your Experiences →
                </button>
            </div>
        </div>
    }

    @* ── Step 3: Description ──────────────────────────────────────────────── *@
    @if (_step == 3)
    {
        <div class="card">
            <div class="card-header fw-semibold">Step 3 — Your Experiences</div>
            <div class="card-body">
                <p class="text-secondary small mb-3">
                    Describe what you have experienced at this location.
                    Be as detailed as possible — when it started, how often it occurs, who has witnessed it.
                </p>
                <TelerikEditor @bind-Value="@_description" @bind-Value:after="@OnDescriptionChanged"
                               Height="320px"
                               Tools="@_editorTools" />
                @* W-R3: this used to shout in red before anything had been typed. It is a
                   reminder for somebody who has written and deleted, not a greeting. *@
                @if (_descriptionTouched && string.IsNullOrWhiteSpace(StripHtml(_description)))
                {
                    <div class="text-danger small mt-1">A description is required before submitting.</div>
                }
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" @onclick="@(() => _step = 2)">← Back</button>
                <button type="button" class="btn btn-primary" @onclick="Step3Next" disabled="@(!(!_isBusy && !string.IsNullOrWhiteSpace(StripHtml(_description))))">
                    Next: Find Organizations →
                </button>
            </div>
        </div>
    }

    @* ── Step 4: Find & Apply ─────────────────────────────────────────────── *@
    @if (_step == 4)
    {
        <div class="card">
            <div class="card-header fw-semibold">Step 4 — Find Organizations</div>
            <div class="card-body">
                @if (_orgs is null)
                {
                    <BenLoaderOverlay Visible="true" Text="Finding organizations near you…" />
                }
                else if (_orgsResult.Failed)
                {
                    @* The one screen where "no groups near you" ends the whole errand: somebody
                       reporting activity concludes nobody covers their area and stops. *@
                    <BenListState TItem="OrgSearchResult" Result="@_orgsResult" OnRetry="@Step3Next" />
                }
                else if (_orgs.Count == 0)
                {
                    @if (_lat is null || _lon is null)
                    {
                        <div class="alert alert-warning mb-0">
                            <strong>Address not verified.</strong> We couldn't locate your address to find nearby organizations.
                            @* W-R2: this was an href="#" anchor with no preventDefault, so it did
                               nothing at all. A button does what it says. *@
                            <button type="button" class="btn btn-link alert-link p-0 align-baseline"
                                    @onclick="@(() => _step = 1)">Go back and verify your address.</button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            No organizations are currently accepting cases in your area.
                            Check back later or <a href="/my-requests" class="alert-link">save your request as a draft</a>.
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary small mb-3">
                        Select up to <strong>2 organizations</strong> to send your request to.
                        The first to accept will be assigned your case.
                    </p>

                    @* Item 194, Ben's direction: FILTER, don't only tint. A request from this
                       wizard is about somebody's own address — private-residence work — so groups
                       whose plan cannot take it are hidden by default rather than offered and then
                       refused after the pick. The escape hatch is explicit, because a free group
                       can still take a public building and the person may know that is their case. *@
                    @if (_orgs.Any(o => !o.TakesPrivateResidenceCases))
                    {
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="wizard-show-public-only-groups"
                                   checked="@_showGroupsWithoutPrivate"
                                   @onchange="@(e => _showGroupsWithoutPrivate = (bool?)e.Value == true)" />
                            <label class="form-check-label small text-secondary" for="wizard-show-public-only-groups">
                                Also show groups that only investigate public places
                                (@_orgs.Count(o => !o.TakesPrivateResidenceCases) nearby) — they cannot take a case at your home.
                            </label>
                        </div>
                    }

                    @* The filter must never leave a silent empty list: if every nearby group is
                       public-only, say so and name the way forward. An empty list with a checkbox
                       above it is the dead end item 149 made policy against. *@
                    @if (!VisibleOrgs.Any())
                    {
                        <div class="alert alert-warning">
                            <strong>No nearby group can take a case at a private home yet.</strong>
                            The groups near you investigate public places — landmarks, businesses,
                            events. You can tick the box above to see them anyway, or
                            <a href="/my-requests" class="alert-link">save this as a draft</a> and
                            come back: groups add private-residence work as their plans change.
                        </div>
                    }

                    <div class="d-flex flex-column gap-3">
                        @foreach (var org in VisibleOrgs)
                        {
                            var isSelected = _selectedOrgIds.Contains(org.OrganizationId);
                            var canSelect  = isSelected || _selectedOrgIds.Count < 2;
                            <div class="border rounded p-3 @(isSelected ? "border-primary border-2" : "") @(!canSelect ? "opacity-50" : "")"
                                 style="cursor:@(canSelect || isSelected ? "pointer" : "default");"
                                 @onclick="@(() => ToggleOrgSelection(org.OrganizationId, canSelect))">
                                <div class="d-flex align-items-start justify-content-between gap-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" class="form-check-input" checked="@isSelected" disabled />
                                            <strong>@org.Name</strong>
                                            @if (org.IsWithinRange)
                                            {
                                                <span class="badge bg-success">Within range</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Outside range — accepts</span>
                                            }
                                            @if (!org.TakesPrivateResidenceCases)
                                            {
                                                <span class="badge bg-body-secondary text-body-emphasis">Public investigations only</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(org.DisplayLabel))
                                        {
                                            <small class="text-secondary">@org.DisplayLabel</small>
                                        }
                                    </div>
                                    <div class="text-end text-secondary small" style="min-width:80px;">
                                        @org.DistanceFromSearchMiles mi away
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_selectedOrgIds.Count == 0)
                    {
                        <div class="text-danger small mt-2">Select at least one organization.</div>
                    }
                }

                @* ── Who is asking ─────────────────────────────────────────
                   For a signed-out person this is the sign-up, and it is deliberately three
                   fields: no @@name to invent (one is allocated and shown after confirming), no
                   separate first and last name, no second password box. The note below is the
                   promise this whole form asks them to believe, so it is always visible and never
                   behind a link. *@
                @if (!UserState.IsAuthenticated)
                {
                    <hr class="my-4" />
                    <h6 class="fw-semibold mb-1">Who should the group write back to?</h6>
                    <p class="text-secondary small mb-3">
                        This creates your account, so you can follow the request and talk to the
                        group. You'll confirm the email address before anyone can reach you.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="req-name">Your name <span class="text-danger">*</span></label>
                            <input type="text" id="req-name" class="form-control" autocomplete="name"
                                   placeholder="Casey Miller" @bind="@_accountName" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="req-email">Email <span class="text-danger">*</span></label>
                            <input type="email" id="req-email" class="form-control" autocomplete="email"
                                   @bind="@_accountEmail" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="req-password">Choose a password <span class="text-danger">*</span></label>
                            <input type="password" id="req-password" class="form-control" autocomplete="new-password"
                                   @bind="@_accountPassword" @bind:event="oninput" />
                            <div class="form-text">At least 8 characters, with an upper-case letter, a lower-case letter and a digit.</div>
                        </div>
                    </div>
                    <div class="alert alert-secondary small mt-3 mb-0" id="req-privacy-note">
                        Your name, address and what you tell us are shared only with the group you
                        send this to. None of it is public, and none of it is ever sold.
                    </div>
                    <p class="small text-secondary mt-2 mb-0">
                        Already have an account? <a href="/login?returnUrl=/my-requests/new">Sign in first</a>
                        and your details will be filled in for you.
                    </p>
                }
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" @onclick="@(() => _step = 3)">← Back</button>
                <div class="d-flex gap-2">
                    @* Saving a draft on the server needs an account. Signed out, the wizard is
                       already keeping one in this browser, and the button says so rather than
                       offering something it cannot do. *@
                    @if (UserState.IsAuthenticated)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="SaveDraft" disabled="@(!(!_isBusy))">Save as Draft</button>
                    }
                    <button type="button" class="btn btn-primary" @onclick="SubmitRequest" disabled="@(!(!_isBusy && CanSubmit))"><BenIcon Name="check" Class="me-1" />
                        @(_isBusy ? "Submitting…" : "Submit Request")
                    </button>
                </div>
            </div>
        </div>
    }

    @* ── Step 5: Submitted ────────────────────────────────────────────────── *@
    @if (_step == 5)
    {
        <div class="card border-success">
            <div class="card-body text-center py-5">
                <div class="mb-3" style="font-size:3rem;">✓</div>
                <h4 class="text-success">Request Submitted!</h4>
                @if (_signedUpMessage is { } signedUp)
                {
                    @* The signed-out ending. Deliberately the same words whether the address was
                       free or already had an account — the server will not say which, and neither
                       will this page. *@
                    <p class="text-secondary mb-1">@signedUp</p>
                    <p class="text-secondary small">
                        Until you use that link we cannot reach you, so open it as soon as you can.
                    </p>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a class="btn btn-secondary" href="/login">Go to sign in</a>
                    </div>
                }
                else
                {
                    <p class="text-secondary">
                        Your request has been sent to @(_selectedOrgIds.Count == 1 ? "1 organization" : $"{_selectedOrgIds.Count} organizations").
                        You'll be notified once one accepts your case.
                    </p>
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a class="btn btn-secondary" href="/my-requests">View My Requests</a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;

        // W-S4: a signed-in person has answered the gender question at onboarding. Asking it a
        // second time under a different word is what made it two questions.
        if (UserState.IsAuthenticated)
        {
            try
            {
                if (await AdminClient.GetMyProfileAsync() is { Gender: { } g }
                    && g != ClientGender.NotProvided)
                    _gender = g;
            }
            catch { /* an unanswered question is a fine starting point */ }
        }
    }

    // ── State ─────────────────────────────────────────────────────────────────
    private int _step = 1;
    private bool _isBusy;
    private string? _error;
    private Guid? _draftId;

    // Step 1 — location
    private string _streetAddress1 = "";
    private string? _streetAddress2;
    private string _city    = "";
    private string _state   = "";
    private string _zipCode = "";
    private decimal? _lat;
    private decimal? _lon;
    private string? _geocodeError;

    private bool _verifying;

    // Step 2 — about you
    private ClientGender _gender    = ClientGender.NotProvided;
    private int? _birthYear;

    // Step 3 — description
    private string _description = "";

    /// <summary>Whether the description field has ever held anything. See W-R3 in the markup.</summary>
    private bool _descriptionTouched;

    // Step 4 — who is asking, for a signed-out person
    private string _accountName     = "";
    private string _accountEmail    = "";
    private string _accountPassword = "";

    /// <summary>Set when the signed-out submit succeeded — its sentence, and the ending it picks.</summary>
    private string? _signedUpMessage;

    /// <summary>
    /// Enough to send. Signed in it is only the groups; signed out the account fields count too,
    /// because Submit creates the account and there is no second screen to catch a blank one.
    /// </summary>
    private bool CanSubmit =>
        _selectedOrgIds.Count > 0
        && (UserState.IsAuthenticated
            || (_accountName.Trim().Length >= 2
                && _accountEmail.Contains('@')
                && _accountPassword.Length >= 8));

    // Step 4 — org selection
    private List<OrgSearchResult>? _orgs;

    /// <summary>
    /// Whether groups that cannot take private-residence work are shown (item 194).
    /// </summary>
    /// <remarks>
    /// Off by default: this wizard requests an investigation at the person's OWN address, and
    /// offering a group that will be refused later answers a question they did not ask. Turning it
    /// on is a deliberate act, for the person who knows their case is a public building.
    /// </remarks>
    private bool _showGroupsWithoutPrivate;

    /// <summary>The groups actually offered, after the private-work filter.</summary>
    private IEnumerable<OrgSearchResult> VisibleOrgs =>
        _showGroupsWithoutPrivate
            ? _orgs ?? []
            : (_orgs ?? []).Where(o => o.TakesPrivateResidenceCases);
    private LoadResult<OrgSearchResult> _orgsResult;
    private readonly HashSet<Guid> _selectedOrgIds = new();

    // ── Options ───────────────────────────────────────────────────────────────
    private bool CanGeocode =>
        !string.IsNullOrWhiteSpace(_streetAddress1) &&
        !string.IsNullOrWhiteSpace(_city) &&
        !string.IsNullOrWhiteSpace(_state) &&
        !string.IsNullOrWhiteSpace(_zipCode);

    private readonly List<GenderOption> _genderOptions =
    [
        new(ClientGender.NotProvided, "Prefer not to say"),
        new(ClientGender.Male,        "Male"),
        new(ClientGender.Female,      "Female"),
    ];

    private static readonly List<IEditorTool> _editorTools =
    [
        new Telerik.Blazor.Components.Editor.EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.Bold(),
            new Telerik.Blazor.Components.Editor.Italic(),
            new Telerik.Blazor.Components.Editor.Underline()),
        new Telerik.Blazor.Components.Editor.EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.AlignLeft(),
            new Telerik.Blazor.Components.Editor.AlignCenter(),
            new Telerik.Blazor.Components.Editor.AlignRight()),
        new Telerik.Blazor.Components.Editor.EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.UnorderedList(),
            new Telerik.Blazor.Components.Editor.OrderedList()),
        new Telerik.Blazor.Components.Editor.EditorButtonGroup(
            new Telerik.Blazor.Components.Editor.Undo(),
            new Telerik.Blazor.Components.Editor.Redo()),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await UserState.AuthReady;

        if (!UserState.IsAuthenticated)
        {
            if (Id is not null) { NavManager.NavigateTo("/login?returnUrl=/my-requests"); return; }
            await RestoreBrowserDraftAsync();
            StateHasChanged();
            return;
        }

        if (Id is null) return;
        // AuthReady is awaited above, before either branch: a hard nav can reach this pass before
        // OnInitializedAsync's own (interactive-only) await has resolved it, and reading a stale
        // IsAuthenticated=false here would skip the draft load for good — firstRender fires once,
        // so nothing would ever retry it.
        try
        {
            var existing = await AdminClient.GetClientRequestAsync(Id.Value);
            if (existing is null || existing.Status != ClientRequestStatus.Draft)
            {
                NavManager.NavigateTo("/my-requests");
                return;
            }
            _draftId        = existing.Id;
            _streetAddress1 = existing.StreetAddress1;
            _streetAddress2 = existing.StreetAddress2;
            _city           = existing.City;
            _state          = existing.State;
            _zipCode        = existing.ZipCode;
            _lat            = existing.Latitude;
            _lon            = existing.Longitude;
            _gender         = existing.Gender;
            _birthYear      = existing.BirthYear;
            _description    = existing.Description ?? "";
        }
        catch { _error = "Failed to load request."; }
        StateHasChanged();
    }

    // ── Geocoding ─────────────────────────────────────────────────────────────
    private async Task GeocodeAddress()
    {
        _geocodeError = null;
        // Its own flag, not _isBusy: Next reads _isBusy, and sharing one made "verify then click
        // Next" a race with the lookup that had already finished.
        _verifying = true;
        try
        {
            var q = $"{_streetAddress1}, {_city}, {_state} {_zipCode}";
            var result = await AdminClient.SearchGeocodingAsync(q);
            if (result is null)
                _geocodeError = "Address not found. Please check the details and try again.";
            else
            {
                _lat = result.Latitude  ?? _lat;
                _lon = result.Longitude ?? _lon;
            }
        }
        catch { _geocodeError = "We couldn't reach the map service. Try again in a moment."; }
        finally { _verifying = false; }
    }

    // ── Step navigation ───────────────────────────────────────────────────────
    private async Task Step1Next()
    {
        if (string.IsNullOrWhiteSpace(_streetAddress1) ||
            string.IsNullOrWhiteSpace(_city) ||
            string.IsNullOrWhiteSpace(_state) ||
            string.IsNullOrWhiteSpace(_zipCode))
        {
            _error = "Please fill in the required address fields.";
            return;
        }
        if (!_lat.HasValue || !_lon.HasValue)
        {
            // W-R1: this used to be allowed, and the consequence appeared at step 4 as "Address
            // not verified" — three screens after the thing that caused it.
            _error = "Press Verify Address first — we need to place it on the map to find groups near you.";
            return;
        }
        _error = null;
        await SaveDraftSilent();
        _step = 2;
    }

    private async Task Step2Next()
    {
        _error = null;
        await SaveDraftSilent();
        _step = 3;
    }

    /// <summary>Once anything has been written, the empty-field reminder is worth showing again.</summary>
    private void OnDescriptionChanged()
    {
        if (!string.IsNullOrWhiteSpace(StripHtml(_description))) _descriptionTouched = true;
    }

    private async Task Step3Next()
    {
        _descriptionTouched = true;
        if (string.IsNullOrWhiteSpace(StripHtml(_description)))
        {
            _error = "Please describe your experiences before continuing.";
            return;
        }
        _error = null;
        _isBusy = true;
        try
        {
            await SaveDraftSilent();
            // Load nearby orgs using the geocoded coordinates
            if (_lat.HasValue && _lon.HasValue)
            {
                _orgsResult = await AdminClient.SearchOrganizationsAsync(
                    (double)_lat.Value, (double)_lon.Value);
                _orgs = _orgsResult.Items.ToList();
            }
            else
                _orgs = [];
            _step = 4;
        }
        catch { _error = "Failed to load organizations. Please try again."; }
        finally { _isBusy = false; }
    }

    private async Task SaveDraft()
    {
        // Used to navigate away unconditionally even when the save silently failed — the user
        // would leave the wizard believing their draft was saved when it wasn't.
        if (await SaveDraftSilent())
            NavManager.NavigateTo("/my-requests");
        else
            _error = "Failed to save your draft. Please try again.";
    }

    /// <summary>Saves the current draft without navigating. Returns whether it actually succeeded —
    /// callers that proceed regardless (auto-save between wizard steps) can ignore the result, but
    /// anything user-facing (SaveDraft, SubmitRequest) must check it.</summary>
    private async Task<bool> SaveDraftSilent()
    {
        // Signed out there is no server draft to make: the request belongs to nobody until Submit
        // creates the account. What survives a closed tab is the browser copy below.
        if (!UserState.IsAuthenticated)
        {
            await SaveBrowserDraftAsync();
            return true;
        }

        try
        {
            var req = BuildRequest();
            if (_draftId is null)
            {
                var created = await AdminClient.CreateClientRequestAsync(req);
                _draftId = created?.Id;
                return created is not null;
            }
            else
            {
                var updated = await AdminClient.UpdateClientRequestAsync(_draftId.Value, req);
                return updated is not null;
            }
        }
        catch { return false; }
    }

    private async Task SubmitRequest()
    {
        if (!CanSubmit) return;
        _isBusy = true;
        _error  = null;
        try
        {
            if (!UserState.IsAuthenticated)
            {
                await SubmitWithoutAccountAsync();
                return;
            }

            // Ensure the latest edits are saved first — if this silently failed, submitting now
            // would transition a stale server-side draft instead of what the user actually typed.
            if (!await SaveDraftSilent() || _draftId is null)
            {
                _error = "Failed to save request. Please try again.";
                return;
            }

            var result = await AdminClient.SubmitClientRequestAsync(
                _draftId.Value, _selectedOrgIds.ToList());

            if (result is null) { _error = "Submission failed. Please try again."; }
            else { _step = 5; }
        }
        catch (Exception ex) { _error = $"Submission failed: {ex.Message}"; }
        finally { _isBusy = false; }
    }

    /// <summary>
    /// The signed-out submit: the request and the account in one call.
    /// </summary>
    /// <remarks>
    /// The server's answer is the same sentence whether the address was free or already had an
    /// account, and this page passes it through unchanged — anything else here would leak what
    /// the endpoint refuses to say. The browser draft is cleared only on success, so a refusal
    /// leaves everything typed still there.
    /// </remarks>
    private async Task SubmitWithoutAccountAsync()
    {
        var outcome = await AdminClient.SubmitRequestWithoutAccountAsync(new AnonymousClientRequestSubmission(
            StreetAddress1: _streetAddress1.Trim(),
            StreetAddress2: string.IsNullOrWhiteSpace(_streetAddress2) ? null : _streetAddress2.Trim(),
            City:           _city.Trim(),
            State:          _state.Trim(),
            ZipCode:        _zipCode.Trim(),
            Country:        "US",
            Latitude:       _lat,
            Longitude:      _lon,
            Gender:         _gender,
            BirthYear:      _birthYear,
            Description:    string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            OrganizationIds: _selectedOrgIds.ToList(),
            Name:            _accountName.Trim(),
            Email:           _accountEmail.Trim(),
            Password:        _accountPassword));

        if (!outcome.Succeeded)
        {
            _error = outcome.Message;
            return;
        }

        _signedUpMessage = outcome.Message;
        _accountPassword = "";
        await ClearBrowserDraftAsync();
        _step = 5;
    }

    // ── The signed-out draft, in this browser only ───────────────────────────
    //
    // Not on the server: until Submit there is no account to own it, and a server-side anonymous
    // draft store would be a place to write to without signing in. localStorage keeps a closed tab
    // from costing somebody the whole form, which is the only thing it needs to do. The password
    // is deliberately NOT part of it.

    private const string DraftKey = "wizard:client-request";

    private sealed record BrowserDraft(
        int Step, string Street1, string? Street2, string City, string State, string Zip,
        decimal? Lat, decimal? Lon, ClientGender Gender, int? BirthYear, string Description,
        string Name, string Email);

    private async Task SaveBrowserDraftAsync()
    {
        if (!RendererInfo.IsInteractive) return;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DraftKey,
                System.Text.Json.JsonSerializer.Serialize(new BrowserDraft(
                    _step, _streetAddress1, _streetAddress2, _city, _state, _zipCode,
                    _lat, _lon, _gender, _birthYear, _description, _accountName, _accountEmail)));
        }
        catch { /* Draft-keeping is a courtesy; losing one restarts a form, never breaks it. */ }
    }

    private async Task RestoreBrowserDraftAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", DraftKey);
            if (raw is null) return;
            if (System.Text.Json.JsonSerializer.Deserialize<BrowserDraft>(raw) is not { } d) return;

            _streetAddress1 = d.Street1; _streetAddress2 = d.Street2;
            _city = d.City; _state = d.State; _zipCode = d.Zip;
            _lat = d.Lat; _lon = d.Lon;
            _gender = d.Gender; _birthYear = d.BirthYear;
            _description = d.Description; _descriptionTouched = !string.IsNullOrWhiteSpace(StripHtml(d.Description));
            _accountName = d.Name; _accountEmail = d.Email;

            // Step 4 is not restored: its list of groups is fetched from the address, and landing
            // on an empty one reads as "nobody covers you". Anything earlier is restored as it was.
            _step = Math.Clamp(d.Step, 1, 3);
        }
        catch { /* A corrupt draft starts the form fresh. */ }
    }

    private async Task ClearBrowserDraftAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey); } catch { }
    }

    private void ToggleOrgSelection(Guid orgId, bool canSelect)
    {
        if (_selectedOrgIds.Contains(orgId))
            _selectedOrgIds.Remove(orgId);
        else if (canSelect)
            _selectedOrgIds.Add(orgId);
    }

    private UpsertClientRequestRequest BuildRequest() => new(
        StreetAddress1: _streetAddress1.Trim(),
        StreetAddress2: string.IsNullOrWhiteSpace(_streetAddress2) ? null : _streetAddress2.Trim(),
        City:           _city.Trim(),
        State:          _state.Trim(),
        ZipCode:        _zipCode.Trim(),
        Country:        "US",
        Latitude:       _lat,
        Longitude:      _lon,
        Gender:         _gender,
        BirthYear:      _birthYear,
        Description:    string.IsNullOrWhiteSpace(_description) ? null : _description.Trim());

    private static string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";
        return System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "").Trim();
    }

    private record GenderOption(ClientGender Value, string Label);
}
