@page "/my-cases"
@using Ben.Data.Common.Enums
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@inject IBenAdminClient AdminClient
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>My Cases</PageTitle>

<div class="container-fluid py-3" style="max-width:860px;">
    <h3 class="mb-1">My Cases</h3>
    @* Says whose cases these are. A member whose desk showed "Open cases 2" opened My Cases and read "You have no active
       cases" — true of them as a client, and nothing to do with the cases they work (UI test pass, 2026-09-14). *@
    <p class="text-secondary small mb-4">
        Cases you asked a group to take on, as the client. If you are also a member of a group, the cases you work on are on
        its Cases tab.
    </p>

    @* A client has no other window into this. "You have no active cases" to somebody who has one
       is not a wording slip — they will wait for a group that already accepted them. *@
    <BenListState TItem="ClientCaseListItem" Result="@_result" Loading="@(_cases is null)"
                  LoadingText="Loading your cases…" OnRetry="@LoadAsync">
        <Empty>
            <div class="text-center py-5 text-secondary">
                <p class="mb-3">You have no active cases.</p>
                <p class="small">Cases appear here after an investigation group accepts your request.</p>
                <a href="/my-requests" class="btn btn-outline-primary mt-2">View My Requests</a>
            </div>
        </Empty>
        <ChildContent>
        <div class="d-flex flex-column gap-3">
            @foreach (var c in _result.Items)
            {
                @* W-CL5: a click-only div could not be tabbed to, opened in a new tab, or read as
                   a link by a screen reader. An anchor is all three for free. *@
                <a class="card text-decoration-none text-reset" data-testid="my-case-card" href="/my-cases/@c.CaseId">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="font-monospace text-muted" style="font-size:.8rem;">@c.CaseReference</span>
                                    <span class="badge @c.Status.BadgeClass()">@c.Status.Label()</span>
                                </div>
                                <div class="fw-semibold">@c.Title</div>
                                <div class="text-secondary small">@c.City, @c.State</div>
                            </div>
                            <BenIcon Name="chevron-right" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.CaseManagerDisplayName))
                        {
                            <div class="text-secondary small mt-1">
                                Case Manager: <span class="fw-semibold">@c.CaseManagerDisplayName</span>
                            </div>
                        }
                        <div class="text-secondary small mt-1">
                            Opened @c.DateCaseOpened.ToViewerLocalTime(UserState).ToDisplayDate()
                        </div>
                        @if (c.NextInvestigationDate.HasValue)
                        {
                            <div class="small mt-1 text-primary fw-semibold d-flex align-items-center gap-1">
                                <BenIcon Name="calendar" />
                                <span>Next visit: @c.NextInvestigationDate.Value.ToViewerLocalTime(UserState).ToDisplayDateTimeNoSeconds()</span>
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
        </ChildContent>
    </BenListState>
</div>

@code {
    private List<ClientCaseListItem>? _cases;
    private LoadResult<ClientCaseListItem> _result;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _result = await AdminClient.GetMyCasesAsync();
            _cases  = _result.Items.ToList();
        }
        catch
        {
            // A thrown fetch is a failed load too — same panel, not an empty world.
            _result = LoadResult<ClientCaseListItem>.Failure();
            _cases  = [];
        }
        StateHasChanged();
    }

}
