@* ── Add co-client / invite dialog ────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showAddCoClient" Title="Share Case Access">
    <ChildContent>
        @if (_inviteResult is null)
        {
            <div class="row g-3">
                <div class="col-12">
