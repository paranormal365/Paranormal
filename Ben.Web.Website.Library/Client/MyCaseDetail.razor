@page "/my-cases/{CaseId:guid}"
@using Ben.Data.Common.Enums
@using Ben.Web.Services
@using Ben.Web.Services.WebApi
@using Ben.Web.Website.Library.Kit
@using Ben.Web.Website.Library.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IBenAdminClient AdminClient
@inject Ben.Web.Services.IMediaUrlBuilder MediaUrls
@inject IBenUserState UserState
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>@(_case?.Title ?? "My Case")</PageTitle>

@if (_loading)
{
    <BenLoaderOverlay Visible="true" Text="Loading your case…" />
    return;
}

@if (_case is null)
{
    <div class="container py-5 text-center">
        <h2 class="text-muted">Case not found</h2>
        <a href="/my-cases" class="btn btn-outline-secondary mt-3">← Back to My Cases</a>
    </div>
    return;
}

<div class="container-fluid py-3" style="max-width:960px;">

    @* ── Header ──────────────────────────────────────────────────────────────── *@
    <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <a href="/my-cases" class="text-secondary small">← My Cases</a>
            <div class="d-flex align-items-center gap-2 mt-1">
                <span class="font-monospace text-muted">@_case.CaseReference</span>
                <span class="badge @_case.Status.BadgeClass()">@_case.Status.Label()</span>
            </div>
            <h3 class="mb-0 mt-1">@_case.Title<HelpLink Slug="your-case" /></h3>
            <div class="text-secondary small">@_case.City, @_case.State · Opened @_case.DateCaseOpened.ToViewerLocalTime(UserState).ToDisplayDate()</div>
            @* Item 158: the client's named humans. Contacts when the group chose them, the
               case manager standing in when not — never a blank where "who do I talk to"
               should be. *@
            @if (_case.Contacts is { Count: > 0 } contacts)
            {
                <div class="text-secondary small mt-1">
                    Your contact@(contacts.Count > 1 ? "s" : ""):
                    <strong>@string.Join(", ", contacts.Select(c => c.DisplayName))</strong>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_case.CaseManagerDisplayName)
                 && (_case.Contacts is not { Count: > 0 } cs || cs.All(c => !c.IsFallback)))
            {
                <div class="text-secondary small mt-1">Case Manager: <strong>@_case.CaseManagerDisplayName</strong></div>
            }
        </div>
        <button type="button" class="btn btn-primary" @onclick="OpenLogDialog"><BenIcon Name="plus" Class="me-1" />Log Occurrence</button>
    </div>

    @if (_case.Status == Ben.Data.Common.Enums.CaseStatus.Paused)
    {
        @* Item 84: the client's view of a lapse. Their records are intact and readable — the
           banner's first job is saying so, because "paused" reads as "gone" to somebody whose
           haunting is still happening. The move flow lives right here rather than on its own
           page: this banner is the only place a client learns the case is paused, and sending
           them elsewhere to act on it loses half of them. *@
        <div class="alert alert-warning mb-3">
            <strong>This case is paused.</strong> The organization's subscription has ended, so
            they cannot work it right now. Everything collected so far is still here and still
            yours to read. If the group renews, the case resumes exactly where it left off.

            @if (_pendingMove is not null)
            {
                <hr />
                <p class="mb-2">
                    You've asked <strong>@_pendingMove.ToOrganizationName</strong> to take this
                    case — waiting for their answer.
                </p>
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_moveBusy"
                        @onclick="WithdrawMoveAsync">Withdraw the request</button>
            }
            else if (!_showMoveForm)
            {
                <hr />
                <button type="button" class="btn btn-primary btn-sm" @onclick="OpenMoveFormAsync">
                    Move my case to a different organization
                </button>
            }
            else
            {
                <hr />
                <div class="mb-2">
                    <label class="form-label" for="move-org">New organization</label>
                    <select id="move-org" class="form-select" style="max-width:26rem" @bind="_moveToOrgId">
                        <option value="">— choose a group —</option>
                        @foreach (var org in _moveTargets)
                        {
                            <option value="@org.OrganizationId">@org.Name@(org.AreaLabel is null ? "" : $" — {org.AreaLabel}")</option>
                        }
                    </select>
                </div>

                @* The per-category consent — the whole point of the flow. The findings are
                   dual-owned by the original group and you, which is why nothing here asks the
                   original group's permission: sharing your own case's material onward is yours
                   to decide. *@
                <p class="mb-1"><strong>What should the new group be able to see?</strong></p>
                <label class="d-block mb-1">
                    <input type="checkbox" class="form-check-input" @bind="_moveShareHistory" />
                    <span class="ms-1">The history collected so far (reports, notes, evidence)</span>
                </label>
                <label class="d-block mb-2">
                    <input type="checkbox" class="form-check-input" @bind="_moveShareInvestigations" />
                    <span class="ms-1">The investigations the previous group ran</span>
                </label>
                <p class="text-secondary small mb-2">
                    Anything you don't share stays with the original case — visible to you, not to
                    the new group. Nothing is deleted either way.
                </p>

                @if (_moveError is not null)
                {
                    <div class="alert alert-danger py-2 mb-2">@_moveError</div>
                }
                <button type="button" class="btn btn-primary btn-sm" disabled="@_moveBusy" @onclick="SubmitMoveAsync">
                    @(_moveBusy ? "Asking…" : "Ask this group")
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm ms-1"
                        @onclick="() => _showMoveForm = false">Cancel</button>
            }
        </div>
    }

    @if (_error is not null) { <div class="alert alert-danger mb-3">@_error</div> }

    @* ── Main grid ────────────────────────────────────────────────────────────── *@
    <div class="row g-4">

        @* ── Calendar + occurrences ──────────────────────────────────────────── *@
        <div class="col-12 col-lg-7">
            <div class="card mb-3">
                <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                    <span>Occurrence Calendar</span>
                    <span class="text-muted small">@_case.Occurrences.Count occurrence@(_case.Occurrences.Count == 1 ? "" : "s")</span>
                </div>
                <div class="card-body">
                    <TelerikCalendar Value="@_selectedDate"
                                     ValueChanged="@((DateTime d) => _selectedDate = d)"
                                     Min="@_case.DateCaseOpened.ToViewerLocalTime(UserState).Date"
                                     Max="@(_case.DateCaseClosed?.ToViewerLocalTime(UserState).Date ?? UserState.NowInViewerTimeZone().Date)"
                                     ShowOtherMonthDays="false">
                    </TelerikCalendar>
                </div>
            </div>

            @* Occurrences for selected date *@
            @{ var dayOccurrences = OccurrencesForDate(_selectedDate); }
            @if (dayOccurrences.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">
                        @_selectedDate.ToDisplayDate()
                        <span class="badge bg-secondary ms-2">@dayOccurrences.Count</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var occ in dayOccurrences)
                        {
                            var o = occ;
                            <div class="list-group-item">
                                <div class="d-flex align-items-start justify-content-between">
                                    <div class="flex-grow-1">
                                        @* Org-authored entries can now reach this list, so say so —
                                           otherwise an investigator's note reads as the client's own. *@
                                        @if (o.FromInvestigators)
                                        {
                                            <span class="badge bg-primary mb-1">From the investigators</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.Title))
                                        {
                                            <div class="fw-semibold small">@o.Title</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.Body))
                                        {
                                            <div class="text-secondary small mt-1">@((MarkupString)o.Body)</div>
                                        }
                                        <div class="text-muted" style="font-size:.72rem;">
                                            @((o.EventDateTime ?? o.DateCreated).ToViewerLocalTime(UserState).ToDisplayTime())
                                        </div>
                                        @* Shown back so tagging isn't a control that swallows input. *@
                                        @if (o.ExperienceTypeIds.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var tid in o.ExperienceTypeIds)
                                                {
                                                    <span class="badge bg-info-subtle text-info-emphasis" style="font-size:.65rem;">
                                                        @(_expTypeNames.TryGetValue(tid, out var tn) ? tn : "Tagged")
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @* Attached files *@
                                        @if (o.Files.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @foreach (var f in o.Files)
                                                {
                                                    var icon = f.ContentType.StartsWith("image/") ? "image"
                                                             : f.ContentType.StartsWith("video/") ? "play"
                                                             : f.ContentType.StartsWith("audio/") ? "play"
                                                             : "file";
                                                    <span class="badge bg-secondary d-flex align-items-center gap-1" title="@f.FileName">
                                                        <BenIcon Name="@icon" />
                                                        <span style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@f.FileName</span>
                                                        <button type="button" class="btn btn-secondary btn-sm text-white p-0" @onclick="@(async () => await RemoveFile(o.Id, f.FileId))"><BenIcon Name="x" /></button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        @* Attach file input *@
                                        <div class="mt-1">
                                            <InputFile OnChange="@(e => AttachFiles(o.Id, e))"
                                                       accept="image/*,audio/*,video/*,.pdf,.doc,.docx"
                                                       multiple
                                                       style="display:none;"
                                                       id="@($"file-{o.Id}")" />
                                            <label for="@($"file-{o.Id}")" class="btn btn-outline-secondary btn-sm" style="cursor:pointer; font-size:.72rem;">
                                                <BenIcon Name="upload" /> Attach File
                                            </label>
                                            @if (_uploading.Contains(o.Id))
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 ms-2">
                                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => OpenEditDialog(o))"><BenIcon Name="edit-2" /></button>
                                        <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-danger" : "btn-outline-danger") btn-sm" @onclick="@(() => ConfirmDelete(o))"><BenIcon Name="trash-2" /></button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_case.Occurrences.Count > 0)
            {
                <p class="text-secondary small text-center">No occurrences on @_selectedDate.ToDisplayDate().</p>
            }
        </div>

        @* ── Right column: description + investigations ───────────────────────── *@
        <div class="col-12 col-lg-5">
            @if (!string.IsNullOrWhiteSpace(_case.Description))
            {
                <div class="card mb-3">
                    <div class="card-header fw-semibold">Case Summary</div>
                    <div class="card-body">@((MarkupString)_case.Description)</div>
                </div>
            }

            @if (_case.Investigations.Count > 0)
            {
                <div class="card">
                    <div class="card-header fw-semibold">Investigations</div>
                    <div class="list-group list-group-flush">
                        @foreach (var inv in _case.Investigations.OrderBy(i => i.ScheduledDateTime))
                        {
                            var canCancel  = inv.CancellationDeadlineUtc.HasValue && DateTime.UtcNow < inv.CancellationDeadlineUtc.Value;
                            var deadlinePassed = inv.CancellationDeadlineUtc.HasValue && DateTime.UtcNow >= inv.CancellationDeadlineUtc.Value;
                            <div class="list-group-item">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div>
                                        <div class="fw-semibold small">@inv.Title</div>
                                        <div class="text-secondary small">
                                            @inv.ScheduledDateTime.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                            @if (inv.EndDateTime.HasValue)
                                            { <span> – @inv.EndDateTime.Value.ToViewerLocalTime(UserState).ToDisplayTime()</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(inv.Location))
                                        {
                                            <div class="text-secondary small">@inv.Location</div>
                                        }
                                        @if (inv.EvidenceDueDate.HasValue)
                                        {
                                            var isPastDue = inv.EvidenceDueDate.Value < DateTime.UtcNow;
                                            var isSoon    = !isPastDue && inv.EvidenceDueDate.Value < DateTime.UtcNow.AddDays(7);
                                            <div class="small mt-1 @(isPastDue ? "text-danger" : isSoon ? "text-warning" : "text-secondary")">
                                                Evidence @(isPastDue ? "was due" : "due"):
                                                @inv.EvidenceDueDate.Value.ToViewerLocalTime(UserState).ToDisplayDate()
                                                @if (isPastDue) { <strong> (closed)</strong> }
                                            </div>
                                        }
                                        @if (canCancel)
                                        {
                                            <div class="text-secondary small mt-1">
                                                Cancel by: @inv.CancellationDeadlineUtc!.Value.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                            </div>
                                        }
                                        @if (deadlinePassed && inv.Status == Ben.Data.Common.Enums.InvestigationStatus.Scheduled)
                                        {
                                            <div class="text-muted small mt-1"><em>Cancellation window closed</em></div>
                                        }
                                    </div>
                                    <div class="d-flex flex-column align-items-end gap-1">
                                        <span class="badge @InvStatusBadge(inv.Status)">@InvStatusLabel(inv.Status)</span>
                                        @if (canCancel)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(async () => await CancelInvestigation(inv.Id))" disabled="@(!(!_cancelling))">Cancel Visit</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>

    @* ── Scheduling proposals from the org ───────────────────────────────────── *@
    @if (_pendingProposals.Count > 0)
    {
        <div class="card mt-4 border-warning">
            <div class="card-header fw-semibold d-flex align-items-center gap-2 bg-warning text-dark">
                <BenIcon Name="calendar" />
                Investigation Date Proposal
                <span class="badge bg-dark">@_pendingProposals.Count</span>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var prop in _pendingProposals)
                {
                    var p = prop;
                    <div class="list-group-item">
                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                        {
                            <div class="small mb-2">@p.Notes</div>
                        }
                        <div class="d-flex flex-column gap-1 mb-3">
                            @foreach (var slot in p.Slots)
                            {
                                var s = slot;
                                <div class="d-flex align-items-center gap-2">
                                    <span class="small">
                                        @s.StartDateTime.ToViewerLocalTime(UserState).ToDisplayDateTime()
                                        @if (s.EndDateTime.HasValue) { <span> – @s.EndDateTime.Value.ToViewerLocalTime(UserState).ToDisplayTime()</span> }
                                    </span>
                                    <button type="button" class="btn btn-success btn-sm" @onclick="@(async () => await AcceptProposal(p.Id, s.Id))" disabled="@(!(!_respondingProposal))">Accept</button>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => { _counterProposalId = p.Id; _showCounterDialog = true; })" disabled="@(!(!_respondingProposal))">Suggest Different Date</button>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="@(async () => await DeclineProposal(p.Id))" disabled="@(!(!_respondingProposal))">Decline All</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Co-client access management (primary client only) ──────────────────── *@
    @if (_isPrimaryClient)
    {
        <div class="card mt-4">
            <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
                <span><BenIcon Name="users" /> Shared Access</span>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => _showAddCoClient = true)"><BenIcon Name="plus" Class="me-1" />Add Person</button>
            </div>
            <div class="card-body">
                @* These lists are mutated in place by Add/Remove below, so the failure state is
                   branched on directly rather than wrapping the card: a wrapped BenListState would
                   still be holding the load's own (now stale) emptiness after the first add. *@
                @if (_coClientsResult.Failed || _invitesResult.Failed)
                {
                    <BenListState TItem="CoClientItem"
                                  Result="@(_coClientsResult.Failed ? _coClientsResult : LoadResult<CoClientItem>.Failure(_invitesResult.Reason))"
                                  OnRetry="@LoadAsync" />
                }
                else if (_coClients.Count == 0 && _pendingInvites.Count == 0)
                {
                    <div class="text-secondary small">Only you have access. Use 'Add Person' to share this case with another account.</div>
                }
                <div class="d-flex flex-column gap-1">
                    @foreach (var cc in _coClients)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small">@cc.DisplayName</span>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="@(async () => await RemoveCoClient(cc.AccessId))"><BenIcon Name="x" /></button>
                        </div>
                    }
                </div>

                @if (_pendingInvites.Count > 0)
                {
                    <div class="text-secondary small fw-semibold mt-3 mb-1">Pending Invites</div>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var inv in _pendingInvites)
                        {
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small">
                                    @inv.Email
                                    <span class="text-secondary"> · expires @inv.DateExpires.ToViewerLocalTime(UserState).ToDisplayDate()</span>
                                </span>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => CopyInviteLink(inv))"><BenIcon Name="copy" Class="me-1" />Copy Link</button>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="@(async () => await RevokeInvite(inv.Id))"><BenIcon Name="x" /></button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ── People at the property (basic info, no account) ─────────────────────── *@
@* ── Public name (U6) ─────────────────────────────────────────────────────────
   Only meaningful to the primary client: they're the one the public page names. *@
@if (_isPrimaryClient)
{
    <div class="card mt-4">
        <div class="card-header fw-semibold">
            <BenIcon Name="eye" /> How You're Named Publicly
        </div>
        <div class="card-body">
            <div class="text-secondary small mb-2">
                If this case is ever published, this is the name shown on the public page.
                Your investigators always see your real name — they can't work the case otherwise.
            </div>

            <div class="d-flex gap-2 align-items-start flex-wrap">
                <input class="form-control" style="max-width:320px;" maxlength="128"
                       placeholder="e.g. The Miller Family" value="@_aliasDraft"
                       @oninput="@(e => _aliasDraft = e.Value?.ToString() ?? string.Empty)" />
                <button type="button" class="btn btn-primary" @onclick="SaveAliasAsync" disabled="@(!(!_aliasSaving))">Save</button>
                @if (!string.IsNullOrWhiteSpace(_alias?.ClientDisplayAlias))
                {
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Outline == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary")" @onclick="ClearAliasAsync" disabled="@(!(!_aliasSaving))">Clear</button>
                }
            </div>

            <div class="d-flex gap-1 flex-wrap mt-2">
                <span class="small text-secondary me-1">Suggestions:</span>
                @foreach (var s in AliasSuggestions)
                {
                    var suggestion = s;
                    <button type="button" class="btn @(ThemeConstants.Button.FillMode.Flat == ThemeConstants.Button.FillMode.Solid ? "btn-secondary" : "btn-outline-secondary") btn-sm" @onclick="@(() => _aliasDraft = suggestion)">@suggestion</button>
                }
            </div>

            @if (_alias is not null)
            {
                <div class="mt-3 small">
                    @* States what the public actually sees, computed server-side — the client
                       shouldn't have to work out whose name wins. *@
                    @if (_alias.EffectivePublicName is { } shown)
                    {
                        <span class="text-secondary">Public pages currently show:</span>
                        <strong class="ms-1">@shown</strong>
                        @if (string.IsNullOrWhiteSpace(_alias.ClientDisplayAlias)
                             && !string.IsNullOrWhiteSpace(_alias.OrganizationPseudonym))
                        {
                            <span class="d-block text-secondary">
                                That was chosen by the group. Set your own above to replace it.
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-secondary">
                            Public pages currently show no name for you at all.
                        </span>
                    }
                </div>
            }
        </div>
    </div>
}

    <div class="card mt-4">
        <div class="card-header fw-semibold d-flex align-items-center justify-content-between">
            <span><BenIcon Name="users" /> People at the Property</span>
            @if (_isPrimaryClient)
            {
                <button type="button" class="btn btn-secondary btn-sm" @onclick="OpenAddPerson"><BenIcon Name="plus" Class="me-1" />Add Person</button>
            }
        </div>
        <div class="card-body">
            <div class="text-secondary small mb-2">
                People you mention who don't have accounts on this site — for reference in your notes and timeline. This information is never made public.
            </div>
            @if (_relatedPeopleResult.Failed)
            {
                <BenListState TItem="CaseRelatedPersonRecord" Result="@_relatedPeopleResult" OnRetry="@LoadAsync" />
            }
            else if (_relatedPeople.Count == 0)
            {
                <div class="text-secondary small">No one added yet.</div>
            }
            <div class="d-flex flex-column gap-2">
                @foreach (var p in _relatedPeople)
                {
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="d-flex align-items-start gap-2">
                            @if (p.UploadFileId is { } pf && _personPhotos.TryGetValue(pf, out var pfSrc))
                            {
                                <img src="@pfSrc" alt="@p.Name" class="rounded border"
                                     style="width:40px;height:40px;object-fit:cover;flex:0 0 auto;" />
                            }
                        <div>
                            <span class="small fw-semibold">@p.Name</span>
                            @if (p.Age.HasValue) { <span class="small text-secondary"> · Age @p.Age</span> }
                            @if (!string.IsNullOrWhiteSpace(p.Relationship)) { <span class="small text-secondary"> · @p.Relationship</span> }
                            @if (p.LivesAtProperty) { <span class="badge bg-info text-dark ms-1" style="font-size:.65rem;">Lives here</span> }
                            @if (!string.IsNullOrWhiteSpace(p.Notes))
                            {
                                <div class="text-secondary small">@p.Notes</div>
                            }
                        </div>
                        </div>
                        @if (_isPrimaryClient)
                        {
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="@(() => OpenEditPerson(p))" title="Edit"><BenIcon Name="edit-2" /></button>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="@(async () => await RemoveRelatedPerson(p.Id))" title="Remove"><BenIcon Name="x" /></button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Message thread ──────────────────────────────────────────────────────── *@
    <div class="card mt-4">
        <div class="card-header fw-semibold d-flex align-items-center gap-2">
            <BenIcon Name="message-square" />
            Messages with your investigation group
            @if (_case.UnreadMessageCount > 0)
            {
                <span class="badge bg-danger rounded-pill" title="@_case.UnreadMessageCount unread">@_case.UnreadMessageCount</span>
            }
        </div>
        <div class="card-body">
            <CaseMessageThread CurrentSide="@Ben.Data.Common.Enums.CaseMessageSide.Client"
                               LoadMessages="@LoadClientMessages"
                               PostMessage="@PostClientMessage" />
        </div>
    </div>

    @* ── Published investigation reports ─────────────────────────────────────── *@
    @* Shown when the fetch failed as well as when there is something to show: hiding the card on
       failure made a case with reports look like a case without any. *@
    @if (_reports.Count > 0 || _reportsResult.Failed)
    {
        <div class="card mt-4">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <BenIcon Name="file" />
                Investigation Reports
                @if (!_reportsResult.Failed)
                {
                    <span class="badge bg-secondary">@_reports.Count</span>
                }
            </div>
            @if (_reportsResult.Failed)
            {
                <div class="card-body">
                    <BenListState TItem="CaseReportSummary" Result="@_reportsResult" OnRetry="@LoadAsync" />
                </div>
            }
            <div class="list-group list-group-flush">
                @foreach (var r in _reports)
                {
                    <div class="list-group-item d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold small">@r.Title</div>
                            @if (r.PublishedAt.HasValue)
                            {
                                <div class="text-secondary small">Published @r.PublishedAt.Value.ToViewerLocalTime(UserState).ToDisplayDate()</div>
                            }
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(async () => await DownloadReport(r.Id))"><BenIcon Name="file-text" Class="me-1" />PDF</button>
                    </div>
                }
            </div>
        </div>
    }

</div>

@* ── Log / Edit Occurrence dialog ─────────────────────────────────────────────── *@
<BenModal @bind-Visible="@_showDialog" Title="@(_editOcc is null ? "Log Occurrence" : "Edit Occurrence")">
