@code {
    // ── Item 84: moving a paused case ────────────────────────────────────────
    private PendingReassignRecord? _pendingMove;
    private bool _showMoveForm;
    private bool _moveBusy;
    private string? _moveError;
    private string _moveToOrgId = "";
    private bool _moveShareHistory = true;
    private bool _moveShareInvestigations = true;
    private List<OrgBrowseResult> _moveTargets = [];

    private async Task OpenMoveFormAsync()
    {
        _showMoveForm = true;
        if (_moveTargets.Count == 0)
        {
            // Accepting groups first — the browse endpoint already orders them that way. The
            // current organization is not filtered out here because the client detail record
            // does not carry its id; the server refuses a same-org move with a sentence this
            // form renders.
            var page = await AdminClient.BrowseOrganizationsAsync(1, 100);
            _moveTargets = [.. page?.Items ?? []];
        }
    }

    private async Task SubmitMoveAsync()
    {
        if (!Guid.TryParse(_moveToOrgId, out var toOrg)) { _moveError = "Choose a group first."; return; }

        _moveBusy = true;
        _moveError = null;

        var failure = await AdminClient.ReassignMyCaseAsync(
            CaseId, toOrg, _moveShareHistory, _moveShareInvestigations, null);

        _moveBusy = false;

        if (failure is not null) { _moveError = failure; return; }

        _showMoveForm = false;
        _pendingMove = await AdminClient.GetMyReassignAsync(CaseId);
    }

    private async Task WithdrawMoveAsync()
    {
        _moveBusy = true;
        await AdminClient.CancelMyReassignAsync(CaseId);
        _pendingMove = null;
        _moveBusy = false;
    }

    [Parameter] public Guid CaseId { get; set; }

    private ClientCaseDetail? _case;
    private bool _loading = true;
    private string? _error;
    private bool _isBusy;
    private HashSet<Guid> _uploading = [];
    private DateTime _selectedDate = DateTime.Today;

    // Dialog state
    private bool _showDialog;
    private ClientCaseOccurrence? _editOcc;
    private ClientCaseOccurrence? _deleteOcc;
    private string? _dialogError;
    private OccForm _form = new();
    private List<CaseReportSummary> _reports = [];
    private LoadResult<CaseReportSummary> _reportsResult;
    private List<ScheduleProposalDto> _pendingProposals = [];
    private List<CoClientItem> _coClients = [];
    private LoadResult<CoClientItem> _coClientsResult;
    private bool _isPrimaryClient;
    private bool _respondingProposal;
    private bool _cancelling;
    private bool _showAddCoClient;
    private string _addCoClientEmail = "";
    private List<CaseClientInviteRecord> _pendingInvites = [];
    private LoadResult<CaseClientInviteRecord> _invitesResult;
    private InviteCoClientResult? _inviteResult;
    private string? _inviteError;
    private bool _isInviting;
    private List<CaseRelatedPersonRecord> _relatedPeople = [];
    private LoadResult<CaseRelatedPersonRecord> _relatedPeopleResult;
    private bool _showAddRelatedPerson;

    private CaseDisplayAliasRecord? _alias;
    private string _aliasDraft = string.Empty;
    private bool   _aliasSaving;

    /// <summary>
    /// Starting points, not a fixed list — the field stays free text. Offered because "what should
    /// I call myself" is a harder question than it looks when someone is deciding how exposed to be.
    /// </summary>
    private static readonly string[] AliasSuggestions =
        ["The homeowner", "A local family", "Anonymous", "The tenant", "A neighbour"];

    /// <summary>Which person is being edited; null while adding a new one.</summary>
    private Guid? _editingPersonId;
    private Guid? _newPersonPhotoFileId;
    private string? _personPhotoPreview;
    private bool _personPhotoUploading;

    /// <summary>
    /// Witness photo thumbnails as data URIs, keyed by upload-file id. Fetched through the
    /// authenticated client rather than linked directly: these files are private, and a browser
    /// sends no bearer token with an &lt;img&gt; request, so a direct URL renders broken.
    /// </summary>
    private readonly Dictionary<Guid, string> _personPhotos = [];

    /// <summary>Witness photos are case evidence — same upload type as everything else on a case.</summary>
    private static readonly Guid EvidenceFileTypeId = new("20000000-0000-0000-0000-000000000001");
    private string _newPersonName = "";
    private int? _newPersonAge;
    private string _newPersonRelationship = "";
    private bool _newPersonLivesAtProperty;
    private string _newPersonNotes = "";
    private string _newPersonPublicLabel = "";
    private bool _showCounterDialog;
    private Guid _counterProposalId;
    private DateTime? _counterDateTime;
    private string _counterNotes = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) { NavManager.NavigateTo("/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try { _case = await AdminClient.GetMyCaseAsync(CaseId); }
        catch { _error = "Failed to load case."; }

        if (_case?.Status == Ben.Data.Common.Enums.CaseStatus.Paused)
            _pendingMove = await AdminClient.GetMyReassignAsync(CaseId);

        _loading = false;
        StateHasChanged();

        // Load published reports after case renders (non-blocking)
        // Reports are the deliverable the client is waiting for. A refused fetch used to hide the
        // whole card, so the page looked like a case nobody had reported on yet.
        try
        {
            _reportsResult = await AdminClient.GetMyCaseReportsAsync(CaseId);
            _reports       = _reportsResult.Items.ToList();
            StateHasChanged();
        }
        catch { _reportsResult = LoadResult<CaseReportSummary>.Failure(); }

        // Load pending scheduling proposals
        try { _pendingProposals = (await AdminClient.GetMyScheduleProposalsAsync(CaseId)).Items.ToList(); StateHasChanged(); }
        catch { /* silent */ }

        // Co-clients — only load (and only shown) for the primary client. IsPrimaryClient comes
        // from the case detail response itself, not from whether GetCoClients happens not to
        // throw: the generic HTTP client returns an empty list on a 403 rather than throwing, so
        // that inference silently showed every co-client the primary-only admin controls too.
        _isPrimaryClient = _case?.IsPrimaryClient ?? false;
        if (_isPrimaryClient)
        {
            try
            {
                _coClientsResult = await AdminClient.GetCoClientsAsync(CaseId);
                _coClients       = _coClientsResult.Items.ToList();
                _invitesResult   = await AdminClient.GetCaseInvitesAsync(CaseId);
                _pendingInvites  = _invitesResult.Items.ToList();
                StateHasChanged();
            }
            catch
            {
                // Was silent, and the card then said "Only you have access" — which is the one
                // sentence a primary client must be able to trust.
                _coClientsResult = LoadResult<CoClientItem>.Failure();
                _invitesResult   = LoadResult<CaseClientInviteRecord>.Failure();
            }
        }

        try
        {
            _relatedPeopleResult = await AdminClient.GetRelatedPeopleAsync(CaseId);
            _relatedPeople       = _relatedPeopleResult.Items.ToList();
            await LoadPersonPhotosAsync();
            await LoadAliasAsync();
            await LoadTaxonomyAsync();
            StateHasChanged();
        }
        catch { _relatedPeopleResult = LoadResult<CaseRelatedPersonRecord>.Failure(); }
    }

    private List<ClientCaseOccurrence> OccurrencesForDate(DateTime date) =>
        _case?.Occurrences
            .Where(o => (o.EventDateTime ?? o.DateCreated).ToViewerLocalTime(UserState).Date == date.Date)
            .OrderBy(o => o.EventDateTime ?? o.DateCreated)
            .ThenBy(o => o.DateCreated).ThenBy(o => o.Id)
            .ToList() ?? [];

    /// <summary>
    /// The shared experience taxonomy, used for optional tagging. Read-only here — clients pick
    /// from the platform's list rather than inventing their own, so investigators can actually
    /// group reports across cases.
    /// </summary>
    private List<ExperienceCategoryWithTypesResponse> _taxonomy = [];
    private Dictionary<Guid, string> _expTypeNames = [];

    private void ToggleExperienceType(Guid id)
    {
        if (!_form.ExperienceTypeIds.Remove(id)) _form.ExperienceTypeIds.Add(id);
    }

    private async Task LoadTaxonomyAsync()
    {
        if (_taxonomy.Count > 0) return;
        try
        {
            // A label lookup. If it fails the chips show ids instead of names, which is worse
            // than names and better than an error panel over somebody's case.
            _taxonomy = (await AdminClient.GetExperienceTaxonomyAsync()).Items.ToList();
            _expTypeNames = _taxonomy.SelectMany(c => c.Types).ToDictionary(t => t.Id, t => t.Name);
        }
        catch { /* tagging is optional — the dialog still works without the list */ }
    }

    private void OpenLogDialog()
    {
        _editOcc = null;
        _form = new OccForm { EventDateTime = _selectedDate.Date.AddHours(UserState.NowInViewerTimeZone().Hour) };
        _dialogError = null;
        _showDialog = true;
    }

    private void OpenEditDialog(ClientCaseOccurrence occ)
    {
        _editOcc = occ;
        _form = new OccForm
        {
            EventDateTime = (occ.EventDateTime ?? occ.DateCreated).ToViewerLocalTime(UserState),
            Title         = occ.Title ?? "",
            Body          = occ.Body ?? "",
        };
        foreach (var id in occ.ExperienceTypeIds) _form.ExperienceTypeIds.Add(id);
        _dialogError = null;
        _showDialog = true;
    }

    private void ConfirmDelete(ClientCaseOccurrence occ) => _deleteOcc = occ;

    private async Task SaveOccurrence()
    {
        if (string.IsNullOrWhiteSpace(_form.Body)) { _dialogError = "Description is required."; return; }
        _isBusy = true; _dialogError = null;
        try
        {
            var req = new LogOccurrenceRequest(
                _form.EventDateTime!.Value.ToUtcFromViewerLocal(UserState),
                _form.Title?.Trim(), _form.Body.Trim(),
                _form.ExperienceTypeIds.ToList());
            if (_editOcc is null)
                await AdminClient.LogOccurrenceAsync(CaseId, req);
            else
                await AdminClient.UpdateOccurrenceAsync(CaseId, _editOcc.Id, req);
            _showDialog = false;
            await LoadAsync();
        }
        catch { _dialogError = "Save failed. Please try again."; }
        finally { _isBusy = false; }
    }

    private async Task DeleteOccurrence()
    {
        if (_deleteOcc is null) return;
        _isBusy = true;
        try
        {
            await AdminClient.DeleteOccurrenceAsync(CaseId, _deleteOcc.Id);
            _deleteOcc = null;
            await LoadAsync();
        }
        catch { _error = "Delete failed."; }
        finally { _isBusy = false; }
    }

    private static string InvStatusBadge(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "bg-primary",
        InvestigationStatus.InProgress => "bg-warning text-dark",
        InvestigationStatus.Completed  => "bg-success",
        _                              => "bg-secondary",
    };

    private static string InvStatusLabel(InvestigationStatus s) => s switch
    {
        InvestigationStatus.Scheduled  => "Scheduled",
        InvestigationStatus.InProgress => "In Progress",
        InvestigationStatus.Completed  => "Completed",
        InvestigationStatus.Cancelled  => "Cancelled",
        _                              => s.ToString(),
    };

    private class OccForm
    {
        public DateTime? EventDateTime { get; set; } = DateTime.Now;
        public string    Title         { get; set; } = "";
        public string    Body          { get; set; } = "";
        public HashSet<Guid> ExperienceTypeIds { get; } = [];
    }

    private async Task RemoveCoClient(Guid accessId)
    {
        await AdminClient.RemoveCoClientAsync(CaseId, accessId);
        _coClients.RemoveAll(c => c.AccessId == accessId);
        StateHasChanged();
    }

    /// <summary>Server-side validation is already correct; this is UX polish only — catches an
    /// obviously malformed address before round-tripping to the API.</summary>
    private static bool IsValidEmailFormat(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try { return new System.Net.Mail.MailAddress(email.Trim()).Address == email.Trim(); }
        catch { return false; }
    }

    private async Task AddCoClient()
    {
        if (!IsValidEmailFormat(_addCoClientEmail) || _isInviting) return;
        _isInviting = true;
        _inviteError = null;
        try
        {
            var result = await AdminClient.InviteCoClientAsync(CaseId, _addCoClientEmail.Trim());
            if (result is null)
            {
                _inviteError = "Something went wrong. Please try again.";
                return;
            }

            if (result.LinkedExistingAccount && result.CoClient is not null)
                _coClients.Add(result.CoClient);
            else if (result.Invite is not null)
                _pendingInvites.Insert(0, result.Invite);

            _inviteResult = result;
        }
        catch
        {
            _inviteError = "Something went wrong. Please try again.";
        }
        finally
        {
            _isInviting = false;
            StateHasChanged();
        }
    }

