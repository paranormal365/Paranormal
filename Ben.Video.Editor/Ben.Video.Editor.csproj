<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<!-- The video editor's version: the newest released heading of
	     Ben.Web.Services/Changelog/Content/video-editor.md. It changes only at release, in the same
	     commit that turns "## Unreleased" into "## x.y.z" (ChangelogServiceTests). -->
	<Version>1.0.0</Version>
	</PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
	<PackageReference Include="Telerik.UI.for.Blazor" Version="14.1.0" />
	<!-- Pinned past the version Telerik's document libraries bring (9.0.9), which carries a published
	     high-severity advisory (GHSA-846f-f764-76mx, fixed in 10.0.13): a fresh restore refused to
	     build with warnings as errors (10/14/2026). Telerik 15.1 brings 10.0.13 itself; remove then. -->
	<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Ben.Video.RenderService\Ben.Video.RenderService.csproj" />
	<ProjectReference Include="..\Ben.Video.Core\Ben.Video.Core.csproj" />
  </ItemGroup>

</Project>
