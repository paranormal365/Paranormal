@implements IDisposable
@using Ben.Video.Editor.Models.Assets
@using Ben.Video.Editor.Services
@inject ClipStore Clips
@inject MotionKeyframeService Motion
@inject PlaybackService Playback

<div class="bv-clipart-editor">

    <!-- Header -->
    <div class="bv-editor-header">
        <span class="bv-editor-header__title" title="@Clip.Name">🖼 @Clip.Name</span>
        <TelerikButton Icon="@SvgIcon.X"
                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                       Size="@ThemeConstants.Button.Size.Small"
                       OnClick="OnClose" />
    </div>

    <!-- Duration -->
    <div class="bv-editor-section">
        <label class="bv-editor-label">Duration (s)</label>
        <TelerikNumericTextBox @bind-Value="@_duration"
                               Min="0.1" Step="0.5"
                               Width="100%"
                               OnChange="ApplyDuration" />
    </div>

    <!-- Position -->
    <div class="bv-editor-section">
        <label class="bv-editor-label">
            Position
            @if (_showingLiveValues)
            {
                <span class="bv-clipart-editor__live-badge" title="This layer has a motion path — position/size/opacity below track the interpolated value at the current playhead time, not a fixed value.">● Live</span>
            }
        </label>
        <div class="bv-editor-row">
            <label class="bv-editor-sublabel">X</label>
            <TelerikSlider @bind-Value="@_x" Min="0.0" Max="1.0"
                           SmallStep="0.01" LargeStep="0.1"
                           Width="100%"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.1)"
                           OnChange="ApplyGeometry" />
        </div>
        <div class="bv-editor-row">
            <label class="bv-editor-sublabel">Y</label>
            <TelerikSlider @bind-Value="@_y" Min="0.0" Max="1.0"
                           SmallStep="0.01" LargeStep="0.1"
                           Width="100%"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.1)"
                           OnChange="ApplyGeometry" />
        </div>
    </div>

    <!-- Size (only if AllowResize) -->
    @if (Clip.Settings.AllowResize)
    {
        <div class="bv-editor-section">
            <label class="bv-editor-label">
                Size
                @if (_showingLiveValues)
                {
                    <span class="bv-clipart-editor__live-badge">● Live</span>
                }
            </label>
            <div class="bv-editor-row">
                <label class="bv-editor-sublabel">Width</label>
                <TelerikSlider @bind-Value="@_width"
                               Min="@(Clip.Settings.MinScale ?? 0.02)"
                               Max="@(Clip.Settings.MaxScale ?? 1.0)"
                               SmallStep="0.01" LargeStep="0.1"
                               Width="100%"
                               LabelTemplate="@SliderLabelTemplates.Endpoints(Clip.Settings.MinScale ?? 0.02, Clip.Settings.MaxScale ?? 1.0, 0.1)"
                               OnChange="ApplyGeometry" />
            </div>
        </div>
    }

    <!-- Rotation (only if AllowRotation) -->
    @if (Clip.Settings.AllowRotation)
    {
        <div class="bv-editor-section">
            <label class="bv-editor-label">Rotation</label>
            <TelerikSlider @bind-Value="@_rotation" Min="-180.0" Max="180.0"
                           SmallStep="1.0" LargeStep="15.0"
                           Width="100%"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(-180.0, 180.0, 15.0)"
                           OnChange="ApplyGeometry" />
        </div>
    }

    <!-- Opacity (only if AllowOpacity) -->
    @if (Clip.Settings.AllowOpacity)
    {
        <div class="bv-editor-section">
            <label class="bv-editor-label">
                Opacity
                @if (_showingLiveValues)
                {
                    <span class="bv-clipart-editor__live-badge">● Live</span>
                }
            </label>
            <TelerikSlider @bind-Value="@_opacity" Min="0.0" Max="1.0"
                           SmallStep="0.01" LargeStep="0.1"
                           Width="100%"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.1)"
                           OnChange="ApplyAppearance" />
        </div>
    }

    <!-- Recolor tint (only if AllowRecolor) -->
    @if (Clip.Settings.AllowRecolor)
    {
        <div class="bv-editor-section">
            <label class="bv-editor-label">Tint color</label>
            <ColorPickerField Value="@_tintPacked"
                              ValueChanged="OnTintColorChanged"
                              ShowAlpha="true" />
        </div>
    }

    <!-- SVG Control Points (only if AllowControlPoints and points exist) -->
    @if (Clip.Settings.AllowControlPoints && Clip.ControlPoints is { Count: > 0 })
    {
        <div class="bv-editor-section">
            <label class="bv-editor-label">Control points</label>
            @foreach (var pt in Clip.ControlPoints)
            {
                <div class="bv-editor-control-point" title="@pt.Label">
                    <span class="bv-editor-sublabel">@pt.Label</span>
                    @if (pt.Type is SvgControlPointType.StrokeColor or SvgControlPointType.FillColor)
                    {
                        <ColorPickerField Value="@GetPointColorPacked(pt)"
                                          ValueChanged="v => SetPointColor(pt, v)"
                                          ShowAlpha="@pt.AllowColorAlpha" />
                    }
                    else
                    {
                        var min = pt.MinValue ?? 0.0;
                        var max = pt.MaxValue ?? 1.0;
                        <TelerikSlider Value="@GetPointValue(pt)"
                                       ValueChanged="(double v) => SetPointValue(pt, v)"
                                       Min="@min" Max="@max"
                                       SmallStep="@((max - min) / 100.0)"
                                       LargeStep="@((max - min) / 10.0)"
                                       LabelTemplate="@SliderLabelTemplates.Endpoints(min, max, (max - min) / 10.0)"
                                       Width="100%" />
                    }
                </div>
            }
        </div>
    }

    <!-- Motion keyframes (only if AllowMotion) -->
    @if (Clip.Settings.AllowMotion)
    {
        <div class="bv-editor-section">
            <TelerikButton Icon="@SvgIcon.Clock"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           Size="@ThemeConstants.Button.Size.Small"
                           Class="bv-clipart-editor__animate-btn"
                           OnClick="ActivateMotion">
                ⏱ Animate position / scale
            </TelerikButton>
        </div>
    }

    <!-- Footer actions -->
    <div class="bv-editor-footer">
        <TelerikButton Icon="@SvgIcon.Trash"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                       FillMode="@ThemeConstants.Button.FillMode.Outline"
                       Size="@ThemeConstants.Button.Size.Small"
                       OnClick="OnRemove">
            Remove
        </TelerikButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ClipArtClip Clip { get; set; } = null!;
    [Parameter] public EventCallback OnClose  { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback<(Guid Id, string Type)> OnAnimate { get; set; }

    private double _duration;
    private double _x, _y, _width, _rotation, _opacity;
    private double _tintPacked;
    private bool   _showingLiveValues;

    protected override void OnInitialized()
    {
        Clips.OnChange          += RefreshAndRender;
        Motion.OnChanged        += RefreshAndRender;
        Playback.OnStateChanged += RefreshAndRender;
    }

    protected override void OnParametersSet() => RefreshFromSource();

    private void RefreshAndRender()
    {
        RefreshFromSource();
        StateHasChanged();
    }

    private void RefreshFromSource()
    {
        _duration = Clip.Duration;
        _x        = Clip.X;
        _y        = Clip.Y;
        _width    = Clip.Width;
        _rotation = Clip.Rotation;
        _opacity  = Clip.Opacity;
        _tintPacked = Clip.TintColor ?? 0;

        _showingLiveValues = Motion.HasPath(Clip.Id);
        if (_showingLiveValues)
        {
            var frame = Motion.Evaluate(Clip.Id, Playback.State.CurrentTime)
                ?? new MotionFrame(Clip.X, Clip.Y, 1.0, 1.0);
            var effective = ExportArgBuilders.ApplyMotionFrame(Clip, frame);
            _x       = effective.X;
            _y       = effective.Y;
            _width   = effective.Width;
            _opacity = effective.Opacity;
        }
    }

    public void Dispose()
    {
        Clips.OnChange          -= RefreshAndRender;
        Motion.OnChanged        -= RefreshAndRender;
        Playback.OnStateChanged -= RefreshAndRender;
    }

    // Every edit below goes through CommitClipArtUpdate, so it can be undone. They all used to
    // call UpdateClipArtClip, which mutates and notifies and pushes nothing — so nothing anybody
    // did to a piece of clip art could be taken back, and Ctrl+Z reached past it to whatever
    // happened before (2026-09-05 audit, callouts-8). The sliders fire on release rather than per
    // tick, which is what keeps one drag to one undo step (callouts-17).
    //
    // The old value is read from the model, not from the panel's fields: the panel is refreshed by
    // external events and its idea of "before" can already be the new value.

    private void ApplyDuration()
    {
        var was   = Clip.Duration;
        var value = _duration;
        Clips.CommitClipArtUpdate(Clip.Id, "duration",
            c => c.Duration = value, c => c.Duration = was);
    }

    private void ApplyGeometry()
    {
        var (wasX, wasY, wasW, wasR) = (Clip.X, Clip.Y, Clip.Width, Clip.Rotation);
        var (x, y, w, r) = (_x, _y, _width, _rotation);

        Clips.CommitClipArtUpdate(Clip.Id, "position and size",
            c => { c.X = x;    c.Y = y;    c.Width = w;    c.Rotation = r; },
            c => { c.X = wasX; c.Y = wasY; c.Width = wasW; c.Rotation = wasR; });
    }

    private void ApplyAppearance()
    {
        var (wasOpacity, wasTint) = (Clip.Opacity, Clip.TintColor);
        var opacity = _opacity;
        var tint    = _tintPacked == 0 ? (double?)null : _tintPacked;

        Clips.CommitClipArtUpdate(Clip.Id, "appearance",
            c => { c.Opacity = opacity;    c.TintColor = tint; },
            c => { c.Opacity = wasOpacity; c.TintColor = wasTint; });
    }

    private void OnTintColorChanged(double packed)
    {
        _tintPacked = packed;
        ApplyAppearance();
    }

    private double GetPointValue(SvgControlPoint pt)
        => Clip.ControlPointValues.TryGetValue(pt.PointId, out var v) ? v : pt.DefaultValue;

    private void SetPointValue(SvgControlPoint pt, double value)
    {
        var id  = pt.PointId;
        var had = Clip.ControlPointValues.TryGetValue(id, out var was);

        Clips.CommitClipArtUpdate(Clip.Id, "shape point",
            c => c.ControlPointValues[id] = value,
            c => { if (had) c.ControlPointValues[id] = was; else c.ControlPointValues.Remove(id); });
    }

    private double GetPointColorPacked(SvgControlPoint pt)
    {
        if (Clip.ControlPointColors.TryGetValue(pt.PointId, out var hex))
            return Effects.ColorHelper.FromHex(hex);
        return pt.DefaultColor is not null ? Effects.ColorHelper.FromHex(pt.DefaultColor) : Effects.ColorHelper.OpaqueWhite;
    }

    private void SetPointColor(SvgControlPoint pt, double packed)
    {
        var id    = pt.PointId;
        var had   = Clip.ControlPointColors.TryGetValue(id, out var was);
        var value = Effects.ColorHelper.ToHex(packed);

        Clips.CommitClipArtUpdate(Clip.Id, "shape colour",
            c => c.ControlPointColors[id] = value,
            c => { if (had) c.ControlPointColors[id] = was!; else c.ControlPointColors.Remove(id); });
    }

    private async Task ActivateMotion()
        => await OnAnimate.InvokeAsync((Clip.Id, "ClipArtClip"));
}
