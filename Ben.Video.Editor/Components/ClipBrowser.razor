    /// <summary>
    /// The Server tab's scope selector.
    /// </summary>
    /// <remarks>
    /// <para>Rendered above every state of the list — loading, error, empty and populated alike.
    /// That matters most in the empty case: a scope that matches nothing must still be
    /// changeable, or picking the wrong case leaves the tab with no way out of it.</para>
    ///
    /// <para>Native selects rather than Telerik dropdowns, matching the site's own reasoning for
    /// BenSelect: no popup layer to fight the editor's stacking contexts, no JavaScript, and the
    /// browser handles keyboard, touch and mobile pickers by itself.</para>
    /// </remarks>
    private RenderFragment LibraryScopeBar => __builder =>
    {
        int seq = 0;
        var hasGroups = _scopeGroups.Count > 0;

        __builder.OpenElement(seq++, "div");
        __builder.AddAttribute(seq++, CssScope, "");
        __builder.AddAttribute(seq++, "class", "bv-browser__scope");

        // Which slice.
        __builder.OpenElement(seq++, "select");
        __builder.AddAttribute(seq++, CssScope, "");
        __builder.AddAttribute(seq++, "class", "bv-browser__scope-select");
        __builder.AddAttribute(seq++, "title", "Which files to show");
        __builder.AddAttribute(seq++, "aria-label", "Media scope");
        __builder.AddAttribute(seq++, "value", CurrentScope.Wire);
        __builder.AddAttribute(seq++, "onchange",
            Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, OnScopeKindChangedAsync));
        foreach (var (value, label) in new[] { ("all", "All media"), ("personal", "My files") })
        {
            __builder.OpenElement(seq++, "option");
            __builder.AddAttribute(seq++, "value", value);
            __builder.AddContent(seq++, label);
            __builder.CloseElement();
        }
        // Offered only when the host can say what the groups are — otherwise choosing it would
        // lead to a second dropdown with nothing in it.
        if (hasGroups)
        {
            __builder.OpenElement(seq++, "option");
            __builder.AddAttribute(seq++, "value", "case");
            __builder.AddContent(seq++, "By case");
            __builder.CloseElement();
        }
        __builder.CloseElement(); // scope select

        if (_scopeKind == MediaLibraryScopeKind.Case && hasGroups)
        {
            // Which case.
            __builder.OpenElement(seq++, "select");
            __builder.AddAttribute(seq++, CssScope, "");
            __builder.AddAttribute(seq++, "class", "bv-browser__scope-select");
            __builder.AddAttribute(seq++, "title", "Which case");
            __builder.AddAttribute(seq++, "aria-label", "Case");
            __builder.AddAttribute(seq++, "value", _scopeCaseId?.ToString() ?? "");
            __builder.AddAttribute(seq++, "onchange",
                Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, OnScopeCaseChangedAsync));
            __builder.OpenElement(seq++, "option");
            __builder.AddAttribute(seq++, "value", "");
            __builder.AddContent(seq++, "Choose a case…");
            __builder.CloseElement();
            foreach (var group in _scopeGroups)
            {
                __builder.OpenElement(seq++, "option");
                __builder.AddAttribute(seq++, "value", group.Id.ToString());
                __builder.AddContent(seq++, group.Label);
                __builder.CloseElement();
            }
            __builder.CloseElement(); // case select

            // Which visit — only once a case is chosen, and only if it has any.
            var visits = InvestigationsForChosenCase;
            if (_scopeCaseId is not null && visits.Count > 0)
            {
                __builder.OpenElement(seq++, "select");
                __builder.AddAttribute(seq++, CssScope, "");
                __builder.AddAttribute(seq++, "class", "bv-browser__scope-select");
                __builder.AddAttribute(seq++, "title", "Narrow to one visit");
                __builder.AddAttribute(seq++, "aria-label", "Investigation");
                __builder.AddAttribute(seq++, "value", _scopeInvestigationId?.ToString() ?? "");
                __builder.AddAttribute(seq++, "onchange",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, OnScopeInvestigationChangedAsync));
                __builder.OpenElement(seq++, "option");
                __builder.AddAttribute(seq++, "value", "");
                __builder.AddContent(seq++, "The whole case");
                __builder.CloseElement();
                foreach (var visit in visits)
                {
                    __builder.OpenElement(seq++, "option");
                    __builder.AddAttribute(seq++, "value", visit.Id.ToString());
                    __builder.AddContent(seq++, visit.Label);
                    __builder.CloseElement();
                }
                __builder.CloseElement(); // investigation select
            }
        }

        // Reload. The list was fetched once and never again, so a file uploaded from another tab
        // — or the render this editor had just published — did not appear without reloading the
        // whole page. A failed load had the same problem in reverse: the retry gate is "no files
        // yet", which an error also satisfies, so there was nothing to press (2026-09-05 audit,
        // media-10).
        __builder.OpenComponent<TelerikButton>(seq++);
        __builder.AddAttribute(seq++, "OnClick",
            Microsoft.AspNetCore.Components.EventCallback.Factory
                .Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                    this, _ => RefreshLibraryAsync()));
        __builder.AddAttribute(seq++, "Title",      "Reload this list from the server");
        __builder.AddAttribute(seq++, "Icon",       (object)SvgIcon.ArrowRotateCw);
        __builder.AddAttribute(seq++, "FillMode",   ThemeConstants.Button.FillMode.Flat);
        __builder.AddAttribute(seq++, "Size",       ThemeConstants.Button.Size.Small);
        __builder.AddAttribute(seq++, "Enabled",    !_libraryLoading);
        __builder.AddAttribute(seq++, "Class",      "bv-browser__scope-refresh");
        __builder.CloseComponent();

        __builder.CloseElement(); // scope bar
    };

    private RenderFragment LibraryFileGrid => __builder =>
    {
        int seq = 0;
        __builder.AddContent(seq++, LibraryScopeBar);

        if (_libraryLoading)
        {
            __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, "class", "bv-browser__loading");
            __builder.OpenComponent<TelerikLoader>(seq++);
            __builder.AddAttribute(seq++, "Type", LoaderType.InfiniteSpinner);
            __builder.AddAttribute(seq++, "Size", ThemeConstants.Loader.Size.Medium);
            __builder.CloseComponent();
            __builder.OpenElement(seq++, "span"); __builder.AddContent(seq++, "Loading library…"); __builder.CloseElement();
            __builder.CloseElement();
        }
        else if (_libraryNeedsSignIn)
        {
            // A refusal, said as a refusal, with whatever way in the host offers. An empty tab or
            // a raw HTTP message both describe a state that is not true (2026-09-05 audit, F11 and
            // site-11).
            __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, "class", "bv-browser__signin");
            __builder.OpenElement(seq++, "p");
            __builder.AddContent(seq++,
                "Sign in to see the files you have uploaded. Everything else in the editor works "
                + "signed out.");
            __builder.CloseElement();

            if (HostStatusContent is not null)
            {
                __builder.AddContent(seq++, HostStatusContent);
            }

            __builder.CloseElement();
        }
        else if (_libraryError is not null)
        {
            __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, "class", "bv-browser__error");
            __builder.AddContent(seq++, $"⚠ {_libraryError}");
            __builder.CloseElement();
        }
        else if (!_libraryFiles.Any())
        {
            __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, "class", "bv-browser__empty");
            // Naming the scope matters: "no files in the media library" is alarming and wrong when
            // the person has simply narrowed to a case that has none yet.
            var emptyText = _scopeKind switch
            {
                MediaLibraryScopeKind.Case when _scopeCaseId is null => "Choose a case to see its media.",
                MediaLibraryScopeKind.Case     => "Nothing here for that selection.",
                MediaLibraryScopeKind.Personal => "You have not uploaded any media yet.",
                _                              => "No files in the media library.",
            };
            __builder.OpenElement(seq++, "p"); __builder.AddContent(seq++, emptyText); __builder.CloseElement();
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-browser__grid");
            foreach (var file in _libraryFiles)
            {
                var f = file;
                // Phase 150 — "busy" (adding an already-cached file to the timeline) and
                // "downloading" (fetching+caching, not yet on the timeline) are now distinct
                // states with their own visuals; see OnLibraryCardClickedAsync's dispatch.
                var busy        = _libraryImporting.Contains(f.Id);
                var downloading = _libraryDownloading.Contains(f.Id);
                var cached      = _libraryCached.Contains(f.Id);
                __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", $"bv-clip-card {(busy || downloading ? "bv-clip-card--busy" : "")}");
                __builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OnLibraryCardClickedAsync(f)));

                // Thumb
                var hasThumb    = _serverThumbnails.TryGetValue(f.Id, out var serverThumbUrl);
                var thumbLoading = _serverThumbnailsLoading.Contains(f.Id);
                __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__thumb");
                if (hasThumb)
                {
                    __builder.OpenElement(seq++, "img");
                    __builder.AddAttribute(seq++, CssScope, "");
                    __builder.AddAttribute(seq++, "src", serverThumbUrl);
                    __builder.AddAttribute(seq++, "alt", file.FileName);
                    __builder.CloseElement();
                }
                else
                {
                    __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__thumb-placeholder");
                    if (thumbLoading)
                    {
                        __builder.OpenComponent<TelerikLoader>(seq++);
                        __builder.AddAttribute(seq++, "Type", LoaderType.Pulsing);
                        __builder.AddAttribute(seq++, "Size", ThemeConstants.Loader.Size.Small);
                        __builder.CloseComponent();
                    }
                    else
                    {
                        __builder.OpenComponent<TelerikSvgIcon>(seq++);
                        __builder.AddAttribute(seq++, "Icon", (object)(file.IsVideo ? SvgIcon.FileVideo : file.IsAudio ? SvgIcon.FileAudio : SvgIcon.Image));
                        __builder.CloseComponent();
                    }
                    // On-demand preview trigger — video only, and only before a thumbnail exists.
                    // A plain native <button> (not TelerikButton) so AddEventStopPropagationAttribute
                    // can target its own onclick directly and keep this from also bubbling up to the
                    // card's onclick (which triggers a full import).
                    if (file.IsVideo && !thumbLoading)
                    {
                        __builder.OpenElement(seq++, "button");
                        __builder.AddAttribute(seq++, CssScope, "");
                        __builder.AddAttribute(seq++, "class", "bv-clip-card__preview-btn");
                        __builder.AddAttribute(seq++, "title", "Load a preview thumbnail");
                        __builder.AddAttribute(seq++, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => LoadServerVideoPreviewAsync(f)));
                        __builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
                        __builder.OpenComponent<TelerikSvgIcon>(seq++);
                        __builder.AddAttribute(seq++, "Icon", (object)SvgIcon.Eye);
                        __builder.CloseComponent();
                        __builder.CloseElement(); // preview button
                    }
                    __builder.CloseElement(); // placeholder
                }
                __builder.CloseElement(); // thumb

                // Info
                __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__info");
                __builder.OpenElement(seq++, "span"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__name"); __builder.AddAttribute(seq++, "title", file.FileName); __builder.AddContent(seq++, file.FileName); __builder.CloseElement();
                __builder.OpenElement(seq++, "span"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__meta"); __builder.AddContent(seq++, file.FileSizeDisplay); __builder.CloseElement();
                __builder.CloseElement();

                // Actions
                __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__actions");
                if (busy)
                {
                    // Adding an already-cached file to the timeline — local/fast, a spinner is enough.
                    __builder.OpenComponent<TelerikLoader>(seq++);
                    __builder.AddAttribute(seq++, "Type", LoaderType.Pulsing);
                    __builder.AddAttribute(seq++, "Size", ThemeConstants.Loader.Size.Small);
                    __builder.CloseComponent();
                }
                else if (downloading)
                {
                    var pct = _libraryDownloadProgress.TryGetValue(f.Id, out var p) ? p : 0;
                    var pctWhole = (double)(int)Math.Round(pct * 100); // whole-number percent — matches the import dialog's own TelerikProgressBar (Value is an int there too)
                    __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__download-progress");
                    __builder.OpenComponent<TelerikProgressBar>(seq++);
                    __builder.AddAttribute(seq++, "Value", pctWhole);
                    __builder.AddAttribute(seq++, "Max", 100.0);
                    __builder.AddAttribute(seq++, "Indeterminate", pct <= 0);
                    __builder.AddAttribute(seq++, "Class", "bv-clip-card__download-bar");
                    __builder.AddAttribute(seq++, "AriaLabel", $"Downloading {file.FileName}");
                    __builder.CloseComponent();
                    __builder.CloseElement();
                }
                else if (cached)
                {
                    // Phase 150 — downloaded locally, not yet on the timeline. Click again to add.
                    __builder.OpenElement(seq++, "span");
                    __builder.AddAttribute(seq++, CssScope, "");
                    __builder.AddAttribute(seq++, "class", "bv-clip-card__cached-badge");
                    __builder.AddAttribute(seq++, "title", "Downloaded locally — click to add to the timeline");
                    __builder.OpenComponent<TelerikSvgIcon>(seq++);
                    __builder.AddAttribute(seq++, "Icon", (object)SvgIcon.Check);
                    __builder.CloseComponent();
                    __builder.CloseElement();
                }
                else
                {
                    // Item #67 fix — downloading no longer needs ffmpeg at all (see
                    // DownloadAndCacheAsync's own note), so this button is always enabled now,
                    // even before Initialize or while ffmpeg is busy elsewhere.
                    __builder.OpenComponent<TelerikButton>(seq++);
                    __builder.AddAttribute(seq++, "Title",      "Download");
                    __builder.AddAttribute(seq++, "Icon",       (object)SvgIcon.Download);
                    __builder.AddAttribute(seq++, "Size",       ThemeConstants.Button.Size.Small);
                    __builder.AddAttribute(seq++, "FillMode",   ThemeConstants.Button.FillMode.Flat);
                    __builder.AddAttribute(seq++, "ThemeColor", ThemeConstants.Button.ThemeColor.Primary);
                    __builder.CloseComponent();
                }
                __builder.CloseElement();

                __builder.CloseElement(); // card
            }
            __builder.CloseElement(); // grid
        }
    };

