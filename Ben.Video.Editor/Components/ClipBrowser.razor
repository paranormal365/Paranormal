    // ── Library tab ───────────────────────────────────────────────────────────

    private async Task OnTabStateChanged(TabStripStateEventArgs _)
    {
        if (_activeLocalTab != "server") return;

        await EnsureScopeGroupsAsync();

        if (!_libraryFiles.Any() && !_libraryLoading)
            await LoadLibraryAsync();
    }

    /// <summary>
    /// Fetches the cases and visits the scope selector offers, once.
    /// </summary>
    /// <remarks>
    /// Failures are swallowed on purpose and leave the list empty: All and Personal still work
    /// without it, and a media tab that refuses to open because a dropdown could not be populated
    /// would be a much worse outcome than a dropdown that is not offered.
    /// </remarks>
    private async Task EnsureScopeGroupsAsync()
    {
        if (_scopeGroupsLoaded || ScopeSource is null) return;
        _scopeGroupsLoaded = true;

        try { _scopeGroups = await ScopeSource.GetScopeGroupsAsync(); }
        catch (Exception ex) { ErrorLog.Log("ClipBrowser.EnsureScopeGroupsAsync", ex); }

        StateHasChanged();
    }

    // ── Scope changes ────────────────────────────────────────────────────────
    // Each of these reloads the list, because the filtering happens on the server. Selecting a
    // case with no visit chosen means the whole case, which is why changing case clears the visit
    // rather than trying to keep it — a visit from the previous case belongs to nothing here.

    private async Task OnScopeKindChangedAsync(ChangeEventArgs e)
    {
        _scopeKind = e.Value?.ToString() switch
        {
            "personal" => MediaLibraryScopeKind.Personal,
            "case"     => MediaLibraryScopeKind.Case,
            _          => MediaLibraryScopeKind.All,
        };

        if (_scopeKind != MediaLibraryScopeKind.Case)
        {
            _scopeCaseId = null;
            _scopeInvestigationId = null;
        }

        // A case scope with no case picked yet has nothing to ask the server for. Clear the list
        // rather than leaving the previous scope's results under a selector that no longer
        // describes them — the empty state says "Choose a case to see its media", which is both
        // true and the next thing to do.
        if (_scopeKind == MediaLibraryScopeKind.Case && _scopeCaseId is null)
        {
            _libraryLoadGeneration++;   // supersede anything still in flight
            _libraryFiles = [];
            _libraryLoading = false;
            StateHasChanged();
            return;
        }

        await LoadLibraryAsync();
    }

    private async Task OnScopeCaseChangedAsync(ChangeEventArgs e)
    {
        _scopeCaseId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _scopeInvestigationId = null;

        if (_scopeCaseId is null)
        {
            _libraryLoadGeneration++;   // supersede anything still in flight
            _libraryFiles = [];
            _libraryLoading = false;
            StateHasChanged();
            return;
        }
        await LoadLibraryAsync();
    }

    private async Task OnScopeInvestigationChangedAsync(ChangeEventArgs e)
    {
        _scopeInvestigationId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadLibraryAsync();
    }

    /// <summary>
    /// Reloads the server list, whatever state it is in.
    /// </summary>
    /// <remarks>
    /// Public so the editor can call it after publishing a render, which is the one moment the
    /// list is known to be out of date because this editor is what changed it.
    /// </remarks>
    public Task RefreshLibraryAsync() => LoadLibraryAsync();

    private async Task LoadLibraryAsync()
    {
        var generation = ++_libraryLoadGeneration;

        _libraryLoading = true;
        _libraryError   = null;
        _libraryNeedsSignIn = false;
        StateHasChanged();

        IReadOnlyList<MediaLibraryFile> files = [];
        string? error = null;
        var needsSignIn = false;

        try
        {
            files = await MediaLib.GetFilesAsync(CurrentScope);
        }
        catch (MediaLibraryUnauthorizedException)
        {
            // Not an error to describe, a state with an action attached. This used to show either
            // an empty tab or a raw HTTP message, both of which say something untrue about why
            // there is nothing here (2026-09-05 audit, F11 and site-11).
            needsSignIn = true;
        }
        catch (Exception ex)
        {
            // Not ex.Message. On WebAssembly an unreachable server arrives as the browser's own
            // "TypeError: Failed to fetch", which was shown verbatim (2026-09-05 audit, found on
            // screen while verifying the refusal state).
            error = MediaLibraryProblemText.Describe(ex);
            ErrorLog.Log("ClipBrowser.LoadLibraryAsync", ex);
        }

        // A newer scope was chosen while this was in flight. Its results are the answer to a
        // question nobody is asking any more, and writing them would undo the newer selection.
        if (generation != _libraryLoadGeneration) return;

        _libraryFiles     = files;
        _libraryError     = error;
        _libraryNeedsSignIn = needsSignIn;
        _libraryLoading   = false;
        StateHasChanged();

        // Phase 150 — seed the "downloaded locally" badge from a real OPFS check so it survives a
        // reload, instead of only reflecting downloads from the current session. Best-effort: an
        // ExistsAsync failure (or OPFS being unavailable) just leaves that file showing as
        // not-yet-cached, same as a brand-new session.
        foreach (var file in _libraryFiles)
        {
            var ext = System.IO.Path.GetExtension(file.FileName).ToLowerInvariant();
            if (await OPFS.ExistsAsync(file.Id, ext)) _libraryCached.Add(file.Id);
        }
        StateHasChanged();

        // Images are small enough to eagerly thumbnail; fire-and-forget so the list
        // renders immediately and thumbnails pop in as each one finishes.
        if (Ffmpeg.State == FfmpegState.Ready)
            _ = LoadServerImageThumbnailsAsync();
    }

    /// <summary>
    /// Eagerly fetches and caches a real thumbnail for every image on the Server tab.
    /// Silently skipped per-file on any error — the row just keeps its icon placeholder.
    /// </summary>
    private async Task LoadServerImageThumbnailsAsync()
    {
        var images = _libraryFiles.Where(f => !f.IsVideo && !f.IsAudio && !_serverThumbnails.ContainsKey(f.Id));
        foreach (var file in images)
        {
            if (!_serverThumbnailsLoading.Add(file.Id)) continue;
            try
            {
                var bytes     = await MediaLib.DownloadFileAsync(file.Id);
                var memFsName = $"srvthumb_{Guid.NewGuid():N}_{file.FileName}";
                await Ffmpeg.WriteFileFromBytesAsync(memFsName, bytes);
                var mime = GetImageMimeType(file.FileName);
                _serverThumbnails[file.Id] = await Ffmpeg.CreatePreviewUrlAsync(memFsName, mime);
                await Ffmpeg.DeleteFileAsync(memFsName);
            }
            catch (Exception ex)
            {
                // Item #59-#65 flakiness investigation — leaving this row on its icon placeholder
                // is still the right UX (a thumbnail failure for one server file shouldn't block
                // the list), but it was previously completely invisible.
                ErrorLog.Log("ClipBrowser.LoadServerImageThumbnailsAsync", $"thumbnail failed for {file.FileName}: {ex.Message}", ex.ToString());
            }
            finally
            {
                _serverThumbnailsLoading.Remove(file.Id);
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// On-demand preview for a Server-tab video row — downloads the file, grabs a single frame, and
    /// cleans up the temp MEMFS entry. Distinct from <see cref="DownloadAndCacheAsync"/>: nothing is
    /// added to the timeline, OPFS, or clip store — this only populates <see cref="_serverThumbnails"/>.
    /// </summary>
    private async Task LoadServerVideoPreviewAsync(MediaLibraryFile file)
    {
        if (Ffmpeg.State != FfmpegState.Ready) return;
        if (_serverThumbnails.ContainsKey(file.Id)) return;
        if (!_serverThumbnailsLoading.Add(file.Id)) return;
        StateHasChanged();

        try
        {
            var bytes     = await MediaLib.DownloadFileAsync(file.Id);
            var memFsName = $"srvthumb_{Guid.NewGuid():N}_{file.FileName}";
            await Ffmpeg.WriteFileFromBytesAsync(memFsName, bytes);
            var meta   = await Ffmpeg.GetMetadataAsync(memFsName);
            var thumbs = await Ffmpeg.ExtractThumbnailsAsync(memFsName, count: 1, meta.Duration);
            if (thumbs.Length > 0) _serverThumbnails[file.Id] = thumbs[0];
            await Ffmpeg.DeleteFileAsync(memFsName);
        }
        catch (Exception ex)
        {
            ErrorLog.Log("ClipBrowser.LoadServerVideoPreviewAsync", $"preview failed for {file.FileName}: {ex.Message}", ex.ToString());
        }
        finally
        {
            _serverThumbnailsLoading.Remove(file.Id);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Item #59-#65 flakiness investigation, phase 145 (symptom S3) — fires and forgets the
    /// remaining thumbnails for a clip that only got <see cref="ThumbnailPlanner.UpfrontCount"/>
    /// generated synchronously during import. No explicit "idle" detection needed: the request
    /// goes through the same <c>FfmpegService</c> worker lock (phase 142) as everything else, so
    /// it naturally queues behind whatever's currently running and executes whenever the worker
    /// is next free — which in practice IS idle, since nothing else fires immediately after an
    /// import completes.
    /// </summary>
    private void ScheduleLazyThumbnailFill(VideoClip clip, string memFsName, double duration, int upfrontCount, int fullCount)
    {
        if (upfrontCount >= fullCount) return; // the upfront batch already covers the full target
        _ = LazyFillThumbnailsAsync(clip, memFsName, duration, fullCount);
    }

    private async Task LazyFillThumbnailsAsync(VideoClip clip, string memFsName, double duration, int fullCount)
    {
        try
        {
            // Re-requesting the FULL count (not just the delta) rather than trying to append —
            // extractThumbnails' per-frame timestamps depend on the requested count (interval =
            // duration / (count + 1)), so a 3-frame batch and an 8-frame batch land at genuinely
            // different timestamps; there's no clean "delta" to append. The redundant regeneration
            // of the first few frames is cheap and happens off the import's own critical path.
            var thumbs = await SidecarMedia.TryExtractThumbnailsAsync(clip.Id, clip.OpfsExt, fullCount, duration, CancellationToken.None)
                         ?? await Ffmpeg.ExtractThumbnailsAsync(memFsName, fullCount, duration);
            var previous = clip.ThumbnailUrls;
            clip.ThumbnailUrls = [.. thumbs];
            RegisterWasmThumbnails(thumbs);

            // Item #62 phase 170 — swap FIRST, revoke LAST, and only what nothing else holds.
            //
            // Ordering (mechanism 1): this used to revoke before NotifyChanged(), so for the gap
            // between the two the DOM still carried <img src="{old}"> — VideoTimeline's thumbstrip
            // and ClipBrowser's own card — pointing at blobs the browser had already released.
            // Any repaint or lazy re-request in that window 404s. Nothing throws and the strip is
            // replaced a moment later, which is exactly why item #62 read as "harmless" for four
            // phases. This is the same swap-then-revoke rule phase 144 established for the preview
            // URL; it simply never reached thumbnails.
            Clips.NotifyChanged();
            await Task.Yield(); // let the queued render actually flush before releasing anything

            // Ownership (mechanism 2): strips share string instances across duplicated clips, and
            // the import row holds thumbs[0] — see ThumbnailRevokePlan for why that makes a
            // wholesale revoke wrong.
            var stillReferenced = Clips.AllVideoClips
                .Where(c => !ReferenceEquals(c, clip))
                .SelectMany(c => c.ThumbnailUrls)
                .Concat(clip.ThumbnailUrls)
                .Concat(_importStatuses.Select(s => s.PreviewUrl).OfType<string>());

            foreach (var url in ThumbnailRevokePlan.Orphaned(previous, stillReferenced))
            {
                // Item #70 phase 159 — the replaced strip can contain URLs from EITHER path, and
                // they must be revoked by their own owner: the wasm revoke goes through the
                // phase-142 worker lock (correct for MEMFS-backed URLs, but needless contention
                // for a sidecar one) and phase 144's registry rejects a mismatched owner outright.
                try
                {
                    if (SidecarMedia.OwnsThumbnail(url))
                    {
                        // RevokeThumbnailAsync reports to BlobLifecycle itself — reporting here too
                        // would consume the registration and make the second call look untracked.
                        await SidecarMedia.RevokeThumbnailAsync(url);
                    }
                    else
                    {
                        BlobLifecycle.Revoking(url, WasmThumbnailOwner);
                        await Ffmpeg.RevokePreviewUrlAsync(url);
                    }
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            // Non-fatal — the clip already has its upfront thumbnails; losing the lazy-filled
            // remainder just means a shorter thumbnail strip, not a broken import.
            ErrorLog.Log($"ClipBrowser.LazyFillThumbnails({clip.Name})", ex);
        }
    }

    // Phase 150 — dispatcher for a Server-tab card click: download+cache when the file isn't
    // local yet, add-to-timeline when it already is. Cards no longer combine both into one click.
    private Task OnLibraryCardClickedAsync(MediaLibraryFile file) =>
        _libraryCached.Contains(file.Id)
            ? AddCachedFileToTimelineAsync(file)
            : DownloadAndCacheAsync(file);

    /// <summary>
    /// Downloads a Server-tab file and OPFS-caches it under the library file's own stable Id —
    /// WITHOUT adding anything to the timeline. See the design note on <see cref="_libraryCached"/>.
    /// </summary>
    private async Task DownloadAndCacheAsync(MediaLibraryFile file)
    {
        // Item #67 fix — this method never touched ffmpeg in the first place (download + OPFS
        // write only; see the class doc comment on DownloadAndCacheAsync's OPFS write), so the
        // upfront "Click Initialize" gate that used to guard the old combined download+import
        // flow was pure dead weight once phase 150 split the two steps apart. Removed outright
        // rather than just fixing its wording — a user can now download/cache a Server-tab file
        // even while ffmpeg is still loading or busy elsewhere; only AddCachedFileToTimelineAsync
        // (which actually calls into ffmpeg) needs a readiness check.
        _errorMessage = null;
        if (_libraryCached.Contains(file.Id)) return; // already cached — OnLibraryCardClickedAsync routes elsewhere
        if (!_libraryDownloading.Add(file.Id)) return; // already downloading — ignore the duplicate dispatch
        _libraryDownloadProgress[file.Id] = 0;
        StateHasChanged();

        try
        {
            var reporter = new Progress<double>(p =>
            {
                _libraryDownloadProgress[file.Id] = p;
                InvokeAsync(StateHasChanged);
            });

            var ext = System.IO.Path.GetExtension(file.FileName).ToLowerInvariant();

            // The browser fetches it itself when the host can say where from. Under Blazor Server
            // the alternative pulls the file into the server's memory, copies it again into a byte
            // array, and ships it over the circuit — three copies of a file the browser could have
            // fetched directly, with a 2 GB ceiling on the way (2026-09-05 audit, site-2).
            var directUrl = await MediaLib.GetDownloadUrlAsync(file.Id);
            if (directUrl is not null)
            {
                var written = await OPFS.DownloadToClipAsync(directUrl, file.Id, ext);
                if (written >= 0)
                {
                    _libraryCached.Add(file.Id);
                    return;
                }

                // Fell through: the direct fetch failed, so try the way that always worked.
                ErrorLog.Log($"ClipBrowser.DownloadAndCacheAsync({file.FileName})",
                    "Direct download failed; falling back to fetching through the host.");
            }

            byte[] bytes;
            try
            {
                bytes = await MediaLib.DownloadFileAsync(file.Id, CancellationToken.None, reporter);
            }
            catch (OperationCanceledException ocex)
            {
                // Item #66 (phase 149) — the provider's own internal timeout fired. Blazor WASM's
                // single main thread hosts both this HttpClient call's continuations and all the
                // JS-interop marshaling for ffmpeg's own worker traffic, so heavy concurrent
                // ffmpeg activity (e.g. the Server tab's own automatic eager thumbnail prefetch)
                // can measurably delay an otherwise-fast download's completion callback —
                // live-reproduced at 31.2s for a normally-68ms request. The provider's own
                // HttpClient.Timeout is generous for the same reason.
                throw new TimeoutException($"Downloading {file.FileName} timed out.", ocex);
            }

            await OPFS.WriteFromBytesAsync(file.Id, ext, bytes);
            _libraryCached.Add(file.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Download failed: {ex.Message}";
            ErrorLog.Log($"ClipBrowser.DownloadAndCacheAsync({file.FileName})", ex);
        }
        finally
        {
            _libraryDownloading.Remove(file.Id);
            _libraryDownloadProgress.Remove(file.Id);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Adds an already-cached (<see cref="_libraryCached"/>) Server-tab file to the timeline. No
    /// network access — reads the cached OPFS entry (keyed by the library file's Id) and copies it
    /// under a fresh clip Id, mirroring how every other placed clip owns its own independent OPFS
    /// copy (see <see cref="SourceMounter"/>), then runs the same
    /// metadata/thumbnail/add-to-timeline tail <see cref="DownloadAndCacheAsync"/> used to run
    /// inline before this phase split the two steps apart.
    /// </summary>
    private async Task AddCachedFileToTimelineAsync(MediaLibraryFile file)
    {
        if (!_libraryImporting.Add(file.Id)) return; // already adding this file — ignore the duplicate dispatch
        _errorMessage = null;

        var status = new FileImportStatus
        {
            FileName  = file.FileName,
            SizeBytes = file.FileSize,
            IsVideo   = file.IsVideo,
        };
        _importStatuses.Add(status);
        _showImportWindow = true;
        StateHasChanged();

        try
        {
            // Item #67 fix — wait out a legitimate Processing state (e.g. an auto-preview
            // re-render already in flight) instead of hard-rejecting with a message that wrongly
            // implies the worker needs re-initializing. Matches phase 145's original "queue on
            // the mutex" design decision, never actually wired into this call site until now.
            if (!await WaitForFfmpegReadyAsync(status)) return;

            var clipId = Guid.NewGuid();
            var ext    = System.IO.Path.GetExtension(file.FileName).ToLowerInvariant();

            Update(status, ImportStage.Writing);
            var cachedFile = await OPFS.ReadAsJSFileAsync(file.Id, ext);
            if (cachedFile is null)
            {
                // The cache entry vanished by some path other than this component (OPFS cleared
                // externally, quota eviction, etc.) — the badge lied. Drop the stale cached-state
                // and fall back to a fresh download rather than failing outright.
                _libraryCached.Remove(file.Id);
                throw new FileNotFoundException($"{file.FileName} is no longer available locally — try downloading it again.");
            }

            // Item #38 phase A/B pattern, same as every other placed clip: OPFS is the copy of
            // record, the main ffmpeg instance mounts it (zero-copy WORKERFS) rather than a full
            // MEMFS byte write — falling back to a real write only when mounting isn't possible.
            await OPFS.WriteAsync(clipId, ext, cachedFile);
            var memFsName = await Mounter.MountAsync(clipId, ext);
            if (memFsName is null)
            {
                memFsName = $"lib_{Guid.NewGuid():N}_{file.FileName}";
                await Ffmpeg.WriteFileAsync(memFsName, cachedFile);
            }

            if (file.IsVideo || (!file.IsAudio && !IsImageFile(file.FileName)))
            {
                Update(status, ImportStage.Metadata, 33);
                // Item #70 phase 159 — try the native sidecar first (ffprobe out-of-process, off
                // the WASM main thread); null means not connected/not capable/failed, and the
                // existing wasm path runs exactly as before.
                var meta  = await SidecarMedia.TryGetMetadataAsync(clipId, ext, CancellationToken.None)
                            ?? await Ffmpeg.GetMetadataAsync(memFsName);
                status.MetaText = $"{FormatDuration(meta.Duration)} · {meta.Width}×{meta.Height}";

            Update(status, ImportStage.Thumbnails, 66);
                // Item #59-#65 flakiness investigation, phase 145 (symptom S3) — only a small
                // upfront batch generates synchronously (blocking this import); the rest fill in
                // lazily afterward through ScheduleLazyThumbnailFill, per the user's explicit
                // decision to accept a smaller initial strip for a faster import.
                var fullCount = ThumbnailPlanner.FullCount(meta.Duration);
                var upfrontCount = ThumbnailPlanner.UpfrontCount(meta.Duration);
                var thumbs = await SidecarMedia.TryExtractThumbnailsAsync(clipId, ext, upfrontCount, meta.Duration, CancellationToken.None)
                             ?? await Ffmpeg.ExtractThumbnailsAsync(memFsName, upfrontCount, meta.Duration);
                RegisterWasmThumbnails(thumbs);
                if (thumbs.Length > 0) await SetThumbnailPreviewAsync(status, thumbs[0]);

                var clip = new VideoClip
                {
                    Id = clipId, Name = file.FileName, MemFsName = memFsName,
                    Duration = meta.Duration, Width = meta.Width, Height = meta.Height,
                    HasAudio = meta.HasAudio,
                    ThumbnailUrls = [.. thumbs], OpfsExt = ext,
                };
                // OnAddToTimeline (→ VideoEditor.AddClipToTimeline) both registers the clip on
                // the primary track AND computes its TimelinePosition — calling Clips.AddClip
                // here too double-adds the same clip instance to the track's Items list.
                await OnAddToTimeline.InvokeAsync(clip);
                ScheduleLazyThumbnailFill(clip, memFsName, meta.Duration, upfrontCount, fullCount);
            }
            else if (file.IsAudio)
            {
                Update(status, ImportStage.Audio, 50);
                var meta   = await SidecarMedia.TryGetMetadataAsync(clipId, ext, CancellationToken.None)
                             ?? await Ffmpeg.GetMetadataAsync(memFsName);
                var blobUrl = await Ffmpeg.CreatePreviewUrlAsync(memFsName, file.ContentType);
                status.MetaText = FormatDuration(meta.Duration);

                var audioClip = new AudioClip
                {
                    Id = clipId, Name = file.FileName, MemFsName = memFsName,
                    Duration = meta.Duration, BlobUrl = blobUrl, OpfsExt = ext,
                };
                // Without an audio track to land on, the clip would silently vanish —
                // decoded and reported "done" but never placed anywhere. Create one
                // on demand, same as the always-present default video track — but
                // only when the host has actually enabled the AudioTracks feature.
                if (Options.AudioTracks)
                {
                    var t = Clips.AudioTracks.FirstOrDefault() ?? Clips.AddAudioTrack();
                    audioClip.TimelinePosition = t.Items.Any() ? t.Items.Max(i => i.TimelinePosition + i.Duration) : 0;
                    Clips.AddClipToTrack(t.Id, audioClip);
                }
                await OnAudioClipAdded.InvokeAsync(audioClip);
            }
            else
            {
                var mime    = GetImageMimeType(file.FileName);
                var thumbUrl = await Ffmpeg.CreatePreviewUrlAsync(memFsName, mime);
                await SetThumbnailPreviewAsync(status, thumbUrl);

                // Item #9 — the media-library import path never populated Width/Height at all
                // (the local-file path at ImportImageFileAtIndexAsync always has). Export no
                // longer depends on these (it scales to the project canvas), but they are the
                // clip's only record of its real size, so leaving them 0 keeps the two import
                // paths producing different clips from the same file.
                var libDims = await (await DomAsync()).InvokeAsync<int[]>("imageDimensions", thumbUrl);
                int libW = libDims.Length > 0 ? libDims[0] : 0, libH = libDims.Length > 1 ? libDims[1] : 0;
                if (libW > 0) status.MetaText = $"{libW}×{libH}";

                var imgTrack = Clips.PrimaryVideoTrack;
                var imgPos   = imgTrack.Items.Any() ? imgTrack.Items.Max(i => i.TimelinePosition + i.Duration) : 0;
                Clips.AddImageClip(new ImageClip
                {
                    Id = clipId, Name = file.FileName, MemFsName = memFsName,
                    Duration = 5.0, Width = libW, Height = libH,
                    ThumbnailUrl = thumbUrl, TimelinePosition = imgPos, OpfsExt = ext,
                });
            }
            Update(status, ImportStage.Done, 100);
        }
        catch (Exception ex)
        {
            // status.ErrorText already surfaces this in the transient import-window row (that
            // path was never silent); ErrorLog additionally makes it exportable/persistent past
            // the row's own lifetime (CloseImportWindow clears _importStatuses once every row is
            // done) — item #59-#65 flakiness investigation.
            status.ErrorText = $"{status.Stage}: {ex.Message}";
            ErrorLog.Log($"ClipBrowser.AddCachedFileToTimelineAsync({file.FileName})", ex);
            Update(status, ImportStage.Error);
        }
        finally
        {
            _libraryImporting.Remove(file.Id);
        }
    }

    // Item #67 fix — how long to wait out a Processing state before giving up. Generous, matching
    // this codebase's general timeout scale elsewhere (see FfmpegTimeoutPolicy), since a healthy
    // but slow operation (e.g. a multi-clip concatClips re-render) can legitimately take 40+
    // seconds — confirmed live during the phase 141-147 flakiness investigation.
    private const int FfmpegBusyWaitTimeoutMs = 60_000;
    private const int FfmpegBusyPollIntervalMs = 250;

    /// <summary>
    /// Waits out a legitimate <see cref="FfmpegState.Processing"/> state instead of hard-rejecting
    /// with a message that wrongly implies the worker needs re-initializing — the gate this
    /// replaced fired even for a perfectly healthy, if slow, operation elsewhere (confirmed live:
    /// a two-clip <c>concatClips</c> re-render took 44+ seconds). Only <see cref="FfmpegState.Idle"/>/
    /// <see cref="FfmpegState.LoadingCore"/>/<see cref="FfmpegState.Error"/> fail immediately, each
    /// with its own accurate message; a wedged worker (per the phase 143 watchdog) or a wait
    /// exceeding <see cref="FfmpegBusyWaitTimeoutMs"/> also fail, rather than waiting forever.
    /// </summary>
    private async Task<bool> WaitForFfmpegReadyAsync(FileImportStatus status)
    {
        var immediateFailure = FfmpegBusyPolicy.ImmediateFailureMessage(Ffmpeg.State);
        if (immediateFailure is not null)
        {
            status.ErrorText = immediateFailure;
            Update(status, ImportStage.Error);
            return false;
        }
        if (Ffmpeg.State == FfmpegState.Ready) return true;

        // Processing — wait for it to clear rather than rejecting outright.
        Update(status, ImportStage.Queued);
        var waited = 0;
        while (Ffmpeg.State == FfmpegState.Processing && waited < FfmpegBusyWaitTimeoutMs)
        {
            if (Ffmpeg.IsWorkerWedged)
            {
                status.ErrorText = FfmpegBusyPolicy.WedgedMessage;
                Update(status, ImportStage.Error);
                return false;
            }
            await Task.Delay(FfmpegBusyPollIntervalMs);
            waited += FfmpegBusyPollIntervalMs;
        }

        if (Ffmpeg.State != FfmpegState.Ready)
        {
            status.ErrorText = FfmpegBusyPolicy.TimedOutWaitingMessage;
            Update(status, ImportStage.Error);
            return false;
        }
        return true;
    }

    // ── File picking ──────────────────────────────────────────────────────────

    public async Task PickFilesAsync()
        // Audit #7 — this used to be `getElementById(...).click()`, which throws a TypeError when
        // the element is absent. That is not hypothetical: the input is only "always rendered"
        // relative to ClipBrowser's OWN internal @if — the whole component unmounts when the Media
        // & Properties panel is closed, so clicking the toolbar's Open button with that panel shut
        // null-dereferenced and took down the entire circuit ("An unhandled error has occurred",
        // requiring a full reload). The optional call makes the crash structurally impossible;
        // VideoEditor.OpenFilesAsync is what makes the button actually *work* in that state.
        => await (await DomAsync()).InvokeVoidAsync("click", "#bv-file-input", false);

    private void OnFfmpegStateChanged() => InvokeAsync(StateHasChanged);

    // ── Pin / float window ────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // Item #51 — mark-in/out (and any other external mutation of a library clip, e.g. trim)
        // happens on the same VideoClip instance this grid reads via Clips.AllVideoClips, not via
        // a parameter change, so this component needs its own OnChange subscription to see it —
        // OnParametersSet alone misses shared-state changes (same lesson as phase 95/LiveOverlayPreview).
        Clips.OnChange += StateHasChanged;

        // Same reasoning, for the ffmpeg service: this grid's cards and their controls read its
        // state directly, and a state change is not a parameter change, so nothing would re-render
        // them. Item 94 — a control that goes on showing what was true at its last paint.
        Ffmpeg.OnStateChanged += OnFfmpegStateChanged;

        _ = RefreshStorageUsageAsync();

        try
        {
            var stored = await (await StorageAsync()).InvokeAsync<string?>("getItem", PinStateKey);
            _isPinned = stored == "true";
        }
        catch { /* localStorage unavailable */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _dragBridgeModule = await JS.InvokeAsync<IJSObjectReference>(
                "benImportEditorModule", "js/clipDragBridge.js");
            _dragSourceRef = DotNetObjectReference.Create(this);
            await _dragBridgeModule.InvokeVoidAsync("registerDragSource", _dragSourceRef);
        }
        catch { /* JS interop unavailable (e.g. prerendering) — pointer-based drag stays inert */ }
    }

    public async ValueTask DisposeAsync()
    {
        Clips.OnChange        -= StateHasChanged;
        Ffmpeg.OnStateChanged -= OnFfmpegStateChanged;

        // Audit #4 — release the cached interop module handles. Guarded because teardown races
        // circuit shutdown: once the circuit is gone the module is already unreachable and
        // disposing it throws, which must not surface as an error during a normal navigation.
        if (_dom is not null)
        {
            try { await _dom.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _dom = null;
        }
        if (_storage is not null)
        {
            try { await _storage.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _storage = null;
        }

        Clips.OnChange -= StateHasChanged;

        if (_dragBridgeModule is not null)
        {
            try { await _dragBridgeModule.InvokeVoidAsync("unregisterDragSource"); } catch { }
            await _dragBridgeModule.DisposeAsync();
        }
        _dragSourceRef?.Dispose();
    }

    private async Task TogglePinAsync()
    {
        _isPinned = !_isPinned;
        await SavePinStateAsync();
        StateHasChanged();
    }

    private async Task OnWindowVisibleChangedAsync(bool visible)
    {
        if (!visible)
        {
            _isPinned = false;
            await SavePinStateAsync();
            StateHasChanged();
        }
    }

    private async Task SavePinStateAsync()
    {
        try
        {
            await (await StorageAsync()).InvokeVoidAsync("setItem", PinStateKey, _isPinned ? "true" : "false");
        }
        catch { /* localStorage unavailable */ }
    }

    private async Task OnFileInputChangeAsync(ChangeEventArgs _)
    {
        _errorMessage = null;
        try
        {
            var count = await (await DomAsync()).InvokeAsync<int>("fileCount", "bv-file-input");
            if (count == 0) return;

            _importStatuses.Clear();
            for (var i = 0; i < count; i++)
            {
                var dom   = await DomAsync();
                var name  = await dom.InvokeAsync<string>("fileName", "bv-file-input", i);
                var size  = await dom.InvokeAsync<long>  ("fileSize", "bv-file-input", i);
                _importStatuses.Add(new FileImportStatus
                {
                    FileName  = name,
                    SizeBytes = size,
                    IsVideo   = !IsAudioFile(name) && !IsImageFile(name),
                });
            }
            _showImportWindow = true;
            StateHasChanged();

            // Generate instant browser preview URLs before touching ffmpeg
            for (var i = 0; i < count; i++)
            {
                var status = _importStatuses[i];
                Update(status, ImportStage.Preview);
                try
                {
                    var url = await (await DomAsync()).InvokeAsync<string>("fileObjectUrl", "bv-file-input", i);
                    status.PreviewUrl = url;
                    // This one IS an object URL over the picked file, so a video file really does
                    // want a <video> here — it's the later thumbnail swap that changes the kind.
                    status.PreviewIsVideo = status.IsVideo;
                    StateHasChanged();
                }
                catch (Exception ex) { ErrorLog.Log("ClipBrowser.PreviewUrl", $"preview failed for {status.FileName} (non-fatal): {ex.Message}", ex.ToString()); }
            }

            // Import each file. Item #59-#65 flakiness investigation, phase 145 — batched so
            // ClipStore.OnChange (and therefore VideoEditor's auto-preview reschedule) fires at
            // most once for the whole import, after the last clip lands, instead of once per file.
            using (Clips.BeginBatch())
            {
                for (var i = 0; i < count; i++)
                {
                    var status = _importStatuses[i];

                    // Every local import gets a real token, so the Cancel button beside it does
                    // something. It used to be rendered only when Cts was set, which the local
                    // path never did — but a half-gigabyte file being written to storage, probed
                    // and turned into a filmstrip is exactly the case somebody wants to stop
                    // (2026-09-05 audit, media-9).
                    status.Cts?.Dispose();
                    status.Cts = new CancellationTokenSource();
                    var ct = status.Cts.Token;

                    try
                    {
                        ct.ThrowIfCancellationRequested();

                        // The browser's own type first, the extension second — see
                        // MediaKindRouter. Two extension lists used to decide, and anything they
                        // did not name took the video path, so a .heic or a .caf became a 0x0
                        // video clip with an empty filmstrip (2026-09-05 audit, media-panel-8).
                        var contentType = await (await DomAsync())
                            .InvokeAsync<string>("fileType", "bv-file-input", i);

                        switch (MediaKindRouter.Decide(status.FileName, contentType))
                        {
                            case MediaKind.Audio: await ImportAudioFileAtIndexAsync(i, status, ct); break;
                            case MediaKind.Image: await ImportImageFileAtIndexAsync(i, status, ct); break;
                            default:              await ImportVideoFileAtIndexAsync(i, status, ct); break;
                        }
                    }
                    catch (OperationCanceledException)
                    {
                        // Asked for, not gone wrong: it reads as cancelled rather than failed, and
                        // the rest of the batch carries on.
                        Update(status, ImportStage.Cancelled);
                    }
                    catch (Exception ex)
                    {
                        status.ErrorText = ex.Message;
                        ErrorLog.Log($"ClipBrowser.ImportLocalFile({status.FileName})", ex);
                        Update(status, ImportStage.Error);
                    }
                }
            }

            if (_importStatuses.All(s => s.Stage is ImportStage.Done or ImportStage.Cancelled))
            {
                await Task.Delay(1200);
                CloseImportWindow();
            }

            await (await DomAsync()).InvokeVoidAsync("clearFileInput", "bv-file-input");
            await RefreshStorageUsageAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; ErrorLog.Log("ClipBrowser.OnFilesSelected", ex); }
        finally { _loading = false; StateHasChanged(); }
    }

    // ── Import methods ────────────────────────────────────────────────────────

    /// <summary>
    /// Item #38 phase B — writes <paramref name="fileRef"/> to OPFS under <paramref name="clipId"/>
    /// then mounts that OPFS copy into the main ffmpeg instance (zero-copy WORKERFS, no MEMFS byte
    /// copy at all). Falls back to a normal <see cref="FfmpegService.WriteFileAsync"/> of the same
    /// <paramref name="fileRef"/> when mounting isn't possible (OPFS unavailable, or the mount call
    /// fails for any other reason) — import always succeeds either way, just without the memory win
    /// in the fallback case, exactly matching every import path's behavior before this phase.
    /// </summary>
    private async Task<string> WriteAndMountAsync(
        Guid clipId, string ext, string fallbackPrefix, string fileName, IJSObjectReference fileRef)
    {
        await OPFS.WriteAsync(clipId, ext, fileRef);
        var mounted = await Mounter.MountAsync(clipId, ext);
        if (mounted is not null) return mounted;

        var memFsName = $"{fallbackPrefix}_{Guid.NewGuid():N}_{fileName}";
        await Ffmpeg.WriteFileAsync(memFsName, fileRef);
        return memFsName;
    }

    private async Task ImportVideoFileAtIndexAsync(
        int index, FileImportStatus status, CancellationToken ct)
    {
        IJSObjectReference? fileRef = null;
        try
        {
            fileRef = await (await DomAsync()).InvokeAsync<IJSObjectReference>(
                "fileAt", "bv-file-input", index);
            var clipId = Guid.NewGuid();
            var ext    = System.IO.Path.GetExtension(status.FileName).ToLowerInvariant();

            Update(status, ImportStage.Writing);
            var memFsName = await WriteAndMountAsync(clipId, ext, "input", status.FileName, fileRef);
            status.MemFsBytes = status.SizeBytes;

            Update(status, ImportStage.Metadata, 33);
            // Item #70 phase 159 — sidecar first, wasm on null (see AddCachedFileToTimelineAsync).
            var meta = await SidecarMedia.TryGetMetadataAsync(clipId, ext, ct)
                       ?? await Ffmpeg.GetMetadataAsync(memFsName);
            status.MetaText = $"{FormatDuration(meta.Duration)} · {meta.Width}×{meta.Height}";

            ct.ThrowIfCancellationRequested();
            Update(status, ImportStage.Thumbnails, 66);
            var fullCount = ThumbnailPlanner.FullCount(meta.Duration);
            var upfrontCount = ThumbnailPlanner.UpfrontCount(meta.Duration);
            var thumbs = await SidecarMedia.TryExtractThumbnailsAsync(clipId, ext, upfrontCount, meta.Duration, ct)
                         ?? await Ffmpeg.ExtractThumbnailsAsync(memFsName, upfrontCount, meta.Duration);
            RegisterWasmThumbnails(thumbs);
            if (thumbs.Length > 0) await SetThumbnailPreviewAsync(status, thumbs[0]);

            var videoClip = new VideoClip
            {
                Id = clipId, Name = status.FileName, OriginalFileName = status.FileName, MemFsName = memFsName,
                Duration = meta.Duration, Width = meta.Width, Height = meta.Height,
                    HasAudio = meta.HasAudio,
                ThumbnailUrls = [.. thumbs], OpfsExt = ext,
            };
            // Into the media bin, not straight onto the timeline. Placing is a separate, deliberate
            // step — except for the very first thing brought into an empty project, where nobody
            // wants to pick a video and then be shown an empty timeline (2026-09-05 audit,
            // media-panel-3 / plan D3).
            var placeIt = Options.AutoPlaceFirstImport && Clips.TotalDuration <= 0;
            Clips.AddToBin(videoClip);
            if (placeIt) await OnAddToTimeline.InvokeAsync(videoClip);

            ScheduleLazyThumbnailFill(videoClip, memFsName, meta.Duration, upfrontCount, fullCount);
            Update(status, ImportStage.Done, 100);
        }
        finally { if (fileRef is not null) await fileRef.DisposeAsync(); }
    }

    private async Task ImportImageFileAtIndexAsync(
        int index, FileImportStatus status, CancellationToken ct)
    {
        if (!Options.ImageClips)
        {
            // It used to mark the row Done at 100% and add nothing, so the import window reported
            // a success that produced no clip (2026-09-05 audit, F8 / ClipBrowser image path).
            status.ErrorText = "Pictures are switched off in this editor.";
            Update(status, ImportStage.Error);
            return;
        }
        IJSObjectReference? fileRef = null;
        try
        {
            fileRef = await (await DomAsync()).InvokeAsync<IJSObjectReference>(
                "fileAt", "bv-file-input", index);
            var imgClipId2 = Guid.NewGuid();
            var imgExt2    = System.IO.Path.GetExtension(status.FileName).ToLowerInvariant();

            Update(status, ImportStage.Writing);
            var memFsName = await WriteAndMountAsync(imgClipId2, imgExt2, "img", status.FileName, fileRef);
            status.MemFsBytes = status.SizeBytes;

            ct.ThrowIfCancellationRequested();
            Update(status, ImportStage.Metadata, 50);
            var mime    = GetImageMimeType(status.FileName);
            var thumbUrl = await Ffmpeg.CreatePreviewUrlAsync(memFsName, mime);
            await SetThumbnailPreviewAsync(status, thumbUrl);

            // Audit #4 — the eval version read naturalWidth synchronously on the statement after
            // setting src, so it returned [0,0] essentially always. domInterop.imageDimensions
            // awaits decode, which is what makes this value real.
            var dims = await (await DomAsync()).InvokeAsync<int[]>("imageDimensions", thumbUrl);
            int w = dims.Length > 0 ? dims[0] : 0, h = dims.Length > 1 ? dims[1] : 0;
            if (w > 0) status.MetaText = $"{w}×{h}";

            // Where the track really ends: by each item's trimmed length, and ignoring overlays,
            // which sit above the picture rather than after it. The old sum used the untrimmed
            // Duration of everything on the track, so an import after a trimmed clip landed in
            // empty space (2026-09-05 audit, F8).
            var imgTrack2  = Clips.PrimaryVideoTrack;
            var imgPos2    = TrackLayout.EndOf(imgTrack2);

            var imageClip = new ImageClip
            {
                Id               = imgClipId2,
                Name             = status.FileName,
                OriginalFileName = status.FileName,
                MemFsName        = memFsName,
                Duration         = 5.0,
                Width            = w,
                Height           = h,
                ThumbnailUrl     = thumbUrl,
                TimelinePosition = imgPos2,
                OpfsExt          = imgExt2,
            };

            var placeImage = Options.AutoPlaceFirstImport && Clips.TotalDuration <= 0;
            Clips.AddToBin(imageClip);
            if (placeImage) await OnAddImageToTimeline.InvokeAsync(imageClip);
            Update(status, ImportStage.Done, 100);
        }
        finally { if (fileRef is not null) await fileRef.DisposeAsync(); }
    }

    private async Task ImportAudioFileAtIndexAsync(
        int index, FileImportStatus status, CancellationToken ct)
    {
        IJSObjectReference? fileRef = null;
        try
        {
            fileRef = await (await DomAsync()).InvokeAsync<IJSObjectReference>(
                "fileAt", "bv-file-input", index);
            var audioClipId = Guid.NewGuid();
            var audioExt    = System.IO.Path.GetExtension(status.FileName).ToLowerInvariant();

            Update(status, ImportStage.Writing);
            var memFsName = await WriteAndMountAsync(audioClipId, audioExt, "audio", status.FileName, fileRef);
            status.MemFsBytes = status.SizeBytes;

            Update(status, ImportStage.Audio, 50);
            var meta    = await SidecarMedia.TryGetMetadataAsync(audioClipId, audioExt, ct)
                          ?? await Ffmpeg.GetMetadataAsync(memFsName);
            var blobUrl = await Ffmpeg.CreatePreviewUrlAsync(memFsName, "audio/mpeg");
            status.MetaText = FormatDuration(meta.Duration);

            var clip = new AudioClip
            {
                Id = audioClipId, Name = status.FileName, OriginalFileName = status.FileName, MemFsName = memFsName,
                Duration = meta.Duration, BlobUrl = blobUrl, OpfsExt = audioExt,
            };
            // Without an audio track to land on the clip would be decoded, reported "done" and
            // placed nowhere — which is what used to happen when the host had AudioTracks off: the
            // import window said it worked and nothing appeared (2026-09-05 audit, F2). One is
            // created on demand, exactly like the always-present video track; a host that has
            // deliberately switched audio off is told, not ignored.
            if (!Options.AudioTracks)
            {
                status.ErrorText = "Audio tracks are switched off in this editor.";
                Update(status, ImportStage.Error);
                return;
            }

            // The bin first; audio is placed on its own track when asked for, or straight away when
            // it is the first thing in an empty project.
            var placeAudio = Options.AutoPlaceFirstImport && Clips.TotalDuration <= 0;
            Clips.AddToBin(clip);
            if (placeAudio) await OnAddAudioToTimeline.InvokeAsync(clip);

            await OnAudioClipAdded.InvokeAsync(clip);
            Update(status, ImportStage.Done, 100);
        }
        finally { if (fileRef is not null) await fileRef.DisposeAsync(); }
    }

