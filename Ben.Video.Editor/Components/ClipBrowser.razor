    private static string StageBadge(ImportStage s) => s switch
    {
        ImportStage.Queued      => "Queued",
        ImportStage.Preview     => "Preview…",
        ImportStage.Downloading => "Fetching…",   // downloading bytes from the web API
        ImportStage.Writing     => "To WASM…",    // writing into ffmpeg MEMFS (local)
        ImportStage.Metadata    => "Reading…",
        ImportStage.Thumbnails  => "Thumbnails…",
        ImportStage.Audio       => "Audio…",
        ImportStage.Done        => "Done ✓",
        ImportStage.Cancelled   => "Cancelled",
        ImportStage.Error       => "Error ✗",
        _                       => string.Empty,
    };

    private static ISvgIcon FileTypeIcon(string name)
    {
        var ext = System.IO.Path.GetExtension(name).ToLowerInvariant();
        return ext is ".mp3" or ".wav" or ".aac" or ".ogg" or ".flac" or ".m4a" or ".opus" or ".wma"
            ? SvgIcon.FileAudio
            : ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp"
                ? SvgIcon.Image
                : SvgIcon.FileVideo;
    }

    private void Update(FileImportStatus s, ImportStage stage, int pct = 0)
    {
        s.Stage    = stage;
        s.Progress = pct;
        InvokeAsync(StateHasChanged);
    }

    private void CloseImportWindow()
    {
        _showImportWindow = false;
        _importStatuses.Clear();
    }

