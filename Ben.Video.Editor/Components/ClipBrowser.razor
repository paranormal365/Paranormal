    }

    private void RemoveClip(VideoClip clip)
    {
        // A card is a source now, so this takes it out of the media bin. Anything already placed
        // from it keeps working: each placement holds its own arrangement and points at the same
        // file (2026-09-05 audit, plan D3).
        if (_selectedId == clip.Id) _selectedId = null;
        Clips.RemoveFromBin(clip.Id);
    }

    // These cards are sources now, so removing one takes it out of the media bin. Anything already
    // placed from it keeps working — it holds its own arrangement and points at the same file.
    private void RemoveAudioClip(AudioClip clip) => Clips.RemoveFromBin(clip.Id);

    private void RemoveImageClip(ImageClip clip) => Clips.RemoveFromBin(clip.Id);

    // ── Utilities ─────────────────────────────────────────────────────────────

    // One place decides what a file is — see MediaKindRouter. These remain for the callers that
    // only have a name to go on (the server library's own listing carries its content type).
    private static bool IsAudioFile(string name) =>
        MediaKindRouter.Decide(name) == MediaKind.Audio;

    private static bool IsImageFile(string name) =>
        MediaKindRouter.Decide(name) == MediaKind.Image;

    private static string GetImageMimeType(string name) => MediaKindRouter.ImageMimeType(name);

    /// <summary>
    /// The card's second line: how long the source is, and how many times it is on the timeline.
    /// </summary>
    /// <remarks>
    /// The count is what tells the bin apart from the edit. Without it, a card gives no clue
    /// whether it is already in use — which is the question anybody looking at a bin is asking.
    /// </remarks>
    private string CardMeta(TrackItem source, double durationSeconds)
    {
        var used = Clips.TimesOnTimeline(source.Id);
        var when = FormatDuration(durationSeconds);

        return used switch
        {
            0 => when,
            1 => $"{when} · on timeline",
            _ => $"{when} · on timeline ×{used}",
        };
    }

    private static string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }
