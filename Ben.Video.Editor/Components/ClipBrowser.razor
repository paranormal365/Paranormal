@inject FfmpegService Ffmpeg
@inject SidecarMediaProbe SidecarMedia
@inject ClipStore Clips
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<VideoEditorOptions> EditorOptionsAccessor
@inject IMediaLibraryProvider MediaLib
@inject OPFSService OPFS
@inject SourceMounter Mounter
@inject ErrorLogService ErrorLog
@inject BlobUrlLifecycle BlobLifecycle
@implements IAsyncDisposable

@* ── Sidebar panel (unpinned) ────────────────────────────────────────────── *@
<aside class="bv-browser @(_isPinned ? "bv-browser--collapsed" : "")">
    @if (!_isPinned)
    {
        <div class="bv-browser__header">
            <span class="bv-browser__title">Media Library</span>
            @* How much of the browser's storage the imported media is taking. Nothing showed this,
               so the first anybody knew about the quota was a save that failed (2026-09-05 audit,
               media-2). *@
            @if (_storageUsed is not null)
            {
                <span class="bv-browser__storage" title="@_storageTitle">@_storageLabel</span>
            }
            <div class="bv-browser__header-actions">
                <TelerikButton OnClick="PickFilesAsync"
                               Enabled="@(Ffmpeg.State == FfmpegState.Ready)"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                               Icon="@SvgIcon.Plus"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Import local files">
                    Add
                </TelerikButton>
                <TelerikButton OnClick="TogglePinAsync"
                               Icon="@SvgIcon.Pin"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Size="@ThemeConstants.Button.Size.Small"
                               Title="Float as window" />
            </div>
        </div>
        @BrowserTabs
        @if (_errorMessage is not null)
        {
            <div class="bv-browser__error">⚠ @_errorMessage</div>
        }
    }
</aside>

@* ── Floating window (pinned) ───────────────────────────────────────────── *@
<TelerikWindow Visible="@_isPinned"
               VisibleChanged="@OnWindowVisibleChangedAsync"
               Draggable="true"
               Resizable="true"
               Width="320px"
               Height="540px"
               Modal="false"
               Class="bv-browser-window">
    <WindowTitle>
        <div class="bv-browser-window__title-bar">
            <span class="bv-browser-window__title">Media Library</span>
            <TelerikButton OnClick="PickFilesAsync"
                           Enabled="@(Ffmpeg.State == FfmpegState.Ready)"
                           Icon="@SvgIcon.Plus"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Size="@ThemeConstants.Button.Size.Small"
                           Title="Import local files" />
        </div>
    </WindowTitle>
    <WindowContent>
        @if (_isPinned)
        {
            @BrowserTabs
            @if (_errorMessage is not null)
            {
                <div class="bv-browser__error">⚠ @_errorMessage</div>
            }
        }
    </WindowContent>
</TelerikWindow>

@* ── Always rendered ─────────────────────────────────────────────────────── *@
<input type="file" id="bv-file-input" multiple accept="video/*,audio/*,image/*"
       style="display:none" @onchange="OnFileInputChangeAsync" />

<TelerikContextMenu @ref="_videoCardMenu"
                    Data="@_videoCardMenuItems"
                    TextField="Text"
                    IconField="Icon"
                    SeparatorField="IsSeparator"
                    DisabledField="IsDisabled"
                    OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
</TelerikContextMenu>

<TelerikContextMenu @ref="_audioCardMenu"
                    Data="@_audioCardMenuItems"
                    TextField="Text"
                    IconField="Icon"
                    SeparatorField="IsSeparator"
                    DisabledField="IsDisabled"
                    OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
</TelerikContextMenu>

<TelerikContextMenu @ref="_imageCardMenu"
                    Data="@_imageCardMenuItems"
                    TextField="Text"
                    IconField="Icon"
                    SeparatorField="IsSeparator"
                    DisabledField="IsDisabled"
                    OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
</TelerikContextMenu>


@* ── Import progress window ──────────────────────────────────────────────── *@
<TelerikWindow @bind-Visible="_showImportWindow"
               Width="600px"
               Modal="true"
               Draggable="true"
               Resizable="false"
               CloseOnOverlayClick="false">
    <WindowTitle>
        @{
            var _dc = _importStatuses.Count(s => s.IsDone);
            var _tc = _importStatuses.Count;
        }
        @if (_tc > 0 && _importStatuses.All(s => s.IsDone))
        {
            <span>Import Complete (@_tc file@(_tc == 1 ? "" : "s"))</span>
        }
        else
        {
            <span>Importing @_dc / @_tc file@(_tc == 1 ? "" : "s")…</span>
        }
    </WindowTitle>
    <WindowContent>
        <div class="bv-import-list">
            @foreach (var item in _importStatuses)
            {
                <div class="bv-import-row bv-import-row--@item.Stage.ToString().ToLowerInvariant()">

                    <div class="bv-import-row__thumb">
                        @if (item.PreviewUrl is not null)
                        {
                            @* Item #62 phase 170 — branch on what the URL actually IS, not on the
                               file type. PreviewUrl starts life as an object URL for the selected
                               file (a real video, so <video> is right), then the pipeline replaces
                               it with an extracted thumbnail FRAME — an image/webp blob. Keying
                               this off IsVideo meant that second, longer-lived value was handed to
                               a <video> element, which can never decode it: one failed blob load
                               per video import, no exception and no visible symptom beyond an
                               empty thumb box in a transient row. That is item #62's "solo blob:
                               URL 404". *@
                            @if (item.PreviewIsVideo)
                            {
                                <video src="@item.PreviewUrl" class="bv-import-row__thumb-img" muted preload="metadata" />
                            }
                            else
                            {
                                <img src="@item.PreviewUrl" alt="@item.FileName" class="bv-import-row__thumb-img" />
                            }
                        }
                        else
                        {
                            <div class="bv-import-row__thumb-icon">
                                <TelerikSvgIcon Icon="@FileTypeIcon(item.FileName)" />
                            </div>
                        }
                    </div>

                    <div class="bv-import-row__body">
                        <div class="bv-import-row__name" title="@item.FileName">@item.FileName</div>
                        <div class="bv-import-row__meta">
                            <span class="bv-import-row__size">@item.OriginalSizeText</span>
                            @if (item.MetaText is not null)
                            {
                                <span class="bv-import-row__dims"> · @item.MetaText</span>
                            }
                            @if (item.MemFsSizeText is not null)
                            {
                                <span class="bv-import-row__wasm"> → @item.MemFsSizeText in WASM</span>
                            }
                        </div>
                        @if (item.Stage is not ImportStage.Queued and not ImportStage.Done and not ImportStage.Error)
                        {
                            <TelerikProgressBar Value="@((double)item.Progress)"
                                                Max="100"
                                                Indeterminate="@(item.Progress == 0)"
                                                Class="bv-import-row__bar"
                                                AriaLabel="@item.FileName" />
                        }
                        @if (item.Stage == ImportStage.Error && item.ErrorText is not null)
                        {
                            <div class="bv-import-row__error">@item.ErrorText</div>
                        }
                    </div>

                    <div class="bv-import-badge bv-import-badge--@item.Stage.ToString().ToLowerInvariant()">
                        @StageBadge(item.Stage)
                    </div>

                    @if (!item.IsDone && item.Cts is not null)
                    {
                        <TelerikButton OnClick="() => item.Cts!.Cancel()"
                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Title="Cancel this import"
                                       Class="bv-import-row__cancel">
                            Cancel
                        </TelerikButton>
                    }

                </div>
            }
        </div>
    </WindowContent>
    <WindowFooter>
        @if (_importStatuses.Count > 0 && _importStatuses.All(s => s.IsDone))
        {
            <TelerikButton OnClick="CloseImportWindow"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           ButtonType="ButtonType.Button">
                Done
            </TelerikButton>
        }
    </WindowFooter>
</TelerikWindow>

@code {
    // Audit #4 — typed DOM/storage helpers instead of eval'd source strings.
    private IJSObjectReference? _dom;
    private IJSObjectReference? _storage;

    private async Task<IJSObjectReference> DomAsync() =>
        _dom ??= await JS.InvokeAsync<IJSObjectReference>(
            "benImportEditorModule", "js/domInterop.js");

    private async Task<IJSObjectReference> StorageAsync() =>
        _storage ??= await JS.InvokeAsync<IJSObjectReference>(
            "benImportEditorModule", "js/storageInterop.js");


    // The grids below (VideoClipGrid/AudioClipGrid/ImageClipGrid/LibraryFileGrid) are built with raw
    // RenderTreeBuilder calls, so the Razor compiler's CSS-isolation pass never sees these elements and
    // never stamps them with this component's scope attribute — every ClipBrowser.razor.css rule
    // silently fails to apply to them (e.g. thumbnails render at native image size instead of the
    // intended 64×40 box). Adding the attribute by hand here restores scoping for the card visuals.
    // Value must match the "aside" element's live b-xxxxxxxx attribute if this file is ever moved/renamed.
    private const string CssScope = "b-xbjan6uni8";

    // ── Parameters ───────────────────────────────────────────────────────────
    [Parameter] public EventCallback<VideoClip> OnClipSelected   { get; set; }
    [Parameter] public EventCallback<VideoClip> OnAddToTimeline  { get; set; }
    [Parameter] public EventCallback<AudioClip> OnAudioClipAdded { get; set; }

    /// <summary>Places a picture from the bin on the timeline.</summary>
    [Parameter] public EventCallback<ImageClip> OnAddImageToTimeline { get; set; }

    /// <summary>Places an audio source from the bin on its own track.</summary>
    [Parameter] public EventCallback<AudioClip> OnAddAudioToTimeline { get; set; }

    /// <summary>Effective options from the parent VideoEditor. Null = use the IOptions value from DI.</summary>
    [Parameter] public VideoEditorOptions? EditorOptions { get; set; }

    private VideoEditorOptions Options => EditorOptions ?? EditorOptionsAccessor.Value;

    // ── Local state ───────────────────────────────────────────────────────────
    private Guid?   _selectedId;
    private bool    _loading;
    private string  _loadingMessage = string.Empty;
    private string? _errorMessage;
    private bool    _isDragging;
    private string  _activeLocalTab = "video";

    // ── ClipBrowser → track pointer-based drag source (item #24) ───────────────
    private IJSObjectReference?                  _dragBridgeModule;
    private DotNetObjectReference<ClipBrowser>?  _dragSourceRef;

    // ── Pin state ─────────────────────────────────────────────────────────────
    private bool _isPinned;
    private const string PinStateKey = "bv-browser-pinned";

    // ── Storage in use ────────────────────────────────────────────────────────

    private long?  _storageUsed;
    private long?  _storageQuota;
    private string _storageLabel = string.Empty;
    private string _storageTitle = string.Empty;

    /// <summary>
    /// Reads how much of the browser's storage is in use, for the header.
    /// </summary>
    /// <remarks>
    /// Refreshed after an import, because that is when it changes by an amount worth noticing.
    /// </remarks>
    private async Task RefreshStorageUsageAsync()
    {
        var (usage, quota) = await OPFS.EstimateAsync();
        _storageUsed  = usage;
        _storageQuota = quota;

        if (usage is null) return;

        _storageLabel = Bytes(usage.Value);
        _storageTitle = quota is > 0
            ? $"Imported media is using {Bytes(usage.Value)} of the "
              + $"{Bytes(quota.Value)} this browser allows. Media no project uses is cleared "
              + "when the editor starts."
            : $"Imported media is using {Bytes(usage.Value)} of this browser's storage.";

        await InvokeAsync(StateHasChanged);
    }

    private static string Bytes(long b) => b switch
    {
        < 1024          => $"{b} B",
        < 1_048_576     => $"{b / 1024.0:F0} KB",
        < 1_073_741_824 => $"{b / 1_048_576.0:F0} MB",
        _               => $"{b / 1_073_741_824.0:F1} GB",
    };

    // ── Library state ─────────────────────────────────────────────────────────
    private bool                           _libraryLoading;
    private string?                        _libraryError;

    /// <summary>The library refused us, which is a different thing from it being empty.</summary>
    private bool                           _libraryNeedsSignIn;

    /// <summary>The host's own sign-in chrome, so the refusal can offer a way in.</summary>
    [Parameter] public RenderFragment?     HostStatusContent { get; set; }
    private IReadOnlyList<MediaLibraryFile> _libraryFiles = [];
    private readonly HashSet<Guid>          _libraryImporting = [];

    // Phase 150 — decouples "have a local copy" from "placed on the timeline". A card's click
    // downloads + OPFS-caches the file (keyed by the library file's own stable Id, same OPFS
    // directory/convention every placed clip's own source already uses — see OPFSService) without
    // touching ClipStore at all; a SECOND click, once cached, adds it to the timeline by copying
    // the cached OPFS entry under a fresh clip id (mirrors how a placed clip's own source is
    // stored) rather than re-downloading. _libraryCached is seeded from a real OPFS existence
    // check on load (LoadLibraryAsync) so the "downloaded locally" badge survives a reload.
    private readonly HashSet<Guid>            _libraryCached           = [];
    private readonly HashSet<Guid>            _libraryDownloading      = [];
    private readonly Dictionary<Guid, double> _libraryDownloadProgress = [];

    // ── Server-tab scope (item 91) ───────────────────────────────────────────
    // The tab lists everything the person can reach, which is fine with a handful of demo clips
    // and unusable once a real investigation has produced dozens of files per visit. The scope
    // narrows the list server-side; it can never widen it, because the server intersects a scope
    // against the audience set it computed first.
    private MediaLibraryScopeKind _scopeKind = MediaLibraryScopeKind.All;
    private Guid? _scopeCaseId;
    private Guid? _scopeInvestigationId;
    private IReadOnlyList<MediaLibraryScopeGroup> _scopeGroups = [];
    private bool _scopeGroupsLoaded;

    /// <summary>
    /// The scope source, when the host registered one. Null means All and Personal only.
    /// </summary>
    /// <remarks>
    /// Resolved from the service provider rather than with <c>[Inject]</c>, because <c>[Inject]</c>
    /// calls <c>GetRequiredService</c> — a nullable property does not make it optional, and a host
    /// that registered no scope source would get an exception on render instead of the two scopes
    /// that work without one.
    /// </remarks>
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private IMediaLibraryScopeSource? ScopeSource
        => _scopeSource ??= Services.GetService(typeof(IMediaLibraryScopeSource)) as IMediaLibraryScopeSource;

    private IMediaLibraryScopeSource? _scopeSource;

    /// <summary>
    /// Which load is the current one.
    /// </summary>
    /// <remarks>
    /// Changing scope starts a fetch and does not wait for the one already in flight. Without a
    /// generation counter the older, slower response wins simply by arriving last — the list then
    /// shows the previous scope's files under a selector describing the new one. Found by a test
    /// that switched scope twice quickly, which is exactly what a person hunting for a file does.
    /// </remarks>
    private int _libraryLoadGeneration;

    private MediaLibraryScope CurrentScope =>
        new(_scopeKind,
            _scopeKind == MediaLibraryScopeKind.Case ? _scopeCaseId : null,
            _scopeKind == MediaLibraryScopeKind.Case ? _scopeInvestigationId : null);

    private IReadOnlyList<MediaLibraryScopeItem> InvestigationsForChosenCase =>
        _scopeGroups.FirstOrDefault(g => g.Id == _scopeCaseId)?.Items ?? [];

    // ── Server-tab preview thumbnails (separate from the real import flow —
    // these are one-off frame grabs for the browsing list, nothing is added to
    // the timeline and any temp MEMFS file is cleaned up immediately after) ───
    private readonly Dictionary<Guid, string> _serverThumbnails = [];
    private readonly HashSet<Guid>            _serverThumbnailsLoading = [];

    // ── Import progress ───────────────────────────────────────────────────────
    private bool                   _showImportWindow;
    private List<FileImportStatus> _importStatuses = [];

    /// <summary>
    /// Item #62 phase 170 — owner label for thumbnails produced by the wasm worker
    /// (<see cref="FfmpegService.ExtractThumbnailsAsync"/>), mirroring
    /// <see cref="SidecarMediaProbe.ThumbnailOwner"/> for the native path.
    ///
    /// <para>Phase 144 built <see cref="BlobUrlLifecycle"/> precisely to catch double-revokes and
    /// revoke-while-attached, then only ever pointed it at preview URLs; phase 159 added the
    /// sidecar's thumbnails. The wasm thumbnails — the majority of blob URLs in the app, and the
    /// ones carrying item #62's bug — were never registered, so the detector built for this class
    /// of bug was structurally blind to it. Registering them is the reason a regression here would
    /// now show up in the error log instead of only as a silent 404 in devtools.</para>
    /// </summary>
    private const string WasmThumbnailOwner = "ClipBrowser.wasmThumbnail";

    /// <summary>
    /// Item #62 phase 170 — points an import row's preview at an extracted thumbnail frame,
    /// keeping <see cref="FileImportStatus.PreviewIsVideo"/> in step with the URL's actual kind so
    /// the markup picks &lt;img&gt; rather than &lt;video&gt;.
    ///
    /// <para>Also releases the object URL this supersedes. That URL comes from
    /// <c>domInterop.fileObjectUrl</c> (a plain <c>URL.createObjectURL(file)</c> over the whole
    /// picked file) and nothing else ever revoked it, so every video import used to strand one
    /// full-file blob for the page's lifetime. Safe to revoke here precisely because the render
    /// that swaps the element happens before this runs.</para>
    /// </summary>
    private async Task SetThumbnailPreviewAsync(FileImportStatus status, string thumbnailUrl)
    {
        var superseded = status.PreviewUrl;
        status.PreviewUrl = thumbnailUrl;
        status.PreviewIsVideo = false;
        StateHasChanged();
        await Task.Yield(); // let the <video>→<img> swap flush before releasing the old blob

        if (superseded is not null && superseded != thumbnailUrl)
        {
            try { await Ffmpeg.RevokePreviewUrlAsync(superseded); } catch { }
        }
    }

    /// <summary>Registers wasm-produced thumbnails; sidecar ones self-register in
    /// <see cref="SidecarMediaProbe.TryExtractThumbnailsAsync"/>, so they are skipped here.</summary>
    private void RegisterWasmThumbnails(IEnumerable<string> urls)
    {
        foreach (var url in urls)
        {
            if (!SidecarMedia.OwnsThumbnail(url)) BlobLifecycle.Created(url, WasmThumbnailOwner);
        }
    }

    private enum ImportStage { Queued, Preview, Downloading, Writing, Metadata, Thumbnails, Audio, Done, Cancelled, Error }

    private sealed class FileImportStatus
    {
        public required string FileName    { get; init; }
        public required long   SizeBytes   { get; init; }
        public required bool   IsVideo     { get; init; }
        public string?         PreviewUrl  { get; set; }

        /// <summary>
        /// Item #62 phase 170 — whether <see cref="PreviewUrl"/> currently holds a *video* blob
        /// rather than a still image, which is NOT the same question as <see cref="IsVideo"/>:
        /// a video import's preview starts as an object URL for the picked file and is then
        /// replaced by an extracted thumbnail frame. Only the markup's element choice depends on
        /// this; everything else keys off <see cref="IsVideo"/> as before.
        /// </summary>
        public bool            PreviewIsVideo { get; set; }
        public ImportStage     Stage       { get; set; } = ImportStage.Queued;
        public int             Progress    { get; set; }
        public string?         ErrorText   { get; set; }
        public string?         MetaText    { get; set; }
        public long?           MemFsBytes  { get; set; }
        /// <summary>
        /// Cancels this file's import.
        /// </summary>
        /// <remarks>
        /// Only the server-library path used to set this, so on the local path the Cancel button
        /// was rendered and did nothing — the note here said a local import had "no long-running
        /// stage to cancel", which is not true of a half-gigabyte file being written to storage,
        /// probed and turned into a filmstrip (2026-09-05 audit, media-9). Cancellation lands
        /// between stages, which is where the time actually goes.
        /// </remarks>
        public CancellationTokenSource? Cts { get; set; }

        public bool    IsDone          => Stage is ImportStage.Done or ImportStage.Cancelled or ImportStage.Error;
        public string  OriginalSizeText => FormatBytes(SizeBytes);
        public string? MemFsSizeText    => MemFsBytes.HasValue ? FormatBytes(MemFsBytes.Value) : null;

        private static string FormatBytes(long b) => b switch
        {
            < 1024        => $"{b} B",
            < 1_048_576   => $"{b / 1024.0:F1} KB",
            _             => $"{b / 1_048_576.0:F1} MB",
        };
    }

    // ── Render fragments ──────────────────────────────────────────────────────

    private RenderFragment BrowserTabs => __builder =>
    {
        __builder.OpenComponent<TelerikTabStrip>(0);
        __builder.AddAttribute(1, "ActiveTabId", _activeLocalTab);
        __builder.AddAttribute(2, "ActiveTabIdChanged",
            EventCallback.Factory.Create<string>(this, v => { _activeLocalTab = v; }));
        __builder.AddAttribute(3, "Size", ThemeConstants.TabStrip.Size.Small);
        __builder.AddAttribute(4, "Class", "bv-browser__tabs");
        __builder.AddAttribute(5, "OnStateChanged",
            EventCallback.Factory.Create<TabStripStateEventArgs>(this, OnTabStateChanged));
        __builder.AddAttribute(6, "ChildContent", (RenderFragment)(__b2 =>
        {
            // Video tab
            __b2.OpenComponent<TabStripTab>(0);
            __b2.AddAttribute(1, "Title", "Video");
            __b2.AddAttribute(2, "Id", "video");
            __b2.AddAttribute(3, "ChildContent", VideoClipGrid);
            __b2.CloseComponent();

            // Audio tab
            __b2.OpenComponent<TabStripTab>(4);
            __b2.AddAttribute(5, "Title", "Audio");
            __b2.AddAttribute(6, "Id", "audio");
            __b2.AddAttribute(7, "ChildContent", AudioClipGrid);
            __b2.CloseComponent();

            // Image tab (conditional)
            if (Options.ImageClips)
            {
                __b2.OpenComponent<TabStripTab>(8);
                __b2.AddAttribute(9, "Title", "Image");
                __b2.AddAttribute(10, "Id", "image");
                __b2.AddAttribute(11, "ChildContent", ImageClipGrid);
                __b2.CloseComponent();
            }

            // Server tab (conditional)
            if (Options.MediaLibrary)
            {
                __b2.OpenComponent<TabStripTab>(12);
                __b2.AddAttribute(13, "Title", "Server");
                __b2.AddAttribute(14, "Id", "server");
                __b2.AddAttribute(15, "ChildContent", LibraryFileGrid);
                __b2.CloseComponent();
            }
        }));
        __builder.CloseComponent();
    };

    private RenderFragment VideoClipGrid => __builder =>
    {
        if (_loading)
        {
            __builder.AddMarkupContent(0,
                "<div class=\"bv-browser__loading\">");
            __builder.OpenComponent<TelerikLoader>(1);
            __builder.AddAttribute(2, "Type", LoaderType.InfiniteSpinner);
            __builder.AddAttribute(3, "Size", ThemeConstants.Loader.Size.Medium);
            __builder.CloseComponent();
            __builder.OpenElement(4, "span"); __builder.AddContent(5, _loadingMessage); __builder.CloseElement();
            __builder.AddMarkupContent(6, "</div>");
        }
        else if (!Clips.BinVideoClips.Any())
        {
            __builder.OpenElement(10, "div"); __builder.AddAttribute(11, "class", "bv-browser__empty");
            __builder.OpenElement(12, "p"); __builder.AddContent(13, "No video yet."); __builder.CloseElement();
            __builder.OpenElement(14, "p");
            __builder.AddContent(15, "Click ");
            __builder.OpenElement(16, "strong"); __builder.AddContent(17, "Add"); __builder.CloseElement();
            __builder.AddContent(18, " to import video files.");
            __builder.CloseElement();
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(20, "div"); __builder.AddAttribute(21, "class", "bv-browser__grid"); __builder.AddAttribute(22, CssScope, "");
            int seq = 30;
            foreach (var clip in Clips.BinVideoClips)
            {
                var c = clip;
                var cls = $"bv-clip-card {(_selectedId == clip.Id ? "bv-clip-card--selected" : "")} {(_isDragging && _selectedId == clip.Id ? "bv-clip-card--dragging" : "")}";
                __builder.OpenElement(seq++, "div");
                __builder.AddAttribute(seq++, CssScope, "");
                __builder.AddAttribute(seq++, "class", cls);
                __builder.AddAttribute(seq++, "onpointerdown", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.PointerEventArgs>(this, e => OnClipPointerDown(e, c)));
                __builder.AddAttribute(seq++, "onclick",       Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => SelectClip(c)));
                __builder.AddAttribute(seq++, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, e => OpenVideoCardMenu(e, c)));
                __builder.AddEventPreventDefaultAttribute(seq++, "oncontextmenu", true);

                // Thumb
                __builder.OpenElement(seq++, "div"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__thumb");
                if (clip.ThumbnailUrls.Count > 0)
                {
                    __builder.OpenElement(seq++, "img");
                    __builder.AddAttribute(seq++, CssScope, "");
                    __builder.AddAttribute(seq++, "src",       clip.ThumbnailUrls[0]);
                    __builder.AddAttribute(seq++, "alt",       clip.Name);
                    __builder.AddAttribute(seq++, "loading",   "lazy");
                    __builder.AddAttribute(seq++, "draggable", "false");
                    __builder.CloseElement();
                }
                else
                {
                    __builder.OpenElement(seq++, "span"); __builder.AddAttribute(seq++, CssScope, ""); __builder.AddAttribute(seq++, "class", "bv-clip-card__thumb-placeholder");
