    private async Task SaveToServerHandlerAsync()
    {
        _transfer = new TransferProgressState("Uploading Project", "Uploading project to server…");
        StateHasChanged();

        try
        {
            // Through the host's own store, not a raw post. The editor used to post over a named
            // HttpClient, which on a Blazor Server host cannot reach the circuit's bearer token —
            // so this button answered 401 there, always (2026-09-05 audit, F13).
            var file = Project.BuildCurrentProjectFile(Projects.CurrentProjectName);

            var (id, problem) = await ServerProjects.SaveAsync(file, Projects.CurrentServerId);

            _transfer = null;

            if (problem is null)
            {
                // Remembered so the next save updates this project rather than creating another
                // copy of it (2026-09-05 audit, persistence-13).
                Projects.CurrentServerId = id;
                _notifications?.Show("Project saved to server.", ThemeConstants.Notification.ThemeColor.Success);
            }
            else
            {
                _notifications?.Show(problem, ThemeConstants.Notification.ThemeColor.Error);
            }
        }
        catch (Exception ex)
        {
            _transfer = null;
            _notifications?.Show(
                $"Save to server error: {ex.Message}",
                ThemeConstants.Notification.ThemeColor.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

