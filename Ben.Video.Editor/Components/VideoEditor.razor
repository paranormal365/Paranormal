    /// <summary>
    /// Turns the browser's "leave site?" prompt on and off as there becomes, or stops being,
    /// something worth losing.
    /// </summary>
    /// <remarks>
    /// Nothing asked before this: closing the tab took whatever was unsaved with it, and a render
    /// in progress with it — a render lives entirely in the tab, so leaving does not background it,
    /// it destroys it (2026-09-05 audit, F9). The handler is removed when there is nothing to
    /// protect, both because a page that always warns gets its warning ignored and because a
    /// registered beforeunload disables the browser's back/forward cache.
    /// </remarks>
    private async Task UpdateUnloadGuardAsync()
    {
        var renderRunning = Exporter.CurrentJob is { State: ExportJobState.Running };

        var shouldGuard = UnloadGuardPolicy.ShouldGuard(
            Projects.IsDirty, Projects.AutosavePending, renderRunning);

        if (shouldGuard == _unloadGuardOn) return;
        _unloadGuardOn = shouldGuard;

        try
        {
            await (await DomAsync()).InvokeVoidAsync(
                "setUnloadGuard", shouldGuard,
                UnloadGuardPolicy.Reason(Projects.IsDirty, renderRunning));
        }
        catch (Exception ex)
        {
            ErrorLog.Log("VideoEditor.UpdateUnloadGuardAsync", ex);
        }
    }
    private void OnQueueChanged()
    {
        // A render running in this tab is worth stopping somebody from leaving over, so the guard
        // follows the queue as well as the dirty flag.
        _ = UpdateUnloadGuardAsync();
        InvokeAsync(StateHasChanged);
    }

    // ── Working Window auto-refresh (item #11, fulfilled unconditionally as of
    // item #36 phase 84) ────────────────────────────────────────────────────────
    // Always on — no opt-in toggle. ClipStore.OnChange fires synchronously/unthrottled
    // on every mutation — including every pointermove during a drag — with no debounce
    // of its own, so this collapses a whole burst of edits into a single
    // RefreshWorkingWindowAsync() call fired once edits settle, instead of re-encoding
    // the timeline dozens of times per second while the user is still mid-edit. This
    // used to be opt-in (phase 65) because every refresh was a full re-encode; phases
    // C/D's background-rendered segments (usually already cached by the time the
    // debounce fires) made "no explicit render step" — item #11's original ask —
    // cheap enough to just always be true, so the toggle is gone.

    private const int AutoPreviewDebounceMs = 1000;

    private CancellationTokenSource?  _autoPreviewCts;

    private void ScheduleAutoPreview()
    {
        _autoPreviewCts?.Cancel();
        _autoPreviewCts = new CancellationTokenSource();
        _ = DebouncedAutoPreviewAsync(_autoPreviewCts.Token);
    }

    private async Task DebouncedAutoPreviewAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(AutoPreviewDebounceMs, token);

            // Wait out a busy main instance instead of letting RefreshWorkingWindowAsync's Ready
            // guard silently drop this refresh — an auto-preview (or a rough→fine sharpen refresh)
            // that fires while the previous assembly is still running used to just vanish, leaving
            // the Working Window stale (or stuck at rough quality) until the next unrelated edit.
            //
            // AutoPreviewGate owns the actual decision (pure, unit-tested). The condition it adds
            // is the export: a rebuild used to take its turn on the same engine mid-render,
            // interleaving its encodes with the export's and making a render somebody is waiting
            // on take longer, for a preview they are not watching (2026-09-05 audit, preview-20).
            var waitedMs = 0;
            while (true)
            {
                var exportRunning = Exporter.CurrentJob is { State: ExportJobState.Running };
                var decision = AutoPreviewGate.Decide(Ffmpeg.State, exportRunning, waitedMs);

                if (decision == AutoPreviewDecision.Run)     break;
                if (decision == AutoPreviewDecision.Abandon) return;

                await Task.Delay(250, token);

                // An export is not a stall, so waiting for one does not count against the budget.
                if (!exportRunning) waitedMs += 250;
            }
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;
        await RefreshWorkingWindowAsync();
    }

    // ── Motion keyframe handlers ──────────────────────────────────────────────

    /// <summary>Activate motion path editing for a layer by ID.</summary>
    public void ActivateMotionPath(Guid layerId, string layerType)
    {
        // Clear other Properties-panel selections so the MotionKeyframeEditor branch is actually reached —
        // it's checked after _selectedCallout/_selectedClipArt in the panel's if/else-if chain, so leaving
        // either set meant clicking "Animate" on a callout or clip-art layer silently did nothing visible.
        _selectedCallout     = null;
        _selectedClipArt     = null;
        _selectedTextOverlay = null;

        _motionLayerId   = layerId;
        _motionLayerType = layerType;
        _motionKeyframeIndex = -1;
        StateHasChanged();
    }

    // ── Canvas nudge (item #57 P5) ──────────────────────────────────────────────

    private const double NudgeStep      = 0.01; // 1% of canvas
    private const double NudgeStepShift = 0.05; // 5% of canvas with Shift held

    /// <summary>Arrow-key nudge for whichever of Callout/ClipArt/TextOverlay is currently
    /// selected — mirrors CanvasSelectionOverlay's own drag/HUD writes exactly (the Camtasia-rule
    /// <c>Motion.EditLayer</c>, one undo commit per discrete action) but lives here since keyboard
    /// dispatch is already centralized in this component for every other shortcut, Delete
    /// included right above.</summary>
    private void NudgeSelectedCanvasItem(string key, bool shift)
    {
        TrackItem? item = _selectedCallout is not null ? _selectedCallout
                        : _selectedClipArt is not null ? _selectedClipArt
                        : _selectedTextOverlay;
        if (item is null) return;

        var step = shift ? NudgeStepShift : NudgeStep;
        var (dx, dy) = key switch
        {
            "ArrowLeft"  => (-step, 0.0),
            "ArrowRight" => (step, 0.0),
            "ArrowUp"    => (0.0, -step),
            _            => (0.0, step), // ArrowDown
        };

        var time = Playback.State.CurrentTime;
        var (curX, curY) = MotionEffectiveGeometry.EffectivePosition(Motion, item, time, ExportRes.Width, ExportRes.Height);
        var nx = Math.Clamp(curX + dx, -1.0, 2.0);
        var ny = Math.Clamp(curY + dy, -1.0, 2.0);
        var oldKf = Motion.GetPath(item.Id)?.Keyframes.FirstOrDefault(k => Math.Abs(k.Time - time) < 0.001);

        switch (item)
        {
            case CalloutClip c:
                Motion.EditLayer(c.Id, "CalloutClip", time,
                    () => MotionEffectiveGeometry.StaticSeed(c, time),
                    kf => { kf.X = nx; kf.Y = ny; },
                    () => Clips.CommitCalloutUpdate(c.Id, "position",
                        cl => { cl.X = nx; cl.Y = ny; },
                        cl => { cl.X = curX; cl.Y = curY; }));
                CommitKeyframeNudgeIfAnimated(item, "CalloutClip", time, oldKf);
                break;
            case ClipArtClip a:
                Motion.EditLayer(a.Id, "ClipArtClip", time,
                    () => MotionEffectiveGeometry.StaticSeed(a, time),
                    kf => { kf.X = nx; kf.Y = ny; },
                    () => Clips.CommitClipArtUpdate(a.Id, "position",
                        cl => { cl.X = nx; cl.Y = ny; },
                        cl => { cl.X = curX; cl.Y = curY; }));
                CommitKeyframeNudgeIfAnimated(item, "ClipArtClip", time, oldKf);
                break;
            case TextOverlay t:
                // No undo tier for TextOverlay's static position anywhere today (matching drag
                // and the HUD's own SetPosition) — deliberately not extending item #63's fix to
                // its keyframe branch either, so as not to introduce a new
                // have-undo-only-when-animated asymmetry.
                Motion.EditLayer(t.Id, "TextOverlay", time,
                    () => MotionEffectiveGeometry.StaticSeed(t, time, ExportRes.Width, ExportRes.Height),
                    kf => { kf.X = nx; kf.Y = ny; },
                    () => Clips.UpdateTextOverlay(t with { OverrideX = nx, OverrideY = ny }));
                break;
        }
    }

    /// <summary>Item #63 — mirrors <c>CanvasSelectionOverlay.CommitKeyframeEditIfAnimated</c>
    /// exactly (arrow-key nudge is this component's own gesture, not routed through that overlay).
    /// Wraps the keyframe-branch edit <see cref="Motion.EditLayer"/> just performed in one undo
    /// entry; no-op when the layer has no path (the static branch already self-committed via its
    /// own <c>writeStatic</c> closure above).</summary>
    private void CommitKeyframeNudgeIfAnimated(TrackItem item, string layerType, double time, MotionKeyframe? oldKf)
    {
        if (!Motion.HasPath(item.Id)) return;
        var newKf = Motion.GetPath(item.Id)?.Keyframes.FirstOrDefault(k => Math.Abs(k.Time - time) < 0.001);
        if (newKf is null) return;

        Clips.CommitMotionKeyframeEdit($"Nudge {layerType}",
            apply:  () => Motion.UpsertKeyframe(item.Id, layerType, newKf),
            revert: () =>
            {
                if (oldKf is null) Motion.RemoveKeyframe(item.Id, time);
                else Motion.UpsertKeyframe(item.Id, layerType, oldKf);
            });
    }

    private void OnMotionKeyframeSelected(int index)
    {
        _motionKeyframeIndex = index;
        StateHasChanged();
    }

    /// <summary>A keyframe diamond was clicked on the timeline (item #57 P6). Opens/focuses the
    /// MotionKeyframeEditor panel on that exact layer+keyframe, mirroring what clicking the same
    /// keyframe's dot on the canvas overlay already does via <see cref="OnMotionKeyframeSelected"/>
    /// — the playhead seek itself already happened in VideoTimeline before this fires.</summary>
    private void OnTimelineKeyframeSelected((Guid LayerId, string LayerType, int KeyframeIndex, double Time) args)
