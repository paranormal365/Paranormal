    // ── Preview handlers ──────────────────────────────────────────────────────

    private void OnPreviewTimeUpdate(double currentTime) { }

    /// <summary>
    /// At the default 100% this returns null — <see cref="FfmpegService.ConcatClipsAsync"/> then
    /// behaves exactly as before this feature existed. Below 100%, scales the export resolution down
    /// by <see cref="PreviewQualityService.ScalePercent"/>, rounded to even numbers (libx264 requires
    /// even width/height).
    /// </summary>
    private (int Width, int Height)? PreviewScaleTarget()
    {
        var pct = PreviewQuality.ScalePercent;
        if (pct >= 100) return null;

        var w = ExportRes.Width  * pct / 100;
        var h = ExportRes.Height * pct / 100;
        w -= w % 2;
        h -= h % 2;
        return (w, h);
    }

    /// <summary>
    /// Assembles all primary-track clips into a single concat output at PREVIEW quality/resolution
    /// and loads it into the Working Window (<see cref="_preview"/>) — the live-editing pane, kept
    /// current automatically (see the auto-refresh region below), never a manual step. Distinct
    /// from <see cref="RenderFullQualityPreviewAsync"/> (item #36 phase 84), which is the toolbar's
    /// "Preview" button — a deliberate, occasional, full-resolution/quality check of the real
    /// result, played in its own separate window.
    /// </summary>
    private async Task RefreshWorkingWindowAsync()
    {
        if (Ffmpeg.State != FfmpegState.Ready || _preview is null) return;
        _sharpenRefreshScheduled = false; // a run is happening — sharpen events may re-arm after this

        var videoClips = Clips.PrimaryVideoTrack.VideoClips
                              .Where(c => c.MemFsName is not null)
                              .ToList();
        var imageClips = Clips.PrimaryVideoTrack.ImageClips
                              .Where(c => c.MemFsName is not null)
                              .ToList();

        // Nothing left to show. This used to return and leave the last render playing, so
        // deleting every clip gave you an empty timeline above a preview still happily playing the
        // footage you had just removed (2026-09-05 audit, preview-19).
        if (videoClips.Count == 0 && imageClips.Count == 0)
        {
            await ClearWorkingWindowAsync();
            return;
        }

        // Item #59-#65 flakiness investigation, phase 144 (symptom S4) — this used to revoke the
        // OLD url right here, before the re-encode below even starts. That re-encode (trim
        // encodes + concat/xfade) can run for many seconds, and the <video> element kept pointing
        // at the just-revoked URL that whole time — any seek/scrub/buffer top-up during it fetched
        // a dead blob (live-captured as a burst of blob: ERR_FILE_NOT_FOUND errors). Swap-then-
        // revoke instead: keep the old URL live+attached until the NEW one is created and handed
        // to the preview element (below), and revoke it only then. If the re-encode throws before
        // that point, the old URL is never touched — Working Window keeps showing the last-good
        // preview instead of going blank.
        var previousTimelinePreviewUrl = _timelinePreviewUrl;

        var outName = $"preview_timeline_{Guid.NewGuid():N}.mp4";
        var videoSegmentNames = new List<string>();
        var imageSegmentNames = new List<string>();
        // Hold background-segment deletion for the whole assembly: a fine pass completing
        // mid-assembly would otherwise delete the superseded rough segment this concat is about
        // to read (live-found race — see BackgroundRenderService.BeginDeletionHold).
        BackgroundRender.BeginDeletionHold();
        try
        {
            var previewSettings = new ExportSettings();
            var regionsById = RenderStatus.Regions.ToDictionary(r => r.ClipId);

            // Trim + apply effects for each video clip, mirroring ExportService.TrimSegmentsAsync,
            // so Preview actually reflects the same edits Export does. Item #36 phase B: skip the
            // encode entirely when a cached segment already matches this clip's current region
            // signature — only clips actually edited since the last Preview pay the encode cost.
            foreach (var vid in videoClips)
            {
                var signature = regionsById.TryGetValue(vid.Id, out var region) ? region.Signature : null;
                if (signature is not null && SegmentCache.TryGet(signature, out var cached))
                {
                    videoSegmentNames.Add(cached);
                    continue;
                }

                var bgSegment = TryConsumeBackgroundSegment(region, signature);
                if (bgSegment is not null)
                {
                    videoSegmentNames.Add(bgSegment);
                    continue;
                }

                var segName = $"preview_vid_{Guid.NewGuid():N}.mp4";
                var start   = vid.StartTrim;
                var end     = vid.EndTrim > vid.StartTrim ? vid.EndTrim : vid.Duration;
                var effectiveDuration = vid.EffectiveDuration > 0 ? vid.EffectiveDuration : vid.Duration;
                var volumeFilter = ExportArgBuilders.BuildVolumeAutomationFilter(vid, effectiveDuration);
                // The preview encodes each clip at its own native size, so that is the canvas an
                // effect runs against here.
                var appliedVf = ExportArgBuilders.BuildAppliedEffectsFilter(
                    vid.AppliedEffects, EffectRegistry, effectiveDuration, vid.Speed,
                    vid.Width, vid.Height);
                var args = ExportArgBuilders.BuildTrimArgs(
                    vid.MemFsName!, segName, start, end, vid.Speed, previewSettings,
                    volumeFilter, vid.Effects, vid.MuteAudio,
                    extraVf: string.IsNullOrEmpty(appliedVf) ? null : appliedVf,
                    sourceHasAudio: vid.HasAudio);
                await Ffmpeg.ExecAsync(args);
                // Item #59-#65 flakiness investigation, phase 146 — size unknown (produced by an
                // ffmpeg exec, not a C#-side byte array), so this is a 0-byte lower-bound entry
                // like FfmpegService.WriteFileAsync's own "source-fallback" category — still gives
                // real diagnostic value as an ENTRY COUNT even without a byte total.
                MemFs.Track(segName, 0, "preview-segment");
                videoSegmentNames.Add(segName);
                if (signature is not null) SegmentCache.Set(signature, segName);
                RequestBackgroundPriorityIfEnabled(vid.Id);
            }

            // Loop each image clip into its own short video segment — now with the same
            // Effects/AppliedEffects support the real export pipeline already gives images.
            // Same cache-first check as video clips above.
            foreach (var img in imageClips)
            {
                var signature = regionsById.TryGetValue(img.Id, out var region) ? region.Signature : null;
                if (signature is not null && SegmentCache.TryGet(signature, out var cached))
                {
                    imageSegmentNames.Add(cached);
                    continue;
                }

                var bgSegment = TryConsumeBackgroundSegment(region, signature);
                if (bgSegment is not null)
                {
                    imageSegmentNames.Add(bgSegment);
                    continue;
                }

                var segName = $"preview_img_{Guid.NewGuid():N}.mp4";
                var duration = img.Duration > 0 ? img.Duration : 5.0;
                var appliedVf = ExportArgBuilders.BuildAppliedEffectsFilter(
                    img.AppliedEffects, EffectRegistry, duration, 1.0, img.Width, img.Height);
                var args = ExportArgBuilders.BuildImageSegmentArgs(
                    img.MemFsName!, segName, duration, previewSettings,
                    outputWidth: img.Width, outputHeight: img.Height,
                    effects: img.Effects,
                    extraVf: string.IsNullOrEmpty(appliedVf) ? null : appliedVf);
                await Ffmpeg.ExecAsync(args);
                MemFs.Track(segName, 0, "preview-segment"); // see the video-clip branch's own note above
                imageSegmentNames.Add(segName);
                if (signature is not null) SegmentCache.Set(signature, segName);
                RequestBackgroundPriorityIfEnabled(img.Id);
            }

            // Merge video and image segments in timeline order. Durations travel alongside —
            // item #57 T2 needs each segment's real length for xfade junction offset math
            // (mirrors ExportService.RunPipelineAsync's orderedSegments), not just concat order.
            var placed = videoClips
                .Select((c, i) => (Segment: videoSegmentNames[i], ClipId: c.Id, Start: c.TimelinePosition,
                                   Duration: c.EffectiveDuration > 0 ? c.EffectiveDuration : c.Duration))
                .Concat(imageClips.Select((c, i) => (Segment: imageSegmentNames[i], ClipId: c.Id,
                                                     Start: c.TimelinePosition,
                                                     Duration: c.Duration > 0 ? c.Duration : 5.0)))
                .ToList();

            // The same plan Export builds, so the Working Window shows the gaps rather than
            // closing them — a preview that silently omitted them disagreed with both the timeline
            // above it and the file Export produced (2026-09-05 audit, preview-3 and export-2).
            var plan = ExportSegmentPlanner.Plan(placed).ToList();

            // Gap fillers are encoded at the preview's own canvas so the re-encoding concat below
            // does not have to letterbox them differently from everything else.
            var gapCanvas = PreviewScaleTarget();
            for (var i = 0; i < plan.Count; i++)
            {
                if (plan[i].Kind != ExportSegmentKind.Filler) continue;

                var gapName = $"preview_gap_{Guid.NewGuid():N}.mp4";
                await Ffmpeg.ExecAsync(ExportArgBuilders.BuildFillerSegmentArgs(
                    gapName, plan[i].Duration, previewSettings,
                    gapCanvas?.Width ?? 0, gapCanvas?.Height ?? 0));
                MemFs.Track(gapName, 0, "preview-segment");
                plan[i] = plan[i] with { Segment = gapName };
            }

            var orderedNames     = plan.Select(x => x.Segment).ToArray();
            var orderedDurations = plan.Select(x => x.Duration).ToList();

            // Item #57 T2 — WYSIWYG preview: same-track transitions get a real xfade blend at
            // the junction instead of a hard cut, exactly like Export (reuses the same, T0-fixed,
            // BuildXfadeFilterComplex offset math). Cross-track transitions are out of scope here
            // — this preview only ever assembles PrimaryVideoTrack, same as before this phase.
            var junctions = ExportSegmentPlanner.MatchTransitions(
                plan, Clips.AllTransitions.Where(t => !IsCrossTrackTransition(t)));
            var hasTransitions = junctions.Any(t => t is not null);
            var scaleTo = PreviewScaleTarget();

            // Item #36's core promise: only re-render where changes occurred — never re-encode at
            // put-together time. Background segments ("bgseg_" prefix, incl. cache entries that
            // were consumed earlier) carry pinned codec/dimensions/fps/always-audio params, so an
            // all-background set can be stream-copy concatenated (-c copy, near-instant, zero
            // re-encoding). Any synchronously-encoded segment in the mix (BuildTrimArgs — no
            // pinned audio, no per-segment scaling) forces the re-encoding concat, which also
            // applies the preview scale those segments still need. A timeline with transitions
            // always takes the (slower, user-approved) xfade path below instead — stream-copy
            // concat can't blend a junction.
            var allPinned = orderedNames.Length > 0 && orderedNames.All(n => n.StartsWith("bgseg_", StringComparison.Ordinal));

            // Item #70 phase 161 — when every input is a background segment the sidecar still
            // holds (dual residency) and there are no transitions to blend, the whole assembly can
            // run natively: one stream-copy concat over files already next to the ffmpeg binary,
            // with the result arriving as a JS-side blob URL. No MEMFS, no worker mutex, no bytes
            // through the WASM heap. Any failure falls through to the unchanged in-browser path
            // below IN THIS SAME PASS, so the user never sees a blank preview.
            RemoteSegments.SyncInstance(NativeSidecar.InstanceId);
            var concatDecision = PreviewConcatGate.Decide(
                orderedNames,
                hasTransitions,
                NativeSidecar.HasCapability(SidecarCapabilities.Concat),
                RemoteSegments.TryGetRemoteId);

            string? nativePreviewUrl = null;
            if (concatDecision == PreviewConcatDecision.UseSidecar
                && RemoteSegments.TryGetAll(orderedNames) is { } remoteIds)
            {
                nativePreviewUrl = await PreviewAssembler.TryAssembleAsync(remoteIds, orderedNames, CancellationToken.None);
            }

            if (nativePreviewUrl is not null)
            {
                _timelinePreviewUrl = nativePreviewUrl;
            }
            else
            {
                if (hasTransitions)
                    await ApplyPreviewXfadeTransitionsAsync(orderedNames, orderedDurations, junctions, previewSettings, scaleTo, outName);
                else if (allPinned)
                    await Ffmpeg.ConcatCopyAsync(orderedNames, outName);
                else
                    await Ffmpeg.ConcatClipsAsync(orderedNames, outName, scaleTo);

                // The soundtrack, in the window you actually edit in. Audio tracks were mixed
                // only by the full-quality Preview, which re-renders the whole timeline — so
                // while editing, a separate audio track was silent, and the only way to hear
                // whether the music sat right against the picture was to wait for a full render
                // (2026-09-05 audit, audio-6).
                var mixed = await MixPreviewAudioAsync(outName, previewSettings);

                _timelinePreviewUrl = await Ffmpeg.CreatePreviewUrlAsync(mixed);

                if (mixed != outName)
                {
                    try { await Ffmpeg.DeleteFileAsync(mixed); } catch { }
                }
            }
            BlobLifecycle.Created(_timelinePreviewUrl, "VideoEditor.timelinePreview");
            // Gaps included, and shorter by each blended junction's overlap — the same arithmetic
            // Export uses, so the scrubber's range is the length of the file actually loaded.
            //
            // A music track that runs past the last clip counts too: the mix keeps the longer of
            // the two, so a scrubber measured on the picture alone would stop short of the file it
            // is scrubbing (2026-09-05 audit, preview-18).
            var audioEnd = Clips.AudibleAudioClips
                .Select(a => a.TimelinePosition + a.EffectiveLength)
                .DefaultIfEmpty(0)
                .Max();

            var totalDuration = Math.Max(
                ExportSegmentPlanner.TotalDuration(plan, junctions), audioEnd);

            _timelinePreviewDuration = totalDuration;
            // VideoPreview.LoadUrlAsync does its own swap-then-revoke of whatever _preview is
            // CURRENTLY showing — which is previousTimelinePreviewUrl in the common case (no clip
            // selection happened in between). Capture that before the call so the check below
            // doesn't double-revoke the same string a second time.
            var previewWasShowing = _preview.CurrentUrl;
            // An auto-refresh keeps the playhead and carries on playing. Every rebuild used to
            // start over, so editing anything past the first few seconds meant scrubbing back to
            // where you were, every time (2026-09-05 audit, preview-2).
            await _preview.LoadUrlAsync(
                _timelinePreviewUrl, totalDuration, PlaybackMode.Timeline, preserveTime: true);
            PreviewFreshness.MarkFresh();
            RenderStatus.MarkAllCurrentRendered();

            // The one case VideoPreview's own internal revoke (above) can't cover: the user
            // selected a different clip in between refreshes, so _preview was showing THAT clip's
            // url, not the old timeline one — previousTimelinePreviewUrl is orphaned and nothing
            // else will ever revoke it unless this does.
            if (previousTimelinePreviewUrl is not null
                && previousTimelinePreviewUrl != _timelinePreviewUrl
                && previousTimelinePreviewUrl != previewWasShowing)
            {
                BlobLifecycle.Revoking(previousTimelinePreviewUrl, "VideoEditor.timelinePreview");
                // Item #70 phase 161 — the previous url may be sidecar-origin now, which must NOT
                // go through the worker-locked revoke. PreviewUrlRevoker routes by origin and
                // defaults to the worker path, so pre-existing behavior is unchanged.
                try { await PreviewRevoker.RevokeAsync(previousTimelinePreviewUrl); } catch { }
            }

            // Drop cached segments for signatures no longer present on any current region — e.g.
            // a clip's pre-edit trim/effects state once it's been retrimmed. Only reachable here,
            // after MarkAllCurrentRendered(), so a segment mid-use this call is never evicted.
            var liveSignatures = RenderStatus.Regions.Select(r => r.Signature).ToList();
            foreach (var orphan in SegmentCache.EvictOrphans(liveSignatures))
            {
                try { await Ffmpeg.DeleteFileAsync(orphan); } catch { }
            }
        }
        catch (Exception ex)
        {
            // Anything that goes wrong assembling the Working Window used to escape into a
            // fire-and-forget task and disappear: no message, no log entry, and the preview simply
            // stopped updating while still showing an older assembly. That is the shape of the
            // whole F7 report — the editor looked fine and had quietly stopped keeping up
            // (2026-09-05 audit, F7). The last good preview is deliberately left on screen, being
            // more use than a blank frame, and the person is told it is behind.
            ErrorLog.Log("VideoEditor.RefreshWorkingWindowAsync", ex);
            PreviewFreshness.MarkStale();

            _notifications?.Show(
                "The preview could not be rebuilt, so it is showing an earlier version. "
                + WorkerFailureClassifier.Explain(Ffmpeg.LastFailureKind, EffectiveOptions.NativeSidecar),
                ThemeConstants.Notification.ThemeColor.Warning);

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            // Only the final assembled output is scratch — per-clip segments are now cached in
            // MEMFS for reuse by the next Preview click (see SegmentCache above) instead of being
            // deleted here every time. Consumed background segments (rough or fine) are owned by
            // their RenderRegion/SegmentCache and cleaned up by supersede/orphan deletion.
            try { await Ffmpeg.DeleteFileAsync(outName); } catch { }
            await BackgroundRender.EndDeletionHoldAsync();
        }
    }

    /// <summary>
    /// Mixes the project's audio tracks into the assembled preview.
    /// </summary>
    /// <returns>
    /// The mixed file, or <paramref name="assembled"/> unchanged when there is nothing to mix or
    /// the mix could not be made.
    /// </returns>
    /// <remarks>
    /// <para>Uses <see cref="AudioMixPlanner"/>, the same trim, position and filter arithmetic the
    /// export uses, so the preview and the file agree about what the soundtrack sounds like.</para>
    ///
    /// <para>A failure here returns the silent assembly rather than throwing: a preview with no
    /// music is worth having, and a preview that vanished because the music could not be mixed is
    /// not.</para>
    /// </remarks>
    private async Task<string> MixPreviewAudioAsync(string assembled, ExportSettings previewSettings)
    {
        var plan = AudioMixPlanner.Plan(Clips.AudibleAudioClips);
        if (plan.Count == 0) return assembled;

        var segments = new List<string>(plan.Count);

        try
        {
            for (var i = 0; i < plan.Count; i++)
            {
                var (source, start, end, filter) = plan[i];

                var segName = $"preview_audio_{i:D3}_{Guid.NewGuid():N}.wav";
                await Ffmpeg.ExecAsync(ExportArgBuilders.BuildAudioClipTrimArgs(
                    source, segName, start, end, filter, previewSettings, lossless: true));
                MemFs.Track(segName, 0, "preview-segment");
                segments.Add(segName);
            }

            var mixedName = $"preview_mixed_{Guid.NewGuid():N}.mp4";
            await Ffmpeg.ExecAsync(ExportArgBuilders.BuildAmixArgs(
                assembled, segments, mixedName, previewSettings));
            MemFs.Track(mixedName, 0, "preview-segment");

            return mixedName;
        }
        catch (Exception ex)
        {
            ErrorLog.Log("VideoEditor.MixPreviewAudioAsync", ex);
            return assembled;
        }
        finally
        {
            foreach (var segment in segments)
            {
                try { await Ffmpeg.DeleteFileAsync(segment); } catch { }
            }
        }
    }

    /// <summary>
    /// Empties the Working Window when the timeline has nothing left on it.
    /// </summary>
    private async Task ClearWorkingWindowAsync()
    {
        var stale = _timelinePreviewUrl;
        _timelinePreviewUrl      = null;
        _timelinePreviewDuration = 0;

        if (_preview is not null) await _preview.ClearAsync();

        if (stale is not null)
        {
            BlobLifecycle.Revoking(stale, "VideoEditor.timelinePreview");
            try { await PreviewRevoker.RevokeAsync(stale); } catch { }
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Item #57 T2 — mirrors <c>ExportService.ApplyTransitionsAsync</c>'s filter_complex shape
    /// exactly (same xfade offset math, same audio/quality arg helpers) so the Working Window
    /// shows the same blend Export will actually produce, just at preview scale/quality. Scaling
    /// is deliberately a SEPARATE second pass (<see cref="FfmpegService.ConcatClipsAsync"/> on the
    /// single blended file, reusing the exact scale+pad shape the plain-concat preview path
    /// already relies on) rather than chaining a scale+pad filter directly off xfade's "[vout]"
    /// inside one filter_complex — live-verification found that combined graph reliably hangs
    /// ffmpeg.wasm (no error, no progress, indefinitely) in this app's single-threaded build, while
    /// xfade alone and scale+pad alone both complete normally. Two known-good passes instead of one
    /// fragile combined one.
    /// </summary>
    private async Task ApplyPreviewXfadeTransitionsAsync(
        string[] orderedNames, List<double> orderedDurations, IReadOnlyList<Transition?> junctions,
        ExportSettings previewSettings, (int Width, int Height)? scaleTo, string outName)
    {
        var filterArgs = ExportArgBuilders.BuildXfadeFilterComplex(
            orderedNames, orderedDurations, junctions, withAudio: previewSettings.IncludeAudio);
        var blendedName = scaleTo is null ? outName : $"xfade_blend_{Guid.NewGuid():N}.mp4";

        var args = new List<string>();
        foreach (var n in orderedNames) { args.Add("-i"); args.Add(n); }
        args.AddRange(["-filter_complex", filterArgs, "-map", "[vout]"]);
        if (previewSettings.IncludeAudio) args.AddRange(["-map", "[aout]"]);
        args.AddRange(ExportArgBuilders.AudioOutputArgs(previewSettings));
        args.AddRange(ExportArgBuilders.QualityArgs(previewSettings));
        args.AddRange(["-pix_fmt", previewSettings.PixelFormat, blendedName]);
        await Ffmpeg.ExecAsync([.. args]);

        if (scaleTo is { } scale)
        {
            try
            {
                await Ffmpeg.ConcatClipsAsync([blendedName], outName, scale);
            }
            finally
            {
                try { await Ffmpeg.DeleteFileAsync(blendedName); } catch { }
            }
        }
    }

    /// <summary>Same-track check for a transition — cross-track ones are handled (pre-baked into
    /// the "from" clip's own segment) only by Export's ApplyCrossTrackTransitionsAsync; this
    /// preview path never touches secondary tracks at all, so any cross-track transition must be
    /// excluded rather than misapplied via BuildXfadeFilterComplex's same-track positional
    /// pairing.</summary>
    private bool IsCrossTrackTransition(Transition t) =>
        Clips.FindTrackOf(t.FromClipId)?.Id != Clips.FindTrackOf(t.ToClipId)?.Id;

    /// <summary>
    /// Reuses a segment the background render worker (item #36 phase C) already rendered for this
    /// exact clip content, instead of re-encoding it here. Since phase 83, completed segments are
    /// transferred into the MAIN instance's MEMFS at render completion (see
    /// <see cref="RenderWorkerBackend"/>'s TransferToMainAsync for why touching the render worker
    /// at Preview time is a trap), so consumption is just handing the concat the region's
    /// already-local segment name — no bytes move here. Returns null (falls through to the normal
    /// encode path below) whenever there's nothing ready: background rendering disabled, the
    /// worker hasn't produced anything for this clip yet, or the content changed. Never waits.
    /// Phase D: ROUGH segments are consumed too — a fast, ugly-but-correct preview now beats a
    /// slow perfect one — including during RenderingFine, when the region's SegmentName still
    /// points at the completed rough segment while the fine pass runs (the longest window). Rough
    /// names are deliberately NOT registered in <see cref="SegmentCache"/>: a cache hit
    /// short-circuits this method on the next pass, which would freeze the clip at rough quality
    /// until its next edit. Instead the clip id is recorded so
    /// <see cref="OnRenderStatusChangedForSharpen"/> can refresh the Working Window once the fine
    /// pass lands.
    /// </summary>
    private string? TryConsumeBackgroundSegment(RenderRegion? region, string? signature)
    {
        if (region is null || signature is null) return null;
        if (region.State is not (RenderRegionState.Fine or RenderRegionState.Rough or RenderRegionState.RenderingFine)) return null;
        if (region.SegmentName is null) return null;
        if (region.Signature != signature) return null;

        // Item #38 phase C — this consumption doesn't re-render anything, but it IS active use;
        // without this, LRU eviction would see only render time, not the far more frequent
        // Preview-time reads, and could evict a segment the user is actively watching.
        BackgroundRender.TouchSegment(region.SegmentName);

        if (region.State == RenderRegionState.Fine)
        {
            SegmentCache.Set(signature, region.SegmentName);
            _roughConsumedClipIds.Remove(region.ClipId);
        }
        else
        {
            _roughConsumedClipIds.Add(region.ClipId);
        }
        return region.SegmentName;
    }

    /// <summary>Clips whose ROUGH background segment is what the Working Window currently shows —
    /// when any of them reaches <see cref="RenderRegionState.Fine"/>, the preview auto-refreshes
    /// (via the normal debounced path) so it sharpens without user action. Only meaningful while
    /// background rendering is enabled.</summary>
    private readonly HashSet<Guid> _roughConsumedClipIds = [];

    /// <summary>Guards against the sharpen refresh re-arming the auto-preview debounce on every
    /// subsequent tracker event (progress ticks fire constantly while other clips render) — each
    /// re-arm resets the debounce timer, which would starve the refresh until the whole queue went
    /// quiet. Schedule once; cleared when <see cref="RefreshWorkingWindowAsync"/> actually runs.</summary>
    private bool _sharpenRefreshScheduled;

    private void OnRenderStatusChangedForSharpen()
    {
        if (_sharpenRefreshScheduled || _roughConsumedClipIds.Count == 0) return;

        var anySharpened = _roughConsumedClipIds
            .Any(id => RenderStatus.Regions.Any(r => r.ClipId == id && r.State == RenderRegionState.Fine));
        if (!anySharpened) return;

        // Don't remove from the set here — the refreshed RefreshWorkingWindowAsync run consumes the
        // fine segment and removes it there. Removing it now would break the case where the
        // debounced refresh gets cancelled by an unrelated edit before it runs.
        _sharpenRefreshScheduled = true;
        _ = InvokeAsync(ScheduleAutoPreview);
    }

    /// <summary>After Preview has to synchronously encode a clip itself (no background segment was
    /// ready), nudge the background worker to prioritize that exact clip — so if the user hits
    /// Preview again, or an edit re-triggers auto-preview, it's more likely to already be waiting.
    /// A no-op if background rendering isn't enabled, so <see cref="BackgroundRenderService"/>'s
    /// priority queue never grows when nothing is ever started to drain it.</summary>
    private void RequestBackgroundPriorityIfEnabled(Guid clipId)
    {
        if (EffectiveOptions.BackgroundRendering)
            BackgroundRender.RequestPriority(clipId);
    }

    // ── Export handlers ───────────────────────────────────────────────────────

    private void OnExportComplete()
    {
        _ = UpdateUnloadGuardAsync();

        // ExportDialog invokes this both when a job is queued (AddToQueueAsync, fired at enqueue
        // time — not when the queued render actually finishes) and when an immediate export
        // genuinely completes (StartExportAsync, after the render). ActiveCount > 0 only ever
        // holds right after the former, so it's how we tell the two apart here without needing
        // a dedicated parameter on the callback.
        if (ExportQueue.ActiveCount > 0)
        {
            _showQueuePanel = true; // job queued — open the queue so progress is visible
            StateHasChanged();
            return;
        }

        // Phase 176 — an immediate export ran with delivery deferred (DeferDelivery mirrors this
        // same HasDelegate check), so its output is sitting in OPFS waiting to be placed. Ask
        // where it goes BEFORE the project-save prompt: the render is the thing the user was
        // actually waiting for, and it's the only one of the two holding storage open.
        var job = Exporter.CurrentJob;
        if (OnPublishExport.HasDelegate && job is { State: ExportJobState.Completed, PreviewBlobUrl: not null })
        {
            _retainedExport = job;
            _showExportDestinationPrompt = true;
            StateHasChanged();
            return;
        }

        _showExportSavePrompt = true; // immediate export just finished rendering
        StateHasChanged();
    }

    // ── Rendered-video destination (phase 176) ────────────────────────────────
    //
    // Exactly one of these three runs per retained export, and each ends with the OPFS copy gone
    // (ExportService's Save/Take/Discard are all terminal). The project-save prompt follows once
    // the video has a home — chained here rather than shown alongside, so the user is never
    // looking at two modals asking different questions about the same export.

    private ExportJob? _retainedExport;
    private bool       _showExportDestinationPrompt;

    private async Task PublishExportAsync()
    {
        if (_retainedExport is not { } job) return;

        // Deliberately NOT wrapped in try/catch: ExportDestinationPrompt needs the exception to
        // decide whether to close. Swallowing it here would close the prompt on a failed upload
        // and discard the user's only copy — see OnPublishExport's remarks.
        await Exporter.TakeRetainedExportAsync(job, exported => OnPublishExport.InvokeAsync(exported));
        FinishExportDestination();

        // The one moment the Server tab is known to be stale, because this editor is what made it
        // so. Best-effort: a list that did not reload is no worse than before (2026-09-05 audit,
        // media-10).
        if (_browser is not null)
        {
            try { await _browser.RefreshLibraryAsync(); }
            catch (Exception ex) { ErrorLog.Log("VideoEditor.PublishExportAsync.Refresh", ex); }
        }
    }

    private async Task PostExportToFeedAsync()
    {
        if (_retainedExport is not { } job) return;

        // Same no-try/catch contract as PublishExportAsync: the destination prompt needs the
        // exception (a refused consent, a screening-path failure) to stay open with the render.
        await Exporter.TakeRetainedExportAsync(job, exported => OnPostToFeed.InvokeAsync(exported));
        FinishExportDestination();
    }

    private async Task SaveExportToDeviceAsync()
    {
        if (_retainedExport is not { } job) return;
        await Exporter.SaveRetainedExportToDeviceAsync(job);
