    /// <summary>Adds a new keyframe at the playhead, seeded at the given canvas position — from
    /// double-clicking the preview at that spot.</summary>
    private void AddKeyframeAt((double X, double Y) pos)
    {
        if (!_motionLayerId.HasValue || _motionLayerType is null) return;

        // Evaluate first (so a second-or-later keyframe interpolates from the existing path instead of
        // resetting), falling back to the layer's actual current static values — not hardcoded defaults —
        // so non-position properties don't visibly snap when the first keyframe is added.
        var frame   = Motion.Evaluate(_motionLayerId.Value, Playback.State.CurrentTime);
        var callout = _motionLayerType == "CalloutClip"
            ? Clips.AllCalloutClips.FirstOrDefault(c => c.Id == _motionLayerId.Value)
            : null;

        var kf = new MotionKeyframe
        {
            Time  = Playback.State.CurrentTime,
            X     = pos.X,
            Y     = pos.Y,
            Scale = frame?.Scale ?? 1.0,
            Alpha = frame?.Alpha ?? 1.0,
        };
        if (frame is not null)
        {
            kf.FillColor          = frame.FillColor;
            kf.StrokeColor        = frame.StrokeColor;
            kf.ControlPointValues = new Dictionary<string, double>(frame.ControlPointValues);
        }
        else if (callout is not null)
        {
            kf.FillColor          = callout.FillColor;
            kf.StrokeColor        = callout.StrokeColor;
            kf.ControlPointValues = new Dictionary<string, double>(callout.ControlPointValues);
        }

        Motion.UpsertKeyframe(_motionLayerId.Value, _motionLayerType, kf);
        StateHasChanged();
    }
    private void OnItemTimeShifted(Guid itemId, double deltaSeconds)
        => Motion.ShiftKeyframes(itemId, deltaSeconds);

    private void OnItemRemovedFromStore(Guid itemId)
        => Motion.RemovePath(itemId);

    private void OnPlaybackStateChanged()   => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Re-renders for a layout change, and remembers it.
    /// </summary>
    /// <remarks>
    /// Debounced because a drag raises this on every pointermove: without it a single resize would
    /// write to localStorage a hundred times. The write is fire-and-forget — a browser that refuses
    /// to store (private mode, quota) still gets a working editor for this session, which is what
    /// <c>storageInterop.setItem</c>'s own false return is for.
    /// </remarks>
    private void OnLayoutChanged()
    {
        InvokeAsync(StateHasChanged);
        ScheduleLayoutSave();
    }

    private CancellationTokenSource? _layoutSaveCts;

    private void ScheduleLayoutSave()
    {
        _layoutSaveCts?.Cancel();
        _layoutSaveCts?.Dispose();
        _layoutSaveCts = new CancellationTokenSource();
        var token = _layoutSaveCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(300, token);
                var storage = await StorageAsync();
                await storage.InvokeAsync<bool>("setItem", LayoutService.StorageKey, Layout.Serialise());
            }
            catch (OperationCanceledException) { /* superseded by a later change */ }
            catch (Exception ex) { ErrorLog.Log("VideoEditor.SaveLayout", ex); }
        });
    }

    private IJSObjectReference? _storage;

    private async Task<IJSObjectReference> StorageAsync() =>
        _storage ??= await JS.InvokeAsync<IJSObjectReference>(
            "benImportEditorModule", "js/storageInterop.js");

    /// <summary>Restores the remembered panel width, timeline height and tab.</summary>
    private async Task RestoreLayoutAsync()
    {
        try
        {
            var storage = await StorageAsync();
            var stored  = await storage.InvokeAsync<string?>("getItem", LayoutService.StorageKey);
            Layout.Apply(LayoutService.Deserialise(stored));
        }
        catch (Exception ex)
        {
            // A layout preference is never worth failing to open the editor over.
            ErrorLog.Log("VideoEditor.RestoreLayout", ex);
        }
    }

    // ── Layout ─────────────────────────────────────────────────────────────────────────────────

    /// <summary>
    /// The composition's shape, as an <c>aspect-ratio</c> value for the preview stage.
    /// </summary>
    /// <remarks>
    /// The black stage used to be whatever box the flexbox left over, with the video letterboxed
    /// inside it by <c>object-fit: contain</c>. That is fine for the picture and wrong for
    /// everything drawn on top of it: the callout, title and control-point overlays are positioned
    /// against the stage's own box, so they drifted away from the frame whenever the two shapes
    /// disagreed. Giving the stage the composition's aspect ratio makes the two the same box
    /// (2026-09-05 audit, F4).
    /// </remarks>
    private string CanvasAspect
    {
        get
        {
            var w = ExportRes.Width  > 0 ? ExportRes.Width  : 1920;
            var h = ExportRes.Height > 0 ? ExportRes.Height : 1080;
            return string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{w} / {h}");
        }
    }

    /// <summary>
    /// Sizes the timeline to the tracks it holds, until the person sizes it themselves.
    /// </summary>
    private void AutoFitTimeline()
    {
        if (_timeline is null) return;
        Layout.AutoFitTimeline(_timeline.PreferredHeightPx);
    }

    // ── Multi-select bulk handlers ─────────────────────────────────────────────────────────────────────────────────────

    private Task OnBulkDeleteAsync(IReadOnlyList<Guid> ids)
    {
        foreach (var id in ids)
            Clips.RemoveClip(id);
        // Same stale-selection gap as item #26's single-remove fix — clear every selection field
        // a deleted id could match, not just the two most commonly multi-selected types.
        foreach (var id in ids)
            OnTimelineItemRemoved(id);
        return Task.CompletedTask;
    }

    private Task OnBulkMoveAsync((IReadOnlyList<Guid> Ids, double DeltaSeconds) args)
    {
        foreach (var id in args.Ids)
            Clips.MoveClip(id, args.DeltaSeconds);
        return Task.CompletedTask;
    }

    // ── Transfer progress state ───────────────────────────────────────────────────

    private sealed class TransferProgressState(string title, string label)
    {
        public string Title          { get; }      = title;
        public string Label          { get; }      = label;
        public int    Percent        { get; private set; } = -1;
        public string FormattedBytes { get; private set; } = "0 B";
        public string FormattedTotal { get; private set; } = "?";

        public void Update(TransferProgress tp)
        {
            Percent        = tp.Percent;
            FormattedBytes = tp.FormattedBytes;
            FormattedTotal = tp.FormattedTotal;
        }
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        // Audit #4 — release the cached interop module handles. Guarded because teardown races
        // circuit shutdown: once the circuit is gone the module is already unreachable and
        // disposing it throws, which must not surface as an error during a normal navigation.
        if (_dom is not null)
        {
            try { await _dom.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _dom = null;
        }

        Ffmpeg.OnStateChanged   -= OnFfmpegStateChanged;
        Ffmpeg.OnWorkerCrashed  -= OnFfmpegWorkerCrashed;
        PreviewQuality.OnChanged -= OnPreviewQualityChanged;
        StopStallWatch();
        _unloadSelfRef?.Dispose();
        Ffmpeg.OnStateChanged   -= OnFfmpegStateChangedForBackgroundRender;
        RenderStatus.OnChanged  -= OnRenderStatusChangedForSharpen;
        BackgroundRender.OnLoopError -= OnBackgroundRenderLoopError;
        _layoutSaveCts?.Cancel();
        _layoutSaveCts?.Dispose();
        Clips.OnChange          -= OnClipsChanged;
        Clips.ItemTimeShifted   -= OnItemTimeShifted;
        Clips.ItemRemoved       -= OnItemRemovedFromStore;
        Playback.OnStateChanged -= OnPlaybackStateChanged;
        Layout.OnChanged        -= OnLayoutChanged;
        Projects.OnChanged      -= OnProjectStoreChanged;
        Projects.OnRefetchOffered -= OnProjectStoreChanged;
        ExportQueue.OnChanged   -= OnQueueChanged;
        await BackgroundRender.DisposeAsync();

        _autoPreviewCts?.Cancel();
        _autoPreviewCts?.Dispose();

        await Keyboard.DisposeAsync();

        // Phase 144 — the child VideoPreview instances (_preview/_fullQualityPreview) may
        // independently revoke these same strings via their own DisposeAsync as the render tree
        // tears down; BlobLifecycle.Revoking logs (doesn't throw) if that race already happened,
        // same as everywhere else in this file. On full component teardown the actual user impact
        // is zero either way — this is diagnostic parity, not a functional fix.
        if (_timelinePreviewUrl is not null)
        {
            BlobLifecycle.Revoking(_timelinePreviewUrl, "VideoEditor.timelinePreview");
            // Item #70 phase 161 made this url possibly sidecar-origin (assembled by a native
            // concat, minted in JS with no MEMFS backing) — that phase routed the orphan-revoke
            // path and both VideoPreview paths through PreviewUrlRevoker but MISSED this disposal
            // one, so a sidecar-origin url was still being revoked through the ffmpeg worker.
            // PreviewUrlRevoker defaults unknown urls to the worker route, so this is a no-op for
            // every worker-origin url and a fix for the sidecar-origin case.
            try { await PreviewRevoker.RevokeAsync(_timelinePreviewUrl); } catch { }
        }

        if (_fullQualityPreviewUrl is not null)
        {
            BlobLifecycle.Revoking(_fullQualityPreviewUrl, "VideoEditor.fullQualityPreview");
            // Always worker-origin today (the full-quality preview is never sidecar-assembled),
            // but routed through the same revoker so it can't become wrong if that changes.
            try { await PreviewRevoker.RevokeAsync(_fullQualityPreviewUrl); } catch { }
        }

        if (Ffmpeg.State is FfmpegState.Ready or FfmpegState.Processing)
            await Ffmpeg.TerminateAsync();

        _fullscreenSelfRef?.Dispose();
        if (_fullscreenModule is not null)
        {
            try { await _fullscreenModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }

        if (_viewportModule is not null)
        {
            try { await _viewportModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
