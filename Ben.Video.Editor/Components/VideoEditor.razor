    private async Task OnTimelineItemSelected(TrackItem item)
    {
        // Auto-switch to Properties and make sure the panel is showing.
        Layout.SetPanelTab("props");
        Layout.SetPanelCollapsed(false);

        // Selecting any other layer exits an active motion-path edit — mirrors the fix already
        // applied in the other direction by ActivateMotionPath (which clears the selections below).
        _motionLayerId   = null;
        _motionLayerType = null;

        // Selecting on the timeline moves the timeline's playhead to the clip's start; it does not
        // load that clip's raw source into the Working Window. It used to, which swapped the window
        // into a single-clip preview with its own clock starting at zero and no way back except
        // making an edit — and every subsequent split, marker or title placement then read that
        // clock as if it were the timeline's (2026-09-05 audit, F6 and timeline-3). Previewing one
        // clip on its own is still what clicking a card in the Media tab does.
        Playback.SetTimelineTime(item.TimelinePosition);

        if (item is VideoClip clip)
        {
            _selectedAudioClip  = null;
            _selectedTransition = null;
            _selectedClip = clip;
            StateHasChanged();
        }
        else if (item is AudioClip audio)
        {
            _selectedClip       = null;
            _selectedTransition = null;
            _selectedAudioClip  = audio;
            StateHasChanged();
        }
        else if (item is Transition transition)
        {
            _selectedClip        = null;
            _selectedAudioClip   = null;
            _selectedTextOverlay = null;
            _selectedTransition  = transition;
            StateHasChanged();
        }
        else if (item is TextOverlay textOverlay)
        {
            _selectedClip        = null;
            _selectedAudioClip   = null;
            _selectedImageClip   = null;
            _selectedTransition  = null;
            _selectedTextOverlay = textOverlay;
            StateHasChanged();
        }
        else if (item is ImageClip imageClip)
        {
            _selectedClip        = null;
            _selectedAudioClip   = null;
            _selectedTransition  = null;
            _selectedTextOverlay = null;
            _selectedImageClip   = imageClip;
            _selectedCallout     = null;
            StateHasChanged();
        }
        else if (item is CalloutClip callout)
        {
            _selectedClip        = null;
            _selectedAudioClip   = null;
            _selectedTransition  = null;
            _selectedTextOverlay = null;
            _selectedImageClip   = null;
            _selectedClipArt     = null;
            _selectedCallout     = callout;
            StateHasChanged();
        }
        else if (item is ClipArtClip clipArt)
        {
            _selectedClip        = null;
            _selectedAudioClip   = null;
            _selectedTransition  = null;
            _selectedTextOverlay = null;
            _selectedImageClip   = null;
            _selectedCallout     = null;
            _selectedClipArt     = clipArt;
            StateHasChanged();
        }
    }

