@inject FfmpegService Ffmpeg
@inject ExportService Exporter
@inject ClipStore Clips
@inject PlaybackService Playback
@inject KeyboardShortcutService Keyboard
@inject ProjectService Project
@inject ProjectStore Projects
@inject IProjectServerStore ServerProjects
@inject ErrorLogService ErrorLog
@inject ExportQueueService ExportQueue
@inject MotionKeyframeService Motion
@inject LayoutService Layout
@inject ExportResolutionService ExportRes
@inject PreviewQualityService PreviewQuality
@inject OPFSService Opfs
@inject PreviewFreshnessService PreviewFreshness
@inject RenderStatusService RenderStatus
@inject PreviewSegmentCache SegmentCache
@inject SourceMounter Mounter
@inject Ben.Video.RenderService.BackgroundRenderService BackgroundRender
@inject RenderWorkerService RenderWorker
@inject ClipEffectRegistry EffectRegistry
@inject BlobUrlLifecycle BlobLifecycle
@using Ben.Video.Core.SidecarContracts
@inject MemFsLedger MemFs
@* Item #70 phase 161 — native preview assembly (sidecar concat) with wasm fallback. *@
@inject NativeSidecarService NativeSidecar
@inject RemoteSegmentIndex RemoteSegments
@inject SidecarPreviewAssembler PreviewAssembler
@inject PreviewUrlRevoker PreviewRevoker
@inject IOptions<VideoEditorOptions> EditorOptionsAccessor
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IKeyboardCommandTarget

<div class="bv-editor" @ref="_editorRoot" style="--bv-timeline-h: @(Layout.TimelineHeight)px; --bv-panel-w: @(Layout.PanelWidth)px; --bv-canvas-aspect: @CanvasAspect">

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    @* One predicate, shared with the export dialog and the pipeline's own "nothing to export"
       check, so the button and the dialog can never disagree about whether there is anything
       to render (2026-09-05 audit, export-20).

       ShowSaveToServer is the store's own answer, not a configured URL. A URL being set says the
       server exists, not that this person can reach it — and on the site it was set while every
       save answered 401 (2026-09-05 audit, F13).

       ProjectName is the bare name. The unsaved asterisk used to be part of the value in the
       toolbar's text box, so renaming a project with unsaved changes saved it as "My Project *" —
       the marker became part of the name and stayed there (2026-09-05 audit, persistence-5). The
       toolbar draws that mark from IsDirty beside the box instead. *@
    <Toolbar HasClips="@Clips.HasExportableContent"
             CanSave="@(Clips.HasSaveableContent || Projects.IsDirty)"
             ShowMultiTrack="@EffectiveOptions.MultiTrack"
             ShowAudioTracks="@EffectiveOptions.AudioTracks"
             ShowTransitions="@EffectiveOptions.Transitions"
             ShowTextOverlays="@EffectiveOptions.TextOverlays"
             CanUndo="@Clips.CanUndo"
             CanRedo="@Clips.CanRedo"
             UndoDescription="@Clips.UndoDescription"
             RedoDescription="@Clips.RedoDescription"
             ShowProjectPersistence="@EffectiveOptions.ProjectPersistence"
             ShowSaveToServer="@ServerProjects.IsAvailable"
             ProjectName="@Projects.CurrentProjectName"
             IsDirty="@Projects.IsDirty"
             ShowErrorLog="@EffectiveOptions.ErrorLog"
             ShowNativeSidecar="@EffectiveOptions.NativeSidecar"
             ShowDiagnostics="@EffectiveOptions.ShowDiagnostics"
             OnInitialize="LoadCoreAsync"
             OnResetEngine="ResetEngineAsync"
             HostStatusContent="@HostStatusContent"
             OnOpen="OpenFilesAsync"
             OnPreview="RenderFullQualityPreviewAsync"
             OnExport="OpenExportDialog"
             OnUndo="() => Clips.Undo()"
             OnRedo="() => Clips.Redo()"
             OnSave="SaveProjectAsync"
             OnSaveToDevice="SaveToDeviceAsync"
             OnSaveToServer="SaveToServerHandlerAsync"
             OnSaveProject="SaveToDeviceAsync"
             OnOpenProject="OpenProjectAsync"
             OnNewProject="NewProjectAsync"
             OnOpenProjectList="OpenProjectListAsync"
             OnExportJson="ExportProjectJsonAsync"
             OnImportJson="ImportProjectJsonAsync"
             OnHelp="ToggleHelp"
             OnExportErrorLog="ExportErrorLogAsync"
             OnProjectNameChanged="OnProjectNameChangedAsync"
             QueueCount="@ExportQueue.ActiveCount"
             OnToggleQueue="() => _showQueuePanel = !_showQueuePanel"
             ShowAssetBrowser="@_showAssetBrowser"
             OnToggleAssetBrowser="() => _showAssetBrowser = !_showAssetBrowser"
             ShowPanel="@Layout.PanelCollapsed"
             OnTogglePanel="@(() => Layout.SetPanelCollapsed(false))"
             IsFullscreen="@_isFullscreen"
             OnToggleFullscreen="ToggleFullscreenAsync"
             HasSubtitles="@Clips.AllTextOverlays.Any()"
             OnExportSrt="ExportSrtAsync"
             OnExportVtt="ExportVttAsync" />

    <!-- ── Project list dialog ──────────────────────────────────────────── -->
    <ProjectListDialog @bind-Visible="_showProjectList"
                       OnOpen="OnProjectListOpenAsync" />

    @* Shown only under 900px, by a container query — see the stylesheet. Rendered always so the
       editor never has to guess at a viewport it cannot measure from C#. *@
    <div class="bv-editor__too-narrow">
        <span class="bv-editor__too-narrow-title">This editor needs a wider window</span>
        <span class="bv-editor__too-narrow-body">
            Editing video means a timeline, a picture and a properties panel side by side. Open this
            on a desktop or laptop, or widen this window, and it will come back.
        </span>
    </div>

    <!-- ── Workspace: the picture, and the panel beside it ──────────────── -->
    @* The Media & Properties panel used to be a floating TelerikWindow parked at the right edge,
       where it covered the timeline's own Ripple, Callout and Marker buttons at any width, forgot
       where it had been put on every reload, and gave Properties 320x420 to show a form twice that
       tall. It is a docked column now: nothing overlaps, the form gets the full height of the
       editor, and the width is remembered (2026-09-05 audit, F3). *@
    <div class="bv-workspace">

        <div class="bv-workspace__stage">
            <!-- ── Preview ──────────────────────────────────────────────── -->
            <div class="bv-preview-row" style="@(_isPoppedOut ? "display:none" : null)">
                @if (!_isPoppedOut)
                {
                    <VideoPreview @ref="_preview"
                                  OwnerLabel="WorkingWindow"
                                  OnTimeUpdate="OnPreviewTimeUpdate"
                                  MotionLayerId="@_motionLayerId"
                                  OnMotionKeyframeSelected="OnMotionKeyframeSelected"
                                  OnAddKeyframeAt="AddKeyframeAt"
                                  ActiveCallout="@_selectedCallout"
                                  ActiveClipArt="@_selectedClipArt"
                                  ActiveTextOverlay="@_selectedTextOverlay"
                                  OnCanvasItemSelected="OnCanvasItemSelected"
                                  OnPopoutRequested="OpenPopoutAsync"
                                  SnappingEnabled="@EffectiveOptions.Snapping"
                                  SelectedCanvasItem="@SelectedCanvasItem"
                                  OnAnimate="@(args => ActivateMotionPath(args.Id, args.Type))" />
                }
            </div>

        @if (!_isPoppedOut && Playback.State.Mode == PlaybackMode.Clip && _previewedLibraryClip is not null)
        {
            <!-- ── Three-point editing marks (item #51) ─────────────────────────── -->
            <div class="bv-mark-inout">
                <TelerikButton OnClick="MarkIn" Size="@ThemeConstants.Button.Size.Small" Title="Mark in-point at the current preview position">
                    Mark In
                </TelerikButton>
                <TelerikButton OnClick="MarkOut" Size="@ThemeConstants.Button.Size.Small" Title="Mark out-point at the current preview position">
                    Mark Out
                </TelerikButton>
                @if (_markedIn.HasValue || _markedOut.HasValue)
                {
                    <span class="bv-mark-inout__summary">
                        @(_markedIn.HasValue ? PlaybackService.FormatTime(_markedIn.Value) : "—") → @(_markedOut.HasValue ? PlaybackService.FormatTime(_markedOut.Value) : "—")
                        (next "Add to Timeline" uses this range)
                    </span>
                    <TelerikButton OnClick="ClearMarks" Size="@ThemeConstants.Button.Size.Small" FillMode="@ThemeConstants.Button.FillMode.Flat" Title="Clear marks">
                        Clear
                    </TelerikButton>
                }
            </div>
        }
        </div>

        @if (!Layout.PanelCollapsed)
        {
            <ResizableDivider Direction="horizontal" Target="next"
                              OnResize="@(px => Layout.SetPanelWidth(px))" />

            <aside class="bv-side-panel">
                <div class="bv-side-panel__header">
                    <span class="bv-side-panel__title">Media &amp; Properties</span>
                    <TelerikButton OnClick="@(() => Layout.TogglePanel())"
                                   Icon="@SvgIcon.WindowMinimize"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Title="Collapse this panel" />
                </div>
                <TelerikTabStrip ActiveTabId="@Layout.PanelTab"
                                 ActiveTabIdChanged="@(id => Layout.SetPanelTab(id))"
                                 Size="@ThemeConstants.TabStrip.Size.Small"
                                 PersistTabContent="true"
                                 Class="bv-side-panel__tabs">

                    <TabStripTab Title="📁 Media" Id="media">
                        <ClipBrowser @ref="_browser"
                                     EditorOptions="EffectiveOptions"
                                     OnClipSelected="OnClipSelectedAsync"
                                     OnAddToTimeline="AddClipToTimeline"
                                     OnAudioClipAdded="OnAudioClipAdded"
                                     OnAddImageToTimeline="AddImageToTimeline"
                                     OnAddAudioToTimeline="AddAudioToTimeline"
                                     HostStatusContent="@HostStatusContent" />
                    </TabStripTab>

                    @if (_showAssetBrowser)
                    {
                        <TabStripTab Title="🖼 Assets" Id="assets">
                            <AssetBrowser />
                        </TabStripTab>
                    }

                    <TabStripTab Title="⚙ Properties" Id="props">
                        <div class="bv-props-tab">
                            @if (_selectedClip is not null)
                            {
                                <ClipEditor Clip="@_selectedClip"
                                            EditorOptions="EffectiveOptions"
                                            OnClose="ClearSelectedClip"
                                            OnTrimApplied="OnTrimApplied"
                                            OnClipSplit="OnClipSplit"
                                            OnClipDeleted="OnClipDeleted" />
                            }
                            else if (_selectedAudioClip is not null)
                            {
                                <AudioClipEditor Clip="@_selectedAudioClip"
                                                 OnClose="ClearSelectedAudioClip"
                                                 OnClipDeleted="OnAudioClipDeleted"
                                                 OnClipSplit="OnAudioClipSplit" />
                            }
                            else if (_selectedImageClip is not null)
                            {
                                <ImageClipEditor Clip="@_selectedImageClip"
                                                 OnClose="ClearSelectedImageClip"
                                                 OnRemove="OnImageClipRemoved"
                                                 OnClipSplit="OnImageClipSplit" />
                            }
                            else if (_selectedCallout is not null)
                            {
                                <CalloutEditor Clip="@_selectedCallout"
                                               OnClose="@(() => _selectedCallout = null)"
                                               OnRemove="@(() => { Clips.RemoveCallout(_selectedCallout!.Id); _selectedCallout = null; })"
                                               OnAnimate="@(args => ActivateMotionPath(args.Id, args.Type))" />
                            }
                            else if (_selectedClipArt is not null)
                            {
                                <ClipArtEditor Clip="@_selectedClipArt"
                                               OnClose="@(() => _selectedClipArt = null)"
                                               OnRemove="@(() => { Clips.RemoveClipArtClip(_selectedClipArt!.Id); _selectedClipArt = null; })"
                                               OnAnimate="@(args => ActivateMotionPath(args.Id, args.Type))" />
                            }
                            else if (_motionLayerId.HasValue)
                            {
                                <MotionKeyframeEditor LayerId="@_motionLayerId"
                                                      LayerType="@_motionLayerType"
                                                      KeyframeIndex="@_motionKeyframeIndex"
                                                      OnClose="@(() => { _motionLayerId = null; _motionLayerType = null; })" />
                            }
                            else if (_selectedTransition is not null)
                            {
                                <TransitionEditor Transition="@_selectedTransition"
                                                  OnClose="ClearSelectedTransition"
                                                  OnRemoved="ClearSelectedTransition" />
                            }
                            else if (_selectedTextOverlay is not null)
                            {
                                <TextOverlayEditor Overlay="@_selectedTextOverlay"
                                                   OnClose="ClearSelectedTextOverlay"
                                                   OnRemoved="ClearSelectedTextOverlay"
                                                   OnAnimate="@(args => ActivateMotionPath(args.Id, args.Type))" />
                            }
                            else
                            {
                                <div class="bv-props-empty">Select a clip on the timeline to edit its properties.</div>
                            }
                        </div>
                    </TabStripTab>

                </TelerikTabStrip>
            </aside>
        }
    </div>

    @* The seam. Target="next" so dragging it upward grows the timeline; the preview simply takes
       what is left, which is why it no longer needs a height of its own. *@
    <ResizableDivider Direction="vertical" Target="next"
                      OnResize="@(px => Layout.SetTimelineHeight(px))" />


    @if (_isPoppedOut)
    {
        <TelerikWindow Visible="true"
                       VisibleChanged="@(v => { if (!v) { _preview?.DetachWithoutRevoking(); _isPoppedOut = false; _pendingWorkingWindowRehydrate = true; } })"
                       Draggable="true"
                       Resizable="true"
                       Width="@_popoutWidth"
                       WidthChanged="OnPopoutWidthChanged"
                       Height="@_popoutHeight"
                       HeightChanged="OnPopoutHeightChanged"
                       MaxWidth="@_popoutMaxWidth"
                       MaxHeight="@_popoutMaxHeight"
                       MinWidth="240px"
                       MinHeight="180px"
                       Class="bv-preview-popout-window">
            <WindowTitle>Working Window</WindowTitle>
            <WindowActions>
                <WindowAction Name="Close" />
            </WindowActions>
            <WindowContent>
                <VideoPreview @ref="_preview"
                              OwnerLabel="WorkingWindow"
                              OnTimeUpdate="OnPreviewTimeUpdate"
                              MotionLayerId="@_motionLayerId"
                              OnMotionKeyframeSelected="OnMotionKeyframeSelected"
                              ActiveCallout="@_selectedCallout"
                              ActiveClipArt="@_selectedClipArt"
                              ActiveTextOverlay="@_selectedTextOverlay"
                              OnCanvasItemSelected="OnCanvasItemSelected"
                              OnPopoutRequested="OpenPopoutAsync"
                              SnappingEnabled="@EffectiveOptions.Snapping"
                              SelectedCanvasItem="@SelectedCanvasItem"
                              OnAnimate="@(args => ActivateMotionPath(args.Id, args.Type))" />
            </WindowContent>
        </TelerikWindow>
    }

    <!-- ── Full-quality Preview output (item #36 phase 84) — a genuinely separate window from
         the Working Window above; only ever visible while _showFullQualityPreview is true. ──── -->
    @if (_showFullQualityPreview)
    {
        <TelerikWindow Visible="true"
                       VisibleChanged="@(v => { if (!v) OnCloseFullQualityPreview(); })"
                       Draggable="true"
                       Resizable="true"
                       Width="@_fullQualityWidth"
                       WidthChanged="OnFullQualityWidthChanged"
                       Height="@_fullQualityHeight"
                       HeightChanged="OnFullQualityHeightChanged"
                       MaxWidth="@_fullQualityMaxWidth"
                       MaxHeight="@_fullQualityMaxHeight"
                       MinWidth="240px"
                       MinHeight="180px"
                       Class="bv-preview-popout-window">
            <WindowTitle>Preview @(ExportRes.Width)&times;@(ExportRes.Height)</WindowTitle>
            <WindowActions>
                <WindowAction Name="Close" />
            </WindowActions>
            <WindowContent>
                @if (_fullQualityRendering)
                {
                    <div class="bv-fullquality-preview__status">
                        <div>Rendering full-quality preview&hellip; @_fullQualityPercent%</div>

                        @* A render that stops reporting progress used to be indistinguishable from
                           a slow one, with nothing to press either way (2026-09-05 audit, F7). *@
                        @if (_fullQualityStalled)
                        {
                            <p class="bv-fullquality-preview__stalled" role="alert">
                                No progress for @PreviewStallSeconds seconds. The video engine may
                                be stuck. Your project is untouched either way.
                            </p>
                        }

                        <div class="bv-fullquality-preview__actions">
                            <TelerikButton OnClick="CancelFullQualityPreview"
                                           Size="@ThemeConstants.Button.Size.Small"
                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                           Class="btn-sm text-nowrap">
                                Stop
                            </TelerikButton>
                            @if (_fullQualityStalled)
                            {
                                <TelerikButton OnClick="ResetFromStalledPreviewAsync"
                                               Size="@ThemeConstants.Button.Size.Small"
                                               ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                               Class="btn-sm text-nowrap">
                                    Stop and restart the engine
                                </TelerikButton>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <VideoPreview @ref="_fullQualityPreview"
                                  OwnerLabel="FullQualityPreview"
                                  ShowWorkingWindowControls="false"
                                  Standalone="true" />
                }
            </WindowContent>
        </TelerikWindow>
    }

    <!-- ── Timeline ─────────────────────────────────────────────────────── -->
    @* Wrapped, and the wrapper is what carries the height. The timeline's own root asks for
       height:100%, which as a bare flex child of .bv-editor made its flex-basis the whole editor
       and squeezed the preview to a strip (2026-09-05 audit, F4). *@
    <div class="bv-timeline-row">
        <VideoTimeline @ref="_timeline"
                       MultiTrack="@EffectiveOptions.MultiTrack"
                       AudioTracks="@EffectiveOptions.AudioTracks"
                       EditorOptions="EffectiveOptions"
                       OnItemSelected="OnTimelineItemSelected"
                       OnItemRemoved="OnTimelineItemRemoved"
                       OnRelinkRequested="OnRelinkRequestedAsync"
                       OnBulkDelete="OnBulkDeleteAsync"
                       OnBulkMove="OnBulkMoveAsync"
                       OnTimelineKeyframeSelected="OnTimelineKeyframeSelected"
                       OnDropConflict="OnDropConflictAsync"
                       OnSaveFrame="OnSaveFrameAsync" />
    </div>

    <!-- ── Export Dialog ───────────────────────────────────────────────────────── -->
    <ExportDialog @ref="_exportDialog"
                  DeferDelivery="@OnPublishExport.HasDelegate"
                  OnExportComplete="OnExportComplete" />

    <!-- ── Export Queue Panel ──────────────────────────────────────────────────── -->
    <ExportQueuePanel @bind-Visible="_showQueuePanel" />

    <!-- ── Where the rendered video goes (phase 176 — host-supplied publish only) ──── -->
    @* FileName below is the SAME name the host receives on ExportedVideo — not the raw
       OutputFilename setting, which has no extension, so the prompt used to say "output"
       for a file everything else calls "output.mp4". *@
    <ExportDestinationPrompt @bind-Visible="_showExportDestinationPrompt"
                             FileName="@(_retainedExport is { } retained ? ExportService.RetainedFileName(retained) : string.Empty)"
                             SizeBytes="@(_retainedExport?.OutputSizeBytes ?? 0)"
                             OnUpload="PublishExportAsync"
                             OnSaveToDevice="SaveExportToDeviceAsync"
                             OnDiscard="DiscardExportAsync"
                             CanUpload="@EnablePublish"
                             UploadUnavailableReason="@PublishUnavailableReason"
                             ShowPostToFeed="@(EnablePostToFeed && OnPostToFeed.HasDelegate)"
                             OnPostToFeed="PostExportToFeedAsync" />

    <!-- ── Post-export save prompt (immediate exports only — see OnExportComplete) ─── -->
    <ExportSavePrompt @bind-Visible="_showExportSavePrompt"
                      ShowServerOption="@ServerProjects.IsAvailable"
                      OnSaveLocally="SaveProjectAsync"
                      OnSaveToServer="SaveToServerHandlerAsync" />

    <!-- ── Media this project needs, waiting on the server (2026-09-05 audit, F14) ── -->
    <MissingMediaPrompt Candidates="@Projects.PendingRefetch"
                        OnDownload="DownloadMissingMediaAsync"
                        OnLater="Projects.DeclineRefetch" />

    <!-- ── "Not enough room" insert/overwrite confirmation (items #25, #49) ───────── -->
    <RippleInsertPrompt Visible="_rippleInsertPromptVisible"
                        ClipName="@(_pendingDrop?.Item.Name ?? _pendingRippleClip?.Name ?? "this clip")"
                        OnConfirm="ConfirmRippleInsert"
                        OnOverwrite="ConfirmOverwriteInsert"
                        OnCancel="CancelRippleInsert" />

    <!-- ── Keyboard shortcut help overlay ──────────────────────────────────────── -->
    @if (_showHelp)
    {
        <div class="bv-kbd-help" @onclick="() => _showHelp = false">
            <div class="bv-kbd-help__panel" @onclick:stopPropagation>
                <div class="bv-kbd-help__header">
                    <span>Keyboard Shortcuts</span>
                    <TelerikButton OnClick="() => _showHelp = false"
                                   Icon="@SvgIcon.X"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat" />
                </div>
                <table class="bv-kbd-help__table">
                    <tbody>
                        <tr><td><kbd>Space</kbd></td><td>Play / Pause preview</td></tr>
                        <tr><td><kbd>Delete</kbd> / <kbd>Backspace</kbd></td><td>Delete selected clip(s)</td></tr>
                        <tr><td><kbd>S</kbd></td><td>Split selected video clip at playhead</td></tr>
                        <tr><td><kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>Click</kbd></td><td>Multi-select clips on timeline</td></tr>
                        <tr><td><kbd>[</kbd> / <kbd>]</kbd></td><td>Nudge selected clips ±1 s</td></tr>
                        <tr><td><kbd>Escape</kbd></td><td>Close editor panel / clear selection</td></tr>
                        <tr><td><kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>Z</kbd></td><td>Undo</td></tr>
                        <tr><td><kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>Y</kbd> / <kbd>Shift</kbd>+<kbd>Z</kbd></td><td>Redo</td></tr>
                        <tr><td><kbd>M</kbd></td><td>Add marker at playhead</td></tr>
                        <tr><td><kbd>←</kbd> / <kbd>→</kbd></td><td>Step back / forward one frame (nudge, with a layer selected)</td></tr>
                        <tr><td><kbd>Home</kbd> / <kbd>End</kbd></td><td>Jump to the start / end</td></tr>
                        <tr><td><kbd>Fit</kbd> button</td><td>Zoom timeline to fit all clips in view</td></tr>
                        <tr><td><kbd>?</kbd></td><td>Toggle this help</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ── Notifications (toast feedback) ────────────────────────────── -->
    <TelerikNotification @ref="_notifications"
                         HorizontalPosition="@NotificationHorizontalPosition.Right"
                         VerticalPosition="@NotificationVerticalPosition.Top" />

</div>

@code {
    // ── Feature flag [Parameter] overrides ───────────────────────────────────

    /// <summary>Override MultiTrack feature flag. Null = use IOptions value.</summary>
    [Parameter] public bool? MultiTrack   { get; set; }

    /// <summary>Override AudioTracks feature flag. Null = use IOptions value.</summary>
    [Parameter] public bool? AudioTracks  { get; set; }

    /// <summary>Override Transitions feature flag. Null = use IOptions value.</summary>
    [Parameter] public bool? Transitions  { get; set; }

    /// <summary>Override TextOverlays feature flag. Null = use IOptions value.</summary>
    [Parameter] public bool? TextOverlays { get; set; }

    /// <summary>
    /// Supply a complete <see cref="VideoEditorOptions"/> object to override ALL flags at once.
    /// Individual bool? parameters (MultiTrack, AudioTracks, Transitions, TextOverlays) are
    /// still applied on top of this object. Null = use the IOptions value from DI.
    /// </summary>
    [Parameter] public VideoEditorOptions? EditorOptions { get; set; }

    /// <summary>
    /// Phase 176 — supply a handler to give the user a second place to send a finished render:
    /// the host application, rather than their own machine. When set, "Export Now" ends with a
    /// destination prompt ("Upload to server" / "Save to my machine") instead of downloading
    /// unconditionally. Leave unset and export behaves exactly as it always has.
    ///
    /// <para>The <see cref="ExportedVideo"/> is valid only until the handler's task completes —
    /// the editor deletes its OPFS copy immediately afterwards. Read the bytes inside the handler,
    /// don't stash the object.</para>
    ///
    /// <para><b>Throw to report failure.</b> The prompt catches it, stays open, and shows the
    /// message, leaving "Save to my machine" available — returning normally is taken as "the video
    /// is safely on the server" and the only remaining copy is discarded.</para>
    /// </summary>
    [Parameter] public EventCallback<ExportedVideo> OnPublishExport { get; set; }

    /// <summary>
    /// The feed destination (item 186 F7). Same contract as <see cref="OnPublishExport"/>:
    /// throws on failure so the prompt keeps the render. The HOST owns the confirmation dialog —
    /// case lineage, privacy wording and consent are its knowledge, not the editor's.
    /// </summary>
    [Parameter] public EventCallback<ExportedVideo> OnPostToFeed { get; set; }

    /// <summary>Host answers from the server's CanPost; the button never invites a refusal.</summary>
    [Parameter] public bool EnablePostToFeed { get; set; }

    /// <summary>
    /// Whether this person can currently publish a render to the server.
    /// </summary>
    /// <remarks>
    /// Separate from whether the host offers publishing at all
    /// (<see cref="OnPublishExport"/>), because the standalone host offers it and the person may
    /// simply not be signed in yet — a state worth explaining rather than hiding (2026-09-05
    /// audit, F12).
    /// </remarks>
    [Parameter] public bool EnablePublish { get; set; } = true;

    /// <summary>What to say when publishing is offered but not currently possible.</summary>
    [Parameter] public string? PublishUnavailableReasonText { get; set; }

    /// <summary>
    /// Host chrome for the toolbar — the standalone editor puts its sign-in state here.
    /// </summary>
    /// <remarks>
    /// The editor does not know who is signed in and should not guess; it only leaves room. The
    /// standalone host had no sign-in door at all before this, so the only way in was to know the
    /// /login URL and type it (2026-09-05 audit, F11).
    /// </remarks>
    [Parameter] public RenderFragment? HostStatusContent { get; set; }

    private string PublishUnavailableReason =>
        PublishUnavailableReasonText ?? "Sign in to upload this to your media library.";

    // ── Child component references ────────────────────────────────────────────

    private ClipBrowser?           _browser;
    private VideoPreview?          _preview;
    private VideoTimeline?         _timeline;
    private ExportDialog?          _exportDialog;
    private bool                   _showQueuePanel;
    private bool                   _showExportSavePrompt;
    private bool                   _rippleInsertPromptVisible;
    /// <summary>A drag that landed on an occupied spot and is waiting for Insert or Overwrite.</summary>
    private VideoTimeline.DropConflict? _pendingDrop;
    private VideoClip?             _pendingRippleClip;
    private double                 _pendingRipplePosition;
    private VideoClip?             _previewedLibraryClip;
    private double?                _markedIn;
    private double?                _markedOut;
    private bool                   _showAssetBrowser;
    // The panel's position, size and window state used to live here as four strings kept in
    // lock-step with two self-heal blocks, because a floating TelerikWindow clamped against
    // .bv-editor could measure a mid-layout container and overwrite its own defaults. A docked
    // column has no position to lose, so all of that is gone; what remains is in LayoutService,
    // which also persists it (2026-09-05 audit, F3).

    private TelerikNotification?   _notifications;

    // Audit #4 — typed DOM helpers instead of eval'd source strings; every lookup is null-guarded
    // (see audit #7, where a missing element crashed the whole circuit).
