    private async Task ImportProjectJsonAsync(ElementReference fileInput)
    {
        if (!await ConfirmDiscardIfDirtyAsync("opening a project file")) return;

        var (file, problem) = await Project.LoadWithReasonAsync(fileInput);

        if (problem is not null)
        {
            // A file that is not a project used to be opened anyway: it deserialised into an empty
            // project, so the timeline was replaced with a blank one and nothing said why
            // (2026-09-05 audit, persistence-8).
            _notifications?.Show(problem, ThemeConstants.Notification.ThemeColor.Error);
            return;
        }

        if (file is null) return;

        Projects.CurrentProjectName = file.ProjectName ?? Projects.CurrentProjectName;
        _selectedClip        = null;
        _selectedAudioClip   = null;
        _selectedTransition  = null;
        _selectedTextOverlay = null;
        _selectedImageClip   = null;

        // Through the store, not straight into ClipStore: this is what remounts the media from
        // browser storage. Restoring directly left every clip marked missing even when its source
        // was sitting right there, so a same-browser round trip looked like lost media
        // (2026-09-05 audit, persistence-7).
        await Projects.LoadFromFileAsync(file, Projects.CurrentProjectName);
    }

