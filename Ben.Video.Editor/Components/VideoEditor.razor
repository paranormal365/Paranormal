    private async Task LoadFromServerHandlerAsync()
    {
        _transfer = new TransferProgressState("Downloading Project", "Downloading project from server…");
        StateHasChanged();

        ProjectFile? file = null;
        try
        {
            var progress = new Progress<TransferProgress>(tp =>
            {
                _transfer.Update(tp);
                InvokeAsync(StateHasChanged);
            });

            file = await Project.LoadFromServerAsync(progress: progress);
        }
        catch (Exception ex)
        {
            _transfer = null;
            _notifications?.Show(
                $"Load from server error: {ex.Message}",
                ThemeConstants.Notification.ThemeColor.Error);
            StateHasChanged();
            return;
        }
        finally
        {
            _transfer = null;
        }

        if (file is null)
        {
            _notifications?.Show("Failed to load project from server.",
                ThemeConstants.Notification.ThemeColor.Error);
            StateHasChanged();
            return;
        }

        Projects.CurrentProjectName = file.ProjectName ?? Projects.CurrentProjectName;
        _selectedClip        = null;
        _selectedAudioClip   = null;
        _selectedTransition  = null;
        _selectedTextOverlay = null;

        Project.RestoreAsync(file);
        _notifications?.Show("Project loaded from server.", ThemeConstants.Notification.ThemeColor.Success);
        StateHasChanged();
    }

