    // ── Effective options ─────────────────────────────────────────────────────

    /// <summary>
    /// Shows the ffmpeg diagnostics chip and panel. Left null, the host's registered option
    /// decides; a page that knows the signed-in person's role passes it explicitly.
    /// </summary>
    [Parameter] public bool? ShowDiagnostics { get; set; }

    private VideoEditorOptions EffectiveOptions
    {
        get
        {
            // Base: use the explicit Options parameter when provided, otherwise fall back to DI.
            var base_ = EditorOptions ?? EditorOptionsAccessor.Value;
            return new()
            {
                MultiTrack            = MultiTrack   ?? base_.MultiTrack,
                // Per-user, not per-app: whether someone sees the operator tools depends on who
                // they are, and the DI options are registered once for everybody.
                ShowDiagnostics       = ShowDiagnostics ?? base_.ShowDiagnostics,
                AudioTracks           = AudioTracks  ?? base_.AudioTracks,
                Transitions           = Transitions  ?? base_.Transitions,
                TextOverlays          = TextOverlays ?? base_.TextOverlays,
                ImageClips            = base_.ImageClips,
                MaxVideoTracks        = base_.MaxVideoTracks,
                MaxAudioTracks        = base_.MaxAudioTracks,
                InlineTrimming        = base_.InlineTrimming,
                Markers               = base_.Markers,
                VideoEffects          = base_.VideoEffects,
                MediaLibrary          = base_.MediaLibrary,
                MediaLibraryBaseUrl   = base_.MediaLibraryBaseUrl,
                DocumentPostUrl       = base_.DocumentPostUrl,
                DocumentSaveUrl       = base_.DocumentSaveUrl,
                ProjectPersistence    = base_.ProjectPersistence,
                Snapping              = base_.Snapping,
                SnapThresholdSeconds  = base_.SnapThresholdSeconds,
                DefaultTimelineZoom   = base_.DefaultTimelineZoom,
                TimelineDisplayMode   = base_.TimelineDisplayMode,
                AlphaCompositing      = base_.AlphaCompositing,
                ErrorLog              = base_.ErrorLog,
                RippleEdit            = base_.RippleEdit,
                AssetCatalogUrl       = base_.AssetCatalogUrl,
                AssetCatalogHttpClientName = base_.AssetCatalogHttpClientName,
                BackgroundRendering   = base_.BackgroundRendering,
                PauseBackgroundRenderDuringExport = base_.PauseBackgroundRenderDuringExport,
                EnableRoughPass       = base_.EnableRoughPass,
                BackgroundRenderMemoryCapMb = base_.BackgroundRenderMemoryCapMb,
                NativeSidecar         = base_.NativeSidecar,
            };
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        Ffmpeg.OnStateChanged   += OnFfmpegStateChanged;
        Ffmpeg.OnWorkerCrashed  += OnFfmpegWorkerCrashed;
        PreviewQuality.OnChanged += OnPreviewQualityChanged;
        Clips.OnChange          += OnClipsChanged;
        // A layer that moves takes its animation with it, and a layer that is removed does not
        // leave one behind (2026-09-05 audit, motion-3 and motion-18). The store has no idea the
        // keyframe service exists; this is the join.
        Clips.ItemTimeShifted   += OnItemTimeShifted;
        Clips.ItemRemoved       += OnItemRemovedFromStore;
        Playback.OnStateChanged += OnPlaybackStateChanged;
        Layout.OnChanged        += OnLayoutChanged;
        Projects.OnChanged      += OnProjectStoreChanged;
        // The offer is raised from the background restore, so nothing would repaint to show it.
        Projects.OnRefetchOffered += OnProjectStoreChanged;
        ExportQueue.OnChanged   += OnQueueChanged;

        // Item #36 phase C — opt-in background render worker. Pause/resume piggybacks on the
        // MAIN ffmpeg instance's own state rather than a dedicated "export in progress" signal:
        // Processing also covers the synchronous Preview encode (same instance), which is a
        // reasonable interpretation too — background rendering shouldn't compete with *any*
        // foreground work the user is actively waiting on, not just Export specifically.
        if (EffectiveOptions.BackgroundRendering)
        {
            BackgroundRender.EnableRoughPass = EffectiveOptions.EnableRoughPass;
            BackgroundRender.SegmentCapBytes = EffectiveOptions.BackgroundRenderMemoryCapMb * 1024L * 1024L;
            Ffmpeg.OnStateChanged += OnFfmpegStateChangedForBackgroundRender;
            RenderStatus.OnChanged += OnRenderStatusChangedForSharpen; // phase D: rough→fine auto-refresh
            BackgroundRender.OnLoopError += OnBackgroundRenderLoopError; // item #9 — see that event's own doc comment
            BackgroundRender.Start();
        }
    }

    private void OnFfmpegStateChangedForBackgroundRender()
    {
        if (!EffectiveOptions.PauseBackgroundRenderDuringExport) return;
        if (Ffmpeg.State == FfmpegState.Processing) BackgroundRender.Pause();
        else BackgroundRender.Resume();
    }

    /// <summary>Item #9 — surfaces a background-render loop iteration fault that would otherwise
    /// be completely invisible (BackgroundRenderService is deliberately dependency-free and has
    /// no logging of its own). The loop itself already recovered on its own by the time this
    /// fires; this is purely visibility, not a user-facing failure to react to.</summary>
    private void OnBackgroundRenderLoopError(Exception ex) => ErrorLog.Log("BackgroundRenderService.LoopAsync", ex);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Keyboard.RegisterAsync(this);

            // Before the project loads, so the editor paints once at the size it will keep rather
            // than snapping from the defaults after the first frame.
            await RestoreLayoutAsync();

            await WarnIfMediaCannotBeStoredAsync();

            await Projects.InitAsync();  // load project index from localStorage

            // Item #69 fix — restore whichever project was last active, if this host opts into
            // ProjectPersistence. Previously nothing ever called this: File > Save could report
            // "Project saved." and a reload would still silently discard everything.
            if (EffectiveOptions.ProjectPersistence)
            {
                await Projects.RestoreLastActiveAsync();

                // Only once the restore has finished, so opening a project cannot immediately
                // schedule a write of what was just read.
                Projects.EnableAutosave();

                // pagehide is the one event that fires on every way out — a closed tab, a followed
                // link, and on a phone a switch to another app, where beforeunload often does not
                // fire at all (2026-09-05 audit, F9).
                _unloadSelfRef = DotNetObjectReference.Create(this);
                await (await DomAsync()).InvokeVoidAsync(
                    "flushOnPageHide", _unloadSelfRef, nameof(OnPageHiding));

                // Housekeeping, once the project list and the open project are both known. Nothing
                // ever freed a source, so every import a person had ever made was still taking up
                // room in the browser's storage (2026-09-05 audit, media-2). Deliberately not
                // awaited: it reads every saved project, and the editor should not wait on it.
                _ = SweepUnusedMediaAsync();
            }

            _fullscreenModule = await JS.InvokeAsync<IJSObjectReference>("benImportEditorModule", FullscreenModulePath);
            _fullscreenSelfRef = DotNetObjectReference.Create(this);
            await _fullscreenModule.InvokeVoidAsync("addChangeListener", _fullscreenSelfRef);

            StateHasChanged();
        }

        if (_pendingWorkingWindowRehydrate)
        {
            _pendingWorkingWindowRehydrate = false;
            if (_preview is not null && _timelinePreviewUrl is not null)
                await _preview.LoadUrlAsync(_timelinePreviewUrl, _timelinePreviewDuration, PlaybackMode.Timeline);
        }

        if (_pendingFullQualityLoad)
        {
            _pendingFullQualityLoad = false;
            if (_fullQualityPreview is not null && _fullQualityPreviewUrl is not null)
                await _fullQualityPreview.LoadUrlAsync(_fullQualityPreviewUrl, _fullQualityPreviewDuration, PlaybackMode.Clip);
        }
    }

    // ── Fullscreen toggle ────────────────────────────────────────────────────────

    private const string FullscreenModulePath = "js/fullscreenInterop.js";
    private IJSObjectReference?              _fullscreenModule;
    private DotNetObjectReference<VideoEditor>? _fullscreenSelfRef;
    private ElementReference                 _editorRoot;
    private bool                              _isFullscreen;

    // ── Preview popout ───────────────────────────────────────────────────────────

    private const string ViewportModulePath = "js/viewportInterop.js";
    private IJSObjectReference? _viewportModule;

    private bool   _isPoppedOut;

    /// <summary>Set whenever <see cref="_isPoppedOut"/> flips, in either direction. Toggling it
    /// tears down and remounts a fresh <see cref="VideoPreview"/> instance (mutually-exclusive
    /// @if blocks — only one is ever alive), which previously just silently blanked the Working
    /// Window: the new instance has no loaded blob URL and nothing ever re-issued one. Consumed in
    /// <see cref="OnAfterRenderAsync"/>, the first point the new instance's <c>_preview</c>
    /// reference is actually valid.</summary>
    private bool   _pendingWorkingWindowRehydrate;
    private string _popoutWidth     = "480px";
    private string _popoutHeight    = "270px";
    private string _popoutMaxWidth  = "960px";
    private string _popoutMaxHeight = "540px";

    private sealed record ViewportSize(int Width, int Height);

    private async Task OpenPopoutAsync()
    {
        _viewportModule ??= await JS.InvokeAsync<IJSObjectReference>("benImportEditorModule", ViewportModulePath);
        var viewport = await _viewportModule.InvokeAsync<ViewportSize>("getViewportSize");

        var aspect = ExportRes.Height > 0 ? (double)ExportRes.Width / ExportRes.Height : 16.0 / 9.0;

        _popoutMaxWidth  = $"{(int)(viewport.Width  * 0.9)}px";
        _popoutMaxHeight = $"{(int)(viewport.Height * 0.9)}px";

        var initialWidth  = Math.Min(ExportRes.Width, (int)(viewport.Width * 0.5));
        _popoutWidth  = $"{initialWidth}px";
        _popoutHeight = $"{(int)(initialWidth / aspect)}px";

        // Detach the current (about-to-be-disposed) instance from its URL before the swap, so its
        // DisposeAsync doesn't revoke the blob the new instance is about to reload — see
        // VideoPreview.DetachWithoutRevoking. Must happen before _isPoppedOut flips, while
        // _preview still references the outgoing instance.
        _preview?.DetachWithoutRevoking();
        _isPoppedOut = true;
        _pendingWorkingWindowRehydrate = true;
    }

    private double PopoutAspectRatio =>
        ExportRes.Height > 0 ? (double)ExportRes.Width / ExportRes.Height : 16.0 / 9.0;

    /// <summary>TelerikWindow has no aspect-ratio-lock parameter, so dragging any edge/corner
    /// handle is corrected here by recomputing the other dimension from the export's aspect
    /// ratio. Only reacts to pixel values (TelerikWindow always reports resize as "Npx").</summary>
    private void OnPopoutWidthChanged(string value)
    {
        _popoutWidth = value;
        if (value.EndsWith("px") && double.TryParse(value.AsSpan(0, value.Length - 2), out var w))
            _popoutHeight = $"{(int)(w / PopoutAspectRatio)}px";
    }

    private void OnPopoutHeightChanged(string value)
    {
        _popoutHeight = value;
        if (value.EndsWith("px") && double.TryParse(value.AsSpan(0, value.Length - 2), out var h))
            _popoutWidth = $"{(int)(h * PopoutAspectRatio)}px";
    }

    // ── Full-quality Preview output (item #36 phase 84) ─────────────────────────
    // The toolbar's "Preview" button. Genuinely separate from the Working Window above: renders
    // at full export resolution/quality (reusing ExportService's own pipeline — every phase,
    // transitions/overlays/audio mix/watermark included — so this can never drift from what
    // Export actually produces) and plays the result as an in-memory blob in its own popout
    // window, never touching disk. The Working Window keeps auto-refreshing at preview
    // quality/resolution independently — this button doesn't affect it at all.

    private bool    _showFullQualityPreview;
    private bool    _fullQualityRendering;
    private int     _fullQualityPercent;
    private VideoPreview? _fullQualityPreview;
    private string? _fullQualityPreviewUrl;
    private double  _fullQualityPreviewDuration;
    private bool    _pendingFullQualityLoad;
    private string  _fullQualityWidth     = "480px";
    private string  _fullQualityHeight    = "270px";
    private string  _fullQualityMaxWidth  = "960px";
    private string  _fullQualityMaxHeight = "540px";

    private async Task RenderFullQualityPreviewAsync()
    {
        if (Ffmpeg.State != FfmpegState.Ready) return;
        if (Exporter.CurrentJob?.State == ExportJobState.Running) return; // don't compete with a real Export

        await OpenFullQualityWindowAsync();
        // Phase 144 — the @if(_fullQualityRendering){...}else{<VideoPreview .../>} block below is
        // mutually exclusive, so the StateHasChanged() on the next line disposes whatever
        // _fullQualityPreview instance was showing the PREVIOUS full-quality preview (if the
        // window was already open) right now — and VideoPreview.DisposeAsync already revokes its
        // own _previewUrl as part of that. Null this immediately so it doesn't linger as a
        // reference to an already-revoked string until the manual revoke check further down
        // (which exists for the OPFS/direct-MEMFS cleanup path, not this one) double-revokes it.
        _fullQualityPreviewUrl = null;
        _fullQualityRendering = true;
        _fullQualityPercent   = 0;
        _fullQualityLastTick  = DateTimeOffset.UtcNow;
        StartStallWatch();
        StateHasChanged();

        // Same resolution the user has actually configured for Export (ExportResolutionService is
        // kept in sync by ExportDialog); quality settings (CRF/preset/codec) use ExportSettings'
        // own defaults, matching how the existing preview-quality pipeline already scopes itself
        // (see RefreshWorkingWindowAsync's previewSettings) rather than requiring the export
        // dialog to have been opened first just to render a check.
        var settings = new ExportSettings
        {
            Resolution = $"{ExportRes.Width}x{ExportRes.Height}",
        };

        // Same pattern ExportDialog.StartExportAsync uses: ExportAsync sets CurrentJob
        // synchronously before its first internal await, so capturing it right after the
        // (not-yet-awaited) call — rather than from the eventually-returned job — is what makes
        // subscribing to OnProgress actually see ticks during the render instead of only after.
        var exportTask = Exporter.ExportAsync(settings, downloadToDisk: false);
        var job = Exporter.CurrentJob!;

        // Held so the window's Cancel — and closing the window at all — can reach it. Without
        // this the render had no handle anywhere: a preview that stalled could not be stopped,
        // could not be closed out of, and left the engine occupied for everything else
        // (2026-09-05 audit, F7).
        _fullQualityJob      = job;
        _fullQualityLastTick = DateTimeOffset.UtcNow;
        job.OnProgress += OnFullQualityProgress;

        try
        {
            await exportTask;
        }
        finally
        {
            job.OnProgress -= OnFullQualityProgress;
            _fullQualityRendering = false;
            _fullQualityJob       = null;
            StopStallWatch();
        }

        if (job.State == ExportJobState.Cancelled)
        {
            StateHasChanged();
            return;
        }

        if (job.State != ExportJobState.Completed || job.PreviewBlobUrl is null)
        {
            ErrorLog.Log("RenderFullQualityPreviewAsync", new InvalidOperationException(job.ErrorMessage ?? "Full-quality preview render failed."));
            StateHasChanged();
            return;
        }

        // No revoke-the-old-one check needed here — _fullQualityPreviewUrl was already nulled
        // above, at the exact point its previous owner (the disposed VideoPreview instance)
        // already revoked it.
        _fullQualityPreviewUrl      = job.PreviewBlobUrl;
        BlobLifecycle.Created(_fullQualityPreviewUrl, "VideoEditor.fullQualityPreview");
        _fullQualityPreviewDuration = job.Duration;

        // _fullQualityRendering just flipped false, which swaps the window's content from the
        // "Rendering…" status div to the actual <VideoPreview> — that swap (and therefore
        // _fullQualityPreview's @ref becoming non-null) hasn't happened yet at this point in the
        // same synchronous continuation, so the load itself is deferred to OnAfterRenderAsync,
        // same pattern as the Working Window's popout-rehydrate.
        _pendingFullQualityLoad = true;
        StateHasChanged();
    }

    private void OnFullQualityProgress() => InvokeAsync(() =>
    {
        _ = UpdateUnloadGuardAsync();
        _fullQualityPercent  = Exporter.CurrentJob?.OverallPercent ?? _fullQualityPercent;
        _fullQualityLastTick = DateTimeOffset.UtcNow;
        _fullQualityStalled  = false;
        StateHasChanged();
    });

    /// <summary>The render behind the preview window, while one is running.</summary>
    private ExportJob?       _fullQualityJob;
    private DateTimeOffset   _fullQualityLastTick;
    private bool             _fullQualityStalled;
    private Timer?           _stallWatch;

    /// <summary>How long without a progress tick before the window says so and offers a reset.</summary>
    private const int PreviewStallSeconds = 10;

    /// <summary>
    /// Watches for a render that has stopped reporting progress.
    /// </summary>
    /// <remarks>
    /// The window showed "Rendering… N%" and nothing else, so a stalled render and a slow one
    /// looked identical for as long as anyone was willing to wait. Ten seconds of silence is not
    /// proof of a wedge, but it is enough to stop pretending progress is being made and to put the
    /// two ways out — stop, or restart the engine — in front of the person (2026-09-05 audit, F7).
    /// </remarks>
    private void StartStallWatch()
    {
        StopStallWatch();
        _stallWatch = new Timer(_ => InvokeAsync(() =>
        {
            if (!_fullQualityRendering) return;

            var stalled = (DateTimeOffset.UtcNow - _fullQualityLastTick).TotalSeconds >= PreviewStallSeconds;
            if (stalled == _fullQualityStalled) return;

            _fullQualityStalled = stalled;
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private void StopStallWatch()
    {
        _stallWatch?.Dispose();
        _stallWatch = null;
        _fullQualityStalled = false;
    }

    /// <summary>Stops the render behind the preview window.</summary>
    private void CancelFullQualityPreview()
    {
        _fullQualityJob?.Cancel();
        _notifications?.Show("Preview stopped.", ThemeConstants.Notification.ThemeColor.Info);
    }

    /// <summary>Stops the render and restarts the engine underneath it.</summary>
    private async Task ResetFromStalledPreviewAsync()
    {
        _fullQualityJob?.Cancel();
        _showFullQualityPreview = false;
        StopStallWatch();
        await ResetEngineAsync();
    }

    private async Task OpenFullQualityWindowAsync()
    {
        _viewportModule ??= await JS.InvokeAsync<IJSObjectReference>("benImportEditorModule", ViewportModulePath);
        var viewport = await _viewportModule.InvokeAsync<ViewportSize>("getViewportSize");
        var aspect = ExportRes.Height > 0 ? (double)ExportRes.Width / ExportRes.Height : 16.0 / 9.0;

        _fullQualityMaxWidth  = $"{(int)(viewport.Width  * 0.9)}px";
        _fullQualityMaxHeight = $"{(int)(viewport.Height * 0.9)}px";
        var initialWidth = Math.Min(ExportRes.Width, (int)(viewport.Width * 0.5));
        _fullQualityWidth  = $"{initialWidth}px";
        _fullQualityHeight = $"{(int)(initialWidth / aspect)}px";

        _showFullQualityPreview = true;
    }

    private void OnCloseFullQualityPreview()
    {
        // Closing used to leave the render going, holding the engine for a result nothing would
        // ever show (2026-09-05 audit, F7).
        _fullQualityJob?.Cancel();
        StopStallWatch();

        _showFullQualityPreview = false;
        // Item #59-#65 flakiness investigation, phase 144 — closing this window unmounts the
        // whole @if (_showFullQualityPreview) block, so Blazor disposes _fullQualityPreview right
        // now, which already revokes ITS OWN _previewUrl (the same string as _fullQualityPreviewUrl
        // here) via VideoPreview.DisposeAsync. This field must follow — otherwise it's left holding
        // a reference to an already-revoked URL, and the next completed render's own revoke-the-
        // previous-one step (above) redundantly re-revokes the same dead string.
        _fullQualityPreviewUrl = null;
    }

    private double FullQualityAspectRatio =>
        ExportRes.Height > 0 ? (double)ExportRes.Width / ExportRes.Height : 16.0 / 9.0;

    private void OnFullQualityWidthChanged(string value)
    {
        _fullQualityWidth = value;
        if (value.EndsWith("px") && double.TryParse(value.AsSpan(0, value.Length - 2), out var w))
            _fullQualityHeight = $"{(int)(w / FullQualityAspectRatio)}px";
    }

    private void OnFullQualityHeightChanged(string value)
    {
        _fullQualityHeight = value;
        if (value.EndsWith("px") && double.TryParse(value.AsSpan(0, value.Length - 2), out var h))
            _fullQualityWidth = $"{(int)(h * FullQualityAspectRatio)}px";
    }

    private async Task ToggleFullscreenAsync()
    {
        if (_fullscreenModule is not null)
            await _fullscreenModule.InvokeVoidAsync("toggle", _editorRoot);
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool isFullscreen)
    {
        _isFullscreen = isFullscreen;
        StateHasChanged();
    }

    // ── Keyboard shortcut dispatch ──────────────────────────────────────────────

    public async Task OnEditorKeyDown(string key, bool ctrl, bool shift, bool alt)
    {
        switch (key)
        {
            case " " or "Spacebar":
                if (_preview is not null)
                    await _preview.TogglePlayPauseAsync();
                break;

            case "Delete" or "Backspace":
                // The store refuses to remove anything from a locked track, and silently — so
                // pressing Delete cleared the selection and left the clip sitting there, which
                // reads as the key being broken (2026-09-05 audit, timeline-12).
                if (SelectedTimelineItem is { } toDelete && Clips.FindTrackOf(toDelete.Id) is { IsLocked: true })
                {
                    _notifications?.Show(
                        "That track is locked. Unlock it from the track menu to change it.",
                        ThemeConstants.Notification.ThemeColor.Info);
                    break;
                }

                // Bulk delete if timeline has a multi-selection
                var multiIds = _timeline?.GetMultiSelectedIds();
                if (multiIds is { Count: >= 2 })
                {
                    await OnBulkDeleteAsync(multiIds);
                    _timeline?.ClearMultiSelection();
                }
                else if (_selectedClip is not null)
                {
                    Clips.RemoveClip(_selectedClip.Id);
                    _selectedClip = null;
                }
                else if (_selectedAudioClip is not null)
                {
                    Clips.RemoveClip(_selectedAudioClip.Id);
                    _selectedAudioClip = null;
                }
                else if (_selectedImageClip is not null)
                {
                    Clips.RemoveClip(_selectedImageClip.Id);
                    _selectedImageClip = null;
                }
                else if (_selectedCallout is not null)
                {
                    Clips.RemoveCallout(_selectedCallout.Id);
                    _selectedCallout = null;
                }
                else if (_selectedClipArt is not null)
                {
                    Clips.RemoveClipArtClip(_selectedClipArt.Id);
                    _selectedClipArt = null;
                }
                // Titles and transitions were the two selectable things Delete ignored, though the
                // shortcut table promises it removes "the selected clip" and both have a Properties
                // panel with a Remove button (2026-09-05 audit, titles-7 and transitions-10).
                else if (_selectedTextOverlay is not null)
                {
                    Clips.RemoveTextOverlay(_selectedTextOverlay.Id);
                    _selectedTextOverlay = null;
                }
                else if (_selectedTransition is not null)
                {
                    Clips.RemoveTransition(_selectedTransition.Id);
                    _selectedTransition = null;
                }
                break;

            // Item #57 P5 — arrow-key nudge for the selected canvas layer (Callout/ClipArt/
            // TextOverlay only; clip/audio/image selections have no canvas X/Y to nudge). Only
            // fires when one of those three is actually selected — an unmatched arrow key here
            // falls through with no effect, same as today.
            case "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown":
                // With a canvas layer selected the arrows nudge it (item #57 P5). With nothing on
                // the canvas selected they step one frame, which the transport buttons' tooltips
                // ("Step back one frame (←)") and the shortcut help have always promised and
                // nothing implemented (2026-09-05 audit, preview-6).
                if (SelectedCanvasItem is not null)
                {
                    NudgeSelectedCanvasItem(key, shift);
                }
                else if (_preview is not null)
                {
                    if (key == "ArrowLeft")  _preview.StepBackAsync();
                    if (key == "ArrowRight") _preview.StepForwardAsync();
                }
                break;

            case "Home" when !ctrl:
                if (_preview is not null) await _preview.RewindAsync();
                break;

            case "End" when !ctrl:
                if (_preview is not null) await _preview.SeekToEndAsync();
                break;

            case "[" when !ctrl:
                {
                    var nudgeIds = _timeline?.GetMultiSelectedIds();
                    if (nudgeIds is { Count: >= 2 })
                        await OnBulkMoveAsync((nudgeIds, -1.0));
                }
                break;

            case "]" when !ctrl:
                {
                    var nudgeIds = _timeline?.GetMultiSelectedIds();
                    if (nudgeIds is { Count: >= 2 })
                        await OnBulkMoveAsync((nudgeIds, 1.0));
                }
                break;

            case "s" or "S" when !ctrl:
                {
                    // The playhead is a timeline position, and SplitClip takes a position measured
                    // from the clip's own start. Handing it the playhead cut early by exactly the
                    // clip's start — right only for a clip beginning at zero, which is why it
                    // looked correct (2026-09-05 audit, timeline-1).
                    var selected = (TrackItem?)_selectedClip ?? (TrackItem?)_selectedAudioClip ?? _selectedImageClip;
                    if (selected is not null)
                    {
                        if (Clips.SplitClipAtTimelineTime(selected.Id, Playback.State.TimelineTime))
                        {
                            _selectedClip      = null;
                            _selectedAudioClip = null;
                            _selectedImageClip = null;
                        }
                        else
                        {
                            _notifications?.Show(
                                "Put the playhead inside the clip to split it.",
                                ThemeConstants.Notification.ThemeColor.Info);
                        }
                    }
                }
                break;

            case "Escape":
                // Every selection kind, not the four that happened to be listed: an image, callout
                // or clip-art selection survived Escape and kept its Properties panel open
                // (2026-09-05 audit, F10).
                _selectedClip        = null;
                _selectedAudioClip   = null;
                _selectedImageClip   = null;
                _selectedCallout     = null;
                _selectedClipArt     = null;
                _selectedTransition  = null;
                _selectedTextOverlay = null;
                _showHelp            = false;
                _timeline?.ClearMultiSelection();
                break;

            case "z" or "Z" when ctrl && !shift:
                Clips.Undo();
                break;

            case "z" or "Z" when ctrl && shift:
            case "y" or "Y" when ctrl:
                Clips.Redo();
                break;

            case "m" or "M" when !ctrl && !shift && !alt:
                if (EffectiveOptions.Markers)
                {
                    // Progress × TotalDuration was a fraction of whatever the preview held, scaled
                    // by the timeline's length — two different clocks multiplied together. With a
                    // clip loaded it put the marker somewhere unrelated to the playhead.
                    Clips.AddMarker(Playback.State.TimelineTime);
                }
                break;

            case "?":
                _showHelp = !_showHelp;
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    // ── Toolbar handlers ──────────────────────────────────────────────────────

    /// <summary>
    /// Backs both the toolbar's Initialize button (enabled when Idle/Error) and the diagnostics
    /// panel's Reset button (enabled when the watchdog flags a wedge, which can happen from ANY
    /// state including Processing — a hung command's promise never resolves on its own).
    ///
    /// Phase 143 fix — the "fake recovery" bug: this used to call <c>Ffmpeg.LoadAsync()</c>
    /// directly. On a State:Error retry, <c>ffmpegInterop.js</c>'s own JS-side ffmpeg instance was
    /// STILL the wedged one (nothing had ever nulled it) — its idempotence guard
    /// (<c>if (_ffmpeg &amp;&amp; _ffmpeg.loaded) return;</c>) saw <c>loaded === true</c> on that
    /// same broken instance and silently no-op'd, so <c>State</c> flipped back to Ready without
    /// the worker actually changing at all. <c>TerminateAsync()</c> first — unconditionally, since
    /// both callers are only reachable from Idle/Error/wedged-Processing, never a healthy Ready —
    /// nulls the JS-side instance so the guard can no longer fake-pass, and is a harmless no-op on
    /// a session's very first Initialize (nothing loaded yet to terminate).
    ///
    /// Ordering below also fixes a second bug: <c>SegmentCache.Clear()</c> used to run BEFORE
    /// <c>RemountAllAsync()</c>, and a remount attempted against the still-wedged (not yet
    /// terminated) worker hit stale WORKERFS directories (EEXIST) that silently dropped clips
    /// from remount tracking (see <see cref="SourceMounter.RemountAllAsync"/>'s own fix) — clips
    /// could lose their live segments AND their remountability in the same broken cycle. Now:
    /// terminate → fresh load → remount (against a guaranteed-empty, real VFS) → only THEN clear
    /// the segment cache, so a genuinely fresh render can rebuild it from mounts that are known-good.
    /// </summary>
    private async Task LoadCoreAsync()
    {
        try
        {
            await Ffmpeg.TerminateAsync();
            await Ffmpeg.LoadAsync();

            var remounted = await Mounter.RemountAllAsync();
            foreach (var (clipId, path) in remounted)
            {
                var vc = Clips.AllVideoClips.FirstOrDefault(c => c.Id == clipId);
                if (vc is not null) { vc.MemFsName = path; continue; }
                var ac = Clips.AllAudioClips.FirstOrDefault(c => c.Id == clipId);
                if (ac is not null) { ac.MemFsName = path; continue; }
                var ic = Clips.AllImageClips.FirstOrDefault(c => c.Id == clipId);
                if (ic is not null) ic.MemFsName = path;
            }

            SegmentCache.Clear();
        }
        catch { /* error stored in Ffmpeg.LastError */ }
    }

    /// <summary>
    /// Says up front when this browser cannot keep the media between visits.
    /// </summary>
    /// <remarks>
    /// The editor writes every imported file to the browser's own storage so a project can be
    /// reopened. Where that storage cannot be written — Safari before version 26 has the storage
    /// but not the call used to write to it — every write failed and was swallowed as non-fatal,
    /// so the editor worked perfectly until the page was reloaded and then every clip came back
    /// missing. Losing an afternoon's work is not something to find out about afterwards
    /// (2026-09-05 audit, the completeness critic's browser-support item).
    /// </remarks>
    private async Task WarnIfMediaCannotBeStoredAsync()
    {
        await Opfs.EnsureInitAsync();
        if (Opfs.IsAvailable) return;

        _notifications?.Show(
            "This browser will not let the editor keep your media between visits, so a project "
            + "reopened here will have missing clips. Editing and export work as normal — save "
            + "the finished video before you leave. Chrome or Edge do not have this limit.",
            ThemeConstants.Notification.ThemeColor.Warning);
    }

    /// <summary>
    /// Restarts the video engine after it has wedged or crashed, and puts the preview back.
    /// </summary>
    private async Task ResetEngineAsync()
    {
        await Ffmpeg.ResetWorkerAsync();
        await LoadCoreAsync();

        _notifications?.Show("Video engine restarted.", ThemeConstants.Notification.ThemeColor.Success);
        ScheduleAutoPreview();
        StateHasChanged();
    }

    /// <summary>When the editor last restarted the engine by itself.</summary>
    private DateTimeOffset? _lastAutoEngineRestart;

    /// <summary>
    /// The engine trapped. Restart it without being asked, and say what happened.
    /// </summary>
    /// <remarks>
    /// <para>A crash used to leave the editor quietly broken: the preview stopped refreshing,
    /// every export refused to start, and the only clue was a status chip most people never look
    /// at (2026-09-05 audit, F7).</para>
    ///
    /// <para>The restart is rate limited, because whatever crashed the engine is usually still on
    /// the timeline — restarting and immediately re-rendering would crash it again, and a tight
    /// loop is worse than staying broken. Running out of memory is never restarted for: a fresh
    /// engine has exactly as much memory as the one that just filled up, so the honest answer is
    /// to say the work is too big for a browser tab and point at the helper that has no such
    /// limit.</para>
    /// </remarks>
    private void OnFfmpegWorkerCrashed(WorkerFailureKind kind)
    {
        _ = InvokeAsync(async () =>
        {
            var now = DateTimeOffset.UtcNow;

            _notifications?.Show(
                WorkerFailureClassifier.Explain(kind, EffectiveOptions.NativeSidecar),
                kind == WorkerFailureKind.OutOfMemory
                    ? ThemeConstants.Notification.ThemeColor.Warning
                    : ThemeConstants.Notification.ThemeColor.Error);

            if (!FfmpegCrashRecoveryPolicy.ShouldRestart(kind, _lastAutoEngineRestart, now))
            {
                if (kind == WorkerFailureKind.Crashed)
                    _notifications?.Show(
                        FfmpegCrashRecoveryPolicy.DeclinedMessage(_lastAutoEngineRestart, now),
                        ThemeConstants.Notification.ThemeColor.Warning);

                StateHasChanged();
                return;
            }

            _lastAutoEngineRestart = now;
            await LoadCoreAsync();
            ScheduleAutoPreview();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Audit #7 — the toolbar's Open (file picker) crashed the whole circuit when the Media &amp;
    /// Properties panel was closed: <c>ClipBrowser</c> (and with it the hidden
    /// <c>#bv-file-input</c>) unmounts with that panel, so the picker's
    /// <c>getElementById(...).click()</c> null-dereferenced. Guarding the JS alone would only
    /// downgrade the crash to "button silently does nothing", so the panel is restored first —
    /// which is what the user wanted anyway by asking to add media. Item #65 made minimized the
    /// default, so this is now the *common* path, not an edge case.
    /// </summary>
    private async Task OpenFilesAsync()
    {
        Layout.SetPanelCollapsed(false);
        Layout.SetPanelTab("media");
        StateHasChanged();

        // Let the panel (and therefore ClipBrowser's file input) actually render before the picker
        // reaches for it — without this yield the element still wouldn't exist on the first click.
        await Task.Yield();

        if (_browser is not null)
            await _browser.PickFilesAsync();
    }

    private void OpenExportDialog() => _exportDialog?.Open();

    // ── ClipBrowser handlers ──────────────────────────────────────────────────

    private async Task OnClipSelectedAsync(VideoClip clip)
    {
        if (Ffmpeg.State != FfmpegState.Ready || clip.MemFsName is null) return;
        var url = await Ffmpeg.CreatePreviewUrlAsync(clip.MemFsName);
        BlobLifecycle.Created(url, "VideoEditor.clipPreview");
        if (_preview is not null)
        {
            // Item #59-#65 flakiness investigation, phase 144 (finding B.3) — VideoPreview.LoadUrlAsync
            // revokes whatever URL it was PREVIOUSLY showing before assigning this new one. When
            // _preview was last showing the timeline assembly (_timelinePreviewUrl holds that exact
            // same string), that revoke silently invalidates _timelinePreviewUrl too, with nothing here
            // to tell VideoEditor. Without this, a later popout/reattach (_pendingWorkingWindowRehydrate
            // in OnAfterRenderAsync) would reload that now-dead string — blank preview + a blob 404 —
            // instead of correctly finding nothing to rehydrate.
            if (_timelinePreviewUrl == _preview.CurrentUrl) _timelinePreviewUrl = null;
            await _preview.LoadUrlAsync(url, clip.TrimmedDuration, PlaybackMode.Clip);
        }

        // Item #51 — three-point editing: switching which clip is previewed clears any pending
        // in/out marks from a previous clip, so they never leak onto an unrelated one.
        _previewedLibraryClip = clip;
        _markedIn  = null;
        _markedOut = null;
    }

    /// <summary>Item #51: records the current preview playhead as the in-point for the next
    /// "Add to Timeline" on <see cref="_previewedLibraryClip"/>.</summary>
    private void MarkIn()
    {
        if (_previewedLibraryClip is null) return;
        _markedIn = Playback.State.CurrentTime;
    }

    /// <summary>Item #51: records the current preview playhead as the out-point for the next
    /// "Add to Timeline" on <see cref="_previewedLibraryClip"/>.</summary>
    private void MarkOut()
    {
        if (_previewedLibraryClip is null) return;
        _markedOut = Playback.State.CurrentTime;
    }

    private void ClearMarks()
    {
        _markedIn  = null;
        _markedOut = null;
    }

    /// <summary>
    /// Places a newly-added clip on the primary video track. Anchors to the playhead — snapping
    /// to touch an adjacent clip's edge if the playhead sits right at one, matching how a user
    /// dragging by hand would expect an insert-at-playhead to land — rather than always dumping
    /// it at the end of the track (item #25). If the resolved position would overlap an existing
    /// clip, asks whether to ripple-shift the clips after it to make room instead of placing it.
    /// </summary>
    private void AddClipToTimeline(VideoClip clip)
    {
        // Placing from the media bin always makes a copy: the bin entry stays as the source, and
        // the same source can be placed as often as you like without one placement's trims and
        // effects following the others (2026-09-05 audit, plan D3).
        var fromBin = Clips.MediaBin.Any(i => i.Id == clip.Id);
        var wasAlreadyPlaced = fromBin || Clips.AllVideoClips.Any(c => c.Id == clip.Id);

        // Item #51 — three-point editing: if this is the clip currently marked in the preview,
        // capture that before the item #48 clone below replaces clip's identity.
        var applyMarks = wasAlreadyPlaced && clip.Id == _previewedLibraryClip?.Id
            && (_markedIn.HasValue || _markedOut.HasValue);

        // Item #48: "Add to Timeline" on a library-view card (ClipBrowser's Video tab lists
        // clips already on the timeline — there's no separate unplaced-library concept in this
        // app; a fresh import calls straight into this same method with a brand-new clip) must
        // clone rather than reuse the clip's Id, or the same Id ends up on two timeline entries —
        // selection, removal, undo, and snap-exclusion all key off Id. List-typed properties are
        // copied too so editing one placement's effects/automation doesn't mutate the other's.
        if (wasAlreadyPlaced)
        {
            clip = clip with
            {
                Id               = Guid.NewGuid(),
                SourceBinId      = fromBin ? clip.Id : clip.SourceBinId,
                ThumbnailUrls    = [.. clip.ThumbnailUrls],
                VolumeAutomation = [.. clip.VolumeAutomation],
                AppliedEffects   = [.. clip.AppliedEffects],
            };
        }

        if (applyMarks)
        {
            var inPoint  = Math.Clamp(_markedIn  ?? clip.StartTrim, 0, clip.Duration);
            var outPoint = Math.Clamp(_markedOut ?? (clip.EndTrim > clip.StartTrim ? clip.EndTrim : clip.Duration), 0, clip.Duration);
            if (inPoint < outPoint)
                clip = clip with { StartTrim = inPoint, EndTrim = outPoint };
            _markedIn  = null;
            _markedOut = null;
        }

        var track    = Clips.PrimaryVideoTrack;
        var existing = track.VideoClips.Select(c => (c.TimelinePosition, c.TrimmedDuration)).ToList();
        // The playhead is a timeline position; Progress × TotalDuration mixed the media clock with
        // the timeline's length (2026-09-05 audit, F6).
        var playhead = Playback.State.TimelineTime;
        var position = TimelineDropCalculator.ResolvePlayheadAnchoredPosition(
            playhead, clip.TrimmedDuration, existing);

        if (TimelineDropCalculator.Overlaps(position, clip.TrimmedDuration, existing))
        {
            _pendingRippleClip         = clip;
            _pendingRipplePosition     = position;
            _rippleInsertPromptVisible = true;
            return;
        }

        clip.TimelinePosition = position;
        Clips.AddClipToTrack(track.Id, clip);
    }

    /// <summary>Places a picture from the media bin at the playhead.</summary>
    private void AddImageToTimeline(ImageClip source)
    {
        var track = Clips.PrimaryVideoTrack;
        var copy  = source with { Id = Guid.NewGuid(), SourceBinId = source.Id };

        copy.TimelinePosition = ResolvePlacementPosition(track, copy.EffectiveLength);
        Clips.AddClipToTrack(track.Id, copy);
    }

    /// <summary>Places an audio source from the media bin on an audio track.</summary>
    private void AddAudioToTimeline(AudioClip source)
    {
        var track = Clips.AudioTracks.FirstOrDefault() ?? Clips.AddAudioTrack();
        var copy  = source with
        {
            Id = Guid.NewGuid(),
            SourceBinId = source.Id,
            VolumeAutomation = [.. source.VolumeAutomation],
        };

        copy.TimelinePosition = ResolvePlacementPosition(track, copy.EffectiveLength);
        Clips.AddClipToTrack(track.Id, copy);
    }

    /// <summary>
    /// Where a newly placed item goes: at the playhead when there is room, otherwise after
    /// whatever is in the way.
    /// </summary>
    /// <remarks>
    /// Pictures and audio used to be appended to the end of the track no matter where the playhead
    /// was, which is not where anybody is looking (2026-09-05 audit, F8).
    /// </remarks>
    private double ResolvePlacementPosition(TimelineTrack track, double length)
    {
        var playhead = Playback.State.TimelineTime;

        return TrackLayout.Overlaps(track, playhead, length)
            ? TrackLayout.EndOf(track)
            : playhead;
    }

    private void ConfirmRippleInsert()
    {
        if (_pendingDrop is { } drop)
            Clips.MoveWithInsert(drop.Item.Id, drop.TrackId, drop.Position, drop.OriginalPosition);
        else if (_pendingRippleClip is not null)
            Clips.InsertClipWithRipple(Clips.PrimaryVideoTrack.Id, _pendingRippleClip, _pendingRipplePosition);

        _pendingDrop               = null;
        _pendingRippleClip         = null;
        _rippleInsertPromptVisible = false;
    }

    /// <summary>Standard NLE "Overwrite" edit (item #49): trims/splits/removes whatever the
    /// pending clip would land on top of instead of shifting subsequent clips later.</summary>
    private void ConfirmOverwriteInsert()
    {
        if (_pendingDrop is { } drop)
            Clips.MoveWithOverwrite(drop.Item.Id, drop.TrackId, drop.Position, drop.OriginalPosition);
        else if (_pendingRippleClip is not null)
            Clips.OverwriteInsert(Clips.PrimaryVideoTrack.Id, _pendingRippleClip, _pendingRipplePosition);

        _pendingDrop               = null;
        _pendingRippleClip         = null;
        _rippleInsertPromptVisible = false;
    }

    /// <summary>
    /// A clip was dragged onto an occupied spot with ripple off. Ask, rather than decide.
    /// </summary>
    /// <remarks>
    /// The alternative to asking is picking one silently: sliding the clip past what it landed on
    /// (surprising — it is not where they dropped it) or replacing what was underneath (destructive
    /// after a fumbled drag). The prompt already existed for "Add to Timeline"; this is the same
    /// question arriving from a drag (2026-09-05 audit, F5).
    /// </remarks>
    /// <summary>
    /// Saves the frame under the playhead as a picture on the person's machine.
    /// </summary>
    /// <remarks>
    /// For an evidence site the frame where something appears is the artefact people share most,
    /// and until now the editor could only produce video (2026-09-05 audit, the completeness
    /// critic's list).
    /// </remarks>
    private async Task OnSaveFrameAsync(double timelineSeconds)
    {
        var (fileName, problem) = await Exporter.SaveFrameAsync(timelineSeconds);

        _notifications?.Show(
            problem ?? $"Saved {fileName}.",
            problem is null
                ? ThemeConstants.Notification.ThemeColor.Success
                : ThemeConstants.Notification.ThemeColor.Error);
    }

    private Task OnDropConflictAsync(VideoTimeline.DropConflict conflict)
    {
        _pendingDrop = conflict;
        _rippleInsertPromptVisible = true;
        return InvokeAsync(StateHasChanged);
    }

    private void CancelRippleInsert()
    {
        // Declining leaves the clip unplaced — it stays in the library for the user to add again
        // (e.g. by dragging it to a spot they pick themselves) rather than silently placing it
        // somewhere they didn't ask for. A dragged clip has already been put back by the timeline.
        _pendingDrop               = null;
        _pendingRippleClip         = null;
        _rippleInsertPromptVisible = false;
    }

