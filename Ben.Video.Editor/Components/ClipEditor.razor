@inject ClipStore Clips
@inject PlaybackService Playback
@inject Microsoft.Extensions.Options.IOptions<VideoEditorOptions> EditorOptionsAccessor
@inject Ben.Video.Editor.Services.ClipEffectRegistry EffectRegistry
@using Ben.Video.Editor.Effects

@if (Clip is not null)
{
    <div class="bv-clip-editor">

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__header">
            <span class="bv-clip-editor__title">@Clip.Name</span>
            <TelerikButton OnClick="Close"
                           Icon="@SvgIcon.X"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="Close clip editor" />
        </div>

        <!-- ── Info row ─────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__info">
            <span>Source: @FormatTime(Clip.Duration)</span>
            <span>Trimmed: @FormatTime(Clip.TrimmedDuration)</span>
            @if (Math.Abs(Clip.Speed - 1.0) > 0.001)
            {
                <span>Effective: @FormatTime(Clip.EffectiveDuration) (@Clip.Speed.ToString("F2")x)</span>
            }
            @if (LinkedAudioOffsetSeconds is { } offset)
            {
                <span class="bv-clip-editor__link-offset">
                    Linked · audio starts @FormatTime(Math.Abs(offset)) @(offset > 0 ? "after" : offset < 0 ? "before" : "with") video
                </span>
            }
        </div>

        <!-- ── Trim In ──────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__field">
            <label class="bv-clip-editor__label">In point</label>
            <TelerikSlider @bind-Value="_trimStart"
                           Min="0"
                           Max="@_trimEnd"
                           SmallStep="0.1"
                           LargeStep="1"
                           Orientation="@SliderOrientation.Horizontal"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0, _trimEnd, 1)"
                           Class="bv-clip-editor__slider" />
            <span class="bv-clip-editor__time">@FormatTime(_trimStart)</span>
        </div>

        <!-- ── Trim Out ─────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__field">
            <label class="bv-clip-editor__label">Out point</label>
            <TelerikSlider @bind-Value="_trimEnd"
                           Min="@_trimStart"
                           Max="@Clip.Duration"
                           SmallStep="0.1"
                           LargeStep="1"
                           Orientation="@SliderOrientation.Horizontal"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(_trimStart, Clip.Duration, 1)"
                           Class="bv-clip-editor__slider" />
            <span class="bv-clip-editor__time">@FormatTime(_trimEnd)</span>
        </div>

        <!-- ── Split at playhead ─────────────────────────────────────────── -->
        <div class="bv-clip-editor__field">
            <label class="bv-clip-editor__label">Split at</label>
            <TelerikSlider @bind-Value="_splitAt"
                           Min="0"
                           Max="@Clip.TrimmedDuration"
                           SmallStep="0.1"
                           LargeStep="1"
                           Orientation="@SliderOrientation.Horizontal"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0, Clip.TrimmedDuration, 1)"
                           Class="bv-clip-editor__slider" />
            <span class="bv-clip-editor__time">@FormatTime(_splitAt)</span>
        </div>

        <!-- ── Slip / Roll / Slide (item #50) ────────────────────────────── -->
        <div class="bv-clip-editor__field bv-clip-editor__trim-nudges">
            <label class="bv-clip-editor__label" title="Change what part of the source media this clip shows, without moving it or changing its length.">Slip</label>
            <TelerikButton OnClick="@(() => SlipClip(-0.5))" Size="@ThemeConstants.Button.Size.Small" Icon="@SvgIcon.ChevronLeft" Title="Slip back 0.5s" />
            <TelerikButton OnClick="@(() => SlipClip(0.5))" Size="@ThemeConstants.Button.Size.Small" Icon="@SvgIcon.ChevronRight" Title="Slip forward 0.5s" />

            <label class="bv-clip-editor__label" title="Move the edit point shared with the next clip, without changing their combined length.">Roll</label>
            <TelerikButton OnClick="@(() => RollEdit(-0.5))" Size="@ThemeConstants.Button.Size.Small" Icon="@SvgIcon.ChevronLeft" Title="Roll edit point back 0.5s" />
            <TelerikButton OnClick="@(() => RollEdit(0.5))" Size="@ThemeConstants.Button.Size.Small" Icon="@SvgIcon.ChevronRight" Title="Roll edit point forward 0.5s" />

            <label class="bv-clip-editor__label" title="Move this clip without changing its own trim — its neighbors absorb the move.">Slide</label>
            <TelerikButton OnClick="@(() => SlideClip(-0.5))" Size="@ThemeConstants.Button.Size.Small" Icon="@SvgIcon.ChevronLeft" Title="Slide back 0.5s" />
            <TelerikButton OnClick="@(() => SlideClip(0.5))" Size="@ThemeConstants.Button.Size.Small" Icon="@SvgIcon.ChevronRight" Title="Slide forward 0.5s" />
        </div>

        <!-- ── Speed ──────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__field">
            <label class="bv-clip-editor__label">Speed (@_speed.ToString("F2")x)</label>
            <TelerikSlider @bind-Value="_speed"
                           Min="0.25"
                           Max="4.0"
                           SmallStep="0.05"
                           LargeStep="0.25"
                           Orientation="@SliderOrientation.Horizontal"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.25, 4.0, 0.25)"
                           Class="bv-clip-editor__slider" />
        </div>

        <!-- ── Volume ──────────────────────────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__field">
            <label class="bv-clip-editor__label">
                Volume (@VolumeToDb(_volume) dB)
                @if (Clip.VolumeAutomation.Count >= 2)
                {
                    <span class="bv-clip-editor__badge">Automation active (@Clip.VolumeAutomation.Count pts)</span>
                }
            </label>
            <TelerikSlider @bind-Value="_volume"
                           Min="0.0"
                           Max="2.0"
                           SmallStep="0.05"
                           LargeStep="0.25"
                           Orientation="@SliderOrientation.Horizontal"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 2.0, 0.25)"
                           Class="bv-clip-editor__slider" />
        </div>


        @if (Options.VideoEffects)
        {
        <div class="bv-clip-editor__section-heading">Visual Effects</div>

        @foreach (var fx in Clip.AppliedEffects)
        {
            var effect = EffectRegistry.GetById(fx.EffectId);
            if (effect is null) { continue; }
            <div class="bv-clip-editor__effect-card">
                <div class="bv-clip-editor__effect-header">
                    <span class="bv-clip-editor__effect-name">@effect.DisplayName</span>
                    <TelerikButton OnClick="@(() => RemoveEffect(fx))"
                                   Icon="@SvgIcon.X"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                   Title="Remove effect" />
                </div>
                @foreach (var param in effect.ParameterSchema)
                {
                    var localFx    = fx;
                    var localParam = param;
                    var paramVal   = localFx.Parameters.TryGetValue(localParam.Key, out var pv) ? pv : localParam.DefaultValue;
                    <div class="bv-clip-editor__field">
                        @if (localParam.Type == ParameterType.Select && localParam.Options.Count > 0)
                        {
                            var idx = (int)Math.Round(paramVal);
                            var label = localParam.Options.ElementAtOrDefault(idx) ?? localParam.Options[0];
                            <label class="bv-clip-editor__label">@localParam.Label: @label</label>
                            <TelerikDropDownList Data="@localParam.Options"
                                                 Value="@label"
                                                 ValueChanged="@((string s) => UpdateEffectParameter(localFx, localParam.Key, (double)localParam.Options.ToList().IndexOf(s)))"
                                                 Class="bv-clip-editor__effect-dropdown" />
                        }
                        else if (localParam.Type == ParameterType.Color)
                        {
                            <ColorPickerField Label="@localParam.Label"
                                              Value="@paramVal"
                                              ValueChanged="@((double v) => UpdateEffectParameter(localFx, localParam.Key, v))"
                                              ShowAlpha="true" />
                        }
                        else if (localParam.Type == ParameterType.Toggle)
                        {
                            <label class="bv-clip-editor__label">@localParam.Label</label>
                            <TelerikCheckBox Value="@(paramVal >= 0.5)"
                                             ValueChanged="@((bool b) => UpdateEffectParameter(localFx, localParam.Key, b ? 1.0 : 0.0))" />
                        }
                        else
                        {
                            <label class="bv-clip-editor__label">@localParam.Label (@paramVal.ToString("F2"))</label>
                            <TelerikSlider Value="@paramVal"
                                           ValueChanged="@((double v) => UpdateEffectParameter(localFx, localParam.Key, v))"
                                           Min="@localParam.Min"
                                           Max="@localParam.Max"
                                           SmallStep="@localParam.Step"
                                           LargeStep="@localParam.LargeStep"
                                           Orientation="@SliderOrientation.Horizontal"
                                           LabelTemplate="@SliderLabelTemplates.Endpoints(localParam.Min, localParam.Max, localParam.LargeStep)"
                                           Class="bv-clip-editor__slider" />
                        }
                    </div>
                }
            </div>
        }

        <div class="bv-clip-editor__field">
            <TelerikDropDownList Data="@EffectRegistry.All"
                                 @bind-Value="@_selectedEffectId"
                                 TextField="@nameof(IClipEffect.DisplayName)"
                                 ValueField="@nameof(IClipEffect.EffectId)"
                                 DefaultText="Add effect..."
                                 Class="bv-clip-editor__effect-dropdown" />
            <TelerikButton OnClick="AddSelectedEffect"
                           Icon="@SvgIcon.Plus"
                           Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                           Title="Add selected effect"
                           Enabled="@(_selectedEffectId is not null)">
                Add
            </TelerikButton>
        </div>
        }

        @* ── Placement ───────────────────────────────────────────────────────────────────
           A clip could only fill the frame. On a second video track that meant it replaced the
           picture underneath and could never sit beside it or in a corner of it — no two cameras
           side by side, no corner inset, no upright phone footage, no cutting a DVR's bars off
           (2026-09-05 audit). *@
        <div class="bv-clip-editor__section-heading">Placement</div>

        @if (Clip.Transform is null)
        {
            <p class="bv-clip-editor__hint">
                This clip fills the frame. Place it to put it in a corner or beside another clip,
                to turn footage that was shot sideways, or to cut something off its edges.
            </p>
            <div class="bv-clip-editor__field">
                <TelerikButton OnClick="AddTransform"
                               Icon="@SvgIcon.Plus"
                               Size="@ThemeConstants.Button.Size.Small"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Info">
                    Place this clip
                </TelerikButton>
            </div>
        }
        else
        {
            var t = Clip.Transform;
            <div class="bv-clip-editor__effect-card">
                <div class="bv-clip-editor__effect-header">
                    <span class="bv-clip-editor__effect-name">Where it sits</span>
                    <TelerikButton OnClick="RemoveTransform"
                                   Icon="@SvgIcon.X"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                   Title="Go back to filling the frame" />
                </div>

                <div class="bv-clip-editor__field">
                    <TelerikDropDownList Data="@_placementPresets"
                                         Value="@_selectedPreset"
                                         ValueChanged="@((string v) => ApplyPreset(v))"
                                         ValueExpression="@(() => _selectedPreset)"
                                         DefaultText="Preset…"
                                         Class="bv-clip-editor__effect-dropdown" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">
                        Across @((t.Width * 100).ToString("F0"))% from @((t.X * 100).ToString("F0"))%
                    </label>
                    <TelerikSlider Value="@t.X" ValueChanged="@((double v) => UpdateTransform(x => x.X = v))"
                                   ValueExpression="@(() => t.X)" Min="0.0" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.25)" Class="bv-clip-editor__slider" />
                    <TelerikSlider Value="@t.Width" ValueChanged="@((double v) => UpdateTransform(x => x.Width = v))"
                                   ValueExpression="@(() => t.Width)" Min="0.05" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.05, 1.0, 0.25)" Class="bv-clip-editor__slider" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">
                        Down @((t.Height * 100).ToString("F0"))% from @((t.Y * 100).ToString("F0"))%
                    </label>
                    <TelerikSlider Value="@t.Y" ValueChanged="@((double v) => UpdateTransform(x => x.Y = v))"
                                   ValueExpression="@(() => t.Y)" Min="0.0" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.25)" Class="bv-clip-editor__slider" />
                    <TelerikSlider Value="@t.Height" ValueChanged="@((double v) => UpdateTransform(x => x.Height = v))"
                                   ValueExpression="@(() => t.Height)" Min="0.05" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.05, 1.0, 0.25)" Class="bv-clip-editor__slider" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">Turn (@t.Rotation.ToString("F0"))°</label>
                    <TelerikSlider Value="@t.Rotation" ValueChanged="@((double v) => UpdateTransform(x => x.Rotation = v))"
                                   ValueExpression="@(() => t.Rotation)" Min="-180" Max="180" SmallStep="90" LargeStep="90"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(-180.0, 180.0, 90.0)" Class="bv-clip-editor__slider" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">Opacity (@((t.Opacity * 100).ToString("F0"))%)</label>
                    <TelerikSlider Value="@t.Opacity" ValueChanged="@((double v) => UpdateTransform(x => x.Opacity = v))"
                                   ValueExpression="@(() => t.Opacity)" Min="0.0" Max="1.0" SmallStep="0.05" LargeStep="0.25"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.25)" Class="bv-clip-editor__slider" />
                </div>

                <div class="bv-clip-editor__section-heading">Cut off the edges</div>
                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">
                        Left @((t.CropLeft * 100).ToString("F0"))% · right @((t.CropRight * 100).ToString("F0"))%
                    </label>
                    <TelerikSlider Value="@t.CropLeft" ValueChanged="@((double v) => UpdateTransform(x => x.CropLeft = v))"
                                   ValueExpression="@(() => t.CropLeft)" Min="0.0" Max="0.45" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 0.45, 0.15)" Class="bv-clip-editor__slider" />
                    <TelerikSlider Value="@t.CropRight" ValueChanged="@((double v) => UpdateTransform(x => x.CropRight = v))"
                                   ValueExpression="@(() => t.CropRight)" Min="0.0" Max="0.45" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 0.45, 0.15)" Class="bv-clip-editor__slider" />
                </div>
                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">
                        Top @((t.CropTop * 100).ToString("F0"))% · bottom @((t.CropBottom * 100).ToString("F0"))%
                    </label>
                    <TelerikSlider Value="@t.CropTop" ValueChanged="@((double v) => UpdateTransform(x => x.CropTop = v))"
                                   ValueExpression="@(() => t.CropTop)" Min="0.0" Max="0.45" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 0.45, 0.15)" Class="bv-clip-editor__slider" />
                    <TelerikSlider Value="@t.CropBottom" ValueChanged="@((double v) => UpdateTransform(x => x.CropBottom = v))"
                                   ValueExpression="@(() => t.CropBottom)" Min="0.0" Max="0.45" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 0.45, 0.15)" Class="bv-clip-editor__slider" />
                </div>
            </div>
        }

        @* ── Hidden areas ────────────────────────────────────────────────────────────────
           Members cut evidence reels from footage shot inside people's homes, and a private
           engagement's own rule is that what identifies the client or the address does not go
           out. The editor had a whole-frame blur and nothing that could obscure part of a
           picture, so a clip with one identifying detail in it could only be left out
           (2026-09-05 audit). *@
        <div class="bv-clip-editor__section-heading">Hidden areas</div>

        @if (Clip.Redactions.Count == 0)
        {
            <p class="bv-clip-editor__hint">
                Cover a face, a number plate or a house number so the clip can still be shared.
            </p>
        }

        @foreach (var region in Clip.Redactions)
        {
            var r = region;
            var index = Clip.Redactions.IndexOf(r) + 1;
            <div class="bv-clip-editor__effect-card">
                <div class="bv-clip-editor__effect-header">
                    <span class="bv-clip-editor__effect-name">Area @index</span>
                    <TelerikButton OnClick="@(() => RemoveRedaction(r))"
                                   Icon="@SvgIcon.X"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                   Title="Stop hiding this area" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">How</label>
                    <TelerikDropDownList Data="@_redactionStyles"
                                         Value="@r.Style"
                                         ValueChanged="@((RedactionStyle v) => UpdateRedaction(r, x => x.Style = v))"
                                         ValueExpression="@(() => r.Style)"
                                         Class="bv-clip-editor__effect-dropdown" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">Strength (@r.Strength.ToString("F0"))</label>
                    <TelerikSlider Value="@r.Strength"
                                   ValueChanged="@((double v) => UpdateRedaction(r, x => x.Strength = v))"
                                   ValueExpression="@(() => r.Strength)"
                                   Min="1" Max="10" SmallStep="1" LargeStep="3"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(1.0, 10.0, 3.0)"
                                   Class="bv-clip-editor__slider" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">
                        Across @((r.Width * 100).ToString("F0"))% from @((r.X * 100).ToString("F0"))%
                    </label>
                    <TelerikSlider Value="@r.X" ValueChanged="@((double v) => UpdateRedaction(r, x => x.X = v))"
                                   ValueExpression="@(() => r.X)"
                                   Min="0.0" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.25)"
                                   Class="bv-clip-editor__slider" />
                    <TelerikSlider Value="@r.Width" ValueChanged="@((double v) => UpdateRedaction(r, x => x.Width = v))"
                                   ValueExpression="@(() => r.Width)"
                                   Min="0.02" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.02, 1.0, 0.25)"
                                   Class="bv-clip-editor__slider" />
                </div>

                <div class="bv-clip-editor__field">
                    <label class="bv-clip-editor__label">
                        Down @((r.Height * 100).ToString("F0"))% from @((r.Y * 100).ToString("F0"))%
                    </label>
                    <TelerikSlider Value="@r.Y" ValueChanged="@((double v) => UpdateRedaction(r, x => x.Y = v))"
                                   ValueExpression="@(() => r.Y)"
                                   Min="0.0" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.25)"
                                   Class="bv-clip-editor__slider" />
                    <TelerikSlider Value="@r.Height" ValueChanged="@((double v) => UpdateRedaction(r, x => x.Height = v))"
                                   ValueExpression="@(() => r.Height)"
                                   Min="0.02" Max="1.0" SmallStep="0.01" LargeStep="0.1"
                                   LabelTemplate="@SliderLabelTemplates.Endpoints(0.02, 1.0, 0.25)"
                                   Class="bv-clip-editor__slider" />
                </div>
            </div>
        }

        <div class="bv-clip-editor__field">
            <TelerikButton OnClick="AddRedaction"
                           Icon="@SvgIcon.Plus"
                           Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                           Title="Hide part of this clip's picture">
                Hide an area
            </TelerikButton>
        </div>

        <!-- ── Action buttons ──────────────────────────────────────────────────────────────── -->
        <div class="bv-clip-editor__actions">
        <div class="bv-clip-editor__field">
            <TelerikButton OnClick="OnTrimChanged"
                           Icon="@SvgIcon.Check"
                           Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Title="Apply trim points">
                Apply Trim
            </TelerikButton>
        </div>

        @* Trimming to where you are watching. Mark In and Mark Out existed, but only for a clip
           being previewed out of the media panel before placing it — for a clip already on the
           timeline there was no way to say "cut it here" except reading the playhead's timecode
           and typing the number into the trim box (2026-09-05 audit, preview-13). *@
        <div class="bv-clip-editor__field bv-clip-editor__marks">
            <TelerikButton OnClick="SetInFromPlayhead"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           Class="btn-sm text-nowrap"
                           Enabled="@PlayheadIsInsideClip"
                           Title="Start the clip at the playhead">
                Set In
            </TelerikButton>
            <TelerikButton OnClick="SetOutFromPlayhead"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Outline"
                           Class="btn-sm text-nowrap"
                           Enabled="@PlayheadIsInsideClip"
                           Title="End the clip at the playhead">
                Set Out
            </TelerikButton>
        </div>

        <div class="bv-clip-editor__field">
            <TelerikButton OnClick="ApplySpeed"
                           Icon="@SvgIcon.Play"
                           Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                           Title="Apply playback speed">
                Apply Speed
            </TelerikButton>
        </div>

        <div class="bv-clip-editor__field">
            <TelerikButton OnClick="ApplyVolume"
                           Icon="@SvgIcon.VolumeUp"
                           Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                           Title="Apply scalar volume">
                Apply Volume
            </TelerikButton>
            @if (Clip.VolumeAutomation.Count >= 2)
            {
                <TelerikButton OnClick="ClearAutomation"
                               Icon="@SvgIcon.X"
                               Size="@ThemeConstants.Button.Size.Small"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                               Title="Clear all automation keyframes">
                    Clear Automation
                </TelerikButton>
            }
        </div>

            <TelerikButton OnClick="SplitAsync"
                           Icon="@SvgIcon.Crop"
                           Size="@ThemeConstants.Button.Size.Small"
                           Title="Split clip at selected point">
                Split
            </TelerikButton>

            @if (Clip.LinkedClipId is null)
            {
                <TelerikButton OnClick="LinkNearbyAudio"
                               Size="@ThemeConstants.Button.Size.Small"
                               Title="Link the nearest unlinked audio clip — lets you see and independently trim their relative offset for a J-cut or L-cut (item #52)">
                    Link Nearby Audio
                </TelerikButton>
            }
            else
            {
                <TelerikButton OnClick="Unlink"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Remove the link to its paired audio clip">
                    Unlink Audio
                </TelerikButton>
            }

            <TelerikButton OnClick="DeleteAsync"
                           Icon="@SvgIcon.Trash"
                           Size="@ThemeConstants.Button.Size.Small"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           Title="Remove clip from timeline">
                Delete
            </TelerikButton>
        </div>

    </div>
}

@code {
    private static readonly List<RedactionStyle> _redactionStyles =
        [.. Enum.GetValues<RedactionStyle>()];

    // ── Parameters ──────────────────────────────────────────────────────────

    /// <summary>The clip currently being edited. Null = panel is hidden.</summary>
    [Parameter] public VideoClip? Clip { get; set; }

    /// <summary>Raised when the user closes the panel (X button).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after trim points are committed to <see cref="ClipStore"/>.</summary>
    [Parameter] public EventCallback<VideoClip> OnTrimApplied { get; set; }

    /// <summary>Raised after the clip is split.</summary>
    [Parameter] public EventCallback<VideoClip> OnClipSplit { get; set; }

    /// <summary>Raised after the clip is deleted from the timeline.</summary>
    [Parameter] public EventCallback<VideoClip> OnClipDeleted { get; set; }

    /// <summary>Effective options from the parent VideoEditor. Null = use the IOptions value from DI.</summary>
    [Parameter] public VideoEditorOptions? EditorOptions { get; set; }

    private VideoEditorOptions Options => EditorOptions ?? EditorOptionsAccessor.Value;

    // ── Local state ─────────────────────────────────────────────────────────

    private double _trimStart;
    private double _trimEnd;
    private double _splitAt;
    private double _speed;
    private double _volume;
    private string? _selectedEffectId;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (Clip is null) return;

        _trimStart = Clip.StartTrim;
        _trimEnd   = Clip.EndTrim > Clip.StartTrim ? Clip.EndTrim : Clip.Duration;
        _speed     = Clip.Speed;
        _volume    = Clip.Volume;
        _selectedEffectId = null;

        // The slider is an offset within this clip, so the playhead has to be converted from the
        // timeline's clock before it can seed it (2026-09-05 audit, timeline-1).
        var playheadOffset = Playback.State.TimelineTime - Clip.TimelinePosition;
        _splitAt = Math.Clamp(playheadOffset, 0, Clip.TrimmedDuration);
        if (_splitAt <= 0 || _splitAt >= Clip.TrimmedDuration)
            _splitAt = Clip.TrimmedDuration / 2.0;
    }

    // ── Handlers ─────────────────────────────────────────────────────────────

    /// <summary>
    /// Where the playhead sits inside this clip's own source, in seconds.
    /// </summary>
    /// <remarks>
    /// Timeline time back to source time: subtract where the clip starts on the timeline, undo the
    /// speed change, then add back what is already trimmed off its head.
    /// </remarks>
    private double PlayheadInSource
    {
        get
        {
            if (Clip is null) return 0;
            var speed = Clip.Speed > 0 ? Clip.Speed : 1.0;
            return Clip.StartTrim + (Playback.State.TimelineTime - Clip.TimelinePosition) * speed;
        }
    }

    /// <summary>
    /// Whether the playhead is over this clip at all — trimming to a point outside it is not a
    /// trim, so the buttons say so rather than silently doing something surprising.
    /// </summary>
    private bool PlayheadIsInsideClip =>
        Clip is not null
        && Playback.State.TimelineTime > Clip.TimelinePosition
        && Playback.State.TimelineTime < Clip.TimelinePosition + Clip.EffectiveLength;

    private void SetInFromPlayhead()
    {
        if (Clip is null) return;

        var at = PlayheadInSource;
        if (at >= _trimEnd) return;

        _trimStart = at;
        OnTrimChanged();
    }

    private void SetOutFromPlayhead()
    {
        if (Clip is null) return;

        var at = PlayheadInSource;
        if (at <= _trimStart) return;

        _trimEnd = at;
        OnTrimChanged();
    }

    private void OnTrimChanged()
    {
        if (Clip is null) return;
        if (_trimStart >= _trimEnd) return;
        Clips.UpdateTrim(Clip.Id, _trimStart, _trimEnd);
        OnTrimApplied.InvokeAsync(Clip);
    }

    private void ApplySpeed()
    {
        if (Clip is null) return;
        Clips.UpdateClipSpeed(Clip.Id, _speed);
    }

    private void ApplyVolume()
    {
        if (Clip is null) return;
        Clips.SetClipVolume(Clip.Id, _volume);
    }

    private void ClearAutomation()
    {
        if (Clip is null) return;
        Clips.ClearVolumeAutomation(Clip.Id);
    }

    private async Task SplitAsync()
    {
        if (Clip is null) return;
        Clips.SplitClip(Clip.Id, _splitAt);
        await OnClipSplit.InvokeAsync(Clip);
    }

    private void SlipClip(double delta)
    {
        if (Clip is null) return;
        Clips.SlipClip(Clip.Id, delta);
    }

    private void RollEdit(double delta)
    {
        if (Clip is null) return;
        Clips.RollEdit(Clip.Id, delta);
    }

    private void SlideClip(double delta)
    {
        if (Clip is null) return;
        Clips.SlideClip(Clip.Id, delta);
    }

    /// <summary>Item #52: links the nearest unlinked audio clip within a small threshold of this
    /// clip's edges, so their relative offset can be shown and independently trimmed for a J/L-cut.</summary>
    private void LinkNearbyAudio()
    {
        if (Clip is null) return;
        var candidate = Clips.FindNearbyLinkCandidate(Clip);
        if (candidate is not null)
            Clips.LinkClips(Clip.Id, candidate.Id);
    }

    private void Unlink()
    {
        if (Clip is null) return;
        Clips.UnlinkClip(Clip.Id);
    }

    /// <summary>Seconds the linked audio clip's start sits after (positive) or before (negative)
    /// this clip's start — an L-cut/J-cut readout. Null when unlinked or the partner is gone.</summary>
    private double? LinkedAudioOffsetSeconds
    {
        get
        {
            if (Clip?.LinkedClipId is not { } partnerId) return null;
            var partner = Clips.AllAudioClips.FirstOrDefault(a => a.Id == partnerId);
            return partner is null ? null : partner.TimelinePosition - Clip.TimelinePosition;
        }
    }

    private async Task DeleteAsync()
    {
        if (Clip is null) return;
        var deleted = Clip;
        Clips.RemoveClip(deleted.Id);
        await OnClipDeleted.InvokeAsync(deleted);
    }

    private void AddSelectedEffect()
    {
        if (Clip is null || _selectedEffectId is null) return;
        var effect = EffectRegistry.GetById(_selectedEffectId);
        if (effect is null) return;
        Clips.AddEffect(Clip.Id, effect.CreateDefault());
        _selectedEffectId = null;
    }

    private void RemoveEffect(AppliedEffect fx)
    {
        if (Clip is null) return;
        Clips.RemoveEffect(Clip.Id, fx);
    }

    // ── Placement ────────────────────────────────────────────────────────────

    /// <summary>Layouts worth one click, because nobody wants to find 0.7 by dragging.</summary>
    private static readonly List<string> _placementPresets =
        ["Fill the frame", "Top left corner", "Top right corner", "Bottom left corner",
         "Bottom right corner", "Left half", "Right half", "Turn upright", "Turn back"];

    private string? _selectedPreset;

    private void AddTransform()
    {
        if (Clip is null) return;
        // A quarter-size inset in the bottom right: visibly placed, so the controls below have
        // something to move rather than starting at "exactly as it was".
        Clips.CommitClipTransform(Clip.Id,
            new ClipTransform { X = 0.68, Y = 0.66, Width = 0.3, Height = 0.3 }, Clip.Transform);
    }

    private void RemoveTransform()
    {
        if (Clip is null) return;
        Clips.CommitClipTransform(Clip.Id, null, Clip.Transform);
    }

    private void UpdateTransform(Action<ClipTransform> change)
    {
        if (Clip?.Transform is not { } current) return;

        var updated = current with { };
        change(updated);
        Clips.CommitClipTransform(Clip.Id, updated, current);
    }

    private void ApplyPreset(string preset)
    {
        _selectedPreset = preset;
        if (Clip is null) return;

        var current = Clip.Transform ?? new ClipTransform();

        var updated = preset switch
        {
            "Fill the frame"        => current with { X = 0,    Y = 0,    Width = 1.0, Height = 1.0 },
            "Top left corner"       => current with { X = 0.02, Y = 0.03, Width = 0.3, Height = 0.3 },
            "Top right corner"      => current with { X = 0.68, Y = 0.03, Width = 0.3, Height = 0.3 },
            "Bottom left corner"    => current with { X = 0.02, Y = 0.66, Width = 0.3, Height = 0.3 },
            "Bottom right corner"   => current with { X = 0.68, Y = 0.66, Width = 0.3, Height = 0.3 },
            "Left half"             => current with { X = 0,    Y = 0,    Width = 0.5, Height = 1.0 },
            "Right half"            => current with { X = 0.5,  Y = 0,    Width = 0.5, Height = 1.0 },
            "Turn upright"          => current with { Rotation = 90 },
            "Turn back"             => current with { Rotation = -90 },
            _                       => current,
        };

        Clips.CommitClipTransform(Clip.Id, updated, Clip.Transform);
    }

    // ── Hidden areas ─────────────────────────────────────────────────────────
    //
    // Undoable like everything else, and for a stronger reason than usual: an accidental Ctrl+Z
    // that quietly removed a redaction would leave somebody exporting a face they believe they
    // covered. The store records the whole list either way, so undo puts back exactly what was
    // there.

    private void AddRedaction()
    {
        if (Clip is null) return;

        var region = new RedactionRegion();
        var before = Snapshot(Clip);

        Clips.CommitClipRedactions(Clip.Id, [.. before, region], before);
    }

    private void RemoveRedaction(RedactionRegion region)
    {
        if (Clip is null) return;

        var before = Snapshot(Clip);
        Clips.CommitClipRedactions(Clip.Id, [.. before.Where(r => !ReferenceEquals(r, region))], before);
    }

    private void UpdateRedaction(RedactionRegion region, Action<RedactionRegion> change)
    {
        if (Clip is null) return;

        var before = Snapshot(Clip);
        var after  = Clip.Redactions
            .Select(r => ReferenceEquals(r, region) ? Apply(r, change) : r with { })
            .ToList();

        Clips.CommitClipRedactions(Clip.Id, after, before);
    }

    private static RedactionRegion Apply(RedactionRegion region, Action<RedactionRegion> change)
    {
        var copy = region with { };
        change(copy);
        return copy;
    }

    /// <summary>Copies, so undo holds values rather than the very objects being edited.</summary>
    private static List<RedactionRegion> Snapshot(VideoClip clip) =>
        [.. clip.Redactions.Select(r => r with { })];

    private void UpdateEffectParameter(AppliedEffect fx, string key, double value)
    {
        if (Clip is null) return;
        Clips.UpdateEffectParameter(fx, key, value);
    }

    private async Task Close() => await OnClose.InvokeAsync();

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? ts.ToString(@"h\:mm\:ss\.f")
            : ts.ToString(@"m\:ss\.f");
    }

    private static string VolumeToDb(double linear)
    {
        if (linear <= 0) return "-\u221e";
        var db = 20.0 * Math.Log10(linear);
        return db.ToString("+0.0;-0.0;0.0", System.Globalization.CultureInfo.InvariantCulture);
    }
}
