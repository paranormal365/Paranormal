@using Ben.Video.Core.Services
@* Phase 176 — where does the finished video go?

   Shown once an immediate ("Export Now") render finishes, and ONLY when the host has supplied an
   OnPublishExport handler; without one there is no second destination to offer, so the export
   downloads directly as it always did and this never appears.

   Distinct from ExportSavePrompt, which is about the .benvideo PROJECT (JSON, so you can keep
   editing later). This one is about the rendered video. The two answer different questions and
   deliberately stay separate components. *@
@if (Visible)
{
    @* Closing the window used to delete the finished render outright, with no confirmation and
       nothing to say it had happened — an accidental X, or Escape, threw away a long export
       (2026-09-05 audit, export-17). Closing now asks; the file is only deleted on purpose. *@
    <TelerikWindow Visible="true"
                   VisibleChanged="@(v => { if (!v) AskBeforeDiscarding(); })"
                   Width="420px"
                   Modal="true"
                   Draggable="true"
                   Resizable="false"
                   Class="bv-export-destination-prompt">
        <WindowTitle>Export Complete</WindowTitle>
        <WindowContent>
            @if (_state.IsConfirmingDiscard)
            {
                <p class="bv-export-destination-prompt__text" role="alert">
                    Discard <strong>@FileName</strong>? The render is finished, and throwing it
                    away means rendering it again from scratch.
                </p>
            }
            else
            {
                <p class="bv-export-destination-prompt__text">
                    <strong>@FileName</strong> is ready@(SizeLabel is null ? "" : $" ({SizeLabel})").
                    Where should it go?
                </p>
            }
            @if (_state.Error is not null)
            {
                <p class="bv-export-destination-prompt__error" role="alert">@_state.Error</p>
            }

            @if (!CanUpload && !_state.IsConfirmingDiscard)
            {
                <p class="bv-export-destination-prompt__hint">@UploadUnavailableReason</p>
            }
        </WindowContent>
        <WindowFooter>
            @if (_state.IsConfirmingDiscard)
            {
                <TelerikButton OnClick="ConfirmDiscardAsync"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                               Size="@ThemeConstants.Button.Size.Small">
                    Discard it
                </TelerikButton>
                <TelerikButton OnClick="KeepIt"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                               Size="@ThemeConstants.Button.Size.Small">
                    Keep it
                </TelerikButton>
            }
            else
            {
            @* Busy state is on the whole footer, not just the clicked button: publishing a large
               render is slow enough that a second click on the OTHER button would otherwise start
               a download of a file publish is midway through consuming. *@
            @* Offered only when the host says this person can actually upload. Shown disabled
               with a reason rather than hidden: "where can this go" is the question the prompt
               exists to answer, and silently omitting the server makes it look as though the
               editor cannot do it at all (2026-09-05 audit, F12). *@
            <TelerikButton OnClick="UploadAsync"
                           Enabled="@(_state.CanAct && CanUpload)"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Size="@ThemeConstants.Button.Size.Small"
                           Title="@(CanUpload ? "Upload to your media library" : UploadUnavailableReason)">
                @(_state.IsBusy ? "Uploading…" : "Upload to server")
            </TelerikButton>
            @if (ShowPostToFeed)
            {
                @* Item 186 F7 — the third destination. Offered only when the host confirmed this
                   person may post (the server's CanPost), so the button is never an invitation
                   to a refusal. The host's handler owns the confirmation dialog — case lineage
                   and privacy wording are the host's knowledge, not the editor's. *@
                <TelerikButton OnClick="PostToFeedAsync"
                               Enabled="@(_state.CanAct)"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                               Size="@ThemeConstants.Button.Size.Small">
                    @(_state.IsBusy ? "Posting…" : "Post to the feed")
                </TelerikButton>
            }
            <TelerikButton OnClick="SaveToDeviceAsync"
                           Enabled="@(_state.CanAct)"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           Size="@ThemeConstants.Button.Size.Small">
                Save to my machine
            </TelerikButton>
            <TelerikButton OnClick="AskBeforeDiscarding"
                           Enabled="@(_state.CanAct)"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Size="@ThemeConstants.Button.Size.Small">
                Discard
            </TelerikButton>
            }
        </WindowFooter>
    </TelerikWindow>
}

@code {
    [Parameter] public bool                Visible        { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>Output filename, shown so the user knows which render they're placing.</summary>
    [Parameter] public string FileName { get; set; } = string.Empty;

    /// <summary>Rendered size in bytes; 0 hides the size hint rather than showing "0 B".</summary>
    [Parameter] public long SizeBytes { get; set; }

    /// <summary>Runs the host's publish. Must throw on failure — the prompt stays open and shows
    /// the message, because a silently-dismissed failure would leave the user believing a video
    /// reached the server when it did not, with the only copy already deleted.</summary>
    [Parameter] public EventCallback OnUpload { get; set; }

    [Parameter] public EventCallback OnSaveToDevice { get; set; }
    [Parameter] public EventCallback OnDiscard      { get; set; }

    /// <summary>Offers the feed destination (item 186 F7). Same throw-on-failure contract as
    /// <see cref="OnUpload"/> — a cancelled or refused post keeps the prompt (and the render).</summary>
    [Parameter] public EventCallback OnPostToFeed { get; set; }

    /// <summary>Host's call, from the server's own CanPost — the editor never guesses.</summary>
    [Parameter] public bool ShowPostToFeed { get; set; }

    /// <summary>
    /// Whether the server destination is actually available to this person right now.
    /// </summary>
    /// <remarks>
    /// The standalone host passes the signed-in state. Signed out, the button stays visible and
    /// disabled with a reason, because the alternative — no server option at all — reads as the
    /// editor being unable to publish rather than the person needing to sign in.
    /// </remarks>
    [Parameter] public bool CanUpload { get; set; } = true;

    /// <summary>Why the server destination is unavailable, when it is.</summary>
    [Parameter] public string UploadUnavailableReason { get; set; } = "Sign in to upload.";

    /// <summary>
    /// Busy, error and confirm-discard, as a machine that can be asked questions without a
    /// browser. Extracted because what this window does wrong loses somebody's render
    /// (2026-09-05 audit, export-17 and phase 11).
    /// </summary>
    private readonly ExportDestinationPromptState _state = new();

    private string? SizeLabel => SizeBytes <= 0 ? null : FormatSize(SizeBytes);

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024L * 1024 * 1024 => $"{bytes / 1024d / 1024 / 1024:0.#} GB",
        >= 1024L * 1024        => $"{bytes / 1024d / 1024:0.#} MB",
        >= 1024                => $"{bytes / 1024d:0.#} KB",
        _                      => $"{bytes} B",
    };

    /// <summary>Second and later exports reuse the component, so it opens fresh each time.</summary>
    protected override void OnParametersSet()
    {
        if (Visible && _state.IsClosed) _state.Reopen();
    }

    private async Task UploadAsync()
    {
        if (!_state.BeginWork()) return;
        StateHasChanged();
        try
        {
            await OnUpload.InvokeAsync();
            _state.Succeeded();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            // Stay open. The editor has NOT discarded the render at this point (see
            // VideoEditor.PublishExportAsync), so "Save to my machine" is still a live escape
            // hatch rather than a dead button next to a lost file.
            _state.Failed($"Upload failed: {ex.Message}. You can still save it to your machine.");
        }
        StateHasChanged();
    }

    private async Task PostToFeedAsync()
    {
        if (!_state.BeginWork()) return;
        StateHasChanged();
        try
        {
            await OnPostToFeed.InvokeAsync();
            _state.Succeeded();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            // Same escape hatch as UploadAsync: the render is untouched, the prompt stays.
            _state.Failed($"{ex.Message} You can still save it to your machine.");
        }
        StateHasChanged();
    }

    private async Task SaveToDeviceAsync()
    {
        if (!_state.BeginWork()) return;
        StateHasChanged();
        try
        {
            await OnSaveToDevice.InvokeAsync();
            _state.Succeeded();
            await CloseAsync();
        }
        catch (Exception ex)
        {
            _state.Failed($"The download did not start: {ex.Message}");
        }
        StateHasChanged();
    }

    /// <summary>
    /// Turns any attempt to close into a question, rather than a deletion.
    /// </summary>
    private void AskBeforeDiscarding()
    {
        if (_state.AskBeforeDiscarding()) StateHasChanged();
    }

    private void KeepIt()
    {
        _state.KeepIt();
        StateHasChanged();
    }

    private async Task ConfirmDiscardAsync()
    {
        // Only ever reached from the confirmation, so nothing can delete a render that nobody was
        // asked about.
        if (!_state.ConfirmDiscard()) return;

        await OnDiscard.InvokeAsync();
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
