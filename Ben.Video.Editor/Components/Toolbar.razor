@implements IDisposable
@implements IAsyncDisposable
@inject FfmpegService Ffmpeg
@inject MemFsLedger MemFs
@inject NativeSidecarService NativeSidecar
@inject IJSRuntime JS

<header class="bv-toolbar">

    <TelerikToolBar OverflowMode="@ToolBarOverflowMode.Menu"
                     Size="@ThemeConstants.Button.Size.Small"
                     Class="bv-toolbar__telerik-bar">

        @* Initialize ffmpeg.wasm core. Hidden once it has loaded: it is a one-shot action whose
           result is already announced by the status chip, so leaving it in place costs permanent
           width for a button nobody presses twice. It comes back on Error, which is the one case
           where pressing it again is exactly what to do. *@
        @if (Ffmpeg.State is FfmpegState.Idle or FfmpegState.Error)
        {
            <ToolBarButton OnClick="OnInitializeClicked"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           Overflow="@ToolBarItemOverflow.Never"
                           Icon="@SvgIcon.Play">
                Initialize
            </ToolBarButton>
        }

        <!-- Open files — only active when ready -->
        <ToolBarButton OnClick="OnOpenClicked"
                       Enabled="@(Ffmpeg.State == FfmpegState.Ready)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                       Overflow="@ToolBarItemOverflow.Never"
                       Icon="@SvgIcon.FolderOpen">
            Open
        </ToolBarButton>

        <!-- Full-resolution/quality Preview — renders the real result (item #36 phase 84) in the
             popout window, in-memory only, never saved. The Working Window itself always stays
             live/current on its own (auto-refreshing preview-quality background rendering) — this
             button is for checking the actual finished output before committing to Export. -->
        <ToolBarButton OnClick="OnPreviewClicked"
                       Enabled="@(Ffmpeg.State == FfmpegState.Ready && HasClips)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                       Overflow="@ToolBarItemOverflow.Never"
                       Icon="@SvgIcon.Eye"
                       Title="Preview the final result at full resolution/quality (opens in a separate window)">
            Preview
        </ToolBarButton>

        <!-- Export — only active when ready and there are clips -->
        <ToolBarButton OnClick="OnExportClicked"
                       Enabled="@(Ffmpeg.State == FfmpegState.Ready && HasClips)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Success"
                       Overflow="@ToolBarItemOverflow.Never"
                       Icon="@SvgIcon.Download"
                       Title="Render the final video locally in the browser (ffmpeg.wasm), then save or upload">
            Export
        </ToolBarButton>

        <!-- Undo -->
        @* Undo/Redo carry a label as well as an icon, hidden in the bar (.bv-icon-only) and shown
           if they ever render in a menu — a menu of unlabelled icons is a list of guesses.

           Every action button before the spacer now sets Overflow="Never". They used to take
           Telerik's default of Auto, so as soon as the status chip grew a progress bar the whole
           primary row — Initialize, Open, Preview, Export, Undo, Redo — collapsed into "…", and
           the first thing the help tells a new person to press was not on screen (2026-09-05
           audit, F1). What may still collapse is deliberately the two least urgent items: the
           Assets toggle and Save-to-server, both labelled. *@
        <ToolBarButton OnClick="OnUndoClicked"
                       Enabled="@CanUndo"
                       Icon="@SvgIcon.Undo"
                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                       Overflow="@ToolBarItemOverflow.Never"
                       Class="bv-icon-only"
                       Title="@(UndoDescription is not null ? $"Undo: {UndoDescription}" : "Nothing to undo")">
            Undo
        </ToolBarButton>

        <!-- Redo -->
        <ToolBarButton OnClick="OnRedoClicked"
                       Enabled="@CanRedo"
                       Icon="@SvgIcon.Redo"
                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                       Overflow="@ToolBarItemOverflow.Never"
                       Class="bv-icon-only"
                       Title="@(RedoDescription is not null ? $"Redo: {RedoDescription}" : "Nothing to redo")">
            Redo
        </ToolBarButton>

        <!-- File menu — replaces the old Save / Open / Project buttons -->
        <ToolBarTemplateItem>
                <TelerikDropDownButton Icon="@SvgIcon.File"
                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Title="File menu">
                    <DropDownButtonContent>File</DropDownButtonContent>
                    <DropDownButtonItems>
                        <DropDownButtonItem Icon="@SvgIcon.Plus"
                                            OnClick="OnNewProjectClicked">New</DropDownButtonItem>
                        @* CanSave, not HasClips: a project can be worth saving without a video
                           clip in it — markers, a title, audio, or simply unsaved changes. Gating
                           on video content meant Save was disabled on work that plainly existed
                           (2026-09-05 audit, persistence-4). *@
                        <DropDownButtonItem Icon="@SvgIcon.Save"
                                            OnClick="OnSaveClicked"
                                            Enabled="@CanSave">Save</DropDownButtonItem>
                        <DropDownButtonItem Icon="@SvgIcon.Download"
                                            OnClick="OnSaveToDeviceClicked"
                                            Enabled="@CanSave">Save to Device…</DropDownButtonItem>
                        <DropDownButtonItem Icon="@SvgIcon.FolderOpen"
                                            OnClick="OnOpenProjectListClicked">Open…</DropDownButtonItem>
                        <DropDownButtonItem Icon="@SvgIcon.Upload"
                                            OnClick="OnImportJsonClicked">Import JSON…</DropDownButtonItem>
                        <DropDownButtonItem Icon="@SvgIcon.Download"
                                            OnClick="OnExportJsonClicked"
                                            Enabled="@CanSave">Export JSON</DropDownButtonItem>
                        @if (HasSubtitles)
                        {
                            <DropDownButtonItem Icon="@SvgIcon.FileTxt"
                                                OnClick="OnExportSrtClicked">Export Subtitles (.srt)</DropDownButtonItem>
                            <DropDownButtonItem Icon="@SvgIcon.FileTxt"
                                                OnClick="OnExportVttClicked">Export Captions (.vtt)</DropDownButtonItem>
                        }
                        @* Named for what it opens. As "Help" nobody found the shortcut list, and
                           the same word means the help article everywhere else on the site. *@
                        <DropDownButtonItem Icon="@SvgIcon.QuestionCircle"
                                            OnClick="OnHelpClicked">Keyboard shortcuts</DropDownButtonItem>
                        @if (ShowErrorLog)
                        {
                            <DropDownButtonItem Icon="@SvgIcon.FileError"
                                                OnClick="OnExportErrorLogClicked">Export Error Log</DropDownButtonItem>
                        }
                    </DropDownButtonItems>
                </TelerikDropDownButton>
        </ToolBarTemplateItem>

        <!-- Project name + dirty indicator -->
        <ToolBarTemplateItem>
                <input class="bv-toolbar__proj-name @(IsDirty ? "bv-toolbar__proj-name--dirty" : "")"
                       type="text"
                       value="@ProjectName"
                       @onchange="e => OnProjectNameChanged.InvokeAsync(e.Value?.ToString() ?? ProjectName)"
                       title="@(IsDirty ? "Project name — click to rename. Unsaved changes." : "Project name — click to rename")" />
                @* Drawn beside the box, not inside its value. As part of the value it became part
                   of the name the moment anybody renamed the project (2026-09-05 audit,
                   persistence-5). *@
                @if (IsDirty)
                {
                    <span class="bv-toolbar__proj-dirty" title="Unsaved changes" aria-label="Unsaved changes">*</span>
                }
        </ToolBarTemplateItem>

        @if (ShowProjectPersistence && ShowSaveToServer)
        {
            <!-- Save to server (legacy, kept for host apps that wire DocumentPostUrl) -->
            <ToolBarButton OnClick="OnSaveToServerClicked"
                           Enabled="@(HasClips)"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                           Icon="@SvgIcon.Cloud"
                           Class="bv-icon-only"
                           Title="Save to server">
                Save to server
            </ToolBarButton>
        }

        <ToolBarSpacer />

        @* The clip-browser / preview / timeline toggles that used to sit here were wired to
           parameters VideoEditor never passed, so every click invoked an empty delegate and the
           buttons rendered permanently "active". The panel they would have hidden no longer
           exists either. Removed with their parameters and LayoutService members rather than
           wired up: Camtasia has no such toggles, and the Media & Properties panel has its own
           close and reopen (2026-09-05 audit, F4). *@
        @* Labelled and allowed to collapse: this is the first thing to give up the bar when
           space runs out, and in the "…" menu a bare picture icon says nothing. *@
        <ToolBarButton OnClick="OnToggleAssetBrowserClicked"
                       Icon="@SvgIcon.Image"
                       FillMode="@(ShowAssetBrowser ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Flat)"
                       ThemeColor="@ThemeConstants.Button.ThemeColor.Base"
                       Class="@(ShowAssetBrowser ? "bv-toggle--active bv-icon-only" : "bv-icon-only")"
                       Title="Toggle asset browser (clipart, callouts, catalog)">
            Assets
        </ToolBarButton>
        @if (ShowPanel)
        {
            <ToolBarButton OnClick="OnTogglePanelClicked"
                           Icon="@SvgIcon.LayoutSideBySide"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                           FillMode="@ThemeConstants.Button.FillMode.Solid"
                           Overflow="@ToolBarItemOverflow.Never"
                           Title="Reopen Media &amp; Properties panel" />
        }
        @if (QueueCount > 0)
        {
            <ToolBarButton OnClick="OnToggleQueueClicked"
                           Icon="@SvgIcon.GridLayout"
                           FillMode="@ThemeConstants.Button.FillMode.Solid"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Info"
                           Overflow="@ToolBarItemOverflow.Never"
                           Title="@($"Export queue ({QueueCount} active)")">
                @QueueCount.ToString()
            </ToolBarButton>
        }
        <ToolBarButton OnClick="OnToggleFullscreenClicked"
                       Icon="@(IsFullscreen ? SvgIcon.FullscreenExit : SvgIcon.Fullscreen)"
                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                       Overflow="@ToolBarItemOverflow.Never"
                       Title="@(IsFullscreen ? "Exit fullscreen" : "Enter fullscreen")" />

        <!-- State / progress -->
        <ToolBarTemplateItem>
                <span class="@StatusCssClass" title="@StatusTooltip">
                    @StatusLabel
                </span>
                @if (Ffmpeg.State == FfmpegState.Processing)
                {
                    <TelerikProgressBar Value="@((double)Ffmpeg.ProgressPercent)"
                                        Max="100"
                                        Class="bv-toolbar__progress" />
                }
                else if (FfmpegStatusPresentation.IsBusyButNotProcessing(Ffmpeg.State, Ffmpeg.IsWorkerBusy))
                {
                    @* Item #71 — a lighter worker call (GetMetadataAsync/WriteFileAsync/etc, used
                       heavily by import) holds the phase-142 worker lock same as a full exec, but
                       never sets State to Processing and so never had a progress percent to show —
                       IsWorkerBusy is accurate for these too, just indeterminate rather than
                       determinate. Same bar/class treatment as a real Processing exec so both read
                       as one visual "busy" concept, not two different ones. *@
                    <TelerikProgressBar Indeterminate="true"
                                        Class="bv-toolbar__progress" />
                }
                else if (Ffmpeg.State == FfmpegState.LoadingCore && Ffmpeg.DownloadLabel is not null)
                {
                    @* Show determinate bar while downloading, indeterminate while initializing *@
                    <TelerikProgressBar Value="@GetDownloadPercent()"
                                        Max="100"
                                        Indeterminate="@(GetDownloadPercent() < 0)"
                                        Class="bv-toolbar__progress" />
                }
                @* The one control that gets the editor going again, next to the thing saying it
                   is stuck. Without it a wedge or a crash left the person with a red chip and no
                   action anywhere in the interface (2026-09-05 audit, F7). *@
                @if (ShowResetEngine)
                {
                    <TelerikButton OnClick="OnResetEngineClicked"
                                   Icon="@SvgIcon.ArrowRotateCw"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                                   Class="btn-sm text-nowrap"
                                   Title="Restart the video engine. Your project is untouched.">
                        Restart engine
                    </TelerikButton>
                }
        </ToolBarTemplateItem>

        @* Whatever the host wants beside its own status — the standalone editor puts its sign-in
           state here. The editor has no idea who is signed in and should not guess; it only leaves
           room. Without this the standalone host had no sign-in door at all, and the only way in
           was to know the /login URL and type it (2026-09-05 audit, F11). *@
        @if (HostStatusContent is not null)
        {
            <ToolBarTemplateItem>
                @HostStatusContent
            </ToolBarTemplateItem>
        }

        @* Phase 141 (flakiness investigation) — ffmpeg diagnostics chip: MEMFS residency, the
           operation trace and the raw log tail, one click away instead of only reachable by
           exporting the error log after the fact.

           Shown only where the host says so (VideoEditorOptions.ShowDiagnostics). It is an
           operator tool, and it was previously on the toolbar for every user regardless of who
           they were. *@
        @if (ShowDiagnostics)
        {
        <ToolBarTemplateItem>
            <button type="button"
                    class="bv-diagnostics-chip @(Ffmpeg.IsWorkerWedged ? "bv-diagnostics-chip--wedged" : $"bv-diagnostics-chip--{Ffmpeg.State.ToString().ToLowerInvariant()}")"
                    title="@(Ffmpeg.IsWorkerWedged ? "ffmpeg appears stuck — click to reset" : "ffmpeg diagnostics — click for details")"
                    @onclick="() => _showDiagnosticsPanel = true">
                @(Ffmpeg.IsWorkerWedged ? "⚠ Stuck — Reset?" : $"🩺 {DiagnosticsChipLabel()}")
            </button>
        </ToolBarTemplateItem>
        }

        @* Item #38 phase E — native sidecar status chip. Only shown when the host opted in
           (VideoEditorOptions.NativeSidecar); clicking it opens the pairing panel regardless of
           current state, so "how do I fix this" is always one click away. *@
        @if (ShowNativeSidecar)
        {
            <ToolBarTemplateItem>
                <button type="button"
                        class="bv-sidecar-chip bv-sidecar-chip--@NativeSidecar.State.ToString().ToLowerInvariant()"
                        title="Native acceleration status — click to manage"
                        @onclick="() => _showSidecarPanel = true">
                    @SidecarChipLabel()
                </button>
            </ToolBarTemplateItem>
        }

    </TelerikToolBar>

    @* The mark sits at the end of the bar rather than the start: the left edge is where the eye
       looks for the next action, and the logo does not need it. Sized in CSS so it can never
       grow the bar's height. *@
    <span class="bv-toolbar__mark" aria-hidden="true"></span>

    @if (ShowNativeSidecar)
    {
        <NativeSidecarPanel @bind-Visible="_showSidecarPanel" />
    }

    @if (ShowDiagnostics)
    {
        <DiagnosticsPanel @bind-Visible="_showDiagnosticsPanel" OnResetWorker="OnInitializeClicked" />
    }

    <!-- Feature badges — purely informational, so kept outside the ToolBar (whose
         ToolBarTemplateItem always behaves as Overflow=Never and can't collapse
         into the "..." popup) and hidden by CSS instead when space is tight. -->
    @if (ActiveFeatures.Any())
    {
        <div class="bv-toolbar__badges">
            @foreach (var badge in ActiveFeatures)
            {
                <span class="bv-feature-badge">@badge</span>
            }
        </div>
    }

    <!-- Hidden file input for JSON import -->
    <input @ref="_importFileInput"
           type="file"
           id="bv-import-json-input"
           accept=".benvideo,.json"
           class="bv-import-json-input"
           style="display:none"
           @onchange="OnImportFileSelectedAsync" />

</header>

@code {
    // Audit #4 — typed DOM helpers instead of eval'd source strings; every lookup is null-guarded
    // (see audit #7, where a missing element crashed the whole circuit).
    private IJSObjectReference? _dom;

    private async Task<IJSObjectReference> DomAsync() =>
        _dom ??= await JS.InvokeAsync<IJSObjectReference>(
            "benImportEditorModule", "js/domInterop.js");

    [Parameter] public bool HasClips            { get; set; }
    [Parameter] public bool ShowMultiTrack      { get; set; }
    [Parameter] public bool ShowAudioTracks     { get; set; }
    [Parameter] public bool ShowTransitions     { get; set; }
    [Parameter] public bool ShowTextOverlays    { get; set; }
    [Parameter] public bool   CanUndo           { get; set; }
    [Parameter] public bool   CanRedo           { get; set; }
    [Parameter] public string? UndoDescription  { get; set; }
    [Parameter] public string? RedoDescription  { get; set; }
    [Parameter] public bool ShowProjectPersistence { get; set; }
    /// <summary>When true, the Save button becomes a dropdown with "Save to Device" / "Save to Server".</summary>
    [Parameter] public bool ShowSaveToServer    { get; set; }
    [Parameter] public string ProjectName       { get; set; } = "project";

    [Parameter] public EventCallback OnInitialize { get; set; }
    [Parameter] public EventCallback OnOpen       { get; set; }
    [Parameter] public EventCallback OnPreview    { get; set; }
    [Parameter] public EventCallback OnExport     { get; set; }
    [Parameter] public EventCallback OnUndo       { get; set; }
    [Parameter] public EventCallback OnRedo       { get; set; }
    /// <summary>Fires when the user chooses "Save to Device" (or clicks Save when server save is not shown).</summary>
    [Parameter] public EventCallback OnSaveToDevice  { get; set; }
    /// <summary>Fires when the user chooses "Save to Server".</summary>
    [Parameter] public EventCallback OnSaveToServer  { get; set; }
    /// <summary>Backward-compat alias for OnSaveToDevice.</summary>
    [Parameter] public EventCallback OnSaveProject   { get; set; }
    /// <summary>
    /// Fires when the user chooses the File menu's "Save" item — persists into the in-app
    /// named-project list (ProjectStore, browser storage) so it shows up in "Open…", as
    /// distinct from <see cref="OnSaveToDevice"/>/<see cref="OnSaveProject"/> which download
    /// a project file to disk instead.
    /// </summary>
    [Parameter] public EventCallback OnSave          { get; set; }
    [Parameter] public EventCallback<ElementReference> OnOpenProject { get; set; }
    [Parameter] public int            QueueCount          { get; set; }
    [Parameter] public bool           HasSubtitles        { get; set; }
    [Parameter] public bool           ShowAssetBrowser    { get; set; }
    [Parameter] public bool           ShowPanel           { get; set; }
    [Parameter] public EventCallback OnToggleQueue        { get; set; }
    [Parameter] public EventCallback OnToggleAssetBrowser { get; set; }
    [Parameter] public EventCallback OnTogglePanel        { get; set; }
    [Parameter] public bool           IsFullscreen         { get; set; }
    [Parameter] public EventCallback OnToggleFullscreen    { get; set; }
    [Parameter] public EventCallback OnExportSrt          { get; set; }
    [Parameter] public EventCallback OnExportVtt          { get; set; }

    // ── Phase 39: File menu ───────────────────────────────────────────────────
    [Parameter] public bool     IsDirty              { get; set; }
    [Parameter] public bool     ShowErrorLog         { get; set; }
    [Parameter] public EventCallback                     OnNewProject       { get; set; }
    [Parameter] public EventCallback                     OnOpenProjectList  { get; set; }
    [Parameter] public EventCallback<ElementReference>   OnImportJson       { get; set; }
    [Parameter] public EventCallback                     OnExportJson       { get; set; }
    [Parameter] public EventCallback                     OnHelp             { get; set; }
    [Parameter] public EventCallback                     OnExportErrorLog   { get; set; }
    [Parameter] public EventCallback<string>             OnProjectNameChanged { get; set; }

    private ElementReference _importFileInput;

    private IEnumerable<string> ActiveFeatures
    {
        get
        {
            if (ShowMultiTrack)   yield return "Multi-Track";
            if (ShowAudioTracks)  yield return "Audio";
            if (ShowTransitions)  yield return "Transitions";
            if (ShowTextOverlays) yield return "Text";
        }
    }

    // Item #71 — decision logic lives in FfmpegStatusPresentation (pure, unit-tested) rather than
    // inline here; see that class's doc comment for the actual bug this phase fixes.
    private string StatusLabel => FfmpegStatusPresentation.Label(
        Ffmpeg.State, Ffmpeg.IsWorkerBusy, Ffmpeg.ProgressPercent, Ffmpeg.DownloadLabel,
        Ffmpeg.LastError, Ffmpeg.IsWorkerWedged);

    private string StatusCssClass =>
        $"bv-toolbar__status bv-status--{FfmpegStatusPresentation.CssModifier(Ffmpeg.State, Ffmpeg.IsWorkerBusy, Ffmpeg.IsWorkerWedged)}";

    private string StatusTooltip => FfmpegStatusPresentation.Tooltip(
        Ffmpeg.State, Ffmpeg.IsWorkerBusy, Ffmpeg.ProgressPercent, Ffmpeg.DownloadLabel,
        Ffmpeg.LastError, Ffmpeg.IsWorkerWedged);

    /// <summary>
    /// Whether to show the restart button beside the status chip — for everyone, not only for a
    /// host that switched diagnostics on (2026-09-05 audit, F7).
    /// </summary>
    private bool ShowResetEngine =>
        FfmpegStatusPresentation.ShouldOfferReset(Ffmpeg.State, Ffmpeg.IsWorkerWedged);

    private async Task OnResetEngineClicked() => await OnResetEngine.InvokeAsync();

    private async Task OnInitializeClicked() => await OnInitialize.InvokeAsync();
    private async Task OnOpenClicked()       => await OnOpen.InvokeAsync();
    private async Task OnPreviewClicked()    => await OnPreview.InvokeAsync();
    private async Task OnExportClicked()     => await OnExport.InvokeAsync();
    private async Task OnUndoClicked()       => await OnUndo.InvokeAsync();
    private async Task OnRedoClicked()       => await OnRedo.InvokeAsync();

    /// <summary>
    /// Parses the trailing percentage out of DownloadLabel (e.g. "Downloading core WASM (single-thread) 45%")
    /// Returns -1 when indeterminate (e.g. "Initializing…").
    /// </summary>
    private double GetDownloadPercent()
    {
        var label = Ffmpeg.DownloadLabel;
        if (label is null) return 0;
        var pctIdx = label.LastIndexOf('%');
        if (pctIdx > 0)
        {
            var spaceIdx = label.LastIndexOf(' ', pctIdx);
            if (spaceIdx >= 0 && double.TryParse(label.Substring(spaceIdx + 1, pctIdx - spaceIdx - 1), out var pct))
                return pct;
        }
        return -1; // indeterminate
    }

    private async Task OnSaveToDeviceClicked()
    {
        await OnSaveToDevice.InvokeAsync();
        if (!OnSaveToDevice.HasDelegate) await OnSaveProject.InvokeAsync(); // backward compat
    }
    private async Task OnSaveToServerClicked() => await OnSaveToServer.InvokeAsync();
    private async Task OnSaveClicked() => await OnSave.InvokeAsync();

    private async Task OnToggleAssetBrowserClicked()    => await OnToggleAssetBrowser.InvokeAsync();
    private async Task OnTogglePanelClicked()           => await OnTogglePanel.InvokeAsync();
    private async Task OnToggleQueueClicked()           => await OnToggleQueue.InvokeAsync();
    private async Task OnToggleFullscreenClicked()      => await OnToggleFullscreen.InvokeAsync();
    private async Task OnExportSrtClicked()             => await OnExportSrt.InvokeAsync();
    private async Task OnExportVttClicked()             => await OnExportVtt.InvokeAsync();

    // ── Phase 39: File menu handlers ──────────────────────────────────────────

    private async Task OnNewProjectClicked()         => await OnNewProject.InvokeAsync();
    private async Task OnOpenProjectListClicked()    => await OnOpenProjectList.InvokeAsync();
    private async Task OnExportJsonClicked()         => await OnExportJson.InvokeAsync();
    private async Task OnHelpClicked()               => await OnHelp.InvokeAsync();
    private async Task OnExportErrorLogClicked()     => await OnExportErrorLog.InvokeAsync();

    // ── Phase 141: ffmpeg diagnostics chip ───────────────────────────────────

    private bool _showDiagnosticsPanel;

    private string DiagnosticsChipLabel() => Ffmpeg.State switch
    {
        FfmpegState.Error => "Error",
        _ => FormatBytesShort(MemFs.TotalBytes),
    };

    private static string FormatBytesShort(long bytes) => bytes switch
    {
        < 1024 * 1024 => $"{bytes / 1024.0:0.#}KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#}MB",
    };

    private async Task OnImportJsonClicked()
    {
        await (await DomAsync()).InvokeVoidAsync("click", ".bv-import-json-input", true);
    }

    private async Task OnImportFileSelectedAsync()
    {
        await OnImportJson.InvokeAsync(_importFileInput);

        // Cleared so the same file can be picked again. A file input only raises change when the
        // selection differs, so choosing the same project twice — after a mistake, or to start
        // over — did nothing at all the second time (2026-09-05 audit, persistence-19).
        await (await DomAsync()).InvokeVoidAsync("clearFileInput", "bv-import-json-input");
    }

    private async Task OnOpenProjectClicked()
        => await (await DomAsync()).InvokeVoidAsync("click", "input[type=file][accept*=benvideo]", false);

    private async Task OnProjectFileSelectedAsync()
        => await OnOpenProject.InvokeAsync(_importFileInput); // legacy — fires import JSON path

    // ── Item #38 phase E: native sidecar status chip ────────────────────────

    [Parameter] public bool ShowNativeSidecar { get; set; }

    /// <summary>Whether the operator tools (diagnostics chip and panel) are shown at all.</summary>
    [Parameter] public bool ShowDiagnostics { get; set; }

    /// <summary>
    /// Whether there is anything worth saving — which is not the same question as whether there is
    /// a video clip on the timeline.
    /// </summary>
    [Parameter] public bool CanSave { get; set; }

    /// <summary>Restarts the video engine after a wedge or a crash.</summary>
    [Parameter] public EventCallback OnResetEngine { get; set; }

    /// <summary>Host chrome shown in the toolbar, such as a sign-in chip.</summary>
    [Parameter] public RenderFragment? HostStatusContent { get; set; }

    private bool _showSidecarPanel;

    protected override void OnInitialized()
    {
        NativeSidecar.OnChanged += OnNativeSidecarChanged;

        // This toolbar reads the ffmpeg state straight from the injected service — the status
        // chip, its progress bar, and the Enabled of Initialize/Open/Preview/Export all depend on
        // it — but nothing here re-renders when that state changes. The parent re-rendering is not
        // enough: Blazor skips a child whose parameters have not changed, and going from
        // Processing back to Ready changes none of this component's parameters.
        //
        // The result was a toolbar frozen mid-render: a chip stuck at "Processing… 33%" with
        // Export greyed out behind it, while the service had long since returned to Ready — a
        // stale paint, not a stalled render, and it survived until something else happened to
        // change a parameter.
        Ffmpeg.OnStateChanged += OnFfmpegStateChanged;

        if (ShowNativeSidecar) _ = NativeSidecar.ProbeAsync();
    }

    private void OnNativeSidecarChanged() => InvokeAsync(StateHasChanged);

    private void OnFfmpegStateChanged() => InvokeAsync(StateHasChanged);

    private string SidecarChipLabel() => NativeSidecar.State switch
    {
        NativeSidecarState.Paired => "⚡ Native",
        NativeSidecarState.FoundUnpaired => "⚡ Pair sidecar",
        NativeSidecarState.TokenRejected => "⚡ Re-pair sidecar",
        NativeSidecarState.Disconnected => "⚡ No sidecar",
        _ => "",
    };

    void IDisposable.Dispose()
    {
        NativeSidecar.OnChanged -= OnNativeSidecarChanged;
        Ffmpeg.OnStateChanged   -= OnFfmpegStateChanged;
    }

    /// <summary>Audit #4 — releases the cached domInterop handle. Separate from the sync
    /// <see cref="Dispose"/> above (which only unsubscribes events) because a JS module handle can
    /// only be released asynchronously; Blazor honours both interfaces on the same component.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_dom is null) return;
        try { await _dom.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
        _dom = null;
    }
}
