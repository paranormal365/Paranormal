@implements IDisposable
@inject ClipStore Clips
@inject MotionKeyframeService Motion
@inject PlaybackService Playback
@inject RichTextRunParserService RunParser
@inject GoogleFontService GoogleFontService
@using Ben.Video.Editor.Effects
@using Ben.Video.Editor.Services
@using EditorTools = Telerik.Blazor.Components.Editor

@if (Overlay is not null)
{
    <div class="bv-text-overlay-editor">

        <div class="bv-toe__header">
            <span class="bv-toe__title">T Text Overlay</span>
            <TelerikButton OnClick="Close"
                           Icon="@SvgIcon.X"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="Close" />
        </div>

        <!-- Text content (item #16 — inline runs: Bold/Underline/Sub/Superscript/Color per selection) -->
        <div class="bv-toe__field">
            <label class="bv-toe__label">Text</label>
            @* Committed as the editor reports a change, not on a button. The words a person
               typed used to sit in this field until Apply was pressed, and any of three
               high-frequency events could discard them first (2026-09-05 audit, titles-5). *@
            <TelerikEditor Value="@_richTextHtml"
                           ValueChanged="@((string v) => OnRichTextChangedAsync(v))"
                           Tools="@_editorTools"
                           Height="120px" />
        </div>

        <!-- Font family -->
        <div class="bv-toe__field">
            <label class="bv-toe__label">Font</label>
            <TelerikDropDownList Data="@_fontFamilies"
                                 Value="@_fontFamily"
                                 ValueChanged="@((string v) => OnFontFamilyChangedAsync(v))"
                                 ValueExpression="@(() => _fontFamily)"
                                 Width="100%" />
        </div>

        <!-- Font size -->
        <div class="bv-toe__field">
            <label class="bv-toe__label">
                Size &nbsp;<span class="bv-toe__value">@_fontSize pt</span>
                @if (_showingLiveValues)
                {
                    <span class="bv-toe__live-badge" title="This layer has a motion path — size below tracks the interpolated scale at the current playhead time, not a fixed value.">● Live</span>
                }
            </label>
            <TelerikSlider Value="@_fontSize"
                           ValueChanged="@((int v) => CommitFontSize(v))"
                           ValueExpression="@(() => _fontSize)"
                           Min="12"
                           Max="120"
                           SmallStep="2"
                           LargeStep="10"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(12, 120, 10)"
                           Width="100%" />
        </div>

        <!-- Font color -->
        <div class="bv-toe__field">
            <ColorPickerField Label="Font color"
                              Value="@ColorHelper.FromHex(_fontColor)"
                              ValueChanged="@OnFontColorChanged"
                              ShowAlpha="false" />
        </div>

        <!-- Background box -->
        <div class="bv-toe__field bv-toe__field--row">
            <label class="bv-toe__label">Background box</label>
            <input type="checkbox" checked="@_hasBox" @onchange="OnHasBoxChanged" />
        </div>
        @if (_hasBox)
        {
            <div class="bv-toe__field">
                <ColorPickerField Label="Box color + opacity"
                                  Value="@BoxColorToDouble()"
                                  ValueChanged="@OnBoxColorChanged"
                                  ShowAlpha="true" />
            </div>
        }

        <!-- Horizontal alignment -->
        <div class="bv-toe__field">
            <label class="bv-toe__label">Horizontal align</label>
            <TelerikDropDownList Data="@_hAligns"
                                 Value="@_hAlign"
                                 ValueChanged="@((TextHorizontalAlign v) => CommitHorizontalAlign(v))"
                                 ValueExpression="@(() => _hAlign)"
                                 Width="100%" />
        </div>

        <!-- Vertical alignment -->
        <div class="bv-toe__field">
            <label class="bv-toe__label">Vertical align</label>
            <TelerikDropDownList Data="@_vAligns"
                                 Value="@_vAlign"
                                 ValueChanged="@((TextVerticalAlign v) => CommitVerticalAlign(v))"
                                 ValueExpression="@(() => _vAlign)"
                                 Width="100%" />
        </div>

        <!-- Offsets -->
        <div class="bv-toe__field bv-toe__field--two-col">
            <div>
                <label class="bv-toe__label">X offset <span class="bv-toe__value">@_offsetX px</span></label>
                <TelerikNumericTextBox Value="@_offsetX" ValueChanged="@((int v) => CommitOffsetX(v))" ValueExpression="@(() => _offsetX)" Min="0" Max="1920" Width="100%" />
            </div>
            <div>
                <label class="bv-toe__label">Y offset <span class="bv-toe__value">@_offsetY px</span></label>
                <TelerikNumericTextBox Value="@_offsetY" ValueChanged="@((int v) => CommitOffsetY(v))" ValueExpression="@(() => _offsetY)" Min="0" Max="1080" Width="100%" />
            </div>
        </div>

        @if (_showingLiveValues)
        {
            <div class="bv-toe__field">
                <label class="bv-toe__label">
                    Position <span class="bv-toe__live-badge" title="This layer has a motion path — position is driven entirely by the interpolated value at the current playhead time, not the alignment/offset fields above.">● Live</span>
                    &nbsp;<span class="bv-toe__value">X @((_liveX * 100).ToString("F0"))% Y @((_liveY * 100).ToString("F0"))%</span>
                </label>
            </div>
        }
        else if (Overlay?.OverrideX is not null || Overlay?.OverrideY is not null)
        {
            <div class="bv-toe__field">
                <TelerikButton OnClick="ResetPosition"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Size="@ThemeConstants.Button.Size.Small"
                               Title="Position was set by dragging on the preview — clear it and go back to alignment + offsets above">
                    Reset position
                </TelerikButton>
            </div>
        }

        @* ── Wrapping and opacity ────────────────────────────────────────────── *@
        <div class="bv-toe__field bv-toe__field--row">
            <label class="bv-toe__label"
                   title="Break long lines instead of running off the sides of the frame">
                Wrap long lines
            </label>
            <input type="checkbox" checked="@(_maxWidth is not null)" @onchange="OnWrapChanged" />
        </div>
        @if (_maxWidth is { } width)
        {
            <div class="bv-toe__field">
                <label class="bv-toe__label">
                    Line width &nbsp;<span class="bv-toe__value">@((width * 100).ToString("F0"))% of frame</span>
                </label>
                <TelerikSlider Value="@width"
                               ValueChanged="@((double v) => CommitMaxWidth(v))"
                               ValueExpression="@(() => width)"
                               Min="0.2" Max="1.0" SmallStep="0.05" LargeStep="0.2" Width="100%"
                               LabelTemplate="@SliderLabelTemplates.Endpoints(0.2, 1.0, 0.2)" />
            </div>
        }

        <div class="bv-toe__field">
            <label class="bv-toe__label">Opacity &nbsp;<span class="bv-toe__value">@((_opacity * 100).ToString("F0"))%</span></label>
            <TelerikSlider Value="@_opacity"
                           ValueChanged="@((double v) => CommitOpacity(v))"
                           ValueExpression="@(() => _opacity)"
                           Min="0.0" Max="1.0" SmallStep="0.05" LargeStep="0.25" Width="100%"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 1.0, 0.25)" />
        </div>

        <!-- Timeline position / duration -->
        <div class="bv-toe__field">
            <label class="bv-toe__label">
                Start &nbsp;<span class="bv-toe__value">@FormatTime(_position)</span>
            </label>
            <TelerikSlider Value="@_position"
                           ValueChanged="@((double v) => CommitPosition(v))"
                           ValueExpression="@(() => _position)"
                           Min="0.0"
                           Max="@_maxPosition"
                           SmallStep="0.1"
                           LargeStep="1.0"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, _maxPosition, 1.0)"
                           Width="100%" />
        </div>
        <div class="bv-toe__field">
            <label class="bv-toe__label">
                Duration &nbsp;<span class="bv-toe__value">@FormatTime(_duration)</span>
            </label>
            <TelerikSlider Value="@_duration"
                           ValueChanged="@((double v) => CommitDuration(v))"
                           ValueExpression="@(() => _duration)"
                           Min="0.5"
                           Max="@_maxDuration"
                           SmallStep="0.1"
                           LargeStep="1.0"
                           LabelTemplate="@SliderLabelTemplates.Endpoints(0.5, _maxDuration, 1.0)"
                           Width="100%" />
        </div>

        <!-- Fade -->
        <div class="bv-toe__field bv-toe__field--two-col">
            <div>
                <label class="bv-toe__label">Fade in <span class="bv-toe__value">@_fadeIn.ToString("F1")s</span></label>
                <TelerikSlider Value="@_fadeIn" ValueChanged="@((double v) => CommitFadeIn(v))" ValueExpression="@(() => _fadeIn)" Min="0.0" Max="2.0" SmallStep="0.1" LargeStep="0.5" Width="100%" LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 2.0, 0.5)" />
            </div>
            <div>
                <label class="bv-toe__label">Fade out <span class="bv-toe__value">@_fadeOut.ToString("F1")s</span></label>
                <TelerikSlider Value="@_fadeOut" ValueChanged="@((double v) => CommitFadeOut(v))" ValueExpression="@(() => _fadeOut)" Min="0.0" Max="2.0" SmallStep="0.1" LargeStep="0.5" Width="100%" LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 2.0, 0.5)" />
            </div>
        </div>

        <!-- Shadow -->
        <div class="bv-toe__section">
            Shadow
            @if (_showingLiveValues)
            {
                <span class="bv-toe__live-badge" title="This layer has a motion path — shadow below tracks the interpolated value at the current playhead time, not a fixed value.">● Live</span>
            }
        </div>
        <div class="bv-toe__field">
            <ColorPickerField Label="Shadow colour" Value="_shadowColor"
                              ValueChanged="@(v => CommitShadowColor(v))"
                              ShowAlpha="true" />
        </div>
        <div class="bv-toe__field bv-toe__field--two-col">
            <div>
                <label class="bv-toe__label">Offset X <span class="bv-toe__value">@_shadowOffsetX</span></label>
                <TelerikSlider Value="@_shadowOffsetX" ValueChanged="@((double v) => CommitShadowOffsetX(v))" ValueExpression="@(() => _shadowOffsetX)" Min="-30" Max="30" SmallStep="1" LargeStep="5" Width="100%" LabelTemplate="@SliderLabelTemplates.Endpoints(-30.0, 30.0, 5.0)" />
            </div>
            <div>
                <label class="bv-toe__label">Offset Y <span class="bv-toe__value">@_shadowOffsetY</span></label>
                <TelerikSlider Value="@_shadowOffsetY" ValueChanged="@((double v) => CommitShadowOffsetY(v))" ValueExpression="@(() => _shadowOffsetY)" Min="-30" Max="30" SmallStep="1" LargeStep="5" Width="100%" LabelTemplate="@SliderLabelTemplates.Endpoints(-30.0, 30.0, 5.0)" />
            </div>
        </div>
        <div class="bv-toe__field">
            <label class="bv-toe__label">Blur <span class="bv-toe__value">@_shadowBlur px</span></label>
            <TelerikSlider Value="@_shadowBlur" ValueChanged="@((double v) => CommitShadowBlur(v))" ValueExpression="@(() => _shadowBlur)" Min="0" Max="30" SmallStep="1" LargeStep="5" Width="100%" LabelTemplate="@SliderLabelTemplates.Endpoints(0.0, 30.0, 5.0)" />
        </div>

        <!-- Actions -->
        <div class="bv-toe__actions">
            <TelerikButton OnClick="OnAnimateClicked"
                           Icon="@SvgIcon.MapMarker"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Size="@ThemeConstants.Button.Size.Small"
                           Title="Animate this layer — add motion keyframes for position, scale, opacity">
                ⏱ Animate
            </TelerikButton>
            <TelerikButton OnClick="Remove"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Size="@ThemeConstants.Button.Size.Small">
                Remove
            </TelerikButton>
        </div>

    </div>
}

@code {
    [Parameter] public TextOverlay?  Overlay    { get; set; }
    [Parameter] public EventCallback OnClose    { get; set; }
    [Parameter] public EventCallback OnRemoved  { get; set; }
    [Parameter] public EventCallback<(Guid Id, string Type)> OnAnimate { get; set; }

    private async Task OnAnimateClicked()
    {
        if (Overlay is not null)
            await OnAnimate.InvokeAsync((Overlay.Id, "TextOverlay"));
    }

    // ── Field state ──────────────────────────────────────────────────────────

    private string                _text         = string.Empty;
    private string                _richTextHtml = string.Empty;
    private string               _fontFamily = "Arial";
    private int                  _fontSize   = 48;
    private string               _fontColor  = "#FFFFFF";
    private bool                 _hasBox;
    private string               _boxColor   = "#000000";
    private double               _boxOpacity = 0.5;
    private double?              _maxWidth;
    private double               _opacity    = 1.0;
    private TextHorizontalAlign  _hAlign     = TextHorizontalAlign.Center;
    private TextVerticalAlign    _vAlign     = TextVerticalAlign.Bottom;
    private int                  _offsetX;
    private int                  _offsetY    = 40;
    private double               _position;
    private double               _duration   = 5.0;
    private double               _fadeIn     = 0.3;
    private double               _fadeOut    = 0.3;
    private double                _shadowColor   = ColorHelper.Pack(0, 0, 0, 120);
    private double                _shadowOffsetX = 3.0;
    private double                _shadowOffsetY = 3.0;
    private double                _shadowBlur    = 4.0;

    private double _maxPosition = 60.0;
    private double _maxDuration = 60.0;

    private bool   _showingLiveValues;
    private double _liveX;
    private double _liveY;

    // Item #16, phase 116 — system fonts first, then the curated Google Fonts list.
    private static readonly IReadOnlyList<string> _fontFamilies =
        [.. StandardFonts.Names, .. GoogleFonts.Names];

    // Item #16 — inline formatting toolbar. Font family/size stay whole-block, governed by the
    // dropdown/slider above; this restricted tool set covers only what a TextRun can express.
    private static readonly List<IEditorTool> _editorTools =
    [
        new EditorTools.Bold(), new EditorTools.Underline(),
        new EditorTools.SubScript(), new EditorTools.SuperScript(),
        new EditorTools.ForeColor(),
    ];

    private static readonly List<TextHorizontalAlign> _hAligns =
        Enum.GetValues<TextHorizontalAlign>().ToList();

    private static readonly List<TextVerticalAlign> _vAligns =
        Enum.GetValues<TextVerticalAlign>().ToList();

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        Clips.OnChange          += RefreshAndRender;
        Motion.OnChanged        += RefreshAndRender;
        Playback.OnStateChanged += RefreshAndRender;
    }

    protected override void OnParametersSet() => RefreshFromSource();

    private void RefreshAndRender()
    {
        RefreshFromSource();
        StateHasChanged();
    }

    // Item #64 — this panel is an edit-then-click-Apply design (unlike CalloutEditor's per-field
    // auto-commit), so it holds locally-edited, not-yet-committed field values between renders.
    // RefreshFromSource used to overwrite all of them unconditionally on every call, but it's
    // wired to three external, high-frequency event sources below (Clips.OnChange fires on any
    // mutation anywhere in the whole project; Playback.OnStateChanged fires every frame during
    // normal playback) — any of them firing while an edit was pending silently discarded it
    // before Apply could ever run. Same bug class as TransitionEditor.OnParametersSet (phase
    // 132); fixed the same way — only reload the editable fields when a *different* overlay is
    // now selected, tracked by Id.
    private Guid? _lastOverlayId;

    private void RefreshFromSource()
    {
        if (Overlay is null) return;

        if (Overlay.Id != _lastOverlayId)
        {
            _lastOverlayId = Overlay.Id;

            _text       = Overlay.Text;
            _fontFamily = Overlay.FontFamily;
            // Reopening a project that already used a Google Font — make sure it's actually
            // loaded so the live preview doesn't silently fall back to the browser's default
            // font. No-op for a system font (EnsureLoadedAsync checks IsGoogleFont itself).
            _ = GoogleFontService.EnsureLoadedAsync(_fontFamily);
            _fontSize   = Overlay.FontSize;
            _fontColor  = Overlay.FontColor;
            _richTextHtml = TextRun.ToHtml(EffectiveRuns(Overlay));
            _hasBox     = Overlay.BoxColor is not null;
            _hAlign     = Overlay.HorizontalAlign;
            _vAlign     = Overlay.VerticalAlign;
            _maxWidth   = Overlay.MaxWidth;
            _opacity    = Overlay.Opacity;
            _offsetX    = Overlay.OffsetX;
            _offsetY    = Overlay.OffsetY;
            _position   = Overlay.TimelinePosition;
            _duration   = Overlay.Duration;
            _fadeIn     = Overlay.FadeInSeconds;
            _fadeOut    = Overlay.FadeOutSeconds;
            _shadowColor   = Overlay.ShadowColor;
            _shadowOffsetX = Overlay.ShadowOffsetX;
            _shadowOffsetY = Overlay.ShadowOffsetY;
            _shadowBlur    = Overlay.ShadowBlur;

            if (Overlay.BoxColor is not null)
            {
                // Parse "#rrggbb@opacity" format stored by the model
                var parts = Overlay.BoxColor.Split('@');
                _boxColor   = parts[0];
                _boxOpacity = parts.Length > 1 && double.TryParse(
                    parts[1], System.Globalization.NumberStyles.Float,
                    System.Globalization.CultureInfo.InvariantCulture, out var op) ? op : 0.5;
            }
        }

        // Slider bounds only — always safe to refresh live, never discards a pending edit.
        var totalDur   = Clips.TotalDuration;
        _maxPosition   = totalDur > 0 ? totalDur : 60.0;
        _maxDuration   = totalDur > 0 ? totalDur : 60.0;

        _showingLiveValues = Motion.HasPath(Overlay.Id);
        if (_showingLiveValues)
        {
            var frame = Motion.Evaluate(Overlay.Id, Playback.State.CurrentTime)
                ?? new MotionFrame(Overlay.OverrideX ?? 0.5, Overlay.OverrideY ?? 0.5, 1.0, 1.0);
            var effective = ExportArgBuilders.ApplyMotionFrame(Overlay, frame);
            _liveX = effective.OverrideX ?? frame.X;
            _liveY = effective.OverrideY ?? frame.Y;
            _fontSize      = effective.FontSize;
            _shadowColor   = effective.ShadowColor;
            _shadowOffsetX = effective.ShadowOffsetX;
            _shadowOffsetY = effective.ShadowOffsetY;
            _shadowBlur    = effective.ShadowBlur;
        }
    }

    public void Dispose()
    {
        Clips.OnChange          -= RefreshAndRender;
        Motion.OnChanged        -= RefreshAndRender;
        Playback.OnStateChanged -= RefreshAndRender;
    }

    // ── Box colour helpers (ColorPickerField ↔ internal _boxColor/_boxOpacity) ──

    private void OnFontColorChanged(double val)
    {
        var (r, g, b, _) = ColorHelper.Unpack(val);
        _fontColor = $"#{r:X2}{g:X2}{b:X2}";

        var was   = Overlay?.FontColor;
        var value = _fontColor;
        Commit("font colour", o => o.FontColor = value, o => o.FontColor = was!);
    }

    private double BoxColorToDouble()
    {
        // Combine hex colour + opacity into a single ARGB packed double
        byte a = (byte)Math.Round(_boxOpacity * 255);
        var packed = ColorHelper.FromHex(_boxColor);
        var (r, g, b, _) = ColorHelper.Unpack(packed);
        return ColorHelper.Pack(r, g, b, a);
    }

    private void OnBoxColorChanged(double val)
    {
        var (r, g, b, a) = ColorHelper.Unpack(val);
        _boxColor   = $"#{r:X2}{g:X2}{b:X2}";
        _boxOpacity = a / 255.0;
        CommitBoxColor();
    }

    // ── Actions ──────────────────────────────────────────────────────────────

    /// <summary>Item #16 — the runs source of truth for the editor's rich-text HTML: the overlay's
    /// own <see cref="TextOverlay.Runs"/> when set, else a synthetic single-run list built from the
    /// legacy whole-block fields, so old saved content still displays its existing Bold/Underline
    /// the first time it's reopened in the new toolbar-based editor.</summary>
    private static List<TextRun> EffectiveRuns(TextOverlay overlay) =>
        overlay.Runs is { Count: > 0 } runs
            ? runs
            : [new TextRun { Text = overlay.Text, Bold = overlay.FontBold, Underline = overlay.FontUnderline }];

    // ── Committing ───────────────────────────────────────────────────────────
    //
    // Every field goes through Commit, which is what the callout and clip-art panels have always
    // done. This panel used to hold a whole set of locally-edited values and write them only when
    // Apply was pressed, which caused two separate problems: nothing a person did to a title could
    // be undone (titles-4), and any of three high-frequency events — a project mutation anywhere,
    // a keyframe change, a playback tick — refreshed the panel and silently discarded whatever was
    // typed but not yet applied (titles-5). Both were listed in the 2026-09-05 audit.

    /// <summary>Applies one change to the selected title, undoably.</summary>
    /// <remarks>
    /// The revert closure captures the value that was there before, so undo puts back exactly that
    /// rather than the panel's idea of it — the panel may have been refreshed since.
    /// </remarks>
    private void Commit(string propertyPath, Action<TextOverlay> apply, Action<TextOverlay> revert)
    {
        if (Overlay is null) return;
        Clips.CommitTextOverlayUpdate(Overlay.Id, propertyPath, apply, revert);
    }

    private async Task OnRichTextChangedAsync(string html)
    {
        _richTextHtml = html;
        if (Overlay is null) return;

        var runs      = await RunParser.HtmlToRunsAsync(html);
        var plainText = string.Concat(runs.Select(r => r.Text));
        var name      = string.IsNullOrWhiteSpace(plainText)
            ? "Text"
            : plainText[..Math.Min(plainText.Length, 20)];

        var (wasText, wasRuns, wasName) = (Overlay.Text, Overlay.Runs, Overlay.Name);

        Commit("text",
            o => { o.Text = plainText; o.Runs = runs; o.Name = name; },
            o => { o.Text = wasText;   o.Runs = wasRuns; o.Name = wasName; });
    }

    private async Task OnFontFamilyChangedAsync(string family)
    {
        _fontFamily = family;
        // A Google font has to be fetched before the live preview can draw with it; a system font
        // makes this a no-op.
        await GoogleFontService.EnsureLoadedAsync(family);

        var was = Overlay?.FontFamily;
        Commit("font", o => o.FontFamily = family, o => o.FontFamily = was!);
    }

    private void CommitFontSize(int size)
    {
        _fontSize = size;
        var was = Overlay?.FontSize ?? size;
        Commit("size", o => o.FontSize = size, o => o.FontSize = was);
    }

    private void CommitHorizontalAlign(TextHorizontalAlign align)
    {
        _hAlign = align;
        var was = Overlay?.HorizontalAlign ?? align;
        Commit("horizontal alignment", o => o.HorizontalAlign = align, o => o.HorizontalAlign = was);
    }

    private void CommitVerticalAlign(TextVerticalAlign align)
    {
        _vAlign = align;
        var was = Overlay?.VerticalAlign ?? align;
        Commit("vertical alignment", o => o.VerticalAlign = align, o => o.VerticalAlign = was);
    }

    private void CommitOffsetX(int value)
    {
        _offsetX = value;
        var was = Overlay?.OffsetX ?? value;
        Commit("X offset", o => o.OffsetX = value, o => o.OffsetX = was);
    }

    private void CommitOffsetY(int value)
    {
        _offsetY = value;
        var was = Overlay?.OffsetY ?? value;
        Commit("Y offset", o => o.OffsetY = value, o => o.OffsetY = was);
    }

    private void CommitPosition(double value)
    {
        _position = value;
        var was = Overlay?.TimelinePosition ?? value;
        Commit("start", o => o.TimelinePosition = value, o => o.TimelinePosition = was);
    }

    private void CommitDuration(double value)
    {
        _duration = value;
        var was = Overlay?.Duration ?? value;
        Commit("duration", o => o.Duration = value, o => o.Duration = was);
    }

    private void CommitFadeIn(double value)
    {
        _fadeIn = value;
        var was = Overlay?.FadeInSeconds ?? value;
        Commit("fade in", o => o.FadeInSeconds = value, o => o.FadeInSeconds = was);
    }

    private void CommitFadeOut(double value)
    {
        _fadeOut = value;
        var was = Overlay?.FadeOutSeconds ?? value;
        Commit("fade out", o => o.FadeOutSeconds = value, o => o.FadeOutSeconds = was);
    }

    private void CommitShadowColor(double value)
    {
        _shadowColor = value;
        var was = Overlay?.ShadowColor ?? value;
        Commit("shadow colour", o => o.ShadowColor = value, o => o.ShadowColor = was);
    }

    private void CommitShadowOffsetX(double value)
    {
        _shadowOffsetX = value;
        var was = Overlay?.ShadowOffsetX ?? value;
        Commit("shadow offset", o => o.ShadowOffsetX = value, o => o.ShadowOffsetX = was);
    }

    private void CommitShadowOffsetY(double value)
    {
        _shadowOffsetY = value;
        var was = Overlay?.ShadowOffsetY ?? value;
        Commit("shadow offset", o => o.ShadowOffsetY = value, o => o.ShadowOffsetY = was);
    }

    private void CommitShadowBlur(double value)
    {
        _shadowBlur = value;
        var was = Overlay?.ShadowBlur ?? value;
        Commit("shadow blur", o => o.ShadowBlur = value, o => o.ShadowBlur = was);
    }

    /// <summary>
    /// Turns wrapping on at a sensible width, or off entirely.
    /// </summary>
    /// <remarks>
    /// 80% of the frame when first switched on: wide enough that a short title is unaffected,
    /// narrow enough that the wrap is visibly doing something.
    /// </remarks>
    private void OnWrapChanged(ChangeEventArgs e)
    {
        var on  = e.Value is true;
        var was = Overlay?.MaxWidth;
        _maxWidth = on ? was ?? 0.8 : null;

        var value = _maxWidth;
        Commit("line width", o => o.MaxWidth = value, o => o.MaxWidth = was);
    }

    private void CommitMaxWidth(double value)
    {
        _maxWidth = value;
        var was = Overlay?.MaxWidth;
        Commit("line width", o => o.MaxWidth = value, o => o.MaxWidth = was);
    }

    private void CommitOpacity(double value)
    {
        _opacity = value;
        var was = Overlay?.Opacity ?? value;
        Commit("opacity", o => o.Opacity = value, o => o.Opacity = was);
    }

    private void OnHasBoxChanged(ChangeEventArgs e)
    {
        _hasBox = e.Value is true;
        CommitBoxColor();
    }

    private void CommitBoxColor()
    {
        var was   = Overlay?.BoxColor;
        var value = _hasBox
            ? $"{_boxColor}@{_boxOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}"
            : null;

        Commit("background box", o => o.BoxColor = value, o => o.BoxColor = was);
    }

    /// <summary>Clears a drag-set on-canvas position, reverting to alignment + offsets.</summary>
    private void ResetPosition()
    {
        if (Overlay is null) return;
        var (wasX, wasY) = (Overlay.OverrideX, Overlay.OverrideY);

        Commit("position",
            o => { o.OverrideX = null; o.OverrideY = null; },
            o => { o.OverrideX = wasX; o.OverrideY = wasY; });
    }

    private async Task Remove()
    {
        if (Overlay is null) return;
        Clips.RemoveTextOverlay(Overlay.Id);
        await OnRemoved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private static string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? ts.ToString(@"h\:mm\:ss")
            : ts.ToString(@"m\:ss\.f");
    }
}
