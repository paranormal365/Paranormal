@using Ben.Video.Core.Services
@inject ProjectStore Store
@inject IJSRuntime JS

@if (Visible)
{
    <TelerikWindow Visible="true"
                   VisibleChanged="@(async v => { if (!v) await Close(); })"
                   Width="560px"
                   Height="440px"
                   Modal="true"
                   Draggable="true"
                   Resizable="true"
                   Class="bv-proj-dialog">
        <WindowTitle>Open Project</WindowTitle>
        <WindowContent>
            @if (_state.Error is not null)
            {
                @* Audit #6 — ProjectStore logs to the diagnostics panel, which a user may never
                   open. A failed delete/rename previously looked like nothing happened at all. *@
                <div class="bv-proj-dialog__error" role="alert">⚠ @_state.Error</div>
            }

            @if (!Store.Projects.Any())
            {
                <div class="bv-proj-dialog__empty">
                    <p>No saved projects yet.</p>
                    <p>Use <strong>File → Save</strong> to save the current session.</p>
                </div>
            }
            else
            {
                <TelerikGrid Data="@Store.Projects"
                             Height="100%"
                             Sortable="true"
                             Resizable="true"
                             Class="bv-proj-grid">
                    <GridColumns>
                        <GridColumn Field="@nameof(ProjectSummary.Name)"
                                    Title="Name"
                                    Editable="true">
                            <Template>
                                @{
                                    var row = (ProjectSummary)context;
                                    @if (_state.IsEditing(row.Id))
                                    {
                                        <input class="bv-proj-name-input"
                                               type="text"
                                               @bind="_state.EditingName"
                                               @bind:event="oninput"
                                               @onblur="CommitRename"
                                               @onkeydown="OnRenameKeyDown"
                                               @onclick:stopPropagation />
                                    }
                                    else
                                    {
                                        <span class="bv-proj-name"
                                              @ondblclick="() => StartRename(row)"
                                              title="Double-click to rename">
                                            @row.Name
                                        </span>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        @* Bound to the real date and the real byte count, displayed through a
                           template. Bound to the formatted strings, the grid sorted them as text:
                           "9 Jan" came after "10 Feb", and 9 KB came after 10 MB — so the sort
                           controls were there and gave the wrong order (2026-09-05 audit,
                           persistence-20). *@
                        <GridColumn Field="@nameof(ProjectSummary.UpdatedAt)"
                                    Title="Saved"
                                    Width="160px">
                            <Template>
                                @((context as ProjectSummary)?.FormattedDate)
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProjectSummary.SizeBytes)"
                                    Title="Size"
                                    Width="90px">
                            <Template>
                                @((context as ProjectSummary)?.FormattedSize)
                            </Template>
                        </GridColumn>
                        <GridColumn Title="" Width="130px">
                            <Template>
                                @{
                                    var row = (ProjectSummary)context;
                                    <div class="bv-proj-actions">
                                        <TelerikButton OnClick="() => OpenProject(row)"
                                                       ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                       Size="@ThemeConstants.Button.Size.Small">
                                            Open
                                        </TelerikButton>
                                        @* Audit #5 — deleting a project is the one destructive
                                           action in the editor with NO undo path: it is a
                                           localStorage removeItem, not a ClipStore command, so a
                                           misclick permanently destroys saved work. (Clip removal
                                           deliberately has no confirm — that one IS undoable.)
                                           Inline two-step rather than a nested dialog: item #68
                                           established that a TelerikWindow inside a TelerikWindow
                                           has real footer-positioning quirks here. *@
                                        @if (_state.IsConfirmingDelete(row.Id))
                                        {
                                            <TelerikButton OnClick="() => DeleteProject(row)"
                                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                           Size="@ThemeConstants.Button.Size.Small"
                                                           Title="@($"Permanently delete \"{row.Name}\" — this cannot be undone")">
                                                Delete?
                                            </TelerikButton>
                                            <TelerikButton OnClick="_state.CancelDelete"
                                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                           Size="@ThemeConstants.Button.Size.Small"
                                                           Title="Keep this project">
                                                No
                                            </TelerikButton>
                                        }
                                        else
                                        {
                                            <TelerikButton OnClick="() => _state.AskToDelete(row.Id)"
                                                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                                                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                           Size="@ThemeConstants.Button.Size.Small"
                                                           Icon="@SvgIcon.Trash"
                                                           Title="Delete" />
                                        }
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </TelerikGrid>
            }
        </WindowContent>
        <WindowFooter>
            <TelerikButton OnClick="Close"
                           Size="@ThemeConstants.Button.Size.Small">
                Cancel
            </TelerikButton>
        </WindowFooter>
    </TelerikWindow>
}

@code {
    [Parameter] public bool                    Visible          { get; set; }
    [Parameter] public EventCallback<bool>     VisibleChanged   { get; set; }
    [Parameter] public EventCallback<ProjectSummary> OnOpen     { get; set; }

    /// <summary>
    /// Rename, confirm-delete and the error line, as a machine that can be asked whether a delete
    /// is possible without clicking one (2026-09-05 audit, phase 11).
    /// </summary>
    private readonly ProjectsDialogState _state = new();

    private IJSObjectReference? _dom;

    private async Task<IJSObjectReference> DomAsync() =>
        _dom ??= await JS.InvokeAsync<IJSObjectReference>(
            "benImportEditorModule", "js/domInterop.js");

    /// <summary>
    /// Opens the rename box on a row and puts the cursor in it.
    /// </summary>
    /// <remarks>
    /// Double-clicking the name produced a box nothing was focused in, so the first thing typed
    /// went to the page instead of the field and the Enter that followed did nothing — the rename
    /// looked broken until you noticed you had to click the box you had just opened. Same
    /// focus-and-select the marker and track renames have always done.
    /// </remarks>
    private void StartRename(ProjectSummary row)
    {
        _state.StartRename(row.Id, row.Name);

        InvokeAsync(async () =>
        {
            StateHasChanged();
            try
            {
                await (await DomAsync()).InvokeVoidAsync("focusAndSelect", ".bv-proj-name-input");
            }
            catch (JSDisconnectedException) { /* the dialog closed while we were asking */ }
            catch (ObjectDisposedException) { }
        });
    }

    private async Task CommitRename()
    {
        if (_state.CommitRename() is not { } rename) return;

        try
        {
            _state.ClearError();
            await Store.RenameAsync(rename.Id, rename.Name);
        }
        catch (Exception ex)
        {
            _state.Failed($"Couldn't rename that project: {ex.Message}");
        }
    }

    private async Task OnRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")  await CommitRename();
        if (e.Key == "Escape") _state.CancelRename();
    }

    private async Task OpenProject(ProjectSummary row)
    {
        await OnOpen.InvokeAsync(row);
        await Close();
    }

    private async Task DeleteProject(ProjectSummary row)
    {
        // Only ever the row that was asked about: deleting a saved project is a localStorage
        // removeItem, not a ClipStore command, so there is no undo waiting behind a misclick.
        if (!_state.ConfirmDelete(row.Id)) return;

        try
        {
            await Store.DeleteAsync(row.Id);
        }
        catch (Exception ex)
        {
            // Without this the row would simply stay in the list with no explanation — the exact
            // silent-failure shape audit #6 flagged.
            _state.Failed($"Couldn't delete \"{row.Name}\": {ex.Message}");
        }
    }

    private async Task Close()
    {
        // Don't let a pending "Delete?" or a stale error survive into the next time this opens.
        _state.Reset();
        await VisibleChanged.InvokeAsync(false);
    }
}
