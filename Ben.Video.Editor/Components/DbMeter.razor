@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="bv-db-meter" @ref="_container" title="Audio level meter (L / R)">
    <canvas @ref="_canvas"
            class="bv-db-meter__canvas"
            width="@CanvasWidth"
            height="@CanvasHeight"
            aria-label="dB level meter (L / R)" />
</div>

@code {

    // ── Parameters ───────────────────────────────────────────────────────────

    /// <summary>CSS selector or element id of the &lt;video&gt; element to analyse.</summary>
    [Parameter, EditorRequired] public string VideoElementId { get; set; } = string.Empty;

    [Parameter] public int CanvasWidth  { get; set; } = 28;
    [Parameter] public int CanvasHeight { get; set; } = 140;

    // ── State ─────────────────────────────────────────────────────────────────

    private ElementReference       _container;
    private ElementReference       _canvas;
    private IJSObjectReference?    _module;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(VideoElementId)) return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/_content/Ben.Video.Editor/js/dbMeter.js");

        await _module.InvokeVoidAsync("init", _canvas, VideoElementId);
    }

    // ── Public: start/stop called by VideoPreview when playback state changes ─

    public async Task ResumeAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("resume", _canvas);
    }

    public async Task SuspendAsync()
    {
        if (_module is null) return;
        await _module.InvokeVoidAsync("suspend", _canvas);
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", _canvas); } catch { /* context gone */ }
            await _module.DisposeAsync();
        }
    }
}
