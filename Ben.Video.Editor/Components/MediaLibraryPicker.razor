@inject IMediaLibraryProvider Library
@inject FfmpegService Ffmpeg
@inject SidecarMediaProbe SidecarMedia
@inject OPFSService OPFS
@inject SourceMounter Mounter
@inject ClipStore Clips
@inject Microsoft.Extensions.Options.IOptions<VideoEditorOptions> EditorOptions

<TelerikWindow Visible="@Visible"
               VisibleChanged="@OnVisibleChanged"
               Width="780px"
               Height="580px"
               Modal="true">
    <WindowTitle>Media Library</WindowTitle>
    <WindowContent>
        <div class="bv-media-picker">

            @* ── Toolbar ──────────────────────────────────────────────────── *@
            <div class="bv-media-picker__toolbar">
                <TelerikTextBox @bind-Value="_search"
                                PlaceHolder="Search files…"
                                Class="bv-media-picker__search" />
                <TelerikButton OnClick="LoadAsync"
                               Icon="@SvgIcon.ArrowRotateCw"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Refresh library" />
            </div>

            @* ── State views ─────────────────────────────────────────────── *@
            @if (_loading)
            {
                <div class="bv-media-picker__state">
                    <TelerikLoader Type="@LoaderType.InfiniteSpinner"
                                   Size="@ThemeConstants.Loader.Size.Medium" />
                    <span>Loading library…</span>
                </div>
            }
            else if (_error is not null)
            {
                <div class="bv-media-picker__state bv-media-picker__state--error">
                    ⚠ @_error
                    <TelerikButton OnClick="LoadAsync"
                                   Size="@ThemeConstants.Button.Size.Small">Retry</TelerikButton>
                </div>
            }
            else if (!FilteredFiles.Any())
            {
                <div class="bv-media-picker__state">
                    <span>No media files found in your library.</span>
                </div>
            }
            else
            {
                @* ── File grid ──────────────────────────────────────────── *@
                <div class="bv-media-picker__grid">
                    @foreach (var file in FilteredFiles)
                    {
                        var importing = _importing.Contains(file.Id);
                        <div class="bv-media-picker__card @(importing ? "bv-media-picker__card--busy" : "")"
                             @oncontextmenu="e => OpenFileMenu(e, file)"
                             @oncontextmenu:preventDefault>
                            <div class="bv-media-picker__card-icon">
                                @if (file.IsVideo)
                                {
                                    <TelerikSvgIcon Icon="@SvgIcon.Film" />
                                }
                                else
                                {
                                    <TelerikSvgIcon Icon="@SvgIcon.MusicNotes" />
                                }
                            </div>
                            <div class="bv-media-picker__card-info">
                                <span class="bv-media-picker__card-name" title="@file.FileName">@file.FileName</span>
                                <span class="bv-media-picker__card-meta">@file.FileSizeDisplay · @file.DateCreated.ToString("MMM d, yyyy")</span>
                                @if (!string.IsNullOrEmpty(file.Description))
                                {
                                    <span class="bv-media-picker__card-desc">@file.Description</span>
                                }
                            </div>
                            <div class="bv-media-picker__card-action">
                                @if (importing)
                                {
                                    <TelerikLoader Type="@LoaderType.Pulsing"
                                                   Size="@ThemeConstants.Loader.Size.Small" />
                                }
                                else
                                {
                                    <TelerikButton OnClick="() => ImportAsync(file)"
                                                   Icon="@SvgIcon.Download"
                                                   Size="@ThemeConstants.Button.Size.Small"
                                                   ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                                   Title="Import into editor"
                                                   Enabled="@(Ffmpeg.State == FfmpegState.Ready)" />
                                }
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </WindowContent>
    <WindowActions>
        <WindowAction Name="Close" />
    </WindowActions>
</TelerikWindow>

<TelerikContextMenu @ref="_fileMenu"
                    Data="@_fileMenuItems"
                    TextField="Text"
                    IconField="Icon"
                    SeparatorField="IsSeparator"
                    DisabledField="IsDisabled"
                    OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
</TelerikContextMenu>

@code {
    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Controls window visibility — two-way bindable.</summary>
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>Raised after a file has been successfully imported into the editor.</summary>
    [Parameter] public EventCallback<VideoClip>  OnVideoImported { get; set; }
    [Parameter] public EventCallback<AudioClip>  OnAudioImported { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private IReadOnlyList<MediaLibraryFile> _files  = [];
    private HashSet<Guid>                   _importing = [];
    private bool                            _loading;
    private string?                         _error;
    private string                          _search = string.Empty;

    private TelerikContextMenu<BvMenuItem>? _fileMenu;
    private List<BvMenuItem> _fileMenuItems = [];

    private async Task OpenFileMenu(MouseEventArgs e, MediaLibraryFile file)
    {
        var busy = _importing.Contains(file.Id);
        _fileMenuItems =
        [
            new() { Text = "Import into Editor", Icon = SvgIcon.Download,
                    Action = async () => await ImportAsync(file),
                    IsDisabled = busy || Ffmpeg.State != FfmpegState.Ready },
            new() { IsSeparator = true },
            new() { Text = file.IsVideo ? "Video File" : "Audio File",
                    Icon = file.IsVideo ? SvgIcon.Film : SvgIcon.MusicNotes,
                    IsDisabled = true },
            new() { Text = $"Size: {file.FileSizeDisplay}", IsDisabled = true },
        ];
        if (_fileMenu is not null)
            await _fileMenu.ShowAsync(e.ClientX, e.ClientY);
}

    private IEnumerable<MediaLibraryFile> FilteredFiles =>
        string.IsNullOrWhiteSpace(_search)
            ? _files
            : _files.Where(f => f.FileName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                             || (f.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && _files.Count == 0 && !_loading)
            await LoadAsync();
    }

    // ── Handlers ──────────────────────────────────────────────────────────────

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();
        try
        {
            _files = await Library.GetFilesAsync();
        }
        catch (Exception ex)
        {
            _error = $"Could not load library: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ImportAsync(MediaLibraryFile file)
    {
        if (!_importing.Add(file.Id)) return;
        StateHasChanged();

        try
        {
            var bytes  = await Library.DownloadFileAsync(file.Id);
            var clipId = Guid.NewGuid();
            var ext    = System.IO.Path.GetExtension(file.FileName).ToLowerInvariant();

            // Item #38 phases A+B — see the identical comments in ClipBrowser.ImportFromLibraryAsync:
            // OPFS is written first, then the main ffmpeg instance mounts that copy (zero-copy)
            // instead of writing the downloaded bytes into MEMFS at all; falls back to a normal
            // write only when mounting isn't possible.
            await OPFS.WriteFromBytesAsync(clipId, ext, bytes);
            var memFsName = await Mounter.MountAsync(clipId, ext);
            if (memFsName is null)
            {
                memFsName = $"lib_{Guid.NewGuid():N}_{file.FileName}";
                await Ffmpeg.WriteFileFromBytesAsync(memFsName, bytes);
            }
            // Item #70 phase 159 — sidecar first (OPFS-backed source is already written above),
            // wasm on null.
            var meta = await SidecarMedia.TryGetMetadataAsync(clipId, ext, CancellationToken.None)
                       ?? await Ffmpeg.GetMetadataAsync(memFsName);

            if (file.IsAudio)
            {
                var audioClip = new AudioClip
                {
                    Id        = clipId,
                    Name      = file.FileName,
                    MemFsName = memFsName,
                    Duration  = meta.Duration,
                    BlobUrl   = await Ffmpeg.CreatePreviewUrlAsync(memFsName, file.ContentType),
                    OpfsExt   = ext,
                };

                var audioTracks = Clips.AudioTracks.ToList();
                if (audioTracks.Count > 0)
                {
                    var track    = audioTracks[0];
                    var position = track.Items.Any()
                        ? track.Items.Max(i => i.TimelinePosition + i.Duration) : 0;
                    audioClip.TimelinePosition = position;
                    Clips.AddClipToTrack(track.Id, audioClip);
                }

                await OnAudioImported.InvokeAsync(audioClip);
            }
            else
            {
                var thumbs = await SidecarMedia.TryExtractThumbnailsAsync(clipId, ext, 4, meta.Duration, CancellationToken.None)
                             ?? await Ffmpeg.ExtractThumbnailsAsync(memFsName, 4, meta.Duration);

                var videoClip = new VideoClip
                {
                    Id            = clipId,
                    Name          = file.FileName,
                    MemFsName     = memFsName,
                    Duration      = meta.Duration,
                    Width         = meta.Width,
                    Height        = meta.Height,
                    ThumbnailUrls = [.. thumbs],
                    OpfsExt       = ext,
                };

                Clips.AddClip(videoClip);
                await OnVideoImported.InvokeAsync(videoClip);
            }
        }
        catch (Exception ex)
        {
            _error = $"Import failed for '{file.FileName}': {ex.Message}";
        }
        finally
        {
            _importing.Remove(file.Id);
            StateHasChanged();
        }
    }

    private async Task OnVisibleChanged(bool visible)
    {
        Visible = visible;
        await VisibleChanged.InvokeAsync(visible);
    }
}
