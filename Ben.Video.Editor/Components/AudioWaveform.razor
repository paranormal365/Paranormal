@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="bv-waveform @(ShowControls ? "bv-waveform--full" : "bv-waveform--mini")"
     style="@(Height > 0 ? $"--bv-waveform-height:{Height}px;" : "")">

    @* ── Loading / Error states ──────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="bv-waveform__loading">
            <TelerikLoader Type="@LoaderType.InfiniteSpinner"
                           Size="@ThemeConstants.Loader.Size.Small" />
        </div>
    }

    @if (_error is not null)
    {
        <div class="bv-waveform__error">⚠ @_error</div>
    }

    @* ── WaveSurfer container ────────────────────────────────────────────── *@
    <div id="@_containerId"
         class="bv-waveform__canvas"
         style="@SyncProgressStyle">
        @* Playhead sync line — shown when SyncProgress ≥ 0 *@
        @if (SyncProgress >= 0)
        {
            <div class="bv-waveform__sync-line"></div>
        }
    </div>

    @* ── Controls bar (full mode only) ──────────────────────────────────── *@
    @if (ShowControls && _ready)
    {
        <div class="bv-waveform__controls">

            <TelerikButton OnClick="PlayPauseAsync"
                           Icon="@(_playing ? SvgIcon.Pause : SvgIcon.Play)"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="@(_playing ? "Pause" : "Play")" />

            <span class="bv-waveform__time">
                @FormatTime(_currentTime) / @FormatTime(_duration)
            </span>

            <label class="bv-waveform__vol-label" title="Volume">
                🔊
                <input type="range" class="bv-waveform__vol-slider"
                       min="0" max="1" step="0.02"
                       value="@_volume.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="OnVolumeInput" />
            </label>

        </div>
    }

</div>

@code {
    private const string ModulePath = "/_content/Ben.Video.Editor/js/waveformInterop.js";

    // ── Parameters ────────────────────────────────────────────────────────────

    /// <summary>Object URL (blob URL) for the audio data to render.</summary>
    [Parameter] public string? BlobUrl { get; set; }

    /// <summary>Pre-computed peak data. When supplied, avoids a full audio decode.</summary>
    [Parameter] public float[]? Peaks { get; set; }

    /// <summary>Waveform canvas height in pixels. 0 = let CSS decide.</summary>
    [Parameter] public int Height { get; set; } = 64;

    /// <summary>Show the play/pause/volume controls bar below the waveform.</summary>
    [Parameter] public bool ShowControls { get; set; }

    /// <summary>
    /// Playhead progress fraction [0, 1] relative to this audio clip.
    /// When &ge; 0 a thin playhead line is overlaid on the waveform canvas.
    /// Set to <c>-1</c> (default) to hide the sync line.
    /// In the timeline, VideoTimeline computes this from:
    /// <c>(Playback.CurrentTime - ac.TimelinePosition) / ac.Duration</c>.
    /// </summary>
    [Parameter] public double SyncProgress { get; set; } = -1;

    /// <summary>Raised when WaveSurfer has decoded the audio and reports its duration.</summary>
    [Parameter] public EventCallback<double> OnReady { get; set; }

    /// <summary>Raised each time the playhead position changes (seconds).</summary>
    [Parameter] public EventCallback<double> OnTimeUpdate { get; set; }

    /// <summary>Raised when WaveSurfer has decoded peaks — use to cache them in the model.</summary>
    [Parameter] public EventCallback<float[]> OnPeaksDecoded { get; set; }

    // ── Local state ───────────────────────────────────────────────────────────

    private IJSObjectReference? _module;
    private DotNetObjectReference<AudioWaveform>? _selfRef;

    private readonly string _containerId = $"bv-wf-{Guid.NewGuid():N}";
    private string?  _lastBlobUrl;
    private bool     _loading;
    private bool     _ready;
    private bool     _playing;
    private double   _currentTime;
    private double   _duration;
    private double   _volume = 1.0;
    private string?  _error;

    // ── Sync playhead ─────────────────────────────────────────────────────────

    private string SyncProgressStyle =>
        SyncProgress >= 0
            ? $"--bv-wf-progress: {SyncProgress.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}"
            : string.Empty;

    private double _lastSyncProgress = -2; // sentinel value different from any valid progress

    protected override async Task OnParametersSetAsync()
    {
        // Full-view waveform (ShowControls=true): call WaveSurfer seekTo so its internal
        // playhead moves. Throttled: skip updates smaller than 0.001 (< 1 frame at 30fps
        // for most clip durations) to avoid excessive JS round-trips.
        if (ShowControls && _ready && SyncProgress >= 0 && _module is not null
            && Math.Abs(SyncProgress - _lastSyncProgress) >= 0.001)
        {
            _lastSyncProgress = SyncProgress;
            try { await _module.InvokeVoidAsync("seek", _containerId, SyncProgress); }
            catch { /* non-critical */ }
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (BlobUrl is null) return;
        if (BlobUrl == _lastBlobUrl) return;  // URL unchanged — no-op

        _lastBlobUrl = BlobUrl;
        await InitWaveformAsync();
    }

    private async Task InitWaveformAsync()
    {
        _loading = true;
        _ready   = false;
        _error   = null;
        StateHasChanged();

        try
        {
            _module  ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _selfRef ??= DotNetObjectReference.Create(this);

            // Height=0 means "let CSS control the size"; pass the string "auto" to WaveSurfer
            // so it doesn't impose a fixed pixel height on the canvas container.
            object heightValue = Height > 0 ? (object)Height : "auto";
            var options = new
            {
                height       = heightValue,
                showControls = ShowControls,
                duration     = _duration > 0 ? _duration : (double?)null,
            };

            await _module.InvokeVoidAsync("create",
                _containerId, BlobUrl, Peaks, options, _selfRef);
        }
        catch (Exception ex)
        {
            _error   = ex.Message;
            _loading = false;
            StateHasChanged();
        }
    }

    // ── JS Callbacks ──────────────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnWaveformReady(double duration)
    {
        _duration = duration;
        _loading  = false;
        _ready    = true;
        StateHasChanged();
        await OnReady.InvokeAsync(duration);

        // Fetch and surface peak data for caching
        if (_module is not null && OnPeaksDecoded.HasDelegate)
        {
            try
            {
                var peaks = await _module.InvokeAsync<float[]>("getPeaks", _containerId, 200);
                await OnPeaksDecoded.InvokeAsync(peaks);
            }
            catch { /* non-critical */ }
        }
    }

    [JSInvokable]
    public async Task OnWaveformTimeUpdate(double currentTime)
    {
        _currentTime = currentTime;
        StateHasChanged();
        await OnTimeUpdate.InvokeAsync(currentTime);
    }

    [JSInvokable]
    public Task OnWaveformFinish()
    {
        _playing = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnWaveformError(string message)
    {
        _error   = message;
        _loading = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ── Controls ──────────────────────────────────────────────────────────────

    private async Task PlayPauseAsync()
    {
        if (_module is null) return;
        if (_playing)
        {
            await _module.InvokeVoidAsync("pause", _containerId);
            _playing = false;
        }
        else
        {
            await _module.InvokeVoidAsync("play", _containerId);
            _playing = true;
        }
    }

    private async Task OnVolumeInput(ChangeEventArgs e)
    {
        if (_module is null) return;
        if (double.TryParse(e.Value?.ToString(),
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out var v))
        {
            _volume = v;
            await _module.InvokeVoidAsync("setVolume", _containerId, _volume);
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string FormatTime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? ts.ToString(@"h\:mm\:ss\.f")
            : ts.ToString(@"m\:ss\.f");
    }

    // ── Dispose ───────────────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        if (_module is not null && _lastBlobUrl is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", _containerId); } catch { }
        }

        _selfRef?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
