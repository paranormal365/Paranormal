    private double          _markerOriginalTime;

    private void OnMarkerPointerDown(PointerEventArgs e, TimelineMarker marker)
    {
        if (e.Button != 0) return;
        _draggingMarker      = marker;
        _markerDragStartX    = e.ClientX;
        _markerOriginalTime  = marker.TimeSeconds;
    }

    private void OnMarkerPointerMove(PointerEventArgs e)
    {
        if (_draggingMarker is null) return;
        var deltaSec = (e.ClientX - _markerDragStartX) / Timeline.PxPerSecond;
        _draggingMarker.TimeSeconds = Math.Max(0, _markerOriginalTime + deltaSec);
        StateHasChanged();
    }

    private void OnMarkerPointerUp(PointerEventArgs e)
    {
        if (_draggingMarker is null) return;
        Clips.CommitMarkerPosition(_draggingMarker.Id, _markerOriginalTime);
        _draggingMarker = null;
    }

