 // --- Item selection ---

    private async Task SelectItem(TrackItem item)
    {
        _selectedItemId = item.Id;
        await OnItemSelected.InvokeAsync(item);
    }

    private async Task SelectItemWithModifier(TrackItem item, bool ctrlHeld)
    {
        if (ctrlHeld)
        {
            // Toggle this item in/out of the multi-selection set
            if (!_multiSelectedIds.Add(item.Id))
                _multiSelectedIds.Remove(item.Id);
            // Keep _selectedItemId tracking for the properties panel
            _selectedItemId = item.Id;
        }
        else
        {
            // Normal click — clear multi-selection and select only this item
            _multiSelectedIds.Clear();
            await SelectItem(item);
        }
    }

    /// <summary>Returns true if the given id is part of an active multi-selection (2+ items).</summary>
    private bool IsMultiSelected(Guid id) =>
        _multiSelectedIds.Count >= 2 && _multiSelectedIds.Contains(id);

    private async Task RemoveItem(TimelineTrack track, TrackItem item)
    {
        if (_selectedItemId == item.Id) _selectedItemId = null;
        _multiSelectedIds.Remove(item.Id);
        if (item is Transition)
            Clips.RemoveTransition(item.Id);
        else if (_rippleOverride)
            Clips.RippleDeleteClip(item.Id);
        else
            Clips.RemoveClip(item.Id);
        await OnItemRemoved.InvokeAsync(item.Id);
    }

    /// <summary>
    /// The height this timeline would like: its chrome plus a row per track, plus the overlay lanes
    /// each track is carrying.
    /// </summary>
    /// <remarks>
    /// <para>Read by <c>VideoEditor</c> so a project with one track does not reserve the space a
    /// project with six needs, and a project with six is not squeezed into the space one needs. The
    /// person's own drag always wins — see <c>LayoutService.AutoFitTimeline</c>.</para>
    ///
    /// <para>The numbers match the stylesheet: <c>.bv-timeline__header</c> and the ruler are fixed
    /// chrome, <c>.bv-track</c> has a 56px floor, and each overlay lane is an inline 40px row
    /// (<c>overlayItems.Count * 40</c> in the markup above). They are approximate on purpose —
    /// this only decides a starting size, and being a row out is invisible.</para>
    /// </remarks>
    public int PreferredHeightPx
    {
        get
        {
            const int Chrome     = 34 + 26;  // header + ruler
            const int TrackRow   = 56;
            const int OverlayRow = 40;
            const int MarkerRuler = 22;

            var tracks = Clips.Tracks.Count;
            var overlayRows = Clips.Tracks.Sum(t => t.Items.Count(
                i => i is CalloutClip or TextOverlay or ClipArtClip));

            var markers = EffectiveOptions.Markers && Clips.Markers.Count > 0 ? MarkerRuler : 0;

            return Chrome + markers + (tracks * TrackRow) + (overlayRows * OverlayRow);
        }
    }

