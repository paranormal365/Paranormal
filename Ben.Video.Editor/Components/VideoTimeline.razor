        Clips.AudioTracks.Count() < EffectiveOptions.MaxAudioTracks;

 // --- Track management ---

    private void AddVideoTrack() => Clips.AddVideoTrack();
    private void AddAudioTrack() => Clips.AddAudioTrack();
    private void RemoveTrack(TimelineTrack track) => Clips.RemoveTrack(track.Id);

    private void MoveTrackUp(TimelineTrack track)
    {
        var videoTracks = Clips.Tracks.Where(t => t.Type == TrackType.Video).OrderBy(t => t.Order).ToList();
        var idx = videoTracks.FindIndex(t => t.Id == track.Id);
        if (idx <= 0) return;
        Clips.ReorderTrack(track.Id, videoTracks[idx - 1].Order);
    }

    private void MoveTrackDown(TimelineTrack track)
    {
        var videoTracks = Clips.Tracks.Where(t => t.Type == TrackType.Video).OrderBy(t => t.Order).ToList();
        var idx = videoTracks.FindIndex(t => t.Id == track.Id);
        if (idx < 0 || idx >= videoTracks.Count - 1) return;
        Clips.ReorderTrack(track.Id, videoTracks[idx + 1].Order);
    }

