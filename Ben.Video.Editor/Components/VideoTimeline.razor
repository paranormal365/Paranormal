@using Ben.Video.Core.Services
@inject ClipStore Clips
@inject IOptions<VideoEditorOptions> EditorOptionsAccessor
@inject TimelineViewState Timeline
@inject PlaybackService Playback
@inject IJSRuntime JS
@inject FfmpegService Ffmpeg
@inject PreviewFreshnessService PreviewFreshness
@inject RenderStatusService RenderStatus
@inject MotionKeyframeService Motion
@using Ben.Video.RenderService
@implements IAsyncDisposable

<footer class="bv-timeline">

    <!-- Timeline header -->
    <div class="bv-timeline__header">
        <span class="bv-timeline__title">Timeline</span>
        <span class="bv-timeline__duration">@FormatDuration(Clips.TotalDuration)</span>

        @if (_multiSelectedIds.Count >= 2)
        {
            <span class="bv-timeline__multiselect-badge">@_multiSelectedIds.Count selected</span>
            <TelerikButton OnClick="DeleteMultiSelected"
                           Icon="@SvgIcon.Trash"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Error"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="Delete selected clips" />
            <TelerikButton OnClick="() => NudgeMultiSelected(-1.0)"
                           Icon="@SvgIcon.ArrowLeft"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="Nudge left 1 s" />
            <TelerikButton OnClick="() => NudgeMultiSelected(1.0)"
                           Icon="@SvgIcon.ArrowRight"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="Nudge right 1 s" />
        }

        <div class="bv-timeline__track-actions">
            <div class="bv-timeline__zoom-controls">
                <TelerikButton OnClick="FitToViewAsync"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Fit timeline to visible width">Fit</TelerikButton>
                <TelerikSlider @bind-Value="Timeline.ZoomScale"
                               Min="0.05" Max="20.0"
                               SmallStep="0.05" LargeStep="1.0"
                               ShowButtons="false"
                               Width="100px"
                               Class="bv-timeline__zoom-slider" />
                <span class="bv-timeline__zoom-label">@Timeline.ZoomScale.ToString("F1")×</span>
                <TelerikButton OnClick="ToggleDisplayMode"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Toggle timecode / frames">
                    @(Timeline.DisplayMode == TimelineDisplayMode.Time ? "TC" : "Fr")
                </TelerikButton>
                <TelerikButton OnClick="() => _rippleOverride = !_rippleOverride"
                               Icon="@SvgIcon.ArrowRight"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@(_rippleOverride ? ThemeConstants.Button.FillMode.Solid : ThemeConstants.Button.FillMode.Flat)"
                               ThemeColor="@(_rippleOverride ? ThemeConstants.Button.ThemeColor.Primary : ThemeConstants.Button.ThemeColor.Base)"
                               Class="@(_rippleOverride ? "bv-toggle--active" : "")"
                               Title="@(_rippleOverride ? "Ripple edit ON — moves/deletes shift subsequent clips" : "Ripple edit OFF — click to enable")">
                    Ripple
                </TelerikButton>
            </div>
            @if (EffectiveOptions.MultiTrack)
            {
                <TelerikButton OnClick="AddVideoTrack"
                               Enabled="@CanAddVideoTrack"
                               Icon="@SvgIcon.Plus"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Add video track">
                    + Video
                </TelerikButton>
                @if (EffectiveOptions.AudioTracks)
                {
                    <TelerikButton OnClick="AddAudioTrack"
                                   Enabled="@CanAddAudioTrack"
                                   Icon="@SvgIcon.MusicNotes"
                                   Size="@ThemeConstants.Button.Size.Small"
                                   FillMode="@ThemeConstants.Button.FillMode.Flat"
                                   Title="Add audio track">
                        + Audio
                    </TelerikButton>
                }
            }
            @if (EffectiveOptions.TextOverlays)
            {
                <TelerikButton OnClick="AddTextOverlay"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Add text overlay">
                    T + Text
                </TelerikButton>
            }
            <TelerikButton OnClick="AddCalloutClip"
                           Icon="@SvgIcon.MapMarker"
                           Size="@ThemeConstants.Button.Size.Small"
                           FillMode="@ThemeConstants.Button.FillMode.Flat"
                           Title="Add callout shape (rectangle, ellipse, arrow…)">
                📌 Callout
            </TelerikButton>
            @if (EffectiveOptions.Markers)
            {
                <TelerikButton OnClick="AddMarkerAtPlayhead"
                               Icon="@SvgIcon.MapMarker"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Title="Add marker at playhead (M)">
                    Marker
                </TelerikButton>
            }
            @if (OnSaveFrame.HasDelegate)
            {
                <TelerikButton OnClick="SaveFrameAtPlayhead"
                               Icon="@SvgIcon.Image"
                               Size="@ThemeConstants.Button.Size.Small"
                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                               Class="btn-sm text-nowrap"
                               Title="Save the frame at the playhead as a picture">
                    Save Frame
                </TelerikButton>
            }
        </div>
    </div>

    @* Marker ruler: rendered below the header, above the track rows *@
    @if (EffectiveOptions.Markers && Clips.Markers.Count > 0 && Clips.TotalDuration > 0)
    {
        <div class="bv-timeline__marker-ruler">
            <div class="bv-timeline__marker-ruler-gutter"></div>
            <div class="bv-timeline__marker-ruler-track">
                @foreach (var marker in Clips.Markers)
                {
                    var capturedMarker = marker;
                    var pct = marker.TimeSeconds / Clips.TotalDuration * 100;
                    var editingThis = _editingMarkerId == marker.Id;
                    <div class="bv-marker-flag @(_draggingMarker?.Id == marker.Id ? "bv-marker-flag--dragging" : "")"
                         style="left: @pct.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%; --bv-marker-color: @marker.Color"
                         title="@marker.Label (@FormatDuration(marker.TimeSeconds)) — drag to move, double-click to rename"
                         @onpointerdown="e => OnMarkerPointerDown(e, capturedMarker)"
                         @onpointermove="OnMarkerPointerMove"
                         @onpointerup="OnMarkerPointerUp"
                         @ondblclick="() => StartEditMarkerLabel(capturedMarker)"
                         @oncontextmenu="e => OpenMarkerMenu(e, capturedMarker)"
                         @oncontextmenu:preventDefault>
                        <div class="bv-marker-flag__stem"></div>
                        @if (editingThis)
                        {
                            <input class="bv-marker-flag__label-input"
                                   type="text"
                                   @bind="_editingMarkerLabel"
                                   @bind:event="oninput"
                                   @onblur="CommitMarkerLabelEdit"
                                   @onkeydown="OnMarkerLabelKeyDown"
                                   @onclick:stopPropagation
                                   @onpointerdown:stopPropagation />
                        }
                        else
                        {
                            <div class="bv-marker-flag__label">@marker.Label</div>
                        }
                        <button class="bv-marker-flag__remove"
                                @onclick="() => RemoveMarker(capturedMarker.Id)"
                                @onclick:stopPropagation="true"
                                @onpointerdown:stopPropagation="true"
                                title="Remove marker">×</button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Track rows -->
    <div class="bv-timeline__tracks">

        @* Time ruler — sticky across all tracks *@
        @if (Clips.TotalDuration > 0)
        {
            var ticks    = Timeline.ComputeTicks(Clips.TotalDuration);
            var canvasW  = Timeline.CanvasWidth(Clips.TotalDuration);
            <div class="bv-timeline__ruler">
                <div class="bv-timeline__ruler-gutter"></div>
                <div class="bv-timeline__ruler-canvas" style="width: @canvasW.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)px"
                     @onpointerdown="OnRulerPointerDown"
                     @onpointermove="OnRulerPointerMove"
                     @onpointerup="OnRulerPointerUp"
                     @onpointercancel="OnRulerPointerUp"
                     @onpointerdown:preventDefault="true">
                    @foreach (var tick in ticks)
                    {
                        var pxLeft = tick * Timeline.PxPerSecond;
                        <div class="bv-ruler-tick @(tick == 0 ? "bv-ruler-tick--start" : "")"
                             style="left: @pxLeft.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)px">
                            <span class="bv-ruler-tick__label">@Timeline.FormatTick(tick)</span>
                        </div>
                    }
                </div>
            </div>

            @* Render-progress indicator — per-region (item #36 phase A) when the primary track has
               clips with tracked regions; falls back to the old whole-timeline bar
               (PreviewFreshnessService) otherwise, e.g. before any clip has been added. *@
            {
                var regions = RenderStatus.Regions;
                <div class="bv-timeline__render-progress">
                    <div class="bv-timeline__render-progress-gutter"></div>
                    <div class="bv-timeline__render-progress-track">
                        @if (regions.Count > 0)
                        {
                            @foreach (var region in regions)
                            {
                                var left  = region.Start * Timeline.PxPerSecond;
                                var width = region.Duration * Timeline.PxPerSecond;
                                var stateClass = region.State switch
                                {
                                    RenderRegionState.Fine           => "bv-render-region--fine",
                                    RenderRegionState.RenderingFine  => "bv-render-region--rendering-fine",
                                    RenderRegionState.Rough          => "bv-render-region--rough",
                                    RenderRegionState.RenderingRough => "bv-render-region--rendering-rough",
                                    _                                 => "bv-render-region--stale",
                                };
                                <div class="bv-render-region @stateClass"
                                     style="left: @(left.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px; width: @(width.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px"
                                     title="@RegionTooltip(region)">
                                    @if (region.State is RenderRegionState.RenderingFine or RenderRegionState.RenderingRough)
                                    {
                                        <div class="bv-render-region__progress" style="width: @(region.ProgressPct)%"></div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            var progressWidth = Clips.TotalDuration * Timeline.PxPerSecond;
                            <div class="bv-render-progress-bar @(PreviewFreshness.IsFresh ? "bv-render-progress-bar--fresh" : "bv-render-progress-bar--stale")"
                                 style="width: @progressWidth.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)px"
                                 title="@(PreviewFreshness.IsFresh ? "Preview is up to date" : "Preview is out of date — click Preview to refresh")">
                            </div>
                        }
                    </div>
                </div>
            }
        }

        @if (!Clips.Tracks.Any())
        {
            <div class="bv-timeline__empty">
                Add clips from the browser panel to get started.
            </div>
        }

        @foreach (var track in Clips.Tracks.OrderBy(t => t.Order))
        {
            <div class="bv-track bv-track--@track.Type.ToString().ToLowerInvariant() @(track.IsMuted ? "bv-track--muted" : "") @(track.IsLocked ? "bv-track--locked" : "") @(_dropTargetTrackId == track.Id ? "bv-track--drop-target" : "") @(_collapsedTrackIds.Contains(track.Id) ? "bv-track--collapsed" : "") @(_movingItem is not null && _moveHoverTrackId == track.Id && track.Id != _moveOriginalTrackId ? "bv-track--move-hover" : "")"
                 data-track-id="@track.Id"
                 style="@(GetTrackHeightOverride(track.Id) is { } trackH ? $"height: {trackH.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)}px; min-height: 0; overflow: hidden;" : "")"
                 @ondragover:preventDefault
                 @ondragover="e => OnTrackDragOver(e, track)"
                 @ondragenter="e => OnTrackDragEnterAsync(e, track)"
                 @ondragleave="() => OnTrackDragLeave(track)"
                 @ondrop="e => OnTrackDrop(e, track)">

                <!-- Label strip -->
                <div class="bv-track__label"
                     @oncontextmenu="e => OpenTrackMenu(e, track)"
                     @oncontextmenu:preventDefault>
                    <span class="bv-track__type-icon">@TrackIcon(track.Type)</span>

                    @if (_editingTrackId == track.Id)
                    {
                        <input class="bv-track__name-input"
                               type="text"
                               @bind="_editingTrackLabel"
                               @bind:event="oninput"
                               @onblur="CommitTrackNameEdit"
                               @onkeydown="OnTrackNameKeyDown"
                               @onclick:stopPropagation />
                    }
                    else
                    {
                        <span class="bv-track__name"
                              title="@track.Label — double-click to rename"
                              @ondblclick="() => StartEditTrackName(track)">
                            @track.Label
                        </span>
                    }

                    <div class="bv-track__controls">
                        @{
                            var vTracks  = Clips.Tracks.Where(t => t.Type == TrackType.Video).OrderBy(t => t.Order).ToList();
                            var tIdx     = vTracks.FindIndex(t => t.Id == track.Id);
                            var isPrimary = track.Id == Clips.PrimaryVideoTrack.Id;
                            var canMoveUp   = EffectiveOptions.MultiTrack && track.Type == TrackType.Video && tIdx > 0;
                            var canMoveDown = EffectiveOptions.MultiTrack && track.Type == TrackType.Video && tIdx >= 0 && tIdx < vTracks.Count - 1;
                        }
                        <TelerikButton OnClick="() => ToggleTrackCollapsed(track.Id)"
                                       Icon="@(_collapsedTrackIds.Contains(track.Id) ? SvgIcon.ChevronDown : SvgIcon.ChevronUp)"
                                       FillMode="@ThemeConstants.Button.FillMode.Flat"
                                       Size="@ThemeConstants.Button.Size.Small"
                                       Class="bv-track__collapse-btn"
                                       Title="@(_collapsedTrackIds.Contains(track.Id) ? "Expand track" : "Collapse track")" />
                        <TelerikDropDownButton Icon="@SvgIcon.MoreVertical"
                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                               Size="@ThemeConstants.Button.Size.Small"
                                               Class="bv-track__menu-btn"
                                               Title="Track options">
                            <DropDownButtonItems>
                                <DropDownButtonItem Icon="@(track.IsMuted ? SvgIcon.VolumeUp : SvgIcon.VolumeMute)"
                                                   OnClick="() => ToggleMute(track)">
                                    @(track.IsMuted ? "Unmute" : "Mute")
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.Lock"
                                                   OnClick="() => ToggleLock(track)">
                                    @(track.IsLocked ? "Unlock" : "Lock")
                                </DropDownButtonItem>
                                @if (track.Type == TrackType.Audio)
                                {
                                    @* Everything else drops while this track is playing — what a
                                       narration track needs, instead of drawing a volume envelope
                                       around every line by hand (2026-09-05 audit). *@
                                    <DropDownButtonItem Icon="@SvgIcon.SortDesc"
                                                       OnClick="() => ToggleDucking(track)">
                                        @(track.DucksOthers ? "Stop ducking others" : "Duck others under this")
                                    </DropDownButtonItem>
                                }
                                <DropDownButtonItem Icon="@SvgIcon.Pencil"
                                                   OnClick="() => StartEditTrackName(track)">
                                    Rename
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.ChevronUp"
                                                   Enabled="@canMoveUp"
                                                   OnClick="() => MoveTrackUp(track)">
                                    Move Up
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.ChevronDown"
                                                   Enabled="@canMoveDown"
                                                   OnClick="() => MoveTrackDown(track)">
                                    Move Down
                                </DropDownButtonItem>
                                <DropDownButtonItem Icon="@SvgIcon.Trash"
                                                   Enabled="@(!isPrimary)"
                                                   OnClick="() => RemoveTrack(track)">
                                    Remove
                                </DropDownButtonItem>
                            </DropDownButtonItems>
                        </TelerikDropDownButton>
                    </div>
                </div>

                <!-- Clip chips — HTML5 drag-and-drop for reorder -->
                <div class="bv-track__items"
                     style="min-width: @(Timeline.CanvasWidth(Clips.TotalDuration).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px">
                    @if (EffectiveOptions.Snapping && _snapGuidePx.HasValue &&
                         (_dropTargetTrackId == track.Id || (_movingItem is not null && _moveItemTrackId == track.Id)))
                    {
                        <div class="bv-snap-guide" style="left: @(_snapGuidePx!.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))px"></div>
                    }
                    @{
                        // Overlay items (Callout/Text/ClipArt) are rendered in their own row below,
                        // not in this one — see .bv-track__overlays. They are excluded here because
                        // this lane holds the items that own a place in time, one at a time, while
                        // an overlay is meant to sit over whatever is beneath it (backlog item #39;
                        // the same distinction TrackLayout.IsSequential draws).
                        //
                        // Transitions (item #57 T1) are excluded here for the same class of
                        // reason, but the opposite direction: a transition doesn't sit *after* its
                        // two clips, it overlaps their shared junction — TimelinePosition/Duration
                        // already encode that overlap (AddTransition centres it on the boundary).
                        // Keeping it in this sequential flex flow was the old (pre-T1) behavior:
                        // it rendered as a small inline pill consuming its own flex width, visually
                        // inflating the apparent gap between the two clips with no relationship to
                        // its actual duration. It's now rendered separately, absolutely positioned,
                        // straddling the real cut — see the loop below this one.
                        var orderedItems = track.Items
                            .Where(i => i is not (CalloutClip or TextOverlay or ClipArtClip or Transition))
                            .OrderBy(i => i.Order)
                            .ToList();
                        var overlayItems = track.Items
                            .Where(i => i is CalloutClip or TextOverlay or ClipArtClip)
                            .OrderByDescending(i => i.LayerIndex)
                            .ToList();
                        var isVideoTrack = track.Type == TrackType.Video;
                        var transitionsOn = EffectiveOptions.Transitions && isVideoTrack;
                        var trackTransitions = track.Items.OfType<Transition>().ToList();
                        // Build a set of FromClipIds that already have a transition on this track
                        var coveredFromIds = trackTransitions.Select(t => t.FromClipId).ToHashSet();
                        // Chips are positioned absolutely, at the time they actually start.
                        //
                        // They used to render in flex flow with the gap to the previous chip as a
                        // leading margin, clamped at zero — so a clip whose position was BEFORE the
                        // previous clip's end (an overlap) was drawn politely after it instead. The
                        // picture disagreed with the model, the ruler and the export dialog, and
                        // the one arrangement nobody could see was the broken one (2026-09-05
                        // audit, F5).
                    }

                    @for (var idx = 0; idx < orderedItems.Count; idx++)
                    {
                        var item     = orderedItems[idx];
                        var captured = item;

                        // Where it starts, in pixels from the start of the timeline.
                        var leftPxStr = (item.TimelinePosition * Timeline.PxPerSecond)
                            .ToString("F0", System.Globalization.CultureInfo.InvariantCulture) + "px";

                        {
                            // Audio joins the list. Its chips had no handles at all, so the only way to
                            // shorten a sound was to type numbers into the properties panel — while help
                            // said every clip trims by its edges (2026-09-05 audit, audio-12).
                            var trimOn  = EffectiveOptions.InlineTrimming && item is VideoClip or ImageClip or AudioClip && !track.IsLocked;
                            var chipWpx = (ItemDuration(item) * Timeline.PxPerSecond).ToString("F0", System.Globalization.CultureInfo.InvariantCulture) + "px";
                            var trimmingThis = _trimmingClip?.Id == item.Id || _trimmingAudio?.Id == item.Id;
                            var movingThis   = _movingItem?.Id   == item.Id;
                            var trimCls = trimmingThis
                                ? (_trimmingSide == TrimSide.Start ? "bv-clip-chip--trimming bv-clip-chip--trimming-start"
                                                                    : "bv-clip-chip--trimming bv-clip-chip--trimming-end")
                                : "";
                            var moveCls = movingThis ? "bv-clip-chip--moving" : "";
                            @* draggable lists every in-progress drag: while one is running the
                               chip must not also be natively draggable, because the browser then
                               suppresses pointerup delivery entirely and the drag never ends (see
                               FinalizeMove's note on #27). An audio trim is one of them. *@
                            <div @key="item.Id"
                                 class="bv-clip-chip bv-clip-chip--@ChipType(item) @(_selectedItemId == item.Id ? "bv-clip-chip--selected" : "") @(IsMultiSelected(item.Id) ? "bv-clip-chip--multi-selected" : "") @(_draggingId == item.Id ? "bv-clip-chip--dragging" : "") @trimCls @moveCls @(item.IsMediaMissing ? "bv-clip-chip--missing" : "") @(item.LinkedClipId is not null ? "bv-clip-chip--linked" : "")"
                                 style="position: absolute; left: @leftPxStr; width: @chipWpx; min-width: @chipWpx; max-width: none"
                                 data-item-id="@item.Id"
                                 draggable="@(track.IsLocked || _trimmingClip != null || _trimmingAudio != null || _trimmingImageClip != null || _movingItem != null ? "false" : "true")"
                                 @onpointerdown="e => OnChipPointerDown(e, captured, track)"
                                 @onclick="e => SelectItemWithModifier(captured, e.CtrlKey || e.MetaKey)"
                                 @ondragstart="() => OnDragStart(captured)"
                                 @ondragend="OnDragEnd"
                                 @ondragover:preventDefault
                                 @ondragover="() => OnDragOver(captured)"
                                 @onpointermove="OnTrimPointerMove"
                                 @onpointerup="OnTrimPointerUp"
                                 @oncontextmenu="e => OpenClipMenu(e, captured)"
                                 @oncontextmenu:preventDefault
                                 title="@ItemTitle(item)">

                                @if (item is VideoClip vc && vc.ThumbnailUrls.Count > 0)
                                {
                                    <div class="bv-clip-chip__thumbstrip">
                                        @* Item #62 phase 170 — @key on the URL itself. Without it
                                           Blazor diffs this list positionally and reuses the same
                                           <img> elements when a lazy thumbnail fill replaces the
                                           strip, so an element can keep a released blob in its src
                                           across the swap. Keying by URL makes a changed strip
                                           replace the elements outright. *@
                                        @foreach (var url in vc.ThumbnailUrls)
                                        {
                                            <img @key="url" class="bv-clip-chip__thumbframe" src="@url" alt="" />
                                        }
                                    </div>
                                }

                                @if (item is ImageClip ic && ic.ThumbnailUrl is not null)
                                {
                                    <img class="bv-clip-chip__thumb" src="@ic.ThumbnailUrl" alt="" draggable="false" />
                                }

                                @if (item is CalloutClip cc)
                                {
                                    <span class="bv-clip-chip__callout-icon">📌</span>
                                    <span class="bv-clip-chip__icon">@CalloutIcon(cc.Shape)</span>
                                }

                                @if (item is AudioClip ac && ac.BlobUrl is not null)
                                {
                                    @* The chip draws the part of the recording this clip plays.
                                       It used to draw all of it however the clip was trimmed, so a
                                       thirty-second excerpt from a three-minute recording showed
                                       the whole three minutes squeezed into its chip, and the two
                                       halves of a split showed the same picture as each other
                                       (2026-09-05 audit, audio-13 and media-11). *@
                                    var chipPeaks = WaveformPeakSlicer.Slice(
                                        ac.WaveformPeaks, ac.Duration, ac.StartTrim, ac.EndTrim);

                                    @* The playhead against the trimmed clip, not against the whole
                                       source, so it lines up with the shape now being drawn. *@
                                    var t         = Playback.State.TimelineTime;
                                    var clipStart = ac.TimelinePosition;
                                    var clipEnd   = ac.TimelinePosition + ac.TrimmedDuration;
                                    var syncProg  = (t >= clipStart && t <= clipEnd && ac.TrimmedDuration > 0)
                                                    ? Math.Clamp((t - clipStart) / ac.TrimmedDuration, 0.0, 1.0)
                                                    : -1.0;
                                    <div class="bv-clip-chip__waveform">
                                        <AudioWaveform BlobUrl="@ac.BlobUrl"
                                                       Peaks="@chipPeaks"
                                                       Height="0"
                                                       ShowControls="false"
                                                       SyncProgress="@syncProg"
                                                       OnPeaksDecoded="@((float[] p) => ac.WaveformPeaks = p)" />
                                    </div>
                                }

                                @if (item is IHasVolumeAutomation volClip)
                                {
                                    <div class="bv-clip-chip__automation">
                                        <VolumeAutomationLane Clip="@volClip"
                                                              ClipId="@item.Id"
                                                              LaneHeight="40" />
                                    </div>
                                }

                                @if (trimOn)
                                {
                                    @if (item is VideoClip chipVc)
                                    {
                                        <div class="bv-trim-handle bv-trim-handle--start"
                                             title="Drag to trim start"
                                             @onpointerdown="e => OnTrimHandlePointerDown(e, chipVc, TrimSide.Start)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick:stopPropagation="true" />
                                        <div class="bv-trim-handle bv-trim-handle--end"
                                             title="Drag to trim end"
                                             @onpointerdown="e => OnTrimHandlePointerDown(e, chipVc, TrimSide.End)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick:stopPropagation="true" />
                                    }
                                    else if (item is AudioClip chipAudio)
                                    {
                                        @* Audio had no handles at all, so the only way to shorten a
                                           sound was to type numbers into the properties panel —
                                           while help said every clip trims by its edges
                                           (2026-09-05 audit, audio-12 and timeline-15). *@
                                        <div class="bv-trim-handle bv-trim-handle--start"
                                             title="Drag to trim start"
                                             @onpointerdown="e => OnAudioTrimHandlePointerDown(e, chipAudio, TrimSide.Start)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick:stopPropagation="true" />
                                        <div class="bv-trim-handle bv-trim-handle--end"
                                             title="Drag to trim end"
                                             @onpointerdown="e => OnAudioTrimHandlePointerDown(e, chipAudio, TrimSide.End)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick:stopPropagation="true" />
                                    }
                                    else if (item is ImageClip chipImg)
                                    {
                                        @* Image clips: start handle shifts TimelinePosition+shrinks Duration; end handle extends/shrinks Duration *@
                                        <div class="bv-trim-handle bv-trim-handle--start"
                                             title="Drag to shift clip start"
                                             @onpointerdown="e => OnImageStartTrimHandlePointerDown(e, chipImg)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick:stopPropagation="true" />
                                        <div class="bv-trim-handle bv-trim-handle--end"
                                             title="Drag to adjust display duration"
                                             @onpointerdown="e => OnImageTrimHandlePointerDown(e, chipImg)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick:stopPropagation="true" />
                                    }
                                }

                                @if (item.IsMediaMissing)
                                {
                                    <span class="bv-clip-chip__missing" title="Media missing — re-link via Add button">⚠</span>
                                }

                                <span class="bv-clip-chip__icon">@ItemIcon(item)</span>
                                <span class="bv-clip-chip__label">@ShortName(ItemTitle(item))</span>
                                <span class="bv-clip-chip__dur">@FormatDuration(ItemDuration(item))</span>

                                <TelerikButton OnClick="() => RemoveItem(track, captured)"
                                               Icon="@SvgIcon.X"
                                               Size="@ThemeConstants.Button.Size.Small"
                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                               Class="bv-clip-chip__remove"
                                               Enabled="@(!track.IsLocked)"
                                               Title="Remove" />
                            </div>

                            @* Between-clip transition insert button — shown when Transitions enabled,
                               there is a next non-Transition clip, and no transition already exists
                               for this clip as the 'from' clip. *@
                            @if (transitionsOn && idx < orderedItems.Count - 1)
                            {
                                // orderedItems no longer contains Transitions at all (see above),
                                // so the very next entry is always the actual next clip.
                                var nextClip = orderedItems[idx + 1];

                                @if (!coveredFromIds.Contains(item.Id))
                                {
                                    var fromId = item.Id;
                                    var toId   = nextClip.Id;
                                    var trkId  = track.Id;
                                    var junction = (trkId, fromId, toId);

                                    <div class="bv-transition-insert-wrap">
                                        <button class="bv-transition-insert"
                                                title="Add transition — drag a style from the Transitions tab, or click to choose"
                                                data-track-id="@trkId"
                                                data-from-id="@fromId"
                                                data-to-id="@toId"
                                                @onclick="() => ToggleStylePicker(junction)">
                                            …
                                        </button>

                                        @if (_openStylePickerFor == junction)
                                        {
                                            <div class="bv-transition-style-picker__backdrop" @onclick="ClosePicker"></div>
                                            <div class="bv-transition-style-picker">
                                                @foreach (var style in _pickerStyles)
                                                {
                                                    var capturedStyle = style;
                                                    <button class="bv-transition-style-picker__item"
                                                            @onclick="() => InsertTransition(trkId, fromId, toId, capturedStyle)">
                                                        @capturedStyle
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        }
                    }

                    @* Transitions (item #57 T1) — absolutely positioned within this same
                       position:relative container, straddling the real cut between their two
                       clips (TimelinePosition/Duration already encode the overlap — see
                       AddTransition). Rendered after the clip loop so they paint on top by
                       default DOM order, no explicit stacking context needed beyond the z-index
                       below (which still keeps the underlying clips' own trim handles, z-index
                       10, grabbable at the very edges). *@
                    @if (transitionsOn)
                    {
                        @foreach (var transition in trackTransitions)
                        {
                            var leftPx  = (transition.TimelinePosition * Timeline.PxPerSecond).ToString("F0", System.Globalization.CultureInfo.InvariantCulture) + "px";
                            var widthPx = (transition.Duration * Timeline.PxPerSecond).ToString("F0", System.Globalization.CultureInfo.InvariantCulture) + "px";
                            var capturedT = transition;

                            var resizingThis = _resizingTransition?.Id == transition.Id;

                            <div class="bv-transition-chip @(_selectedItemId == transition.Id ? "bv-transition-chip--selected" : "") @(resizingThis ? "bv-transition-chip--resizing" : "")"
                                 style="left: @leftPx; width: @widthPx"
                                 data-item-id="@transition.Id"
                                 @onclick="() => SelectItem(capturedT)"
                                 @onpointermove="OnTrimPointerMove"
                                 @onpointerup="OnTrimPointerUp"
                                 @oncontextmenu="e => OpenTransitionMenu(e, track, capturedT)"
                                 @oncontextmenu:preventDefault
                                 title="@ItemTitle(transition): @FormatDuration(transition.Duration)s">
                                @if (!track.IsLocked)
                                {
                                    <div class="bv-transition-resize-handle bv-transition-resize-handle--start"
                                         title="Drag to resize transition"
                                         @onpointerdown="e => OnTransitionResizeHandlePointerDown(e, capturedT, TrimSide.Start)"
                                         @onpointerdown:stopPropagation="true"
                                         @onclick:stopPropagation="true" />
                                    <div class="bv-transition-resize-handle bv-transition-resize-handle--end"
                                         title="Drag to resize transition"
                                         @onpointerdown="e => OnTransitionResizeHandlePointerDown(e, capturedT, TrimSide.End)"
                                         @onpointerdown:stopPropagation="true"
                                         @onclick:stopPropagation="true" />
                                }
                                <span class="bv-transition-chip__icon">…</span>
                                <span class="bv-transition-chip__label">@(resizingThis ? $"{FormatDuration(transition.Duration)}s" : ShortName(ItemTitle(transition)))</span>
                                <TelerikButton OnClick="() => RemoveItem(track, capturedT)"
                                               Icon="@SvgIcon.X"
                                               Size="@ThemeConstants.Button.Size.Small"
                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                               Class="bv-transition-chip__remove"
                                               Enabled="@(!track.IsLocked)"
                                               Title="Remove transition" />
                            </div>
                        }
                    }
                </div>

            </div>

            <!-- Row-height resize handle (item #44) — measures/resizes the immediately-preceding
                 .bv-track via ResizableDivider's own "previousElementSibling" convention, so this
                 must stay directly after .bv-track's closing tag, before the overlay row below. -->
            <ResizableDivider Direction="vertical" OnResize="@(px => OnTrackResize(track.Id, px))" />

            <!-- Overlay layers (Callout/Text/ClipArt) — item #36-adjacent backlog #39: each gets
                 its own row, absolutely positioned by TimelinePosition so items can freely overlap
                 each other and the sequential row's video/audio content in time, unlike the
                 flex-gap layout above (which assumes non-overlapping, front-to-back items and
                 cannot represent overlays at all). A sibling row below .bv-track, not a child of
                 it — .bv-track is itself a horizontal flex row (label | items), so a third child
                 there would render beside .bv-track__items, not below it. Mirrors .bv-track's own
                 120px label-gutter so horizontal position matches the ruler exactly. Ordered
                 highest-LayerIndex-first (newest layer = topmost row), matching "everything added
                 gets its own layer, each layer higher than any added before it." -->
            @if (overlayItems.Count > 0)
            {
                <div class="bv-track bv-track__overlay-row">
                    <div class="bv-track__label bv-track__overlay-gutter"
                         style="height: @(overlayItems.Count * 40)px">
                        @foreach (var item in overlayItems)
                        {
                            var rowIndex = overlayItems.IndexOf(item);
                            var topPx    = rowIndex * 40;
                            <div class="bv-track__overlay-lane-label" style="top: @(topPx)px" title="@(LaneTypeName(item)): @ItemTitle(item)">
                                <span class="bv-track__type-icon">@ItemIcon(item)</span>
                                <span>@LaneTypeName(item)</span>
                            </div>
                        }
                    </div>
                    <div class="bv-track__overlays"
                         style="height: @(overlayItems.Count * 40)px; min-width: @(Timeline.CanvasWidth(Clips.TotalDuration).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))px">
                        @foreach (var item in overlayItems)
                        {
                            var captured  = item;
                            var rowIndex  = overlayItems.IndexOf(item);
                            var leftPx    = (item.TimelinePosition * Timeline.PxPerSecond)
                                .ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
                            var widthPx   = (ItemDuration(item) * Timeline.PxPerSecond)
                                .ToString("F0", System.Globalization.CultureInfo.InvariantCulture);
                            var topPx     = rowIndex * 40;

                            // Drag-to-extend start/end trim (item #28) — Callout/TextOverlay only,
                            // mirroring ImageClip's trim handles: no source in/out points, just a
                            // TimelinePosition + Duration on the timeline.
                            // Clip art is an overlay like the others and had no handles, so a piece of artwork could
                            // only be timed from the properties panel (2026-09-05 audit, audio-12's sibling).
                            var overlayTrimOn = EffectiveOptions.InlineTrimming && item is CalloutClip or TextOverlay or ClipArtClip && !track.IsLocked;
                            var trimmingThisOverlay = _trimmingOverlay?.Id == item.Id || _overlayStartTrimClip?.Id == item.Id;
                            var overlayTrimCls = trimmingThisOverlay
                                ? (_overlayStartTrimClip?.Id == item.Id ? "bv-clip-chip--trimming bv-clip-chip--trimming-start"
                                                                          : "bv-clip-chip--trimming bv-clip-chip--trimming-end")
                                : "";

                            <div class="bv-clip-chip bv-clip-chip--@ChipType(item) bv-clip-chip--overlay @(_selectedItemId == item.Id ? "bv-clip-chip--selected" : "") @(IsMultiSelected(item.Id) ? "bv-clip-chip--multi-selected" : "") @(item.IsMediaMissing ? "bv-clip-chip--missing" : "") @overlayTrimCls"
                                 style="position: absolute; left: @(leftPx)px; top: @(topPx)px; width: @(widthPx)px; height: 40px"
                                 data-item-id="@item.Id"
                                 @onpointerdown="e => OnChipPointerDown(e, captured, track)"
                                 @onpointermove="OnTrimPointerMove"
                                 @onpointerup="OnTrimPointerUp"
                                 @onclick="e => SelectItemWithModifier(captured, e.CtrlKey || e.MetaKey)"
                                 @oncontextmenu="e => OpenClipMenu(e, captured)"
                                 @oncontextmenu:preventDefault
                                 title="@ItemTitle(item)">

                                @if (item is CalloutClip cc)
                                {
                                    <span class="bv-clip-chip__callout-icon">📌</span>
                                    <span class="bv-clip-chip__icon">@CalloutIcon(cc.Shape)</span>
                                }
                                else
                                {
                                    <span class="bv-clip-chip__icon">@ItemIcon(item)</span>
                                }

                                @if (item.IsMediaMissing)
                                {
                                    <span class="bv-clip-chip__missing" title="Media missing — re-link via Add button">⚠</span>
                                }

                                <span class="bv-clip-chip__label">@ShortName(ItemTitle(item))</span>
                                <span class="bv-clip-chip__dur">@FormatDuration(ItemDuration(item))</span>

                                @if (Motion.GetPath(item.Id) is { } motionPath)
                                {
                                    @for (var ki = 0; ki < motionPath.Keyframes.Count; ki++)
                                    {
                                        var kfIndex  = ki;
                                        var isDraggingThis = _draggingKeyframeItem?.Id == item.Id && _draggingKeyframeIndex == kfIndex;
                                        var kfTime   = isDraggingThis ? _kfDragLiveTime : motionPath.Keyframes[ki].Time;
                                        var kfLeftPx = ((kfTime - item.TimelinePosition) * Timeline.PxPerSecond)
                                            .ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                                        <div class="bv-timeline-kf-diamond @(isDraggingThis ? "bv-timeline-kf-diamond--dragging" : "")"
                                             style="left: @(kfLeftPx)px"
                                             title="Keyframe at @FormatDuration(kfTime) — click to select, drag to retime"
                                             @onpointerdown="e => OnKeyframeDiamondPointerDown(e, captured, kfIndex)"
                                             @onpointerdown:stopPropagation="true"
                                             @onclick="() => SelectTimelineKeyframe(captured, kfIndex)"
                                             @onclick:stopPropagation="true" />
                                    }
                                }

                                @if (overlayTrimOn)
                                {
                                    <div class="bv-trim-handle bv-trim-handle--start"
                                         title="Drag to shift start"
                                         @onpointerdown="e => OnOverlayStartTrimHandlePointerDown(e, captured)"
                                         @onpointerdown:stopPropagation="true"
                                         @onclick:stopPropagation="true" />
                                    <div class="bv-trim-handle bv-trim-handle--end"
                                         title="Drag to adjust duration"
                                         @onpointerdown="e => OnOverlayTrimHandlePointerDown(e, captured)"
                                         @onpointerdown:stopPropagation="true"
                                         @onclick:stopPropagation="true" />
                                }

                                <TelerikButton OnClick="() => RemoveItem(track, captured)"
                                               Icon="@SvgIcon.X"
                                               Size="@ThemeConstants.Button.Size.Small"
                                               FillMode="@ThemeConstants.Button.FillMode.Flat"
                                               Class="bv-clip-chip__remove"
                                               Enabled="@(!track.IsLocked)"
                                               Title="Remove" />
                            </div>
                        }
                    </div>
                </div>
            }
        }

        <!-- Playhead inside tracks — aligned with clip area, contained by isolation:isolate -->
        @if (Clips.TotalDuration > 0)
        {
            var phPx = 120 + Playback.State.TimelineTime * Timeline.PxPerSecond;
            <div class="bv-timeline__playhead" style="left: @phPx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)px">
                <div class="bv-timeline__playhead-line"></div>
                <div class="bv-timeline__playhead-head"></div>
            </div>
        }
    </div>

    <!-- Context menus -->

    <TelerikContextMenu @ref="_clipMenu"
                        Data="@_clipMenuItems"
                        TextField="Text"
                        IconField="Icon"
                        SeparatorField="IsSeparator"
                        DisabledField="IsDisabled"
                        OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
    </TelerikContextMenu>

    <TelerikContextMenu @ref="_trackMenu"
                        Data="@_trackMenuItems"
                        TextField="Text"
                        IconField="Icon"
                        SeparatorField="IsSeparator"
                        DisabledField="IsDisabled"
                        OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
    </TelerikContextMenu>

    <TelerikContextMenu @ref="_markerMenu"
                        Data="@_markerMenuItems"
                        TextField="Text"
                        IconField="Icon"
                        SeparatorField="IsSeparator"
                        DisabledField="IsDisabled"
                        OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
    </TelerikContextMenu>

    <!-- Item #57 T4 — its own dedicated menu rather than folding into _clipMenu: a Transition
         has none of _clipMenu's items in common (Duplicate/Split/Speed/Replace Source all
         disabled for it there today) and needs a "Replace ▸ style" list _clipMenu's flat
         BvMenuItem model has no submenu support for; a second flat menu is simpler and safer
         than retrofitting submenus onto the shared model all three other menus also use. -->
    <TelerikContextMenu @ref="_transitionMenu"
                        Data="@_transitionMenuItems"
                        TextField="Text"
                        IconField="Icon"
                        SeparatorField="IsSeparator"
                        DisabledField="IsDisabled"
                        OnClick="@(async (BvMenuItem i) => { if (i.Action is not null) await i.Action(); })">
    </TelerikContextMenu>

</footer>

@code {
    // Audit #4 — typed DOM helpers instead of eval'd source strings; every lookup is null-guarded
    // (see audit #7, where a missing element crashed the whole circuit).
    private IJSObjectReference? _dom;

    private async Task<IJSObjectReference> DomAsync() =>
        _dom ??= await JS.InvokeAsync<IJSObjectReference>(
            "benImportEditorModule", "js/domInterop.js");

    [Parameter] public bool? MultiTrack   { get; set; }
    [Parameter] public bool? AudioTracks  { get; set; }
    /// <summary>Effective options from the parent VideoEditor. Null = use the IOptions value from DI.</summary>
    [Parameter] public VideoEditorOptions? EditorOptions { get; set; }
    [Parameter] public EventCallback<TrackItem>   OnItemSelected     { get; set; }
    [Parameter] public EventCallback<Guid>        OnItemRemoved      { get; set; }
    [Parameter] public EventCallback<Guid>        OnRelinkRequested  { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnBulkDelete { get; set; }
    [Parameter] public EventCallback<(IReadOnlyList<Guid> Ids, double DeltaSeconds)> OnBulkMove { get; set; }

    /// <summary>Raised when a keyframe diamond (item #57 P6) is clicked — seeks the playhead to
    /// the keyframe's own time first, then reports which layer/keyframe so the parent can open/
    /// focus the MotionKeyframeEditor panel on it, mirroring what clicking the same keyframe's dot
    /// on the canvas overlay already does.</summary>
    [Parameter] public EventCallback<(Guid LayerId, string LayerType, int KeyframeIndex, double Time)> OnTimelineKeyframeSelected { get; set; }

 // --- Context menu state ---

    private TelerikContextMenu<BvMenuItem>? _clipMenu;
    private TelerikContextMenu<BvMenuItem>? _trackMenu;
    private TelerikContextMenu<BvMenuItem>? _markerMenu;
    private TelerikContextMenu<BvMenuItem>? _transitionMenu;

    private List<BvMenuItem> _clipMenuItems       = [];
    private List<BvMenuItem> _trackMenuItems      = [];
    private List<BvMenuItem> _markerMenuItems     = [];
    private List<BvMenuItem> _transitionMenuItems = [];

    /// <summary>
    /// Fades a clip up from black at its start, or down to black at its end.
    /// </summary>
    /// <remarks>
    /// The honest replacement for the cross-track crossfade: it is the clip's own property, the
    /// export already renders it, and it survives a save. One second, or a quarter of the clip if
    /// that is shorter.
    /// </remarks>
    private void FadeClip(TrackItem item, bool fadeIn)
    {
        if (item is not VideoClip clip) return;

        var seconds = Math.Min(1.0, clip.EffectiveLength / 4);
        if (seconds <= 0) return;

        Clips.UpdateClipEffects(clip.Id, fadeIn
            ? clip.Effects with { FadeInSeconds  = seconds }
            : clip.Effects with { FadeOutSeconds = seconds });
    }

    private async Task OpenClipMenu(MouseEventArgs e, TrackItem item)
    {
        await SelectItem(item);
        // Inside this clip's own span on the timeline, not "between zero and its length" —
        // which was only the same question for a clip starting at zero.
        var playhead  = Playback.State.TimelineTime;
        var canSplit  = item is VideoClip vc2 &&
                        playhead > vc2.TimelinePosition &&
                        playhead < vc2.TimelinePosition + vc2.TrimmedDuration;
        // A locked track refuses every mutation in the store, silently — which from the menu looked
        // like a broken editor: Duplicate, Split, Separate Audio, Speed, Replace, Remove and Ripple
        // Delete all stayed enabled and all did nothing (2026-09-05 audit, timeline-12).
        var locked    = Clips.FindTrackOf(item.Id)?.IsLocked == true;
        var isMedia   = item is VideoClip or AudioClip;
        // Overlays duplicate now too. Making three matching callouts used to mean building each
        // from scratch (2026-09-05 audit, callouts-15). A transition belongs to the junction
        // between two clips, so a second copy of one has nowhere to be.
        var canDuplicate = item is not Transition;
        var isRemovable = item is not Transition;
        var canSeparateAudio = item is VideoClip vcAudio && vcAudio.MemFsName is not null && !vcAudio.MuteAudio;

        _clipMenuItems =
        [
            new() { Text = "Edit Properties", Icon = SvgIcon.Pencil,
                    Action = () => Task.CompletedTask /* properties panel already opened by SelectItem */ },
            @* One sound can be silenced without losing the level it was at. Dragging its volume
               to zero was the only way, and putting it back meant remembering the number
               (2026-09-05 audit, audio-19). *@
            new() { Text = ClipIsMuted(item) ? "Unmute" : "Mute",
                    Icon = ClipIsMuted(item) ? SvgIcon.VolumeUp : SvgIcon.VolumeMute,
                    Action = () => { Clips.SetClipMuted(item.Id, !ClipIsMuted(item)); return Task.CompletedTask; },
                    IsDisabled = locked || item is not (VideoClip or AudioClip) },
            new() { Text = "Duplicate",  Icon = SvgIcon.Copy,
                    Action = () => { Clips.DuplicateClip(item.Id); return Task.CompletedTask; },
                    IsDisabled = locked || !canDuplicate },
            new() { IsSeparator = true },
            new() { Text = "Split at Playhead", Icon = SvgIcon.Cut,
                    Action = () =>
                    {
                        if (item is VideoClip vc3)
                            // Absolute playhead → the clip's own offset; see
                            // ClipStore.SplitClipAtTimelineTime.
                            Clips.SplitClipAtTimelineTime(vc3.Id, Playback.State.TimelineTime);
                        return Task.CompletedTask;
                    }, IsDisabled = locked || !canSplit },
            new() { Text = "Separate Audio", Icon = SvgIcon.VolumeUp,
                    Action = async () =>
                    {
                        if (item is VideoClip vc4)
                            await SeparateAudioAsync(vc4);
                    }, IsDisabled = locked || !canSeparateAudio },
            @* "Add Crossfade to Overlapping Clip" stood here. It built a cross-track transition,
               which the export turned into a segment longer than the two clips it replaced while
               leaving every later offset measured against the old length — a corrupt render — and
               which the preview never showed at all. A clip's own fade in and out does the same
               job honestly, and both are already persisted and exported (2026-09-05 audit,
               transitions-9). *@
            new() { Text = "Fade In", Icon = SvgIcon.BrightnessContrast,
                    Action = () => { FadeClip(item, fadeIn: true); return Task.CompletedTask; },
                    IsDisabled = locked || item is not VideoClip },
            new() { Text = "Fade Out", Icon = SvgIcon.BrightnessContrast,
                    Action = () => { FadeClip(item, fadeIn: false); return Task.CompletedTask; },
                    IsDisabled = locked || item is not VideoClip },
            new() { IsSeparator = true },
            new() { Text = "Speed: 0.5×", Action = () => { SetSpeed(item, 0.5); return Task.CompletedTask; }, IsDisabled = locked || item is not VideoClip },
            new() { Text = "Speed: 1×",   Action = () => { SetSpeed(item, 1.0); return Task.CompletedTask; }, IsDisabled = locked || item is not VideoClip },
            new() { Text = "Speed: 2×",   Action = () => { SetSpeed(item, 2.0); return Task.CompletedTask; }, IsDisabled = locked || item is not VideoClip },
            new() { IsSeparator = true },
            new() { Text = item.IsMediaMissing ? "Replace Media…" : "Replace Source…",
                    Icon = SvgIcon.Link,
                    Action = async () => await OnRelinkRequested.InvokeAsync(item.Id),
                    IsDisabled = locked || !isMedia },
            new() { IsSeparator = true },
            new() { Text = "Remove",        Icon = SvgIcon.Trash,
                    Action = async () =>
                    {
                        switch (item)
                        {
                            case CalloutClip c:  Clips.RemoveCallout(c.Id); break;
                            case ClipArtClip ca: Clips.RemoveClipArtClip(ca.Id); break;
                            case ImageClip im:   Clips.RemoveClip(im.Id); break;
                            default:             Clips.RemoveClip(item.Id); break;
                        }
                        if (_selectedItemId == item.Id) _selectedItemId = null;
                        _multiSelectedIds.Remove(item.Id);
                        await OnItemRemoved.InvokeAsync(item.Id);
                    }, IsDisabled = locked || !isRemovable },
            new() { Text = "Ripple Delete", Icon = SvgIcon.Minus,
                    Action = async () =>
                    {
                        Clips.RippleDeleteClip(item.Id);
                        if (_selectedItemId == item.Id) _selectedItemId = null;
                        _multiSelectedIds.Remove(item.Id);
                        await OnItemRemoved.InvokeAsync(item.Id);
                    }, IsDisabled = locked || !isMedia },
        ];

        if (_clipMenu is not null)
            await _clipMenu.ShowAsync(e.ClientX, e.ClientY);
    }

    /// <summary>Item #57 T4 — right-click menu for a transition chip: "Replace" with any real
    /// style (flat list, not a true submenu — see the markup comment above <c>_transitionMenu</c>
    /// for why; item #57 T5 grew this list from 6 to 16 styles, still flat) plus Remove.</summary>
    private async Task OpenTransitionMenu(MouseEventArgs e, TimelineTrack track, Transition transition)
    {
        await SelectItem(transition);

        _transitionMenuItems =
        [
            .. _pickerStyles.Select(style => new BvMenuItem
            {
                Text   = $"Replace: {style}",
                Action = () =>
                {
                    Clips.UpdateTransition(transition.Id, style, transition.Duration);
                    return Task.CompletedTask;
                },
                IsDisabled = track.IsLocked,
            }),
            new() { IsSeparator = true },
            new() { Text = "Remove", Icon = SvgIcon.Trash,
                    Action = async () =>
                    {
                        Clips.RemoveTransition(transition.Id);
                        if (_selectedItemId == transition.Id) _selectedItemId = null;
                        await OnItemRemoved.InvokeAsync(transition.Id);
                    }, IsDisabled = track.IsLocked },
        ];

        if (_transitionMenu is not null)
            await _transitionMenu.ShowAsync(e.ClientX, e.ClientY);
    }

    private async Task OpenTrackMenu(MouseEventArgs e, TimelineTrack track)
    {
        var isPrimary = track.Id == Clips.PrimaryVideoTrack?.Id;
        var vTracks   = Clips.Tracks.Where(t => t.Type == TrackType.Video).OrderBy(t => t.Order).ToList();
        var tIdx      = vTracks.FindIndex(t => t.Id == track.Id);
        _trackMenuItems =
        [
            new() { Text = track.IsMuted ? "Unmute Track" : "Mute Track",
                    Icon = track.IsMuted ? SvgIcon.VolumeUp : SvgIcon.VolumeMute,
                    Action = () => { ToggleMute(track); return Task.CompletedTask; } },
            new() { Text = track.IsLocked ? "Unlock Track" : "Lock Track",
                    Icon = SvgIcon.Lock,
                    Action = () => { ToggleLock(track); return Task.CompletedTask; } },
            new() { Text = "Rename Track", Icon = SvgIcon.Pencil,
                    Action = () => { StartEditTrackName(track); return Task.CompletedTask; } },
            new() { IsSeparator = true },
            new() { Text = "Move Up",   Icon = SvgIcon.ChevronUp,
                    IsDisabled = !(EffectiveOptions.MultiTrack && track.Type == TrackType.Video && tIdx > 0),
                    Action = () => { MoveTrackUp(track); return Task.CompletedTask; } },
            new() { Text = "Move Down", Icon = SvgIcon.ChevronDown,
                    IsDisabled = !(EffectiveOptions.MultiTrack && track.Type == TrackType.Video && tIdx >= 0 && tIdx < vTracks.Count - 1),
                    Action = () => { MoveTrackDown(track); return Task.CompletedTask; } },
            new() { IsSeparator = true },
            new() { Text = "Remove Track", Icon = SvgIcon.Trash,
                    Action = () => { RemoveTrack(track); return Task.CompletedTask; },
                    IsDisabled = isPrimary },
        ];

        if (_trackMenu is not null)
            await _trackMenu.ShowAsync(e.ClientX, e.ClientY);
    }

