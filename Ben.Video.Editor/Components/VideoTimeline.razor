    public IReadOnlyList<Guid> GetMultiSelectedIds() => _multiSelectedIds.ToList();

    public void ClearMultiSelection()
    {
        _multiSelectedIds.Clear();
        StateHasChanged();
    }

    private async Task DeleteMultiSelected()
    {
        var ids = _multiSelectedIds.ToList();
        if (ids.Count == 0) return;
        _multiSelectedIds.Clear();
        _selectedItemId = null;
        await OnBulkDelete.InvokeAsync(ids);
    }

    private async Task NudgeMultiSelected(double deltaSeconds)
    {
