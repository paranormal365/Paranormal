    private void SetSpeed(TrackItem item, double speed)
    {
        if (item is VideoClip vc) { vc.Speed = speed; Clips.NotifyChanged(); }
    }

    private async Task SeparateAudioAsync(VideoClip clip)
    {
        if (clip.MemFsName is null || clip.MuteAudio) return;

        // Ensure an audio track exists (create one if none present)
        var audioTrack = Clips.Tracks.FirstOrDefault(t => t.Type == TrackType.Audio)
                         ?? Clips.AddAudioTrack();

        // The clip's own stretch of sound, at the clip's own speed. Both used to be ignored: the
        // whole source stream came out and the new clip was given the trimmed length, so a
        // head-trimmed clip's sound was out of step with its picture from the first frame, and a
        // slowed clip's sound ran at the original speed underneath it (2026-09-05 audit, audio-8).
        var trimStart = clip.StartTrim;
        var trimEnd   = clip.EndTrim > clip.StartTrim ? clip.EndTrim : clip.Duration;

        // The speed change is baked in, so the audio clip is at natural speed from here on and
        // trimming or moving it behaves like any other sound on the timeline.
        var audioMemFs = $"detached_{clip.Id:N}.aac";
        await Ffmpeg.ExtractAudioAsync(clip.MemFsName, audioMemFs, trimStart, trimEnd, clip.Speed);

        // Create a blob URL so WaveSurfer can render the waveform
        var blobUrl = await Ffmpeg.CreatePreviewUrlAsync(audioMemFs, "audio/aac");

        // Build the AudioClip at the same timeline position and duration
        var audioClip = new AudioClip
        {
            Name             = $"{clip.Name} (Audio)",
            TimelinePosition = clip.TimelinePosition,
            Duration         = clip.EffectiveDuration,
            MemFsName        = audioMemFs,
            BlobUrl          = blobUrl,
            OriginalFileName = clip.OriginalFileName,
            // The level the picture was playing at. Separating sound from a clip whose volume had
            // been set put it back at full, which is a change nobody asked for.
            Volume           = clip.Volume,
            VolumeAutomation = [.. clip.VolumeAutomation],
        };

        // Apply mutation + push undo command
        Clips.DetachAudio(clip.Id, audioClip, audioTrack.Id);
    }

    /// <summary>Whether this clip's own sound is silenced.</summary>
    private static bool ClipIsMuted(TrackItem item) => item switch
    {
        VideoClip v => v.MuteAudio,
        AudioClip a => a.MuteAudio,
        _           => false,
    };

    private void ToggleDucking(TimelineTrack track)
        => Clips.SetTrackDucking(track.Id, !track.DucksOthers);

    private void ToggleLock(TimelineTrack track)
    {
        Clips.LockTrack(track.Id, !track.IsLocked);
    }

    protected override void OnInitialized()
    {
        Playback.OnStateChanged  += OnPlaybackChanged;
        Clips.OnChange           += OnClipsChanged;
        PreviewFreshness.OnChanged += OnClipsChanged;
        RenderStatus.OnChanged   += OnClipsChanged;
        Timeline.ZoomScale   = EffectiveOptions.DefaultTimelineZoom;
        Timeline.DisplayMode = EffectiveOptions.TimelineDisplayMode;

        // The ruler counts in the session's own frames. It used to use a constant 30, so at any
        // other frame rate it numbered frames that did not exist and stepping the preview by one
        // did not move it by one (2026-09-05 audit, timeline-17).
        Timeline.Fps = Playback.SessionFps;
        _rippleOverride      = EffectiveOptions.RippleEdit;
    }

    // Backlog #39 (second half): the configured default zoom is a fixed pixels-per-second value,
    // independent of clip length — a short clip forced horizontal scrolling even on a normal
    // window. Auto-fit once, the first time real content appears (duration goes from 0 to >0),
    // so the initial view never needs scrolling for a short clip. Resets when the timeline empties
    // back out (all clips removed) so the next clip added also gets a fresh auto-fit, but never
    // fires again while content already exists — a user's own manual zoom during editing is never
    // overridden.
    private bool   _hasAutoFitted;
    private double _lastKnownDuration;

    private void OnClipsChanged()
    {
        var duration = Clips.TotalDuration;
        if (_lastKnownDuration <= 0 && duration > 0 && !_hasAutoFitted)
        {
            _hasAutoFitted     = true;
            _lastKnownDuration = duration;
            InvokeAsync(FitToViewAsync);
            return;
        }

        if (duration <= 0) _hasAutoFitted = false;
        _lastKnownDuration = duration;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDisplayMode()
    {
        Timeline.DisplayMode = Timeline.DisplayMode == TimelineDisplayMode.Time
            ? TimelineDisplayMode.Frames
            : TimelineDisplayMode.Time;
    }

    public void Dispose()
    {
        Playback.OnStateChanged -= OnPlaybackChanged;
    }

    public async ValueTask DisposeAsync()
    {
        // Audit #4 — release the cached interop module handles. Guarded because teardown races
        // circuit shutdown: once the circuit is gone the module is already unreachable and
        // disposing it throws, which must not surface as an error during a normal navigation.
        if (_dom is not null)
        {
            try { await _dom.DisposeAsync(); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { }
            _dom = null;
        }

        Playback.OnStateChanged  -= OnPlaybackChanged;
        Clips.OnChange           -= OnClipsChanged;
        PreviewFreshness.OnChanged -= OnClipsChanged;
        RenderStatus.OnChanged   -= OnClipsChanged;
        if (_dragBridgeModule is not null)
        {
            try { await _dragBridgeModule.InvokeVoidAsync("unregisterDropTarget"); } catch { }
            try { await _dragBridgeModule.InvokeVoidAsync("unregisterTransitionDropTarget"); } catch { }
            await _dragBridgeModule.DisposeAsync();
        }
        _dropBridgeRef?.Dispose();
        if (_jsModule is not null)
            await _jsModule.DisposeAsync();
    }

    // ── ClipBrowser → track pointer-based drop (item #24) ───────────────────

    private IJSObjectReference?                    _dragBridgeModule;
    private DotNetObjectReference<VideoTimeline>?   _dropBridgeRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _dragBridgeModule = await JS.InvokeAsync<IJSObjectReference>(
                "benImportEditorModule", "js/clipDragBridge.js");
            _dropBridgeRef = DotNetObjectReference.Create(this);
            await _dragBridgeModule.InvokeVoidAsync("registerDropTarget", _dropBridgeRef);
            await _dragBridgeModule.InvokeVoidAsync("registerTransitionDropTarget", _dropBridgeRef);
        }
        catch { /* JS interop unavailable (e.g. prerendering) — pointer-based drop stays inert */ }
    }

    /// <summary>
    /// Completes a pointer-based drag-drop of a transition style from the AssetBrowser's
    /// Transitions gallery onto a brand-new junction (item #57 T3) — called from JS
    /// (<c>clipDragBridge.js</c>) once the pointer lands on a <c>.bv-transition-insert</c>
    /// button. Mirrors <see cref="InsertTransition"/>, just with a style chosen by drag instead
    /// of the style-picker popover.
    /// </summary>
    [JSInvokable]
    public void HandleTransitionDropOnJunction(string trackIdStr, string fromIdStr, string toIdStr, string styleStr)
    {
        if (!Guid.TryParse(trackIdStr, out var trackId)) return;
        if (!Guid.TryParse(fromIdStr, out var fromId)) return;
        if (!Guid.TryParse(toIdStr, out var toId)) return;
        if (!Enum.TryParse<TransitionStyle>(styleStr, out var style)) return;

        InsertTransition(trackId, fromId, toId, style);
    }

    /// <summary>
    /// Completes a pointer-based drag-drop of a transition style onto an EXISTING transition
    /// chip (item #57 T3) — an undoable style replace, called from JS once the pointer lands on
    /// a <c>.bv-transition-chip</c>. Keeps the chip's current duration; only the style changes.
    /// </summary>
    [JSInvokable]
    public void HandleTransitionDropOnChip(string transitionIdStr, string styleStr)
    {
        if (!Guid.TryParse(transitionIdStr, out var transitionId)) return;
        if (!Enum.TryParse<TransitionStyle>(styleStr, out var style)) return;

        var transition = Clips.AllTransitions.FirstOrDefault(t => t.Id == transitionId);
        if (transition is null) return;

        Clips.UpdateTransition(transitionId, style, transition.Duration);
    }

    /// <summary>
    /// Completes a pointer-based drag-drop of a new clip from <c>ClipBrowser</c> onto this track
    /// — the pointer-event replacement for the old native-HTML5-drag browser-source branch of
    /// <see cref="OnTrackDrop"/> (item #24). Called from JS (<c>clipDragBridge.js</c>) once the
    /// user releases the pointer over a track. Mirrors that branch's logic exactly: video clips
    /// only, onto video tracks only, with the same snap/position-resolution pipeline.
    /// </summary>
    [JSInvokable]
    public async Task HandlePointerDropFromJs(string clipIdStr, string trackIdStr, double clientX)
    {
        if (!Guid.TryParse(clipIdStr, out var clipId)) return;
        if (!Guid.TryParse(trackIdStr, out var trackId)) return;

        var track = Clips.Tracks.FirstOrDefault(t => t.Id == trackId);
        if (track is null || track.IsLocked) return;
        if (track.Type != TrackType.Video) return;

        var clip = Clips.Clips.FirstOrDefault(c => c.Id == clipId);
        if (clip is null) return;

        var js   = await GetJsModuleAsync();
        var rect = await js.InvokeAsync<TrackContentRect>("measureTrackContent", track.Id.ToString());

        var dropSeconds = TimelineDropCalculator.DropPositionSeconds(
            clientX, rect.Left, rect.ScrollLeft, Timeline.PxPerSecond);

        var snappedSeconds = EffectiveOptions.Snapping
            ? SnapEngine.Snap(dropSeconds, SnapEngine.CollectSnapTargets(Clips.Tracks, Clips.Markers), EffectiveOptions.SnapThresholdSeconds)
            : dropSeconds;

        var existingClips = track.VideoClips.Select(c => (c.TimelinePosition, c.EffectiveDuration));
        var position = TimelineDropCalculator.ResolvePosition(
            snappedSeconds, clip.EffectiveDuration, existingClips);

        var placed = clip with { TimelinePosition = position };
        Clips.AddClipToTrack(track.Id, placed);
        _ = ScrollItemIntoViewAsync(placed.Id); // item #25 — fire-and-forget, purely cosmetic
    }

    /// <summary>
    /// Scrolls the given item's chip into view if it isn't already fully visible (item #25) —
    /// called after placing a new clip or committing an existing-clip move. Fire-and-forget from
    /// the caller: this is cosmetic, never something a failure here should block or surface to
    /// the user, so exceptions (e.g. JS interop unavailable during prerendering, matching the
    /// same guard already used for the drag-bridge import in OnAfterRenderAsync) are swallowed.
    /// </summary>
    private async Task ScrollItemIntoViewAsync(Guid itemId)
    {
        try
        {
            var js = await GetJsModuleAsync();
            await js.InvokeVoidAsync("scrollItemIntoView", itemId.ToString());
        }
        catch { /* cosmetic only — JS interop unavailable is not worth surfacing */ }
    }

    private void OnPlaybackChanged()
    {
        // Changing the frame rate has to move the ruler with it, not just the preview's stepping.
        Timeline.Fps = Playback.SessionFps;
        InvokeAsync(StateHasChanged);
    }

    private async Task FitToViewAsync()
    {
        if (Clips.TotalDuration <= 0) { Timeline.ResetZoom(); return; }
        try
        {
            var js    = await GetJsModuleAsync();
            var width = await js.InvokeAsync<double>("getTracksAreaWidth");
            if (width > 0)
                Timeline.FitToView(Clips.TotalDuration, width);
            else
                Timeline.ResetZoom();
        }
        catch { Timeline.ResetZoom(); }
        StateHasChanged();
    }

 // --- Ruler scrub state ---

    private bool _rulerScrubbing;

    private void OnRulerPointerDown(PointerEventArgs e)
    {
        if (Clips.TotalDuration <= 0) return;
        _rulerScrubbing = true;
        // pointer capture is handled by @onpointerdown:preventDefault + touch-action:none in CSS;
        // JS setPointerCapture is not needed in Blazor WASM because the browser retains capture
        // as long as preventDefault is called on pointerdown.
        SeekFromRuler(e.OffsetX);
    }

    private void OnRulerPointerMove(PointerEventArgs e)
    {
        if (!_rulerScrubbing) return;
        SeekFromRuler(e.OffsetX);
    }

    private void OnRulerPointerUp(PointerEventArgs e) => _rulerScrubbing = false;

    private void SeekFromRuler(double offsetX)
    {
        // offsetX is relative to the ruler-canvas element (already excludes the gutter)
        var seconds = Math.Max(0, Math.Min(offsetX / Timeline.PxPerSecond, Clips.TotalDuration));
        Playback.RequestSeek(seconds);
    }

