        => Clips.MuteTrack(track.Id, !track.IsMuted);

    // ── Resizable / collapsible track row height (item #44) ─────────────────────
    // Purely visual, UI-only state — doesn't touch track/clip data, doesn't persist
    // to project JSON. Untouched tracks are left alone entirely (no inline style at
    // all — CSS's own min-height:56px still governs them, unchanged); only a track
    // the user has actually resized or collapsed gets an explicit height + overflow:
    // hidden override, so this can never re-introduce phase 94's "content taller
    // than its row" overflow bug for the common, never-touched case.

    private const double MinTrackHeight       = 32;
    private const double MaxTrackHeight       = 240;
    private const double CollapsedTrackHeight = 28;

    private readonly Dictionary<Guid, double> _customTrackHeights = new();
    private readonly HashSet<Guid>            _collapsedTrackIds  = new();

    /// <summary>Non-null only when this track has an explicit height override (resized or
    /// collapsed) — null means "leave it to the default CSS," not "use some default pixel value."</summary>
    private double? GetTrackHeightOverride(Guid trackId)
    {
        if (_collapsedTrackIds.Contains(trackId)) return CollapsedTrackHeight;
        return _customTrackHeights.TryGetValue(trackId, out var h) ? h : null;
    }

    private void OnTrackResize(Guid trackId, int pixels) =>
        _customTrackHeights[trackId] = Math.Clamp(pixels, MinTrackHeight, MaxTrackHeight);

    private void ToggleTrackCollapsed(Guid trackId)
    {
        if (!_collapsedTrackIds.Remove(trackId))
            _collapsedTrackIds.Add(trackId);
    }

