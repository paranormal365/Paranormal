    // ── Transition style picker (item #57 T3 — replaces the old hardcoded-Fade insert) ──────

    private (Guid TrackId, Guid FromId, Guid ToId)? _openStylePickerFor;
    private static readonly List<TransitionStyle> _pickerStyles =
        Enum.GetValues<TransitionStyle>().Where(s => s != TransitionStyle.Cut).ToList();

    private void ToggleStylePicker((Guid TrackId, Guid FromId, Guid ToId) junction) =>
        _openStylePickerFor = _openStylePickerFor == junction ? null : junction;

    private void ClosePicker() => _openStylePickerFor = null;

    private void InsertTransition(Guid trackId, Guid fromId, Guid toId, TransitionStyle style = TransitionStyle.Fade)
    {
        Clips.AddTransition(trackId, fromId, toId, style, 1.0);
        _openStylePickerFor = null;
    }

    /// <summary>
    /// Finds a VideoClip on a different video track that overlaps <paramref name="clip"/> in
    /// time and isn't already linked to it by a transition — the candidate for
    /// "Add Crossfade to Overlapping Clip" in the clip context menu.
    /// </summary>
    private VideoClip? FindCrossTrackOverlapCandidate(VideoClip clip)
    {
        var clipTrack = Clips.FindTrackOf(clip.Id);
        if (clipTrack is null) return null;

        var clipEnd = clip.TimelinePosition + clip.TrimmedDuration;
        var linkedIds = Clips.AllTransitions
            .Where(t => t.FromClipId == clip.Id || t.ToClipId == clip.Id)
            .SelectMany(t => new[] { t.FromClipId, t.ToClipId })
            .ToHashSet();

        return Clips.VideoTracks
            .Where(t => t.Id != clipTrack.Id)
            .SelectMany(t => t.VideoClips)
            .FirstOrDefault(other =>
                !linkedIds.Contains(other.Id) &&
                other.TimelinePosition < clipEnd &&
                other.TimelinePosition + other.TrimmedDuration > clip.TimelinePosition);
    }

    /// <summary>Where a new overlay goes — one answer for all three kinds.</summary>
    /// <remarks>
    /// See <see cref="OverlayPlacement"/> for why this is not three separate calculations
    /// (2026-09-05 audit, titles-8, callouts-7 and phase 11).
    /// </remarks>
    private OverlayPlacement NewOverlayPlacement() =>
        OverlayPlacement.AtPlayhead(Playback.State.TimelineTime, Clips.TotalDuration);

    private void AddTextOverlay()
    {
        var placement = NewOverlayPlacement();
        var overlay   = new TextOverlay
        {
            Name             = "New Text",
            Text             = "New Text",
            TimelinePosition = placement.Position,
            Duration         = placement.Duration,
        };
        Clips.AddTextOverlay(overlay);
    }

    private void AddCalloutClip()
    {
        // TimelineTime, not CurrentTime: in clip preview the media clock counts from the selected
        // clip's own start, so a callout added there landed earlier than the playhead by exactly
        // that clip's start — right only for a clip beginning at zero, which is why it looked
        // correct (2026-09-05 audit, phase 11).
        var placement = NewOverlayPlacement();
        var clip      = new CalloutClip
        {
            Name             = "New Callout",
            TimelinePosition = placement.Position,
            Duration         = placement.Duration,
        };
        Clips.AddCallout(clip);
    }

 // --- Drag-and-drop reorder ---

    private void OnDragStart(TrackItem item)
    {
        _draggingId   = item.Id;
        _draggingItem = item;
    }

    private void OnDragEnd()
    {
        _draggingId   = null;
        _draggingItem = null;
        // Safety net for #27 — see FinalizeMove's doc comment.
        FinalizeMove();
    }

    private void OnDragOver(TrackItem target)
    {
        if (_draggingItem is null || _draggingItem.Id == target.Id) return;

        // Find the track that owns the target
        var track = Clips.Tracks.FirstOrDefault(t => t.Items.Any(i => i.Id == target.Id));
        if (track is null) return;

        var items = track.Items.OrderBy(i => i.Order).ToList();
        var fromIndex = items.FindIndex(i => i.Id == _draggingItem.Id);
        var toIndex   = items.FindIndex(i => i.Id == target.Id);

        if (fromIndex < 0 || toIndex < 0 || fromIndex == toIndex) return;

        items.RemoveAt(fromIndex);
        items.Insert(toIndex, _draggingItem);

        Clips.ReorderTrackItems(track.Id, items);
    }

    private async Task OnTrackDragEnterAsync(DragEventArgs _, TimelineTrack track)
    {
        // Only highlight when a browser-source drag is active (_draggingItem is null = not a reorder)
        if (_draggingItem is not null) return;
        if (track.IsLocked) return;
        if (_dropTargetTrackId != track.Id)
        {
            _dropTargetTrackId = track.Id;
            _dragEnterCount    = 0;
            _snapGuidePx       = null;

            // Cache the track content rect once per drag enter (avoids repeated JS calls in dragover)
            try
            {
                var js = await GetJsModuleAsync();
                _cachedTrackRect = await js.InvokeAsync<TrackContentRect>(
                    "measureTrackContent", track.Id.ToString());
            }
            catch { _cachedTrackRect = null; }

            // Build snap targets from all markers and clip edges
            if (EffectiveOptions.Snapping)
                _snapTargets = SnapEngine.CollectSnapTargets(Clips.Tracks, Clips.Markers);
        }
        _dragEnterCount++;
    }

    private void OnTrackDragLeave(TimelineTrack track)
    {
        if (_draggingItem is not null) return;
        if (_dropTargetTrackId != track.Id) return;
        _dragEnterCount--;
        if (_dragEnterCount <= 0)
        {
            _dropTargetTrackId = null;
            _dragEnterCount    = 0;
            _snapGuidePx       = null;
            _cachedTrackRect   = null;
        }
    }

    private void OnTrackDragOver(DragEventArgs e, TimelineTrack track)
    {
        // Keep the snap guide in sync with the cursor position — runs synchronously on every dragover
        if (!EffectiveOptions.Snapping || _cachedTrackRect is null || Clips.TotalDuration <= 0)
        {
            _snapGuidePx = null;
            return;
        }

        var raw    = TimelineDropCalculator.DropPositionSeconds(e.ClientX, _cachedTrackRect.Left, _cachedTrackRect.ScrollLeft, Timeline.PxPerSecond);
        var target = SnapEngine.ActiveSnapTarget(raw, _snapTargets, EffectiveOptions.SnapThresholdSeconds);

        _snapGuidePx = target.HasValue
            ? target.Value * Timeline.PxPerSecond
            : null;
    }

    /// <summary>
    /// Handles the drop end of the native-HTML5-drag same-track/cross-track item **reorder**
    /// gesture only (see <see cref="OnDragStart"/>/<see cref="OnDragOver"/>) — <c>_draggingItem</c>
    /// is non-null exactly when that gesture is active. Dragging a *new* clip in from
    /// <c>ClipBrowser</c> is a separate, pointer-based path now (item #24) — see
    /// <see cref="HandlePointerDropFromJs"/> — which never sets <c>_draggingItem</c> and so never
    /// reaches this method at all; it no longer needs a browser-source-drop branch here.
    /// </summary>
    private void OnTrackDrop(DragEventArgs e, TimelineTrack track)
    {
        // Clear drop-target highlight and snap guide
        _dropTargetTrackId = null;
        _dragEnterCount    = 0;
        _snapGuidePx       = null;
        _cachedTrackRect   = null;

        _draggingId   = null;
        _draggingItem = null;
    }

    // Small record to deserialize the JS measureTrackContent result
    private sealed record TrackContentRect(double Left, double Width, double ScrollLeft);

    // -- Inline trim drag --------------------------------------------------------

    private async Task OnTrimHandlePointerDown(PointerEventArgs e, VideoClip clip, TrimSide side)
    {
        _trimmingClip      = clip;
        _trimmingSide      = side;
        _trimDragStartX    = e.ClientX;
        _trimOriginalStart = clip.StartTrim;
        _trimOriginalEnd   = clip.EndTrim > 0 ? clip.EndTrim : clip.Duration;
        try
        {
            var js = await GetJsModuleAsync();
            _trimChipWidthPx = await js.InvokeAsync<double>("measureWidth", (object?)null);
        }
        catch { _trimChipWidthPx = 0; }
        if (_trimChipWidthPx <= 0) _trimChipWidthPx = 160.0;
        await CapturePointerAsync(e);
    }

    /// <summary>Starts an edge-drag trim of an audio chip.</summary>
    private async Task OnAudioTrimHandlePointerDown(PointerEventArgs e, AudioClip clip, TrimSide side)
    {
        _trimmingAudio     = clip;
        _trimmingSide      = side;
        _trimDragStartX    = e.ClientX;
        _trimOriginalStart = clip.StartTrim;
        _trimOriginalEnd   = clip.EndTrim > 0 ? clip.EndTrim : clip.Duration;
        await CapturePointerAsync(e);
    }

    /// <summary>Item #57 T4 — starts an edge-drag resize of a transition chip's Duration. Caches
    /// the two adjacent clips' own durations up front so <see cref="OnTrimPointerMove"/> can
    /// clamp locally every frame without re-walking the track on each pointermove.</summary>
    private async Task OnTransitionResizeHandlePointerDown(PointerEventArgs e, Transition transition, TrimSide side)
    {
        var track = Clips.FindTrackOf(transition.Id);
        if (track is null || track.IsLocked) return;

        var fromItem = track.Items.FirstOrDefault(i => i.Id == transition.FromClipId);
        var toItem   = track.Items.FirstOrDefault(i => i.Id == transition.ToClipId);
        if (fromItem is null || toItem is null) return;

        _resizingTransition               = transition;
        _resizingTransitionSide           = side;
        _transitionResizeStartX           = e.ClientX;
        _transitionResizeOriginalDuration = transition.Duration;
        _transitionResizeFromEndSeconds   = fromItem.TimelinePosition + (fromItem is VideoClip fromVc ? fromVc.TrimmedDuration : fromItem.Duration);
        _transitionResizeFromDur          = fromItem is VideoClip fvc ? fvc.TrimmedDuration : fromItem.Duration;
        _transitionResizeToDur            = toItem   is VideoClip tvc ? tvc.TrimmedDuration : toItem.Duration;

        await CapturePointerAsync(e);
    }

    private void OnTrimPointerMove(PointerEventArgs e)
    {
        // Transition chip edge resize (item #57 T4) — see the field-group comment above for why
        // this stays a local, un-pushed mutation until pointerup.
        if (_resizingTransition is not null)
        {
            var deltaSec  = (e.ClientX - _transitionResizeStartX) / Timeline.PxPerSecond;
            var requested = _resizingTransitionSide == TrimSide.End
                ? _transitionResizeOriginalDuration + deltaSec
                : _transitionResizeOriginalDuration - deltaSec;
            var newDuration = TransitionDurationClamp.Clamp(requested, _transitionResizeFromDur, _transitionResizeToDur);

            _resizingTransition.Duration         = newDuration;
            _resizingTransition.TimelinePosition = _transitionResizeFromEndSeconds - newDuration;
            StateHasChanged();
            return;
        }

        // Video clip trim
        if (_trimmingClip is not null)
        {
            var deltaX   = e.ClientX - _trimDragStartX;
            var duration = _trimOriginalEnd - _trimOriginalStart;
            if (duration <= 0) return;
            var deltaSec = deltaX / Timeline.PxPerSecond;
            double newStart = _trimOriginalStart;
            double newEnd   = _trimOriginalEnd;
            if (_trimmingSide == TrimSide.Start)
                newStart = Math.Clamp(_trimOriginalStart + deltaSec, 0, newEnd - 0.1);
            else
                newEnd   = Math.Clamp(_trimOriginalEnd + deltaSec, newStart + 0.1, _trimmingClip.Duration);
            // Live only. One undo entry per pointermove made a two-second drag leave dozens of
            // steps on the stack, so undoing a trim meant pressing Ctrl+Z until something moved
            // (2026-09-05 audit, timeline-6). CommitTrim records the gesture once at pointerup.
            Clips.SetTrimLive(_trimmingClip.Id, newStart, newEnd);
            return;
        }

        // Audio clip trim — the same gesture as a video clip's, against its own source length.
        if (_trimmingAudio is not null)
        {
            var deltaX   = e.ClientX - _trimDragStartX;
            var duration = _trimOriginalEnd - _trimOriginalStart;
            if (duration <= 0) return;
            var deltaSec = deltaX / Timeline.PxPerSecond;
            double newStart = _trimOriginalStart;
            double newEnd   = _trimOriginalEnd;
            if (_trimmingSide == TrimSide.Start)
                newStart = Math.Clamp(_trimOriginalStart + deltaSec, 0, newEnd - 0.1);
            else
                newEnd   = Math.Clamp(_trimOriginalEnd + deltaSec, newStart + 0.1, _trimmingAudio.Duration);
            Clips.SetTrimLive(_trimmingAudio.Id, newStart, newEnd);
            return;
        }

        // Image clip duration drag (end handle)
        if (_trimmingImageClip is not null)
        {
            var deltaX   = e.ClientX - _trimDragStartX;
            var deltaSec = deltaX / Timeline.PxPerSecond;
            var newDur   = Math.Max(0.1, _imageOriginalDuration + deltaSec);
            Clips.UpdateImageDuration(_trimmingImageClip.Id, newDur);
            return;
        }

        // Image clip start trim (start handle — shifts position forward, shrinks duration)
        if (_imageStartTrimClip is not null)
        {
            var deltaX      = e.ClientX - _trimDragStartX;
            var deltaSec    = deltaX / Timeline.PxPerSecond;
            var newPosition = Math.Max(0, _imageStartOriginalPosition + deltaSec);
            var newDuration = Math.Max(0.1, _imageStartOriginalDuration - (newPosition - _imageStartOriginalPosition));
            _imageStartTrimClip.TimelinePosition = newPosition;
            Clips.UpdateImageDuration(_imageStartTrimClip.Id, newDuration);
            return;
        }

        // Overlay (Callout/TextOverlay) end handle — extends/shrinks Duration (item #28)
        if (_trimmingOverlay is not null)
        {
            var deltaX   = e.ClientX - _trimDragStartX;
            var deltaSec = deltaX / Timeline.PxPerSecond;
            var newDur   = Math.Max(0.1, _overlayOriginalDuration + deltaSec);
            ApplyOverlayDuration(_trimmingOverlay, newDur);
            return;
        }

        // Overlay start handle — shifts position forward, shrinks duration (item #28)
        if (_overlayStartTrimClip is not null)
        {
            var deltaX      = e.ClientX - _trimDragStartX;
            var deltaSec    = deltaX / Timeline.PxPerSecond;
            var newPosition = Math.Max(0, _overlayStartOriginalPosition + deltaSec);
            var newDuration = Math.Max(0.1, _overlayStartOriginalDuration - (newPosition - _overlayStartOriginalPosition));
            _overlayStartTrimClip.TimelinePosition = newPosition;
            ApplyOverlayDuration(_overlayStartTrimClip, newDuration);
            return;
        }

        // Keyframe diamond retime (item #57 P6) — live preview only (MotionKeyframe is an
        // immutable record, so there's nothing to mutate in place the way a plain TrackItem field
        // can be); clamped to the layer's own visible span on the timeline. The one authoritative
        // Motion.MoveKeyframeTime commit happens once, at pointerup, below.
        if (_draggingKeyframeItem is not null)
        {
            var item     = _draggingKeyframeItem;
            var deltaSec = (e.ClientX - _kfDragStartX) / Timeline.PxPerSecond;
            var minTime  = item.TimelinePosition;
            var maxTime  = item.TimelinePosition + ItemDuration(item);
            _kfDragLiveTime = Math.Clamp(_kfDragOriginalTime + deltaSec, minTime, maxTime);
            StateHasChanged();
            return;
        }

        // Body drag — move TimelinePosition (live preview, no undo entry yet)
        if (_movingItem is not null)
        {
            // Cross-track vertical move (item #25) — only track which row is hovered, for visual
            // feedback (a highlighted row). The actual track-membership change happens once, at
            // drop, in FinalizeMove/ClipStore.CommitDraggedPositionAndTrack — relocating the item
            // between tracks' Items lists mid-drag would move its chip into a different track's
            // @foreach, destroying and recreating its DOM element and breaking the pointer
            // capture the rest of this drag depends on (same class of bug as #27, a new trigger).
            if (_moveTrackRows.Count > 0)
            {
                var hovered = _moveTrackRows.FirstOrDefault(r => e.ClientY >= r.Top && e.ClientY <= r.Bottom);
                _moveHoverTrackId = hovered is not null && Guid.TryParse(hovered.TrackId, out var hoveredTrackId)
                    ? hoveredTrackId
                    : null;
            }

            // Clamp, snap and snap-guide are one calculation, and it lives in TimelineDragSession
            // so it can be checked without a pointer (2026-09-05 audit, phase 11).
            var dragged = (_moveSession ?? TimelineDragSession.Begin(
                    _moveDragStartX, _moveOriginalPosition, Timeline.PxPerSecond))
                .Move(e.ClientX, _moveSnapTargets, EffectiveOptions.Snapping,
                      EffectiveOptions.SnapThresholdSeconds);

            _movingItem.TimelinePosition = dragged.Position;
            _snapGuidePx                 = dragged.SnapGuidePx;
            StateHasChanged();
        }
    }

    private void OnTrimPointerUp(PointerEventArgs e)
    {
        // One undo entry for the whole gesture, recorded from where the drag started. Every
        // pointermove used to push its own (2026-09-05 audit, timeline-6).
        if (_trimmingClip is { } trimmed)
            Clips.CommitTrim(trimmed.Id, _trimOriginalStart, _trimOriginalEnd);
        else if (_trimmingAudio is { } trimmedAudio)
            Clips.CommitTrim(trimmedAudio.Id, _trimOriginalStart, _trimOriginalEnd);

        _trimmingClip        = null;
        _trimmingAudio       = null;
        _trimmingImageClip   = null;
        _imageStartTrimClip  = null;
        _trimmingOverlay     = null;
        _overlayStartTrimClip = null;

        // Item #57 P6 — the one authoritative retime commit, only if the keyframe actually moved
        // (a plain click that never crossed the retime path leaves _kfDragLiveTime == the original
        // time, so this is a no-op then — SelectTimelineKeyframe's sibling @onclick handles that
        // case instead).
        if (_draggingKeyframeItem is not null)
        {
            var item = _draggingKeyframeItem;
            _draggingKeyframeItem = null;
            if (Math.Abs(_kfDragLiveTime - _kfDragOriginalTime) > 0.001)
                Motion.MoveKeyframeTime(item.Id, _kfDragOriginalTime, _kfDragLiveTime);
            _draggingKeyframeIndex = -1;
        }

        // Item #57 T4 — the one authoritative, undoable commit for the whole resize gesture.
        // Re-derives everything fresh via Clips.UpdateTransition (which recomputes
        // TimelinePosition itself from current state) rather than trusting the live-preview
        // mutation's own cached numbers, so a stale cache can never leave the model wrong even
        // if something else changed the adjacent clips mid-drag.
        if (_resizingTransition is not null)
        {
            var transition = _resizingTransition;
            _resizingTransition = null;
            // The original duration, not the one the live drag just wrote — otherwise the undo step
            // records no change at all and undoing a resize does nothing (2026-09-05 audit,
            // transitions-6).
            try { Clips.CommitTransitionResize(transition.Id, _transitionResizeOriginalDuration); }
            catch { /* transition or track vanished mid-drag — nothing to commit */ }
        }

        FinalizeMove();
    }

    /// <summary>
    /// A drag that ended on top of another clip, with ripple off — the host asks what to do.
    /// </summary>
    /// <param name="Item">The clip that was dragged.</param>
    /// <param name="TrackId">The track it was dropped on.</param>
    /// <param name="Position">Where it was dropped.</param>
    /// <param name="OriginalPosition">Where it started, to put it back on Cancel.</param>
    /// <param name="OriginalTrackId">The track it came from, when the drop crossed tracks.</param>
    public sealed record DropConflict(
        TrackItem Item, Guid TrackId, double Position, double OriginalPosition, Guid? OriginalTrackId);

    /// <summary>Raised when a drop lands on an occupied spot and nobody has said what that means.</summary>
    [Parameter] public EventCallback<DropConflict> OnDropConflict { get; set; }

    /// <summary>Commits (or no-ops, if it never actually moved) and clears an in-progress
    /// body-drag. Called from the normal pointerup path, and also as a fallback from
    /// <see cref="OnDragEnd"/> — see #27: if native drag-and-drop ever wins the race against
    /// the draggable="false" gate below, the browser suppresses pointerup delivery to the chip
    /// entirely, which would otherwise leave <see cref="_movingItem"/> stuck set forever (the
    /// clip visually stays in "moving" state and can never be dragged again).</summary>
    private void FinalizeMove()
    {
        if (_movingItem is null) return;
        var movedItemId = _movingItem.Id;
        var targetTrackId = _moveHoverTrackId is { } hovered && hovered != _moveOriginalTrackId
            ? hovered
            : (Guid?)null;
        // A drop onto occupied ground is a decision, and with ripple off it is the person's to
        // make: Insert pushes what is there, Overwrite replaces it. With ripple on they have
        // already said "close the gaps", so the drop inserts without asking. Nothing overlaps
        // either way — the store refuses to write one (2026-09-05 audit, F5).
        var landingTrack = Clips.Tracks.FirstOrDefault(t => t.Id == (targetTrackId ?? _moveItemTrackId));
        var conflicted   = !_rippleOverride
                        && landingTrack is not null
                        && TrackLayout.IsSequential(_movingItem)
                        && TrackLayout.Overlaps(landingTrack, _movingItem.TimelinePosition,
                                                _movingItem.EffectiveLength, _movingItem.Id);

        if (conflicted && OnDropConflict.HasDelegate)
        {
            var conflict = new DropConflict(
                _movingItem, landingTrack!.Id, _movingItem.TimelinePosition,
                _moveOriginalPosition, _moveOriginalTrackId);

            // Put it back until they answer; the handler applies whichever they choose.
            _movingItem.TimelinePosition = _moveOriginalPosition;
            _ = OnDropConflict.InvokeAsync(conflict);
        }
        else if (targetTrackId.HasValue && _moveOriginalTrackId.HasValue)
            Clips.CommitDraggedPositionAndTrack(_movingItem.Id, _moveOriginalTrackId.Value, _moveOriginalPosition, targetTrackId);
        else if (_rippleOverride)
            Clips.RippleCommitDraggedPosition(_movingItem.Id, _moveOriginalPosition);
        else
            Clips.CommitDraggedPosition(_movingItem.Id, _moveOriginalPosition);
        _ = ScrollItemIntoViewAsync(movedItemId); // item #25 — fire-and-forget, purely cosmetic
        _movingItem           = null;
        _moveSession          = null;
        _moveItemTrackId      = null;
        _moveOriginalTrackId  = null;
        _moveHoverTrackId     = null;
        _moveTrackRows        = [];
        _moveSnapTargets      = [];
        _snapGuidePx          = null;
    }

    // ── Middle-drag (move clip position) ──────────────────────────────────────

    private TrackItem? _movingItem;
    private double     _moveOriginalPosition;
    private double     _moveDragStartX;

    /// <summary>The live body drag, started at pointerdown; null between gestures.</summary>
    private TimelineDragSession? _moveSession;
    private bool       _rippleOverride; // initialized from VideoEditorOptions.RippleEdit
    private Guid?       _moveItemTrackId;
    private Guid?       _moveOriginalTrackId;
    private Guid?       _moveHoverTrackId; // item #25 — row currently hovered during a cross-track drag, visual only
    private IReadOnlyList<double>       _moveSnapTargets = [];
    private IReadOnlyList<TrackRowRect> _moveTrackRows   = [];

    private sealed record TrackRowRect(string TrackId, double Top, double Bottom);

    private async Task OnChipPointerDown(PointerEventArgs e, TrackItem item, TimelineTrack track)
    {
        // Only left button; only when InlineTrimming is on; trim handles stop propagation
        // so this fires only for the chip body (middle zone).
        if (e.Button != 0 || !EffectiveOptions.InlineTrimming || track.IsLocked) return;
        _movingItem           = item;
        _moveOriginalPosition = item.TimelinePosition;
        _moveDragStartX       = e.ClientX;
        _moveSession          = TimelineDragSession.Begin(e.ClientX, item.TimelinePosition, Timeline.PxPerSecond);
        _moveItemTrackId      = track.Id;
        _moveOriginalTrackId  = track.Id;
        _moveSnapTargets      = EffectiveOptions.Snapping
            ? SnapEngine.CollectSnapTargets(Clips.Tracks, Clips.Markers, excludeItemId: item.Id)
            : [];

        // Cross-track vertical drag (item #25) — only VideoClip/AudioClip move freely between
        // same-type tracks; overlay items (Callout/Text/ClipArt) stay pinned to their owning
        // video track's overlay lane, so there's nothing to measure for them.
        _moveTrackRows = [];
        if (EffectiveOptions.MultiTrack && item is VideoClip or AudioClip)
        {
            try
            {
                var js   = await GetJsModuleAsync();
                var rows = await js.InvokeAsync<TrackRowRect[]>("measureAllTrackRows");
                var sameTypeTrackIds = Clips.Tracks
                    .Where(t => t.Type == track.Type)
                    .Select(t => t.Id.ToString())
                    .ToHashSet();
                _moveTrackRows = rows.Where(r => sameTypeTrackIds.Contains(r.TrackId)).ToList();
            }
            catch { _moveTrackRows = []; }
        }

        await CapturePointerAsync(e);
    }

    // Image clips: only the end handle adjusts display duration
    private ImageClip? _trimmingImageClip;
    private double     _imageOriginalDuration;

    private async Task OnImageTrimHandlePointerDown(PointerEventArgs e, ImageClip clip)
    {
        _trimmingImageClip     = clip;
        _trimmingClip          = null;
        _trimDragStartX        = e.ClientX;
        _imageOriginalDuration = clip.Duration;
        try
        {
            var js = await GetJsModuleAsync();
            _trimChipWidthPx = await js.InvokeAsync<double>("measureWidth", (object?)null);
        }
        catch { _trimChipWidthPx = 0; }
        if (_trimChipWidthPx <= 0) _trimChipWidthPx = 160.0;
        await CapturePointerAsync(e);
    }

    // Start-trim for image clips: moves the TimelinePosition forward and shrinks Duration
    private ImageClip?  _imageStartTrimClip;
    private double      _imageStartOriginalPosition;
    private double      _imageStartOriginalDuration;

    private async Task OnImageStartTrimHandlePointerDown(PointerEventArgs e, ImageClip clip)
    {
        _imageStartTrimClip          = clip;
        _trimmingImageClip           = null;
        _trimmingClip                = null;
        _trimDragStartX              = e.ClientX;
        _imageStartOriginalPosition  = clip.TimelinePosition;
        _imageStartOriginalDuration  = clip.Duration;
        await CapturePointerAsync(e);
    }

    // Overlay items (CalloutClip/TextOverlay) — no source in/out points, just TimelinePosition +
    // Duration on the timeline. End handle adjusts duration directly; start handle shifts
    // TimelinePosition forward and shrinks duration to compensate (item #28, mirrors ImageClip above).
    private TrackItem? _trimmingOverlay;
    private double     _overlayOriginalDuration;

    private async Task OnOverlayTrimHandlePointerDown(PointerEventArgs e, TrackItem clip)
    {
        _trimmingOverlay         = clip;
        _overlayStartTrimClip    = null;
        _trimDragStartX          = e.ClientX;
        _overlayOriginalDuration = clip.Duration;
        await CapturePointerAsync(e);
    }

    private TrackItem? _overlayStartTrimClip;
    private double     _overlayStartOriginalPosition;
    private double     _overlayStartOriginalDuration;

    private async Task OnOverlayStartTrimHandlePointerDown(PointerEventArgs e, TrackItem clip)
    {
        _overlayStartTrimClip        = clip;
        _trimmingOverlay             = null;
        _trimDragStartX              = e.ClientX;
        _overlayStartOriginalPosition = clip.TimelinePosition;
        _overlayStartOriginalDuration = clip.Duration;
        await CapturePointerAsync(e);
    }

    /// <summary>Applies a live (no-undo) duration change to a CalloutClip or TextOverlay during
    /// an inline-trim drag — mirrors <see cref="ClipStore.UpdateImageDuration"/> for ImageClip.</summary>
    private void ApplyOverlayDuration(TrackItem item, double duration)
    {
        switch (item)
        {
            case CalloutClip:
                Clips.UpdateCallout(item.Id, c => c.Duration = duration);
                break;
            case TextOverlay to:
                Clips.UpdateTextOverlay(to with { Duration = duration });
                break;
            case ClipArtClip:
                Clips.UpdateClipArtClip(item.Id, c => c.Duration = duration);
                break;
        }
    }

    // ── Keyframe diamonds (item #57 P6) ─────────────────────────────────────────
    // Live drag mutates the path directly via MoveKeyframeTime on every pointermove (matching
    // MotionKeyframeService's own no-undo-mid-gesture style — its keyframe mutations aren't wired
    // into ClipStore's undo stack at all yet, a pre-existing gap tracked separately as item #63,
    // not something this phase can fix incidentally). A plain click (no real movement) is handled
    // by the sibling @onclick below instead — SelectTimelineKeyframe — the same "separate @onclick
    // alongside @onpointerdown" pattern this file already uses for chip body-drag vs. selection.

    private TrackItem? _draggingKeyframeItem;
    private int        _draggingKeyframeIndex = -1;
    private double     _kfDragStartX;
    private double     _kfDragOriginalTime;
    private double     _kfDragLiveTime;

    private async Task OnKeyframeDiamondPointerDown(PointerEventArgs e, TrackItem item, int keyframeIndex)
    {
        var track = Clips.FindTrackOf(item.Id);
        if (track is null || track.IsLocked) return;
        var path = Motion.GetPath(item.Id);
        if (path is null || keyframeIndex < 0 || keyframeIndex >= path.Keyframes.Count) return;

        _draggingKeyframeItem  = item;
        _draggingKeyframeIndex = keyframeIndex;
        _kfDragStartX          = e.ClientX;
        _kfDragOriginalTime    = path.Keyframes[keyframeIndex].Time;
        _kfDragLiveTime        = _kfDragOriginalTime;
        await CapturePointerAsync(e);
    }

    /// <summary>Click (not drag) on a keyframe diamond — seeks the playhead to the keyframe's own
    /// time and reports it upward so the parent can open/focus the MotionKeyframeEditor panel.
    /// Uses the keyframe's actual current time from <see cref="Motion"/> rather than any live drag
    /// state, so a plain click always selects the real, settled keyframe.</summary>
    private async Task SelectTimelineKeyframe(TrackItem item, int keyframeIndex)
    {
        var path = Motion.GetPath(item.Id);
        if (path is null || keyframeIndex < 0 || keyframeIndex >= path.Keyframes.Count) return;

        var time = path.Keyframes[keyframeIndex].Time;
        Playback.RequestSeek(time);
        await OnTimelineKeyframeSelected.InvokeAsync((item.Id, LayerTypeOf(item), keyframeIndex, time));
    }

    private static string LayerTypeOf(TrackItem item) => item switch
    {
        CalloutClip => "CalloutClip",
        ClipArtClip => "ClipArtClip",
        TextOverlay => "TextOverlay",
        _           => string.Empty,
    };

 // --- Helpers ---

    private string RegionTooltip(RenderRegion region)
    {
        var item = Clips.PrimaryVideoTrack.Items.FirstOrDefault(i => i.Id == region.ClipId);
        var clipName = item is not null ? ItemTitle(item) : "Clip";
        var state = region.State switch
        {
            RenderRegionState.Fine           => "rendered — matches cached preview",
            RenderRegionState.RenderingFine  => $"rendering ({region.ProgressPct}%)",
            RenderRegionState.Rough          => "rough render cached",
            RenderRegionState.RenderingRough => $"rendering rough pass ({region.ProgressPct}%)",
            _                                 => "not yet rendered — click Preview to refresh",
        };
        return $"{clipName}: {state}";
    }

    private static string ChipType(TrackItem item) => item switch
    {
        VideoClip    => "video",
        AudioClip    => "audio",
        TextOverlay  => "text",
        Transition   => "transition",
        ImageClip    => "image",
        CalloutClip  => "callout",
        ClipArtClip  => "clipart",
        _            => "video"
    };

    private static string ItemIcon(TrackItem item) => item switch
    {
        AudioClip    => "🎵",
        TextOverlay  => "T",
        Transition   => "…",
        CalloutClip  => "📌",
        ClipArtClip  => "🖼",
        _            => ""
    };

    private static string CalloutIcon(ShapeType shape) => shape switch
    {
        ShapeType.Rectangle => "▭",
        ShapeType.Ellipse   => "◎",
        ShapeType.Arrow     => "→",
        ShapeType.Line      => "—",
        ShapeType.Star      => "★",
        ShapeType.Custom    => "✦",
        _                   => "▭"
    };

    private static string ItemTitle(TrackItem item) => item switch
    {
        TextOverlay to => to.Text,
        _              => item.Name
    };

    /// <summary>Label shown in the overlay row's named-lane gutter (item #42) — the item's
    /// type, not its own name/text (which is already shown inside the chip itself).</summary>
    private static string LaneTypeName(TrackItem item) => item switch
    {
        CalloutClip  => "Callout",
        TextOverlay  => "Text",
        ClipArtClip  => "Clipart",
        _            => "Layer"
    };

    /// <summary>How much of the timeline a chip covers.</summary>
    /// <remarks>
    /// <see cref="TrackItem.EffectiveLength"/> is the one place that answers this, and every item
    /// type answers it correctly. Special-casing video here meant a trimmed audio chip kept the
    /// full source's width and label however short it had been made, so trimming a sound by its
    /// edges appeared to do nothing at all (2026-09-05 audit, audio-11's other half, found on
    /// screen while verifying phase 9).
    /// </remarks>
    private static double ItemDuration(TrackItem item) => item.EffectiveLength;

    private static string TrackIcon(TrackType type) => type switch
    {
        TrackType.Video => "🎬",
        TrackType.Audio => "🎵",
        _               => "♪"
    };

    private static string ShortName(string name) =>
        name.Length <= 18 ? name : name[..15] + "…";

    private static string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? ts.ToString(@"h\:mm\:ss")
            : ts.ToString(@"m\:ss\.f");
    }
