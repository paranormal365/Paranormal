@*
    Copied from Ben.Web.Website.Library/Kit/BenConfirmDialog.razor, because Kit cannot be referenced
    from WebAssembly (Razor SDK plus the Ben.Web.Services FrameworkReference). Keep markup, parameter
    names and defaults identical so the site look and habits carry.
*@

<BcModal Visible="@Visible" VisibleChanged="@VisibleChanged"
         Title="@Title" Static="@Static" Scrollable="false"
         ShowCloseButton="@(!Busy)">
    <ChildContent>
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="mb-0">@Message</p>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@Busy">
            @CancelText
        </button>
        <button type="button" class="btn @ConfirmButtonClass"
                @onclick="@(() => OnConfirm.InvokeAsync())"
                disabled="@(Busy || !ConfirmEnabled)">
            @if (Busy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                @BusyText
            }
            else
            {
                @ConfirmText
            }
        </button>
    </FooterContent>
</BcModal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string Title { get; set; } = "Confirm";

    /// <summary>Single line of prose. Ignored when ChildContent is supplied.</summary>
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Delete";
    [Parameter] public string BusyText { get; set; } = "Working…";
    [Parameter] public string CancelText { get; set; } = "Cancel";

    /// <summary>Disables both buttons and spins the confirm one, so a double-click cannot fire the
    /// action twice.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Extra gate on the confirm button beyond <c>!Busy</c>.</summary>
    [Parameter] public bool ConfirmEnabled { get; set; } = true;

    /// <summary>Renders the confirm button red. Defaults true because most prompts guard a delete.</summary>
    [Parameter] public bool Destructive { get; set; } = true;

    /// <summary>Backdrop and Escape are ignored by default: dismissing a destructive prompt with a
    /// stray click is worse than making the choice explicit.</summary>
    [Parameter] public bool Static { get; set; } = true;

    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string ConfirmButtonClass => Destructive ? "btn-danger" : "btn-primary";

    private async Task Cancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}
