@*
    Copied from Ben.Web.Website.Library/Kit/BenIcon.razor, because Kit cannot be referenced from
    WebAssembly (Razor SDK plus the Ben.Web.Services FrameworkReference). Keep markup and class names
    identical so the site look carries.

    One deliberate difference: the href is RELATIVE ("icons/sprite.svg#name") and resolves against
    <base>. BenIcon writes it root-absolute because the site is served from "/" and relative paths
    broke on nested routes there; the canvas is served from /editors/canvas/, where a root-absolute
    href asks the site root for a sprite that lives under the editor. The <base> element makes the
    relative form right in both places: /editors/canvas/icons/sprite.svg standalone, /icons/sprite.svg
    inside the site. The Safari streamed-SSR quirk that made the site go absolute
    (Ben.Web.Website/Components/App.razor:11-17) does not apply to markup WebAssembly inserts after
    load; M8 re-verifies inside the site.
*@

<svg class="@CssClass" aria-hidden="@(Title is null ? "true" : "false")" role="@(Title is null ? "presentation" : "img")" @attributes="Extra">
    @if (Title is not null)
    {
        <title>@Title</title>
    }
    <use href="icons/sprite.svg#@Name"></use>
</svg>

@code {
    /// <summary>Sprite symbol id, e.g. "home", "bell", "log-in".</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "circle";

    /// <summary>Extra classes appended after the base <c>sa-icon</c> class.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Renders a &lt;title&gt; and switches the icon from decorative to labelled.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "sa-icon" : $"sa-icon {Class}";
}
