@typeparam TItem

@*
    Copied from Ben.Web.Website.Library/Kit/BenContextMenu.razor, because Kit cannot be referenced
    from WebAssembly (Razor SDK plus the Ben.Web.Services FrameworkReference). Keep markup and
    Bootstrap class names identical so the site look carries; the Kit-owned classes are renamed
    ben-context-* to bc-context-*.

    No JavaScript anywhere. ShowAsync(x, y) takes viewport coordinates, which the board passes from a
    right-click and from its long-press callback. Staying on screen is done in CSS: min() against
    100vw/100vh clamps the menu inside the window, and the fixed width makes that clamp exact.
*@

@if (_open)
{
    <div class="bc-context-backdrop"
         @onclick="Close"
         @oncontextmenu="Close"
         @oncontextmenu:preventDefault="true"></div>

    <ul class="dropdown-menu show bc-context-menu"
        style="left: min(@(_x.ToString(Culture))px, calc(100vw - @(WidthPx + 8)px));
               top:  min(@(_y.ToString(Culture))px, calc(100vh - @(EstimatedHeightPx + 8)px));
               width: @(WidthPx)px;"
        role="menu">
        @foreach (var item in Data ?? Enumerable.Empty<TItem>())
        {
            <li>
                <button type="button" class="dropdown-item" role="menuitem"
                        @onclick="@(() => PickAsync(item))">
                    @SelectValue.GetMember(item, TextField)
                </button>
            </li>
        }
    </ul>
}

@code {
    private static readonly System.Globalization.CultureInfo Culture =
        System.Globalization.CultureInfo.InvariantCulture;

    [Parameter] public IEnumerable<TItem>? Data { get; set; }

    /// <summary>Property on <c>TItem</c> holding the label. Omit for a list of strings.</summary>
    [Parameter] public string? TextField { get; set; }

    [Parameter] public EventCallback<TItem> OnClick { get; set; }

    /// <summary>Menu width in pixels. Fixed so the on-screen clamp above can be exact.</summary>
    [Parameter] public int WidthPx { get; set; } = 220;

    private bool _open;
    private double _x;
    private double _y;

    /// <summary>Rough height used only for the bottom clamp; the menu scrolls if it exceeds it.</summary>
    private int EstimatedHeightPx => Math.Min(320, 12 + (Data?.Count() ?? 0) * 34);

    /// <summary>Opens the menu at a viewport coordinate.</summary>
    public Task ShowAsync(double clientX, double clientY)
    {
        _x = clientX;
        _y = clientY;
        _open = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Closes the menu.</summary>
    public void Close()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
    }

    private async Task PickAsync(TItem item)
    {
        // Closed first: the handler may open a dialog, and a menu still sitting over it reads as
        // the click not having registered.
        _open = false;
        await OnClick.InvokeAsync(item);
    }
}
