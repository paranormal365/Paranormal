@*
    Eight resize handles in canonical order (tl, t, tr, r, br, b, bl, l), or only the ones a block's axes
    allow. The keyboard resizes with R and the arrows, so the handles are hidden from screen readers.
*@

@foreach (var key in RectResizeMath.HandleKeys)
{
    if (!RectResizeMath.AllowedFor(key, ResizableWidth, ResizableHeight)) continue;
    <span class="bc-handle bc-handle--@key" data-bc-handle="@key"
          data-bc-node="@NodeId" data-bc-group="@GroupId"
          style="cursor:@RectResizeMath.CursorFor(key)" aria-hidden="true"></span>
}

@code {
    [Parameter] public Guid? NodeId { get; set; }
    [Parameter] public Guid? GroupId { get; set; }
    [Parameter] public bool ResizableWidth { get; set; } = true;
    [Parameter] public bool ResizableHeight { get; set; } = true;
}
