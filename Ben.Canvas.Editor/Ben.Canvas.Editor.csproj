<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The canvas editor itself, as a Razor class library any host can mount: the standalone
    WebAssembly app now, the IsHaunted site later. It never handles credentials - hosts decorate its
    named HttpClients and replace its server seams - which is what lets both hosts be the same
    editor (the shape Ben.Video.Editor proved).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The canvas's version: the newest released heading of
         Ben.Web.Services/Changelog/Content/canvas.md. It changes only at release, in the same
         commit that turns "## Unreleased" into "## x.y.z" (ChangelogServiceTests). -->
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Telerik.UI.for.Blazor" Version="14.1.0" />
    <!-- Pinned past the version Telerik's document libraries bring (9.0.9), which carries a published
         high-severity advisory (GHSA-846f-f764-76mx, fixed in 10.0.13): a fresh restore refused to
         build with warnings as errors (10/14/2026). Telerik 15.1 brings 10.0.13 itself; remove then. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ben.Canvas.Core\Ben.Canvas.Core.csproj" />
  </ItemGroup>

</Project>
