<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The canvas editor itself, as a Razor class library any host can mount: the standalone
    WebAssembly app now, the IsHaunted site later. It never handles credentials - hosts decorate its
    named HttpClients and replace its server seams - which is what lets both hosts be the same
    editor (the shape Ben.Video.Editor proved).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Telerik.UI.for.Blazor" Version="14.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ben.Canvas.Core\Ben.Canvas.Core.csproj" />
  </ItemGroup>

</Project>
