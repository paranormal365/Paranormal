<Project>
  <!-- Item #38 phase E — self-contained, single-file publish for Windows x64, bundling the
       pinned ffmpeg binary from ffmpeg/win-x64/ (run scripts\fetch-ffmpeg.ps1 -Rid win-x64 first).
       v1 ships unsigned (user decision, 2026-08-12) — signing (Authenticode) is a recorded
       requirement before any real user distribution, not before this local build/test workflow. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
