<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Item #38 phase 122 (E): the local native-ffmpeg companion process. Bound to 127.0.0.1 only —
    never reachable from the network — and paired with the browser editor via a one-time pasted
    token (see Security/PairingTokenStore.cs). See DESIGN-item38-long-form-memory.md §5.4 for the
    full threat model this project is built against.
  -->

  <PropertyGroup>
    <!-- Kept identical to Ben.Video.Core SidecarContracts.SidecarRelease.Version, which is what
         the editor compares an installed sidecar against. A guard test holds the two together. -->
    <Version>1.1.3</Version>
    <!--
      Two builds of the one program. net10.0 is the macOS one, and what the tests run against.
      net10.0-windows is the Windows one: a windowed program rather than a console one, so starting
      it never opens a console window that stops the sidecar when somebody closes it (the Store
      1.1.2 did exactly that, from the Start menu, from Win+R and from the editor's Turn on), and it
      can show its own small window with the pairing code. Publishing picks one with -f; the
      installer scripts say which.
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <!-- So a Mac can build, and publish, the Windows one too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Ben.Video.Sidecar</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- Windows Forms adds these as implicit usings, and their Timer, Application and friends then
         collide with names the server code already uses. The window's own files say what they need. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The pairing window and single-copy handling exist only in the Windows build. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Desktop/**" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Item #70 phase 174 — which ffmpeg/<rid>/ directory gets copied next to the app.
      FfmpegLocator resolves its RID at RUNTIME from RuntimeInformation, so the build has to bundle
      the RID the app will actually ask for. A RID-less `dotnet build`/`dotnet run` (the normal
      local-testing case, and how the sidecar is launched during development) leaves
      $(RuntimeIdentifier) empty, which made the old glob read `ffmpeg/**` and sweep in EVERY RID's
      binaries — ~130MB each. Falling back to the SDK's own host RID copies exactly the one set the
      runtime will look for. Override with -p:BundledFfmpegRid=<rid> to stage a different one.
    -->
    <BundledFfmpegRid Condition="'$(BundledFfmpegRid)' == ''">$(RuntimeIdentifier)</BundledFfmpegRid>
    <BundledFfmpegRid Condition="'$(BundledFfmpegRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</BundledFfmpegRid>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ben.Video.Core\Ben.Video.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK's default Content globs include **/*.json and **/*.config from anywhere in
         the project, and this project has an installer/ directory that holds BUILT PACKAGES. So a
         publish swept the previously-built macOS .app's runtimeconfig.json, deps.json and its own
         copy of ffmpeg-manifest.json into the new package — a macOS app's fragments shipping
         inside a Windows download, and growing with whatever was last built. installer/ is build
         tooling and build output; none of it belongs in the product. -->
    <Content Remove="installer/**" />
    <None Remove="installer/**" />

    <!-- The Microsoft Store's ffmpeg pin. build-msix.ps1 reads it from the PROJECT directory and
         copies it into that package as ffmpeg-manifest.json; nothing reads it at runtime. Without
         this the Web SDK's **/*.json glob swept it into the ordinary installer too, which shipped
         a second manifest naming a build that installer does not carry. -->
    <Content Remove="ffmpeg-manifest.store.json" />
    <None Include="ffmpeg-manifest.store.json" />

    <!-- ffmpeg-manifest.json is already auto-included as Content by the SDK's default item globs
         (EnableDefaultContentItems) — Update (not Include) just adds the copy-to-output
         instruction without re-declaring the item and tripping NETSDK1022. -->
    <Content Update="ffmpeg-manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The actual ffmpeg binaries, populated by scripts/fetch-ffmpeg.{sh,ps1} — not committed
         (see .gitignore) and absent from a fresh clone, so this glob is empty and harmless until
         someone runs the fetch script. FfmpegLocator/health degrade gracefully
         (FfmpegIntegrityOk: false) when it's absent. -->
    <Content Include="ffmpeg/$(BundledFfmpegRid)/**" Condition="Exists('ffmpeg/$(BundledFfmpegRid)')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- On a single-file publish (the Windows profile) the bundler classifies these executables
           as native binaries and swallows them INTO the host — measured: a 375 MB
           Ben.Video.Sidecar.exe with no ffmpeg/ folder beside it, while the json manifest, not
           being a binary, still copied loose. FfmpegLocator wants them at ffmpeg/<rid>/ next to
           the app, and the manifest hash-check re-reads them from disk at startup. This keeps
           them as ordinary files. Harmless on the non-single-file macOS publish. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
