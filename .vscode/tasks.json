{
  "version": "2.0.0",
  "tasks": [
    // ── Step 1: Ensure Docker Desktop + bendb-sql are running ──────────────
    {
      "label": "ensure-docker-db",
      "type": "shell",
      "command": "bash scripts/ensure-docker-running.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "label": "Docker + DB",
        "panel": "shared",
        "group": "build",
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },

    // ── Step 2: Start WebApi (background) then WebApp (foreground) ─────────
    {
      "label": "start-full-stack",
      "type": "shell",
      "command": "bash scripts/start-webapp-with-api.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["ensure-docker-db"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": {
        "label": "WebApp",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [
        {
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "\\[startup\\]",
            "endsPattern": "Now listening on: http"
          }
        }
      ]
    },

    // ── Convenience: tail the WebApi log ────────────────────────────────────
    {
      "label": "tail-webapi-log",
      "type": "shell",
      "command": "tail -f .vscode/webapi.log",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "label": "WebApi Log",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },

    // ── Build all projects ───────────────────────────────────────────────────
    {
      "label": "build-all",
      "type": "shell",
      "command": "dotnet build Ben.slnx -v q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "label": "Build",
        "panel": "shared",
        "reveal": "always",
        "clear": true
      },
      "problemMatcher": "$msCompile"
    },

    // ── Start WebApi only + open Swagger UI ─────────────────────────────────
    {
      "label": "start-webapi-swagger",
      "type": "shell",
      "command": "bash scripts/start-webapi-only.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["ensure-docker-db"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "presentation": {
        "label": "WebApi",
        "panel": "dedicated",
        "reveal": "always",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [
        {
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "\\[startup\\]",
            "endsPattern": "\\[swagger\\]"
          }
        }
      ]
    }
  ]
}
