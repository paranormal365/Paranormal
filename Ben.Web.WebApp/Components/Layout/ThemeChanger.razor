@inject IJSRuntime JSRuntime

<div>
    <TelerikSwitch @bind-Value="@IsLightMode"
                   OnLabel="Light"
                   OffLabel="Dark"
                   OnChange="Toggle" />
    <TelerikSvgIcon Icon="SvgIcon.InvertColors" ThemeColor="@ThemeColor" />
</div>

@code {
    private bool IsLightMode { get; set; } = false;
    private string ThemeColor = ThemeConstants.SvgIcon.ThemeColor.Base;

    private async Task Toggle()
    {
        // IsLightMode is already updated by @bind-Value before OnChange fires
        string themeName = IsLightMode ? "light" : "dark";
        ThemeColor = IsLightMode ? ThemeConstants.SvgIcon.ThemeColor.Inverse : ThemeConstants.SvgIcon.ThemeColor.Base;
        await JSRuntime.InvokeVoidAsync("setTheme", themeName);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // initTheme() resolves saved preference or OS preference and returns the name
            var theme = await JSRuntime.InvokeAsync<string>("initTheme");
            IsLightMode = theme == "light";
            ThemeColor = IsLightMode ? ThemeConstants.SvgIcon.ThemeColor.Inverse : ThemeConstants.SvgIcon.ThemeColor.Base;
            StateHasChanged();
        }
    }
}

