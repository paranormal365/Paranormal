@implements IDisposable
@using Ben.Service.Models.Entities

@inject IWebApiTokenStore TokenStore
@inject IWebApiAuthService AuthService
@inject NavigationManager NavManager
@inject NotificationState Notifications

<TelerikDrawer Data="@DrawerData"
               Expanded="@DrawerExpanded"
               ExpandedChanged="@DrawerExpandedChanged"
               @bind-SelectedItem="@DrawerSelectedItem"
               Mode="@DrawerMode.Push"
               MiniMode="true"
               Class="mainlayout-drawer">
    <ItemTemplate Context="item">
        @if (item is not null)
        {
            <div class="k-drawer-link drawer-item">
                <TelerikSvgIcon Icon="@((ISvgIcon?)item.Icon)" Class="k-drawer-item-icon" />
                @if (DrawerExpanded)
                {
                    <span class="k-item-text drawer-item-text">@item.Text</span>
                }
                @if (item.Count > 0)
                {
                    <span class="@($"drawer-item-badge {NotificationBadge.CssClass(item.Urgency)}")"
                          title="@($"{item.Count} waiting")">@NotificationBadge.Text(item.Count)</span>
                }
            </div>
        }
    </ItemTemplate>
    <DrawerContent>
        @if (TokenStore.IsImpersonating)
        {
            <div class="impersonation-banner">
                <TelerikSvgIcon Icon="@SvgIcon.User" />
                <span>Viewing as <strong>@TokenStore.UserEmail</strong></span>
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                               ThemeColor="@ThemeConstants.Button.ThemeColor.Warning"
                               Size="@ThemeConstants.Button.Size.Small"
                               Icon="@SvgIcon.ArrowRotateCcw"
                               OnClick="ReturnToSuperAdmin">Return to SuperAdmin</TelerikButton>
            </div>
        }
        <main>
            @ChildContent
        </main>
    </DrawerContent>
</TelerikDrawer>

<TelerikMediaQuery Media="(min-width: 641px)" OnChange="@OnMediaQueryChange" />

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private bool DrawerExpanded { get; set; } = true;
    private NavItem? DrawerSelectedItem { get; set; }
    private bool LargeScreen { get; set; } = true;

    private IEnumerable<NavItem> DrawerData
    {
        get
        {
            var items = new List<NavItem>
            {
                new NavItem("Home", SvgIcon.Home, "/"),
                new NavItem("Find a Group", SvgIcon.MapMarker, "/find"),
                new NavItem("Equipment Catalog", SvgIcon.Wrench, "/equipment-catalog"),
            };
            if (TokenStore.IsAuthenticated && !TokenStore.IsImpersonating)
            {
                var s = Notifications.Current;

                // Buckets are rolled up to the page a user would actually go to. Group messages and
                // client messages awaiting a reply both live under an organization, so they share
                // the Organizations badge; the bell popover is what breaks them apart again.
                var orgSide = Combine(s.OrgMessages, s.CaseMessagesAsOrgMember);

                items.Add(new NavItem("Notifications",     SvgIcon.Bell,     "/notifications",
                                      Combine(s.SystemMessages, s.PendingPermissionRequests)));
                items.Add(new NavItem("My Cases",          SvgIcon.Folder,   "/my-cases", s.CaseMessagesAsClient));
                items.Add(new NavItem("My Investigations", SvgIcon.Calendar, "/my-investigations", s.InvestigationInvites));
                items.Add(new NavItem("My Requests",       SvgIcon.Inbox,    "/my-requests"));
                items.Add(new NavItem("My Videos",         SvgIcon.Film,     "/my-videos"));
                items.Add(new NavItem("My Equipment",      SvgIcon.Wrench,   "/my-equipment"));
                items.Add(new NavItem("My Checkouts",      SvgIcon.CalendarDate, "/my-checkouts"));
                items.Add(new NavItem("Gear Questions",    SvgIcon.QuestionCircle, "/my-equipment/questions"));
                items.Add(new NavItem("Organizations",     SvgIcon.Globe,    "/organizations", orgSide));
                items.Add(new NavItem("Upload Files",      SvgIcon.Upload,   "/upload-files"));
                items.Add(new NavItem("Media Library",     SvgIcon.Images,   "/media-library"));
            }
            if (!TokenStore.IsAuthenticated)
                items.Add(new NavItem("Login", SvgIcon.Login, "/login"));
            return items;
        }
    }

    public void ToggleDrawer() => DrawerExpanded = !DrawerExpanded;

    protected override void OnInitialized()
    {
        SelectDrawerItem();
        NavManager.LocationChanged += OnLocationChanged;
        // DrawerData is recomputed on every render, so the badges only need a re-render to update.
        Notifications.Changed += OnNotificationsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Notifications.EnsureStartedAsync(RendererInfo.IsInteractive);
    }

    // Raised off the renderer's synchronization context by NotificationState's poll.
    private void OnNotificationsChanged() => InvokeAsync(StateHasChanged);

    private void OnMediaQueryChange(bool mediaQueryMatched)
    {
        LargeScreen = DrawerExpanded = mediaQueryMatched;
    }

    private void DrawerExpandedChanged(bool newExpanded)
    {
        if (!LargeScreen && !newExpanded)
            DrawerExpanded = newExpanded;
    }

    private void SelectDrawerItem()
    {
        var url = NavManager.Uri.Replace(NavManager.BaseUri, "/").ToLowerInvariant();
        DrawerSelectedItem = DrawerData.FirstOrDefault(x => x.Url.ToLowerInvariant() == url);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var url = args.Location.Replace(NavManager.BaseUri, "/").ToLowerInvariant();
        DrawerSelectedItem = DrawerData.FirstOrDefault(x => x.Url.ToLowerInvariant() == url);
        InvokeAsync(StateHasChanged);
    }

    private async Task ReturnToSuperAdmin()
    {
        await AuthService.StopImpersonatingAsync();
        NavManager.NavigateTo("/admin/users");
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        Notifications.Changed -= OnNotificationsChanged;
    }

    /// <summary>Merges buckets that share one drawer destination, keeping the older timestamp.</summary>
    private static NotificationBucket Combine(params NotificationBucket[] buckets)
    {
        var count = buckets.Sum(b => b.Count);
        if (count == 0) return NotificationBucket.Empty;

        var oldest = buckets.Where(b => b.Count > 0 && b.OldestUnreadUtc.HasValue)
                            .Select(b => b.OldestUnreadUtc!.Value)
                            .DefaultIfEmpty()
                            .Min();
        return new NotificationBucket(count, oldest == default ? null : oldest);
    }

    public sealed class NavItem
    {
        public string Text { get; set; }
        public object? Icon { get; set; }
        public string Url { get; set; } = string.Empty;

        /// <summary>Items waiting behind this destination, or 0 for a plain nav item.</summary>
        public int Count { get; }

        /// <summary>How overdue those items are — drives the badge colour.</summary>
        public NotificationBadge.Urgency Urgency { get; }

        public NavItem(string text, object? icon, string url, NotificationBucket? bucket = null)
        {
            Text = text;
            Icon = icon;
            Url = url;
            Count = bucket?.Count ?? 0;
            Urgency = bucket is null ? NotificationBadge.Urgency.None : NotificationBadge.Classify(bucket);
        }
    }
}
