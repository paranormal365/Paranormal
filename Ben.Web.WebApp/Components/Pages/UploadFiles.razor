@page "/upload-files"

@inject IWebApiClient Api
@inject IWebApiTokenStore TokenStore
@inject NavigationManager NavManager
@inject IJSRuntime JS

@using Ben.Data.Common.Enums
@using Ben.Data.Common.Helpers
@using Ben.Service.Models.Entities
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Upload Files</PageTitle>

<div class="container-fluid px-3">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h3 class="mb-0">Upload Files</h3>
        </div>
        <div class="col-auto">
            <TelerikButton Icon="@SvgIcon.Upload"
                           ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                           OnClick="@(() => _showUploadPanel = !_showUploadPanel)">
                Upload New File
            </TelerikButton>
        </div>
    </div>

    @if (_showUploadPanel)
    {
        <div class="card mb-4 p-3">
            <h5 class="mb-3">New Upload</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">File Type</label>
                    <TelerikDropDownList Data="@_fileTypes"
                                         Value="@_newUpload.FileTypeId"
                                         ValueChanged="@((Guid id) => { _newUpload.FileTypeId = id; _uploadError = GetExtensionError(_selectedFile); })"
                                         TextField="@nameof(UploadFileTypeRecord.Name)"
                                         ValueField="@nameof(UploadFileTypeRecord.Id)"
                                         Width="100%" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Description</label>
                    <TelerikTextBox @bind-Value="@_newUpload.Description" Width="100%" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <TelerikCheckBox @bind-Value="@_newUpload.IsPublic" Id="chkPublic" />
                    <label class="ms-2" for="chkPublic">Public</label>
                </div>
                <div class="col-12">
                    <label class="form-label">File</label>
                    <InputFile OnChange="@OnFileSelected" class="form-control" />
                </div>
                @if (_uploadError is not null)
                {
                    <div class="col-12"><div class="alert alert-danger py-2">@_uploadError</div></div>
                }
                <div class="col-12 d-flex gap-2">
                    <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                                   OnClick="UploadFile"
                                   Enabled="@(_selectedFile is not null && !_isUploading)">
                        @(_isUploading ? "Uploading..." : "Upload")
                    </TelerikButton>
                    <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                                   OnClick="@(() => _showUploadPanel = false)">Cancel</TelerikButton>
                </div>
            </div>
        </div>
    }

    <TelerikGrid Data="@_files"
                 TItem="UploadFileRecord"
                 Pageable="true"
                 PageSize="20"
                 Sortable="true"
                 FilterMode="GridFilterMode.FilterRow">
        <GridColumns>
            <GridColumn Field="@nameof(UploadFileRecord.FileName)" Title="File Name" />
            <GridColumn Field="@nameof(UploadFileRecord.ContentType)" Title="Type" Width="140px" />
            <GridColumn Field="@nameof(UploadFileRecord.FileSize)" Title="Size" Width="100px">
                <Template>
                    @(FormatSize(((UploadFileRecord)context).FileSize))
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(UploadFileRecord.IsPublic)" Title="Public" Width="80px">
                <Template>
                    @if (((UploadFileRecord)context).IsPublic)
                    {
                        <TelerikSvgIcon Icon="@SvgIcon.Check" ThemeColor="@ThemeConstants.SvgIcon.ThemeColor.Success" />
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(UploadFileRecord.DateCreated)" Title="Uploaded" Width="140px"
                        DisplayFormat="{0:yyyy-MM-dd}" />
            <GridCommandColumn Width="220px">
                <GridCommandButton Command="Download" Icon="@SvgIcon.Download"
                                   OnClick="@((GridCommandEventArgs e) => DownloadFile((UploadFileRecord)e.Items.First()))">
                    Download
                </GridCommandButton>
                <GridCommandButton Command="Share" Icon="@SvgIcon.Share"
                                   OnClick="@((GridCommandEventArgs e) => OpenShareDialog((UploadFileRecord)e.Items.First()))">
                    Share
                </GridCommandButton>
                <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash"
                                   OnClick="@((GridCommandEventArgs e) => DeleteFile((UploadFileRecord)e.Items.First()))">
                </GridCommandButton>
            </GridCommandColumn>
        </GridColumns>
    </TelerikGrid>
</div>

@* Share with Org Dialog *@
<TelerikDialog @bind-Visible="@_showShareDialog" Title="Share with Organization" Width="440px">
    <DialogContent>
        @if (_sharingFile is not null)
        {
            <p class="text-secondary mb-3">Sharing: <strong>@_sharingFile.FileName</strong></p>
            <div class="mb-3">
                <label class="form-label">Organization</label>
                <TelerikDropDownList Data="@_myOrgs"
                                     @bind-Value="@_shareOrgId"
                                     TextField="@nameof(OrganizationSummaryResponse.Name)"
                                     ValueField="@nameof(OrganizationSummaryResponse.OrganizationId)"
                                     Width="100%" />
            </div>
            <div class="mb-3">
                <label class="form-label">Visibility</label>
                <TelerikDropDownList Data="@_visibilityOptions"
                                     @bind-Value="@_shareVisibility"
                                     TextField="Label"
                                     ValueField="Value"
                                     Width="100%" />
            </div>
        }
    </DialogContent>
    <DialogButtons>
        <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary" OnClick="ConfirmShare">Share</TelerikButton>
        <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                       OnClick="@(() => _showShareDialog = false)">Cancel</TelerikButton>
    </DialogButtons>
</TelerikDialog>

@code {
    // ── State ────────────────────────────────────────────────────────────────
    private IReadOnlyList<UploadFileRecord> _files = [];
    private IReadOnlyList<UploadFileTypeRecord> _fileTypes = [];
    private IReadOnlyList<OrganizationSummaryResponse> _myOrgs = [];

    private bool _showUploadPanel;
    private bool _isUploading;
    private string? _uploadError;
    private IBrowserFile? _selectedFile;

    private NewUploadModel _newUpload = new();

    // Share dialog
    private bool _showShareDialog;
    private UploadFileRecord? _sharingFile;
    private Guid _shareOrgId;
    private FileShareVisibility _shareVisibility = FileShareVisibility.OrgAdminsOnly;

    private static readonly List<(string Label, FileShareVisibility Value)> _visibilityOptions =
    [
        ("Org Admins Only", FileShareVisibility.OrgAdminsOnly),
        ("All Org Members",  FileShareVisibility.OrgMembers),
        ("Public",           FileShareVisibility.Public)
    ];

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        if (!TokenStore.IsAuthenticated)
            NavManager.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        var filesTask = Api.GetUploadFilesAsync();
        var typesTask = Api.GetUploadFileTypesAsync();
        var orgsTask  = Api.GetMyOrganizationsAsync();

        await Task.WhenAll(filesTask, typesTask, orgsTask);

        _files     = filesTask.Result;
        _fileTypes = typesTask.Result;
        _myOrgs    = orgsTask.Result;

        if (_fileTypes.Any())
            _newUpload.FileTypeId = _fileTypes[0].Id;
        if (_myOrgs.Any())
            _shareOrgId = _myOrgs[0].OrganizationId;
    }

    // ── Upload ───────────────────────────────────────────────────────────────
    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadError = GetExtensionError(_selectedFile);
    }

    private string? GetExtensionError(IBrowserFile? file)
    {
        if (file is null) return null;
        var type = _fileTypes.FirstOrDefault(t => t.Id == _newUpload.FileTypeId);
        if (type is null || type.AllowAllExtensions) return null;
        var ext = Path.GetExtension(file.Name);
        if (!FileExtensionPatternMatcher.IsAllowedByPatterns(type.AllowedPatterns, ext))
        {
            var allowed = type.AllowedPatterns.Count > 0
                ? string.Join(", ", type.AllowedPatterns)
                : "(none defined)";
            return $"File extension '{ext}' is not allowed for type '{type.Name}'. Allowed: {allowed}";
        }
        return null;
    }

    private async Task UploadFile()
    {
        if (_selectedFile is null || TokenStore.UserEmail is null) return;

        // Re-validate extension in case file type selection changed after file was picked
        _uploadError = GetExtensionError(_selectedFile);
        if (_uploadError is not null) return;

        _isUploading = true;
        _uploadError = null;

        try
        {
            var userId = TokenStore.UserId ?? Guid.Empty;

            var content = new MultipartFormDataContent();
            content.Add(new StringContent(_newUpload.FileTypeId.ToString()), "uploadFileTypeId");
            content.Add(new StringContent(userId.ToString()), "appUserId");
            content.Add(new StringContent(_newUpload.Description ?? string.Empty), "description");
            content.Add(new StringContent(_newUpload.IsPublic.ToString()), "isPublic");

            var maxSize = 50 * 1024 * 1024; // 50 MB
            await using var stream = _selectedFile.OpenReadStream(maxSize);
            var fileContent = new StreamContent(stream);
            var contentType = string.IsNullOrWhiteSpace(_selectedFile.ContentType)
                ? "application/octet-stream"
                : _selectedFile.ContentType;
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
            content.Add(fileContent, "file", _selectedFile.Name);

            var result = await Api.UploadFileAsync(content);
            if (result is not null)
            {
                _files = [result, .._files];
                _showUploadPanel = false;
                _newUpload = new NewUploadModel { FileTypeId = _fileTypes.FirstOrDefault()?.Id ?? Guid.Empty };
                _selectedFile = null;
            }
            else
            {
                _uploadError = "Upload failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Error: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }

    // ── Download ─────────────────────────────────────────────────────────────
    private async Task DownloadFile(UploadFileRecord file)
    {
        var result = await Api.DownloadFileAsync(file.Id);
        if (result is null) return;

        var (data, contentType, fileName) = result.Value;
        var base64 = Convert.ToBase64String(data);
        await JS.InvokeVoidAsync("downloadFileFromBase64", base64, contentType, fileName);
    }

    // ── Delete ───────────────────────────────────────────────────────────────
    private async Task DeleteFile(UploadFileRecord file)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete '{file.FileName}'?")) return;
        if (await Api.DeleteUploadFileAsync(file.Id))
            _files = [.._files.Where(f => f.Id != file.Id)];
    }

    // ── Share ────────────────────────────────────────────────────────────────
    private void OpenShareDialog(UploadFileRecord file)
    {
        _sharingFile = file;
        _shareVisibility = FileShareVisibility.OrgAdminsOnly;
        _showShareDialog = true;
    }

    private async Task ConfirmShare()
    {
        if (_sharingFile is null) return;
        var userId = _sharingFile.AppUserId;

        await Api.ShareFileWithOrgAsync(_sharingFile.Id, new ShareFileWithOrgRequest(
            _shareOrgId, userId, _shareVisibility));

        _showShareDialog = false;
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private static string FormatSize(long bytes) => Ben.Web.Library.Manage.Audio.AudioFormatUtils.FormatSize(bytes);

    private sealed class NewUploadModel
    {
        public Guid FileTypeId { get; set; }
        public string? Description { get; set; }
        public bool IsPublic { get; set; }
    }
}
