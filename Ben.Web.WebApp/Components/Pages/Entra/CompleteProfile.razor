@page "/entra/complete-profile"

@inject EntraTokenHolder EntraTokenHolder
@inject IWebApiClient WebApiClient
@inject IWebApiAuthService AuthService
@inject IWebApiTokenStore TokenStore
@inject NavigationManager NavManager

<PageTitle>Complete Your Profile</PageTitle>

<div class="login-container">
    <div class="login-card" style="max-width:460px">

        @if (!EntraTokenHolder.IsEntraAuthenticated)
        {
            <p class="text-muted">No active Microsoft session found. <a href="/login">Return to login</a>.</p>
        }
        else if (_mode == PageMode.Choose)
        {
            <h2 class="mb-1">Welcome</h2>
            <p class="text-muted mb-4">
                We don't have a local account for
                <strong>@EntraTokenHolder.Email</strong>.
                What would you like to do?
            </p>

            <div class="d-grid gap-2">
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Class="w-100"
                               OnClick="@(() => _mode = PageMode.CreateNew)">
                    Create a new account
                </TelerikButton>
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Outline"
                               Class="w-100"
                               OnClick="@(() => _mode = PageMode.LinkExisting)">
                    I already have an account — link it
                </TelerikButton>
            </div>
        }
        else if (_mode == PageMode.CreateNew)
        {
            <h2 class="mb-1">Create Account</h2>
            <p class="text-muted mb-3">
                Signing in as <strong>@EntraTokenHolder.Email</strong>
            </p>

            <div class="mb-3">
                <label class="form-label">Display Name <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="_displayName" Placeholder="Your name" Width="100%" />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <TelerikTextBox Value="@EntraTokenHolder.Email" Enabled="false" Width="100%" />
                <div class="form-text">Provided by Microsoft — cannot be changed here.</div>
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@_error</div>
            }

            <div class="d-flex gap-2">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                               OnClick="@(() => { _mode = PageMode.Choose; _error = null; })">
                    Back
                </TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Class="flex-grow-1"
                               Enabled="@(!_saving && !string.IsNullOrWhiteSpace(_displayName))"
                               OnClick="CreateAccount">
                    @(_saving ? "Creating…" : "Create Account")
                </TelerikButton>
            </div>
        }
        else if (_mode == PageMode.LinkExisting)
        {
            <h2 class="mb-1">Link Your Account</h2>
            <p class="text-muted mb-3">
                Sign in with your existing account to link
                <strong>@EntraTokenHolder.Email</strong> to it.
            </p>

            <div class="mb-3">
                <label class="form-label">Account Email <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="_linkEmail" Placeholder="you@example.com" Width="100%" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password <span class="text-danger">*</span></label>
                <TelerikTextBox @bind-Value="_linkPassword" Password="true" Placeholder="••••••••" Width="100%" />
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 mb-3">@_error</div>
            }
            @if (_linkSuccess)
            {
                <div class="alert alert-success py-2 mb-3">
                    Microsoft account linked! Redirecting…
                </div>
            }

            <div class="d-flex gap-2">
                <TelerikButton FillMode="@ThemeConstants.Button.FillMode.Flat"
                               OnClick="@(() => { _mode = PageMode.Choose; _error = null; })">
                    Back
                </TelerikButton>
                <TelerikButton ThemeColor="@ThemeConstants.Button.ThemeColor.Primary"
                               Class="flex-grow-1"
                               Enabled="@(!_saving)"
                               OnClick="LinkAccount">
                    @(_saving ? "Linking…" : "Sign In & Link")
                </TelerikButton>
            </div>
        }

    </div>
</div>

@code {
    private enum PageMode { Choose, CreateNew, LinkExisting }

    private PageMode _mode = PageMode.Choose;
    private string   _displayName  = string.Empty;
    private string   _linkEmail    = string.Empty;
    private string   _linkPassword = string.Empty;
    private string?  _error;
    private bool     _saving;
    private bool     _linkSuccess;

    protected override void OnInitialized()
    {
        // If user navigated here without an Entra session, or is already authenticated locally, redirect away.
        if (!EntraTokenHolder.IsEntraAuthenticated)
            NavManager.NavigateTo("/login");
    }

    // ── Create new account ────────────────────────────────────────────────────

    private async Task CreateAccount()
    {
        _saving = true;
        _error  = null;

        try
        {
            var payload = new EntraRegisterPayload(
                EntraOid:             EntraTokenHolder.EntraOid ?? string.Empty,
                EntraEmail:           EntraTokenHolder.Email    ?? string.Empty,
                DisplayName:          _displayName,
                ProviderDisplayName:  EntraTokenHolder.Email);

            var result = await WebApiClient.EntraRegisterAsync(payload);

            if (result is null)
            {
                _error = "Registration failed. An account with this email may already exist — try 'Link existing account'.";
                return;
            }

            // Force a full page reload so the OIDC middleware repopulates EntraTokenHolder,
            // and MainLayout.TryBridgeEntraAuthAsync finds the user via FindByLoginAsync.
            NavManager.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Link to existing account ──────────────────────────────────────────────

    private async Task LinkAccount()
    {
        _saving = true;
        _error  = null;

        try
        {
            // Step 1: sign in with local credentials → sets TokenStore with local bearer token
            var loginOk = await AuthService.LoginAsync(_linkEmail, _linkPassword);
            if (!loginOk)
            {
                _error = "Invalid email or password.";
                return;
            }

            // Step 2: link the Entra OID to the now-authenticated local account
            var linkPayload = new EntraLinkPayload(
                EntraOid:            EntraTokenHolder.EntraOid ?? string.Empty,
                EntraEmail:          EntraTokenHolder.Email    ?? string.Empty,
                ProviderDisplayName: EntraTokenHolder.Email);

            var linkOk = await WebApiClient.EntraLinkAsync(linkPayload);
            if (!linkOk)
            {
                _error = "Account linking failed. This Microsoft identity may already be linked elsewhere.";
                return;
            }

            _linkSuccess = true;
            // Small delay so the user sees the success message, then navigate home.
            await Task.Delay(1200);
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
