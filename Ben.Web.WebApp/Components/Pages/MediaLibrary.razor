@page "/media-library"
@using Ben.Web.Library.Media
@using Ben.Web.Library.Services
@inject IBenUserState UserState
@inject NavigationManager NavManager

<PageTitle>Media Library</PageTitle>

@if (!UserState.IsAuthenticated)
{
    <div class="container py-4"><p class="text-muted">You must be signed in to view your media library.</p></div>
}
else
{
    <div class="container-fluid py-3">
        <h3 class="mb-3">Media Library</h3>
        <p class="text-secondary small mb-3">
            Everything you own, everything shared with you (by a person, an investigation team, or an organization),
            and everything public.
        </p>
        <MediaLibraryGrid ShowVoting="true" />
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!await UserState.WaitUntilAuthReadyAsync(RendererInfo.IsInteractive)) return;
        if (!UserState.IsAuthenticated) NavManager.NavigateTo("/login");
    }
}
