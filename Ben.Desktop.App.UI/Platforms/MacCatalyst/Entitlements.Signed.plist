<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    The entitlements for a build signed with a real Apple identity. Selected by the csproj when
    CodesignKey is set; the plain Entitlements.plist is what an ordinary local build uses.

    keychain-access-groups is split out because it CANNOT be carried by an ad-hoc signature.
    $(AppIdentifierPrefix) only expands from a provisioning profile, so an unsigned build ends up
    declaring a group with no team prefix, the signature is rejected, and the app does not launch
    at all — "Launchd job spawn failed", which names nothing. Found exactly that way on 2026-09-10.

    Sign in with Apple goes here too, once there is an App ID for com.ishaunted.desktop.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <key>com.apple.security.network.client</key>
    <true/>

    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.ishaunted.desktop</string>
    </array>
</dict>
</plist>
