<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:kit="clr-namespace:Ben.Desktop.App.Library.Kit;assembly=Ben.Desktop.App.Library"
             x:Class="Ben.Desktop.App.UI.Pages.CompleteProfilePage"
             Title="Finish setting up">
    <!--
        Reached when Microsoft or Apple vouched for somebody who has no account here yet. That is a
        normal outcome, not an error: the token is perfectly valid, there is simply nobody here it
        belongs to. Treating it as a failure would leave them signed in to an app where every page
        refuses them.
    -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="32" Spacing="16" MaximumWidthRequest="440"
                                 HorizontalOptions="Center" VerticalOptions="Center">

                <Label x:Name="Heading" Text="Finish setting up your account"
                       FontSize="22" FontAttributes="Bold" />

                <Label x:Name="Explanation" />

                <VerticalStackLayout x:Name="CreateSection" Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Display name" />
                        <Entry x:Name="DisplayNameField" TextChanged="OnDisplayNameChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="HandleSection" Spacing="4" IsVisible="False">
                        <Label Text="@name" />
                        <Entry x:Name="HandleField" TextChanged="OnHandleChanged" />
                        <!-- Said before they choose, not after. A handle cannot be changed later. -->
                        <Label Text="This is permanent — it can't be changed afterwards."
                               FontSize="12" />
                    </VerticalStackLayout>

                    <Button x:Name="CreateButton" Text="Create my account" Clicked="OnCreate" />
                </VerticalStackLayout>

                <!--
                    ALWAYS offered, not only when the server spots a matching address. It can only
                    spot one when the provider's address happens to equal an existing account's,
                    which is the easy case and not the common one: an Apple relay address matches
                    nothing, and a work Microsoft account is often at a different address entirely.
                    Every one of those would otherwise get a second account holding none of their
                    history. The person knows; the server cannot.
                -->
                <VerticalStackLayout x:Name="LinkSection" Spacing="12" IsVisible="False">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />
                    <Label x:Name="LinkHeading" Text="Already have an account here?"
                           FontSize="18" FontAttributes="Bold" />
                    <Label Text="Sign in to it once and we'll join the two, so you keep everything that's already yours." />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email address" />
                        <Entry x:Name="LinkEmailField" Keyboard="Email" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password" />
                        <Entry x:Name="LinkPasswordField" IsPassword="True" />
                    </VerticalStackLayout>

                    <Button Text="Link it" Clicked="OnLink" />
                </VerticalStackLayout>

                <Label x:Name="MessageText" IsVisible="False" />

                <Button Text="Cancel" Clicked="OnCancel" />
            </VerticalStackLayout>
        </ScrollView>

        <kit:BenBusyOverlay x:Name="Busy" />
    </Grid>
</ContentPage>
