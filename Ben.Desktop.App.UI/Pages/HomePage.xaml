<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ben.Desktop.App.UI.Pages.HomePage"
             Title="IsHaunted">
    <!--
        A placeholder, and honest about it. Its job in this phase is to prove one authenticated
        round trip really happened: the name and the roles below came from GET api/me, not from
        anything the client assumed.
    -->
    <VerticalStackLayout Padding="32" Spacing="16">
        <Label x:Name="Greeting" FontSize="22" FontAttributes="Bold" />
        <Label x:Name="Roles" />
        <Button Text="Sign out" Clicked="OnSignOut" HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentPage>
