<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ben.Desktop.App.Library.Kit.BenBusyOverlay">
    <!--
        Covers its parent while something is in flight. Blocking input is the point: a form that
        stays pressable during a sign-in invites a second attempt, and a second attempt against a
        rate-limited endpoint spends the next window too.
    -->
    <Grid x:Name="Root" BackgroundColor="{AppThemeBinding Light=#B0FFFFFF, Dark=#B0000000}"
          IsVisible="False">
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
            <ActivityIndicator x:Name="Spinner" IsRunning="False" />
            <Label x:Name="CaptionLabel" HorizontalOptions="Center" IsVisible="False" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
