<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ben.Desktop.App.Library.Kit.BenCodeEntry">
    <!--
        A one-time code. Deliberately NOT a password field: there is nothing to hide from somebody
        looking over a shoulder in a six-digit number that expires in thirty seconds, and masking it
        only makes a typo impossible to spot.
    -->
    <VerticalStackLayout Spacing="4">
        <Label x:Name="CaptionLabel" Text="Code" />
        <Entry x:Name="Field" Keyboard="Numeric" MaxLength="12" FontFamily="Monospace" />
        <Label x:Name="HintLabel" FontSize="12" IsVisible="False" />
    </VerticalStackLayout>
</ContentView>
