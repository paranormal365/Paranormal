<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Item 225: the reusable half of the desktop app — controls, styles, converters and the view
    models that sit between Ben.Data.WebApi.Client and a screen. Same division as
    Ben.Web.Website.Library on the web side, and the same rule about Telerik: a Telerik control is
    wrapped once in Kit/ and used through the wrapper, never reached for directly from a page.

    WINDOWS IS CONDITIONAL, AND HAS TO BE. net10.0-windows can be restored anywhere but built only
    on Windows: the WinUI build tasks are Windows-only. Listing it unconditionally would break
    `dotnet build Ben.slnx` on this Mac and on the Linux CI runner, which is a worse outcome than
    not building the Windows head on a machine that could never run it anyway.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ben.Desktop.App.Library</RootNamespace>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!--
      Telerik's UseTelerik() lives in Telerik.Maui.Controls.Compatibility, which needs this. It is
      NOT implicit any more: .NET 10 stopped including Microsoft.Maui.Controls.Compatibility, so
      the app compiled perfectly and then died on launch inside UseTelerik with
      "Could not load file or assembly Microsoft.Maui.Controls.Compatibility". Nothing at build
      time says a word about it.
    -->
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Telerik.UI.for.Maui" Version="3.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!--
    Both of these arrive transitively from Telerik.UI.for.Maui 3.2.1 at versions with known HIGH
    severity advisories (NU1903): SkiaSharp 2.88.1 (GHSA-j7hp-h8jx-5ppr) and
    System.Security.Cryptography.Pkcs 6.0.0 (GHSA-555c-2p6r-68mm). Pinned forward to the patched
    releases in the same major, so Telerik still gets the API it compiled against.

    Delete these the day Telerik ships a version that resolves them itself, and check with
    dotnet list package with the vulnerable and include-transitive flags rather than assuming.
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="6.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ben.Data.WebApi.Client\Ben.Data.WebApi.Client.csproj" />
  </ItemGroup>

</Project>
