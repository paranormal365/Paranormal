<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the real ffmpeg binary, used by Ben.Video.Sidecar.Tests. Records exactly what
    argv it was invoked with (so tests can assert the sidecar built safe, sandbox-relative
    argument lists) and can simulate success, failure, or a hang on demand via FAKE_FFMPEG_MODE.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>fakeffmpeg</AssemblyName>
  </PropertyGroup>

</Project>
